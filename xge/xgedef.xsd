<?xml version="1.0" encoding="utf-8"?>
<!--
  xgedef.xsd

  What a game file is made of. The rule of thumb:

    * An attribute NAMES or PICKS something: name, class, object, variable,
      state, action, button, edge, direction, unless, burn, sprite, sound, wave,
      pitch, to, keys. These are labels, and they cannot be computed.
    * Everything else is the content of an element. Wherever the content is a
      number (valueType below) it is either a math expression written out as
      text - window.width.center - title.width / 2 - or a single value tag that
      makes the number, such as <random min="-7" max="7" />. To add a new kind
      of value, add it to the valueTag group and teach game_xml and game_expr
      about it; every place that takes a value takes it.
    * What an object DOES is a list of command tags (the command group below):
      <bounce />, <inc variable="paddle1.score" />, <push state="playing" />.
      They run in the order written.

  Shapes, commands and random numbers are tags, never function calls; only
  plain arithmetic is left to be written out as text.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" attributeFormDefault="unqualified" elementFormDefault="qualified">

  <!-- The words an attribute may hold. -->
  <xs:simpleType name="edgeType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="left" />
      <xs:enumeration value="right" />
      <xs:enumeration value="top" />
      <xs:enumeration value="bottom" />
      <xs:enumeration value="horizontal" />
      <xs:enumeration value="vertical" />
      <xs:enumeration value="all" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="directionType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="up" />
      <xs:enumeration value="down" />
      <xs:enumeration value="left" />
      <xs:enumeration value="right" />
    </xs:restriction>
  </xs:simpleType>

  <!-- The two ways an object with a heading can turn. -->
  <xs:simpleType name="turnDirectionType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="left" />
      <xs:enumeration value="right" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="flipType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="horizontal" />
      <xs:enumeration value="vertical" />
    </xs:restriction>
  </xs:simpleType>

  <!-- Value tags: the ways, besides writing an expression, to give a number. -->
  <xs:group name="valueTag">
    <xs:choice>
      <xs:element name="random" type="randomType" />
      <xs:element name="equation" type="equationType" />
      <xs:element name="formula" type="formulaType" />
    </xs:choice>
  </xs:group>

  <xs:complexType name="randomType">
    <xs:attribute name="min" type="xs:string" use="required" />
    <xs:attribute name="max" type="xs:string" use="required" />
  </xs:complexType>

  <!-- Arithmetic without a string to parse, in two spellings that mean the same.

       <equation> is a list of steps, one operation each, the operands
       attributes (a name or a number); a step's name is what later steps call
       its answer, and the last step is the answer of the whole equation:
         <equation>
           <divide name="half" dividend="title.width" divisor="2" />
           <subtract minuend="window.width.center" subtrahend="half" />
         </equation>

       <formula> is one operation whose operands are elements: a name, a number,
       <random> or another operation. The first operand is combined with each
       of the others in turn, so a - b - c is a subtract with two subtrahends:
         <formula>
           <subtract>
             <minuend>window.width.center</minuend>
             <subtrahend><divide><dividend>title.width</dividend><divisor>2</divisor></divide></subtrahend>
           </subtract>
         </formula>

       Both are value tags, so they go anywhere an expression or <random> does.
       Operations, one per arithmetic word: add, subtract, multiply, divide. -->

  <xs:complexType name="addStepType">
    <xs:attribute name="name" type="xs:string" />
    <xs:attribute name="augend" type="xs:string" use="required" />
    <xs:attribute name="addend" type="xs:string" use="required" />
  </xs:complexType>

  <xs:complexType name="subtractStepType">
    <xs:attribute name="name" type="xs:string" />
    <xs:attribute name="minuend" type="xs:string" use="required" />
    <xs:attribute name="subtrahend" type="xs:string" use="required" />
  </xs:complexType>

  <xs:complexType name="multiplyStepType">
    <xs:attribute name="name" type="xs:string" />
    <xs:attribute name="multiplicand" type="xs:string" use="required" />
    <xs:attribute name="multiplier" type="xs:string" use="required" />
  </xs:complexType>

  <xs:complexType name="divideStepType">
    <xs:attribute name="name" type="xs:string" />
    <xs:attribute name="dividend" type="xs:string" use="required" />
    <xs:attribute name="divisor" type="xs:string" use="required" />
  </xs:complexType>

  <xs:complexType name="equationType">
    <xs:choice maxOccurs="unbounded">
      <xs:element name="add" type="addStepType" />
      <xs:element name="subtract" type="subtractStepType" />
      <xs:element name="multiply" type="multiplyStepType" />
      <xs:element name="divide" type="divideStepType" />
    </xs:choice>
  </xs:complexType>

  <xs:complexType name="formulaType">
    <xs:choice>
      <xs:element name="add" type="addType" />
      <xs:element name="subtract" type="subtractType" />
      <xs:element name="multiply" type="multiplyType" />
      <xs:element name="divide" type="divideType" />
    </xs:choice>
  </xs:complexType>

  <!-- An operand of a formula: text (a name or a number), <random> or an operation, which contains operands in turn. -->
  <xs:complexType name="operandType" mixed="true">
    <xs:choice minOccurs="0">
      <xs:element name="random" type="randomType" />
      <xs:element name="add" type="addType" />
      <xs:element name="subtract" type="subtractType" />
      <xs:element name="multiply" type="multiplyType" />
      <xs:element name="divide" type="divideType" />
    </xs:choice>
  </xs:complexType>

  <xs:complexType name="addType">
    <xs:sequence>
      <xs:element name="augend" type="operandType" />
      <xs:element name="addend" type="operandType" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="subtractType">
    <xs:sequence>
      <xs:element name="minuend" type="operandType" />
      <xs:element name="subtrahend" type="operandType" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="multiplyType">
    <xs:sequence>
      <xs:element name="multiplicand" type="operandType" />
      <xs:element name="multiplier" type="operandType" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="divideType">
    <xs:sequence>
      <xs:element name="dividend" type="operandType" />
      <xs:element name="divisor" type="operandType" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <!-- A number: text (an expression) or one value tag, not both. -->
  <xs:complexType name="valueType" mixed="true">
    <xs:sequence>
      <xs:group ref="valueTag" minOccurs="0" />
    </xs:sequence>
  </xs:complexType>

  <!--
    What a condition's variable is compared with: a number, as content
    (<atleast>15</atleast>), or another variable, read every frame:
    variable= names it, and object= whose (the tested object's own when left
    out): <above object="gun2" variable="score" />.
  -->
  <xs:complexType name="compareType" mixed="true">
    <xs:sequence>
      <xs:group ref="valueTag" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="object" type="xs:string" use="optional" />
    <xs:attribute name="variable" type="xs:string" use="optional" />
  </xs:complexType>

  <!-- A number with a name, for <variable name="score">0</variable>. -->
  <xs:complexType name="variableType" mixed="true">
    <xs:sequence>
      <xs:group ref="valueTag" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required" />
  </xs:complexType>

  <!-- Two numbers: <position>, <velocity> and a grid's <padding>. -->
  <xs:complexType name="vector2Type">
    <xs:sequence>
      <xs:element name="x" type="valueType" />
      <xs:element name="y" type="valueType" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="emptyType" />

  <!-- Sounds: the voices of an old 8-bit sound chip, and a soft sine. -->
  <xs:simpleType name="waveType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="square" />
      <xs:enumeration value="triangle" />
      <xs:enumeration value="sawtooth" />
      <xs:enumeration value="sine" />
      <xs:enumeration value="noise" />
    </xs:restriction>
  </xs:simpleType>

  <!--
    A note: its pitch (a note name with an octave such as C4, F#3 or Bb5 -
    C4 is middle C - or a number of hertz), optionally a pitch to slide to
    while it plays, and optionally a wave of its own instead of the sound's.
    Its content is how long it lasts, in seconds.
  -->
  <xs:complexType name="noteType" mixed="true">
    <xs:sequence>
      <xs:group ref="valueTag" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="pitch" type="xs:string" use="required" />
    <xs:attribute name="to" type="xs:string" use="optional" />
    <xs:attribute name="wave" type="waveType" use="optional" />
  </xs:complexType>

  <!--
    A sound that <play sound="..." /> starts: whether it loops (<loop />: over
    and over until a <silence>, or, played from a key, until the key is let
    go), how loud (0 to 1, 0.3 when left
    out), then notes and rests (a rest's content is how many seconds of
    silence), played one after the other. wave is every note's that does not
    give its own (square when left out).
  -->
  <xs:complexType name="soundType">
    <xs:sequence>
      <xs:element name="loop" type="emptyType" minOccurs="0" />
      <xs:element name="volume" type="valueType" minOccurs="0" />
      <xs:choice maxOccurs="unbounded">
        <xs:element name="note" type="noteType" />
        <xs:element name="rest" type="valueType" />
      </xs:choice>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required" />
    <xs:attribute name="wave" type="waveType" use="optional" />
  </xs:complexType>

  <!-- Sprites: one shape. -->
  <xs:group name="shape">
    <xs:choice>
      <xs:element name="circle">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="radius" type="valueType" />
            <xs:element name="color" type="xs:string" minOccurs="0" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="rectangle">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="width" type="valueType" />
            <xs:element name="height" type="valueType" />
            <xs:element name="color" type="xs:string" minOccurs="0" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="text">
        <xs:complexType>
          <xs:sequence>
            <!-- its pieces, in order, a space between them (letters side by side make one word) -->
            <xs:choice maxOccurs="unbounded">
              <!-- a fixed label -->
              <xs:element name="content" type="xs:string" />
              <!-- a live number: an owner.variable stays up to date as it changes -->
              <xs:element name="number" type="valueType" />
              <!-- a number shown as a letter, 0 is A and 25 is Z, live the same way -->
              <xs:element name="letter" type="valueType" />
            </xs:choice>
            <xs:element name="size" type="valueType" />
            <xs:element name="color" type="xs:string" minOccurs="0" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="image">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="path" type="xs:string" />
            <xs:element name="flip" type="flipType" minOccurs="0" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <!--
        A picture in rows of text, one character to a pixel: a period is a clear
        pixel and an asterisk a solid one, drawn in the color. Every character
        becomes scale by scale real pixels (1 if left out), so a few characters
        make a chunky sprite. The rows must all be the same width. Like a
        drawing of lines it is made into a picture when the game loads.
      -->
      <xs:element name="bitmap">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="row" type="xs:string" maxOccurs="unbounded" />
            <xs:element name="scale" type="valueType" minOccurs="0" />
            <xs:element name="color" type="bitmapColorType" minOccurs="0" maxOccurs="unbounded" />
            <xs:element name="flip" type="flipType" minOccurs="0" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <!--
        A drawing from an SVG file, made into a picture when the game loads, so
        every graphics library shows it the same way and a pixel collision tests
        what is shown. The path is read like an image's. x, y, width and height
        (all four, or none for the whole drawing) pick the part of the drawing to
        take, in the drawing's own units, which is how one sheet of sprites
        serves many objects. scale is how many real pixels a unit is (1 if left
        out; it need not be a whole number). Each hide is the id of an element to
        leave out, such as a backdrop. The colors are the drawing's own.
      -->
      <xs:element name="svg">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="path" type="xs:string" />
            <xs:element name="x" type="valueType" minOccurs="0" />
            <xs:element name="y" type="valueType" minOccurs="0" />
            <xs:element name="width" type="valueType" minOccurs="0" />
            <xs:element name="height" type="valueType" minOccurs="0" />
            <xs:element name="scale" type="valueType" minOccurs="0" />
            <xs:element name="hide" type="xs:string" minOccurs="0" maxOccurs="unbounded" />
            <xs:element name="flip" type="flipType" minOccurs="0" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:choice>
  </xs:group>

  <!--
    One straight line of a drawing: where from and to, in pixels from the
    sprite's top left, and optionally its color and how many pixels thick it is
    (1 if left out). A sprite of one or more of these is drawn once, when the
    game loads, into the picture that is shown and that a collision of type
    pixel looks at.
  -->
  <xs:complexType name="lineType">
    <xs:sequence>
      <xs:element name="from" type="vector2Type" />
      <xs:element name="to" type="vector2Type" />
      <xs:element name="color" type="xs:string" minOccurs="0" />
      <xs:element name="thickness" type="valueType" minOccurs="0" />
    </xs:sequence>
  </xs:complexType>

  <!-- A sprite is named when an object has several, so an animation can pick them out. -->
  <xs:complexType name="spriteType">
    <xs:choice>
      <xs:group ref="shape" />
      <xs:element name="line" type="lineType" maxOccurs="unbounded" />
    </xs:choice>
    <xs:attribute name="name" type="xs:string" use="optional" />
  </xs:complexType>

  <!--
    A sprite that changes one its group has, for a member, row, column or cell:
    the group's sprite of the same name (or the one with no name). Of the same
    shape it gives only what changes, a color say, and keeps the rest; of
    another shape, or as lines, it is a sprite of its own, and must be complete
    (the engine says what is missing). A name the group has not got adds one.
  -->
  <xs:complexType name="spriteChangeType">
    <xs:choice>
      <xs:element name="circle">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="radius" type="valueType" minOccurs="0" />
            <xs:element name="color" type="xs:string" minOccurs="0" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="rectangle">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="width" type="valueType" minOccurs="0" />
            <xs:element name="height" type="valueType" minOccurs="0" />
            <xs:element name="color" type="xs:string" minOccurs="0" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="text">
        <xs:complexType>
          <xs:sequence>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
              <xs:element name="content" type="xs:string" />
              <xs:element name="number" type="valueType" />
              <xs:element name="letter" type="valueType" />
            </xs:choice>
            <xs:element name="size" type="valueType" minOccurs="0" />
            <xs:element name="color" type="xs:string" minOccurs="0" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="image">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="path" type="xs:string" minOccurs="0" />
            <xs:element name="flip" type="flipType" minOccurs="0" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="bitmap">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="row" type="xs:string" minOccurs="0" maxOccurs="unbounded" />
            <xs:element name="scale" type="valueType" minOccurs="0" />
            <xs:element name="color" type="bitmapColorType" minOccurs="0" maxOccurs="unbounded" />
            <xs:element name="flip" type="flipType" minOccurs="0" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="svg">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="path" type="xs:string" minOccurs="0" />
            <xs:element name="x" type="valueType" minOccurs="0" />
            <xs:element name="y" type="valueType" minOccurs="0" />
            <xs:element name="width" type="valueType" minOccurs="0" />
            <xs:element name="height" type="valueType" minOccurs="0" />
            <xs:element name="scale" type="valueType" minOccurs="0" />
            <xs:element name="hide" type="xs:string" minOccurs="0" maxOccurs="unbounded" />
            <xs:element name="flip" type="flipType" minOccurs="0" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="line" type="lineType" maxOccurs="unbounded" />
    </xs:choice>
    <xs:attribute name="name" type="xs:string" use="optional" />
  </xs:complexType>

  <!--
    An animation: how many seconds each picture is shown, and the sprites it
    shows in turn, round and round, each picked out by the name of one of the
    object's own sprites. At least two frames; the same sprite may come up more
    than once. The frames must all be pictures (bitmaps, svgs or drawings of
    lines) of the same size.
  -->
  <xs:complexType name="animationType">
    <xs:sequence>
      <xs:element name="interval" type="valueType" />
      <xs:element name="frame" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="sprite" type="xs:string" use="required" />
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- Commands: what a collision rule, an object action, a key or a condition does. -->
  <!-- inc and dec: which variable, and by how much (1 when there is nothing between the tags). -->
  <xs:complexType name="variableReferenceType" mixed="true">
    <xs:sequence>
      <xs:group ref="valueTag" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="variable" type="xs:string" use="required" />
  </xs:complexType>

  <!-- move and hop: a direction, and how far. -->
  <xs:complexType name="stepType" mixed="true">
    <xs:sequence>
      <xs:group ref="valueTag" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="direction" type="directionType" use="required" />
  </xs:complexType>

  <!-- accelerate: a direction, how much to add to the velocity each frame, and optionally the variable it burns. -->
  <xs:complexType name="thrustType" mixed="true">
    <xs:sequence>
      <xs:group ref="valueTag" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="direction" type="directionType" use="required" />
    <xs:attribute name="burn" type="xs:string" use="optional" />
  </xs:complexType>

  <!-- turn: left or right, and how many degrees a frame while the key is held. -->
  <xs:complexType name="turnType" mixed="true">
    <xs:sequence>
      <xs:group ref="valueTag" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="direction" type="turnDirectionType" use="required" />
  </xs:complexType>

  <!-- thrust: how much to add to the velocity each frame along the heading, and optionally the variable it burns. -->
  <xs:complexType name="aheadType" mixed="true">
    <xs:sequence>
      <xs:group ref="valueTag" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="burn" type="xs:string" use="optional" />
  </xs:complexType>

  <!-- release: the objects (a pool, a group) to put back in play, and how many (one if left out). -->
  <xs:complexType name="releaseType" mixed="true">
    <xs:sequence>
      <xs:group ref="valueTag" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="object" type="xs:string" use="required" />
  </xs:complexType>

  <!-- deflect: the widest angle, in degrees, a bounce off another object leaves at (at the ends of the side it hit). -->
  <xs:complexType name="deflectType" mixed="true">
    <xs:sequence>
      <xs:group ref="valueTag" minOccurs="0" />
    </xs:sequence>
  </xs:complexType>

  <!-- jump: a direction, how far, and how many seconds it takes (0.3 if left out). -->
  <xs:complexType name="jumpType">
    <xs:sequence>
      <xs:element name="distance" type="valueType" />
      <xs:element name="seconds" type="valueType" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="direction" type="directionType" use="required" />
  </xs:complexType>

  <!-- climb: up or down, the class of what is climbed (a ladder), and the step a frame. -->
  <xs:complexType name="climbType" mixed="true">
    <xs:sequence>
      <xs:group ref="valueTag" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="direction" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="up" />
          <xs:enumeration value="down" />
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="class" type="xs:string" use="required" />
  </xs:complexType>

  <!-- One character of a <map>'s rows. -->
  <xs:simpleType name="mapCharType">
    <xs:restriction base="xs:string">
      <xs:length value="1" />
    </xs:restriction>
  </xs:simpleType>

  <!-- A key of a recorded <demo>: which, and the frame it happened at. -->
  <xs:complexType name="demoKeyType">
    <xs:simpleContent>
      <xs:extension base="xs:unsignedInt">
        <xs:attribute name="button" type="xs:string" use="required" />
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- A bitmap's <color>: with no char=, the color of its '*'s; with char="w", of its 'w's. -->
  <xs:complexType name="bitmapColorType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="char" type="mapCharType" use="optional" />
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- maze: the <map> an object walks, and each class that is a wall to it (only while it shows sprite=, if given). -->
  <xs:complexType name="mazeType">
    <xs:sequence>
      <xs:element name="wall" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="class" type="xs:string" use="required" />
          <xs:attribute name="sprite" type="xs:string" use="optional" />
        </xs:complexType>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="map" type="xs:string" use="required" />
  </xs:complexType>

  <!-- go: the way to turn at the first gap, and the speed (pixels a frame). -->
  <xs:complexType name="goType" mixed="true">
    <xs:sequence>
      <xs:group ref="valueTag" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="direction" type="directionType" use="required" />
  </xs:complexType>

  <!--
    hunt: what to hunt, how fast, and how the target is found from it: tiles
    in front of it (ahead), as far again past that as a partner is short of
    it (with), and, within that many tiles of it, another object instead
    (retreat).
  -->
  <xs:complexType name="huntType">
    <xs:sequence>
      <xs:element name="speed" type="valueType" />
      <xs:element name="ahead" type="valueType" minOccurs="0" />
      <xs:element name="with" minOccurs="0">
        <xs:complexType>
          <xs:attribute name="object" type="xs:string" use="required" />
        </xs:complexType>
      </xs:element>
      <xs:element name="retreat" minOccurs="0">
        <xs:complexType mixed="true">
          <xs:sequence>
            <xs:group ref="valueTag" minOccurs="0" />
          </xs:sequence>
          <xs:attribute name="object" type="xs:string" use="required" />
        </xs:complexType>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="object" type="xs:string" use="required" />
  </xs:complexType>

  <!-- wander: how fast. -->
  <xs:complexType name="wanderType">
    <xs:sequence>
      <xs:element name="speed" type="valueType" />
    </xs:sequence>
  </xs:complexType>

  <!-- chase: the object to head for, how fast, and (if given) how near is near enough to stop. -->
  <xs:complexType name="chaseType">
    <xs:sequence>
      <xs:element name="speed" type="valueType" />
      <xs:element name="near" type="valueType" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="object" type="xs:string" use="required" />
  </xs:complexType>

  <xs:group name="command">
    <xs:choice>
      <xs:element name="bounce" type="emptyType" />
      <xs:element name="deflect" type="deflectType" />
      <xs:element name="stick" type="emptyType" />
      <xs:element name="wrap" type="emptyType" />
      <xs:element name="ride" type="emptyType" />
      <xs:element name="carry" type="emptyType" />
      <xs:element name="drop" type="emptyType" />
      <xs:element name="track" type="emptyType" />
      <xs:element name="die" type="emptyType" />
      <xs:element name="stop" type="emptyType" />
      <!-- <reset /> puts back the object running it; object= that object
           or group; scene= every object of that scene, as it started; way=
           the scene that way of the current scene leads to. -->
      <xs:element name="reset">
        <xs:complexType>
          <xs:attribute name="object" type="xs:string" use="optional" />
          <xs:attribute name="scene" type="xs:string" use="optional" />
          <xs:attribute name="way" type="xs:string" use="optional" />
        </xs:complexType>
      </xs:element>
      <!-- <enter scene="room2" />: that scene becomes its state's current one;
           <enter way="east" />: the scene the current scene's way leads to. -->
      <xs:element name="enter">
        <xs:complexType>
          <xs:attribute name="scene" type="xs:string" use="optional" />
          <xs:attribute name="way" type="xs:string" use="optional" />
        </xs:complexType>
      </xs:element>
      <xs:element name="inc" type="variableReferenceType" />
      <xs:element name="dec" type="variableReferenceType" />
      <!-- copy: the variable into= takes the number variable= holds now (both owner.variable) -->
      <xs:element name="copy">
        <xs:complexType>
          <xs:attribute name="variable" type="xs:string" use="required" />
          <xs:attribute name="into" type="xs:string" use="required" />
        </xs:complexType>
      </xs:element>
      <!-- turns: a <player> for each player taking turns, each with the state that says whose turn it is -->
      <xs:element name="turns">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="player" maxOccurs="unbounded">
              <xs:complexType>
                <xs:attribute name="state" type="xs:string" use="optional" />
              </xs:complexType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <!-- pass: the next player's turn; out: this player is out, and the next player's turn -->
      <xs:element name="pass" type="emptyType" />
      <!-- demo: the game's recorded <demo> plays, until a key is pressed -->
      <xs:element name="demo" type="emptyType" />
      <xs:element name="out" type="emptyType" />
      <!-- rank: the entry variable= is of goes into the group into= (the best first), in place by that variable -->
      <xs:element name="rank">
        <xs:complexType>
          <xs:attribute name="variable" type="xs:string" use="required" />
          <xs:attribute name="into" type="xs:string" use="required" />
        </xs:complexType>
      </xs:element>
      <xs:element name="move" type="stepType" />
      <xs:element name="hop" type="stepType" />
      <xs:element name="jump" type="jumpType" />
      <!-- land: stand on top of the object touched; leap: a jump of that height under the object's own pull -->
      <xs:element name="land" type="emptyType" />
      <xs:element name="leap" type="valueType" />
      <xs:element name="climb" type="climbType" />
      <!-- chase: head for an object; aim: face it, so the next <fire> goes straight at it -->
      <xs:element name="chase" type="chaseType" />
      <xs:element name="go" type="goType" />
      <xs:element name="hunt" type="huntType" />
      <xs:element name="wander" type="wanderType" />
      <xs:element name="aim">
        <xs:complexType>
          <xs:attribute name="object" type="xs:string" use="required" />
        </xs:complexType>
      </xs:element>
      <xs:element name="reverse" type="emptyType" />
      <xs:element name="become">
        <xs:complexType>
          <xs:attribute name="sprite" type="xs:string" use="required" />
          <xs:attribute name="object" type="xs:string" use="optional" />
          <!-- only those showing this look change -->
          <xs:attribute name="from" type="xs:string" use="optional" />
        </xs:complexType>
      </xs:element>
      <xs:element name="reveal" type="releaseType" />
      <xs:element name="accelerate" type="thrustType" />
      <xs:element name="turn" type="turnType" />
      <xs:element name="thrust" type="aheadType" />
      <xs:element name="release" type="releaseType" />
      <xs:element name="push">
        <xs:complexType>
          <xs:attribute name="state" type="xs:string" use="required" />
        </xs:complexType>
      </xs:element>
      <!-- <pop /> goes back to the state underneath; <pop state="..." /> puts
           that state in place of this one. -->
      <xs:element name="pop">
        <xs:complexType>
          <xs:attribute name="state" type="xs:string" use="optional" />
        </xs:complexType>
      </xs:element>
      <xs:element name="fire">
        <xs:complexType>
          <xs:attribute name="object" type="xs:string" use="required" />
        </xs:complexType>
      </xs:element>
      <xs:element name="trigger">
        <xs:complexType>
          <xs:attribute name="object" type="xs:string" use="required" />
          <xs:attribute name="action" type="xs:string" use="required" />
        </xs:complexType>
      </xs:element>
      <xs:element name="play">
        <xs:complexType>
          <xs:attribute name="sound" type="xs:string" use="required" />
        </xs:complexType>
      </xs:element>
      <xs:element name="silence">
        <xs:complexType>
          <xs:attribute name="sound" type="xs:string" use="required" />
        </xs:complexType>
      </xs:element>
      <xs:element name="follow" type="followType" />
    </xs:choice>
  </xs:group>

  <!--
    follow: the object sets off along one of the game's <paths>. With object=
    every object of that name or group does, each <stagger> seconds after the
    one before (0 if left out).
  -->
  <xs:complexType name="followType">
    <xs:sequence>
      <xs:element name="stagger" type="valueType" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="path" type="xs:string" use="required" />
    <xs:attribute name="object" type="xs:string" use="optional" />
  </xs:complexType>

  <!--
    A path: how fast it is flown (pixels a frame), where it begins (left out:
    wherever the object is), then its legs in order. A step moves the object
    by x and y from where the step began, and runs its commands as it sets
    off; home takes it back to where it started the game.
  -->
  <xs:complexType name="pathStepType">
    <xs:sequence>
      <xs:element name="x" type="valueType" />
      <xs:element name="y" type="valueType" />
      <xs:group ref="command" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="pathType">
    <xs:sequence>
      <xs:element name="speed" type="valueType" />
      <xs:element name="start" type="vector2Type" minOccurs="0" />
      <xs:choice maxOccurs="unbounded">
        <xs:element name="step" type="pathStepType" />
        <xs:element name="home" type="emptyType" />
      </xs:choice>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required" />
  </xs:complexType>

  <!--
    A collision rule. With edge it is about a screen edge, and takes no class
    or object; without, it is about another object, narrowed by class and/or
    object (neither: anything). Either is passed over while the object is
    touching something of the unless class. A
    rule about another object may also begin with slower and/or faster, which
    hold it to when the object's own speed is under (slower) or at least
    (faster) that number. With sprite, it runs only while the object shows its
    sprite of that name (see become).
  -->
  <xs:complexType name="collisionType">
    <xs:sequence>
      <xs:element name="slower" type="valueType" minOccurs="0" />
      <xs:element name="faster" type="valueType" minOccurs="0" />
      <xs:group ref="command" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
    <xs:attribute name="edge" type="edgeType" use="optional" />
    <xs:attribute name="class" type="xs:string" use="optional" />
    <xs:attribute name="object" type="xs:string" use="optional" />
    <xs:attribute name="unless" type="xs:string" use="optional" />
    <xs:attribute name="sprite" type="xs:string" use="optional" />
  </xs:complexType>

  <!-- A named thing an object can do, run by a <trigger>. -->
  <xs:complexType name="actionType">
    <xs:sequence>
      <xs:group ref="command" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required" />
  </xs:complexType>

  <!-- What pressing a key does in a state: button is one key, or several
       separated by spaces ("a left"); or, with axis= (mouse.x, mouse.y,
       pad1.x, ...) instead, the <trigger> run as that control moves. One of
       the two, which the engine checks. -->
  <xs:complexType name="inputType">
    <xs:sequence>
      <xs:group ref="command" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
    <xs:attribute name="button" type="xs:string" use="optional" />
    <xs:attribute name="axis" type="xs:string" use="optional" />
  </xs:complexType>

  <!--
    Checked every frame. One test, then the commands to run when it holds:
    atleast / atmost read the variable named by the variable attribute off
    every object that matches class and/or object; remaining counts the
    matching objects still in play. Or, with set="name" and nothing else, a
    named <conditions> set's conditions in its place.
  -->
  <xs:complexType name="conditionType">
    <xs:sequence minOccurs="0">
      <xs:choice>
        <xs:element name="atleast" type="compareType" />
        <xs:element name="atmost" type="compareType" />
        <xs:element name="above" type="compareType" />
        <xs:element name="below" type="compareType" />
        <xs:element name="equal" type="compareType" />
        <xs:element name="remaining" type="valueType" />
      </xs:choice>
      <xs:group ref="command" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
    <xs:attribute name="class" type="xs:string" use="optional" />
    <xs:attribute name="object" type="xs:string" use="optional" />
    <xs:attribute name="variable" type="xs:string" use="optional" />
    <xs:attribute name="set" type="xs:string" use="optional" />
    <!-- a scene from= this one's can put a condition of the same name in its place -->
    <xs:attribute name="name" type="xs:string" use="optional" />
  </xs:complexType>

  <!--
    Timers: each goes off after a number of seconds - <every> again and again
    (worked out again each time, so a <random> waits a new time), <after>
    once - and runs its commands. An object's count while it is shown and in
    play; a state's while it is the current state. A reset starts them over.
  -->
  <xs:complexType name="timerType">
    <xs:sequence>
      <xs:choice>
        <xs:element name="every" type="valueType" />
        <xs:element name="after" type="valueType" />
      </xs:choice>
      <xs:group ref="command" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
    <!-- a scene from= this one's can put a timer of the same name in its place -->
    <xs:attribute name="name" type="xs:string" use="optional" />
    <!-- an object's timer that counts only while it shows this look -->
    <xs:attribute name="sprite" type="xs:string" use="optional" />
  </xs:complexType>

  <xs:complexType name="timersType">
    <xs:sequence>
      <xs:element name="timer" type="timerType" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <!-- Some of two numbers: a group's or a member's <position> and <velocity>, and an object's <velocity> (a half left out is 0). -->
  <xs:complexType name="partialVector2Type">
    <xs:sequence>
      <xs:element name="x" type="valueType" minOccurs="0" />
      <xs:element name="y" type="valueType" minOccurs="0" />
    </xs:sequence>
  </xs:complexType>

  <!-- How an object's shape is tested: as a box (the default), or by the pixels drawn. -->
  <xs:simpleType name="collisionShapeType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="box" />
      <xs:enumeration value="pixel" />
    </xs:restriction>
  </xs:simpleType>

  <!-- Whether collisions are on, whether the object moves in lockstep with the others of its group, how its shape is tested, then the rules. -->
  <xs:complexType name="collisionsType">
    <xs:sequence>
      <xs:element name="enabled" type="xs:boolean" />
      <xs:element name="lockstep" type="xs:boolean" minOccurs="0" />
      <xs:element name="type" type="collisionShapeType" minOccurs="0" />
      <xs:element name="collision" type="collisionType" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="actionsType">
    <xs:sequence>
      <xs:element name="action" type="actionType" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <!-- The variables an object owns. -->
  <xs:complexType name="variablesType">
    <xs:sequence>
      <xs:element name="variable" type="variableType" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <!-- Anything that can be drawn, moved or collided with. -->
  <xs:complexType name="objectType">
    <xs:sequence>
      <xs:element name="sprite" type="spriteType" maxOccurs="unbounded" />
      <xs:element name="animation" type="animationType" minOccurs="0" />
      <xs:element name="position" type="vector2Type" />
      <xs:element name="velocity" type="partialVector2Type" minOccurs="0" />
      <xs:element name="acceleration" type="vector2Type" minOccurs="0" />
      <xs:element name="heading" type="valueType" minOccurs="0" />
      <xs:element name="drag" type="valueType" minOccurs="0" />
      <xs:element name="facing" type="directionType" minOccurs="0" />
      <xs:element name="maze" type="mazeType" minOccurs="0" />
      <xs:element name="hidden" type="xs:boolean" minOccurs="0" />
      <xs:element name="drawn" type="xs:boolean" minOccurs="0" />
      <xs:element name="collisions" type="collisionsType" minOccurs="0" />
      <xs:element name="actions" type="actionsType" minOccurs="0" />
      <xs:element name="variables" type="variablesType" minOccurs="0" />
      <xs:element name="timers" type="timersType" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required" />
    <xs:attribute name="class" type="xs:string" use="optional" />
  </xs:complexType>

  <!--
    Objects that share a description: a lane of logs or cars, the pads at the
    top of Frogger, a wall of bricks. The group says what its members have in
    common (all of it optional) and each member says only what is its own; what
    a member leaves out it takes from its group, and after that it must be as
    complete as an object. The group's class is every member's, and the group's
    name means all of them.

    The members are either listed, each a <member> (called name="..." if it
    says so, otherwise the group's name, a dot, and its number counting from 1,
    lane3.2), or laid out in <columns> and <rows>: a cell to each place, the
    group's <position> the top left of the first, with <padding> the gaps
    between them. A cell is called the group's name, its column and its row
    (bricks.5.3), counting from 1. A <row number="...">, <column number="...">
    or <cell row="..." column="..."> then changes what the cells it picks have;
    a row or column and a cell may both, and the cell wins, but a row and a
    column (or two rows) that pick one cell may not change the same thing in it.
  -->
  <xs:complexType name="memberType">
    <xs:sequence>
      <xs:element name="sprite" type="spriteChangeType" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="animation" type="animationType" minOccurs="0" />
      <xs:element name="position" type="partialVector2Type" minOccurs="0" />
      <xs:element name="velocity" type="partialVector2Type" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="optional" />
  </xs:complexType>

  <!-- One thing a state shows: an object (or a group) by name, a named
       <shows> set, or (in a state's own <shows>) another state, whose objects
       are drawn still underneath. One of the three. -->
  <xs:complexType name="showType">
    <xs:attribute name="object" type="xs:string" use="optional" />
    <xs:attribute name="set" type="xs:string" use="optional" />
    <xs:attribute name="state" type="xs:string" use="optional" />
  </xs:complexType>

  <!--
    Which rows or columns: numbers counting from 1, one or several (2, or
    2 4 6), or odd or even.
  -->
  <xs:simpleType name="pickType">
    <xs:restriction base="xs:string">
      <xs:pattern value="\s*(odd|even|[1-9][0-9]*)(\s+(odd|even|[1-9][0-9]*))*\s*" />
    </xs:restriction>
  </xs:simpleType>

  <!--
    What the rows (or columns) it picks change. Its padding is the gap before
    it: a row's <y> the gap above it and its <x> the gaps between its cells, a
    column's <x> the gap to its left. The first row and column have no gap
    before them.
  -->
  <xs:complexType name="lineOfCellsType">
    <xs:sequence>
      <xs:element name="sprite" type="spriteChangeType" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="animation" type="animationType" minOccurs="0" />
      <xs:element name="velocity" type="partialVector2Type" minOccurs="0" />
      <xs:element name="padding" type="partialVector2Type" minOccurs="0" />
      <xs:element name="variables" type="variablesType" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="number" type="pickType" use="required" />
  </xs:complexType>

  <!-- What one cell changes, and a name of its own. -->
  <xs:complexType name="cellType">
    <xs:sequence>
      <xs:element name="sprite" type="spriteChangeType" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="animation" type="animationType" minOccurs="0" />
      <xs:element name="velocity" type="partialVector2Type" minOccurs="0" />
      <xs:element name="variables" type="variablesType" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="row" type="xs:positiveInteger" use="required" />
    <xs:attribute name="column" type="xs:positiveInteger" use="required" />
    <xs:attribute name="name" type="xs:string" use="optional" />
  </xs:complexType>

  <!-- How a group lays out cells: before its sprites. -->
  <xs:group name="groupLayout">
    <xs:sequence>
      <xs:element name="columns" type="xs:positiveInteger" minOccurs="0" />
      <xs:element name="rows" type="xs:positiveInteger" minOccurs="0" />
      <xs:element name="padding" type="partialVector2Type" minOccurs="0" />
    </xs:sequence>
  </xs:group>

  <!-- What a group gives after its sprites. -->
  <xs:group name="groupParts">
    <xs:sequence>
      <xs:element name="animation" type="animationType" minOccurs="0" />
      <xs:element name="position" type="partialVector2Type" minOccurs="0" />
      <xs:element name="velocity" type="partialVector2Type" minOccurs="0" />
      <xs:element name="acceleration" type="vector2Type" minOccurs="0" />
      <xs:element name="facing" type="directionType" minOccurs="0" />
      <xs:element name="maze" type="mazeType" minOccurs="0" />
      <xs:element name="hidden" type="xs:boolean" minOccurs="0" />
      <xs:element name="drawn" type="xs:boolean" minOccurs="0" />
      <xs:element name="collisions" type="collisionsType" minOccurs="0" />
      <xs:element name="actions" type="actionsType" minOccurs="0" />
      <xs:element name="variables" type="variablesType" minOccurs="0" />
      <xs:element name="timers" type="timersType" minOccurs="0" />
    </xs:sequence>
  </xs:group>

  <!-- A group's members, or what changes its cells. -->
  <xs:group name="groupMembers">
    <xs:choice>
      <xs:element name="member" type="memberType" maxOccurs="unbounded" />
      <xs:sequence>
        <xs:element name="row" type="lineOfCellsType" minOccurs="0" maxOccurs="unbounded" />
        <xs:element name="column" type="lineOfCellsType" minOccurs="0" maxOccurs="unbounded" />
        <xs:element name="cell" type="cellType" minOccurs="0" maxOccurs="unbounded" />
      </xs:sequence>
    </xs:choice>
  </xs:group>

  <xs:complexType name="groupType">
    <xs:sequence>
      <xs:group ref="groupLayout" />
      <xs:element name="sprite" type="spriteType" minOccurs="0" maxOccurs="unbounded" />
      <xs:group ref="groupParts" />
      <xs:choice>
        <xs:group ref="groupMembers" />
        <xs:element name="group" type="innerGroupType" maxOccurs="unbounded" />
      </xs:choice>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required" />
    <xs:attribute name="class" type="xs:string" use="optional" />
  </xs:complexType>

  <!-- A group inside another: the same, except that a sprite of the outer group's (by name) need only give what changes. -->
  <xs:complexType name="innerGroupType">
    <xs:sequence>
      <xs:group ref="groupLayout" />
      <xs:element name="sprite" type="spriteChangeType" minOccurs="0" maxOccurs="unbounded" />
      <xs:group ref="groupParts" />
      <xs:choice>
        <xs:group ref="groupMembers" />
        <xs:element name="group" type="innerGroupType" maxOccurs="unbounded" />
      </xs:choice>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required" />
    <xs:attribute name="class" type="xs:string" use="optional" />
  </xs:complexType>

  <!--
    An object on a <map>: as any other, but with no <position>; char= picks
    the one tile of the map's rows it starts on.
  -->
  <xs:complexType name="mapObjectType">
    <xs:sequence>
      <xs:element name="sprite" type="spriteType" maxOccurs="unbounded" />
      <xs:element name="animation" type="animationType" minOccurs="0" />
      <xs:element name="velocity" type="partialVector2Type" minOccurs="0" />
      <xs:element name="acceleration" type="vector2Type" minOccurs="0" />
      <xs:element name="heading" type="valueType" minOccurs="0" />
      <xs:element name="drag" type="valueType" minOccurs="0" />
      <xs:element name="facing" type="directionType" minOccurs="0" />
      <xs:element name="maze" type="mazeType" minOccurs="0" />
      <xs:element name="hidden" type="xs:boolean" minOccurs="0" />
      <xs:element name="drawn" type="xs:boolean" minOccurs="0" />
      <xs:element name="collisions" type="collisionsType" minOccurs="0" />
      <xs:element name="actions" type="actionsType" minOccurs="0" />
      <xs:element name="variables" type="variablesType" minOccurs="0" />
      <xs:element name="timers" type="timersType" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required" />
    <xs:attribute name="class" type="xs:string" use="optional" />
    <xs:attribute name="char" type="mapCharType" use="required" />
  </xs:complexType>

  <!--
    A group on a <map>: a member on each tile of the character char= picks,
    or groups inside it that each pick one (and change its sprites by name,
    as an inner group does). The map says where, so it has no layout, no
    <position> and no <member>s.
  -->
  <xs:complexType name="mapGroupType">
    <xs:sequence>
      <xs:element name="sprite" type="spriteChangeType" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="animation" type="animationType" minOccurs="0" />
      <xs:element name="velocity" type="partialVector2Type" minOccurs="0" />
      <xs:element name="acceleration" type="vector2Type" minOccurs="0" />
      <xs:element name="facing" type="directionType" minOccurs="0" />
      <xs:element name="maze" type="mazeType" minOccurs="0" />
      <xs:element name="hidden" type="xs:boolean" minOccurs="0" />
      <xs:element name="drawn" type="xs:boolean" minOccurs="0" />
      <xs:element name="collisions" type="collisionsType" minOccurs="0" />
      <xs:element name="actions" type="actionsType" minOccurs="0" />
      <xs:element name="variables" type="variablesType" minOccurs="0" />
      <xs:element name="timers" type="timersType" minOccurs="0" />
      <xs:element name="group" type="mapGroupType" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required" />
    <xs:attribute name="class" type="xs:string" use="optional" />
    <xs:attribute name="char" type="mapCharType" use="optional" />
  </xs:complexType>

  <!--
    Level data: the size of a tile, where the top left of the map is, its
    <row>s of characters (a character a tile, every row as wide), and the
    groups and objects that say what each character is. A character nothing
    picks is an empty tile. The map's name means everything on it.
  -->
  <xs:complexType name="mapType">
    <xs:sequence>
      <xs:element name="tile">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="width" type="valueType" />
            <xs:element name="height" type="valueType" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="position" type="vector2Type" />
      <xs:element name="row" type="xs:string" maxOccurs="unbounded" />
      <xs:choice maxOccurs="unbounded">
        <xs:element name="group" type="mapGroupType" />
        <xs:element name="object" type="mapObjectType" />
      </xs:choice>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required" />
  </xs:complexType>

  <!-- Objects and groups: the game's, a state's, or the kit of its scenes. -->
  <xs:complexType name="objectsType">
    <xs:choice maxOccurs="unbounded">
      <xs:element name="object" type="objectType" />
      <xs:element name="group" type="groupType" />
      <xs:element name="map" type="mapType" />
    </xs:choice>
  </xs:complexType>

  <!--
    An object in a scene: the same as any other, or, when it is named after
    a piece of the kit (or one of the scene it is from=), that piece taken,
    changed by what it gives: whole <sprite>s by name, either half of the
    <position> or the <velocity>, <hidden>, <drawn> and <variables>. So
    everything here may be left out, and the engine checks that an object of
    the scene's own is complete.
  -->
  <xs:complexType name="sceneObjectType">
    <xs:sequence>
      <xs:element name="sprite" type="spriteType" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="animation" type="animationType" minOccurs="0" />
      <xs:element name="position" type="partialVector2Type" minOccurs="0" />
      <xs:element name="velocity" type="partialVector2Type" minOccurs="0" />
      <xs:element name="acceleration" type="vector2Type" minOccurs="0" />
      <xs:element name="heading" type="valueType" minOccurs="0" />
      <xs:element name="drag" type="valueType" minOccurs="0" />
      <xs:element name="facing" type="directionType" minOccurs="0" />
      <xs:element name="maze" type="mazeType" minOccurs="0" />
      <xs:element name="hidden" type="xs:boolean" minOccurs="0" />
      <xs:element name="drawn" type="xs:boolean" minOccurs="0" />
      <xs:element name="collisions" type="collisionsType" minOccurs="0" />
      <xs:element name="actions" type="actionsType" minOccurs="0" />
      <xs:element name="variables" type="variablesType" minOccurs="0" />
      <xs:element name="timers" type="timersType" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required" />
    <xs:attribute name="class" type="xs:string" use="optional" />
  </xs:complexType>

  <xs:complexType name="sceneObjectsType">
    <xs:choice maxOccurs="unbounded">
      <xs:element name="object" type="sceneObjectType" />
      <xs:element name="group" type="groupType" />
      <xs:element name="map" type="mapType" />
    </xs:choice>
  </xs:complexType>

  <xs:complexType name="conditionsType">
    <xs:sequence>
      <xs:element name="condition" type="conditionType" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <!--
    One place of a state: its own numbers (read inside it by their plain
    names), its objects, and the conditions and timers that run while it is
    its state's current scene. from= starts it as a copy of an earlier
    scene: its objects, variables and ways, changed by its own, and its
    conditions and timers, unless it has its own.
  -->
  <!-- Where a scene's ways lead: <way name="east" scene="screen2" />, a
       scene of the same state, gone to by <enter way="east" />. -->
  <xs:complexType name="waysType">
    <xs:sequence>
      <xs:element name="way" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="name" type="xs:string" use="required" />
          <xs:attribute name="scene" type="xs:string" use="required" />
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="sceneType">
    <xs:sequence>
      <xs:element name="ways" type="waysType" minOccurs="0" />
      <xs:element name="variables" type="variablesType" minOccurs="0" />
      <xs:element name="objects" type="sceneObjectsType" minOccurs="0" />
      <xs:element name="conditions" type="conditionsType" minOccurs="0" />
      <xs:element name="timers" type="timersType" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required" />
    <xs:attribute name="from" type="xs:string" use="optional" />
  </xs:complexType>

  <!-- The kit of pieces the scenes take, then the scenes; the first is current when the game starts. -->
  <xs:complexType name="scenesType">
    <xs:sequence>
      <xs:element name="objects" type="objectsType" minOccurs="0" />
      <xs:element name="scene" type="sceneType" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <xs:element name="game">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="window">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="width" type="xs:unsignedShort" />
              <xs:element name="height" type="xs:unsignedShort" />
              <xs:element name="background" type="xs:string" />
              <xs:element name="fullscreen" type="xs:boolean" />
              <xs:element name="framerate" type="xs:unsignedByte" />
            </xs:sequence>
            <xs:attribute name="name" type="xs:string" use="required" />
          </xs:complexType>
        </xs:element>
        <xs:element name="variables">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="variable" type="variableType" maxOccurs="unbounded" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="sounds" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="sound" type="soundType" maxOccurs="unbounded" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="paths" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="path" type="pathType" maxOccurs="unbounded" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="objects" type="objectsType" minOccurs="0" />
        <!--
          What a full <reset /> passes over: each <keep> names an object or a
          group, which keeps what it holds (a best score) into the next game.
        -->
        <xs:element name="keeps" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="keep" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="object" type="xs:string" use="required" />
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="states">
          <xs:complexType>
            <xs:sequence>
              <!--
                A named set of key bindings that states can share: a state's
                <inputs keys="name"> takes them, and its own <input>s go over
                them, key by key.
              -->
              <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element name="keys">
                  <xs:complexType>
                    <xs:sequence>
                      <xs:element name="input" type="inputType" maxOccurs="unbounded" />
                    </xs:sequence>
                    <xs:attribute name="name" type="xs:string" use="required" />
                  </xs:complexType>
                </xs:element>
                <!--
                  A named set of objects that states can share: a state's
                  <show set="name" /> shows them, in order, where it stands.
                  A set can take a set written before it.
                -->
                <xs:element name="shows">
                  <xs:complexType>
                    <xs:sequence>
                      <xs:element name="show" type="showType" maxOccurs="unbounded" />
                    </xs:sequence>
                    <xs:attribute name="name" type="xs:string" use="required" />
                  </xs:complexType>
                </xs:element>
                <!--
                  A named set of conditions that states can share: a state's
                  <condition set="name" /> checks them, in order, where it
                  stands. A set can take a set written before it.
                -->
                <xs:element name="conditions">
                  <xs:complexType>
                    <xs:sequence>
                      <xs:element name="condition" type="conditionType" maxOccurs="unbounded" />
                    </xs:sequence>
                    <xs:attribute name="name" type="xs:string" use="required" />
                  </xs:complexType>
                </xs:element>
              </xs:choice>
              <xs:element name="state" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <!-- the state's own objects, in play in every scene of it -->
                    <xs:element name="objects" type="objectsType" minOccurs="0" />
                    <xs:element name="scenes" type="scenesType" minOccurs="0" />
                    <xs:element name="shows" minOccurs="0">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="show" type="showType" maxOccurs="unbounded" />
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="inputs">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="input" type="inputType" minOccurs="0" maxOccurs="unbounded" />
                        </xs:sequence>
                        <xs:attribute name="keys" type="xs:string" use="optional" />
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="conditions" type="conditionsType" minOccurs="0" />
                    <xs:element name="timers" type="timersType" minOccurs="0" />
                  </xs:sequence>
                  <xs:attribute name="name" type="xs:string" use="required" />
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <!--
          A recorded game for the attract mode (written by recording a game with xgecli):
          the random seed it was played with, how many frames long it is,
          then each key pressed and let go, at the frame it happened. A
          <demo /> command plays it.
        -->
        <xs:element name="demo" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="seed" type="xs:unsignedInt" />
              <xs:element name="frames" type="xs:unsignedInt" />
              <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element name="press" type="demoKeyType" />
                <xs:element name="release" type="demoKeyType" />
              </xs:choice>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
