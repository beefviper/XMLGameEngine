<!-- kaboom.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Sept 30, 2026 -->

<!--
  Kaboom!, after the 1981 Atari 2600 game. The Mad Bomber paces the rooftop at
  the top of the screen, changing direction whenever he likes, and drops bombs
  as he goes; you slide a bucket along the bottom to catch them. Because the
  bombs leave from wherever he is, they come down in trails and clusters that
  follow his path: a run to the left, a doubling back, a burst in one place.
  Every bomb caught scores; one that reaches the ground sets off every bomb
  still falling and costs a bucket (you start with three), and with none left
  it is game over. There are three waves, each with a quicker bomber, faster
  bombs and more of them, worth one, two and three points a bomb. Reach `goal`
  points to win (the arcade game has no end).

  How it is written:
  * The bomber has two <timers>. One <reverse />s him after a random wait
    (worked out again each time), so his path is never the same; the other
    <fire>s a bomb every `dropN` seconds. He has <facing>down</facing>, so a
    bomb leaves from under him and falls at its own speed.
  * The bombs of a wave are a pool, a <group> of hidden bombs that the bomber
    fires one at a time and that <die /> back into the pool when caught.
  * A bomb that hits the ground runs <reset object="bombsN" />, which puts
    every bomb of the wave back in the pool at once: the explosion.
  * Each wave is a <state> with its own bomber and pool, and a <condition> on
    the score moves on to the next. The keys are one <keys> set the waves share.
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../xgedef.xsd">
  <window name="Kaboom!">
    <width>800</width>
    <height>600</height>
    <background>color.black</background>
    <fullscreen>false</fullscreen>
    <framerate>60</framerate>
  </window>
  <variables>
    <variable name="bucketwidth">110</variable>
    <variable name="bucketheight">18</variable>
    <variable name="bomb">8</variable>
    <variable name="step">9</variable>
    <variable name="margin">20</variable>
    <variable name="roof">104</variable>
    <!-- each wave: how fast the bomber paces, how often he drops a bomb (seconds), and how fast it falls -->
    <variable name="pace1">3</variable>
    <variable name="drop1">0.55</variable>
    <variable name="fall1">3</variable>
    <variable name="pace2">4.5</variable>
    <variable name="drop2">0.42</variable>
    <variable name="fall2">4.5</variable>
    <variable name="pace3">6</variable>
    <variable name="drop3">0.32</variable>
    <variable name="fall3">6</variable>
    <variable name="wave2at">15</variable>
    <variable name="wave3at">45</variable>
    <variable name="goal">90</variable>
  </variables>
  <sounds>
    <!-- a bomb caught: a quick rising blip -->
    <sound name="catch" wave="square">
      <volume>0.2</volume>
      <note pitch="C5" to="G5">0.05</note>
    </sound>
    <!-- a bomb on the ground: a burst of noise that sinks -->
    <sound name="boom" wave="noise">
      <volume>0.45</volume>
      <note pitch="3000" to="200">0.6</note>
    </sound>
    <!-- a new wave -->
    <sound name="wave" wave="triangle">
      <volume>0.4</volume>
      <note pitch="C4">0.08</note>
      <note pitch="E4">0.08</note>
      <note pitch="G4">0.08</note>
      <note pitch="C5">0.16</note>
    </sound>
    <!-- out of buckets -->
    <sound name="gameover" wave="square">
      <volume>0.2</volume>
      <note pitch="E4">0.2</note>
      <note pitch="D#4">0.2</note>
      <note pitch="D4">0.2</note>
      <note pitch="C#4" to="C3">0.6</note>
    </sound>
  </sounds>
  <objects>
    <!-- the rooftop the bomber walks along -->
    <object name="rooftop">
      <sprite>
        <rectangle>
          <width>window.right</width>
          <height>roof</height>
          <color>color.darkgrey</color>
        </rectangle>
      </sprite>
      <position><x>0</x><y>0</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="ledge">
      <sprite>
        <rectangle>
          <width>window.right</width>
          <height>6</height>
          <color>color.lightgrey</color>
        </rectangle>
      </sprite>
      <position><x>0</x><y>roof</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <!-- the wave 1 bomber: the same man, quicker, and dropping faster -->
    <object name="bomber1" class="bomber">
      <sprite>
        <bitmap>
          <row>....****....</row>
          <row>...******...</row>
          <row>..********..</row>
          <row>....****....</row>
          <row>...*.**.*...</row>
          <row>....****....</row>
          <row>..********..</row>
          <row>.**.****.**.</row>
          <row>.**.****.**.</row>
          <row>....****....</row>
          <row>....*..*....</row>
          <row>...**..**...</row>
          <scale>4</scale>
          <color>color.white</color>
        </bitmap>
      </sprite>
      <position><x>window.width.center - bomber1.width / 2</x><y>roof - bomber1.height</y></position>
      <velocity><x>pace1</x><y>0</y></velocity>
      <facing>down</facing>
      <collisions>
        <enabled>true</enabled>
        <collision edge="horizontal">
          <bounce />
        </collision>
      </collisions>
      <timers>
        <timer>
          <every><random min="0.3" max="1.4" /></every>
          <reverse />
        </timer>
        <timer>
          <every>drop1</every>
          <fire object="bombs1" />
        </timer>
      </timers>
    </object>
    <!-- the wave 2 bomber: the same man, quicker, and dropping faster -->
    <object name="bomber2" class="bomber">
      <sprite>
        <bitmap>
          <row>....****....</row>
          <row>...******...</row>
          <row>..********..</row>
          <row>....****....</row>
          <row>...*.**.*...</row>
          <row>....****....</row>
          <row>..********..</row>
          <row>.**.****.**.</row>
          <row>.**.****.**.</row>
          <row>....****....</row>
          <row>....*..*....</row>
          <row>...**..**...</row>
          <scale>4</scale>
          <color>color.white</color>
        </bitmap>
      </sprite>
      <position><x>window.width.center - bomber2.width / 2</x><y>roof - bomber2.height</y></position>
      <velocity><x>pace2</x><y>0</y></velocity>
      <facing>down</facing>
      <collisions>
        <enabled>true</enabled>
        <collision edge="horizontal">
          <bounce />
        </collision>
      </collisions>
      <timers>
        <timer>
          <every><random min="0.3" max="1.4" /></every>
          <reverse />
        </timer>
        <timer>
          <every>drop2</every>
          <fire object="bombs2" />
        </timer>
      </timers>
    </object>
    <!-- the wave 3 bomber: the same man, quicker, and dropping faster -->
    <object name="bomber3" class="bomber">
      <sprite>
        <bitmap>
          <row>....****....</row>
          <row>...******...</row>
          <row>..********..</row>
          <row>....****....</row>
          <row>...*.**.*...</row>
          <row>....****....</row>
          <row>..********..</row>
          <row>.**.****.**.</row>
          <row>.**.****.**.</row>
          <row>....****....</row>
          <row>....*..*....</row>
          <row>...**..**...</row>
          <scale>4</scale>
          <color>color.white</color>
        </bitmap>
      </sprite>
      <position><x>window.width.center - bomber3.width / 2</x><y>roof - bomber3.height</y></position>
      <velocity><x>pace3</x><y>0</y></velocity>
      <facing>down</facing>
      <collisions>
        <enabled>true</enabled>
        <collision edge="horizontal">
          <bounce />
        </collision>
      </collisions>
      <timers>
        <timer>
          <every><random min="0.3" max="1.4" /></every>
          <reverse />
        </timer>
        <timer>
          <every>drop3</every>
          <fire object="bombs3" />
        </timer>
      </timers>
    </object>
    <!-- the wave 1 bombs: ten in a pool, hidden until the bomber drops one -->
    <group name="bombs1" class="bombs">
      <sprite>
        <circle>
          <radius>bomb</radius>
          <color>color.lightgrey</color>
        </circle>
      </sprite>
      <position><x>0</x><y>0</y></position>
      <velocity><x>0</x><y>fall1</y></velocity>
      <hidden>true</hidden>
      <collisions>
        <enabled>false</enabled>
        <collision edge="bottom">
          <dec variable="bucket.buckets" />
          <play sound="boom" />
          <reset object="bombs1" />
        </collision>
        <collision object="bucket">
          <inc variable="bucket.score" />
          <play sound="catch" />
          <die />
        </collision>
      </collisions>
      <member />
      <member />
      <member />
      <member />
      <member />
      <member />
      <member />
      <member />
      <member />
      <member />
    </group>
    <!-- the wave 2 bombs: ten in a pool, hidden until the bomber drops one -->
    <group name="bombs2" class="bombs">
      <sprite>
        <circle>
          <radius>bomb</radius>
          <color>color.orange</color>
        </circle>
      </sprite>
      <position><x>0</x><y>0</y></position>
      <velocity><x>0</x><y>fall2</y></velocity>
      <hidden>true</hidden>
      <collisions>
        <enabled>false</enabled>
        <collision edge="bottom">
          <dec variable="bucket.buckets" />
          <play sound="boom" />
          <reset object="bombs2" />
        </collision>
        <collision object="bucket">
          <inc variable="bucket.score">2</inc>
          <play sound="catch" />
          <die />
        </collision>
      </collisions>
      <member />
      <member />
      <member />
      <member />
      <member />
      <member />
      <member />
      <member />
      <member />
      <member />
    </group>
    <!-- the wave 3 bombs: ten in a pool, hidden until the bomber drops one -->
    <group name="bombs3" class="bombs">
      <sprite>
        <circle>
          <radius>bomb</radius>
          <color>color.red</color>
        </circle>
      </sprite>
      <position><x>0</x><y>0</y></position>
      <velocity><x>0</x><y>fall3</y></velocity>
      <hidden>true</hidden>
      <collisions>
        <enabled>false</enabled>
        <collision edge="bottom">
          <dec variable="bucket.buckets" />
          <play sound="boom" />
          <reset object="bombs3" />
        </collision>
        <collision object="bucket">
          <inc variable="bucket.score">3</inc>
          <play sound="catch" />
          <die />
        </collision>
      </collisions>
      <member />
      <member />
      <member />
      <member />
      <member />
      <member />
      <member />
      <member />
      <member />
      <member />
    </group>
    <!-- the bucket -->
    <object name="bucket">
      <sprite>
        <rectangle>
          <width>bucketwidth</width>
          <height>bucketheight</height>
          <color>color.cyan</color>
        </rectangle>
      </sprite>
      <position><x>window.width.center - bucket.width / 2</x><y>window.bottom - bucket.height - margin</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>true</enabled>
        <collision edge="horizontal">
          <stick />
        </collision>
      </collisions>
      <actions>
        <action name="left">
          <move direction="left">step</move>
        </action>
        <action name="right">
          <move direction="right">step</move>
        </action>
      </actions>
      <variables>
        <variable name="score">0</variable>
        <variable name="buckets">3</variable>
      </variables>
    </object>
    <object name="scorelabel">
      <sprite>
        <text>
          <content>SCORE</content>
          <size>30</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position><x>margin</x><y>12</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="scorevalue">
      <sprite>
        <text>
          <number>bucket.score</number>
          <size>30</size>
          <color>color.cyan</color>
        </text>
      </sprite>
      <position><x>margin + scorelabel.width + 12</x><y>12</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="bucketsvalue">
      <sprite>
        <text>
          <number>bucket.buckets</number>
          <size>30</size>
          <color>color.red</color>
        </text>
      </sprite>
      <position><x>window.right - bucketsvalue.width - margin</x><y>12</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="bucketslabel">
      <sprite>
        <text>
          <content>BUCKETS</content>
          <size>30</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position><x>window.right - bucketsvalue.width - bucketslabel.width - margin - 12</x><y>12</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="wave1label">
      <sprite>
        <text>
          <content>WAVE 1</content>
          <size>30</size>
          <color>color.yellow</color>
        </text>
      </sprite>
      <position><x>window.width.center - wave1label.width / 2</x><y>12</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="wave2label">
      <sprite>
        <text>
          <content>WAVE 2</content>
          <size>30</size>
          <color>color.yellow</color>
        </text>
      </sprite>
      <position><x>window.width.center - wave2label.width / 2</x><y>12</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="wave3label">
      <sprite>
        <text>
          <content>WAVE 3</content>
          <size>30</size>
          <color>color.yellow</color>
        </text>
      </sprite>
      <position><x>window.width.center - wave3label.width / 2</x><y>12</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="title">
      <sprite>
        <text>
          <content>KABOOM!</content>
          <size>128</size>
          <color>color.red</color>
        </text>
      </sprite>
      <position><x>window.width.center - title.width / 2</x><y>window.height.center - title.height / 2 + (-110)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="help">
      <sprite>
        <text>
          <content>the mad bomber drops them; catch every one</content>
          <size>36</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position><x>window.width.center - help.width / 2</x><y>window.height.center - help.height / 2 + (-10)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="keys">
      <sprite>
        <text>
          <content>a and d, or the arrow keys, to move</content>
          <size>32</size>
          <color>color.lightgrey</color>
        </text>
      </sprite>
      <position><x>window.width.center - keys.width / 2</x><y>window.height.center - keys.height / 2 + (40)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="start">
      <sprite>
        <text>
          <content>spacebar to start</content>
          <size>48</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position><x>window.width.center - start.width / 2</x><y>window.height.center - start.height / 2 + (130)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="paused">
      <sprite>
        <text>
          <content>PAUSED</content>
          <size>128</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position><x>window.width.center - paused.width / 2</x><y>window.height.center - paused.height / 2 + (0)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="youwin">
      <sprite>
        <text>
          <content>YOU WIN</content>
          <size>128</size>
          <color>color.green</color>
        </text>
      </sprite>
      <position><x>window.width.center - youwin.width / 2</x><y>window.height.center - youwin.height / 2 + (-60)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="gameover">
      <sprite>
        <text>
          <content>GAME OVER</content>
          <size>128</size>
          <color>color.red</color>
        </text>
      </sprite>
      <position><x>window.width.center - gameover.width / 2</x><y>window.height.center - gameover.height / 2 + (-60)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="again">
      <sprite>
        <text>
          <content>spacebar to play again</content>
          <size>48</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position><x>window.width.center - again.width / 2</x><y>window.height.center - again.height / 2 + (70)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
  </objects>
  <states>
    <!-- the keys every wave uses -->
    <keys name="bucket">
      <input button="a left">
        <trigger object="bucket" action="left" />
      </input>
      <input button="d right">
        <trigger object="bucket" action="right" />
      </input>
      <input button="space p">
        <push state="paused" />
      </input>
    </keys>
    <state name="mainmenu">
      <shows>
        <show object="title" />
        <show object="help" />
        <show object="keys" />
        <show object="start" />
      </shows>
      <inputs>
        <input button="space">
          <push state="wave1" />
          <play sound="wave" />
        </input>
      </inputs>
    </state>
    <state name="wave1">
      <shows>
        <show object="rooftop" />
        <show object="ledge" />
        <show object="bomber1" />
        <show object="bombs1" />
        <show object="bucket" />
        <show object="scorelabel" />
        <show object="scorevalue" />
        <show object="bucketslabel" />
        <show object="bucketsvalue" />
        <show object="wave1label" />
      </shows>
      <inputs keys="bucket" />
      <conditions>
        <condition object="bucket" variable="buckets">
          <atmost>0</atmost>
          <push state="gameover" />
          <play sound="gameover" />
        </condition>
        <condition object="bucket" variable="score">
          <atleast>wave2at</atleast>
          <reset object="bombs1" />
          <push state="wave2" />
          <play sound="wave" />
        </condition>
      </conditions>
    </state>
    <state name="wave2">
      <shows>
        <show object="rooftop" />
        <show object="ledge" />
        <show object="bomber2" />
        <show object="bombs2" />
        <show object="bucket" />
        <show object="scorelabel" />
        <show object="scorevalue" />
        <show object="bucketslabel" />
        <show object="bucketsvalue" />
        <show object="wave2label" />
      </shows>
      <inputs keys="bucket" />
      <conditions>
        <condition object="bucket" variable="buckets">
          <atmost>0</atmost>
          <push state="gameover" />
          <play sound="gameover" />
        </condition>
        <condition object="bucket" variable="score">
          <atleast>wave3at</atleast>
          <reset object="bombs2" />
          <push state="wave3" />
          <play sound="wave" />
        </condition>
      </conditions>
    </state>
    <state name="wave3">
      <shows>
        <show object="rooftop" />
        <show object="ledge" />
        <show object="bomber3" />
        <show object="bombs3" />
        <show object="bucket" />
        <show object="scorelabel" />
        <show object="scorevalue" />
        <show object="bucketslabel" />
        <show object="bucketsvalue" />
        <show object="wave3label" />
      </shows>
      <inputs keys="bucket" />
      <conditions>
        <condition object="bucket" variable="buckets">
          <atmost>0</atmost>
          <push state="gameover" />
          <play sound="gameover" />
        </condition>
        <condition object="bucket" variable="score">
          <atleast>goal</atleast>
          <reset object="bombs3" />
          <push state="youwin" />
          <play sound="wave" />
        </condition>
      </conditions>
    </state>
    <state name="paused">
      <shows>
        <show object="paused" />
      </shows>
      <inputs>
        <input button="space p">
          <pop />
        </input>
      </inputs>
    </state>
    <state name="youwin">
      <shows>
        <show object="youwin" />
        <show object="scorelabel" />
        <show object="scorevalue" />
        <show object="again" />
      </shows>
      <inputs>
        <input button="space">
          <reset />
        </input>
      </inputs>
    </state>
    <state name="gameover">
      <shows>
        <show object="gameover" />
        <show object="scorelabel" />
        <show object="scorevalue" />
        <show object="again" />
      </shows>
      <inputs>
        <input button="space">
          <reset />
        </input>
      </inputs>
    </state>
  </states>
</game>
