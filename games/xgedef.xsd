<?xml version="1.0" encoding="utf-8"?>
<!-- xgedef.xsd: what a game file is made of (documented below, for an editor to show). -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" attributeFormDefault="unqualified" elementFormDefault="qualified">

  <xs:annotation>
    <xs:documentation><![CDATA[
      What a game file is made of. The rule of thumb:

        * An attribute NAMES or PICKS something: name, class, object, variable,
          state, action, button, edge, direction, unless, burn, sprite, sound,
          wave, pitch, to, keys. These are labels, and they cannot be computed.
        * Everything else is the content of an element. Where the content is a
          number (valueType below) it is one number or one name, or a value tag
          that makes the number: <random><min>-7</min><max>7</max></random>, or
          an operation such as <subtract><value>window.right</value><value>4</value></subtract>.
          Arithmetic written as text stops the load.
        * What an object DOES is a list of command tags (the command groups
          below): <bounce />, <inc variable="paddle1.score" />, <push state="playing" />.
          They run in the order written.

      Shapes, commands, random numbers and operations are tags, never
      function calls, and nothing is hidden in a string.
    ]]></xs:documentation>
  </xs:annotation>

  <!-- The words an attribute may hold. -->

  <xs:simpleType name="edgeType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="left" />
      <xs:enumeration value="right" />
      <xs:enumeration value="top" />
      <xs:enumeration value="bottom" />
      <xs:enumeration value="horizontal" />
      <xs:enumeration value="vertical" />
      <xs:enumeration value="all" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="directionType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="up" />
      <xs:enumeration value="down" />
      <xs:enumeration value="left" />
      <xs:enumeration value="right" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="turnDirectionType">
    <xs:annotation>
      <xs:documentation>The two ways an object with a heading can turn: clockwise adds to the heading, counterclockwise takes from it.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="clockwise" />
      <xs:enumeration value="counterclockwise" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="cycleDirectionType">
    <xs:annotation>
      <xs:documentation>The two ways a cycle goes: forward each cell to the next place, backward each to the one before.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="forward" />
      <xs:enumeration value="backward" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="flipType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="horizontal" />
      <xs:enumeration value="vertical" />
    </xs:restriction>
  </xs:simpleType>

  <xs:group name="valueTag">
    <xs:annotation>
      <xs:documentation>Value tags: the ways, besides one number or one name, to give a number.</xs:documentation>
    </xs:annotation>
    <xs:choice>
      <xs:element name="random" type="randomType" />
      <xs:group ref="operation" />
    </xs:choice>
  </xs:group>

  <xs:complexType name="randomType">
    <xs:annotation>
      <xs:documentation><![CDATA[random: a number from <min> up to <max>, each a number, a name or an operation, drawn each time it is worked out.]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="min" type="randomEndType" />
      <xs:element name="max" type="randomEndType" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="randomEndType" mixed="true">
    <xs:annotation>
      <xs:documentation><![CDATA[An end of a <random>: text (a number or a name) or an operation, not both.]]></xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0">
      <xs:group ref="operation" />
    </xs:choice>
  </xs:complexType>

  <!-- (The operations are listed twice, here and in operandType: the weak
       validator, load/xsd, does not follow a group that contains itself.) -->
  <xs:group name="operation">
    <xs:annotation>
      <xs:documentation><![CDATA[
        Arithmetic without a string to parse: an operation, written straight in
        a value, whose operands are <value>s: a name, a number, <random> or
        another operation. Nesting is the order it is worked out in. The first
        value is combined with each of the others in turn, so a - b - c is one
        subtract of three values:
          <x>
            <subtract>
              <value>window.width.center</value>
              <value><divide><value>title.width</value><value>2</value></divide></value>
            </subtract>
          </x>
        A value tag, so it goes anywhere a number or <random> does.
        Operations: add, subtract, multiply, divide of two or more <value>;
        remainder of two (what is left of the first, from 0 up to the second);
        smallest and largest of two or more; absolute, negate, sign (-1, 0 or
        1), floor, ceiling, round, sine and cosine (of degrees) of one <value>;
        clamp, a <value> kept from <atleast> up to <atmost>; and compare, a
        <value> and its test (<above>, <below>, <atleast>, <atmost> or <equal>,
        the condition words): 1 when it holds and 0 when not.
      ]]></xs:documentation>
    </xs:annotation>
    <xs:choice>
      <xs:element name="add" type="addType" />
      <xs:element name="subtract" type="subtractType" />
      <xs:element name="multiply" type="multiplyType" />
      <xs:element name="divide" type="divideType" />
      <xs:element name="remainder" type="remainderType" />
      <xs:element name="smallest" type="extremeType" />
      <xs:element name="largest" type="extremeType" />
      <xs:element name="absolute" type="oneOperandType" />
      <xs:element name="negate" type="oneOperandType" />
      <xs:element name="sign" type="oneOperandType" />
      <xs:element name="floor" type="oneOperandType" />
      <xs:element name="ceiling" type="oneOperandType" />
      <xs:element name="round" type="oneOperandType" />
      <xs:element name="sine" type="oneOperandType" />
      <xs:element name="cosine" type="oneOperandType" />
      <xs:element name="clamp" type="clampType" />
      <xs:element name="compare" type="compareOperationType" />
    </xs:choice>
  </xs:group>

  <xs:complexType name="operandType" mixed="true">
    <xs:annotation>
      <xs:documentation><![CDATA[An operand of an operation: text (a name or a number), <random> or an operation, which contains operands in turn.]]></xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0">
      <xs:element name="random" type="randomType" />
      <xs:element name="add" type="addType" />
      <xs:element name="subtract" type="subtractType" />
      <xs:element name="multiply" type="multiplyType" />
      <xs:element name="divide" type="divideType" />
      <xs:element name="remainder" type="remainderType" />
      <xs:element name="smallest" type="extremeType" />
      <xs:element name="largest" type="extremeType" />
      <xs:element name="absolute" type="oneOperandType" />
      <xs:element name="negate" type="oneOperandType" />
      <xs:element name="sign" type="oneOperandType" />
      <xs:element name="floor" type="oneOperandType" />
      <xs:element name="ceiling" type="oneOperandType" />
      <xs:element name="round" type="oneOperandType" />
      <xs:element name="sine" type="oneOperandType" />
      <xs:element name="cosine" type="oneOperandType" />
      <xs:element name="clamp" type="clampType" />
      <xs:element name="compare" type="compareOperationType" />
    </xs:choice>
  </xs:complexType>

  <xs:complexType name="extremeType">
    <xs:sequence>
      <xs:element name="value" type="operandType" minOccurs="2" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="oneOperandType">
    <xs:sequence>
      <xs:element name="value" type="operandType" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="compareOperationType">
    <xs:annotation>
      <xs:documentation><![CDATA[
        <compare><value>mode.waves</value><atleast>4</atleast></compare>: the <value>
        and its test, the same words as a condition's.
      ]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="value" type="operandType" />
      <xs:choice>
        <xs:element name="above" type="operandType" />
        <xs:element name="below" type="operandType" />
        <xs:element name="atleast" type="operandType" />
        <xs:element name="atmost" type="operandType" />
        <xs:element name="equal" type="operandType" />
      </xs:choice>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="remainderType">
    <xs:sequence>
      <xs:element name="value" type="operandType" minOccurs="2" maxOccurs="2" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="clampType">
    <xs:sequence>
      <xs:element name="value" type="operandType" />
      <xs:element name="atleast" type="operandType" />
      <xs:element name="atmost" type="operandType" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="addType">
    <xs:sequence>
      <xs:element name="value" type="operandType" minOccurs="2" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="subtractType">
    <xs:sequence>
      <xs:element name="value" type="operandType" minOccurs="2" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="multiplyType">
    <xs:sequence>
      <xs:element name="value" type="operandType" minOccurs="2" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="divideType">
    <xs:sequence>
      <xs:element name="value" type="operandType" minOccurs="2" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="valueType" mixed="true">
    <xs:annotation>
      <xs:documentation>A number: text (one number or one name) or one value tag, not both.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:group ref="valueTag" minOccurs="0" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="compareType" mixed="true">
    <xs:annotation>
      <xs:documentation><![CDATA[
        What a condition's variable is compared with: a number, as content
        (<atleast>15</atleast>), which may name another variable, read as the game
        runs: <above>gun2.score</above>.
      ]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:group ref="valueTag" minOccurs="0" />
    </xs:sequence>
  </xs:complexType>

  <xs:simpleType name="updateType">
    <xs:annotation>
      <xs:documentation><![CDATA[
        When a number of an object's is worked out: once, as the game loads (the
        default), or live, again every frame from what it reads, after the move:
        <x update="live"><add><value>player.x</value><value>18</value></add></x>. A command cannot change a live one.
      ]]></xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="once" />
      <xs:enumeration value="live" />
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="liveValueType" mixed="true">
    <xs:annotation>
      <xs:documentation><![CDATA[A number that may be live: an object's <heading>.]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:group ref="valueTag" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="update" type="updateType" use="optional" />
  </xs:complexType>

  <xs:complexType name="variableType" mixed="true">
    <xs:annotation>
      <xs:documentation><![CDATA[A number with a name, for <variable name="score">0</variable>.]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:group ref="valueTag" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="name" type="xs:NMTOKEN" use="required" />
  </xs:complexType>

  <xs:complexType name="vector2Type">
    <xs:annotation>
      <xs:documentation><![CDATA[Two numbers: <position>, <velocity> and a grid's <padding>.]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="x" type="valueType" />
      <xs:element name="y" type="valueType" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="emptyType" />

  <xs:simpleType name="waveType">
    <xs:annotation>
      <xs:documentation>Sounds: the voices of an old 8-bit sound chip, and a soft sine.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="square" />
      <xs:enumeration value="triangle" />
      <xs:enumeration value="sawtooth" />
      <xs:enumeration value="sine" />
      <xs:enumeration value="noise" />
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="noteType" mixed="true">
    <xs:annotation>
      <xs:documentation>
        A note: its pitch (a note name with an octave such as C4, F#3 or Bb5 -
        C4 is middle C - or a number of hertz), optionally a pitch to slide to
        while it plays, and optionally a wave of its own instead of the sound's.
        Its content is how long it lasts, in seconds.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:group ref="valueTag" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="pitch" type="xs:string" use="required" />
    <xs:attribute name="to" type="xs:string" use="optional" />
    <xs:attribute name="wave" type="waveType" use="optional" />
  </xs:complexType>

  <xs:complexType name="partType">
    <xs:annotation>
      <xs:documentation><![CDATA[
        A sound that <play sound="..." /> starts: whether it loops (<loop />: over
        and over until a <silence>, or, played from a key, until the key is let
        go), how loud (0 to 1, 0.3 when left
        out for notes), then notes and rests (a rest's content is how many seconds of
        silence), played one after the other, or parts (voices) that play at
        the same time, each its own notes and rests: a tune and its bass. wave is
        every note's that does not give its own (square when left out); a part's
        wave is its notes'. Or, in place of notes or parts, the <path> of a
        recording: an uncompressed WAV file, loud as recorded (volume 1) when
        no <volume> is given.
      ]]></xs:documentation>
    </xs:annotation>
    <xs:choice maxOccurs="unbounded">
      <xs:element name="note" type="noteType" />
      <xs:element name="rest" type="valueType" />
    </xs:choice>
    <xs:attribute name="wave" type="waveType" use="optional" />
  </xs:complexType>

  <xs:complexType name="soundType">
    <xs:sequence>
      <xs:element name="loop" type="emptyType" minOccurs="0" />
      <xs:element name="volume" type="valueType" minOccurs="0" />
      <xs:choice>
        <xs:choice maxOccurs="unbounded">
          <xs:element name="note" type="noteType" />
          <xs:element name="rest" type="valueType" />
        </xs:choice>
        <xs:element name="part" type="partType" maxOccurs="unbounded" />
        <xs:element name="path" type="xs:string" />
      </xs:choice>
    </xs:sequence>
    <xs:attribute name="name" type="xs:NMTOKEN" use="required" />
    <xs:attribute name="wave" type="waveType" use="optional" />
  </xs:complexType>

  <xs:complexType name="tetherType">
    <xs:sequence>
      <xs:element name="thickness" type="valueType" minOccurs="0" />
      <xs:element name="color" type="xs:string" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="from" type="xs:NMTOKEN" use="required" />
    <xs:attribute name="to" type="xs:NMTOKEN" use="required" />
  </xs:complexType>

  <xs:complexType name="chooseWordType">
    <xs:sequence>
      <xs:element name="by" type="valueType" />
      <xs:element name="word" type="xs:string" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <xs:group name="shape">
    <xs:annotation>
      <xs:documentation>Sprites: one shape.</xs:documentation>
    </xs:annotation>
    <xs:choice>
      <xs:element name="circle">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="radius" type="valueType" />
            <xs:element name="color" type="xs:string" minOccurs="0" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="rectangle">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="width" type="valueType" />
            <xs:element name="height" type="valueType" />
            <xs:element name="color" type="xs:string" minOccurs="0" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="text">
        <xs:complexType>
          <xs:sequence>
            <!-- its pieces, in order, a space between them (letters side by side make one word); none only in a group whose members, rows or cells give them -->
            <xs:choice minOccurs="0" maxOccurs="unbounded">
              <xs:element name="content" type="xs:string">
                <xs:annotation>
                  <xs:documentation>a fixed label</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="number" type="valueType">
                <xs:annotation>
                  <xs:documentation>a live number: an owner.variable stays up to date as it changes</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="letter" type="valueType">
                <xs:annotation>
                  <xs:documentation>a number shown as a letter, 0 is A and 25 is Z, live the same way</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="choose" type="chooseWordType">
                <xs:annotation>
                  <xs:documentation>one of its words, picked by a number (0 the first), live the same way</xs:documentation>
                </xs:annotation>
              </xs:element>
            </xs:choice>
            <xs:element name="size" type="valueType" minOccurs="0">
              <xs:annotation>
                <xs:documentation>left out, the style's</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element name="color" type="xs:string" minOccurs="0" />
            <xs:element name="font" type="xs:string" minOccurs="0">
              <xs:annotation>
                <xs:documentation>a font file (assets/pressstart2p.ttf); left out, the style's, or assets/tuffy.ttf</xs:documentation>
              </xs:annotation>
            </xs:element>
          </xs:sequence>
          <xs:attribute name="style" type="xs:NMTOKEN" use="optional">
            <xs:annotation>
              <xs:documentation><![CDATA[a <style> of the game's <styles>, for the <size> and <color> left out]]></xs:documentation>
            </xs:annotation>
          </xs:attribute>
        </xs:complexType>
      </xs:element>
      <xs:element name="tether" type="tetherType">
        <xs:annotation>
          <xs:documentation>a line from the middle of one object to the middle of another, drawn again every frame wherever they are</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="image">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="path" type="xs:string" />
            <xs:element name="flip" type="flipType" minOccurs="0" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="bitmap">
        <xs:annotation>
          <xs:documentation>
            A picture in rows of text, one character to a pixel: a period is a clear
            pixel and an asterisk a solid one, drawn in the color. Every character
            becomes scale by scale real pixels (1 if left out), so a few characters
            make a chunky sprite. The rows must all be the same width. Like a
            drawing of lines it is made into a picture when the game loads.
          </xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:sequence>
            <xs:element name="row" type="xs:string" minOccurs="0" maxOccurs="unbounded">
              <xs:annotation>
                <xs:documentation>none with from=: the picture's</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element name="scale" type="valueType" minOccurs="0" />
            <xs:element name="color" type="bitmapColorType" minOccurs="0" maxOccurs="unbounded" />
            <xs:element name="flip" type="flipType" minOccurs="0" />
          </xs:sequence>
          <xs:attribute name="style" type="xs:NMTOKEN" use="optional">
            <xs:annotation>
              <xs:documentation><![CDATA[a <style> of the game's <styles>, for the <scale> and <color>s left out]]></xs:documentation>
            </xs:annotation>
          </xs:attribute>
          <xs:attribute name="from" type="xs:NMTOKEN" use="optional">
            <xs:annotation>
              <xs:documentation><![CDATA[a <bitmap> of the <pictures>, changed by what this one gives]]></xs:documentation>
            </xs:annotation>
          </xs:attribute>
        </xs:complexType>
      </xs:element>
      <xs:element name="svg">
        <xs:annotation>
          <xs:documentation>
            A drawing from an SVG file, made into a picture when the game loads, so
            every graphics library shows it the same way and a pixel collision tests
            what is shown. The path is read like an image's. x, y, width and height
            (all four, or none for the whole drawing) pick the part of the drawing to
            take, in the drawing's own units, which is how one sheet of sprites
            serves many objects. scale is how many real pixels a unit is (1 if left
            out; it need not be a whole number). Each hide is the id of an element to
            leave out, such as a backdrop. The colors are the drawing's own.
          </xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:sequence>
            <xs:element name="path" type="xs:string" />
            <xs:element name="x" type="valueType" minOccurs="0" />
            <xs:element name="y" type="valueType" minOccurs="0" />
            <xs:element name="width" type="valueType" minOccurs="0" />
            <xs:element name="height" type="valueType" minOccurs="0" />
            <xs:element name="scale" type="valueType" minOccurs="0" />
            <xs:element name="hide" type="xs:string" minOccurs="0" maxOccurs="unbounded" />
            <xs:element name="flip" type="flipType" minOccurs="0" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="cell" type="sheetCellType" />
    </xs:choice>
  </xs:group>

  <xs:complexType name="lineType">
    <xs:annotation>
      <xs:documentation>
        One straight line of a drawing: where from and to, in pixels from the
        sprite's top left, and optionally its color and how many pixels thick it is
        (1 if left out). A sprite of one or more of these is drawn once, when the
        game loads, into the picture that is shown and that a collision of type
        pixel looks at.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="from" type="vector2Type" />
      <xs:element name="to" type="vector2Type" />
      <xs:element name="color" type="xs:string" minOccurs="0" />
      <xs:element name="thickness" type="valueType" minOccurs="0" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="polygonType">
    <xs:annotation>
      <xs:documentation><![CDATA[
        One filled shape of a drawing: its corners in order, in pixels from the
        sprite's top left, the last joined back to the first, and its color. A
        sprite of one or more of these is drawn once, when the game loads, and a
        collision of type pixel looks at what is drawn; a <hole> can cut it (hills
        blown into craters).
      ]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="point" type="vector2Type" minOccurs="3" maxOccurs="unbounded" />
      <xs:element name="color" type="xs:string" minOccurs="0" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="drawingFromType">
    <xs:annotation>
      <xs:documentation><![CDATA[<drawing from="rock" />: a drawing of the <pictures>, taken as it is.]]></xs:documentation>
    </xs:annotation>
    <xs:attribute name="from" type="xs:NMTOKEN" use="required" />
  </xs:complexType>

  <xs:complexType name="spriteType">
    <xs:annotation>
      <xs:documentation>A sprite is named when an object has several, so an animation can pick them out.</xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0">
      <xs:group ref="shape" />
      <xs:element name="cell" type="sheetCellType" />
      <xs:element name="line" type="lineType" maxOccurs="unbounded" />
      <xs:element name="polygon" type="polygonType" maxOccurs="unbounded" />
      <xs:element name="drawing" type="drawingFromType">
        <xs:annotation>
          <xs:documentation><![CDATA[the <pictures> drawing of that name: its lines, or its polygons]]></xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:choice>
    <xs:attribute name="name" type="xs:NMTOKEN" use="optional" />
  </xs:complexType>

  <xs:complexType name="spriteChangeType">
    <xs:annotation>
      <xs:documentation>
        A sprite that changes one its group has, for a member, row, column or cell:
        the group's sprite of the same name (or the one with no name). Of the same
        shape it gives only what changes, a color say, and keeps the rest; of
        another shape, or as lines, it is a sprite of its own, and must be complete
        (the engine says what is missing). A name the group has not got adds one.
      </xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0">
      <xs:element name="circle">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="radius" type="valueType" minOccurs="0" />
            <xs:element name="color" type="xs:string" minOccurs="0" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="rectangle">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="width" type="valueType" minOccurs="0" />
            <xs:element name="height" type="valueType" minOccurs="0" />
            <xs:element name="color" type="xs:string" minOccurs="0" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="text">
        <xs:complexType>
          <xs:sequence>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
              <xs:element name="content" type="xs:string" />
              <xs:element name="number" type="valueType" />
              <xs:element name="letter" type="valueType" />
              <xs:element name="choose" type="chooseWordType" />
            </xs:choice>
            <xs:element name="size" type="valueType" minOccurs="0" />
            <xs:element name="color" type="xs:string" minOccurs="0" />
            <xs:element name="font" type="xs:string" minOccurs="0" />
          </xs:sequence>
          <xs:attribute name="style" type="xs:NMTOKEN" use="optional">
            <xs:annotation>
              <xs:documentation><![CDATA[a <style> of the game's <styles>, for the <size> and <color> left out]]></xs:documentation>
            </xs:annotation>
          </xs:attribute>
        </xs:complexType>
      </xs:element>
      <xs:element name="tether" type="tetherType">
        <xs:annotation>
          <xs:documentation><![CDATA[of a tether, from= and to= again, and the <thickness> or <color> that changes]]></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="image">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="path" type="xs:string" minOccurs="0" />
            <xs:element name="flip" type="flipType" minOccurs="0" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="bitmap">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="row" type="xs:string" minOccurs="0" maxOccurs="unbounded" />
            <xs:element name="scale" type="valueType" minOccurs="0" />
            <xs:element name="color" type="bitmapColorType" minOccurs="0" maxOccurs="unbounded" />
            <xs:element name="flip" type="flipType" minOccurs="0" />
          </xs:sequence>
          <xs:attribute name="style" type="xs:NMTOKEN" use="optional">
            <xs:annotation>
              <xs:documentation><![CDATA[a <style> of the game's <styles>, for the <scale> and <color>s left out]]></xs:documentation>
            </xs:annotation>
          </xs:attribute>
          <xs:attribute name="from" type="xs:NMTOKEN" use="optional">
            <xs:annotation>
              <xs:documentation><![CDATA[a <bitmap> of the <pictures>, changed by what this one gives]]></xs:documentation>
            </xs:annotation>
          </xs:attribute>
        </xs:complexType>
      </xs:element>
      <xs:element name="svg">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="path" type="xs:string" minOccurs="0" />
            <xs:element name="x" type="valueType" minOccurs="0" />
            <xs:element name="y" type="valueType" minOccurs="0" />
            <xs:element name="width" type="valueType" minOccurs="0" />
            <xs:element name="height" type="valueType" minOccurs="0" />
            <xs:element name="scale" type="valueType" minOccurs="0" />
            <xs:element name="hide" type="xs:string" minOccurs="0" maxOccurs="unbounded" />
            <xs:element name="flip" type="flipType" minOccurs="0" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="line" type="lineType" maxOccurs="unbounded" />
      <xs:element name="polygon" type="polygonType" maxOccurs="unbounded" />
      <xs:element name="drawing" type="drawingFromType">
        <xs:annotation>
          <xs:documentation><![CDATA[the <pictures> drawing of that name: its lines, or its polygons]]></xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:choice>
    <xs:attribute name="name" type="xs:NMTOKEN" use="optional" />
  </xs:complexType>

  <xs:complexType name="sheetCellType">
    <xs:annotation>
      <xs:documentation><![CDATA[
        A picture cut from a <sheet>: the cell at <column> and <row> (from 1,
        each 1 when left out), or the part at <x>, <y>, <width> by <height>;
        drawn <scale> pixels to the sheet's, maybe flipped.
      ]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="column" type="valueType" minOccurs="0" />
      <xs:element name="row" type="valueType" minOccurs="0" />
      <xs:element name="x" type="valueType" minOccurs="0" />
      <xs:element name="y" type="valueType" minOccurs="0" />
      <xs:element name="width" type="valueType" minOccurs="0" />
      <xs:element name="height" type="valueType" minOccurs="0" />
      <xs:element name="scale" type="valueType" minOccurs="0" />
      <xs:element name="flip" type="flipType" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="sheet" type="xs:NMTOKEN" use="required" />
  </xs:complexType>


  <xs:complexType name="sheetRunType">
    <xs:annotation>
      <xs:documentation><![CDATA[
        A run of a sheet's cells: <count> of them (1 when left out) from
        <column> and <row> (each 1 when left out), along the row, or down
        the column with <down />.
      ]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="column" type="xs:positiveInteger" minOccurs="0" />
      <xs:element name="row" type="xs:positiveInteger" minOccurs="0" />
      <xs:element name="count" type="xs:positiveInteger" minOccurs="0" />
      <xs:element name="down" type="emptyType" minOccurs="0" />
      <xs:element name="scale" type="valueType" minOccurs="0" />
      <xs:element name="flip" type="flipType" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="sheet" type="xs:NMTOKEN" use="optional" />
  </xs:complexType>

  <xs:complexType name="animationType">
    <xs:annotation>
      <xs:documentation><![CDATA[
        An animation: how many seconds each picture is shown, and the sprites it
        shows in turn, round and round, each picked out by the name of one of the
        object's own sprites. At least two frames; the same sprite may come up more
        than once. The frames must all be pictures (bitmaps, svgs or drawings of
        lines) of the same size.
      ]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="interval" type="valueType" />
      <!-- each frame a sprite by name, a sheet's <cell>, or a run of its <cells> (with sheet=) -->
      <xs:choice maxOccurs="unbounded">
        <xs:element name="frame">
          <xs:complexType>
            <xs:attribute name="sprite" type="xs:NMTOKEN" use="required" />
          </xs:complexType>
        </xs:element>
        <xs:element name="cell" type="sheetCellType" />
        <xs:element name="cells" type="sheetRunType" />
      </xs:choice>
    </xs:sequence>
    <xs:attribute name="name" type="xs:NMTOKEN" use="optional">
      <xs:annotation>
        <xs:documentation><![CDATA[named: a look that moves, which <become> and <poses> pick like a sprite]]></xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="poseType">
    <xs:annotation>
      <xs:documentation>poses: the look for each way an object moves, picked each frame while it shows one of them.</xs:documentation>
    </xs:annotation>
    <xs:attribute name="sprite" type="xs:NMTOKEN" use="required" />
  </xs:complexType>
  <xs:complexType name="posesType">
    <xs:sequence>
      <xs:element name="standing" type="poseType" />
      <xs:element name="walking" type="poseType" minOccurs="0" />
      <xs:element name="skidding" type="poseType" minOccurs="0" />
      <xs:element name="rising" type="poseType" minOccurs="0" />
      <xs:element name="falling" type="poseType" minOccurs="0" />
      <xs:element name="thrusting" type="poseType" minOccurs="0" />
    </xs:sequence>
  </xs:complexType>
  <xs:simpleType name="mirrorType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="left" />
      <xs:enumeration value="right" />
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="surfaceType">
    <xs:annotation>
      <xs:documentation>surface: the drag and grip a thing that grips has while its middle is over it; one left out is its own</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="drag" type="valueType" minOccurs="0" />
      <xs:element name="grip" type="valueType" minOccurs="0" />
    </xs:sequence>
  </xs:complexType>

  <xs:group name="moveParts">
    <xs:annotation>
      <xs:documentation>How its looks and steps follow its moves: poses, a mirror going one way across, and how quickly it gets to the speed its moves ask for (0 up to 1, 1 at once).</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="poses" type="posesType" minOccurs="0" />
      <xs:element name="mirror" type="mirrorType" minOccurs="0" />
      <xs:element name="grip" type="valueType" minOccurs="0" />
      <xs:element name="joins" type="joinsType" minOccurs="0" />
      <xs:element name="moves" type="pieceMovesType" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="marks" type="marksType" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="holds" type="holdsType" minOccurs="0" />
      <xs:element name="owns" type="ownsType" minOccurs="0">
        <xs:annotation>
          <xs:documentation><![CDATA[
            owns: the holder of its own, a player's cards: a picker takes any of them, face up or down, and what a
            holder's <picked> sends with no into= comes to it
          ]]></xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:group>
  <xs:complexType name="passType">
    <xs:annotation>
      <xs:documentation>
        pass: the next player's turn. For a group that takes turns, member= the number of the member whose turn it is
        now (from 1; 0: nobody's), of the group object= names (in an action, left out: the doer's)
      </xs:documentation>
    </xs:annotation>
    <xs:attribute name="object" type="xs:NMTOKEN" use="optional" />
    <xs:attribute name="member" type="xs:NMTOKEN" use="optional" />
  </xs:complexType>
  <xs:complexType name="ownsType">
    <xs:annotation>
      <xs:documentation>owns: a player's own holder (object=, its cards), or the pieces it moves in a board game (class=)</xs:documentation>
    </xs:annotation>
    <xs:attribute name="object" type="xs:NMTOKEN" use="optional" />
    <xs:attribute name="class" type="xs:NMTOKEN" use="optional" />
  </xs:complexType>
  <xs:complexType name="memberThinkType">
    <xs:annotation>
      <xs:documentation>think on a member of a group that takes turns: the computer plays it, pressing button= on its turn</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="depth" type="valueType" minOccurs="0" />
      <xs:element name="avoid" type="emptyType" minOccurs="0" />
      <xs:element name="worth" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:simpleContent>
            <xs:extension base="xs:string">
              <xs:attribute name="sprite" type="xs:NMTOKEN" use="required" />
            </xs:extension>
          </xs:simpleContent>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="button" type="xs:NMTOKEN" use="required" />
  </xs:complexType>
  <xs:complexType name="holdsType">
    <xs:annotation>
      <xs:documentation><![CDATA[
        holds: what this object (or each member of a group) holds, in order, the last on top: members of that class=, each
        showing the look sprite= while laid here. The members of a held class are the cells of one <group> in <columns> and
        <rows> (cards: a row for each suit, a column for each rank), with two looks, the face first and the back.
        spread: each held one on from the one under it (<width>: never wider; with sprite=, for those showing that look);
        accepts: what may be placed on top, as <condition>s on the arriving one (all must hold), comparing its variable=
        with a number or a variable of the top one (top.suit; <add><value>top.rank</value><value>1</value></add>); total="sum": that variable added up over what is laid at
        once; total="count" <equal>1: one at a time; <any>: one of these holds too; <empty>: <condition>s on the first
        one; carry: one may be picked with all those on it; top: the top one turns to that look; lift: the one a
        picker points at is lifted by that much; picked: what picking from it does instead, picking nothing up (<send
        into>N there; <empty>: a <send from> with <all /> (and <leave>) back, then <order><random /></order>; <play sound>)
      ]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="spread" minOccurs="0" maxOccurs="2">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="x" type="valueType" minOccurs="0" />
            <xs:element name="y" type="valueType" minOccurs="0" />
            <xs:element name="width" type="valueType" minOccurs="0" />
          </xs:sequence>
          <xs:attribute name="sprite" type="xs:NMTOKEN" use="optional" />
        </xs:complexType>
      </xs:element>
      <xs:element name="accepts" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="condition" type="acceptConditionType" minOccurs="0" maxOccurs="unbounded" />
            <xs:element name="any" minOccurs="0">
              <xs:annotation>
                <xs:documentation>one of these holds too</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="condition" type="acceptConditionType" maxOccurs="unbounded" />
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element name="wild" minOccurs="0">
              <xs:annotation>
                <xs:documentation>what keeps these goes on anything; who laid it then names a value of variable=</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="condition" type="acceptConditionType" maxOccurs="unbounded" />
                </xs:sequence>
                <xs:attribute name="variable" type="xs:NMTOKEN" use="required" />
              </xs:complexType>
            </xs:element>
            <xs:element name="empty" minOccurs="0">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="condition" type="acceptConditionType" minOccurs="0" maxOccurs="unbounded" />
                </xs:sequence>
              </xs:complexType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="carry" type="emptyType" minOccurs="0" />
      <xs:element name="top" minOccurs="0">
        <xs:complexType>
          <xs:attribute name="sprite" type="xs:NMTOKEN" use="required" />
        </xs:complexType>
      </xs:element>
      <xs:element name="lift" type="valueType" minOccurs="0" />
      <xs:element name="trick" minOccurs="0">
        <xs:annotation>
          <xs:documentation><![CDATA[
            trick: any member leads, then the value of variable= led is followed
            while the player holds one; a value <breaks> leads only once played (or
            when the player holds nothing else), a value <trumps> beats the rest;
            else the highest worth of the value led wins. For now variable="suit"
          ]]></xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:sequence>
            <xs:element name="breaks" type="xs:integer" minOccurs="0" maxOccurs="unbounded" />
            <xs:element name="trumps" type="xs:integer" minOccurs="0" maxOccurs="unbounded" />
          </xs:sequence>
          <xs:attribute name="variable" type="xs:NMTOKEN" use="required" />
        </xs:complexType>
      </xs:element>
      <xs:element name="score" type="scoreType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>score patterns=: as a pile's</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="counts" minOccurs="0">
        <xs:annotation>
          <xs:documentation><![CDATA[
            counts: its own variable of that name, what its face-up members' variables of that name add up to; for
            worth, a member's high instead while the total stays <atmost>
          ]]></xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:sequence>
            <xs:element name="atmost" type="valueType" minOccurs="0" />
          </xs:sequence>
          <xs:attribute name="variable" type="xs:NMTOKEN" use="required" />
        </xs:complexType>
      </xs:element>
      <xs:element name="order" minOccurs="0">
        <xs:annotation>
          <xs:documentation>kept in order by these variables, the first first</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:sequence>
            <xs:element name="by" maxOccurs="unbounded">
              <xs:complexType>
                <xs:attribute name="variable" type="xs:NMTOKEN" use="required" />
              </xs:complexType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="picked" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="send" minOccurs="0">
              <xs:complexType>
                <xs:simpleContent>
                  <xs:extension base="xs:string">
                    <xs:attribute name="into" type="xs:NMTOKEN" use="optional" />
                  </xs:extension>
                </xs:simpleContent>
              </xs:complexType>
            </xs:element>
            <xs:element name="empty" minOccurs="0">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="send">
                    <xs:complexType>
                      <xs:sequence>
                        <xs:element name="all" type="emptyType" />
                        <xs:element name="leave" type="valueType" minOccurs="0" />
                      </xs:sequence>
                      <xs:attribute name="from" type="xs:NMTOKEN" use="required" />
                    </xs:complexType>
                  </xs:element>
                  <xs:element name="order" minOccurs="0">
                    <xs:complexType>
                      <xs:sequence>
                        <xs:element name="random" type="emptyType" />
                      </xs:sequence>
                    </xs:complexType>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element name="play" minOccurs="0">
              <xs:complexType>
                <xs:attribute name="sound" type="xs:NMTOKEN" use="required" />
              </xs:complexType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="class" type="xs:NMTOKEN" use="required" />
    <xs:attribute name="sprite" type="xs:NMTOKEN" use="optional" />
  </xs:complexType>
  <xs:complexType name="acceptTestType" mixed="true">
    <xs:annotation>
      <xs:documentation><![CDATA[What an accepting test compares with: a number, top. and a variable, or an <add> or <subtract> of top. and a number.]]></xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0">
      <xs:element name="add" type="addType" />
      <xs:element name="subtract" type="subtractType" />
    </xs:choice>
  </xs:complexType>
  <xs:complexType name="acceptConditionType">
    <xs:annotation>
      <xs:documentation><![CDATA[
        A <condition> of an <accepts>: the arriving one's variable= against a number, or against a variable of the
        top one, or an <add> or <subtract> of it and a number (top.suit; <add><value>top.rank</value><value>1</value></add>; top.worth). total="sum": that variable over what is laid at once; total="count": how many.
      ]]></xs:documentation>
    </xs:annotation>
    <xs:choice>
      <xs:element name="equal" type="acceptTestType" />
      <xs:element name="unequal" type="acceptTestType" />
      <xs:element name="above" type="acceptTestType" />
      <xs:element name="below" type="acceptTestType" />
      <xs:element name="atleast" type="acceptTestType" />
      <xs:element name="atmost" type="acceptTestType" />
    </xs:choice>
    <xs:attribute name="variable" type="xs:NMTOKEN" use="optional" />
    <xs:attribute name="total" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="count" />
          <xs:enumeration value="sum" />
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="marksType">
    <xs:annotation>
      <xs:documentation><![CDATA[
        marks: on a picker, pieces it shows in cells of their own map of cells, a copy of object= in each:
        held, the piece it holds; moves, each cell that piece can move to; movable, each piece of class= that can be picked;
        put, each cell a piece of class= can be <put> in (movable and put with no class=: the pieces the player on its turn <owns>);
        last, the cells the last move it placed went from and to (a piece put: its cell). sprite=: only while it shows that look.
        variable=: only while that variable is not 0 (an option)
      ]]></xs:documentation>
    </xs:annotation>
    <xs:choice maxOccurs="unbounded">
      <xs:element name="held" type="markType" />
      <xs:element name="moves" type="markType" />
      <xs:element name="movable" type="markType" />
      <xs:element name="put" type="markType" />
      <xs:element name="last" type="markType" />
    </xs:choice>
    <xs:attribute name="sprite" type="xs:NMTOKEN" use="optional" />
  </xs:complexType>
  <xs:complexType name="markType">
    <xs:attribute name="object" type="xs:NMTOKEN" use="required" />
    <xs:attribute name="class" type="xs:NMTOKEN" use="optional" />
    <xs:attribute name="variable" type="xs:NMTOKEN" use="optional" />
  </xs:complexType>
  <xs:complexType name="pieceMovesType">
    <xs:annotation>
      <xs:documentation><![CDATA[
        moves: on a map with <cells />, a board game piece's moves, made when a picker <place>s it;
        sprite=: the set for that look (a king's), the one without for the other looks.
        forced: while any piece of its class can jump, it may only jump.
        step: to the empty cell that many cells across (x) and down (y).
        jump: over a piece of that class that far away into the empty cell beyond, taking it;
        a piece that can jump again after a jump must, before its turn is over.
        flank: a new piece of its kind is <put> only where it traps a line of pieces of that class
        (any of the eight ways; with <straight />, across and down only) against one of its own,
        and the pieces trapped turn into its kind (reversi).
        on: a piece put goes only on a piece of that class, in its place (dots and boxes' lines on their slots).
        fall: a piece put drops to the lowest free cell of the picker's column (four in a row).
        close: a piece put that walls in a piece of class= beside it (no place it could go left round it) puts a copy of object=
        in that cell, and the put counts as refused, so the turn goes on (dots and boxes' boxes).
        A set with no step or jump is of pieces put; one with nothing in it puts in any free cell (tic-tac-toe).
        promote: reaching that row, it shows that look (crowned), and its move ends.
      ]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="forced" type="emptyType" minOccurs="0" />
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="step" type="cellOffsetType" />
        <xs:element name="jump">
          <xs:complexType>
            <xs:complexContent>
              <xs:extension base="cellOffsetType">
                <xs:attribute name="class" type="xs:NMTOKEN" use="required" />
              </xs:extension>
            </xs:complexContent>
          </xs:complexType>
        </xs:element>
      </xs:choice>
      <xs:element name="flank" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="straight" type="emptyType" minOccurs="0" />
          </xs:sequence>
          <xs:attribute name="class" type="xs:NMTOKEN" use="required" />
        </xs:complexType>
      </xs:element>
      <xs:element name="on" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="class" type="xs:NMTOKEN" use="required" />
        </xs:complexType>
      </xs:element>
      <xs:element name="fall" type="emptyType" minOccurs="0" />
      <xs:element name="close" minOccurs="0">
        <xs:complexType>
          <xs:attribute name="class" type="xs:NMTOKEN" use="required" />
          <xs:attribute name="object" type="xs:NMTOKEN" use="required" />
        </xs:complexType>
      </xs:element>
      <xs:element name="promote" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="row" type="xs:positiveInteger" />
          </xs:sequence>
          <xs:attribute name="sprite" type="xs:NMTOKEN" use="required" />
        </xs:complexType>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="sprite" type="xs:NMTOKEN" use="optional" />
  </xs:complexType>
  <xs:complexType name="cellOffsetType">
    <xs:sequence>
      <xs:element name="x" type="xs:integer" />
      <xs:element name="y" type="xs:integer" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="joinsType">
    <xs:annotation>
      <xs:documentation><![CDATA[joins: on a map with <cells />, the look for where the piece it is joined to lies (the other cells of its shape, falling or settled), and alone; put on while it shows one of them]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="alone" type="poseType" />
      <xs:element name="left" type="poseType" />
      <xs:element name="right" type="poseType" />
      <xs:element name="up" type="poseType" />
      <xs:element name="down" type="poseType" />
    </xs:sequence>
  </xs:complexType>

  <!-- Commands: what a collision rule, an object action, a key or a condition does. -->

  <xs:complexType name="variableReferenceType" mixed="true">
    <xs:annotation>
      <xs:documentation>inc and dec: which variable, and by how much (1 when there is nothing between the tags).</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:group ref="valueTag" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="variable" type="xs:NMTOKEN" use="required" />
  </xs:complexType>

  <xs:complexType name="targetValueType" mixed="true">
    <xs:annotation>
      <xs:documentation>pull and seek: which object or group, and how much.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:group ref="valueTag" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="object" type="xs:NMTOKEN" use="required" />
  </xs:complexType>

  <xs:group name="sightParts">
    <xs:annotation>
      <xs:documentation>An object's light, darkness, height off the ground and shadow.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="light" type="valueType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>how far round its middle it lights what is dark</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="dark" type="darkType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>unlit: drawn only while lit; unseen: drawn once it has been lit</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="altitude" type="altitudeType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>how high off the ground it starts, how fast it rises, how much less each frame, how much it bounces back up</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="shadow" type="objectRefType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>kept under that object, on the ground</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:group>

  <xs:simpleType name="darkType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="unlit" />
      <xs:enumeration value="unseen" />
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="altitudeType">
    <xs:sequence>
      <xs:element name="start" type="valueType" minOccurs="0" />
      <xs:element name="rise" type="valueType" minOccurs="0" />
      <xs:element name="fall" type="valueType" minOccurs="0" />
      <xs:element name="bounce" type="valueType" minOccurs="0" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="objectRefType">
    <xs:attribute name="object" type="xs:NMTOKEN" use="required" />
  </xs:complexType>

  <xs:simpleType name="hopDirectionType">
    <xs:annotation>
      <xs:documentation><![CDATA[hop: one of the four ways, or a diagonal, and how far: a distance, or for a diagonal an <x> across and a <y> up or down.]]></xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="up" />
      <xs:enumeration value="down" />
      <xs:enumeration value="left" />
      <xs:enumeration value="right" />
      <xs:enumeration value="up-left" />
      <xs:enumeration value="up-right" />
      <xs:enumeration value="down-left" />
      <xs:enumeration value="down-right" />
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="hopType" mixed="true">
    <xs:annotation>
      <xs:documentation><![CDATA[hop: how far, as its value, or an <x> and a <y>, then how long it takes, and how high it goes on the way (an <arc>, which needs <seconds>); or, on cells, <onto>s: to the nearest cell that way holding one of those classes (left and right along the row; up and down to the nearest row that has one, keeping the column as a text cursor does)]]></xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0">
      <xs:group ref="hopParts" />
      <xs:element name="onto" type="ontoType" maxOccurs="unbounded" />
    </xs:choice>
    <xs:attribute name="direction" type="hopDirectionType" use="required" />
  </xs:complexType>
  <xs:complexType name="ontoType">
    <xs:annotation>
      <xs:documentation>onto: a class of piece a hop or a track on cells may go to the cell of</xs:documentation>
    </xs:annotation>
    <xs:attribute name="class" type="xs:NMTOKEN" use="required" />
  </xs:complexType>
  <xs:group name="hopParts">
    <xs:sequence>
      <xs:choice minOccurs="0">
        <xs:group ref="valueTag" />
        <xs:sequence>
          <xs:element name="x" type="valueType" />
          <xs:element name="y" type="valueType" />
        </xs:sequence>
      </xs:choice>
      <xs:element name="seconds" type="valueType" minOccurs="0" />
      <xs:element name="arc" type="valueType" minOccurs="0" />
    </xs:sequence>
  </xs:group>
  <xs:complexType name="huntHopType" mixed="true">
    <xs:annotation>
      <xs:documentation>the hop of a hunt by hops: the hunt chooses the way.</xs:documentation>
    </xs:annotation>
    <xs:group ref="hopParts" minOccurs="0" />
  </xs:complexType>

  <xs:complexType name="setType" mixed="true">
    <xs:annotation>
      <xs:documentation>set: the value, worked out as it runs.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:group ref="valueTag" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="variable" type="xs:NMTOKEN" use="required" />
  </xs:complexType>

  <xs:complexType name="spawnType">
    <xs:annotation>
      <xs:documentation><![CDATA[spawn: which object or group (<random />: one of its members at random, not in turn), into= the map of cells it goes on (left out: its own), where (a half may be <centered>; on a map with <cells />, the <column> and <row> of its top left cell), and how fast.]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="count" type="valueType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>count: how many copies (one if left out)</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="random" type="emptyType" minOccurs="0" />
      <xs:choice minOccurs="0">
        <xs:element name="position" type="spawnPositionType" />
        <xs:sequence>
          <xs:element name="column" type="valueType" />
          <xs:element name="row" type="valueType" />
        </xs:sequence>
        <xs:element name="free">
          <xs:annotation>
            <xs:documentation><![CDATA[free: a free cell of the map, at random; with <below>, one under that row]]></xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="below" type="valueType" minOccurs="0" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:choice>
      <xs:element name="velocity" type="partialVector2Type" minOccurs="0" />
      <xs:element name="acceleration" type="partialVector2Type" minOccurs="0">
        <xs:annotation>
          <xs:documentation>acceleration: its pull for as long as it lasts (wind on a shell), read as the spawn runs</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="object" type="xs:NMTOKEN" use="required" />
    <xs:attribute name="into" type="xs:NMTOKEN" use="optional" />
  </xs:complexType>

  <xs:complexType name="sendType" mixed="true">
    <xs:annotation>
      <xs:documentation><![CDATA[
        send: with object=, its piece from one map of cells to another, at a <column> and <row> if given (left out: the same cell); with no
        object=, members of a held class from holder from= (a group's name: every member, wherever it is) into holder
        into=: how many, as content, or <all />; sprite= the look they show there
      ]]></xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0">
      <xs:sequence>
        <xs:element name="column" type="valueType" />
        <xs:element name="row" type="valueType" />
      </xs:sequence>
      <xs:element name="all" type="emptyType" />
    </xs:choice>
    <xs:attribute name="object" type="xs:NMTOKEN" use="optional" />
    <xs:attribute name="from" type="xs:NMTOKEN" use="required" />
    <xs:attribute name="into" type="xs:NMTOKEN" use="required" />
    <xs:attribute name="sprite" type="xs:NMTOKEN" use="optional" />
  </xs:complexType>
  <xs:complexType name="orderType">
    <xs:annotation>
      <xs:documentation><![CDATA[order: what holder group= holds, at <random />]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="random" type="emptyType" />
    </xs:sequence>
    <xs:attribute name="group" type="xs:NMTOKEN" use="required" />
  </xs:complexType>

  <xs:simpleType name="windowSizeType">
    <xs:annotation>
      <xs:documentation>a window's width or height in pixels: 1 or more</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:unsignedShort">
      <xs:minInclusive value="1" />
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="scoreType">
    <xs:sequence>
      <xs:element name="melds" type="emptyType" minOccurs="0">
        <xs:annotation>
          <xs:documentation><![CDATA[
            melds: scored instead by laying the things held out in groups, each making one of the named
            <patterns> with all its members (<alike variable>: N alike, <run variable>: N in a row), the groups
            leaving the fewest points over; live number deadwood, the points left over by the best <best> of them
          ]]></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="with" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="full" type="xs:positiveInteger" minOccurs="0" />
          </xs:sequence>
          <xs:attribute name="object" type="xs:NMTOKEN" use="required" />
        </xs:complexType>
      </xs:element>
      <xs:element name="best" type="xs:positiveInteger" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="patterns" type="xs:NMTOKEN" use="required" />
  </xs:complexType>

  <xs:complexType name="patternPartType">
    <xs:annotation>
      <xs:documentation><![CDATA[A part of a <pattern>: how many, and variable= the one compared.]]></xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="xs:positiveInteger">
        <xs:attribute name="variable" type="xs:NMTOKEN" use="required" />
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="distributeType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="from" type="xs:NMTOKEN" use="required" />
        <xs:attribute name="into" type="xs:NMTOKEN" use="required" />
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="stepType" mixed="true">
    <xs:annotation>
      <xs:documentation><![CDATA[move: a direction, and how far a frame; on a map with <cells />, how many cells a second while held, after one at once and a <wait> of so many seconds.]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:group ref="valueTag" minOccurs="0" />
      <xs:element name="wait" type="valueType" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="direction" type="directionType" use="required" />
  </xs:complexType>

  <xs:complexType name="slideType">
    <xs:annotation>
      <xs:documentation><![CDATA[slide: on a map with <cells />, a cell at a time that way until the next is refused; with class=, every piece of that class on cells, the one nearest that way first, refused when none moved.]]></xs:documentation>
    </xs:annotation>
    <xs:attribute name="direction" type="directionType" use="required" />
    <xs:attribute name="class" type="xs:NMTOKEN" use="optional" />
  </xs:complexType>

  <xs:complexType name="aroundType">
    <xs:annotation>
      <xs:documentation><![CDATA[
        Cells about the object running a <count> or a <trigger>, on any map
        of cells laid in the same place: here, its own; around, the eight round
        it (<straight />: the four beside it), with <alike variable> only the
        pieces whose number is the object's own.
      ]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="straight" type="emptyType" minOccurs="0" />
      <xs:element name="alike" minOccurs="0">
        <xs:complexType>
          <xs:attribute name="variable" type="xs:NMTOKEN" use="required" />
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:group name="cellPlace">
    <xs:choice>
      <xs:element name="here" type="emptyType" />
      <xs:element name="around" type="aroundType" />
    </xs:choice>
  </xs:group>

  <xs:complexType name="thrustType" mixed="true">
    <xs:annotation>
      <xs:documentation>thrust: how much to add to the velocity each frame while held, the way it faces (its heading), or with direction= one way across the screen; and optionally the variable it burns.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:group ref="valueTag" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="direction" type="directionType" use="optional" />
    <xs:attribute name="burn" type="xs:NMTOKEN" use="optional" />
  </xs:complexType>

  <xs:complexType name="turnType" mixed="true">
    <xs:annotation>
      <xs:documentation><![CDATA[turn: clockwise or counterclockwise (direction=), and how many degrees a frame while the key is held; a shape on a map with <cells />, a quarter turn with nothing written.]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:group ref="valueTag" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="direction" type="turnDirectionType" use="required" />
  </xs:complexType>

  <xs:complexType name="swingType">
    <xs:annotation>
      <xs:documentation><![CDATA[swing: which way it turns (direction=, as <turn>), how far, and how long the stroke takes.]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="degrees" type="valueType">
        <xs:annotation>
          <xs:documentation>how many degrees it turns from where it started</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="seconds" type="valueType">
        <xs:annotation>
          <xs:documentation>how long the stroke takes: from still, fastest half way, to still</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="direction" type="turnDirectionType" use="required" />
  </xs:complexType>

  <xs:complexType name="deflectType" mixed="true">
    <xs:sequence>
      <xs:group ref="valueTag" minOccurs="0" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="knockType" mixed="true">
    <xs:annotation>
      <xs:documentation>knock: how bouncy the meeting is, 0 up to 1; left out, 1.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:group ref="valueTag" minOccurs="0" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="holeType" mixed="true">
    <xs:annotation>
      <xs:documentation>
        hole: cut in the object's own picture where what it touched struck it,
        its radius as its value; rough, 0 up to 1, gives it a ragged edge.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:group ref="valueTag" minOccurs="0" />
      <xs:element name="rough" type="valueType" minOccurs="0" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="climbType" mixed="true">
    <xs:annotation>
      <xs:documentation>climb: up or down, the class of what is climbed (a ladder), and the step a frame.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:group ref="valueTag" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="direction" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="up" />
          <xs:enumeration value="down" />
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="class" type="xs:NMTOKEN" use="required" />
  </xs:complexType>

  <xs:simpleType name="mapCharType">
    <xs:annotation>
      <xs:documentation><![CDATA[One character of a <map>'s rows.]]></xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:length value="1" />
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="demoKeyType">
    <xs:annotation>
      <xs:documentation><![CDATA[A key of a recorded <demo>: which, and the frame it happened at.]]></xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="xs:unsignedInt">
        <xs:attribute name="button" type="xs:NMTOKEN" use="required" />
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="bitmapColorType">
    <xs:annotation>
      <xs:documentation><![CDATA[A bitmap's <color>: with no char=, the color of its '*'s; with char="w", of its 'w's.]]></xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="char" type="mapCharType" use="optional" />
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="mazeType">
    <xs:annotation>
      <xs:documentation><![CDATA[maze: the <map> an object walks, and each class that is a wall to it (only while it shows sprite=, if given).]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="wall" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="class" type="xs:NMTOKEN" use="required" />
          <xs:attribute name="sprite" type="xs:NMTOKEN" use="optional" />
        </xs:complexType>
      </xs:element>
      <xs:element name="slow" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>slow: on a tile holding something of this class, the walker goes at this share of its speed</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:simpleContent>
            <xs:extension base="xs:decimal">
              <xs:attribute name="class" type="xs:NMTOKEN" use="required" />
            </xs:extension>
          </xs:simpleContent>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="map" type="xs:NMTOKEN" use="required" />
  </xs:complexType>

  <xs:complexType name="goType" mixed="true">
    <xs:annotation>
      <xs:documentation>go: the way to turn at the first gap, and the speed (pixels a frame).</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:group ref="valueTag" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="direction" type="directionType" use="required" />
  </xs:complexType>

  <xs:complexType name="huntType" mixed="true">
    <xs:annotation>
      <xs:documentation><![CDATA[
        hunt: what to hunt, how fast as its value, and how the target is found from it: tiles
        in front of it (ahead), as far again past that as a partner is short of
        it (with), and, within that many tiles of it, another object instead
        (retreat). Or, for an object that walks no maze, a hunt by hops: one
        <hop>, toward it.
      ]]></xs:documentation>
    </xs:annotation>
    <xs:choice>
      <xs:element name="hop" type="huntHopType" />
      <xs:sequence>
        <xs:group ref="valueTag" minOccurs="0" />
        <xs:element name="ahead" type="valueType" minOccurs="0" />
        <xs:element name="with" minOccurs="0">
          <xs:complexType>
            <xs:attribute name="object" type="xs:NMTOKEN" use="required" />
          </xs:complexType>
        </xs:element>
        <xs:element name="retreat" minOccurs="0">
          <xs:complexType mixed="true">
            <xs:sequence>
              <xs:group ref="valueTag" minOccurs="0" />
            </xs:sequence>
            <xs:attribute name="object" type="xs:NMTOKEN" use="required" />
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:choice>
    <xs:attribute name="object" type="xs:NMTOKEN" use="required" />
  </xs:complexType>

  <xs:complexType name="wanderType" mixed="true">
    <xs:annotation>
      <xs:documentation>wander: how fast, as its value.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:group ref="valueTag" minOccurs="0" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="chaseType" mixed="true">
    <xs:annotation>
      <xs:documentation>chase: the object to head for, how fast as its value, and (if given) how near is near enough to stop.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:group ref="valueTag" minOccurs="0" />
      <xs:element name="near" type="valueType" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="object" type="xs:NMTOKEN" use="required" />
  </xs:complexType>

  <!--
    Commands, in groups by what they need to mean something; each place
    that runs commands names the groups it takes (below).
  -->

  <xs:group name="changesCommands">
    <xs:annotation>
      <xs:documentation>changes: what can be done from anywhere: a variable, a look, a sound, a scene, an object put back, made or taken away, or another object's action run</xs:documentation>
    </xs:annotation>
    <xs:choice>
      <xs:element name="inc" type="variableReferenceType" />
      <xs:element name="dec" type="variableReferenceType" />
      <xs:element name="set" type="setType">
        <xs:annotation>
          <xs:documentation>
            set: the variable (owner.variable), or owner.x, owner.y,
            owner.velocity.x, owner.velocity.y or owner.heading, takes the
            value, worked out as it runs
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="copy">
        <xs:annotation>
          <xs:documentation>copy: the variable into= takes the number variable= holds now (both owner.variable)</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:attribute name="variable" type="xs:NMTOKEN" use="required" />
          <xs:attribute name="into" type="xs:NMTOKEN" use="required" />
        </xs:complexType>
      </xs:element>
      <xs:element name="count">
        <xs:annotation>
          <xs:documentation><![CDATA[count: the variable into= (owner.variable) takes how many objects of that class are in play now; with <here /> or <around />, only in those cells about the object running it]]></xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:sequence>
            <xs:group ref="cellPlace" minOccurs="0" />
          </xs:sequence>
          <xs:attribute name="class" type="xs:NMTOKEN" use="required" />
          <xs:attribute name="into" type="xs:NMTOKEN" use="required" />
        </xs:complexType>
      </xs:element>
      <xs:element name="rank">
        <xs:annotation>
          <xs:documentation>rank: the entry variable= is of goes into the group into= (the best first), in place by that variable</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:attribute name="variable" type="xs:NMTOKEN" use="required" />
          <xs:attribute name="into" type="xs:NMTOKEN" use="required" />
        </xs:complexType>
      </xs:element>
      <xs:element name="play">
        <xs:complexType>
          <xs:attribute name="sound" type="xs:NMTOKEN" use="required" />
        </xs:complexType>
      </xs:element>
      <xs:element name="silence">
        <xs:complexType>
          <xs:attribute name="sound" type="xs:NMTOKEN" use="required" />
        </xs:complexType>
      </xs:element>
      <xs:element name="become">
        <xs:complexType>
          <xs:attribute name="sprite" type="xs:NMTOKEN" use="optional">
            <xs:annotation>
              <xs:documentation>a look, a palette (a style its bitmaps take instead), or both</xs:documentation>
            </xs:annotation>
          </xs:attribute>
          <xs:attribute name="style" type="xs:NMTOKEN" use="optional" />
          <xs:attribute name="object" type="xs:NMTOKEN" use="optional" />
          <xs:attribute name="from" type="xs:NMTOKEN" use="optional">
            <xs:annotation>
              <xs:documentation>only those showing this look change</xs:documentation>
            </xs:annotation>
          </xs:attribute>
        </xs:complexType>
      </xs:element>
      <xs:element name="reveal">
        <xs:annotation>
          <xs:documentation>reveal: the objects (a group) out of play to bring in, and how many (one if left out)</xs:documentation>
        </xs:annotation>
        <xs:complexType mixed="true">
          <xs:sequence>
            <xs:group ref="valueTag" minOccurs="0" />
          </xs:sequence>
          <xs:attribute name="object" type="xs:NMTOKEN" use="optional" />
        </xs:complexType>
      </xs:element>
      <xs:element name="follow" type="followType" />
      <xs:element name="shift">
        <xs:annotation>
          <xs:documentation><![CDATA[
            <shift object="aliens"><x>2</x></shift>: those objects, and the
            places they go home to, moved by x across and y down
          ]]></xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:sequence>
            <xs:element name="x" type="valueType" minOccurs="0" />
            <xs:element name="y" type="valueType" minOccurs="0" />
          </xs:sequence>
          <xs:attribute name="object" type="xs:NMTOKEN" use="required" />
        </xs:complexType>
      </xs:element>
      <xs:element name="enter">
        <xs:annotation>
          <xs:documentation><![CDATA[
            <enter scene="room2" />: that scene becomes its state's current one;
            <enter way="east" />: the scene the current scene's way leads to.
          ]]></xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:attribute name="scene" type="xs:NMTOKEN" use="optional" />
          <xs:attribute name="way" type="xs:NMTOKEN" use="optional" />
        </xs:complexType>
      </xs:element>
      <xs:element name="reset">
        <xs:annotation>
          <xs:documentation><![CDATA[
            <reset /> puts back the object running it; object= that object
            or group; scene= every object of that scene, as it started; way=
            the scene that way of the current scene leads to.
          ]]></xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:attribute name="object" type="xs:NMTOKEN" use="optional" />
          <xs:attribute name="scene" type="xs:NMTOKEN" use="optional" />
          <xs:attribute name="way" type="xs:NMTOKEN" use="optional" />
        </xs:complexType>
      </xs:element>
      <xs:element name="spawn" type="spawnType">
        <xs:annotation>
          <xs:documentation><![CDATA[
            spawn: a new copy of the object (of a group, its members in
            turn) comes into the game, where the <position> says and going as
            the <velocity> says (a half left out is as the object starts),
            worked out as it runs
          ]]></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="send" type="sendType">
        <xs:annotation>
          <xs:documentation>
            send: a piece from one map of cells to another (a next-piece box
            to the playfield), refused if it has no room there
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="order" type="orderType" />
      <xs:element name="distribute" type="distributeType">
        <xs:annotation>
          <xs:documentation><![CDATA[
            distribute: N each from the holder from= into the holder into=, or
            into a group's, each member's own (<owns>) a card a round in turn
          ]]></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="despawn">
        <xs:annotation>
          <xs:documentation>
            despawn: the object running it, or object= every one of that
            name or group, is taken out of the game
          </xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:attribute name="object" type="xs:NMTOKEN" use="optional" />
        </xs:complexType>
      </xs:element>
      <xs:element name="trigger">
        <xs:complexType>
          <!-- with <here /> or <around /> and class=: the action of each piece of that class in those cells about the object running it, each once a press however the actions call one another -->
          <xs:choice minOccurs="0">
            <xs:element name="otherwise" type="stateCommandsType">
              <xs:annotation>
                <xs:documentation><![CDATA[in a key's <input>: commands run only when the action it runs is refused (for now only there)]]></xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:group ref="cellPlace" />
          </xs:choice>
          <xs:attribute name="object" type="xs:NMTOKEN" use="optional">
            <xs:annotation>
              <xs:documentation>left out in an object's own collision, action or timer: that object</xs:documentation>
            </xs:annotation>
          </xs:attribute>
          <xs:attribute name="class" type="xs:NMTOKEN" use="optional" />
          <xs:attribute name="action" type="xs:NMTOKEN" use="required" />
          <xs:attribute name="from" type="xs:NMTOKEN" use="optional">
            <xs:annotation>
              <xs:documentation>only those of them showing this look</xs:documentation>
            </xs:annotation>
          </xs:attribute>
        </xs:complexType>
      </xs:element>
    </xs:choice>
  </xs:group>

  <xs:group name="flowCommands">
    <xs:annotation>
      <xs:documentation>flow: the running order of the game: its states, its players' turns, its demo</xs:documentation>
    </xs:annotation>
    <xs:choice>
      <xs:element name="push">
        <xs:complexType>
          <xs:attribute name="state" type="xs:NMTOKEN" use="required" />
        </xs:complexType>
      </xs:element>
      <xs:element name="pop">
        <xs:annotation>
          <xs:documentation><![CDATA[
            <pop /> goes back to the state underneath; <pop state="..." /> puts
            that state in place of this one.
          ]]></xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:attribute name="state" type="xs:NMTOKEN" use="optional" />
        </xs:complexType>
      </xs:element>
      <xs:element name="alternate">
        <xs:annotation>
          <xs:documentation><![CDATA[
            alternate: a <player> for each player taking turns, each with a game of their own (the arcade way),
            and the state that says whose turn it is
          ]]></xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:sequence>
            <xs:element name="player" maxOccurs="unbounded">
              <xs:complexType>
                <xs:attribute name="state" type="xs:NMTOKEN" use="optional" />
              </xs:complexType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="pass" type="passType">
        <xs:annotation>
          <xs:documentation>pass: the next player's turn</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="out" type="emptyType">
        <xs:annotation>
          <xs:documentation><![CDATA[out: this player is out, and the next player's turn]]></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="demo" type="emptyType">
        <xs:annotation>
          <xs:documentation><![CDATA[demo: the game's recorded <demo> plays, until a key is pressed]]></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="undo" type="emptyType">
        <xs:annotation>
          <xs:documentation>undo: the pieces on cells and every object's numbers back as before the last press that moved a piece; refused when there is none</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:choice>
  </xs:group>

  <xs:group name="selfCommands">
    <xs:annotation>
      <xs:documentation>self: what an object does to itself</xs:documentation>
    </xs:annotation>
    <xs:choice>
      <xs:element name="die" type="emptyType" />
      <xs:element name="drop" type="emptyType" />
      <xs:element name="hop" type="hopType">
        <xs:annotation>
          <xs:documentation><![CDATA[hop: a step at once; on a map with <cells />, whole cells (one with nothing written), refused and touching what is in the way]]></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="move" type="stepType" />
      <xs:element name="reverse" type="emptyType" />
      <xs:element name="stop" type="emptyType" />
      <xs:element name="fire">
        <xs:complexType>
          <xs:attribute name="object" type="xs:NMTOKEN" use="required" />
        </xs:complexType>
      </xs:element>
      <xs:element name="settle" type="emptyType">
        <xs:annotation>
          <xs:documentation><![CDATA[settle: on a map with <cells />, a shape's cells stay as loose pieces and the shape is gone; then the map's checks]]></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="slide" type="slideType" />
      <xs:element name="cycle">
        <xs:annotation>
          <xs:documentation><![CDATA[cycle: on a map with <cells />, a shape's cells each move on to the next cell of its outline, in reading order, the last to the first (Columns' jewels); direction="backward" the other way]]></xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:attribute name="direction" type="cycleDirectionType" />
        </xs:complexType>
      </xs:element>
      <xs:element name="grow" type="emptyType">
        <xs:annotation>
          <xs:documentation><![CDATA[grow: an object with a <chain> gets one link longer, at its tail, on its next step]]></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="split" type="emptyType">
        <xs:annotation>
          <xs:documentation>split: a piece of a chain cuts it there: it leaves the chain, and the links behind it are a chain of their own, led by the first of them</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="pick">
        <xs:annotation>
          <xs:documentation><![CDATA[pick: a picker on a map of cells over a board takes up the piece of that class (left out: of the pieces the player on its turn <owns>) in its cell, one with a move to make; refused when there is none, or while the piece held must jump on. With <only />: the one piece of that class that has a move, wherever the picker is, when only one has]]></xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:sequence>
            <xs:element name="only" type="emptyType" minOccurs="0" />
            <xs:element name="most" type="xs:positiveInteger" minOccurs="0">
              <xs:annotation>
                <xs:documentation><![CDATA[most: by a picker of a class a <holds> holds, from how many holders it may hold one at once (Pyramid's two)]]></xs:documentation>
              </xs:annotation>
            </xs:element>
          </xs:sequence>
          <xs:attribute name="class" type="xs:NMTOKEN" use="optional" />
        </xs:complexType>
      </xs:element>
      <xs:element name="place">
        <xs:annotation>
          <xs:documentation><![CDATA[
            place: the piece held makes its move that ends in the picker's cell; refused when none does, and while it can jump on.
            By a picker of a class a <holds> holds: lays what it holds where it points (into=: on the first of those holders that accepts it)
          ]]></xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:attribute name="into" type="xs:NMTOKEN" use="optional" />
        </xs:complexType>
      </xs:element>
      <xs:element name="call">
        <xs:annotation>
          <xs:documentation><![CDATA[
            call, on a hand with a pile of its own: the suit of the card it points at there is called for the holder object=, waiting
            with a <wild> card on top; refused when it is not waiting
          ]]></xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:attribute name="object" type="xs:NMTOKEN" use="required" />
        </xs:complexType>
      </xs:element>
      <xs:element name="put">
        <xs:annotation>
          <xs:documentation><![CDATA[put: a new piece of class= (left out: of the pieces the player on its turn <owns>) in the picker's cell of the pieces' map; refused when the cell is taken, or, when the pieces have <flank>s, where it traps nothing; the pieces it traps turn into its kind. A piece put whose <moves> have a <close> may claim what it walls in; then the put counts as refused (the turn goes on)]]></xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:attribute name="class" type="xs:NMTOKEN" use="optional" />
        </xs:complexType>
      </xs:element>
    </xs:choice>
  </xs:group>

  <xs:group name="steeringCommands">
    <xs:annotation>
      <xs:documentation>steering: an object steering itself toward or around another</xs:documentation>
    </xs:annotation>
    <xs:choice>
      <xs:element name="aim">
        <xs:annotation>
          <xs:documentation><![CDATA[aim: face object=, so the next <fire> goes straight at it]]></xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:sequence>
            <xs:element name="lined" type="valueType" minOccurs="0">
              <xs:annotation>
                <xs:documentation>
                  only when lined up with it, across, up or down or on a true
                  diagonal, within this many pixels; otherwise refused
                </xs:documentation>
              </xs:annotation>
            </xs:element>
          </xs:sequence>
          <xs:attribute name="object" type="xs:NMTOKEN" use="required" />
        </xs:complexType>
      </xs:element>
      <xs:element name="chase" type="chaseType">
        <xs:annotation>
          <xs:documentation><![CDATA[chase: head for an object]]></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="hunt" type="huntType" />
      <xs:element name="wander" type="wanderType" />
    </xs:choice>
  </xs:group>

  <xs:group name="touchCommands">
    <xs:annotation>
      <xs:documentation>touch: what needs another object, touched</xs:documentation>
    </xs:annotation>
    <xs:choice>
      <xs:element name="carry" type="emptyType" />
      <xs:element name="deflect" type="deflectType">
        <xs:annotation>
          <xs:documentation>Bounces off the object touched, leaving at up to this many degrees (the content) by where along the side it hit: straight back at the middle, the widest at the ends. The speed is kept (Pong).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="hole" type="holeType" />
      <xs:element name="knock" type="knockType" />
      <xs:element name="land" type="emptyType">
        <xs:annotation>
          <xs:documentation>land: stand on top of the object touched</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="ride" type="emptyType" />
      <xs:element name="through" type="emptyType">
        <xs:annotation>
          <xs:documentation><![CDATA[through: on a map with <cells />, the refused step is made after all, into the cell with what is there]]></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="shove" type="emptyType">
        <xs:annotation>
          <xs:documentation>shove: on cells, what is in the way goes one cell on, the way it was met, and the step goes on; refused when it cannot</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="merge">
        <xs:annotation>
          <xs:documentation>merge: on cells, a piece in the way with the same number in variable= is taken away, its number added to this one's, and the step goes on; refused when they differ or either merged in this slide</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:attribute name="variable" type="xs:NMTOKEN" use="required" />
        </xs:complexType>
      </xs:element>
    </xs:choice>
  </xs:group>

  <xs:group name="edgeCommands">
    <xs:annotation>
      <xs:documentation>edge: what needs a screen edge (stick also takes a touch: only the velocity into what it met stops)</xs:documentation>
    </xs:annotation>
    <xs:choice>
      <xs:element name="stick" type="emptyType" />
      <xs:element name="wrap" type="emptyType" />
    </xs:choice>
  </xs:group>

  <xs:group name="bounceCommands">
    <xs:annotation>
      <xs:documentation>bounce: off a screen edge or another object</xs:documentation>
    </xs:annotation>
    <xs:choice>
      <xs:element name="bounce" type="knockType">
        <xs:annotation>
          <xs:documentation>
            bounce: off what it touched, mirrored about the way its surface faces;
            its value is the share of the speed kept (left out, 1; above 1, a bumper)
          </xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:choice>
  </xs:group>

  <xs:group name="controlsCommands">
    <xs:annotation>
      <xs:documentation>controls: how an object moves when its action is asked for</xs:documentation>
    </xs:annotation>
    <xs:choice>
      <xs:element name="climb" type="climbType" />
      <xs:element name="go" type="goType" />
      <xs:element name="jump" type="valueType">
        <xs:annotation>
          <xs:documentation><![CDATA[jump: up off the ground that high, under the object's own pull]]></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="swing" type="swingType">
        <xs:annotation>
          <xs:documentation><![CDATA[swing: held, the heading turns <degrees> that way in one eased stroke <seconds> long; let go, back to the heading it started with]]></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="thrust" type="thrustType" />
      <xs:element name="turn" type="turnType" />
      <xs:element name="track">
        <xs:annotation>
          <xs:documentation><![CDATA[track: where a control points; path= along that path instead of across the window; on cells, <onto>s: the cell nearest the pointer holding one of those classes]]></xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:sequence>
            <xs:element name="onto" type="ontoType" minOccurs="0" maxOccurs="unbounded" />
          </xs:sequence>
          <xs:attribute name="path" type="xs:NMTOKEN" use="optional" />
        </xs:complexType>
      </xs:element>
    </xs:choice>
  </xs:group>

  <xs:group name="pressCommands">
    <xs:annotation>
      <xs:documentation>press: a button held down, as a computer player does</xs:documentation>
    </xs:annotation>
    <xs:choice>
      <xs:element name="hold">
        <xs:annotation>
          <xs:documentation><![CDATA[hold: only in a <computer>'s condition: the button held down while it holds]]></xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:attribute name="button" type="xs:NMTOKEN" use="required" />
        </xs:complexType>
      </xs:element>
      <xs:element name="think">
        <xs:annotation>
          <xs:documentation><![CDATA[
            think: only in a <computer>'s condition: while it holds, the computer plays the board game pieces of class= (left out: those the player on its turn <owns>),
            looking <depth> moves ahead (4 when left out), each piece worth 1 or its look's <worth>; it walks the picker
            object= to the piece and each cell of its move, pressing button= on each
          ]]></xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:sequence>
            <xs:element name="depth" type="xs:positiveInteger" minOccurs="0" />
            <xs:element name="avoid" type="emptyType" minOccurs="0">
              <xs:annotation>
                <xs:documentation>avoid: a card player that keeps out of tricks (Hearts); none: one that takes them</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element name="worth" minOccurs="0" maxOccurs="unbounded">
              <xs:complexType>
                <xs:simpleContent>
                  <xs:extension base="xs:decimal">
                    <xs:attribute name="sprite" type="xs:NMTOKEN" use="required" />
                  </xs:extension>
                </xs:simpleContent>
              </xs:complexType>
            </xs:element>
          </xs:sequence>
          <xs:attribute name="class" type="xs:NMTOKEN" use="optional" />
          <xs:attribute name="object" type="xs:NMTOKEN" use="required" />
          <xs:attribute name="button" type="xs:NMTOKEN" use="required" />
        </xs:complexType>
      </xs:element>
    </xs:choice>
  </xs:group>

  <xs:group name="cellsCommands">
    <xs:annotation>
      <xs:documentation><![CDATA[cells: what a check of a map with <cells /> does with what it found]]></xs:documentation>
    </xs:annotation>
    <xs:choice>
      <xs:element name="clear" type="emptyType">
        <xs:annotation>
          <xs:documentation>clear: what it found leaves the game</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="collapse" type="emptyType">
        <xs:annotation>
          <xs:documentation><![CDATA[collapse: what is above a full row comes down a row]]></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="fall">
        <xs:annotation>
          <xs:documentation>fall: every loose piece of the map (with class=, only those of that class) drops down its column onto what is under it</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:attribute name="class" type="xs:NMTOKEN" />
        </xs:complexType>
      </xs:element>
    </xs:choice>
  </xs:group>

  <xs:group name="checkCommands">
    <xs:annotation>
      <xs:documentation><![CDATA[a check of a map with <cells />]]></xs:documentation>
    </xs:annotation>
    <xs:choice>
      <xs:group ref="changesCommands" />
      <xs:group ref="cellsCommands" />
    </xs:choice>
  </xs:group>

  <xs:group name="ruleCommands">
    <xs:annotation>
      <xs:documentation>a collision rule: about another object (touch, steering) or about a screen edge (edge); the loader holds each kind to its own</xs:documentation>
    </xs:annotation>
    <xs:choice>
      <xs:group ref="changesCommands" />
      <xs:group ref="selfCommands" />
      <xs:group ref="steeringCommands" />
      <xs:group ref="touchCommands" />
      <xs:group ref="edgeCommands" />
      <xs:group ref="bounceCommands" />
    </xs:choice>
  </xs:group>

  <xs:group name="actionCommands">
    <xs:annotation>
      <xs:documentation>an object's action</xs:documentation>
    </xs:annotation>
    <xs:choice>
      <xs:group ref="changesCommands" />
      <xs:group ref="selfCommands" />
      <xs:group ref="steeringCommands" />
      <xs:group ref="controlsCommands" />
      <xs:element name="pass" type="passType">
        <xs:annotation>
          <xs:documentation><![CDATA[pass, by a member of a group that takes <turns>: the next member's turn; refused while a holder waits for a wild card's call]]></xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:choice>
  </xs:group>

  <xs:group name="objectTimeCommands">
    <xs:annotation>
      <xs:documentation>an object's timer, and a step of a path an object follows</xs:documentation>
    </xs:annotation>
    <xs:choice>
      <xs:group ref="changesCommands" />
      <xs:group ref="selfCommands" />
      <xs:group ref="steeringCommands" />
    </xs:choice>
  </xs:group>

  <xs:group name="stateCommands">
    <xs:annotation>
      <xs:documentation>a state's keys, conditions and timers, and a scene's</xs:documentation>
    </xs:annotation>
    <xs:choice>
      <xs:group ref="changesCommands" />
      <xs:group ref="flowCommands" />
    </xs:choice>
  </xs:group>

  <xs:complexType name="followType">
    <xs:annotation>
      <xs:documentation><![CDATA[
        follow: the object sets off along one of the game's <paths>. With object=
        every object of that name or group does, each <stagger> seconds after the
        one before (0 if left out); with <nearest>N</nearest>, only the N of them
        nearest the object running it.
      ]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="stagger" type="valueType" minOccurs="0" />
      <xs:element name="nearest" type="valueType" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="path" type="xs:NMTOKEN" use="required" />
    <xs:attribute name="object" type="xs:NMTOKEN" use="optional" />
  </xs:complexType>

  <xs:complexType name="pathStepType">
    <xs:annotation>
      <xs:documentation>
        A path: how fast it is flown (pixels a frame), where it begins (left out:
        wherever the object is), then its legs in order. A step moves the object
        by x and y from where the step began, and runs its commands as it sets
        off; home takes it back to where it started the game.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="x" type="valueType" />
      <xs:element name="y" type="valueType" />
      <xs:group ref="objectTimeCommands" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="pathType">
    <xs:sequence>
      <xs:element name="speed" type="valueType" />
      <xs:element name="start" type="vector2Type" minOccurs="0" />
      <xs:choice maxOccurs="unbounded">
        <xs:element name="step" type="pathStepType" />
        <xs:element name="home" type="emptyType" />
      </xs:choice>
    </xs:sequence>
    <xs:attribute name="name" type="xs:NMTOKEN" use="required" />
  </xs:complexType>

  <xs:complexType name="ruleCommandsType">
    <xs:annotation>
      <xs:documentation><![CDATA[
        A collision rule. With edge it is about a screen edge, and takes no class
        or object; without, it is about another object, narrowed by class and/or
        object (neither: anything). Either is passed over while the object is
        touching something of the unless class. Its
        conditions about itself read its speed (the live number speed) as the
        touch happened. With sprite, it runs only while the object shows its
        sprite of that name (see become). A rule may hold rules, which say what it
        says too (a holder's attribute is not said again below it), its <first>
        running as a rule of its own before them.
      ]]></xs:documentation>
    </xs:annotation>
    <xs:group ref="ruleCommands" minOccurs="0" maxOccurs="unbounded" />
  </xs:complexType>
  <xs:complexType name="collisionType">
    <xs:sequence>
      <!-- conditions (tests alone, no commands) that must all hold for the
           rule to run; one with no class= or object= is about the object itself -->
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="condition" type="testType" />
        <xs:element name="any" type="joinType" />
      </xs:choice>
      <xs:choice>
        <!-- rules it holds, each saying what this one says too; every one that matches runs, after <first> -->
        <xs:sequence>
          <xs:element name="first" type="ruleCommandsType" minOccurs="0" />
          <xs:element name="collision" type="collisionType" maxOccurs="unbounded" />
        </xs:sequence>
        <xs:group ref="ruleCommands" minOccurs="0" maxOccurs="unbounded" />
      </xs:choice>
    </xs:sequence>
    <xs:attribute name="edge" type="edgeType" use="optional" />
    <xs:attribute name="side" type="edgeType" use="optional">
      <xs:annotation>
        <xs:documentation>the side of this object the other touched: top, bottom, left, right, horizontal or vertical</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="class" type="xs:NMTOKEN" use="optional" />
    <xs:attribute name="object" type="xs:NMTOKEN" use="optional" />
    <xs:attribute name="unless" type="xs:NMTOKEN" use="optional" />
    <xs:attribute name="through" type="xs:NMTOKEN" use="optional">
      <xs:annotation>
        <xs:documentation>
          only a touch felt through something of this class (a knock through
          a floor); a rule without it, only a touch itself
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="sprite" type="xs:NMTOKEN" use="optional" />
  </xs:complexType>

  <xs:complexType name="actionType">
    <xs:annotation>
      <xs:documentation><![CDATA[A named thing an object can do, run by a <trigger>.]]></xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:group ref="actionCommands" />
      <xs:element name="condition" type="actionConditionType">
        <xs:annotation>
          <xs:documentation>a test about the object itself (unless it names another), and the commands it runs while it holds</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:choice>
    <xs:attribute name="name" type="xs:NMTOKEN" use="required" />
  </xs:complexType>

  <xs:complexType name="inputType">
    <xs:annotation>
      <xs:documentation><![CDATA[
        What pressing a key does in a state: button= is one key, and several
        are a <button> each, before the commands (<button>a</button>
        <button>left</button>); or, with axis= (mouse.x, mouse.y, pad1.x, ...)
        instead, the <trigger> run as that control moves. One of the two,
        which the engine checks.
      ]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="button" type="xs:NMTOKEN" minOccurs="0" maxOccurs="unbounded" />
      <xs:group ref="stateCommands" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
    <xs:attribute name="button" type="xs:NMTOKEN" use="optional" />
    <xs:attribute name="axis" type="xs:NMTOKEN" use="optional" />
    <xs:attribute name="on" type="keyMomentType" use="optional">
      <xs:annotation>
        <xs:documentation>
          on: the moment of the key it answers. press (left out: the same) runs
          its commands as the key goes down, a held verb staying on while it is
          down; hold runs them every frame while it is down; release once when
          it is let go. hold and release answer only a press made in this state.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:simpleType name="keyMomentType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="press" />
      <xs:enumeration value="hold" />
      <xs:enumeration value="release" />
    </xs:restriction>
  </xs:simpleType>

  <xs:group name="conditionTest">
    <xs:annotation>
      <xs:documentation>
        One test of a condition: atleast / atmost / above / below /
        equal / unequal compare what is tested (the variable named by variable= of every
        object that matches class and/or object; a total= over them; or each
        one's distance= to the nearest of another) with a number or another
        variable; remaining counts the matching objects still in play.
      </xs:documentation>
    </xs:annotation>
    <xs:choice>
      <xs:element name="atleast" type="compareType" />
      <xs:element name="atmost" type="compareType" />
      <xs:element name="above" type="compareType" />
      <xs:element name="below" type="compareType" />
      <xs:element name="equal" type="compareType" />
      <xs:element name="unequal" type="compareType" />
      <xs:element name="remaining" type="valueType" />
      <xs:element name="lowest" type="emptyType">
        <xs:annotation>
          <xs:documentation>the one whose variable is lowest (highest) of all those matched; a tie, the first</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="highest" type="emptyType" />
    </xs:choice>
  </xs:group>

  <xs:simpleType name="totalType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="count" />
      <xs:enumeration value="sum" />
      <xs:enumeration value="highest" />
      <xs:enumeration value="lowest" />
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="testType">
    <xs:annotation>
      <xs:documentation><![CDATA[
        A <condition> inside an <all>, an <any> or a <collision>: one test with what it tests, and no commands.
        With sprite=, the test may be left out: showing that look is the test.
      ]]></xs:documentation>
    </xs:annotation>
    <xs:group ref="conditionTest" minOccurs="0" />
    <xs:attribute name="class" type="xs:NMTOKEN" use="optional" />
    <xs:attribute name="object" type="xs:NMTOKEN" use="optional" />
    <xs:attribute name="variable" type="xs:NMTOKEN" use="optional" />
    <xs:attribute name="total" type="totalType" use="optional">
      <xs:annotation>
        <xs:documentation>count: how many are in play; sum, highest, lowest: of variable= over them</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="distance" type="xs:NMTOKEN" use="optional">
      <xs:annotation>
        <xs:documentation>how far each is from the nearest in play of this object or group</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="sprite" type="xs:NMTOKEN" use="optional">
      <xs:annotation>
        <xs:documentation>only those showing this look</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="joinType">
    <xs:annotation>
      <xs:documentation><![CDATA[any: one of its conditions holds (or of the <any>s in it). Each a test of its own.]]></xs:documentation>
    </xs:annotation>
    <xs:choice maxOccurs="unbounded">
      <xs:element name="condition" type="testType" />
      <xs:element name="any" type="joinType" />
    </xs:choice>
  </xs:complexType>

  <xs:group name="conditionHead">
    <xs:annotation>
      <xs:documentation><![CDATA[
        Checked every frame. One test (or an <any> of conditions; with sprite=,
        none: showing that look is the test), then the commands to run when it holds; or, holding conditions
        (checked in order only while it holds, the first that holds runs), a
        <first> run before them and an <otherwise> run when none of them does.
        Tests that must all hold are a condition in a condition.
      ]]></xs:documentation>
    </xs:annotation>
    <xs:choice>
      <xs:group ref="conditionTest" />
      <xs:element name="any" type="joinType" />
    </xs:choice>
  </xs:group>
  <xs:attributeGroup name="conditionAttributes">
    <xs:attribute name="class" type="xs:NMTOKEN" use="optional" />
    <xs:attribute name="object" type="xs:NMTOKEN" use="optional" />
    <xs:attribute name="variable" type="xs:NMTOKEN" use="optional" />
    <xs:attribute name="total" type="totalType" use="optional">
      <xs:annotation>
        <xs:documentation>count: how many are in play; sum, highest, lowest: of variable= over them</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="distance" type="xs:NMTOKEN" use="optional">
      <xs:annotation>
        <xs:documentation>how far each is from the nearest in play of this object or group</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="sprite" type="xs:NMTOKEN" use="optional">
      <xs:annotation>
        <xs:documentation>only those showing this look; with no test, showing it is the test</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="name" type="xs:NMTOKEN" use="optional">
      <xs:annotation>
        <xs:documentation>a scene from= this one's can put a condition of the same name in its place</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:complexType name="stateCommandsType">
    <xs:annotation>
      <xs:documentation><![CDATA[
        The commands of a condition that holds conditions: <first> runs as soon as it holds, before they are
        checked; <otherwise> when none of them does.
      ]]></xs:documentation>
    </xs:annotation>
    <xs:group ref="stateCommands" minOccurs="0" maxOccurs="unbounded" />
  </xs:complexType>
  <xs:complexType name="pressCommandsType">
    <xs:group ref="pressCommands" minOccurs="0" maxOccurs="unbounded" />
  </xs:complexType>
  <xs:complexType name="conditionType">
    <xs:sequence minOccurs="0">
      <xs:group ref="conditionHead" minOccurs="0" />
      <xs:choice>
        <xs:sequence>
          <xs:element name="first" type="stateCommandsType" minOccurs="0" />
          <xs:element name="condition" type="conditionType" maxOccurs="unbounded" />
          <xs:element name="otherwise" type="stateCommandsType" minOccurs="0" />
        </xs:sequence>
        <xs:group ref="stateCommands" minOccurs="0" maxOccurs="unbounded" />
      </xs:choice>
    </xs:sequence>
    <xs:attributeGroup ref="conditionAttributes" />
  </xs:complexType>
  <xs:complexType name="actionConditionType">
    <xs:annotation>
      <xs:documentation>A condition in an action: a test, then the action's commands it runs while it holds.</xs:documentation>
    </xs:annotation>
    <xs:sequence minOccurs="0">
      <xs:group ref="conditionHead" minOccurs="0" />
      <xs:group ref="actionCommands" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
    <xs:attributeGroup ref="conditionAttributes" />
  </xs:complexType>
  <xs:complexType name="computerConditionType">
    <xs:annotation>
      <xs:documentation><![CDATA[
        A computer player's condition: a state's test, then the buttons it holds down while it holds. Every one that
        holds counts, so one holding conditions has a <first> but no <otherwise>.
      ]]></xs:documentation>
    </xs:annotation>
    <xs:sequence minOccurs="0">
      <xs:group ref="conditionHead" minOccurs="0" />
      <xs:choice>
        <xs:sequence>
          <xs:element name="first" type="pressCommandsType" minOccurs="0" />
          <xs:element name="condition" type="computerConditionType" maxOccurs="unbounded" />
        </xs:sequence>
        <xs:group ref="pressCommands" minOccurs="0" maxOccurs="unbounded" />
      </xs:choice>
    </xs:sequence>
    <xs:attributeGroup ref="conditionAttributes" />
  </xs:complexType>
  <xs:complexType name="computerType">
    <xs:sequence>
      <xs:element name="condition" type="computerConditionType" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <xs:group name="timerHead">
    <xs:annotation>
      <xs:documentation><![CDATA[
        Timers: each goes off after a number of seconds - <every> again and again
        (worked out again each time, so a <random> waits a new time), <after>
        once - and runs its commands. An object's count while it is shown and in
        play; a state's while it is the current state. A reset starts them over.
      ]]></xs:documentation>
    </xs:annotation>
    <xs:choice>
      <xs:element name="every" type="valueType" />
      <xs:element name="after" type="valueType" />
    </xs:choice>
  </xs:group>
  <xs:attributeGroup name="timerAttributes">
    <xs:attribute name="name" type="xs:NMTOKEN" use="optional">
      <xs:annotation>
        <xs:documentation>a scene from= this one's can put a timer of the same name in its place</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="sprite" type="xs:NMTOKEN" use="optional">
      <xs:annotation>
        <xs:documentation>an object's timer that counts only while it shows this look</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:complexType name="objectTimerType">
    <xs:sequence>
      <xs:group ref="timerHead" />
      <xs:group ref="objectTimeCommands" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
    <xs:attributeGroup ref="timerAttributes" />
  </xs:complexType>
  <xs:complexType name="stateTimerType">
    <xs:sequence>
      <xs:group ref="timerHead" />
      <xs:group ref="stateCommands" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
    <xs:attributeGroup ref="timerAttributes" />
  </xs:complexType>

  <xs:complexType name="objectTimersType">
    <xs:annotation>
      <xs:documentation>An object's timers, and a state's or a scene's: the same timer, each running the commands of its place.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="timer" type="objectTimerType" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="stateTimersType">
    <xs:sequence>
      <xs:element name="timer" type="stateTimerType" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="positionValueType" mixed="true">
    <xs:annotation>
      <xs:documentation><![CDATA[
        Where an object starts: a value, or <centered>, its middle at what it
        holds (a name, a number or an operation), less half its own width (or
        height); left empty, at the window's middle; with an <offset>, that far
        from the window's middle (right or down, a negative number left or up);
        or <left>, <right>, <top> or <bottom>, a side of it on that side of the
        window: <x><centered /></x>, <y><centered><offset>-60</offset></centered></y>,
        <x><right><offset>12</offset></right></x>.
      ]]></xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0">
      <xs:group ref="valueTag" />
      <xs:element name="centered" type="centeredType" />
      <xs:element name="left" type="sideType">
        <xs:annotation>
          <xs:documentation><![CDATA[that side of the object on the window's, its <offset> in from it: <x><right><offset>12</offset></right></x>; left and right in an <x>, top and bottom in a <y>]]></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="right" type="sideType" />
      <xs:element name="top" type="sideType" />
      <xs:element name="bottom" type="sideType" />
    </xs:choice>
    <xs:attribute name="update" type="updateType" use="optional" />
  </xs:complexType>

  <xs:complexType name="sideType">
    <xs:annotation>
      <xs:documentation><![CDATA[<left>, <right>, <top>, <bottom>: an <offset> in from that side of the window, or none.]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="offset" type="xs:string" minOccurs="0" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="centeredType" mixed="true">
    <xs:annotation>
      <xs:documentation><![CDATA[<centered>: where the middle goes (a name, a number or an operation), or one <offset> from the window's middle.]]></xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0">
      <xs:element name="offset" type="xs:string" />
      <xs:group ref="operation" />
    </xs:choice>
  </xs:complexType>

  <xs:complexType name="placeValueType" mixed="true">
    <xs:annotation>
      <xs:documentation><![CDATA[Where a <spawn> puts its copy: worked out as it spawns.]]></xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0">
      <xs:group ref="valueTag" />
      <xs:element name="centered" type="centeredType" />
    </xs:choice>
  </xs:complexType>
  <xs:complexType name="spawnPositionType">
    <xs:sequence>
      <xs:element name="x" type="placeValueType" minOccurs="0" />
      <xs:element name="y" type="placeValueType" minOccurs="0" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="partialPositionType">
    <xs:annotation>
      <xs:documentation><![CDATA[Some of a <position>: a group's, a member's, a cell's or a scene's change (a half left out is the group's, or 0); a half may be live.]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="x" type="positionValueType" minOccurs="0" />
      <xs:element name="y" type="positionValueType" minOccurs="0" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="partialVector2Type">
    <xs:annotation>
      <xs:documentation><![CDATA[Some of two numbers: a group's or a member's <velocity> and <padding>, and an object's <velocity> (a half left out is 0).]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="x" type="valueType" minOccurs="0" />
      <xs:element name="y" type="valueType" minOccurs="0" />
    </xs:sequence>
  </xs:complexType>

  <xs:simpleType name="collisionShapeType">
    <xs:annotation>
      <xs:documentation>How an object's shape is tested: as a box (the default), or by the pixels drawn.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="box" />
      <xs:enumeration value="pixel" />
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="collisionsType">
    <xs:annotation>
      <xs:documentation>Whether collisions are off, whether the object moves in lockstep with the others of its group, how its shape is tested, then the rules.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="off" type="emptyType" minOccurs="0">
        <xs:annotation>
          <xs:documentation><![CDATA[off: no touches until a rule turns them on; left out, a <collisions> is on]]></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="lockstep" type="emptyType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>lockstep: the group moves as one block (a member at an edge turns them all)</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="type" type="collisionShapeType" minOccurs="0" />
      <xs:element name="solid" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="char" use="required">
            <xs:simpleType>
              <xs:restriction base="xs:string">
                <xs:length value="1" />
              </xs:restriction>
            </xs:simpleType>
          </xs:attribute>
        </xs:complexType>
      </xs:element>
      <xs:element name="hitbox" type="hitboxType" minOccurs="0" />
      <xs:element name="collision" type="collisionType" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="hitboxType">
    <xs:annotation>
      <xs:documentation>What an object touches others with instead of its picture: a rectangle or a circle, its top left from the picture's.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:choice>
        <xs:element name="rectangle">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="width" type="valueType" />
              <xs:element name="height" type="valueType" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="circle">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="radius" type="valueType" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:choice>
      <xs:element name="position" type="partialVector2Type" minOccurs="0" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="actionsType">
    <xs:sequence>
      <xs:element name="action" type="actionType" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="variablesType">
    <xs:annotation>
      <xs:documentation>The variables an object owns; one may be live.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="variable" maxOccurs="unbounded">
        <xs:complexType mixed="true">
          <xs:sequence>
            <xs:group ref="valueTag" minOccurs="0" />
          </xs:sequence>
          <xs:attribute name="name" type="xs:NMTOKEN" use="required" />
          <xs:attribute name="update" type="updateType" use="optional" />
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:group name="objectParts">
    <xs:annotation>
      <xs:documentation><![CDATA[
        What every object-like thing may have after its sprites, animations and
        position: an object, a group (for all its members), a piece,
        an object or group on a <map>. Written once so they cannot drift apart.
      ]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="shape" type="shapeType" minOccurs="0">
        <xs:annotation>
          <xs:documentation><![CDATA[on a map with <cells />: the cells it fills, a <row> of characters each; each character picks an object of the map by its char=]]></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="velocity" type="partialVector2Type" minOccurs="0" />
      <xs:element name="acceleration" type="vector2Type" minOccurs="0" />
      <xs:element name="heading" type="liveValueType" minOccurs="0" />
      <xs:element name="pivot" type="vector2Type" minOccurs="0">
        <xs:annotation>
          <xs:documentation><![CDATA[the point of its picture, as drawn, that the heading turns it about (left out, its middle); its <position> is then where that point is on the screen]]></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="drag" type="valueType" minOccurs="0" />
      <xs:element name="friction" type="valueType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>how much a surface it touches holds it back along that surface, as a share of how hard it meets it (0 none); and enough of it holds it still where its pull cannot slide it</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="mass" type="valueType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>how hard it is to knock; left out, a knock does not move it</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="surface" type="surfaceType" minOccurs="0">
        <xs:annotation>
          <xs:documentation><![CDATA[ground: what holds a thing with a <grip> whose middle is over it, in place of its own drag and grip (grass, sand, oil)]]></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="pull" type="targetValueType" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>pulled toward the nearest of each, that much speed a frame</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="seek" type="targetValueType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>turns the way it goes toward the nearest of it, at most that many degrees a frame</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:group ref="sightParts" />
      <xs:element name="facing" type="directionType" minOccurs="0" />
      <xs:group ref="moveParts" />
      <xs:element name="maze" type="mazeType" minOccurs="0" />
      <xs:element name="chain" minOccurs="0">
        <xs:annotation>
          <xs:documentation><![CDATA[on a map with <cells />: the pieces of that name or group behind it follow its trail, a cell each step; <grow /> adds one at the tail]]></xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:attribute name="object" type="xs:NMTOKEN" use="required" />
        </xs:complexType>
      </xs:element>
      <xs:choice minOccurs="0">
        <xs:element name="waiting" type="emptyType">
          <xs:annotation>
            <xs:documentation><![CDATA[out of play (not drawn, touching nothing, not counted) until a <reveal> brings it in]]></xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="ready" type="emptyType">
          <xs:annotation>
            <xs:documentation>in play after all, in a take of a waiting piece or an inner group of a waiting one</xs:documentation>
          </xs:annotation>
        </xs:element>
      </xs:choice>
      <xs:element name="hidden" type="emptyType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>hidden: in play, touching and counted, but never drawn</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="most" type="xs:positiveInteger" minOccurs="0">
        <xs:annotation>
          <xs:documentation><![CDATA[most: how many copies a <spawn> may have made of it at once]]></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="collisions" type="collisionsType" minOccurs="0" />
      <xs:element name="actions" type="actionsType" minOccurs="0" />
      <xs:element name="variables" type="variablesType" minOccurs="0" />
      <xs:element name="timers" type="objectTimersType" minOccurs="0" />
    </xs:sequence>
  </xs:group>

  <xs:complexType name="shapeType">
    <xs:sequence>
      <xs:element name="row" type="xs:string" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="objectType">
    <xs:annotation>
      <xs:documentation><![CDATA[
        Anything that can be drawn, moved or collided with. One with no sprite only
        holds numbers (a score, the lives): it is never drawn, and its position,
        0, 0 if left out, is only where it is.

        from= starts it as a copy of a piece of the top-level <objects> (or of a named
        member of a group piece), changed by what it gives; one named after a
        piece takes it the same way without from=. In a state or scene from=
        another, one named after an object the other has changes that object.
        What is given goes over what it starts from: sprites and animations by
        name, either half of a position or velocity, variables, actions and
        timers by name, collision rules after the piece's, anything else in its
        place. So everything here may be left out, and the engine checks that
        the object made is complete.
      ]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="sprite" type="spriteType" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="animation" type="animationType" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="position" type="partialPositionType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>both halves, unless it starts from something that has them</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:group ref="objectParts" />
    </xs:sequence>
    <xs:attribute name="name" type="xs:NMTOKEN" use="required" />
    <xs:attribute name="class" type="xs:NMTOKEN" use="optional" />
    <xs:attribute name="from" type="xs:NMTOKEN" use="optional" />
  </xs:complexType>

  <xs:complexType name="memberType">
    <xs:annotation>
      <xs:documentation><![CDATA[
        Objects that share a description: a lane of logs or cars, the pads at the
        top of Frogger, a wall of bricks. The group says what its members have in
        common (all of it optional) and each member says only what is its own; what
        a member leaves out it takes from its group, and after that it must be as
        complete as an object. The group's class is every member's, and the group's
        name means all of them.

        The members are either listed, each a <member> (called name="..." if it
        says so, otherwise the group's name, a dot, and its number counting from 1,
        lane3.2), or laid out in <columns> and <rows>: a cell to each place, the
        group's <position> the top left of the first, with <padding> the gaps
        between them. A cell is called the group's name, its column and its row
        (bricks.5.3), counting from 1. A <row number="...">, <column number="...">
        or <cell row="..." column="..."> then changes what the cells it picks have;
        a row or column and a cell may both, and the cell wins, but a row and a
        column (or two rows) that pick one cell may not change the same thing in it.
      ]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="sprite" type="spriteChangeType" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="animation" type="animationType" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="position" type="partialPositionType" minOccurs="0" />
      <xs:element name="velocity" type="partialVector2Type" minOccurs="0" />
      <xs:element name="variables" type="variablesType" minOccurs="0" />
      <xs:element name="owns" type="ownsType" minOccurs="0" />
      <xs:element name="team" type="xs:positiveInteger" minOccurs="0">
        <xs:annotation>
          <xs:documentation>team: its side; partners are members on the same team (a computer's think lets a partner's card win)</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="think" type="memberThinkType" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="name" type="xs:NMTOKEN" use="optional" />
  </xs:complexType>

  <xs:complexType name="showType">
    <xs:annotation>
      <xs:documentation><![CDATA[
        One thing a state shows: an object (or a group) by name, a named
        <shows> set, or (in a state's own <shows>) another state, whose objects
        are drawn still underneath. One of the three.
      ]]></xs:documentation>
    </xs:annotation>
    <xs:attribute name="object" type="xs:NMTOKEN" use="optional" />
    <xs:attribute name="state" type="xs:NMTOKEN" use="optional" />
  </xs:complexType>

  <xs:complexType name="lineOfCellsType">
    <xs:annotation>
      <xs:documentation><![CDATA[
        What the rows (or columns) it picks change. Its padding is the gap before
        it: a row's <y> the gap above it and its <x> the gaps between its cells, a
        column's <x> the gap to its left. The first row and column have no gap
        before them.
      ]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <!-- which it picks: number="2", or a <number> each, or <odd /> or <even /> -->
      <xs:choice minOccurs="0">
        <xs:element name="number" type="xs:positiveInteger" maxOccurs="unbounded" />
        <xs:element name="odd" type="emptyType" />
        <xs:element name="even" type="emptyType" />
      </xs:choice>
      <xs:element name="sprite" type="spriteChangeType" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="animation" type="animationType" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="velocity" type="partialVector2Type" minOccurs="0" />
      <xs:element name="padding" type="partialVector2Type" minOccurs="0" />
      <xs:element name="variables" type="variablesType" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="number" type="xs:positiveInteger" use="optional" />
  </xs:complexType>

  <xs:complexType name="cellType">
    <xs:annotation>
      <xs:documentation>What one cell changes, and a name of its own.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="sprite" type="spriteChangeType" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="animation" type="animationType" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="velocity" type="partialVector2Type" minOccurs="0" />
      <xs:element name="variables" type="variablesType" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="row" type="xs:positiveInteger" use="required" />
    <xs:attribute name="column" type="xs:positiveInteger" use="required" />
    <xs:attribute name="name" type="xs:NMTOKEN" use="optional" />
  </xs:complexType>

  <xs:complexType name="namedCountType">
    <xs:simpleContent>
      <xs:extension base="xs:positiveInteger">
        <xs:attribute name="name" type="xs:NMTOKEN" use="optional" />
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:group name="groupLayout">
    <xs:annotation>
      <xs:documentation>How a group lays out cells: before its sprites.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="columns" type="namedCountType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>name=: what a member's column or row is also called beside column and row (a pack's rank and suit)</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="rows" type="namedCountType" minOccurs="0" />
      <xs:element name="padding" type="partialVector2Type" minOccurs="0" />
      <xs:element name="slope" type="valueType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>
            each column this much lower than the one before it (higher when
            below 0): a sloped girder of pieces
          </xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:group>

  <xs:group name="groupParts">
    <xs:annotation>
      <xs:documentation>What a group gives after its sprites.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="animation" type="animationType" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="position" type="partialPositionType" minOccurs="0" />
      <xs:group ref="objectParts" />
      <xs:element name="turns" minOccurs="0">
        <xs:annotation>
          <xs:documentation><![CDATA[
            turns: the members take turns, in the order written, the first first (live turn: 1 on its turn, else 0);
            keys reach only the member on its turn, and one with a <think> only as the computer presses for it;
            <pass /> in an action hands the turn on. sprite=: the look a member shows off its turn
          ]]></xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:attribute name="sprite" type="xs:NMTOKEN" use="optional" />
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:group>

  <xs:group name="groupMembers">
    <xs:annotation>
      <xs:documentation>A group's members, or what changes its cells.</xs:documentation>
    </xs:annotation>
    <xs:choice>
      <xs:element name="member" type="memberType" maxOccurs="unbounded" />
      <xs:sequence>
        <xs:element name="row" type="lineOfCellsType" minOccurs="0" maxOccurs="unbounded" />
        <xs:element name="column" type="lineOfCellsType" minOccurs="0" maxOccurs="unbounded" />
        <xs:element name="cell" type="cellType" minOccurs="0" maxOccurs="unbounded" />
      </xs:sequence>
    </xs:choice>
  </xs:group>

  <xs:complexType name="groupType">
    <xs:annotation>
      <xs:documentation>
        A group, as an object can be, can start from a piece
        (from=, or named after it); then its members may be left out, and
        given, they replace the piece's.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:group ref="groupLayout" />
      <xs:element name="sprite" type="spriteType" minOccurs="0" maxOccurs="unbounded" />
      <xs:group ref="groupParts" />
      <xs:choice minOccurs="0">
        <xs:group ref="groupMembers" />
        <xs:element name="group" type="innerGroupType" maxOccurs="unbounded" />
      </xs:choice>
    </xs:sequence>
    <xs:attribute name="name" type="xs:NMTOKEN" use="required" />
    <xs:attribute name="class" type="xs:NMTOKEN" use="optional" />
    <xs:attribute name="from" type="xs:NMTOKEN" use="optional" />
  </xs:complexType>

  <xs:complexType name="innerGroupType">
    <xs:annotation>
      <xs:documentation>A group inside another: the same, except that a sprite of the outer group's (by name) need only give what changes.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:group ref="groupLayout" />
      <xs:element name="sprite" type="spriteChangeType" minOccurs="0" maxOccurs="unbounded" />
      <xs:group ref="groupParts" />
      <xs:choice>
        <xs:group ref="groupMembers" />
        <xs:element name="group" type="innerGroupType" maxOccurs="unbounded" />
      </xs:choice>
    </xs:sequence>
    <xs:attribute name="name" type="xs:NMTOKEN" use="required" />
    <xs:attribute name="class" type="xs:NMTOKEN" use="optional" />
  </xs:complexType>

  <xs:complexType name="mapObjectType">
    <xs:annotation>
      <xs:documentation><![CDATA[
        An object on a <map>: as any other, but with no <position>; char= picks
        the one tile of the map's rows it starts on.
      ]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="sprite" type="spriteType" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation><![CDATA[none for a <shape>, which its cells draw]]></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="animation" type="animationType" minOccurs="0" maxOccurs="unbounded" />
      <xs:group ref="objectParts" />
    </xs:sequence>
    <xs:attribute name="name" type="xs:NMTOKEN" use="required" />
    <xs:attribute name="class" type="xs:NMTOKEN" use="optional" />
    <xs:attribute name="char" type="mapCharType" use="optional">
      <xs:annotation>
        <xs:documentation><![CDATA[on a map with <cells />, left out (or on no tile): it waits to be spawned]]></xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="mapGroupType">
    <xs:annotation>
      <xs:documentation><![CDATA[
        A group on a <map>: a member on each tile of the character char= picks,
        or groups inside it that each pick one (and change its sprites by name,
        as an inner group does). The map says where, so it has no layout, no
        <position> and no <member>s.
      ]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="sprite" type="spriteChangeType" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="animation" type="animationType" minOccurs="0" maxOccurs="unbounded" />
      <xs:group ref="objectParts" />
      <xs:element name="group" type="mapGroupType" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
    <xs:attribute name="name" type="xs:NMTOKEN" use="required" />
    <xs:attribute name="class" type="xs:NMTOKEN" use="optional" />
    <xs:attribute name="char" type="mapCharType" use="optional" />
  </xs:complexType>

  <xs:complexType name="mapType">
    <xs:annotation>
      <xs:documentation><![CDATA[
        Level data: the size of a tile, where the top left of the map is, its
        <row>s of characters (a character a tile, every row as wide), and the
        groups and objects that say what each character is. A character nothing
        picks is an empty tile. The map's name means everything on it. A map that
        takes a map piece (from=, or by its name) gives only what it changes,
        most often its <row>s; each part is then left out here, and the loader
        asks for any the map still lacks.
      ]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="tile" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="width" type="valueType" />
            <xs:element name="height" type="valueType" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="position" type="partialVector2Type" minOccurs="0" />
      <xs:element name="columns" type="xs:positiveInteger" minOccurs="0">
        <xs:annotation>
          <xs:documentation><![CDATA[how many tiles across and down, for a map with no <row>s]]></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="rows" type="xs:positiveInteger" minOccurs="0" />
      <xs:element name="cells" type="emptyType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>its pieces move a cell at a time, and a move that is refused touches what refused it</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="row" type="xs:string" minOccurs="0" maxOccurs="unbounded" />
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="group" type="mapGroupType" />
        <xs:element name="object" type="mapObjectType" />
      </xs:choice>
      <xs:element name="checks" type="checksType" minOccurs="0">
        <xs:annotation>
          <xs:documentation><![CDATA[on a map with <cells />: what it asks after something settles]]></xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="name" type="xs:NMTOKEN" use="required" />
    <xs:attribute name="from" type="xs:NMTOKEN" use="optional" />
  </xs:complexType>

  <xs:complexType name="checksType">
    <xs:annotation>
      <xs:documentation><![CDATA[A cell map's checks: <full> is a row every cell of which holds a loose piece (of class=, if given); its commands run once for each. <line> is every line of so many alike.]]></xs:documentation>
    </xs:annotation>
    <xs:choice maxOccurs="unbounded">
      <xs:element name="full">
        <xs:complexType>
          <xs:sequence>
            <xs:group ref="checkCommands" maxOccurs="unbounded" />
          </xs:sequence>
          <xs:attribute name="class" type="xs:NMTOKEN" use="optional" />
        </xs:complexType>
      </xs:element>
      <xs:element name="line">
        <xs:annotation>
          <xs:documentation><![CDATA[
            line: <atleast> so many pieces alike (of one group) in a row, across, down or diagonal; every such line at once, asked again after its commands until none.
            <straight />: across and down only. <alike variable="hue" />: alike by that variable's value instead of by group.
          ]]></xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:sequence>
            <xs:element name="atleast" type="xs:positiveInteger" />
            <xs:element name="straight" type="emptyType" minOccurs="0" />
            <xs:element name="alike" minOccurs="0">
              <xs:complexType>
                <xs:attribute name="variable" type="xs:NMTOKEN" use="required" />
              </xs:complexType>
            </xs:element>
            <xs:group ref="checkCommands" maxOccurs="unbounded" />
          </xs:sequence>
          <xs:attribute name="class" type="xs:NMTOKEN" use="optional" />
        </xs:complexType>
      </xs:element>
    </xs:choice>
  </xs:complexType>

  <xs:complexType name="objectsType">
    <xs:annotation>
      <xs:documentation>Objects and groups: the game's, a state's or a scene's.</xs:documentation>
    </xs:annotation>
    <xs:choice maxOccurs="unbounded">
      <xs:element name="object" type="objectType" />
      <xs:element name="group" type="groupType" />
      <xs:element name="map" type="mapType" />
    </xs:choice>
  </xs:complexType>

  <xs:complexType name="conditionsType">
    <xs:sequence>
      <xs:element name="condition" type="conditionType" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="waysType">
    <xs:annotation>
      <xs:documentation><![CDATA[
        Where a scene's ways lead: <way name="east" scene="screen2" />, a
        scene of the same state, gone to by <enter way="east" />.
      ]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="way" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="name" type="xs:NMTOKEN" use="required" />
          <xs:attribute name="scene" type="xs:NMTOKEN" use="required" />
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="sceneType">
    <xs:annotation>
      <xs:documentation>
        One place of a state: its own numbers (read inside it by their plain
        names), its objects, and the conditions and timers that run while it is
        its state's current scene. from= starts it as a copy of an earlier
        scene: its objects, variables, ways, conditions and timers, changed by
        its own of the same names, and with its own added.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="ways" type="waysType" minOccurs="0" />
      <xs:element name="variables" type="variablesType" minOccurs="0" />
      <xs:element name="objects" type="objectsType" minOccurs="0" />
      <xs:element name="conditions" type="conditionsType" minOccurs="0" />
      <xs:element name="timers" type="stateTimersType" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="name" type="xs:NMTOKEN" use="required" />
    <xs:attribute name="from" type="xs:NMTOKEN" use="optional" />
  </xs:complexType>

  <xs:complexType name="scenesType">
    <xs:annotation>
      <xs:documentation>The scenes; the first is current when the game starts.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="scene" type="sceneType" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="piecesType">
    <xs:annotation>
      <xs:documentation><![CDATA[
        The top-level <objects>: pieces, objects, groups and maps written once,
        never in play themselves. A piece comes into play where an <objects> of
        <states>, of a state or of a scene takes it (an object or group from=
        one, or named after one), or as copies a <spawn> or <fire>
        that names it makes, which come into the game beside what spawns them.
        A piece can be from= an earlier piece.
      ]]></xs:documentation>
    </xs:annotation>
    <xs:choice maxOccurs="unbounded">
      <xs:element name="object" type="objectType" />
      <xs:element name="group" type="groupType" />
      <xs:element name="map" type="mapType" />
    </xs:choice>
  </xs:complexType>

  <xs:element name="game">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="window">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="width" type="windowSizeType" />
              <xs:element name="height" type="windowSizeType" />
              <xs:element name="scale" type="xs:positiveInteger" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>scale: each of the game's pixels drawn as a square this many window pixels across</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="background" type="xs:string" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>left out: color.black, a window and 60; fullscreen: the whole screen</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="fullscreen" type="emptyType" minOccurs="0" />
              <xs:element name="framerate" type="xs:positiveInteger" minOccurs="0" />
            </xs:sequence>
            <xs:attribute name="name" type="xs:string" use="required" />
          </xs:complexType>
        </xs:element>
        <xs:element name="variables">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="variable" type="variableType" maxOccurs="unbounded" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="paths" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="path" type="pathType" maxOccurs="unbounded" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="styles" minOccurs="0">
          <xs:annotation>
            <xs:documentation><![CDATA[
              Named looks for text: a <text style="title"> takes the <size> and
              <color> it leaves out from the <style name="title">.
            ]]></xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="style" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="size" type="valueType" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation><![CDATA[a <text>'s]]></xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="scale" type="valueType" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation><![CDATA[a <bitmap>'s]]></xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="color" type="bitmapColorType" minOccurs="0" maxOccurs="unbounded">
                      <xs:annotation>
                        <xs:documentation>either's: the one with no char=; a bitmap's, each char=</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="font" type="xs:string" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation><![CDATA[a <text>'s font file]]></xs:documentation>
                      </xs:annotation>
                    </xs:element>
                  </xs:sequence>
                  <xs:attribute name="name" type="xs:NMTOKEN" use="required" />
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="patterns" minOccurs="0" maxOccurs="unbounded">
          <xs:annotation>
            <xs:documentation><![CDATA[
              What a pile's cards may make, the lowest first, for a pile's
              <score patterns="name">: each <pattern> one or more parts that all
              hold: <alike variable="rank">N (N cards of one rank; each <alike> a
              rank of its own), <alike variable="suit">N (N cards of one suit),
              <run variable="worth">N (N worths in a row, a card counting its high
              too; variable="rank": its column, for <melds /> only).
            ]]></xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="pattern" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:choice maxOccurs="unbounded">
                    <xs:element name="alike" type="patternPartType" />
                    <xs:element name="run" type="patternPartType" />
                  </xs:choice>
                  <xs:attribute name="name" type="xs:NMTOKEN" use="required" />
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:attribute name="name" type="xs:NMTOKEN" use="required" />
          </xs:complexType>
        </xs:element>
        <xs:element name="objects" type="piecesType" minOccurs="0" />
        <xs:element name="keeps" minOccurs="0">
          <xs:annotation>
            <xs:documentation><![CDATA[
              What a full <reset /> passes over: each <keep> names an object or a
              group, which keeps what it holds (a best score) into the next game.
            ]]></xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="keep" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="object" type="xs:NMTOKEN" use="required" />
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="states">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="objects" type="objectsType" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>the game's own objects, in play in every state that shows them</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="state" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="objects" type="objectsType" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>the state's own objects, in play in every scene of it</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="scenes" type="scenesType" minOccurs="0" />
                    <xs:element name="starts" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation><![CDATA[
                          starts: done as the state begins and on a full reset, the
                          deal: a <send from into> of <all /> of a group's held
                          members into one holder, then <order group> at <random />
                          and <distribute from into>N (each, one at a time round;
                          <more>: each after the first that many more) and <send
                          from into>N from it.
                        ]]></xs:documentation>
                      </xs:annotation>
                      <xs:complexType>
                        <xs:choice maxOccurs="unbounded">
                          <xs:element name="send">
                            <xs:complexType mixed="true">
                              <xs:sequence>
                                <xs:element name="all" type="emptyType" minOccurs="0" />
                              </xs:sequence>
                              <xs:attribute name="from" type="xs:NMTOKEN" use="required" />
                              <xs:attribute name="into" type="xs:NMTOKEN" use="required" />
                            </xs:complexType>
                          </xs:element>
                          <xs:element name="order">
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element name="random" type="emptyType" />
                              </xs:sequence>
                              <xs:attribute name="group" type="xs:NMTOKEN" use="required" />
                            </xs:complexType>
                          </xs:element>
                          <xs:element name="distribute">
                            <xs:complexType mixed="true">
                              <xs:sequence>
                                <xs:element name="more" type="xs:integer" minOccurs="0" />
                              </xs:sequence>
                              <xs:attribute name="from" type="xs:NMTOKEN" use="required" />
                              <xs:attribute name="into" type="xs:NMTOKEN" use="required" />
                            </xs:complexType>
                          </xs:element>
                        </xs:choice>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="shows" minOccurs="0">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="show" type="showType" maxOccurs="unbounded" />
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="music" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>
                          music: a sound of the game's that is the state's own.
                          One that loops plays while the state is the current one;
                          one that does not plays once as the state begins.
                        </xs:documentation>
                      </xs:annotation>
                      <xs:complexType>
                        <xs:attribute name="sound" type="xs:NMTOKEN" use="required" />
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="inputs" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>needed, unless the state is from= another, whose it takes</xs:documentation>
                      </xs:annotation>
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="input" type="inputType" minOccurs="0" maxOccurs="unbounded" />
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="conditions" type="conditionsType" minOccurs="0" />
                    <xs:element name="computer" type="computerType" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation><![CDATA[
                          computer: a player the game plays itself. Every one of
                          its conditions is tested every frame, and while one
                          holds, the buttons its <hold>s name are held down.
                        ]]></xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="timers" type="stateTimersType" minOccurs="0" />
                  </xs:sequence>
                  <xs:attribute name="name" type="xs:NMTOKEN" use="required" />
                  <xs:attribute name="from" type="xs:NMTOKEN" use="optional">
                    <xs:annotation>
                      <xs:documentation><![CDATA[
                        A copy of an earlier state: its objects (an <object> or
                        <group> of one of their names changes it, as a scene changes
                        a piece it takes), shows, keys, conditions, timers and music,
                        with this one's own over them.
                      ]]></xs:documentation>
                    </xs:annotation>
                  </xs:attribute>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="sounds" minOccurs="0">
          <xs:annotation>
            <xs:documentation><![CDATA[
              The sounds: effects, and tunes of <part>s a state plays as its
              <music>. At the bottom of the file with the pictures, since they
              are long and say little about how the game plays.
            ]]></xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="sound" type="soundType" maxOccurs="unbounded" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="pictures" minOccurs="0">
          <xs:annotation>
            <xs:documentation><![CDATA[
              The pictures: each <bitmap name> a sprite takes with
              <bitmap from="name" /> (giving, if it likes, its own <scale>,
              <color>s, <flip>, style= or <row>s over the picture's), and the
              <sheet>s, picture files many pictures are cut from: a sprite's
              <cell>, an animation's <cell>s and runs of <cells>, a group's members.
              A sheet is a grid of <columns> by <rows> sharing the picture out, or
              of cells a <cell> size; <margin> round the edge and <gap> between
              cells, 0 when left out. A picture taken by <x>, <y>, <width> and
              <height> needs no grid. An SVG's <hide>s leave elements out.
            ]]></xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:choice maxOccurs="unbounded">
              <xs:element name="bitmap">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="row" type="xs:string" maxOccurs="unbounded" />
                    <xs:element name="scale" type="valueType" minOccurs="0" />
                    <xs:element name="color" type="bitmapColorType" minOccurs="0" maxOccurs="unbounded" />
                    <xs:element name="flip" type="flipType" minOccurs="0" />
                  </xs:sequence>
                  <xs:attribute name="name" type="xs:NMTOKEN" use="required" />
                  <xs:attribute name="style" type="xs:NMTOKEN" use="optional" />
                </xs:complexType>
              </xs:element>
              <xs:element name="drawing">
                <xs:annotation>
                  <xs:documentation><![CDATA[a line drawing a sprite takes with <drawing from="name" />: lines, or polygons]]></xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:choice>
                    <xs:element name="line" type="lineType" maxOccurs="unbounded" />
                    <xs:element name="polygon" type="polygonType" maxOccurs="unbounded" />
                  </xs:choice>
                  <xs:attribute name="name" type="xs:NMTOKEN" use="required" />
                </xs:complexType>
              </xs:element>
              <xs:element name="sheet">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="path" type="xs:string" />
                    <xs:choice minOccurs="0">
                      <xs:sequence>
                        <xs:element name="columns" type="xs:positiveInteger" />
                        <xs:element name="rows" type="xs:positiveInteger" />
                      </xs:sequence>
                      <xs:element name="cell">
                        <xs:complexType>
                          <xs:sequence>
                            <xs:element name="width" type="xs:decimal" />
                            <xs:element name="height" type="xs:decimal" />
                          </xs:sequence>
                        </xs:complexType>
                      </xs:element>
                    </xs:choice>
                    <xs:element name="margin" type="xs:decimal" minOccurs="0" />
                    <xs:element name="gap" type="xs:decimal" minOccurs="0" />
                    <xs:element name="hide" type="xs:string" minOccurs="0" maxOccurs="unbounded" />
                  </xs:sequence>
                  <xs:attribute name="name" type="xs:NMTOKEN" use="required" />
                </xs:complexType>
              </xs:element>
            </xs:choice>
          </xs:complexType>
        </xs:element>
        <xs:element name="demo" minOccurs="0">
          <xs:annotation>
            <xs:documentation><![CDATA[
              A recorded game for the attract mode (written by recording a game with xgecli):
              the random seed it was played with, how many frames long it is,
              then each key pressed and let go, at the frame it happened. A
              <demo /> command plays it.
            ]]></xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="seed" type="xs:unsignedInt" />
              <xs:element name="frames" type="xs:unsignedInt" />
              <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element name="press" type="demoKeyType" />
                <xs:element name="release" type="demoKeyType" />
              </xs:choice>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
