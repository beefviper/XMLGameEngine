<!-- airseabattle.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Oct 7, 2026 -->

<!--
  Air-Sea Battle, after the anti-aircraft game of the 1977 Atari 2600
  cartridge. Two players, a gun each on the shore, and four lanes of planes
  crossing the sky above them: jets, bombers, blimps and helicopters, each
  lane at its own height and speed, going round and round. A gun points one
  of three ways, left, up or right; every plane brought down is a point,
  and comes back into its lane a moment later. Whoever has more when the
  2:16 are up wins.

  Player one (yellow): A, S and D point the gun left, up and right, W
  fires. Player two (white): Left, Down and Right point, Up fires. Space,
  P or Escape pauses.

  How it is written:
  * The planes are one group, which says once what every plane does (wrap
    round at the sides, fall to either player's shells), with a group
    inside it for each lane: its picture, height, speed and planes.
  * The guns are one group with a <heading>; pointing is <set> on the
    gun's own heading (self.heading), and each player's gun is a group
    inside it with its color and the shell it fires. The shells are one
    group too, which does not exist until a gun fires: two each at most,
    and each player's has a name of its own, which says whose it is.
  * The clock is a timer of the battle taking a second off status.time.
  * At time up the two scores are compared (<above object="gun2"
    variable="score" />, <equal>), and the result screen takes the place of
    time up, its words picked to say who won, or a draw (<become
    object="result.outcome" sprite="white" />).
  Not in it: the planes falling as they are hit, and the other games on the
  cartridge (the submarines, the torpedoes, the shooting gallery).
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../xge/xgedef.xsd">
  <window name="Air-Sea Battle">
    <width>640</width>
    <height>480</height>
    <background>color.darkblue</background>
  </window>
  <variables>
    <variable name="margin">10</variable>
    <variable name="sea">420</variable>
    <variable name="shellspeed">6</variable>
  </variables>
  <sounds>
    <!-- the planes' drone, all through the battle -->
    <sound name="drone" wave="sawtooth">
      <loop />
      <volume>0.04</volume>
      <note pitch="A1">0.2</note>
      <note pitch="A#1">0.2</note>
    </sound>
    <sound name="fire" wave="square">
      <volume>0.15</volume>
      <note pitch="A5" to="A4">0.08</note>
    </sound>
    <sound name="hit" wave="noise">
      <volume>0.35</volume>
      <note pitch="2500" to="150">0.4</note>
    </sound>
    <sound name="end" wave="square">
      <volume>0.2</volume>
      <note pitch="C5">0.15</note>
      <note pitch="G4">0.15</note>
      <note pitch="C4">0.4</note>
    </sound>
  </sounds>
  <styles>
    <style name="banner"><size>100</size><color>color.yellow</color></style>
    <style name="prompt"><size>40</size><color>color.white</color></style>
    <style name="keys"><size>22</size><color>color.yellow</color></style>
    <style name="hud"><size>40</size><color>color.yellow</color></style>
  </styles>
  <kit>
    <!-- each gun's shell, made when it fires: two each in the air at most -->
    <group name="shells">
      <sprite><rectangle><width>4</width><height>4</height><color>color.yellow</color></rectangle></sprite>
      <velocity><y>-shellspeed</y></velocity>
      <most>2</most>
      <collisions>
        <collision edge="all"><despawn /></collision>
        <collision class="plane"><despawn /></collision>
      </collisions>
      <member name="shell1" />
      <member name="shell2"><sprite><rectangle><color>color.white</color></rectangle></sprite></member>
    </group>
  </kit>
  <objects>
    <!-- on every end screen -->
    <object name="timeup">
      <sprite><text style="banner"><content>TIME UP</content></text></sprite>
      <position><x><centered /></x><y><centered>window.height.center - 60</centered></y></position>
    </object>
    <object name="again">
      <sprite><text style="prompt"><content>spacebar to play again</content></text></sprite>
      <position><x><centered /></x><y><centered>window.height.center + 70</centered></y></position>
    </object>
  </objects>
  <states>
    <!-- what every end screen shows over the battle -->
    <shows name="end">
      <show object="timeup" />
      <show object="again" />
    </shows>
    <state name="title">
      <objects>
        <object name="title">
          <sprite><text style="banner"><content>AIR-SEA BATTLE</content><size>80</size></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 140</centered></y></position>
        </object>
        <object name="help">
          <sprite><text style="prompt"><content>two players, 2:16, most planes wins</content><size>26</size></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 50</centered></y></position>
        </object>
        <object name="keys1">
          <sprite><text style="keys"><content>yellow: a s d point the gun, w fires</content></text></sprite>
          <position><x><centered /></x><y><centered /></y></position>
        </object>
        <object name="keys2">
          <sprite><text style="keys"><content>white: left down right point, up fires</content><color>color.white</color></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center + 35</centered></y></position>
        </object>
        <object name="start">
          <sprite><text style="prompt"><content>spacebar to start</content><color>color.yellow</color></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center + 120</centered></y></position>
        </object>
      </objects>
      <inputs>
        <input button="space"><push state="battle" /></input>
      </inputs>
    </state>
    <state name="battle">
      <objects>
        <!-- the clock; never drawn -->
        <object name="status">
          <variables>
            <variable name="time">136</variable>
          </variables>
        </object>
        <object name="sea">
          <sprite><rectangle><width>window.right</width><height>window.bottom - sea</height><color>color.blue</color></rectangle></sprite>
          <position><x>0</x><y>sea</y></position>
        </object>
        <!-- four lanes of planes going round and round the sky: they start off the side they fly in from, and one shot down comes back from there -->
        <group name="planes" class="plane">
          <collisions>
            <collision edge="horizontal"><wrap /></collision>
            <collision object="shell1">
              <inc variable="gun1.score" />
              <play sound="hit" />
              <die />
            </collision>
            <collision object="shell2">
              <inc variable="gun2.score" />
              <play sound="hit" />
              <die />
            </collision>
          </collisions>
          <group name="jets">
            <sprite>
              <bitmap>
                <row>....**......</row>
                <row>...****.....</row>
                <row>**********..</row>
                <row>************</row>
                <row>.**********.</row>
                <row>...**.......</row>
                <scale>3</scale>
                <color>color.white</color>
              </bitmap>
            </sprite>
            <position><y>60</y></position>
            <velocity><x>2.5</x></velocity>
            <member><position><x>-60</x></position></member>
            <member><position><x>-280</x></position></member>
            <member><position><x>-500</x></position></member>
          </group>
          <group name="bombers">
            <sprite>
              <bitmap>
                <row>......**....</row>
                <row>.....****...</row>
                <row>..**********</row>
                <row>************</row>
                <row>.**********.</row>
                <row>.......**...</row>
                <scale>3</scale>
                <color>color.yellow</color>
              </bitmap>
            </sprite>
            <position><y>130</y></position>
            <velocity><x>-1.5</x></velocity>
            <member><position><x>window.right + 40</x></position></member>
            <member><position><x>window.right + 260</x></position></member>
            <member><position><x>window.right + 480</x></position></member>
          </group>
          <group name="blimps">
            <sprite>
              <bitmap>
                <row>..********..</row>
                <row>.**********.</row>
                <row>************</row>
                <row>************</row>
                <row>.**********.</row>
                <row>....****....</row>
                <scale>3</scale>
                <color>color.lightgrey</color>
              </bitmap>
            </sprite>
            <position><y>200</y></position>
            <velocity><x>1</x></velocity>
            <member><position><x>-60</x></position></member>
            <member><position><x>-300</x></position></member>
            <member><position><x>-540</x></position></member>
          </group>
          <group name="choppers">
            <sprite>
              <bitmap>
                <row>************</row>
                <row>.....**.....</row>
                <row>..*******...</row>
                <row>.*********.*</row>
                <row>..*******..*</row>
                <row>...*...*....</row>
                <scale>3</scale>
                <color>color.orange</color>
              </bitmap>
            </sprite>
            <position><y>270</y></position>
            <velocity><x>-2</x></velocity>
            <member><position><x>window.right + 40</x></position></member>
            <member><position><x>window.right + 360</x></position></member>
          </group>
        </group>
        <!-- the two guns on the shore, pointing straight up to start with -->
        <group name="guns">
          <sprite>
            <bitmap>
              <row>....*....</row>
              <row>....*....</row>
              <row>....*....</row>
              <row>....*....</row>
              <row>...***...</row>
              <row>..*****..</row>
              <row>.*******.</row>
              <row>*********</row>
              <row>*********</row>
              <scale>3</scale>
              <color>color.yellow</color>
            </bitmap>
          </sprite>
          <position><y><centered>sea</centered></y></position>
          <heading>0</heading>
          <actions>
            <action name="left"><set variable="self.heading">315</set></action>
            <action name="up"><set variable="self.heading">0</set></action>
            <action name="right"><set variable="self.heading">45</set></action>
          </actions>
          <variables>
            <variable name="score">0</variable>
          </variables>
          <group name="yellow">
            <actions>
              <action name="fire">
                <fire object="shell1" />
                <play sound="fire" />
              </action>
            </actions>
            <member name="gun1"><position><x><centered>window.width.center / 2</centered></x></position></member>
          </group>
          <group name="white">
            <sprite><bitmap><color>color.white</color></bitmap></sprite>
            <actions>
              <action name="fire">
                <fire object="shell2" />
                <play sound="fire" />
              </action>
            </actions>
            <member name="gun2"><position><x><centered>window.width.center * 3 / 2</centered></x></position></member>
          </group>
        </group>
        <object name="score1">
          <sprite><text style="hud"><number>gun1.score</number></text></sprite>
          <position><x>margin</x><y>margin</y></position>
        </object>
        <object name="clock">
          <sprite><text style="hud"><number>status.time</number><size>32</size><color>color.lightgrey</color></text></sprite>
          <position><x><centered /></x><y>margin</y></position>
        </object>
        <object name="score2">
          <sprite><text style="hud"><number>gun2.score</number><color>color.white</color></text></sprite>
          <position><x>window.right - score2.width - margin</x><y>margin</y></position>
        </object>
      </objects>
      <music sound="drone" />
      <inputs>
        <input button="a"><trigger object="gun1" action="left" /></input>
        <input button="s"><trigger object="gun1" action="up" /></input>
        <input button="d"><trigger object="gun1" action="right" /></input>
        <input button="w"><trigger object="gun1" action="fire" /></input>
        <input button="left"><trigger object="gun2" action="left" /></input>
        <input button="down"><trigger object="gun2" action="up" /></input>
        <input button="right"><trigger object="gun2" action="right" /></input>
        <input button="up"><trigger object="gun2" action="fire" /></input>
        <input button="space p escape"><push state="paused" /></input>
      </inputs>
      <conditions>
        <condition object="status" variable="time">
          <atmost>0</atmost>
          <play sound="end" />
          <push state="timeup" />
        </condition>
      </conditions>
      <timers>
        <timer><every>1</every><dec variable="status.time" /></timer>
        <timer>
          <every>1.5</every>
          <reveal object="jets" />
          <reveal object="bombers" />
          <reveal object="blimps" />
          <reveal object="choppers" />
        </timer>
      </timers>
    </state>
    <state name="paused">
      <objects>
        <object name="paused">
          <sprite><text style="banner"><content>PAUSED</content><color>color.white</color></text></sprite>
          <position><x><centered /></x><y><centered /></y></position>
        </object>
      </objects>
      <shows>
        <show state="battle" />
      </shows>
      <inputs>
        <input button="space p escape"><pop /></input>
      </inputs>
    </state>
    <!-- Time up: the scores are compared, and the state that says who won takes this one's place. -->
    <state name="timeup">
      <shows>
        <show state="battle" />
        <show set="end" />
      </shows>
      <inputs>
        <input button="space"><reset /></input>
      </inputs>
      <conditions>
        <condition object="gun1" variable="score">
          <above object="gun2" variable="score" />
          <become object="result.outcome" sprite="yellow" />
          <pop state="result" />
        </condition>
        <condition object="gun2" variable="score">
          <above object="gun1" variable="score" />
          <become object="result.outcome" sprite="white" />
          <pop state="result" />
        </condition>
        <condition object="gun1" variable="score">
          <equal object="gun2" variable="score" />
          <become object="result.outcome" sprite="draw" />
          <pop state="result" />
        </condition>
      </conditions>
    </state>
    <state name="result">
      <objects>
        <!-- who won, or a draw: under TIME UP -->
        <object name="outcome">
          <sprite name="yellow"><text><content>YELLOW WINS</content><size>50</size><color>color.yellow</color></text></sprite>
          <sprite name="white"><text><content>WHITE WINS</content><size>50</size><color>color.white</color></text></sprite>
          <sprite name="draw"><text><content>A DRAW</content><size>50</size><color>color.white</color></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center + 10</centered></y></position>
        </object>
      </objects>
      <shows>
        <show state="battle" />
        <show set="end" />
      </shows>
      <inputs>
        <input button="space"><reset /></input>
      </inputs>
    </state>
  </states>
</game>
