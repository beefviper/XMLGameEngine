<!-- breakout.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Sept 18, 2020 -->

<!--
  Breakout, after Atari's 1976 arcade game: eight rows of bricks, two each
  of red, orange, green and yellow, a square ball and a paddle. A yellow
  brick is worth 1, green 3, orange 5 and red 7. Three balls; clear the wall
  and a second one is built, clear that too and you win.

  A and D, the arrow keys, the mouse or a pad move the paddle; Space starts,
  pauses (or P) and plays again.

  How it is written:
  * The wall is a group of four groups, a colour each: the wall gives the
    columns, the gap, the size and the rule every brick has (score its own
    worth, <inc>'d by self.worth, then go), and each colour its two rows,
    its worth and its own pitch, higher the further back, as the arcade's.
  * The ball <deflect>s off the paddle and <bounce>s off a brick. It counts
    its hits, and the fourth and the twelfth make it faster, and so does the
    first brick it reaches in the back four rows (a <check> of its own y).
  * The paddle has two looks: once the ball has broken through to the top
    wall, it is half as wide (<become>).
  * A ball lost costs one of three; the next is served from the middle.
  * The score, the balls and the walls cleared are numbers on an object
    with no sprite, status, which no reset of the ball touches.
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../xge/xgedef.xsd">
  <window name="Breakout">
    <width>640</width>
    <height>720</height>
    <background>color.black</background>
    <fullscreen>false</fullscreen>
    <framerate>60</framerate>
  </window>
  <variables>
    <variable name="brick">38</variable>
    <variable name="gap">4</variable>
    <variable name="line">18</variable>
    <variable name="top">110</variable>
    <variable name="paddle">64</variable>
    <variable name="step">8</variable>
  </variables>
  <sounds>
    <sound name="wall"><note pitch="A3">0.03</note></sound>
    <sound name="paddle"><note pitch="A4">0.04</note></sound>
    <sound name="red"><note pitch="C6">0.05</note></sound>
    <sound name="orange"><note pitch="G5">0.05</note></sound>
    <sound name="green"><note pitch="C5">0.05</note></sound>
    <sound name="yellow"><note pitch="G4">0.05</note></sound>
    <sound name="lost" wave="triangle">
      <volume>0.4</volume>
      <note pitch="E4" to="E2">0.4</note>
    </sound>
  </sounds>
  <styles>
    <style name="banner"><size>100</size><color>color.orange</color></style>
    <style name="prompt"><size>36</size></style>
    <style name="help"><size>26</size><color>color.lightgrey</color></style>
    <style name="hud"><size>64</size></style>
  </styles>
  <objects>
    <object name="again">
      <sprite><text style="prompt"><content>spacebar to play again</content></text></sprite>
      <position><x><centered /></x><y><centered>window.height.center + 70</centered></y></position>
    </object>
  </objects>
  <states>
    <state name="mainmenu">
      <objects>
        <object name="title">
          <sprite><text style="banner"><content>BREAKOUT</content></text></sprite>
          <!-- x is window.width.center - title.width / 2 and y is window.height.center - title.height / 2 + (-110), written as <formula>s: one operation, its operands nested inside it -->
          <position>
            <x>
              <formula>
                <subtract>
                  <minuend>window.width.center</minuend>
                  <subtrahend><divide><dividend>title.width</dividend><divisor>2</divisor></divide></subtrahend>
                </subtract>
              </formula>
            </x>
            <y>
              <formula>
                <add>
                  <augend>
                    <subtract>
                      <minuend>window.height.center</minuend>
                      <subtrahend><divide><dividend>title.height</dividend><divisor>2</divisor></divide></subtrahend>
                    </subtract>
                  </augend>
                  <addend>-110</addend>
                </add>
              </formula>
            </y>
          </position>
        </object>
        <object name="help">
          <sprite><text style="help"><content>three balls, two walls: yellow 1, green 3, orange 5, red 7</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 10</centered></y></position>
        </object>
        <object name="keys">
          <sprite><text style="help"><content>a and d, the arrows or the mouse move the paddle</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center + 30</centered></y></position>
        </object>
        <object name="start">
          <sprite><text style="prompt"><content>spacebar to start</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center + 120</centered></y></position>
        </object>
      </objects>
      <inputs>
        <input button="space pad1.start"><push state="playing" /></input>
      </inputs>
    </state>
    <state name="playing">
      <objects>
        <object name="status">
          <variables>
            <variable name="score">0</variable>
            <variable name="balls">3</variable>
            <variable name="walls">0</variable>
          </variables>
        </object>
        <object name="score">
          <sprite><text style="hud"><number>status.score</number></text></sprite>
          <position><x>40</x><y>16</y></position>
        </object>
        <object name="balls">
          <sprite><text style="hud"><number>status.balls</number></text></sprite>
          <position><x>window.right - 40 - balls.width</x><y>16</y></position>
        </object>
        <!-- the wall: fourteen bricks across, two rows of each colour -->
        <group name="wall" class="brick">
          <columns>14</columns>
          <rows>2</rows>
          <padding><x>gap</x><y>gap</y></padding>
          <sprite><rectangle><width>brick</width><height>line - gap</height></rectangle></sprite>
          <position><x>(window.right - 14 * brick - 13 * gap) / 2</x></position>
          <collisions>
            <enabled>true</enabled>
            <collision object="ball">
              <inc variable="status.score">self.worth</inc>
              <die />
            </collision>
          </collisions>
          <group name="red">
            <sprite><rectangle><color>color.red</color></rectangle></sprite>
            <position><y>top</y></position>
            <collisions><enabled>true</enabled><collision object="ball"><play sound="red" /></collision></collisions>
            <variables><variable name="worth">7</variable></variables>
          </group>
          <group name="orange">
            <sprite><rectangle><color>color.orange</color></rectangle></sprite>
            <position><y>top + 2 * line</y></position>
            <collisions><enabled>true</enabled><collision object="ball"><play sound="orange" /></collision></collisions>
            <variables><variable name="worth">5</variable></variables>
          </group>
          <group name="green">
            <sprite><rectangle><color>color.green</color></rectangle></sprite>
            <position><y>top + 4 * line</y></position>
            <collisions><enabled>true</enabled><collision object="ball"><play sound="green" /></collision></collisions>
            <variables><variable name="worth">3</variable></variables>
          </group>
          <group name="yellow">
            <sprite><rectangle><color>color.yellow</color></rectangle></sprite>
            <position><y>top + 6 * line</y></position>
            <collisions><enabled>true</enabled><collision object="ball"><play sound="yellow" /></collision></collisions>
            <variables><variable name="worth">1</variable></variables>
          </group>
        </group>
        <object name="player">
          <sprite name="full"><rectangle><width>paddle</width><height>12</height><color>color.cyan</color></rectangle></sprite>
          <sprite name="half"><rectangle><width>paddle / 2</width><height>12</height><color>color.cyan</color></rectangle></sprite>
          <position><x><centered /></x><y>window.bottom - 60</y></position>
          <collisions>
            <enabled>true</enabled>
            <collision edge="horizontal"><stick /></collision>
          </collisions>
          <actions>
            <action name="left"><move direction="left">step</move></action>
            <action name="right"><move direction="right">step</move></action>
            <action name="steer"><track /></action>
          </actions>
        </object>
        <!-- served from under the wall, down towards the paddle -->
        <object name="ball">
          <sprite><rectangle><width>10</width><height>10</height></rectangle></sprite>
          <position><x><centered /></x><y><centered /></y></position>
          <velocity><x><random min="-3" max="3" /></x><y>4</y></velocity>
          <collisions>
            <enabled>true</enabled>
            <collision edge="horizontal">
              <bounce />
              <play sound="wall" />
            </collision>
            <collision edge="top">
              <bounce />
              <play sound="wall" />
              <become object="player" sprite="half" />
            </collision>
            <collision edge="bottom">
              <dec variable="status.balls" />
              <play sound="lost" />
              <reset object="ball" />
            </collision>
            <collision object="player">
              <deflect>60</deflect>
              <inc variable="ball.hits" />
              <play sound="paddle" />
            </collision>
            <collision object="player">
              <any>
                <check variable="hits"><equal>4</equal></check>
                <check variable="hits"><equal>12</equal></check>
              </any>
              <trigger action="faster" />
            </collision>
            <collision class="brick"><bounce /></collision>
            <collision class="brick">
              <all>
                <check variable="y"><below>top + 4 * line</below></check>
                <check variable="deep"><equal>0</equal></check>
              </all>
              <inc variable="ball.deep" />
              <trigger action="faster" />
            </collision>
          </collisions>
          <actions>
            <action name="faster">
              <set variable="ball.velocity.x">ball.velocity.x * 1.25</set>
              <set variable="ball.velocity.y">ball.velocity.y * 1.25</set>
            </action>
          </actions>
          <variables>
            <variable name="hits">0</variable>
            <variable name="deep">0</variable>
          </variables>
        </object>
      </objects>
      <inputs>
        <input button="a left pad1.left"><trigger object="player" action="left" /></input>
        <input button="d right pad1.right"><trigger object="player" action="right" /></input>
        <input axis="mouse.x"><trigger object="player" action="steer" /></input>
        <input button="space p pad1.start"><push state="paused" /></input>
      </inputs>
      <conditions>
        <condition>
          <all>
            <check object="wall"><remaining>0</remaining></check>
            <check object="status" variable="walls"><atleast>1</atleast></check>
          </all>
          <push state="youwin" />
        </condition>
        <!-- the first wall cleared: a second, and a new ball -->
        <condition object="wall">
          <remaining>0</remaining>
          <inc variable="status.walls" />
          <reset object="wall" />
          <reset object="ball" />
        </condition>
        <condition object="status" variable="balls">
          <atmost>0</atmost>
          <push state="gameover" />
        </condition>
      </conditions>
    </state>
    <state name="paused">
      <objects>
        <object name="paused">
          <sprite><text style="banner"><content>PAUSED</content><color>color.white</color></text></sprite>
          <position><x><centered /></x><y><centered /></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input button="space p pad1.start"><pop /></input>
      </inputs>
    </state>
    <state name="youwin">
      <objects>
        <object name="message">
          <sprite><text style="banner"><content>YOU WIN</content><color>color.green</color></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 60</centered></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
        <show object="again" />
      </shows>
      <inputs>
        <input button="space pad1.start"><reset /></input>
      </inputs>
    </state>
    <state name="gameover" from="youwin">
      <objects>
        <object name="message">
          <sprite><text style="banner"><content>GAME OVER</content><color>color.red</color></text></sprite>
        </object>
      </objects>
    </state>
  </states>
</game>
