<!-- breakout.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Sept 18, 2020 -->

<!--
  Breakout, after Atari's 1976 arcade game: eight rows of bricks, two each
  of red, orange, green and yellow, a square ball and a paddle. A yellow
  brick is worth 1, green 3, orange 5 and red 7. Three balls; clear the wall
  and a second one is built, clear that too and you win.

  A and D, the arrow keys, the mouse or a pad move the paddle; Space starts
  and plays again, Pause pauses.

  How it is written:
  * The wall is a group of four groups, a colour each: the wall gives the
    columns, the gap, the size and the rule every brick has (score its own
    worth, <inc>'d by self.worth, then go), and each colour its two rows,
    its worth and its own pitch, higher the further back, as the arcade's.
  * The ball <deflect>s off the paddle and <bounce>s off a brick. It counts
    its hits, and the fourth and the twelfth make it faster, and so does the
    first brick it reaches in the back four rows (a <condition> of its own y).
  * The paddle has two looks: once the ball has broken through to the top
    wall, it is half as wide (<become>).
  * A ball lost costs one of three; the next is served from the middle.
  * The score, the balls and the walls cleared are numbers on an object
    with no sprite, status, which no reset of the ball touches.
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../xgedef.xsd">
  <window name="Breakout">
    <width>640</width>
    <height>720</height>
  </window>
  <variables>
    <variable name="brick">38</variable>
    <variable name="gap">4</variable>
    <variable name="line">18</variable>
    <variable name="top">110</variable>
    <variable name="paddle">64</variable>
    <variable name="step">8</variable>
  </variables>
  <styles>
    <style name="banner"><size>100</size><color>color.orange</color></style>
    <style name="prompt"><size>36</size></style>
    <style name="help"><size>26</size><color>color.lightgrey</color></style>
    <style name="hud"><size>64</size></style>
  </styles>
  <states>
    <objects>
      <object name="again">
        <sprite><text style="prompt"><content>spacebar to play again</content></text></sprite>
        <position><x><centered /></x><y><centered><offset>70</offset></centered></y></position>
      </object>
    </objects>
    <state name="title">
      <objects>
        <object name="title">
          <sprite><text style="banner"><content>BREAKOUT</content></text></sprite>
          <position><x><centered /></x><y><centered><offset>-110</offset></centered></y></position>
        </object>
        <group name="help">
          <rows>2</rows>
          <padding><y>40</y></padding>
          <sprite><text style="help" /></sprite>
          <position><x><centered /></x><y><centered><offset>-10</offset></centered></y></position>
          <row number="1"><sprite><text><content>three balls, two walls: yellow 1, green 3, orange 5, red 7</content></text></sprite></row>
          <row number="2"><sprite><text><content>a and d, the arrows or the mouse move the paddle</content></text></sprite></row>
        </group>
        <object name="start">
          <sprite><text style="prompt"><content>spacebar to start</content></text></sprite>
          <position><x><centered /></x><y><centered><offset>120</offset></centered></y></position>
        </object>
      </objects>
      <inputs>
        <input><button>space</button><button>pad1.start</button><push state="playing" /></input>
      </inputs>
    </state>
    <state name="playing">
      <objects>
        <object name="status">
          <variables>
            <variable name="score">0</variable>
            <variable name="balls">3</variable>
            <variable name="walls">0</variable>
          </variables>
        </object>
        <object name="score">
          <sprite><text style="hud"><number>status.score</number></text></sprite>
          <position><x>40</x><y>16</y></position>
        </object>
        <object name="balls">
          <sprite><text style="hud"><number>status.balls</number></text></sprite>
          <position><x><right><offset>40</offset></right></x><y>16</y></position>
        </object>
        <!-- the wall: fourteen bricks across, two rows of each colour -->
        <group name="wall" class="brick">
          <columns>14</columns>
          <rows>2</rows>
          <padding><x>gap</x><y>gap</y></padding>
          <sprite><rectangle><width>brick</width><height><subtract><value>line</value><value>gap</value></subtract></height></rectangle></sprite>
          <position><x>
            <divide>
              <value>
                <subtract>
                  <value>window.right</value>
                  <value><multiply><value>14</value><value>brick</value></multiply></value>
                  <value><multiply><value>13</value><value>gap</value></multiply></value>
                </subtract>
              </value>
              <value>2</value>
            </divide>
          </x></position>
          <collisions>
            <collision object="ball">
              <inc variable="status.score">self.worth</inc>
              <die />
            </collision>
          </collisions>
          <group name="red">
            <sprite><rectangle><color>color.red</color></rectangle></sprite>
            <position><y>top</y></position>
            <collisions><collision object="ball"><play sound="red" /></collision></collisions>
            <variables><variable name="worth">7</variable></variables>
          </group>
          <group name="orange">
            <sprite><rectangle><color>color.orange</color></rectangle></sprite>
            <position><y><add><value>top</value><value><multiply><value>2</value><value>line</value></multiply></value></add></y></position>
            <collisions><collision object="ball"><play sound="orange" /></collision></collisions>
            <variables><variable name="worth">5</variable></variables>
          </group>
          <group name="green">
            <sprite><rectangle><color>color.green</color></rectangle></sprite>
            <position><y><add><value>top</value><value><multiply><value>4</value><value>line</value></multiply></value></add></y></position>
            <collisions><collision object="ball"><play sound="green" /></collision></collisions>
            <variables><variable name="worth">3</variable></variables>
          </group>
          <group name="yellow">
            <sprite><rectangle><color>color.yellow</color></rectangle></sprite>
            <position><y><add><value>top</value><value><multiply><value>6</value><value>line</value></multiply></value></add></y></position>
            <collisions><collision object="ball"><play sound="yellow" /></collision></collisions>
            <variables><variable name="worth">1</variable></variables>
          </group>
        </group>
        <object name="player">
          <sprite name="full"><rectangle><width>paddle</width><height>12</height><color>color.cyan</color></rectangle></sprite>
          <sprite name="half"><rectangle><width><divide><value>paddle</value><value>2</value></divide></width><height>12</height><color>color.cyan</color></rectangle></sprite>
          <position><x><centered /></x><y><subtract><value>window.bottom</value><value>60</value></subtract></y></position>
          <collisions>
            <collision edge="horizontal"><stick /></collision>
          </collisions>
          <actions>
            <action name="left"><move direction="left">step</move></action>
            <action name="right"><move direction="right">step</move></action>
            <action name="steer"><track /></action>
          </actions>
        </object>
        <!-- served from under the wall, down towards the paddle -->
        <object name="ball">
          <sprite><rectangle><width>10</width><height>10</height></rectangle></sprite>
          <position><x><centered /></x><y><centered /></y></position>
          <velocity><x><random><min>-3</min><max>3</max></random></x><y>4</y></velocity>
          <collisions>
            <collision edge="horizontal">
              <bounce />
              <play sound="wall" />
            </collision>
            <collision edge="top">
              <bounce />
              <play sound="wall" />
              <become object="player" sprite="half" />
            </collision>
            <collision edge="bottom">
              <dec variable="status.balls" />
              <play sound="lost" />
              <reset object="ball" />
            </collision>
            <collision object="player">
              <deflect>60</deflect>
              <inc variable="ball.hits" />
              <play sound="paddle" />
            </collision>
            <collision object="player">
              <any>
                <condition variable="hits"><equal>4</equal></condition>
                <condition variable="hits"><equal>12</equal></condition>
              </any>
              <trigger action="faster" />
            </collision>
            <collision class="brick"><bounce /></collision>
            <collision class="brick">
              <condition variable="y"><below>
                <add>
                  <value>top</value>
                  <value><multiply><value>4</value><value>line</value></multiply></value>
                </add>
              </below></condition>
              <condition variable="deep"><equal>0</equal></condition>
              <inc variable="ball.deep" />
              <trigger action="faster" />
            </collision>
          </collisions>
          <actions>
            <action name="faster">
              <set variable="ball.velocity.x"><multiply><value>ball.velocity.x</value><value>1.25</value></multiply></set>
              <set variable="ball.velocity.y"><multiply><value>ball.velocity.y</value><value>1.25</value></multiply></set>
            </action>
          </actions>
          <variables>
            <variable name="hits">0</variable>
            <variable name="deep">0</variable>
          </variables>
        </object>
      </objects>
      <inputs>
        <input><button>a</button><button>left</button><button>pad1.left</button><trigger object="player" action="left" /></input>
        <input><button>d</button><button>right</button><button>pad1.right</button><trigger object="player" action="right" /></input>
        <input axis="mouse.x"><trigger object="player" action="steer" /></input>
        <input><button>pause</button><button>pad1.start</button><push state="paused" /></input>
      </inputs>
      <conditions>
        <condition object="wall"><remaining>0</remaining>
          <condition object="status" variable="walls"><atleast>1</atleast>
            <become object="over.message" sprite="won" />
            <push state="over" />
          </condition>
        </condition>
        <!-- the first wall cleared: a second, and a new ball -->
        <condition object="wall">
          <remaining>0</remaining>
          <inc variable="status.walls" />
          <reset object="wall" />
          <reset object="ball" />
        </condition>
        <condition object="status" variable="balls">
          <atmost>0</atmost>
          <become object="over.message" sprite="lost" />
          <push state="over" />
        </condition>
      </conditions>
    </state>
    <state name="paused">
      <objects>
        <object name="paused">
          <sprite><text style="banner"><content>PAUSED</content><color>color.white</color></text></sprite>
          <position><x><centered /></x><y><centered /></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input><button>pause</button><button>pad1.start</button><pop /></input>
      </inputs>
    </state>
    <state name="over">
      <objects>
        <object name="message">
          <sprite name="won"><text style="banner"><content>YOU WIN</content><color>color.green</color></text></sprite>
          <sprite name="lost"><text style="banner"><content>GAME OVER</content><color>color.red</color></text></sprite>
          <position><x><centered /></x><y><centered><offset>-60</offset></centered></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
        <show object="again" />
      </shows>
      <inputs>
        <input><button>space</button><button>pad1.start</button><reset /></input>
      </inputs>
    </state>
  </states>
  <sounds>
    <sound name="wall"><note pitch="A3">0.03</note></sound>
    <sound name="paddle"><note pitch="A4">0.04</note></sound>
    <sound name="red"><note pitch="C6">0.05</note></sound>
    <sound name="orange"><note pitch="G5">0.05</note></sound>
    <sound name="green"><note pitch="C5">0.05</note></sound>
    <sound name="yellow"><note pitch="G4">0.05</note></sound>
    <sound name="lost" wave="triangle">
      <volume>0.4</volume>
      <note pitch="E4" to="E2">0.4</note>
    </sound>
  </sounds>
</game>
