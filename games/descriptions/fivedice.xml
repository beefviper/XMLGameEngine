<!-- fivedice.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Nov 22, 2026 -->

<!--
  Five Dice: dice poker on a score card of thirteen boxes, one game alone.

  Each turn roll the five dice up to three times, keeping any between rolls,
  then write the roll into one empty box. The upper boxes score the dice
  showing their number (three 4s in fours: 12); 63 or more there earns 35
  more. Three or four alike and chance score all five dice; a full house
  25, a small run of four 30, a large run of five 40, five alike 50. A roll
  that does not make a box scores 0 there. Thirteen turns fill the card.

  Space rolls, 1 to 5 keep or free a die, W and S (or the arrows) choose a
  box, E writes the roll in it. Pause pauses.

  How it is written:
  * The dice are a group of five cells of class die, held by the cup; a
    die's `worth` is its number. A die rolls by <set>ting its worth from a
    <random>, then shows the look of that number.
  * Each lower box's test is a holder of its own that holds nothing and
    is <score>d with the cup's five dice by a <patterns> set of one
    pattern, so its live `pattern` is 1 when the dice make it. The cup
    <counts> its dice's worth: the sum.
  * A box's offer is a live number: the upper ones count the dice showing
    their row, the lower ones their judge's pattern times what it pays.
  * Kept dice wear the gold `kept` style.
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../xgedef.xsd">
  <window name="Five Dice">
    <width>900</width>
    <height>900</height>
    <background>color.darkgreen</background>
  </window>
  <variables>
    <variable name="cupy">110</variable>
    <variable name="cardy">290</variable>
    <variable name="labelx">300</variable>
    <variable name="pointx">560</variable>
    <variable name="rowstep">40</variable>
  </variables>
  <styles>
    <style name="banner"><size>80</size><color>color.yellow</color></style>
    <style name="heading"><size>48</size><color>color.yellow</color></style>
    <style name="prompt"><size>32</size></style>
    <style name="help"><size>22</size><color>color.lightgrey</color></style>
    <style name="note"><size>26</size><color>color.white</color></style>
    <style name="box"><size>26</size><color>color.lightgrey</color></style>
    <style name="points"><size>26</size><color>color.white</color></style>
    <style name="die"><scale>5</scale><color char="w">color.white</color><color char="k">color.black</color></style>
    <style name="free"><color char="w">color.white</color></style>
    <style name="kept"><color char="w">color.gold</color></style>
  </styles>
  <!-- what the lower boxes ask of the dice, a set of one pattern for each -->
  <patterns name="three"><pattern name="three"><alike variable="worth">3</alike></pattern></patterns>
  <patterns name="four"><pattern name="four"><alike variable="worth">4</alike></pattern></patterns>
  <patterns name="house"><pattern name="house"><alike variable="worth">3</alike><alike variable="worth">2</alike></pattern></patterns>
  <patterns name="small"><pattern name="small"><run variable="worth">4</run></pattern></patterns>
  <patterns name="large"><pattern name="large"><run variable="worth">5</run></pattern></patterns>
  <patterns name="five"><pattern name="five"><alike variable="worth">5</alike></pattern></patterns>
  <states>
    <state name="title">
      <objects>
        <object name="title">
          <sprite><text style="banner"><content>FIVE DICE</content></text></sprite>
          <position><x><centered /></x><y><centered><offset>-170</offset></centered></y></position>
        </object>
        <group name="help">
          <rows>3</rows>
          <padding><y>30</y></padding>
          <sprite><text style="help" /></sprite>
          <position><x><centered /></x><y><centered><offset>-90</offset></centered></y></position>
          <row number="1"><sprite><text><content>roll five dice up to three times a turn, keeping any you like,</content></text></sprite></row>
          <row number="2"><sprite><text><content>then write the roll in one of thirteen boxes. fill the card for the most points</content></text></sprite></row>
          <row number="3"><sprite><text><content>spacebar rolls, 1 to 5 keep a die, w s choose a box, e writes it</content></text></sprite><padding><y>40</y></padding></row>
        </group>
        <object name="start">
          <sprite><text style="prompt"><content>spacebar to start</content></text></sprite>
          <position><x><centered /></x><y><centered><offset>170</offset></centered></y></position>
        </object>
      </objects>
      <inputs>
        <input><button>space</button><button>pad1.start</button><push state="playing" /></input>
      </inputs>
    </state>
    <state name="playing">
      <objects>
        <!-- the five dice: a die is worth its number, and shows it -->
        <group name="dice" class="die">
          <columns>5</columns>
          <sprite name="one"><bitmap from="one" /></sprite>
          <sprite name="two"><bitmap from="two" /></sprite>
          <sprite name="three"><bitmap from="three" /></sprite>
          <sprite name="four"><bitmap from="four" /></sprite>
          <sprite name="five"><bitmap from="five" /></sprite>
          <sprite name="six"><bitmap from="six" /></sprite>
          <position><x>0</x><y>0</y></position>
          <actions>
            <action name="roll">
              <condition variable="kept"><equal>0</equal>
                <set variable="self.worth"><smallest><value><floor><value><random><min>1</min><max>7</max></random></value></floor></value><value>6</value></smallest></set>
              </condition>
              <trigger action="show" />
            </action>
            <action name="keep">
              <condition object="card" variable="rolls"><atleast>1</atleast>
                <set variable="self.kept"><subtract><value>1</value><value>self.kept</value></subtract></set>
                <play sound="keep" />
              </condition>
              <trigger action="show" />
            </action>
            <action name="show">
              <condition variable="worth"><equal>1</equal><become sprite="one" /></condition>
              <condition variable="worth"><equal>2</equal><become sprite="two" /></condition>
              <condition variable="worth"><equal>3</equal><become sprite="three" /></condition>
              <condition variable="worth"><equal>4</equal><become sprite="four" /></condition>
              <condition variable="worth"><equal>5</equal><become sprite="five" /></condition>
              <condition variable="worth"><equal>6</equal><become sprite="six" /></condition>
              <condition variable="kept"><equal>1</equal><become style="kept" /></condition>
              <condition variable="kept"><equal>0</equal><become style="free" /></condition>
            </action>
          </actions>
          <variables><variable name="kept">0</variable></variables>
        </group>

        <!-- the cup: the dice in a row, their sum its worth -->
        <object name="cup" class="place">
          <sprite name="spot" />
          <position><x>190</x><y>cupy</y></position>
          <holds class="die">
            <spread><x>110</x></spread>
            <counts variable="worth" />
            <order><by variable="column" /></order>
          </holds>
        </object>

        <!-- the lower boxes' tests, each scored with the cup's dice -->
        <object name="three" class="judge">
          <sprite name="spot" />
          <position><x>0</x><y>0</y></position>
          <holds class="die"><score patterns="three"><with object="cup"><full>5</full></with><best>5</best></score></holds>
        </object>
        <object name="four" class="judge">
          <sprite name="spot" />
          <position><x>0</x><y>0</y></position>
          <holds class="die"><score patterns="four"><with object="cup"><full>5</full></with><best>5</best></score></holds>
        </object>
        <object name="house" class="judge">
          <sprite name="spot" />
          <position><x>0</x><y>0</y></position>
          <holds class="die"><score patterns="house"><with object="cup"><full>5</full></with><best>5</best></score></holds>
        </object>
        <object name="small" class="judge">
          <sprite name="spot" />
          <position><x>0</x><y>0</y></position>
          <holds class="die"><score patterns="small"><with object="cup"><full>5</full></with><best>5</best></score></holds>
        </object>
        <object name="large" class="judge">
          <sprite name="spot" />
          <position><x>0</x><y>0</y></position>
          <holds class="die"><score patterns="large"><with object="cup"><full>5</full></with><best>5</best></score></holds>
        </object>
        <object name="five" class="judge">
          <sprite name="spot" />
          <position><x>0</x><y>0</y></position>
          <holds class="die"><score patterns="five"><with object="cup"><full>5</full></with><best>5</best></score></holds>
        </object>

        <!-- the card: the turn, the rolls this turn, the box chosen, and the totals -->
        <object name="card">
          <sprite name="roll"><text style="note"><content>spacebar rolls</content></text></sprite>
          <position><x><centered /></x><y><add><value>cupy</value><value>110</value></add></y></position>
          <actions>
            <action name="roll">
              <condition variable="rolls"><below>3</below>
                <trigger object="dice" action="roll" />
                <inc variable="card.rolls" />
                <play sound="roll" />
              </condition>
            </action>
            <action name="up">
              <dec variable="card.at" />
              <condition variable="at"><below>1</below><set variable="card.at">13</set></condition>
              <play sound="tick" />
            </action>
            <action name="down">
              <inc variable="card.at" />
              <condition variable="at"><above>13</above><set variable="card.at">1</set></condition>
              <play sound="tick" />
            </action>
            <!-- a box written: the next turn, every die free -->
            <action name="next">
              <inc variable="card.turn" />
              <set variable="card.rolls">0</set>
              <set variable="dice.kept">0</set>
              <trigger object="dice" action="show" />
              <play sound="write" />
            </action>
          </actions>
          <variables>
            <variable name="turn">1</variable>
            <variable name="rolls">0</variable>
            <variable name="at">1</variable>
            <variable name="upper" update="live">
              <add>
                <value>boxes.1.score</value>
                <value>boxes.2.score</value>
                <value>boxes.3.score</value>
                <value>boxes.4.score</value>
                <value>boxes.5.score</value>
                <value>boxes.6.score</value>
              </add>
            </variable>
            <variable name="bonus" update="live"><multiply><value>35</value><value><compare><value>card.upper</value><atleast>63</atleast></compare></value></multiply></variable>
            <variable name="total" update="live">
              <add>
                <value>card.upper</value>
                <value>card.bonus</value>
                <value>boxes.7.score</value>
                <value>boxes.8.score</value>
                <value>boxes.9.score</value>
                <value>boxes.10.score</value>
                <value>boxes.11.score</value>
                <value>boxes.12.score</value>
                <value>boxes.13.score</value>
              </add>
            </variable>
          </variables>
        </object>
        <object name="rolls">
          <sprite><text style="note"><content>turn </content><number>card.turn</number><content> of 13     rolls </content><number>card.rolls</number><content> of 3</content></text></sprite>
          <position><x><centered /></x><y><add><value>cupy</value><value>140</value></add></y></position>
        </object>

        <!-- the thirteen boxes: a name, and what the dice would score there, or what was written -->
        <group name="labels" class="label">
          <rows>13</rows>
          <padding><y>rowstep</y></padding>
          <sprite name="open"><text style="box" /></sprite>
          <sprite name="filled"><text style="box" /></sprite>
          <position><x>labelx</x><y>cardy</y></position>
          <actions>
            <action name="mark"><condition variable="row"><equal>card.at</equal><become sprite="filled" /></condition></action>
          </actions>
          <row number="1"><sprite name="open"><text><content>ones</content></text></sprite><sprite name="filled"><text><content>ones</content><color>color.white</color></text></sprite></row>
          <row number="2"><sprite name="open"><text><content>twos</content></text></sprite><sprite name="filled"><text><content>twos</content><color>color.white</color></text></sprite></row>
          <row number="3"><sprite name="open"><text><content>threes</content></text></sprite><sprite name="filled"><text><content>threes</content><color>color.white</color></text></sprite></row>
          <row number="4"><sprite name="open"><text><content>fours</content></text></sprite><sprite name="filled"><text><content>fours</content><color>color.white</color></text></sprite></row>
          <row number="5"><sprite name="open"><text><content>fives</content></text></sprite><sprite name="filled"><text><content>fives</content><color>color.white</color></text></sprite></row>
          <row number="6"><sprite name="open"><text><content>sixes</content></text></sprite><sprite name="filled"><text><content>sixes</content><color>color.white</color></text></sprite></row>
          <row number="7"><sprite name="open"><text><content>three alike</content></text></sprite><sprite name="filled"><text><content>three alike</content><color>color.white</color></text></sprite><padding><y><add><value>rowstep</value><value>24</value></add></y></padding></row>
          <row number="8"><sprite name="open"><text><content>four alike</content></text></sprite><sprite name="filled"><text><content>four alike</content><color>color.white</color></text></sprite></row>
          <row number="9"><sprite name="open"><text><content>full house</content></text></sprite><sprite name="filled"><text><content>full house</content><color>color.white</color></text></sprite></row>
          <row number="10"><sprite name="open"><text><content>small run</content></text></sprite><sprite name="filled"><text><content>small run</content><color>color.white</color></text></sprite></row>
          <row number="11"><sprite name="open"><text><content>large run</content></text></sprite><sprite name="filled"><text><content>large run</content><color>color.white</color></text></sprite></row>
          <row number="12"><sprite name="open"><text><content>five alike</content></text></sprite><sprite name="filled"><text><content>five alike</content><color>color.white</color></text></sprite></row>
          <row number="13"><sprite name="open"><text><content>chance</content></text></sprite><sprite name="filled"><text><content>chance</content><color>color.white</color></text></sprite></row>
        </group>
        <group name="boxes" class="box">
          <rows>13</rows>
          <padding><y>rowstep</y></padding>
          <sprite><text style="points"><number>boxes.shown</number></text></sprite>
          <position><x>pointx</x><y>cardy</y></position>
          <actions>
            <action name="write">
              <condition variable="writable"><equal>1</equal>
                <copy variable="self.offer" into="self.score" />
                <set variable="self.filled">1</set>
                <trigger object="labels" action="mark" />
                <trigger object="card" action="next" />
              </condition>
            </action>
          </actions>
          <variables>
            <variable name="filled">0</variable>
            <variable name="score">0</variable>
            <variable name="offer" update="live">
              <multiply>
                <value>self.row</value>
                <value>
                  <add>
                    <value><compare><value>dice.1.worth</value><equal>self.row</equal></compare></value>
                    <value><compare><value>dice.2.worth</value><equal>self.row</equal></compare></value>
                    <value><compare><value>dice.3.worth</value><equal>self.row</equal></compare></value>
                    <value><compare><value>dice.4.worth</value><equal>self.row</equal></compare></value>
                    <value><compare><value>dice.5.worth</value><equal>self.row</equal></compare></value>
                  </add>
                </value>
              </multiply>
            </variable>
            <!-- what was written, else what the roll would score, nothing before the first roll -->
            <variable name="shown" update="live">
              <add>
                <value><multiply><value>self.filled</value><value>self.score</value></multiply></value>
                <value>
                  <multiply>
                    <value><subtract><value>1</value><value>self.filled</value></subtract></value>
                    <value><compare><value>card.rolls</value><atleast>1</atleast></compare></value>
                    <value>self.offer</value>
                  </multiply>
                </value>
              </add>
            </variable>
            <variable name="writable" update="live">
              <multiply>
                <value><compare><value>self.row</value><equal>card.at</equal></compare></value>
                <value><compare><value>self.filled</value><equal>0</equal></compare></value>
                <value><compare><value>card.rolls</value><atleast>1</atleast></compare></value>
              </multiply>
            </variable>
          </variables>
          <row number="7"><padding><y><add><value>rowstep</value><value>24</value></add></y></padding><variables><variable name="offer" update="live"><multiply><value>three.pattern</value><value>cup.worth</value></multiply></variable></variables></row>
          <row number="8"><variables><variable name="offer" update="live"><multiply><value>four.pattern</value><value>cup.worth</value></multiply></variable></variables></row>
          <row number="9"><variables><variable name="offer" update="live"><multiply><value>house.pattern</value><value>25</value></multiply></variable></variables></row>
          <row number="10"><variables><variable name="offer" update="live"><multiply><value>small.pattern</value><value>30</value></multiply></variable></variables></row>
          <row number="11"><variables><variable name="offer" update="live"><multiply><value>large.pattern</value><value>40</value></multiply></variable></variables></row>
          <row number="12"><variables><variable name="offer" update="live"><multiply><value>five.pattern</value><value>50</value></multiply></variable></variables></row>
          <row number="13"><variables><variable name="offer" update="live">cup.worth</variable></variables></row>
        </group>

        <!-- the box chosen -->
        <object name="pointer">
          <sprite><text style="points"><content>&gt;</content><color>color.yellow</color></text></sprite>
          <position>
            <x><subtract><value>labelx</value><value>40</value></subtract></x>
            <y update="live">
              <add>
                <value>cardy</value>
                <value><multiply><value><subtract><value>card.at</value><value>1</value></subtract></value><value>rowstep</value></multiply></value>
                <value><multiply><value>24</value><value><compare><value>card.at</value><atleast>7</atleast></compare></value></multiply></value>
              </add>
            </y>
          </position>
        </object>

        <object name="totals">
          <sprite><text style="note"><content>upper </content><number>card.upper</number><content>   bonus </content><number>card.bonus</number><content>   total </content><number>card.total</number></text></sprite>
          <position><x><centered /></x><y><subtract><value>window.height</value><value>50</value></subtract></y></position>
        </object>
      </objects>
      <starts>
        <send from="dice" into="cup"><all /></send>
      </starts>
      <inputs>
        <input><button>space</button><button>pad1.a</button><trigger object="card" action="roll" /></input>
        <input><button>num1</button><trigger object="dice.1" action="keep" /></input>
        <input><button>num2</button><trigger object="dice.2" action="keep" /></input>
        <input><button>num3</button><trigger object="dice.3" action="keep" /></input>
        <input><button>num4</button><trigger object="dice.4" action="keep" /></input>
        <input><button>num5</button><trigger object="dice.5" action="keep" /></input>
        <input><button>w</button><button>up</button><button>pad1.up</button><trigger object="card" action="up" /></input>
        <input><button>s</button><button>down</button><button>pad1.down</button><trigger object="card" action="down" /></input>
        <input><button>e</button><button>pad1.b</button><trigger object="boxes" action="write" /></input>
        <input><button>pause</button><button>pad1.start</button><push state="paused" /></input>
      </inputs>
      <conditions>
        <condition object="card" variable="turn"><above>13</above><push state="over" /></condition>
      </conditions>
    </state>
    <state name="over">
      <objects>
        <object name="over">
          <sprite><text style="heading"><content>card full: </content><number>card.total</number></text></sprite>
          <position><x><centered /></x><y><add><value>cupy</value><value>110</value></add></y></position>
        </object>
        <object name="again">
          <sprite><text style="note"><content>spacebar to play again</content></text></sprite>
          <position><x><centered /></x><y><add><value>cupy</value><value>160</value></add></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input><button>space</button><button>pad1.start</button><reset /></input>
      </inputs>
    </state>
    <state name="paused">
      <objects>
        <object name="paused">
          <sprite><text style="banner"><content>PAUSED</content><color>color.white</color></text></sprite>
          <position><x><centered /></x><y><centered /></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input><button>pause</button><button>pad1.start</button><pop /></input>
      </inputs>
    </state>
  </states>
  <sounds>
    <sound name="roll" wave="noise"><note pitch="G5">0.03</note><note pitch="C6">0.03</note><note pitch="G5">0.03</note></sound>
    <sound name="keep"><note pitch="E6">0.04</note></sound>
    <sound name="tick"><note pitch="C6">0.02</note></sound>
    <sound name="write">
      <note pitch="C5">0.08</note>
      <note pitch="G5">0.12</note>
    </sound>
  </sounds>
  <!-- the faces of a die: w its face, k its spots -->
  <pictures>
    <bitmap name="one" style="die">
      <row>.wwwwwwwwwwwwww.</row>
      <row>wwwwwwwwwwwwwwww</row>
      <row>wwwwwwwwwwwwwwww</row>
      <row>wwwwwwwwwwwwwwww</row>
      <row>wwwwwwwwwwwwwwww</row>
      <row>wwwwwwwwwwwwwwww</row>
      <row>wwwwwwwwwwwwwwww</row>
      <row>wwwwwwwkkwwwwwww</row>
      <row>wwwwwwwkkwwwwwww</row>
      <row>wwwwwwwwwwwwwwww</row>
      <row>wwwwwwwwwwwwwwww</row>
      <row>wwwwwwwwwwwwwwww</row>
      <row>wwwwwwwwwwwwwwww</row>
      <row>wwwwwwwwwwwwwwww</row>
      <row>wwwwwwwwwwwwwwww</row>
      <row>.wwwwwwwwwwwwww.</row>
    </bitmap>
    <bitmap name="two" style="die">
      <row>.wwwwwwwwwwwwww.</row>
      <row>wwwwwwwwwwwwwwww</row>
      <row>wwwwwwwwwwwwwwww</row>
      <row>wwwkkwwwwwwwwwww</row>
      <row>wwwkkwwwwwwwwwww</row>
      <row>wwwwwwwwwwwwwwww</row>
      <row>wwwwwwwwwwwwwwww</row>
      <row>wwwwwwwwwwwwwwww</row>
      <row>wwwwwwwwwwwwwwww</row>
      <row>wwwwwwwwwwwwwwww</row>
      <row>wwwwwwwwwwwwwwww</row>
      <row>wwwwwwwwwwwkkwww</row>
      <row>wwwwwwwwwwwkkwww</row>
      <row>wwwwwwwwwwwwwwww</row>
      <row>wwwwwwwwwwwwwwww</row>
      <row>.wwwwwwwwwwwwww.</row>
    </bitmap>
    <bitmap name="three" style="die">
      <row>.wwwwwwwwwwwwww.</row>
      <row>wwwwwwwwwwwwwwww</row>
      <row>wwwwwwwwwwwwwwww</row>
      <row>wwwkkwwwwwwwwwww</row>
      <row>wwwkkwwwwwwwwwww</row>
      <row>wwwwwwwwwwwwwwww</row>
      <row>wwwwwwwwwwwwwwww</row>
      <row>wwwwwwwkkwwwwwww</row>
      <row>wwwwwwwkkwwwwwww</row>
      <row>wwwwwwwwwwwwwwww</row>
      <row>wwwwwwwwwwwwwwww</row>
      <row>wwwwwwwwwwwkkwww</row>
      <row>wwwwwwwwwwwkkwww</row>
      <row>wwwwwwwwwwwwwwww</row>
      <row>wwwwwwwwwwwwwwww</row>
      <row>.wwwwwwwwwwwwww.</row>
    </bitmap>
    <bitmap name="four" style="die">
      <row>.wwwwwwwwwwwwww.</row>
      <row>wwwwwwwwwwwwwwww</row>
      <row>wwwwwwwwwwwwwwww</row>
      <row>wwwkkwwwwwwkkwww</row>
      <row>wwwkkwwwwwwkkwww</row>
      <row>wwwwwwwwwwwwwwww</row>
      <row>wwwwwwwwwwwwwwww</row>
      <row>wwwwwwwwwwwwwwww</row>
      <row>wwwwwwwwwwwwwwww</row>
