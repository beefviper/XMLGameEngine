<!-- astrosmash.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Sept 30, 2026 -->

<!--
  Astrosmash, after the 1981 Intellivision game: rocks fall from the top of the
  screen and you shoot them from a ship that slides along the bottom. A rock
  that is shot scores and starts its fall over; a rock that reaches the ground
  or hits the ship costs a life. Score `goal` to win, lose all your lives and
  it is game over. A and D or the arrows move, Space fires, P or Escape
  pauses.

  How it is written:
  * Each state owns what it draws: the title, the help and the keys to the
    main menu, the rocks, the shot, the ship, the score and the lives to
    playing, the PAUSED sign to paused, each ending's words to its own state.
    Only "spacebar to play again", which both endings show, is the game's.
  * It is Kaboom's falling pieces, with their fall speeds and starting heights
    drawn by <random> when the game loads, plus Space Invaders' gun: <fire />
    launches one shot at a time from the ship, and the shot <die />s on a
    rock or the edge of the screen.
  * A rock hit by the shot is <inc />'d for the ship and <reset /> to the
    start of its fall. Two groups of falling things, slow boulders and fast
    pebbles, share the class `rocks`, so the shot and the ship have one rule
    each for both.
  * Paused and the endings draw the sky still underneath (<show state>),
    with the score.
  The rocks never change, so there are no waves and no <scenes>.
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../xge/xgedef.xsd">
  <window name="Astrosmash">
    <width>800</width>
    <height>600</height>
    <background>color.black</background>
    <fullscreen>false</fullscreen>
    <framerate>60</framerate>
  </window>
  <variables>
    <variable name="shipwidth">60</variable>
    <variable name="shipheight">20</variable>
    <variable name="boulder">34</variable>
    <variable name="pebble">18</variable>
    <variable name="step">7</variable>
    <variable name="margin">20</variable>
    <variable name="goal">20</variable>
    <variable name="startlives">5</variable>
  </variables>
  <sounds>
    <!-- a rock shot: a pop -->
    <sound name="pop" wave="noise">
      <volume>0.3</volume>
      <note pitch="3000" to="800">0.1</note>
    </sound>
    <!-- a rock on the ground, or on the ship -->
    <sound name="thud" wave="noise">
      <volume>0.45</volume>
      <note pitch="1500" to="100">0.4</note>
    </sound>
    <!-- a shot fired: a quick falling zap -->
    <sound name="shoot" wave="square">
      <volume>0.15</volume>
      <note pitch="C6" to="C4">0.1</note>
    </sound>
    <!-- a game started: a rising arpeggio -->
    <sound name="start" wave="square">
      <volume>0.2</volume>
      <note pitch="C5">0.07</note>
      <note pitch="E5">0.07</note>
      <note pitch="G5">0.07</note>
      <note pitch="C6">0.14</note>
    </sound>
    <!-- twenty rocks shot -->
    <sound name="win" wave="square">
      <volume>0.2</volume>
      <note pitch="C5">0.1</note>
      <note pitch="E5">0.1</note>
      <note pitch="G5">0.1</note>
      <note pitch="C6">0.1</note>
      <note pitch="G5">0.1</note>
      <note pitch="C6">0.3</note>
    </sound>
    <!-- out of ships -->
    <sound name="gameover" wave="triangle">
      <volume>0.4</volume>
      <note pitch="G4">0.25</note>
      <note pitch="E4">0.25</note>
      <note pitch="C4" to="C3">0.7</note>
    </sound>
  </sounds>
  <styles>
    <style name="banner"><size>128</size><color>color.orange</color></style>
    <style name="prompt"><size>48</size></style>
    <style name="hud"><size>48</size><color>color.cyan</color></style>
  </styles>
  <objects>
    <!-- after a game, in both endings -->
    <object name="again">
      <sprite>
        <text style="prompt">
          <content>spacebar to play again</content>
        </text>
      </sprite>
      <position><x><centered /></x><y><centered>window.height.center + 70</centered></y></position>
    </object>
  </objects>
  <states>
    <state name="mainmenu">
      <objects>
        <object name="title">
          <sprite>
            <text style="banner">
              <content>ASTROSMASH</content>
              <size>120</size>
            </text>
          </sprite>
          <position><x><centered /></x><y><centered>window.height.center - 130</centered></y></position>
        </object>
        <object name="help">
          <sprite>
            <text>
              <content>shoot the rocks before they land</content>
              <size>40</size>
              <color>color.white</color>
            </text>
          </sprite>
          <position><x><centered /></x><y><centered>window.height.center - 20</centered></y></position>
        </object>
        <object name="keys">
          <sprite>
            <text>
              <content>a and d, or the arrow keys, to move; space to fire</content>
              <size>28</size>
              <color>color.lightgrey</color>
            </text>
          </sprite>
          <position><x><centered /></x><y><centered>window.height.center + 30</centered></y></position>
        </object>
        <object name="start">
          <sprite>
            <text style="prompt">
              <content>spacebar to start</content>
            </text>
          </sprite>
          <position><x><centered /></x><y><centered>window.height.center + 130</centered></y></position>
        </object>
      </objects>
      <inputs>
        <input button="space">
          <push state="playing" />
          <play sound="start" />
        </input>
      </inputs>
    </state>
    <state name="playing">
      <objects>
        <group name="boulders" class="rocks">
          <sprite>
            <rectangle>
              <width>boulder</width>
              <height>boulder</height>
              <color>color.lightgrey</color>
            </rectangle>
          </sprite>
          <position>
            <y><random min="-500" max="-40" /></y>
          </position>
          <velocity>
            <x>0</x>
            <y><random min="1" max="2" /></y>
          </velocity>
          <collisions>
            <enabled>true</enabled>
            <collision edge="bottom">
              <dec variable="ship.lives" />
              <reset />
              <play sound="thud" />
            </collision>
            <collision object="ship">
              <dec variable="ship.lives" />
              <reset />
              <play sound="thud" />
            </collision>
            <collision object="shot">
              <inc variable="ship.score" />
              <reset />
              <play sound="pop" />
            </collision>
          </collisions>
          <member>
            <position><x>50</x></position>
          </member>
          <member>
            <position><x>230</x></position>
          </member>
          <member>
            <position><x>410</x></position>
          </member>
          <member>
            <position><x>590</x></position>
          </member>
        </group>
        <group name="pebbles" class="rocks">
          <sprite>
            <rectangle>
              <width>pebble</width>
              <height>pebble</height>
              <color>color.orange</color>
            </rectangle>
          </sprite>
          <position>
            <y><random min="-700" max="-40" /></y>
          </position>
          <velocity>
            <x>0</x>
            <y><random min="2" max="3.5" /></y>
          </velocity>
          <collisions>
            <enabled>true</enabled>
            <collision edge="bottom">
              <dec variable="ship.lives" />
              <reset />
              <play sound="thud" />
            </collision>
            <collision object="ship">
              <dec variable="ship.lives" />
              <reset />
              <play sound="thud" />
            </collision>
            <collision object="shot">
              <inc variable="ship.score" />
              <reset />
              <play sound="pop" />
            </collision>
          </collisions>
          <member>
            <position><x>140</x></position>
          </member>
          <member>
            <position><x>320</x></position>
          </member>
          <member>
            <position><x>500</x></position>
          </member>
          <member>
            <position><x>680</x></position>
          </member>
        </group>
        <object name="shot" class="projectile">
          <sprite>
            <rectangle>
              <width>4</width>
              <height>16</height>
              <color>color.white</color>
            </rectangle>
          </sprite>
          <position><x>0</x><y>0</y></position>
          <velocity><y>-11</y></velocity>
          <collisions>
            <enabled>false</enabled>
            <collision edge="all">
              <die />
            </collision>
            <collision class="rocks">
              <die />
            </collision>
          </collisions>
        </object>
        <object name="ship">
          <sprite>
            <rectangle>
              <width>shipwidth</width>
              <height>shipheight</height>
              <color>color.cyan</color>
            </rectangle>
          </sprite>
          <position><x><centered /></x><y>window.bottom - ship.height - margin</y></position>
          <collisions>
            <enabled>true</enabled>
            <collision edge="horizontal">
              <stick />
            </collision>
          </collisions>
          <actions>
            <action name="left">
              <move direction="left">step</move>
            </action>
            <action name="right">
              <move direction="right">step</move>
            </action>
            <action name="gun">
              <fire object="shot" />
              <play sound="shoot" />
            </action>
          </actions>
          <variables>
            <variable name="score">0</variable>
            <variable name="lives">startlives</variable>
          </variables>
        </object>
        <object name="score">
          <sprite>
            <text style="hud">
              <number>ship.score</number>
            </text>
          </sprite>
          <position><x>margin</x><y>margin</y></position>
        </object>
        <object name="lives">
          <sprite>
            <text style="hud">
              <number>ship.lives</number>
              <color>color.red</color>
            </text>
          </sprite>
          <position><x>window.right - lives.width - margin</x><y>margin</y></position>
        </object>
      </objects>
      <inputs>
        <input button="a">
          <trigger object="ship" action="left" />
        </input>
        <input button="left">
          <trigger object="ship" action="left" />
        </input>
        <input button="d">
          <trigger object="ship" action="right" />
        </input>
        <input button="right">
          <trigger object="ship" action="right" />
        </input>
        <input button="space">
          <trigger object="ship" action="gun" />
        </input>
        <input button="p">
          <push state="paused" />
        </input>
        <input button="escape">
          <push state="paused" />
        </input>
      </inputs>
      <conditions>
        <condition object="ship" variable="score">
          <atleast>goal</atleast>
          <push state="youwin" />
          <play sound="win" />
        </condition>
        <condition object="ship" variable="lives">
          <atmost>0</atmost>
          <push state="gameover" />
          <play sound="gameover" />
        </condition>
      </conditions>
    </state>
    <state name="paused">
      <objects>
        <object name="paused">
          <sprite>
            <text style="banner">
              <content>PAUSED</content>
              <color>color.white</color>
            </text>
          </sprite>
          <position><x><centered /></x><y><centered /></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input button="space">
          <pop />
        </input>
        <input button="p">
          <pop />
        </input>
        <input button="escape">
          <pop />
        </input>
      </inputs>
    </state>
    <state name="youwin">
      <objects>
        <object name="youwin">
          <sprite>
            <text style="banner">
              <content>YOU WIN</content>
              <color>color.green</color>
            </text>
          </sprite>
          <position><x><centered /></x><y><centered>window.height.center - 60</centered></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
        <show object="again" />
      </shows>
      <inputs>
        <input button="space">
          <reset />
        </input>
      </inputs>
    </state>
    <state name="gameover">
      <objects>
        <object name="gameover">
          <sprite>
            <text style="banner">
              <content>GAME OVER</content>
              <color>color.red</color>
            </text>
          </sprite>
          <position><x><centered /></x><y><centered>window.height.center - 60</centered></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
        <show object="again" />
      </shows>
      <inputs>
        <input button="space">
          <reset />
        </input>
      </inputs>
    </state>
  </states>
</game>
