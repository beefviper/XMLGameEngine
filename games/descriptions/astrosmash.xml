<!-- astrosmash.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Sept 30, 2026 -->

<!--
  Astrosmash, after the 1981 Intellivision game. Rocks rain down at a slant
  and you shoot them from a laser base that slides along the ground. A big
  rock scores 10 and breaks into two small ones; a small rock scores 20. A
  rock that lands takes half its worth off the score, and one that hits the
  base costs it. Spinners score 40, but one that lands blows up the base
  too. A spare base every 1,000 points; the game goes on until the last
  base is gone, and the peak score reached is shown beside the score.

  A and D or the arrows move, Space fires, P or Escape pauses.

  How it is written:
  * Every falling rock is of one <group>, `rocks`, holding two groups of
    columns, the big ones and the small ones, which take its rules and give
    their own picture and worth (self.worth, read as the rule runs). Their
    fall speeds, slants and starting heights are <random>, drawn again each
    time one is reset to the top.
  * The shot's rule about the big rocks <release>s two chips, small rocks
    that do not exist until then, where it hits one.
  * A hit on the base resets every rock and spinner (<reset object>): the
    sky clears, as it does on the Intellivision.
  * The spare bases: the ship's `spare` is the next 1,000, and a condition
    comparing the score with it adds a base and moves it on.
  * Paused and game over draw the sky still underneath (<show state>).
  Not in it: the levels (faster rocks, a higher multiplier and a new sky
  colour at 5,000, 20,000 ...), the guided missiles and the UFO, and
  holding Space for rapid fire.
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../xge/xgedef.xsd">
  <window name="Astrosmash">
    <width>800</width>
    <height>600</height>
    <background>color.black</background>
    <fullscreen>false</fullscreen>
    <framerate>60</framerate>
  </window>
  <variables>
    <variable name="step">7</variable>
    <variable name="margin">20</variable>
    <variable name="ground">40</variable>
    <variable name="slant">1</variable>
  </variables>
  <sounds>
    <sound name="pop" wave="noise"><volume>0.3</volume><note pitch="3000" to="800">0.1</note></sound>
    <sound name="thud" wave="noise"><volume>0.3</volume><note pitch="800" to="100">0.25</note></sound>
    <sound name="boom" wave="noise"><volume>0.5</volume><note pitch="1500" to="60">0.9</note></sound>
    <sound name="shoot" wave="square"><volume>0.15</volume><note pitch="C6" to="C4">0.1</note></sound>
    <sound name="start" wave="square">
      <volume>0.2</volume>
      <note pitch="C5">0.07</note>
      <note pitch="E5">0.07</note>
      <note pitch="G5">0.07</note>
      <note pitch="C6">0.14</note>
    </sound>
    <!-- a spare base -->
    <sound name="spare" wave="square">
      <volume>0.2</volume>
      <note pitch="G5">0.08</note>
      <note pitch="C6">0.08</note>
      <note pitch="G6">0.16</note>
    </sound>
    <sound name="gameover" wave="triangle">
      <volume>0.4</volume>
      <note pitch="G4">0.25</note>
      <note pitch="E4">0.25</note>
      <note pitch="C4" to="C3">0.7</note>
    </sound>
  </sounds>
  <styles>
    <style name="banner"><size>120</size><color>color.orange</color></style>
    <style name="line"><size>32</size><color>color.white</color></style>
    <style name="hud"><size>40</size><color>color.white</color></style>
  </styles>
  <states>
    <state name="mainmenu">
      <objects>
        <object name="title">
          <sprite><text style="banner"><content>ASTROSMASH</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 140</centered></y></position>
        </object>
        <object name="help">
          <sprite><text style="line"><content>big rocks 10, small rocks 20, spinners 40</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 30</centered></y></position>
        </object>
        <object name="keys">
          <sprite><text style="line"><content>a and d, or the arrow keys, to move; space to fire</content><size>26</size><color>color.lightgrey</color></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center + 20</centered></y></position>
        </object>
        <object name="start">
          <sprite><text style="line"><content>spacebar to start</content><size>48</size></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center + 130</centered></y></position>
        </object>
      </objects>
      <inputs>
        <input button="space"><push state="playing" /><play sound="start" /></input>
      </inputs>
    </state>
    <state name="playing">
      <objects>
        <object name="ground" class="ground">
          <sprite><rectangle><width>window.right</width><height>ground</height><color>color.darkgrey</color></rectangle></sprite>
          <position><x>0</x><y>window.bottom - ground</y></position>
          <collisions><enabled>true</enabled></collisions>
        </object>
        <!-- the falling rocks: four big and four small, falling at a slant from
             above the screen, each starting over at the top when shot or landed -->
        <group name="rocks" class="rocks">
          <columns>4</columns>
          <rows>1</rows>
          <position><y><random min="-600" max="-40" /></y></position>
          <velocity><x><random min="-slant" max="slant" /></x><y><random min="1" max="2.5" /></y></velocity>
          <collisions>
            <enabled>true</enabled>
            <collision edge="horizontal"><bounce /></collision>
            <collision object="ground">
              <set variable="ship.score">max(0, ship.score - self.worth / 2)</set>
              <reset />
              <play sound="thud" />
            </collision>
            <collision object="shot">
              <inc variable="ship.score">self.worth</inc>
              <set variable="ship.peak">max(ship.peak, ship.score)</set>
              <reset />
              <play sound="pop" />
            </collision>
          </collisions>
          <group name="boulders">
            <padding><x>140</x></padding>
            <sprite>
              <bitmap>
                <row>..****..</row>
                <row>.******.</row>
                <row>********</row>
                <row>********</row>
                <row>.******.</row>
                <row>..***...</row>
                <scale>5</scale>
                <color>color.lightgrey</color>
              </bitmap>
            </sprite>
            <position><x>50</x></position>
            <variables><variable name="worth">10</variable></variables>
          </group>
          <group name="pebbles">
            <padding><x>160</x></padding>
            <sprite>
              <bitmap>
                <row>.**.</row>
                <row>****</row>
                <row>***.</row>
                <scale>5</scale>
                <color>color.orange</color>
              </bitmap>
            </sprite>
            <position><x>140</x><y><random min="-800" max="-40" /></y></position>
            <velocity><y><random min="2" max="3.5" /></y></velocity>
            <variables><variable name="worth">20</variable></variables>
          </group>
        </group>
        <!-- what a big rock breaks into: small ones flying apart, eight at most -->
        <object name="chip" class="rocks">
          <sprite>
            <bitmap>
              <row>.**.</row>
              <row>****</row>
              <row>.**.</row>
              <scale>5</scale>
              <color>color.yellow</color>
            </bitmap>
          </sprite>
          <velocity><x><random min="-2.5" max="2.5" /></x><y>2.5</y></velocity>
          <exists>false</exists>
          <most>8</most>
          <collisions>
            <enabled>true</enabled>
            <collision edge="horizontal"><bounce /></collision>
            <collision object="ground">
              <set variable="ship.score">max(0, ship.score - 10)</set>
              <despawn />
              <play sound="thud" />
            </collision>
            <collision object="shot">
              <inc variable="ship.score">20</inc>
              <set variable="ship.peak">max(ship.peak, ship.score)</set>
              <despawn />
              <play sound="pop" />
            </collision>
          </collisions>
        </object>
        <!-- spinners: two, now and then, that blow up the base if they land -->
        <group name="spinners" class="spinner">
          <columns>2</columns>
          <rows>1</rows>
          <padding><x>320</x></padding>
          <sprite name="a">
            <bitmap>
              <row>*...*</row>
              <row>.*.*.</row>
              <row>..*..</row>
              <row>.*.*.</row>
              <row>*...*</row>
              <scale>4</scale>
              <color>color.magenta</color>
            </bitmap>
          </sprite>
          <sprite name="b">
            <bitmap>
              <row>..*..</row>
              <row>..*..</row>
              <row>*****</row>
              <row>..*..</row>
              <row>..*..</row>
              <scale>4</scale>
              <color>color.magenta</color>
            </bitmap>
          </sprite>
          <animation>
            <interval>0.1</interval>
            <frame sprite="a" />
            <frame sprite="b" />
          </animation>
          <position><x>200</x><y><random min="-2400" max="-900" /></y></position>
          <velocity><x>0</x><y><random min="1.5" max="2.5" /></y></velocity>
          <collisions>
            <enabled>true</enabled>
            <collision object="ground"><trigger object="ship" action="lose" /></collision>
            <collision object="shot">
              <inc variable="ship.score">40</inc>
              <set variable="ship.peak">max(ship.peak, ship.score)</set>
              <reset />
              <play sound="pop" />
            </collision>
          </collisions>
        </group>
        <object name="shot" class="projectile">
          <sprite><rectangle><width>4</width><height>16</height><color>color.white</color></rectangle></sprite>
          <position><x>0</x><y>0</y></position>
          <velocity><y>-11</y></velocity>
          <collisions>
            <enabled>false</enabled>
            <collision edge="all"><die /></collision>
            <!-- a big rock breaks where the shot hits it -->
            <collision object="boulders"><release object="chip">2</release></collision>
            <collision class="rocks"><die /></collision>
            <collision class="spinner"><die /></collision>
          </collisions>
        </object>
        <!-- the laser base -->
        <object name="ship">
          <sprite>
            <bitmap>
              <row>.....**.....</row>
              <row>.....**.....</row>
              <row>....****....</row>
              <row>.**********.</row>
              <row>************</row>
              <scale>5</scale>
              <color>color.cyan</color>
            </bitmap>
          </sprite>
          <position><x><centered /></x><y>window.bottom - ground - ship.height</y></position>
          <collisions>
            <enabled>true</enabled>
            <collision edge="horizontal"><stick /></collision>
            <collision class="rocks"><trigger action="lose" /></collision>
            <collision class="spinner"><trigger action="lose" /></collision>
          </collisions>
          <actions>
            <action name="left"><move direction="left">step</move></action>
            <action name="right"><move direction="right">step</move></action>
            <action name="gun"><fire object="shot" /><play sound="shoot" /></action>
            <!-- the base blown up: the sky clears and the next comes on -->
            <action name="lose">
              <dec variable="ship.lives" />
              <reset object="rocks" />
              <despawn object="chip" />
              <reset object="spinners" />
              <play sound="boom" />
            </action>
          </actions>
          <variables>
            <variable name="score">0</variable>
            <variable name="peak">0</variable>
            <variable name="lives">4</variable>
            <variable name="spare">1000</variable>
          </variables>
        </object>
        <object name="score">
          <sprite><text style="hud"><number>ship.score</number></text></sprite>
          <position><x>margin</x><y>margin</y></position>
        </object>
        <object name="peak">
          <sprite><text style="hud"><content>PEAK </content><number>ship.peak</number><size>28</size><color>color.lightgrey</color></text></sprite>
          <position><x><centered /></x><y>margin + 6</y></position>
        </object>
        <object name="lives">
          <sprite><text style="hud"><number>ship.lives</number><color>color.cyan</color></text></sprite>
          <position><x>window.right - lives.width - margin</x><y>margin</y></position>
        </object>
      </objects>
      <inputs>
        <input button="a left"><trigger object="ship" action="left" /></input>
        <input button="d right"><trigger object="ship" action="right" /></input>
        <input button="space"><trigger object="ship" action="gun" /></input>
        <input button="p escape"><push state="paused" /></input>
      </inputs>
      <conditions>
        <condition object="ship" variable="score">
          <atleast object="ship" variable="spare" />
          <inc variable="ship.lives" />
          <inc variable="ship.spare">1000</inc>
          <play sound="spare" />
        </condition>
        <condition object="ship" variable="lives">
          <atmost>0</atmost>
          <push state="gameover" />
          <play sound="gameover" />
        </condition>
      </conditions>
    </state>
    <state name="paused">
      <objects>
        <object name="paused">
          <sprite><text style="banner"><content>PAUSED</content><color>color.white</color></text></sprite>
          <position><x><centered /></x><y><centered /></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input button="space p escape"><pop /></input>
      </inputs>
    </state>
    <state name="gameover">
      <objects>
        <object name="message">
          <sprite><text style="banner"><content>GAME OVER</content><color>color.red</color></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 60</centered></y></position>
        </object>
        <object name="again">
          <sprite><text style="line"><content>spacebar to play again</content><size>48</size></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center + 70</centered></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input button="space"><reset /></input>
      </inputs>
    </state>
  </states>
</game>
