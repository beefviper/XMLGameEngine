<!-- speedway.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Oct 31, 2026 -->

<!--
  Speedway: an original top down race for two players and two computer
  cars, three laps of a loop seen from above. Keep to the tarmac: the grass
  slows you, the sand corners slow you more, and the oil on the back
  straight lets the car slide where it was going. The first car home after
  three laps wins.

  Player one drives with W A S D, player two with the arrows: up goes, down
  brakes and backs, left and right steer. P or Escape pauses, Space starts
  and plays again.

  It is the game the fourth stage of tables and tracks was made for:
  * A car has a <heading>, held <thrust> and <turn>, <drag> for its top
    speed, and a <grip>: with a heading, its speed across the way it faces
    loses that share every frame, so it goes where it points and slides when
    the grip is low.
  * The track is a <map>. Its grass, sand and oil are <surface>s: a car
    whose middle is over one has that ground's drag and grip in place of
    its own. The tarmac is no piece at all, so the car's own.
  * Laps are four gates the cars must cross in order. Each car keeps the
    number of the next one; a gate's rule moves it on only when it is that
    one, so cutting across or turning back counts nothing.
  * The computer cars fly a <path> round their lanes; with a heading, a
    car on a path faces the way it goes.
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../xgedef.xsd">
  <window name="Speedway">
    <width>800</width>
    <height>600</height>
    <background>color.darkgrey</background>
  </window>
  <variables>
    <variable name="laps">3</variable>
    <!-- a car: its push, its brake, its steering, its drag (top speed is about push / drag) and grip on tarmac -->
    <variable name="push">0.14</variable>
    <variable name="brake">0.08</variable>
    <variable name="steer">3.5</variable>
    <variable name="tarmac">0.03</variable>
    <variable name="hold">0.3</variable>
  </variables>
  <sounds>
    <sound name="gate" wave="triangle"><volume>0.15</volume><note pitch="E5">0.04</note></sound>
    <sound name="lap" wave="triangle">
      <volume>0.35</volume>
      <note pitch="C5">0.08</note>
      <note pitch="G5">0.12</note>
    </sound>
    <sound name="bump"><volume>0.2</volume><note pitch="C3">0.04</note></sound>
    <sound name="win" wave="triangle">
      <volume>0.4</volume>
      <note pitch="C5">0.1</note>
      <note pitch="E5">0.1</note>
      <note pitch="G5">0.1</note>
      <note pitch="C6">0.3</note>
    </sound>
  </sounds>
  <paths>
    <!-- the outer lane, from the front of the grid, round and back -->
    <path name="outer">
      <speed>3.4</speed>
      <step><x>120</x><y>0</y></step>
      <step><x>60</x><y>60</y></step>
      <step><x>0</x><y>240</y></step>
      <step><x>-60</x><y>60</y></step>
      <step><x>-480</x><y>0</y></step>
      <step><x>-60</x><y>-60</y></step>
      <step><x>0</x><y>-240</y></step>
      <step><x>60</x><y>-60</y></step>
      <step><x>360</x><y>0</y></step>
    </path>
    <!-- the inner lane: shorter, a little slower -->
    <path name="inner">
      <speed>3.1</speed>
      <step><x>60</x><y>0</y></step>
      <step><x>40</x><y>40</y></step>
      <step><x>0</x><y>120</y></step>
      <step><x>-40</x><y>40</y></step>
      <step><x>-360</x><y>0</y></step>
      <step><x>-40</x><y>-40</y></step>
      <step><x>0</x><y>-120</y></step>
      <step><x>40</x><y>-40</y></step>
      <step><x>300</x><y>0</y></step>
    </path>
  </paths>
  <styles>
    <style name="banner"><size>90</size><color>color.yellow</color></style>
    <style name="prompt"><size>34</size></style>
    <style name="help"><size>24</size></style>
    <style name="hud"><size>22</size><color>color.lightgrey</color></style>
  </styles>
  <kit>
    <!-- What every car has: its laps, and the gates. Starting just past the
         finish line, the next gate is the second; crossing the finish line
         when the fourth was the last finishes a lap. -->
    <object name="racer">
      <heading>90</heading>
      <collisions>
        <type>pixel</type>
        <collision object="gate2"><condition variable="next"><equal>2</equal></condition><set variable="self.next">3</set></collision>
        <collision object="gate3"><condition variable="next"><equal>3</equal></condition><set variable="self.next">4</set></collision>
        <collision object="gate4"><condition variable="next"><equal>4</equal></condition><set variable="self.next">1</set></collision>
        <collision object="gate1">
          <condition variable="next"><equal>1</equal></condition>
          <set variable="self.next">2</set>
          <inc variable="self.lap" />
          <play sound="lap" />
        </collision>
      </collisions>
      <variables>
        <variable name="lap">1</variable>
        <variable name="next">2</variable>
      </variables>
    </object>

    <!-- a gate across the track: nothing to see but the finish line -->
    <object name="gate">
      <sprite><rectangle><width>120</width><height>4</height><color>color.darkgrey</color></rectangle></sprite>
      <position><x>0</x><y>0</y></position>
      <collisions />
    </object>
  </kit>
  <objects>
    <object name="again">
      <sprite><text style="prompt"><content>spacebar to race again</content></text></sprite>
      <position><x><centered /></x><y><centered>window.height.center + 90</centered></y></position>
    </object>
  </objects>
  <states>
    <state name="title">
      <objects>
        <object name="title">
          <sprite><text style="banner"><content>SPEEDWAY</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 140</centered></y></position>
        </object>
        <object name="help">
          <sprite><text style="help"><content>three laps against each other and two computer cars: keep off the grass, mind the oil</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 40</centered></y></position>
        </object>
        <object name="keys">
          <sprite><text style="help"><content>player one w a s d, player two the arrows: up goes, down brakes, left and right steer</content><color>color.lightgrey</color></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center + 6</centered></y></position>
        </object>
        <object name="start">
          <sprite><text style="prompt"><content>spacebar to start</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center + 110</centered></y></position>
        </object>
      </objects>
      <inputs>
        <input button="space"><push state="playing" /></input>
      </inputs>
    </state>

    <state name="playing">
      <objects>
        <object name="race">
          <variables>
            <variable name="started">0</variable>
          </variables>
        </object>
        <object name="lap1shown">
          <sprite><text style="hud"><content>PLAYER 1  LAP</content><number>p1.lap</number><content>OF 3</content><color>color.orange</color></text></sprite>
          <position><x>20</x><y>10</y></position>
        </object>
        <object name="lap2shown">
          <sprite><text style="hud"><content>PLAYER 2  LAP</content><number>p2.lap</number><content>OF 3</content><color>color.cyan</color></text></sprite>
          <position><x>560</x><y>10</y></position>
        </object>

        <!-- The track, 40 pixels a tile: barriers round it and in the
             middle, grass inside them, sand in the corners, oil on the
             back straight. The tarmac is no piece. -->
        <map name="track">
          <tile><width>40</width><height>40</height></tile>
          <position><x>0</x><y>40</y></position>
          <row>####################</row>
          <row>#gggggggggggggggggg#</row>
          <row>#gs..............sg#</row>
          <row>#g................g#</row>
          <row>#g................g#</row>
          <row>#g...gggggggggg...g#</row>
          <row>#g...g########g...g#</row>
          <row>#g...g########g...g#</row>
          <row>#g...gggggggggg...g#</row>
          <row>#g................g#</row>
          <row>#g.......oo.......g#</row>
          <row>#gs..............sg#</row>
          <row>#gggggggggggggggggg#</row>
          <row>####################</row>
          <group name="barriers" char="#" class="wall">
            <sprite><rectangle><width>40</width><height>40</height><color>color.red</color></rectangle></sprite>
            <collisions />
          </group>
          <group name="grass" char="g">
            <sprite><rectangle><width>40</width><height>40</height><color>color.forestgreen</color></rectangle></sprite>
            <surface><drag>0.08</drag><grip>0.3</grip></surface>
          </group>
          <group name="sand" char="s">
            <sprite><rectangle><width>40</width><height>40</height><color>color.brown</color></rectangle></sprite>
            <surface><drag>0.14</drag><grip>0.5</grip></surface>
          </group>
          <group name="oil" char="o">
            <sprite><rectangle><width>40</width><height>40</height><color>color.black</color></rectangle></sprite>
            <surface><drag>0.005</drag><grip>0.02</grip></surface>
          </group>
        </map>

        <!-- the finish line, and three more gates round the loop -->
        <object name="gate1" from="gate">
          <sprite><rectangle><width>6</width><height>120</height><color>color.white</color></rectangle></sprite>
          <position><x>380</x><y>120</y></position>
        </object>
        <object name="gate2" from="gate"><position><x>600</x><y>320</y></position></object>
        <object name="gate3" from="gate">
          <sprite><rectangle><width>4</width><height>120</height><color>color.darkgrey</color></rectangle></sprite>
          <position><x>400</x><y>400</y></position>
        </object>
        <object name="gate4" from="gate"><position><x>80</x><y>320</y></position></object>

        <!-- the players' cars -->
        <object name="p1" class="car" from="racer">
          <sprite>
            <bitmap>
              <row>.****.</row>
              <row>******</row>
              <row>.*ww*.</row>
              <row>.****.</row>
              <row>.****.</row>
              <row>.*ww*.</row>
              <row>******</row>
              <row>.****.</row>
              <scale>2</scale>
              <color>color.orange</color>
              <color char="w">color.lightgrey</color>
            </bitmap>
          </sprite>
          <position><x><centered>440</centered></x><y><centered>160</centered></y></position>
          <drag>tarmac</drag>
          <mass>1</mass>
          <grip>hold</grip>
          <collisions>
            <collision class="wall"><bounce>0.4</bounce><play sound="bump" /></collision>
            <collision class="car"><knock>0.5</knock><play sound="bump" /></collision>
            <collision class="cpu"><bounce>0.6</bounce><play sound="bump" /></collision>
          </collisions>
          <actions>
            <action name="go"><thrust>push</thrust></action>
            <action name="brake"><thrust>0 - brake</thrust></action>
            <action name="left"><turn direction="counterclockwise">steer</turn></action>
            <action name="right"><turn direction="clockwise">steer</turn></action>
          </actions>
        </object>
        <object name="p2" class="car" from="racer">
          <sprite>
            <bitmap>
              <row>.****.</row>
              <row>******</row>
              <row>.*ww*.</row>
              <row>.****.</row>
              <row>.****.</row>
              <row>.*ww*.</row>
              <row>******</row>
              <row>.****.</row>
              <scale>2</scale>
              <color>color.cyan</color>
              <color char="w">color.lightgrey</color>
            </bitmap>
          </sprite>
          <position><x><centered>440</centered></x><y><centered>200</centered></y></position>
          <drag>tarmac</drag>
          <mass>1</mass>
          <grip>hold</grip>
          <collisions>
            <collision class="wall"><bounce>0.4</bounce><play sound="bump" /></collision>
            <collision class="car"><knock>0.5</knock><play sound="bump" /></collision>
            <collision class="cpu"><bounce>0.6</bounce><play sound="bump" /></collision>
          </collisions>
          <actions>
            <action name="go"><thrust>push</thrust></action>
            <action name="brake"><thrust>0 - brake</thrust></action>
            <action name="left"><turn direction="counterclockwise">steer</turn></action>
            <action name="right"><turn direction="clockwise">steer</turn></action>
          </actions>
        </object>

        <!-- the computer's cars, each on its lane's path, round and round -->
        <object name="cpu1" class="cpu" from="racer">
          <sprite>
            <bitmap>
              <row>.****.</row>
              <row>******</row>
              <row>.*ww*.</row>
              <row>.****.</row>
              <row>.****.</row>
              <row>.*ww*.</row>
              <row>******</row>
              <row>.****.</row>
              <scale>2</scale>
              <color>color.magenta</color>
              <color char="w">color.lightgrey</color>
            </bitmap>
          </sprite>
          <position><x><centered>520</centered></x><y><centered>140</centered></y></position>
          <timers>
            <timer><every>0.1</every><follow path="outer" /></timer>
          </timers>
        </object>
        <object name="cpu2" class="cpu" from="racer">
          <sprite>
            <bitmap>
              <row>.****.</row>
              <row>******</row>
              <row>.*ww*.</row>
              <row>.****.</row>
              <row>.****.</row>
              <row>.*ww*.</row>
              <row>******</row>
              <row>.****.</row>
              <scale>2</scale>
              <color>color.yellow</color>
              <color char="w">color.lightgrey</color>
            </bitmap>
          </sprite>
          <position><x><centered>520</centered></x><y><centered>220</centered></y></position>
          <timers>
            <timer><every>0.1</every><follow path="inner" /></timer>
          </timers>
        </object>
      </objects>
      <inputs>
        <input button="w"><trigger object="p1" action="go" /></input>
        <input button="s"><trigger object="p1" action="brake" /></input>
        <input button="a"><trigger object="p1" action="left" /></input>
        <input button="d"><trigger object="p1" action="right" /></input>
        <input button="up"><trigger object="p2" action="go" /></input>
        <input button="down"><trigger object="p2" action="brake" /></input>
        <input button="left"><trigger object="p2" action="left" /></input>
        <input button="right"><trigger object="p2" action="right" /></input>
        <input><button>p</button><button>escape</button><push state="paused" /></input>
      </inputs>
      <conditions>
        <!-- the first time round: on your marks -->
        <condition object="race" variable="started">
          <equal>0</equal>
          <set variable="race.started">1</set>
          <push state="ready" />
        </condition>
        <condition object="p1" variable="lap">
          <above>laps</above>
          <become object="winner" sprite="p1" />
          <play sound="win" />
          <push state="over" />
        </condition>
        <condition object="p2" variable="lap">
          <above>laps</above>
          <become object="winner" sprite="p2" />
          <play sound="win" />
          <push state="over" />
        </condition>
        <condition object="cpu1" variable="lap">
          <above>laps</above>
          <become object="winner" sprite="cpu" />
          <push state="over" />
        </condition>
        <condition object="cpu2" variable="lap">
          <above>laps</above>
          <become object="winner" sprite="cpu" />
          <push state="over" />
        </condition>
      </conditions>
    </state>

    <!-- on your marks: the grid, still, for a moment -->
    <state name="ready">
      <objects>
        <object name="ready">
          <sprite><text style="banner"><content>GET READY</content><color>color.white</color></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 20</centered></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input><button>p</button><button>escape</button><push state="paused" /></input>
      </inputs>
      <timers>
        <timer><after>1.5</after><pop /></timer>
      </timers>
    </state>

    <state name="paused">
      <objects>
        <object name="paused">
          <sprite><text style="banner"><content>PAUSED</content><color>color.white</color></text></sprite>
          <position><x><centered /></x><y><centered /></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input><button>p</button><button>escape</button><pop /></input>
      </inputs>
    </state>

    <state name="over">
      <objects>
        <object name="winner">
          <sprite name="p1"><text style="banner"><content>PLAYER 1 WINS</content><color>color.orange</color></text></sprite>
          <sprite name="p2"><text style="banner"><content>PLAYER 2 WINS</content><color>color.cyan</color></text></sprite>
          <sprite name="cpu"><text style="banner"><content>THE COMPUTER WINS</content><color>color.magenta</color></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 90</centered></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
        <show object="again" />
      </shows>
      <inputs>
        <input button="space"><reset /></input>
      </inputs>
    </state>
  </states>
</game>
