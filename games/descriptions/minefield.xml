<!-- minefield.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Nov 9, 2026 -->

<!--
  Minefield: ten mines are hidden under a nine by nine field. Open a
  square and it shows how many mines touch it, across, down or on a
  slant; a square with none round it opens its neighbours by itself, and
  theirs, so a whole clear patch opens at once. Open every square that
  hides no mine to win; open a mine and the game is lost. Flag a square
  you think hides a mine, so you do not open it by mistake.

  W A S D or the arrows move the cursor, Space opens, F flags. The mouse
  works too: the cursor follows it, a left click opens, a right click
  flags. P or Escape pauses. Space plays again.

  How it is written:
  * Three maps of <cells /> are laid in the same place: the mines, the
    squares over them, and the cursor over those.
  * The mines are spawned into <free /> cells, one a frame, by a condition
    that holds while fewer than ten are in play.
  * Opening is the cursor's <trigger action="open" class="square"><here /></trigger>:
    the action of the square under it.
  * A square counts the mines under it with <count><here /></count> and
    round it with <count><around /></count>, and picks its look with
    <condition>s in its action. With none round it, it runs the same
    action of the squares <around /> it; each square runs once a press,
    so the patch opens and the flood ends.
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../xgedef.xsd">
  <window name="Minefield">
    <width>480</width>
    <height>560</height>
  </window>
  <variables>
    <variable name="cell">48</variable>
    <variable name="left">24</variable>
    <variable name="top">104</variable>
  </variables>
  <styles>
    <style name="banner"><size>72</size><color>color.lightgrey</color></style>
    <style name="prompt"><size>28</size></style>
    <style name="help"><size>20</size><color>color.lightgrey</color></style>
    <style name="hud"><size>28</size></style>
    <style name="one"><size>32</size><color>color.cyan</color></style>
    <style name="two"><size>32</size><color>color.green</color></style>
    <style name="three"><size>32</size><color>color.red</color></style>
    <style name="more"><size>32</size><color>color.magenta</color></style>
    <style name="flag"><size>32</size><color>color.orange</color></style>
    <style name="cursor"><scale>4</scale><color>color.yellow</color></style>
  </styles>
  <objects>
    <object name="again">
      <sprite><text style="prompt"><content>spacebar to play again</content></text></sprite>
      <position><x><centered /></x><y>40</y></position>
    </object>
  </objects>
  <states>
    <state name="title">
      <objects>
        <object name="title">
          <sprite><text style="banner"><content>MINEFIELD</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 130</centered></y></position>
        </object>
        <group name="help">
          <rows>4</rows>
          <padding><y>30</y></padding>
          <sprite><text style="help" /></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 30</centered></y></position>
          <row number="1"><sprite><text><content>open every square that hides no mine</content></text></sprite></row>
          <row number="2"><sprite><text><content>a number is how many mines touch it</content></text></sprite></row>
          <row number="3"><sprite><text><content>w a s d or the arrows move, the mouse too</content></text></sprite></row>
          <row number="4"><sprite><text><content>spacebar or click opens, f or right click flags</content></text></sprite></row>
        </group>
        <object name="start">
          <sprite><text style="prompt"><content>spacebar to start</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center + 130</centered></y></position>
        </object>
      </objects>
      <inputs>
        <input><button>space</button><button>pad1.start</button><push state="playing" /></input>
      </inputs>
    </state>
    <state name="playing">
      <objects>
        <object name="status">
          <variables>
            <variable name="opened">0</variable>
            <variable name="flags">0</variable>
            <variable name="lost">0</variable>
          </variables>
        </object>
        <object name="flaglabel">
          <sprite><text style="hud"><content>flags </content><number>status.flags</number><content> of 10</content></text></sprite>
          <position><x>left</x><y>top - 50</y></position>
        </object>

        <!-- the mines, hidden under the squares -->
        <map name="mines">
          <tile><width>cell</width><height>cell</height></tile>
          <position><x>left</x><y>top</y></position>
          <columns>9</columns>
          <rows>9</rows>
          <cells />
          <object name="mine" class="mine">
            <sprite><circle><radius>4</radius><color>color.black</color></circle></sprite>
            <drawn>false</drawn>
          </object>
        </map>

        <!-- the squares -->
        <map name="field">
          <tile><width>cell</width><height>cell</height></tile>
          <position><x>left</x><y>top</y></position>
          <cells />
          <row>#########</row>
          <row>#########</row>
          <row>#########</row>
          <row>#########</row>
          <row>#########</row>
          <row>#########</row>
          <row>#########</row>
          <row>#########</row>
          <row>#########</row>
          <group name="squares" class="square" char="#">
            <sprite name="closed"><rectangle><width>cell - 4</width><height>cell - 4</height><color>color.grey</color></rectangle></sprite>
            <sprite name="flag"><text style="flag"><content>F</content></text></sprite>
            <sprite name="n0"><rectangle><width>cell - 4</width><height>cell - 4</height><color>color.darkgrey</color></rectangle></sprite>
            <sprite name="n1"><text style="one"><content>1</content></text></sprite>
            <sprite name="n2"><text style="two"><content>2</content></text></sprite>
            <sprite name="n3"><text style="three"><content>3</content></text></sprite>
            <sprite name="n4"><text style="more"><content>4</content></text></sprite>
            <sprite name="n5"><text style="more"><content>5</content></text></sprite>
            <sprite name="n6"><text style="more"><content>6</content></text></sprite>
            <sprite name="n7"><text style="more"><content>7</content></text></sprite>
            <sprite name="n8"><text style="more"><content>8</content></text></sprite>
            <sprite name="boom"><circle><radius>cell / 3</radius><color>color.red</color></circle></sprite>
            <sprite name="mine"><circle><radius>cell / 4</radius><color>color.white</color></circle></sprite>
            <actions>
              <!-- opened (by the cursor, or by a clear neighbour): only one still closed -->
              <action name="open">
                <condition variable="open"><equal>0</equal><trigger action="reveal" /></condition>
              </action>
              <action name="reveal">
                <set variable="self.open">1</set>
                <count class="mine" into="self.mine"><here /></count>
                <count class="mine" into="self.near"><around /></count>
                <condition variable="mine">
                  <equal>1</equal>
                  <set variable="self.near">9</set>
                  <become sprite="boom" />
                  <set variable="status.lost">1</set>
                  <trigger object="squares" action="show" />
                </condition>
                <condition variable="mine"><equal>0</equal><inc variable="status.opened" /></condition>
                <!-- nothing round it: the squares round it open too -->
                <condition variable="near"><equal>0</equal><become sprite="n0" /><trigger action="open" class="square"><around /></trigger></condition>
                <condition variable="near"><equal>1</equal><become sprite="n1" /></condition>
                <condition variable="near"><equal>2</equal><become sprite="n2" /></condition>
                <condition variable="near"><equal>3</equal><become sprite="n3" /></condition>
                <condition variable="near"><equal>4</equal><become sprite="n4" /></condition>
                <condition variable="near"><equal>5</equal><become sprite="n5" /></condition>
                <condition variable="near"><equal>6</equal><become sprite="n6" /></condition>
                <condition variable="near"><equal>7</equal><become sprite="n7" /></condition>
                <condition variable="near"><equal>8</equal><become sprite="n8" /></condition>
              </action>
              <!-- a flag on, or off again: open is 0 closed, 1 open, 2 flagged -->
              <action name="flag">
                <condition variable="open"><unequal>1</unequal><set variable="self.open">2 - self.open</set></condition>
                <condition variable="open"><equal>2</equal><become sprite="flag" /><inc variable="status.flags" /></condition>
                <condition variable="open"><equal>0</equal><become from="flag" sprite="closed" /><dec variable="status.flags" /></condition>
              </action>
              <!-- the game lost: where the mines were -->
              <action name="show">
                <count class="mine" into="self.mine"><here /></count>
                <condition variable="mine"><equal>1</equal><become from="closed" sprite="mine" /></condition>
              </action>
            </actions>
            <variables>
              <variable name="open">0</variable>
              <variable name="mine">0</variable>
              <variable name="near">0</variable>
            </variables>
          </group>
        </map>

        <!-- the cursor, over the squares -->
        <map name="pointer">
          <tile><width>cell</width><height>cell</height></tile>
          <position><x>left</x><y>top</y></position>
          <cells />
          <row>.........</row>
          <row>.........</row>
          <row>.........</row>
          <row>.........</row>
          <row>....c....</row>
          <row>.........</row>
          <row>.........</row>
          <row>.........</row>
          <row>.........</row>
          <object name="cursor" char="c">
            <sprite><bitmap from="frame" /></sprite>
            <actions>
              <action name="up"><hop direction="up" /></action>
              <action name="down"><hop direction="down" /></action>
              <action name="left"><hop direction="left" /></action>
              <action name="right"><hop direction="right" /></action>
              <action name="point"><track /></action>
              <action name="open"><trigger action="open" class="square"><here /></trigger><play sound="open" /></action>
              <action name="flag"><trigger action="flag" class="square"><here /></trigger><play sound="flag" /></action>
            </actions>
          </object>
        </map>
      </objects>
      <inputs>
        <input><button>w</button><button>up</button><button>pad1.up</button><trigger object="cursor" action="up" /></input>
        <input><button>s</button><button>down</button><button>pad1.down</button><trigger object="cursor" action="down" /></input>
        <input><button>a</button><button>left</button><button>pad1.left</button><trigger object="cursor" action="left" /></input>
        <input><button>d</button><button>right</button><button>pad1.right</button><trigger object="cursor" action="right" /></input>
        <input><button>space</button><button>pad1.a</button><button>mouse.left</button><trigger object="cursor" action="open" /></input>
        <input><button>f</button><button>pad1.x</button><button>mouse.right</button><trigger object="cursor" action="flag" /></input>
        <input axis="mouse.x"><trigger object="cursor" action="point" /></input>
        <input axis="mouse.y"><trigger object="cursor" action="point" /></input>
        <input><button>p</button><button>escape</button><button>pad1.start</button><push state="paused" /></input>
      </inputs>
      <conditions>
        <!-- ten mines, laid one a frame where none is yet -->
        <condition class="mine" total="count">
          <below>10</below>
          <spawn object="mine" into="mines"><free /></spawn>
        </condition>
        <condition object="status" variable="lost">
          <equal>1</equal>
          <play sound="boom" />
          <push state="lost" />
        </condition>
        <condition object="status" variable="opened">
          <atleast>71</atleast>
          <play sound="won" />
          <push state="won" />
        </condition>
      </conditions>
    </state>
    <state name="paused">
      <objects>
        <object name="paused">
          <sprite><text style="banner"><content>PAUSED</content><color>color.white</color></text></sprite>
          <position><x><centered /></x><y><centered /></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input><button>p</button><button>escape</button><button>pad1.start</button><pop /></input>
      </inputs>
    </state>
    <state name="lost">
      <objects>
        <object name="message">
          <sprite><text style="banner"><content>BOOM</content><color>color.red</color></text></sprite>
          <position><x><centered /></x><y><centered>window.bottom - 30</centered></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
        <show object="again" />
      </shows>
      <inputs>
        <input><button>space</button><button>pad1.start</button><reset /></input>
      </inputs>
    </state>
    <state name="won">
      <objects>
        <object name="message">
          <sprite><text style="banner"><content>CLEARED</content><color>color.green</color></text></sprite>
          <position><x><centered /></x><y><centered>window.bottom - 30</centered></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
        <show object="again" />
      </shows>
      <inputs>
        <input><button>space</button><button>pad1.start</button><reset /></input>
      </inputs>
    </state>
  </states>
  <sounds>
    <sound name="open"><note pitch="A5">0.02</note></sound>
    <sound name="flag"><note pitch="E5">0.03</note><note pitch="E6">0.03</note></sound>
    <sound name="boom" wave="noise"><note pitch="C3" to="C1">0.6</note></sound>
    <sound name="won"><note pitch="C5">0.1</note><note pitch="E5">0.1</note><note pitch="G5">0.1</note><note pitch="C6">0.3</note></sound>
  </sounds>
  <pictures>
    <bitmap name="frame" style="cursor">
      <row>************</row>
      <row>*..........*</row>
      <row>*..........*</row>
      <row>*..........*</row>
      <row>*..........*</row>
      <row>*..........*</row>
      <row>*..........*</row>
      <row>*..........*</row>
      <row>*..........*</row>
      <row>*..........*</row>
      <row>*..........*</row>
      <row>************</row>
    </bitmap>
  </pictures>
</game>
