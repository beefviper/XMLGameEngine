<!-- megamania.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Oct 7, 2026 -->

<!--
  Megamania, after Activision's 1982 Atari 2600 game. Your blaster slides
  along the bottom of the screen and fires up at eight waves of strange
  things that sweep across the sky and drop bombs: hamburgers, cookies, bugs,
  radial tires, diamonds, steam irons, bow ties and space dice, each worth
  more than the last. All the while your energy bar runs down; shoot the
  whole wave before it is gone, and what is left of it is a bonus. A bomb,
  anything you fly into, or running out of energy costs a blaster; three
  blasters. Clear the eight waves to win.

  A and D (or the arrows) slide, Space fires, Pause pauses.

  How it is written:
  * The eight waves are the <scenes> of the playing state. The blaster, its
    shot, the energy bar and the numbers along the top are the state's own
    objects, there in every wave. The bomb is a piece, so each wave has
    the bombs its enemies drop.
  * A wave is a <group> piece of eight, moving with one velocity and
    <wrap />ping round the sides, so the formation goes off one side and
    comes back on the other, and <bounce />ing off the top and bottom (only
    the waves that come down at a slant ever reach them). Each wave takes it
    with a picture of its own and changes its velocity; the heights of its
    two rows and what a hit scores are the wave's <variables>.
  * Each member drops bombs from under it (<facing>down</facing>, <fire>)
    on a timer of its own, every few seconds, the wait drawn again each time.
  * As on the 2600, the shot is steered: its x is update="live", worked
    out from the blaster's every frame.
  * The energy is a timer of its own object, named "level", so energy.level
    is the seconds it has left; when it goes off a blaster is lost, and a
    <reset object="energy" /> fills it again at the start of each wave and
    when a blaster is lost another way. The bar is
    drawn as a green strip with a black cover laid over it, which another
    timer slides along to where the energy has got to.
  * A wave's condition that none of it is left (a class counts the wave in
    play, not the others), named "cleared", scores the energy left and
    <enter>s its way "next". The later waves are the first (from=), so they
    have that condition too and say only where "next" leads; the last writes
    a "cleared" of its own, which takes the copied one's place and wins.
  * Paused and over draw the game still underneath (<show state>).
  * A hit blaster (or one out of energy) <spawn>s a wreck and <die>s: the wreck's burst plays
    <once /> and <then> counts the loss and <reveal>s it again. What is
    shot leaves a smaller burst, a "boom", that despawns itself.
  Not in it: the waves coming round again faster after the eighth, and a
  blaster for every 10,000 points.
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../xgedef.xsd">
  <window name="Megamania">
    <width>640</width>
    <height>480</height>
  </window>
  <variables>
    <variable name="margin">10</variable>
    <variable name="slide">4</variable>
    <!-- a member of a wave drops a bomb every drop - 1 to drop + 2 seconds -->
    <variable name="drop">3</variable>
    <!-- the energy bar: seconds of energy, and how wide it is drawn -->
    <variable name="full">45</variable>
    <variable name="barwidth">360</variable>
    <variable name="barleft">
      <subtract>
        <value>window.width.center</value>
        <value><divide><value>barwidth</value><value>2</value></divide></value>
      </subtract>
    </variable>
  </variables>
  <styles>
    <style name="banner"><size>100</size><color>color.orange</color></style>
    <style name="line"><size>24</size><color>color.white</color></style>
    <style name="prompt"><size>40</size></style>
    <style name="hud"><size>28</size><color>color.yellow</color></style>
  </styles>
  <objects>
    <!-- one shot at a time, steered with the blaster -->
    <object name="laser" class="laser">
      <sprite><rectangle><width>3</width><height>14</height><color>color.cyan</color></rectangle></sprite>
      <position><x update="live"><add><value>player.x</value><value>16.5</value></add></x><y>0</y></position>
      <velocity><y>-9</y></velocity>
      <most>1</most>
      <collisions>
        <collision edge="all"><despawn /></collision>
        <collision class="enemy"><despawn /></collision>
      </collisions>
    </object>
    <group name="enemies" class="enemy">
      <sprite>
        <bitmap from="wave1" />
      </sprite>
      <velocity><x>2</x></velocity>
      <facing>down</facing>
      <collisions>
        <collision edge="horizontal"><wrap /></collision>
        <collision edge="vertical"><bounce /></collision>
        <collision object="laser">
          <inc variable="player.score">points</inc>
          <play sound="hit" />
          <die />
          <spawn object="boom" />
        </collision>
      </collisions>
      <timers>
        <timer><every><random><min><subtract><value>drop</value><value>1</value></subtract></min><max><add><value>drop</value><value>2</value></add></max></random></every><fire object="bomb" /></timer>
      </timers>
      <member><position><x>40</x><y>row1</y></position></member>
      <member><position><x>200</x><y>row1</y></position></member>
      <member><position><x>360</x><y>row1</y></position></member>
      <member><position><x>520</x><y>row1</y></position></member>
      <member><position><x>120</x><y>row2</y></position></member>
      <member><position><x>280</x><y>row2</y></position></member>
      <member><position><x>440</x><y>row2</y></position></member>
      <member><position><x>600</x><y>row2</y></position></member>
    </group>
    <!-- a bomb: six at most -->
    <object name="bomb" class="bomb">
      <sprite><rectangle><width>4</width><height>10</height><color>color.red</color></rectangle></sprite>
      <velocity><y>4</y></velocity>
      <most>6</most>
      <collisions>
        <collision edge="all"><despawn /></collision>
        <collision object="player"><despawn /></collision>
      </collisions>
    </object>
    <!-- what a hit enemy leaves: a burst that grows and scatters -->
    <object name="boom">
      <sprite name="a"><bitmap from="burst-a" /></sprite>
      <sprite name="b"><bitmap from="burst-b" /></sprite>
      <sprite name="c"><bitmap from="burst-c" /></sprite>
      <sprite name="d"><bitmap from="burst-d" /></sprite>
      <animation>
        <seconds>0.07</seconds>
        <once />
        <frame sprite="a" />
        <frame sprite="b" />
        <frame sprite="c" />
        <frame sprite="d" />
        <then><despawn /></then>
      </animation>
      <most>8</most>
    </object>
    <!-- the blaster hit or out of energy: it bursts, and only then is it lost -->
    <object name="wreck">
      <sprite name="a"><bitmap from="burst-a" /></sprite>
      <sprite name="b"><bitmap from="burst-b" /></sprite>
      <sprite name="c"><bitmap from="burst-c" /></sprite>
      <sprite name="d"><bitmap from="burst-d" /></sprite>
      <animation>
        <seconds>0.15</seconds>
        <once />
        <frame sprite="a" />
        <frame sprite="b" />
        <frame sprite="c" />
        <frame sprite="b" />
        <frame sprite="c" />
        <frame sprite="d"><seconds>0.4</seconds></frame>
        <then>
          <dec variable="player.lives" />
          <despawn object="bomb" />
          <reset object="energy" />
          <reveal object="player" />
          <despawn />
        </then>
      </animation>
      <most>1</most>
    </object>
  </objects>
  <states>
    <objects>
      <!-- after a game, in both endings -->
      <object name="again">
        <sprite><text style="prompt"><content>spacebar to play again</content></text></sprite>
        <position><x><centered /></x><y><centered><offset>70</offset></centered></y></position>
      </object>
    </objects>
    <state name="title">
      <objects>
        <object name="title">
          <sprite><text style="banner"><content>MEGAMANIA</content></text></sprite>
          <position><x><centered /></x><y><centered><offset>-140</offset></centered></y></position>
        </object>
        <group name="help">
          <rows>2</rows>
          <padding><y>50</y></padding>
          <sprite><text style="line" /></sprite>
          <position><x><centered /></x><y><centered><offset>-40</offset></centered></y></position>
          <row number="1"><sprite><text><content>shoot every wave before your energy runs out</content></text></sprite></row>
          <row number="2"><sprite><text><content>a and d (or the arrows) slide, space fires</content><color>color.lightgrey</color></text></sprite></row>
        </group>
        <object name="start">
          <sprite><text style="prompt"><content>spacebar to start</content></text></sprite>
          <position><x><centered /></x><y><centered><offset>110</offset></centered></y></position>
        </object>
      </objects>
      <inputs>
        <input button="space"><push state="playing" /><play sound="wave" /></input>
      </inputs>
    </state>

    <state name="playing">
      <objects>
        <!-- the blaster -->
        <object name="player" class="player">
          <sprite>
            <bitmap from="player" />
          </sprite>
          <position><x><centered /></x><y><bottom><offset>40</offset></bottom></y></position>
          <collisions>
            <!-- touched by its body, not the wingtips and the thin nose -->
            <hitbox><horizontal>3</horizontal><top>6</top></hitbox>
            <collision edge="horizontal"><stick /></collision>
            <collision class="bomb"><trigger action="lose" /></collision>
            <collision class="enemy"><trigger action="lose" /></collision>
          </collisions>
          <actions>
            <!-- out of play while its wreck bursts -->
            <action name="lose">
              <spawn object="wreck" />
              <play sound="lost" />
              <die />
            </action>
            <action name="left"><move direction="left">slide</move></action>
            <action name="right"><move direction="right">slide</move></action>
            <action name="fire"><fire object="laser" /><play sound="fire" /></action>
          </actions>
          <variables>
            <variable name="score">0</variable>
            <variable name="lives">3</variable>
          </variables>
        </object>

        <!-- the energy that runs down, and its bar: a green strip, and a black
             cover over what is spent -->
        <object name="energy">
          <timers>
            <!-- out of energy: a blaster lost, and the energy filled again -->
            <timer name="level">
              <after>full</after>
              <trigger object="player" action="lose" />
            </timer>
          </timers>
        </object>
        <object name="bar">
          <sprite><rectangle><width>barwidth</width><height>12</height><color>color.green</color></rectangle></sprite>
          <position><x>barleft</x><y><subtract><value>window.bottom</value><value>24</value></subtract></y></position>
        </object>
        <object name="cover">
          <sprite><rectangle><width>barwidth</width><height>12</height><color>color.black</color></rectangle></sprite>
          <position><x><add><value>barleft</value><value>barwidth</value></add></x><y><subtract><value>window.bottom</value><value>24</value></subtract></y></position>
        </object>

        <object name="score">
          <sprite><text style="hud"><number>player.score</number></text></sprite>
          <position><x>margin</x><y>margin</y></position>
        </object>
        <object name="lives">
          <sprite><text style="hud"><number>player.lives</number><color>color.red</color></text></sprite>
          <position><x><right><offset>margin</offset></right></x><y>margin</y></position>
        </object>
      </objects>
      <scenes>

        <!-- hamburgers, crossing straight over -->
        <scene name="wave1">
          <ways><way name="next" scene="wave2" /></ways>
          <variables>
            <variable name="row1">80</variable>
            <variable name="row2">150</variable>
            <variable name="points">20</variable>
          </variables>
          <objects>
            <group name="enemies" />
          </objects>
          <conditions>
            <condition name="cleared" class="enemy">
              <remaining>0</remaining>
              <inc variable="player.score"><multiply><value>energy.level</value><value>10</value></multiply></inc>
              <play sound="wave" />
              <reset object="energy" />
              <despawn object="bomb" />
              <despawn object="laser" />
              <enter way="next" />
            </condition>
          </conditions>
        </scene>

        <!-- cookies, coming down at a slant and bouncing back up -->
        <scene name="wave2" from="wave1">
          <ways><way name="next" scene="wave3" /></ways>
          <variables>
            <variable name="row1">60</variable>
            <variable name="row2">140</variable>
            <variable name="points">30</variable>
          </variables>
          <objects>
            <group name="enemies">
              <sprite>
                <bitmap from="wave2" />
              </sprite>
              <velocity><y>1</y></velocity>
            </group>
          </objects>
        </scene>

        <!-- bugs, rushing the other way -->
        <scene name="wave3" from="wave1">
          <ways><way name="next" scene="wave4" /></ways>
          <variables>
            <variable name="row1">90</variable>
            <variable name="row2">170</variable>
            <variable name="points">40</variable>
          </variables>
          <objects>
            <group name="enemies">
              <sprite>
                <bitmap from="wave3" />
              </sprite>
              <velocity><x>-3</x></velocity>
            </group>
          </objects>
        </scene>

        <!-- radial tires, rolling down at a slant -->
        <scene name="wave4" from="wave1">
          <ways><way name="next" scene="wave5" /></ways>
          <variables>
            <variable name="row1">60</variable>
            <variable name="row2">130</variable>
            <variable name="points">50</variable>
          </variables>
          <objects>
            <group name="enemies">
              <sprite>
                <bitmap from="wave4" />
              </sprite>
              <velocity><x>3</x><y>2</y></velocity>
            </group>
          </objects>
        </scene>
        <!-- diamonds, weaving back the other way -->
        <scene name="wave5" from="wave1">
          <ways><way name="next" scene="wave6" /></ways>
          <variables>
            <variable name="row1">70</variable>
            <variable name="row2">140</variable>
            <variable name="points">60</variable>
          </variables>
          <objects>
            <group name="enemies">
              <sprite>
                <bitmap from="wave5" />
              </sprite>
              <velocity><x>-3</x><y>1.5</y></velocity>
            </group>
          </objects>
        </scene>
        <!-- steam irons, pressing straight across -->
        <scene name="wave6" from="wave1">
          <ways><way name="next" scene="wave7" /></ways>
          <variables>
            <variable name="row1">90</variable>
            <variable name="row2">160</variable>
            <variable name="points">70</variable>
          </variables>
          <objects>
            <group name="enemies">
              <sprite>
                <bitmap from="wave6" />
              </sprite>
              <velocity><x>4</x><y>0</y></velocity>
            </group>
          </objects>
        </scene>
        <!-- bow ties, flapping down and up -->
        <scene name="wave7" from="wave1">
          <ways><way name="next" scene="wave8" /></ways>
          <variables>
            <variable name="row1">60</variable>
            <variable name="row2">130</variable>
            <variable name="points">80</variable>
          </variables>
          <objects>
            <group name="enemies">
              <sprite>
                <bitmap from="wave7" />
              </sprite>
              <velocity><x>-3</x><y>2.5</y></velocity>
            </group>
          </objects>
        </scene>
        <!-- space dice, tumbling fast -->
        <scene name="wave8" from="wave1">
          <variables>
            <variable name="row1">70</variable>
            <variable name="row2">150</variable>
            <variable name="points">90</variable>
          </variables>
          <objects>
            <group name="enemies">
              <sprite>
                <bitmap from="wave8" />
              </sprite>
              <velocity><x>4</x><y>2</y></velocity>
            </group>
          </objects>
          <conditions>
            <condition name="cleared" class="enemy">
              <remaining>0</remaining>
              <inc variable="player.score"><multiply><value>energy.level</value><value>10</value></multiply></inc>
              <play sound="wave" />
              <become object="over.message" sprite="won" />
              <push state="over" />
            </condition>
          </conditions>
        </scene>
      </scenes>
      <inputs>
        <input><button>a</button><button>left</button><trigger object="player" action="left" /></input>
        <input><button>d</button><button>right</button><trigger object="player" action="right" /></input>
        <input button="space"><trigger object="player" action="fire" /></input>
        <input><button>pause</button><button>pad1.start</button><push state="paused" /></input>
      </inputs>
      <conditions>
        <!-- out of blasters -->
        <condition object="player" variable="lives">
          <atmost>0</atmost>
          <become object="over.message" sprite="lost" />
          <push state="over" />
        </condition>
      </conditions>
      <timers>
        <timer><every>0.1</every><set variable="cover.x">
          <add>
            <value>barleft</value>
            <value>
              <divide>
                <value><multiply><value>barwidth</value><value>energy.level</value></multiply></value>
                <value>full</value>
              </divide>
            </value>
          </add>
        </set></timer>
      </timers>
    </state>

    <state name="paused">
      <objects>
        <object name="paused">
          <sprite><text style="banner"><content>PAUSED</content><color>color.white</color></text></sprite>
          <position><x><centered /></x><y><centered /></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input><button>pause</button><button>pad1.start</button><pop /></input>
      </inputs>
    </state>

    <state name="over">
      <objects>
        <object name="message">
          <sprite name="won"><text style="banner"><content>YOU WIN</content><color>color.green</color></text></sprite>
          <sprite name="lost"><text style="banner"><content>GAME OVER</content><color>color.red</color></text></sprite>
          <position><x><centered /></x><y><centered><offset>-60</offset></centered></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
        <show object="again" />
      </shows>
      <inputs>
        <input button="space"><reset /></input>
      </inputs>
    </state>

  </states>
  <sounds>
    <sound name="fire" wave="square"><volume>0.15</volume><note pitch="E6" to="E5">0.07</note></sound>
    <sound name="hit" wave="noise"><volume>0.3</volume><note pitch="3000" to="300">0.25</note></sound>
    <sound name="lost" wave="noise"><volume>0.45</volume><note pitch="2000" to="80">0.8</note></sound>
    <sound name="wave" wave="square">
      <volume>0.2</volume>
      <note pitch="C5">0.08</note>
      <note pitch="E5">0.08</note>
      <note pitch="G5">0.08</note>
      <note pitch="C6">0.2</note>
    </sound>
  </sounds>
  <pictures>
    <!-- a burst, four pictures: a flash, a ball, its pieces flying, the last sparks -->
    <bitmap name="burst-a">
      <row>.........</row>
      <row>.........</row>
      <row>....*....</row>
      <row>...*o*...</row>
      <row>..*ooo*..</row>
      <row>...*o*...</row>
      <row>....*....</row>
      <row>.........</row>
      <row>.........</row>
      <scale>3</scale>
      <color>color.yellow</color>
      <color char="o">color.red</color>
    </bitmap>
    <bitmap name="burst-b">
      <row>.........</row>
      <row>..*...*..</row>
      <row>...*o*...</row>
      <row>..*ooo*..</row>
      <row>.*oo.oo*.</row>
      <row>..*ooo*..</row>
      <row>...*o*...</row>
      <row>..*...*..</row>
      <row>.........</row>
      <scale>3</scale>
      <color>color.yellow</color>
      <color char="o">color.red</color>
    </bitmap>
    <bitmap name="burst-c">
      <row>*...*...*</row>
      <row>.*.....*.</row>
      <row>...o.o...</row>
      <row>..o...o..</row>
      <row>*.......*</row>
      <row>..o...o..</row>
      <row>...o.o...</row>
      <row>.*.....*.</row>
      <row>*...*...*</row>
      <scale>3</scale>
      <color>color.yellow</color>
      <color char="o">color.red</color>
    </bitmap>
    <bitmap name="burst-d">
      <row>o.......o</row>
      <row>.........</row>
      <row>.........</row>
      <row>.........</row>
      <row>....o....</row>
      <row>.........</row>
      <row>.........</row>
      <row>.........</row>
      <row>o.......o</row>
      <scale>3</scale>
      <color>color.red</color>
      <color char="o">color.red</color>
    </bitmap>
    <bitmap name="wave1">
      <row>..******..</row>
      <row>.********.</row>
      <row>**********</row>
      <row>..........</row>
      <row>**********</row>
      <row>.********.</row>
      <scale>3</scale>
      <color>color.orange</color>
    </bitmap>
    <bitmap name="player">
      <row>.....**.....</row>
      <row>.....**.....</row>
      <row>....****....</row>
      <row>.**.****.**.</row>
      <row>************</row>
      <row>************</row>
      <row>**...**...**</row>
      <scale>3</scale>
      <color>color.lightgrey</color>
    </bitmap>
    <bitmap name="wave2">
      <row>..****..</row>
      <row>.**.***.</row>
      <row>****.***</row>
      <row>*.******</row>
      <row>***.**.*</row>
      <row>.******.</row>
      <row>..****..</row>
      <scale>3</scale>
      <color>color.yellow</color>
    </bitmap>
    <bitmap name="wave3">
      <row>*..*..*..*</row>
      <row>.*.****.*.</row>
      <row>..******..</row>
      <row>.********.</row>
      <row>*.*....*.*</row>
      <scale>3</scale>
      <color>color.green</color>
    </bitmap>
    <bitmap name="wave4">
      <row>..****..</row>
      <row>.*.**.*.</row>
      <row>**.**.**</row>
      <row>********</row>
      <row>**.**.**</row>
      <row>.*.**.*.</row>
      <row>..****..</row>
      <scale>3</scale>
      <color>color.lightgrey</color>
    </bitmap>
    <bitmap name="wave5">
      <row>....*....</row>
      <row>...***...</row>
      <row>..*****..</row>
      <row>.*******.</row>
      <row>..*****..</row>
      <row>...***...</row>
      <row>....*....</row>
      <scale>3</scale>
      <color>color.cyan</color>
    </bitmap>
    <bitmap name="wave6">
      <row>....******</row>
      <row>...*******</row>
      <row>..********</row>
      <row>.*********</row>
      <row>**********</row>
      <row>**********</row>
      <scale>3</scale>
      <color>color.lightgrey</color>
    </bitmap>
    <bitmap name="wave7">
      <row>**......**</row>
      <row>****..****</row>
      <row>**********</row>
      <row>****..****</row>
      <row>**......**</row>
      <scale>3</scale>
      <color>color.magenta</color>
    </bitmap>
    <bitmap name="wave8">
      <row>*********</row>
      <row>*.*****.*</row>
      <row>*********</row>
      <row>****.****</row>
      <row>*********</row>
      <row>*.*****.*</row>
      <row>*********</row>
      <scale>3</scale>
      <color>color.white</color>
    </bitmap>
  </pictures>
</game>
