<!-- yarsrevenge.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Oct 17, 2026 -->

<!--
  After Howard Scott Warshaw's Yars' Revenge for the Atari 2600: Yar, a fly,
  nibbles through the shield around the Qotile while the Qotile's destroyer
  missile homes in on him. A bite of the shield, or a touch of the Qotile,
  brings the Zorlon cannon to the left edge, where it follows Yar up and
  down; Space fires it across the screen. Get a shot through the gap into
  the Qotile. Now and then the Qotile becomes the Swirl and flies at Yar;
  shoot it in flight for 6000. The flickering neutral zone down the middle
  is safe from the missile. Yar flies off the top and comes in at the bottom.

  W A S D or the arrows fly Yar (two at once go diagonally), Space fires
  his energy missile the way he last flew, and the cannon when it is there,
  Pause pauses, Space starts and plays again.

  How it is written:
  * The shield is a <map>: the cells are drawn as the shape they make, with
    the Qotile in its cup as the map's one Q. Cells and Qotile go up and
    down at the same speed and turn round on the same timer, so they keep
    together; <reset object="shield" /> puts the whole map back.
  * The destroyer missile has a <seek object="yar">; Yar's rule about it
    has unless="zone", so in the zone it does nothing.
  * The cannon is out of play until a bite <reveal>s it; its y is
    update="live", level with Yar's every frame, and its action fires the blast and puts it away.
    An object out of play does not act on a key, so Space without the
    cannon fires only Yar's missile.
  * The Swirl does not exist until the Qotile <spawn>s it where it is
    (one at a time: <most>1</most>); it waits, then <chase>s where Yar is
    at that moment, in a straight line, and <despawn>s at an edge or hit.
  * The neutral zone is a column of bands, each an <animation> of two
    bitmaps of colors; the even bands run it the other way round.
  Not in it: the ghost of Yar, the Qotile's ion zone colors, Yar bouncing
  off the shield, the cannon hitting Yar, the levels getting harder.
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../xgedef.xsd">
  <window name="Yars' Revenge">
    <width>800</width>
    <height>600</height>
  </window>
  <variables>
    <variable name="fly">3</variable>
    <variable name="sway">1</variable>
    <variable name="turnround">6</variable>
  </variables>
  <styles>
    <style name="banner"><size>90</size><color>color.green</color></style>
    <style name="help"><size>28</size><color>color.white</color></style>
    <style name="hud"><size>32</size><color>color.white</color></style>
    <style name="zone">
      <scale>20</scale>
      <color char="r">color.red</color>
      <color char="g">color.green</color>
      <color char="b">color.blue</color>
      <color char="m">color.magenta</color>
      <color char="y">color.yellow</color>
    </style>
  </styles>
  <objects>
    <!-- the Zorlon cannon's blast, straight across -->
    <object name="blast">
      <sprite><rectangle><width>24</width><height>10</height><color>color.yellow</color></rectangle></sprite>
      <velocity><x>8</x><y>0</y></velocity>
      <most>1</most>
      <collisions>
        <collision edge="right"><despawn /></collision>
        <collision class="shield"><despawn /></collision>
        <collision object="qotile"><despawn /></collision>
        <collision object="swirl"><despawn /></collision>
      </collisions>
    </object>
    <!-- Yar's energy missile: one at a time, the way he last flew -->
    <object name="energy">
      <sprite><rectangle><width>6</width><height>4</height><color>color.white</color></rectangle></sprite>
      <velocity><x>7</x><y>0</y></velocity>
      <most>1</most>
      <collisions>
        <collision edge="all"><despawn /></collision>
        <collision class="shield"><despawn /></collision>
      </collisions>
    </object>
    <!-- the Swirl: a spinning Qotile that waits a moment, then flies at where Yar is -->
    <object name="swirl">
      <sprite name="one">
        <bitmap from="swirl-one" />
      </sprite>
      <sprite name="two">
        <bitmap from="swirl-two" />
      </sprite>
      <animation>
        <seconds>0.06</seconds>
        <frame sprite="one" />
        <frame sprite="two" />
      </animation>
      <most>1</most>
      <collisions>
        <type>pixel</type>
        <collision edge="all"><despawn /></collision>
        <collision object="blast">
          <inc variable="player.score">6000</inc>
          <play sound="boom" />
          <despawn />
        </collision>
      </collisions>
      <timers>
        <timer><after>1</after><chase object="yar">4</chase></timer>
      </timers>
    </object>
  </objects>
  <states>
    <state name="title">
      <objects>
        <object name="title">
          <sprite><text style="banner"><content>YARS' REVENGE</content></text></sprite>
          <position><x><centered /></x><y><centered><offset>-140</offset></centered></y></position>
        </object>
        <group name="help">
          <rows>2</rows>
          <padding><y>50</y></padding>
          <sprite><text style="help" /></sprite>
          <position><x><centered /></x><y><centered><offset>-40</offset></centered></y></position>
          <row number="1"><sprite><text><content>eat through the shield, then fire the cannon into the qotile</content></text></sprite></row>
          <row number="2"><sprite><text><content>w a s d or the arrows fly, space fires, pause key pauses</content><color>color.lightgrey</color></text></sprite></row>
        </group>
        <object name="start">
          <sprite><text style="help"><content>spacebar to start</content><size>40</size></text></sprite>
          <position><x><centered /></x><y><centered><offset>110</offset></centered></y></position>
        </object>
      </objects>
      <inputs>
        <input button="space"><push state="playing" /></input>
      </inputs>
    </state>
    <state name="playing">
      <objects>
        <!-- the neutral zone, drawn first so everything goes over it -->
        <group name="zone" class="zone">
          <columns>1</columns>
          <rows>10</rows>
          <sprite name="a">
            <bitmap from="zone-a" />
          </sprite>
          <sprite name="b">
            <bitmap from="zone-b" />
          </sprite>
          <animation>
            <seconds>0.05</seconds>
            <frame sprite="a" />
            <frame sprite="b" />
          </animation>
          <position><x>300</x><y>0</y></position>
          <collisions />
          <row><even />
            <animation>
              <seconds>0.05</seconds>
              <frame sprite="b" />
              <frame sprite="a" />
            </animation>
          </row>
        </group>
        <object name="player">
          <variables>
            <variable name="score">0</variable>
            <variable name="lives">4</variable>
          </variables>
        </object>
        <object name="score">
          <sprite><text style="hud"><number>player.score</number></text></sprite>
          <position><x>40</x><y>12</y></position>
        </object>
        <object name="lives">
          <sprite><text style="hud"><content>YARS </content><number>player.lives</number></text></sprite>
          <position><x><right><offset>40</offset></right></x><y>12</y></position>
        </object>
        <!-- the shield, in the shape it is, and the Qotile in its cup -->
        <map name="shield">
          <tile><width>12</width><height>14</height></tile>
          <position><x>668</x><y>60</y></position>
          <row>....######</row>
          <row>..########</row>
          <row>.####.....</row>
          <row>.###......</row>
          <row>###.......</row>
          <row>###...Q...</row>
          <row>###.......</row>
          <row>.###......</row>
          <row>.####.....</row>
          <row>..########</row>
          <row>....######</row>
          <group name="cells" char="#" class="shield">
            <sprite><rectangle><width>11</width><height>13</height><color>color.orange</color></rectangle></sprite>
            <velocity><x>0</x><y>sway</y></velocity>
            <collisions>
              <collision object="yar">
                <inc variable="player.score">69</inc>
                <play sound="nibble" />
                <reveal object="cannon" />
                <die />
              </collision>
              <collision object="energy"><die /></collision>
              <collision object="blast"><die /></collision>
            </collisions>
            <timers>
              <timer><every>turnround</every><reverse /></timer>
            </timers>
          </group>
          <object name="qotile" char="Q">
            <sprite>
              <bitmap from="qotile" />
            </sprite>
            <velocity><x>0</x><y>sway</y></velocity>
            <collisions>
              <collision object="blast">
                <inc variable="player.score">1000</inc>
                <play sound="boom" />
                <die />
              </collision>
            </collisions>
            <timers>
              <timer><every>turnround</every><reverse /></timer>
              <timer>
                <every><random><min>5</min><max>9</max></random></every>
                <spawn object="swirl"><position><x>qotile.x</x><y>qotile.y</y></position></spawn>
                <play sound="swirl" />
              </timer>
            </timers>
          </object>
        </map>
        <object name="yar">
          <sprite name="up">
            <bitmap from="yar-up" />
          </sprite>
          <sprite name="down">
            <bitmap from="yar-down" />
          </sprite>
          <animation>
            <seconds>0.08</seconds>
            <frame sprite="up" />
            <frame sprite="down" />
          </animation>
          <position><x>60</x><y>288</y></position>
          <facing>right</facing>
          <collisions>
            <collision edge="horizontal"><stick /></collision>
            <collision edge="vertical"><wrap /></collision>
            <collision object="qotile"><reveal object="cannon" /></collision>
            <collision object="missile" unless="zone">
              <dec variable="player.lives" />
              <play sound="hit" />
              <reset />
              <reset object="missile" />
            </collision>
            <collision object="swirl">
              <dec variable="player.lives" />
              <play sound="hit" />
              <reset />
              <reset object="missile" />
              <reset object="swirl" />
            </collision>
          </collisions>
          <actions>
            <action name="up"><move direction="up">fly</move></action>
            <action name="down"><move direction="down">fly</move></action>
            <action name="left"><move direction="left">fly</move></action>
            <action name="right"><move direction="right">fly</move></action>
            <action name="fire">
              <fire object="energy" />
              <play sound="shoot" />
            </action>
          </actions>
        </object>
        <!-- the destroyer missile: always turning toward Yar -->
        <object name="missile">
          <sprite><rectangle><width>6</width><height>6</height><color>color.white</color></rectangle></sprite>
          <position><x>700</x><y>296</y></position>
          <velocity><x>-1.6</x><y>0</y></velocity>
          <seek object="yar">2</seek>
          <collisions />
        </object>
        <!-- the Zorlon cannon at the left edge, level with Yar while it is there -->
        <object name="cannon">
          <sprite>
            <bitmap from="cannon" />
          </sprite>
          <position><x>0</x><y update="live"><add><value>yar.y</value><value>4</value></add></y></position>
          <facing>right</facing>
          <waiting />
          <actions>
            <action name="fire">
              <fire object="blast" />
              <play sound="cannon" />
              <die />
            </action>
          </actions>
        </object>
      </objects>
      <music sound="hum" />
      <inputs>
        <input><button>w</button><button>up</button><trigger object="yar" action="up" /></input>
        <input><button>s</button><button>down</button><trigger object="yar" action="down" /></input>
        <input><button>a</button><button>left</button><trigger object="yar" action="left" /></input>
        <input><button>d</button><button>right</button><trigger object="yar" action="right" /></input>
        <input button="space">
          <trigger object="cannon" action="fire" />
          <trigger object="yar" action="fire" />
        </input>
        <input><button>pause</button><button>pad1.start</button><push state="paused" /></input>
      </inputs>
      <conditions>
        <condition object="player" variable="lives">
          <atmost>0</atmost>
          <push state="over" />
        </condition>
        <condition object="qotile">
          <remaining>0</remaining>
          <push state="destroyed" />
        </condition>
      </conditions>
    </state>
    <state name="paused">
      <objects>
        <object name="paused">
          <sprite><text style="banner"><content>PAUSED</content><color>color.white</color></text></sprite>
          <position><x><centered /></x><y><centered /></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input><button>pause</button><button>pad1.start</button><pop /></input>
      </inputs>
    </state>
    <!-- the Qotile hit: a moment to see it, then the shield is back whole -->
    <state name="destroyed">
      <objects>
        <object name="message">
          <sprite><text style="banner"><content>QOTILE DESTROYED</content><size>70</size></text></sprite>
          <position><x><centered /></x><y><centered><offset>-60</offset></centered></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input><button>pause</button><button>pad1.start</button><push state="paused" /></input>
      </inputs>
      <timers>
        <timer>
          <every>2</every>
          <reset object="shield" />
          <reset object="missile" />
          <reset object="swirl" />
          <reset object="yar" />
          <pop />
        </timer>
      </timers>
    </state>
    <state name="over">
      <objects>
        <object name="message">
          <sprite><text style="banner"><content>GAME OVER</content><color>color.red</color></text></sprite>
          <position><x><centered /></x><y><centered><offset>-60</offset></centered></y></position>
        </object>
        <object name="again">
          <sprite><text style="help"><content>spacebar to play again</content><size>40</size></text></sprite>
          <position><x><centered /></x><y><centered><offset>70</offset></centered></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input button="space"><reset /></input>
      </inputs>
    </state>
  </states>
  <sounds>
    <!-- the low buzz the game makes all the while -->
    <sound name="hum" wave="noise">
      <loop />
      <volume>0.05</volume>
      <note pitch="90">1</note>
    </sound>
    <sound name="nibble" wave="square">
      <volume>0.2</volume>
      <note pitch="G5">0.03</note>
    </sound>
    <sound name="shoot" wave="square">
      <volume>0.15</volume>
      <note pitch="C6" to="C5">0.06</note>
    </sound>
    <sound name="cannon" wave="noise">
      <volume>0.3</volume>
      <note pitch="900" to="200">0.3</note>
    </sound>
    <sound name="swirl" wave="sawtooth">
      <volume>0.2</volume>
      <note pitch="C3" to="C6">0.5</note>
    </sound>
    <sound name="hit" wave="triangle">
      <volume>0.4</volume>
      <note pitch="C5" to="C2">0.4</note>
    </sound>
    <sound name="boom" wave="noise">
      <volume>0.5</volume>
      <note pitch="2000" to="60">1.5</note>
    </sound>
  </sounds>
  <pictures>
    <bitmap name="swirl-one">
      <row>..**....</row>
      <row>...**...</row>
      <row>*...**.*</row>
      <row>**.**.**</row>
      <row>**.**.**</row>
      <row>*.**...*</row>
      <row>...**...</row>
      <row>....**..</row>
      <scale>3</scale>
      <color>color.magenta</color>
    </bitmap>
    <bitmap name="swirl-two">
      <row>....**..</row>
      <row>...**...</row>
      <row>*.**...*</row>
      <row>**.**.**</row>
      <row>**.**.**</row>
      <row>*...**.*</row>
      <row>...**...</row>
      <row>..**....</row>
      <scale>3</scale>
      <color>color.magenta</color>
    </bitmap>
    <bitmap name="zone-a" style="zone">
      <row>rbgm</row>
      <row>gmrb</row>
      <row>bryg</row>
    </bitmap>
    <bitmap name="zone-b" style="zone">
      <row>ygbr</row>
      <row>rbmg</row>
      <row>gmrb</row>
    </bitmap>
    <bitmap name="qotile">
      <row>..****..</row>
      <row>.******.</row>
      <row>**.**.**</row>
      <row>********</row>
      <row>.*.**.*.</row>
      <row>*......*</row>
      <scale>4</scale>
      <color>color.red</color>
    </bitmap>
    <bitmap name="yar-up">
      <row>**....**</row>
      <row>.**..**.</row>
      <row>..****..</row>
      <row>.*****o.</row>
      <row>..****..</row>
      <row>...**...</row>
      <row>..*..*..</row>
      <row>........</row>
      <scale>3</scale>
      <color>color.green</color>
      <color char="o">color.white</color>
    </bitmap>
    <bitmap name="yar-down">
      <row>........</row>
      <row>........</row>
      <row>..****..</row>
      <row>******o*</row>
      <row>..****..</row>
      <row>.**..**.</row>
      <row>**....**</row>
      <row>........</row>
      <scale>3</scale>
      <color>color.green</color>
      <color char="o">color.white</color>
    </bitmap>
    <bitmap name="cannon">
      <row>****....</row>
      <row>********</row>
      <row>********</row>
      <row>****....</row>
      <scale>4</scale>
      <color>color.yellow</color>
    </bitmap>
  </pictures>
</game>
