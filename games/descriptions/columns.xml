<!-- columns.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Oct 31, 2026 -->

<!--
  Columns, after Jay Geertsen's 1989 game: a column of three jewels falls
  into a well six cells wide and thirteen deep. Three or more alike in a
  line, across, down or on a slant, vanish, and the jewels above drop into
  the gaps, which can make new lines: a chain. Every ten lines the jewels
  fall faster. The game is over when a new column has no room to come in.

  A and D or the arrows move the column; W, Up, X or Space cycles its
  jewels (each one down, the bottom one to the top); S or Down drops it
  faster while held. P or Escape pauses; Space starts and plays again.

  How it is written:
  * The well is a <map> of <cells />, as Tetris's is. The jewels are one
    group picking the character j, with a group inside for each colour:
    a cell of j in a shape is any one of them, at random.
  * The column is a <shape> of three j cells; <cycle /> moves its jewels
    round. Landing is a refused hop down, as in Tetris.
  * The well's <line> check finds every line of three or more alike at
    once; <clear /> takes them, <fall /> drops what is left onto what is
    under it, and the check is asked again until no line is left.
  * The next column waits in a second map, only shown, until it is sent in.
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../xgedef.xsd">
  <window name="Columns">
    <width>640</width>
    <height>640</height>
  </window>
  <variables>
    <variable name="cell">40</variable>
    <variable name="left">80</variable>
    <variable name="top">60</variable>
    <variable name="panel">420</variable>
  </variables>
  <sounds>
    <sound name="cycle"><note pitch="A5">0.02</note></sound>
    <sound name="land" wave="triangle"><note pitch="D3">0.06</note></sound>
    <sound name="match">
      <note pitch="E5">0.04</note>
      <note pitch="A5">0.04</note>
      <note pitch="E6">0.08</note>
    </sound>
    <sound name="over" wave="triangle">
      <note pitch="A4" to="A1">0.9</note>
    </sound>
  </sounds>
  <styles>
    <style name="banner"><size>88</size><color>color.yellow</color></style>
    <style name="prompt"><size>32</size></style>
    <style name="help"><size>22</size><color>color.lightgrey</color></style>
    <style name="label"><size>24</size><color>color.lightgrey</color></style>
    <style name="hud"><size>40</size></style>
  </styles>
  <objects>
    <object name="again">
      <sprite><text style="prompt"><content>spacebar to play again</content></text></sprite>
      <position><x><centered /></x><y><centered>window.height.center + 70</centered></y></position>
    </object>
  </objects>
  <states>
    <state name="title">
      <objects>
        <object name="title">
          <sprite><text style="banner"><content>COLUMNS</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 140</centered></y></position>
        </object>
        <object name="move">
          <sprite><text style="help"><content>a and d or the arrows move, w, x or spacebar cycles the jewels</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 20</centered></y></position>
        </object>
        <object name="drop">
          <sprite><text style="help"><content>s or down drops faster, p pauses</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center + 16</centered></y></position>
        </object>
        <object name="start">
          <sprite><text style="prompt"><content>spacebar to start</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center + 110</centered></y></position>
        </object>
      </objects>
      <inputs>
        <input><button>space</button><button>pad1.start</button><push state="playing" /></input>
      </inputs>
    </state>
    <state name="playing">
      <objects>
        <object name="status">
          <variables>
            <variable name="score">0</variable>
            <variable name="lines">0</variable>
            <variable name="level">1</variable>
            <variable name="next">10</variable>
            <variable name="gravity">0.8</variable>
            <variable name="over">0</variable>
          </variables>
        </object>
        <object name="frame">
          <sprite><rectangle><width>6 * cell + 8</width><height>13 * cell + 8</height><color>color.darkgrey</color></rectangle></sprite>
          <position><x>left - 4</x><y>top - 4</y></position>
        </object>
        <object name="well">
          <sprite><rectangle><width>6 * cell</width><height>13 * cell</height><color>color.black</color></rectangle></sprite>
          <position><x>left</x><y>top</y></position>
        </object>
        <object name="scorelabel">
          <sprite><text style="label"><content>SCORE</content></text></sprite>
          <position><x>panel</x><y>top</y></position>
        </object>
        <object name="score">
          <sprite><text style="hud"><number>status.score</number></text></sprite>
          <position><x>panel</x><y>top + 30</y></position>
        </object>
        <object name="lineslabel">
          <sprite><text style="label"><content>LINES</content></text></sprite>
          <position><x>panel</x><y>top + 100</y></position>
        </object>
        <object name="lines">
          <sprite><text style="hud"><number>status.lines</number></text></sprite>
          <position><x>panel</x><y>top + 130</y></position>
        </object>
        <object name="levellabel">
          <sprite><text style="label"><content>LEVEL</content></text></sprite>
          <position><x>panel</x><y>top + 200</y></position>
        </object>
        <object name="level">
          <sprite><text style="hud"><number>status.level</number></text></sprite>
          <position><x>panel</x><y>top + 230</y></position>
        </object>
        <object name="nextlabel">
          <sprite><text style="label"><content>NEXT</content></text></sprite>
          <position><x>panel</x><y>top + 300</y></position>
        </object>
        <object name="nextbox">
          <sprite><rectangle><width>cell + 16</width><height>3 * cell + 16</height><color>color.darkgrey</color></rectangle></sprite>
          <position><x>panel - 8</x><y>top + 332</y></position>
        </object>
        <object name="nextwell">
          <sprite><rectangle><width>cell + 8</width><height>3 * cell + 8</height><color>color.black</color></rectangle></sprite>
          <position><x>panel - 4</x><y>top + 336</y></position>
        </object>

        <!-- the next column waits here, only shown, until it is sent to the well -->
        <map name="next">
          <tile><width>cell</width><height>cell</height></tile>
          <position><x>panel</x><y>top + 340</y></position>
          <columns>1</columns>
          <rows>3</rows>
          <cells />
        </map>

        <!-- the well: six cells across, thirteen down -->
        <map name="board">
          <tile><width>cell</width><height>cell</height></tile>
          <position><x>left</x><y>top</y></position>
          <columns>6</columns>
          <rows>13</rows>
          <cells />

          <!-- a jewel of each colour; j in a shape is any one of them -->
          <group name="jewels" class="jewel" char="j">
            <sprite><circle><radius>cell / 2 - 3</radius></circle></sprite>
            <group name="red"><sprite><circle><color>color.red</color></circle></sprite></group>
            <group name="yellow"><sprite><circle><color>color.yellow</color></circle></sprite></group>
            <group name="orange"><sprite><circle><color>color.orange</color></circle></sprite></group>
            <group name="green"><sprite><circle><color>color.green</color></circle></sprite></group>
            <group name="blue"><sprite><circle><color>color.blue</color></circle></sprite></group>
            <group name="purple"><sprite><circle><color>color.magenta</color></circle></sprite></group>
          </group>

          <!-- the falling column of three -->
          <group name="pieces" class="falling">
            <collisions>
              <!-- a fall refused by a jewel or the floor: it lands -->
              <collision class="jewel" side="bottom"><trigger action="land" /></collision>
              <collision edge="bottom"><trigger action="land" /></collision>
            </collisions>
            <actions>
              <action name="left"><move direction="left">10<wait>0.2</wait></move></action>
              <action name="right"><move direction="right">10<wait>0.2</wait></move></action>
              <action name="faster"><move direction="down">20</move></action>
              <action name="cycle"><cycle /><play sound="cycle" /></action>
              <action name="land">
                <settle />
                <play sound="land" />
                <set variable="status.over">1</set>
                <send object="pieces" from="next" into="board"><column>3</column><row>1</row></send>
                <spawn object="pieces" into="next"><random /></spawn>
                <set variable="status.over">0</set>
              </action>
            </actions>
            <timers>
              <timer><every>status.gravity</every><hop direction="down" /></timer>
            </timers>
            <group name="column">
              <shape>
                <row>j</row>
                <row>j</row>
                <row>j</row>
              </shape>
            </group>
          </group>

          <!-- three or more alike in a line go; what is above drops; again -->
          <checks>
            <line class="jewel">
              <atleast>3</atleast>
              <clear />
              <fall />
              <inc variable="status.lines" />
              <inc variable="status.score">30 * status.level</inc>
              <play sound="match" />
            </line>
          </checks>
        </map>
      </objects>
      <inputs>
        <input><button>a</button><button>left</button><button>pad1.left</button><trigger object="pieces" action="left" /></input>
        <input><button>d</button><button>right</button><button>pad1.right</button><trigger object="pieces" action="right" /></input>
        <input><button>s</button><button>down</button><button>pad1.down</button><trigger object="pieces" action="faster" /></input>
        <input><button>w</button><button>up</button><button>x</button><button>space</button><button>pad1.a</button><trigger object="pieces" action="cycle" /></input>
        <input><button>p</button><button>escape</button><button>pad1.start</button><push state="paused" /></input>
      </inputs>
      <conditions>
        <condition object="status" variable="over">
          <equal>1</equal>
          <play sound="over" />
          <push state="gameover" />
        </condition>
        <!-- every ten lines: the next level, faster -->
        <condition object="status" variable="lines">
          <atleast>status.next</atleast>
          <inc variable="status.level" />
          <inc variable="status.next">10</inc>
          <set variable="status.gravity">status.gravity * 0.85</set>
        </condition>
      </conditions>
      <timers>
        <timer>
          <after>0</after>
          <spawn object="pieces"><random /><column>3</column><row>1</row></spawn>
          <spawn object="pieces" into="next"><random /></spawn>
        </timer>
      </timers>
    </state>
    <state name="paused">
      <objects>
        <object name="paused">
          <sprite><text style="banner"><content>PAUSED</content><color>color.white</color></text></sprite>
          <position><x><centered /></x><y><centered /></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input><button>p</button><button>escape</button><button>pad1.start</button><pop /></input>
      </inputs>
    </state>
    <state name="gameover">
      <objects>
        <object name="message">
          <sprite><text style="banner"><content>GAME OVER</content><color>color.red</color></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 60</centered></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
        <show object="again" />
      </shows>
      <inputs>
        <input><button>space</button><button>pad1.start</button><reset /></input>
      </inputs>
    </state>
  </states>
</game>
