<!-- asteroids.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Oct 1, 2026 -->

<!--
  Asteroids, after the 1979 arcade game: a ship that turns, thrusts the way
  it faces, drifts on and wraps round the screen, shooting rocks that break
  into smaller ones. Clear the rocks and a new wave comes; now and then a
  flying saucer crosses: the big one shoots anywhere, the small one at the
  ship, and the higher the score the likelier the small one. Every 10000
  points is another ship. Three ships.

  A and D or Left and Right turn, W or Up thrusts, Space fires, S or Down
  jumps into hyperspace, P or Escape pauses.

  How it is written:
  * Everything is drawn from <line>s and tested by pixel. The ship has a
    <heading>, which <turn> and <thrust> use, and its shots leave its nose.
  * What every rock is (a hazard, tested by pixel, wrapping) is said once,
    as the rock of the <kit>, and each size is from= it, saying its picture
    and how it breaks: its points and what it breaks into. A size with
    several shapes has a member per shape. The big rocks are in play; the
    medium and small ones are the kit's, not in play until a bigger rock
    breaks: it <release>s two, spawned where it was,
    the shapes in turn, each going its own way (a <random> velocity drawn
    as it is made, never slower than its shape's least up or down), and a broken one <despawn>s.
  * Shots wrap round the edges like everything else and run out after a
    second (a timer of their own that <despawn>s them).
  * The ship and its shots are both class "breaker", so each size has one
    rule for being broken, by either. A ship that is hit goes out of play
    and brings in "centre", a pictureless mark at the middle; two seconds
    on, it is ready, and the ship comes back there once no hazard is within
    150 of it (distance= with total="lowest": the nearest one).
  * A saucer falls due on a timer of the playing state, with a luck drawn;
    a condition sends the small one when the luck is below the score over
    40000, else the big one, and only when neither is out. The two are
    members of one kit group, "ufos", so a rock size names them both in
    one rule (it breaks, no points), and they name each rock size to die.
  * The heartbeat is the playing state's <music>; the saucer warbles on a
    timer of its own, so a pause is quiet.
  * The best score is <keeps>, shown on the title and in play.
  * The ship's flame flickers while thrust is held: a look of two pictures
    its <poses> pick while thrusting, turned with it like the others.
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../xgedef.xsd">
  <window name="Asteroids">
    <width>800</width>
    <height>600</height>
  </window>
  <variables>
    <variable name="turnrate">4</variable>
    <variable name="thrustpower">0.09</variable>
    <variable name="drag">0.02</variable>
    <variable name="shotspeed">8</variable>
    <variable name="margin">20</variable>
    <variable name="shotlife">1</variable>
  </variables>
  <sounds>
    <!-- the heartbeat, two low thumps over and over -->
    <sound name="beat" wave="triangle">
      <loop />
      <volume>0.5</volume>
      <note pitch="B1">0.1</note>
      <rest>0.4</rest>
      <note pitch="A#1">0.1</note>
      <rest>0.4</rest>
    </sound>
    <sound name="thrust" wave="noise">
      <loop />
      <volume>0.12</volume>
      <note pitch="180">1</note>
    </sound>
    <sound name="shoot" wave="square">
      <volume>0.15</volume>
      <note pitch="C6" to="C4">0.1</note>
    </sound>
    <!-- a rock broken: the bigger the rock, the lower the rumble -->
    <sound name="bangbig" wave="noise">
      <volume>0.45</volume>
      <note pitch="1200" to="100">0.45</note>
    </sound>
    <sound name="bangmedium" wave="noise">
      <volume>0.4</volume>
      <note pitch="2000" to="200">0.3</note>
    </sound>
    <sound name="bangsmall" wave="noise">
      <volume>0.35</volume>
      <note pitch="3500" to="400">0.2</note>
    </sound>
    <sound name="boom" wave="noise">
      <volume>0.5</volume>
      <note pitch="3000" to="100">0.8</note>
    </sound>
    <sound name="saucer" wave="square">
      <volume>0.12</volume>
      <note pitch="B5">0.12</note>
      <note pitch="F#5">0.12</note>
    </sound>
    <sound name="extra" wave="square">
      <volume>0.2</volume>
      <note pitch="E6">0.08</note>
      <rest>0.05</rest>
      <note pitch="E6">0.08</note>
      <rest>0.05</rest>
      <note pitch="E6">0.08</note>
    </sound>
    <sound name="gameover" wave="triangle">
      <volume>0.4</volume>
      <note pitch="G4">0.25</note>
      <note pitch="E4">0.25</note>
      <note pitch="C4" to="C3">0.7</note>
    </sound>
  </sounds>
  <styles>
    <style name="banner"><size>110</size><color>color.white</color></style>
    <style name="prompt"><size>40</size></style>
    <style name="hud"><size>30</size></style>
  </styles>
  <kit>
    <!-- four shots in the air at most, wrapping, each gone after a second -->
    <object name="shot" class="breaker">
      <sprite><rectangle><width>3</width><height>3</height></rectangle></sprite>
      <velocity><y>-shotspeed</y></velocity>
      <most>4</most>
      <collisions>
        <collision edge="all"><wrap /></collision>
        <collision class="hazard"><despawn /></collision>
      </collisions>
      <timers>
        <timer><after>shotlife</after><despawn /></timer>
      </timers>
    </object>
    <!-- what every rock is: a hazard, hit by its outline, wrapping round the edges -->
    <group name="rock" class="hazard">
      <position><x>0</x><y>0</y></position>
      <collisions>
        <type>pixel</type>
        <collision edge="all"><wrap /></collision>
      </collisions>
    </group>
    <!-- what a big rock breaks into: two of these, spawned where it was, each going its own way -->
    <group name="mediumrocks" from="rock">
      <sprite>
        <line><from><x>27</x><y>28</y></from><to><x>20</x><y>35</y></to><thickness>2</thickness></line>
        <line><from><x>20</x><y>35</y></from><to><x>10</x><y>34</y></to><thickness>2</thickness></line>
        <line><from><x>10</x><y>34</y></from><to><x>3</x><y>26</y></to><thickness>2</thickness></line>
        <line><from><x>3</x><y>26</y></from><to><x>4</x><y>16</y></to><thickness>2</thickness></line>
        <line><from><x>4</x><y>16</y></from><to><x>18</x><y>2</y></to><thickness>2</thickness></line>
        <line><from><x>18</x><y>2</y></from><to><x>28</x><y>4</y></to><thickness>2</thickness></line>
        <line><from><x>28</x><y>4</y></from><to><x>29</x><y>15</y></to><thickness>2</thickness></line>
        <line><from><x>29</x><y>15</y></from><to><x>35</x><y>23</y></to><thickness>2</thickness></line>
        <line><from><x>35</x><y>23</y></from><to><x>27</x><y>28</y></to><thickness>2</thickness></line>
      </sprite>
      <velocity><x><random><min>-1.6</min><max>1.6</max></random></x></velocity>
      <collisions>
        <collision class="breaker">
          <despawn />
          <inc variable="ship.score">50</inc>
          <release object="smallrocks">2</release>
          <play sound="bangmedium" />
        </collision>
        <collision object="ufos">
          <despawn />
          <release object="smallrocks">2</release>
          <play sound="bangmedium" />
        </collision>
      </collisions>
      <member name="mediumA">
        <velocity><y><random><min>0.6</min><max>1.6</max></random></y></velocity>
      </member>
      <member name="mediumB">
        <sprite>
            <line><from><x>32</x><y>19</y></from><to><x>33</x><y>30</y></to><thickness>2</thickness></line>
            <line><from><x>33</x><y>30</y></from><to><x>14</x><y>34</y></to><thickness>2</thickness></line>
            <line><from><x>14</x><y>34</y></from><to><x>5</x><y>29</y></to><thickness>2</thickness></line>
            <line><from><x>5</x><y>29</y></from><to><x>8</x><y>19</y></to><thickness>2</thickness></line>
            <line><from><x>8</x><y>19</y></from><to><x>7</x><y>9</y></to><thickness>2</thickness></line>
            <line><from><x>7</x><y>9</y></from><to><x>16</x><y>7</y></to><thickness>2</thickness></line>
            <line><from><x>16</x><y>7</y></from><to><x>34</x><y>9</y></to><thickness>2</thickness></line>
            <line><from><x>34</x><y>9</y></from><to><x>32</x><y>19</y></to><thickness>2</thickness></line>
        </sprite>
        <velocity><y><random><min>-1.6</min><max>-0.6</max></random></y></velocity>
      </member>
      <member name="mediumC">
        <sprite>
            <line><from><x>32</x><y>25</y></from><to><x>28</x><y>35</y></to><thickness>2</thickness></line>
            <line><from><x>28</x><y>35</y></from><to><x>18</x><y>31</y></to><thickness>2</thickness></line>
            <line><from><x>18</x><y>31</y></from><to><x>7</x><y>32</y></to><thickness>2</thickness></line>
            <line><from><x>7</x><y>32</y></from><to><x>8</x><y>21</y></to><thickness>2</thickness></line>
            <line><from><x>8</x><y>21</y></from><to><x>5</x><y>13</y></to><thickness>2</thickness></line>
            <line><from><x>5</x><y>13</y></from><to><x>12</x><y>7</y></to><thickness>2</thickness></line>
            <line><from><x>12</x><y>7</y></from><to><x>20</x><y>7</y></to><thickness>2</thickness></line>
            <line><from><x>20</x><y>7</y></from><to><x>32</x><y>16</y></to><thickness>2</thickness></line>
            <line><from><x>32</x><y>16</y></from><to><x>32</x><y>25</y></to><thickness>2</thickness></line>
        </sprite>
        <velocity><y><random><min>0.6</min><max>1.6</max></random></y></velocity>
      </member>
    </group>
    <group name="smallrocks" from="rock">
      <sprite>
        <line><from><x>16</x><y>11</y></from><to><x>16</x><y>17</y></to><thickness>2</thickness></line>
        <line><from><x>16</x><y>17</y></from><to><x>10</x><y>17</y></to><thickness>2</thickness></line>
        <line><from><x>10</x><y>17</y></from><to><x>3</x><y>10</y></to><thickness>2</thickness></line>
        <line><from><x>3</x><y>10</y></from><to><x>12</x><y>3</y></to><thickness>2</thickness></line>
        <line><from><x>12</x><y>3</y></from><to><x>18</x><y>5</y></to><thickness>2</thickness></line>
        <line><from><x>18</x><y>5</y></from><to><x>16</x><y>11</y></to><thickness>2</thickness></line>
      </sprite>
      <velocity><x><random><min>-2.6</min><max>2.6</max></random></x></velocity>
      <collisions>
        <collision class="breaker">
          <despawn />
          <inc variable="ship.score">100</inc>
          <play sound="bangsmall" />
        </collision>
        <collision object="ufos">
          <despawn />
          <play sound="bangsmall" />
        </collision>
      </collisions>
      <member name="smallA">
        <velocity><y><random><min>1</min><max>2.6</max></random></y></velocity>
      </member>
      <member name="smallB">
        <sprite>
            <line><from><x>16</x><y>14</y></from><to><x>12</x><y>18</y></to><thickness>2</thickness></line>
            <line><from><x>12</x><y>18</y></from><to><x>6</x><y>17</y></to><thickness>2</thickness></line>
            <line><from><x>6</x><y>17</y></from><to><x>5</x><y>12</y></to><thickness>2</thickness></line>
            <line><from><x>5</x><y>12</y></from><to><x>10</x><y>5</y></to><thickness>2</thickness></line>
            <line><from><x>10</x><y>5</y></from><to><x>15</x><y>5</y></to><thickness>2</thickness></line>
            <line><from><x>15</x><y>5</y></from><to><x>16</x><y>14</y></to><thickness>2</thickness></line>
        </sprite>
        <velocity><y><random><min>-2.6</min><max>-1</max></random></y></velocity>
      </member>
      <member name="smallC">
        <sprite>
            <line><from><x>17</x><y>13</y></from><to><x>15</x><y>18</y></to><thickness>2</thickness></line>
            <line><from><x>15</x><y>18</y></from><to><x>6</x><y>14</y></to><thickness>2</thickness></line>
            <line><from><x>6</x><y>14</y></from><to><x>7</x><y>3</y></to><thickness>2</thickness></line>
            <line><from><x>7</x><y>3</y></from><to><x>18</x><y>7</y></to><thickness>2</thickness></line>
            <line><from><x>18</x><y>7</y></from><to><x>17</x><y>13</y></to><thickness>2</thickness></line>
        </sprite>
        <velocity><y><random><min>1</min><max>2.6</max></random></y></velocity>
      </member>
    </group>
    <!-- the small saucer's shot, aimed at the ship -->
    <object name="saucershot" class="hazard">
      <sprite><rectangle><width>3</width><height>3</height></rectangle></sprite>
      <velocity><y>5</y></velocity>
      <most>2</most>
      <collisions>
        <collision edge="all"><wrap /></collision>
        <collision class="breaker"><despawn /></collision>
      </collisions>
      <timers>
        <timer><after>shotlife</after><despawn /></timer>
      </timers>
    </object>
    <!-- the big saucer's shot, off any way at all -->
    <object name="wildshot" from="saucershot">
      <velocity>
        <x><random><min>-5</min><max>5</max></random></x>
        <y><random><min>-5</min><max>5</max></random></y>
      </velocity>
    </object>
    <!-- the two saucers: they cross now and then, wandering up and down and shooting; a rock that meets one breaks it -->
    <group name="ufos" class="hazard">
      <position><x>-30</x><y><random><min>80</min><max>window.bottom - 80</max></random></y></position>
      <active>false</active>
      <collisions>
        <type>pixel</type>
        <collision edge="vertical"><wrap /></collision>
        <collision edge="right"><die /></collision>
        <collision object="rocks"><die /></collision>
        <collision object="mediumrocks"><die /></collision>
        <collision object="smallrocks"><die /></collision>
      </collisions>
      <timers>
        <timer>
          <every>1.5</every>
          <set variable="self.velocity.y"><random><min>-1.5</min><max>1.5</max></random></set>
        </timer>
      </timers>
      <!-- the big one; it shoots anywhere (its timers are where play takes it) -->
      <member name="saucer">
        <sprite>
          <line><from><x>10</x><y>1</y></from><to><x>18</x><y>1</y></to></line>
          <line><from><x>10</x><y>1</y></from><to><x>8</x><y>5</y></to></line>
          <line><from><x>18</x><y>1</y></from><to><x>20</x><y>5</y></to></line>
          <line><from><x>1</x><y>9</y></from><to><x>8</x><y>5</y></to><thickness>2</thickness></line>
          <line><from><x>8</x><y>5</y></from><to><x>20</x><y>5</y></to><thickness>2</thickness></line>
          <line><from><x>20</x><y>5</y></from><to><x>27</x><y>9</y></to><thickness>2</thickness></line>
          <line><from><x>1</x><y>9</y></from><to><x>27</x><y>9</y></to><thickness>2</thickness></line>
          <line><from><x>1</x><y>9</y></from><to><x>8</x><y>13</y></to><thickness>2</thickness></line>
          <line><from><x>8</x><y>13</y></from><to><x>20</x><y>13</y></to><thickness>2</thickness></line>
          <line><from><x>20</x><y>13</y></from><to><x>27</x><y>9</y></to><thickness>2</thickness></line>
        </sprite>
        <velocity><x>2</x></velocity>
      </member>
      <!-- the small one: half the size, quicker, and it aims -->
      <member name="smallsaucer">
        <sprite>
          <line><from><x>5</x><y>1</y></from><to><x>9</x><y>1</y></to></line>
          <line><from><x>5</x><y>1</y></from><to><x>4</x><y>3</y></to></line>
          <line><from><x>9</x><y>1</y></from><to><x>10</x><y>3</y></to></line>
          <line><from><x>1</x><y>5</y></from><to><x>4</x><y>3</y></to></line>
          <line><from><x>4</x><y>3</y></from><to><x>10</x><y>3</y></to></line>
          <line><from><x>10</x><y>3</y></from><to><x>13</x><y>5</y></to></line>
          <line><from><x>1</x><y>5</y></from><to><x>13</x><y>5</y></to></line>
          <line><from><x>1</x><y>5</y></from><to><x>4</x><y>7</y></to></line>
          <line><from><x>4</x><y>7</y></from><to><x>10</x><y>7</y></to></line>
          <line><from><x>10</x><y>7</y></from><to><x>13</x><y>5</y></to></line>
        </sprite>
        <velocity><x>2.5</x></velocity>
      </member>
    </group>
  </kit>
  <objects>
    <object name="best">
      <sprite><text style="hud"><number>best.score</number><color>color.lightgrey</color></text></sprite>
      <position><x><centered /></x><y>margin</y></position>
      <variables><variable name="score">0</variable></variables>
    </object>
  </objects>
  <keeps>
    <keep object="best" />
  </keeps>
  <states>
    <state name="mainmenu">
      <objects>
        <object name="title">
          <sprite><text style="banner"><content>ASTEROIDS</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 110</centered></y></position>
        </object>
        <object name="keys">
          <sprite><text style="prompt"><content>turn a d   thrust w   fire space   hyperspace s</content><size>24</size><color>color.lightgrey</color></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center + 10</centered></y></position>
        </object>
        <object name="start">
          <sprite><text style="prompt"><content>spacebar to start</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center + 100</centered></y></position>
        </object>
      </objects>
      <shows>
        <show object="best" />
      </shows>
      <inputs>
        <input button="space"><push state="playing" /></input>
      </inputs>
    </state>
    <state name="playing">
      <objects>
        <!-- The ship: an arrowhead of three lines, drawn again at its heading. -->
        <object name="ship" class="breaker">
          <sprite name="coasting">
            <line><from><x>12</x><y>0</y></from><to><x>23</x><y>28</y></to><thickness>2</thickness></line>
            <line><from><x>12</x><y>0</y></from><to><x>1</x><y>28</y></to><thickness>2</thickness></line>
            <line><from><x>4</x><y>22</y></from><to><x>20</x><y>22</y></to><thickness>2</thickness></line>
          </sprite>
          <!-- the flame out of the back, inside the same box so the ship turns about the same middle -->
          <sprite name="flame">
            <line><from><x>12</x><y>0</y></from><to><x>23</x><y>28</y></to><thickness>2</thickness></line>
            <line><from><x>12</x><y>0</y></from><to><x>1</x><y>28</y></to><thickness>2</thickness></line>
            <line><from><x>4</x><y>22</y></from><to><x>20</x><y>22</y></to><thickness>2</thickness></line>
            <line><from><x>8</x><y>23</y></from><to><x>12</x><y>28</y></to></line>
            <line><from><x>16</x><y>23</y></from><to><x>12</x><y>28</y></to></line>
          </sprite>
          <animation name="burning">
            <interval>0.05</interval>
            <frame sprite="flame" />
            <frame sprite="coasting" />
          </animation>
          <position><x><centered /></x><y><centered /></y></position>
          <heading>0</heading>
          <drag>drag</drag>
          <poses>
            <standing sprite="coasting" />
            <thrusting sprite="burning" />
          </poses>
          <collisions>
            <type>pixel</type>
            <collision edge="all"><wrap /></collision>
            <collision class="hazard">
              <reveal object="centre" />
              <dec variable="ship.lives" />
              <play sound="boom" />
              <reset />
              <die />
            </collision>
          </collisions>
          <actions>
            <action name="left"><turn direction="counterclockwise">turnrate</turn></action>
            <action name="right"><turn direction="clockwise">turnrate</turn></action>
            <action name="thrust">
              <thrust>thrustpower</thrust>
              <play sound="thrust" />
            </action>
            <action name="fire">
              <fire object="shot" />
              <play sound="shoot" />
            </action>
            <action name="hyperspace">
              <set variable="ship.x"><random><min>margin</min><max>window.right - 60</max></random></set>
              <set variable="ship.y"><random><min>margin</min><max>window.bottom - 60</max></random></set>
            </action>
          </actions>
          <variables>
            <variable name="score">0</variable>
            <variable name="lives">3</variable>
            <variable name="next">10000</variable>
          </variables>
        </object>
        <!-- Four big rocks come in from the edges each wave; a broken one releases two of the next size. -->
        <group name="rocks" from="rock">
          <group name="bigrocks">
            <sprite>
              <line><from><x>60</x><y>33</y></from><to><x>44</x><y>40</y></to><thickness>2</thickness></line>
              <line><from><x>44</x><y>40</y></from><to><x>38</x><y>47</y></to><thickness>2</thickness></line>
              <line><from><x>38</x><y>47</y></from><to><x>28</x><y>52</y></to><thickness>2</thickness></line>
              <line><from><x>28</x><y>52</y></from><to><x>14</x><y>53</y></to><thickness>2</thickness></line>
              <line><from><x>14</x><y>53</y></from><to><x>8</x><y>40</y></to><thickness>2</thickness></line>
              <line><from><x>8</x><y>40</y></from><to><x>12</x><y>28</y></to><thickness>2</thickness></line>
              <line><from><x>12</x><y>28</y></from><to><x>13</x><y>18</y></to><thickness>2</thickness></line>
              <line><from><x>13</x><y>18</y></from><to><x>21</x><y>11</y></to><thickness>2</thickness></line>
              <line><from><x>21</x><y>11</y></from><to><x>44</x><y>10</y></to><thickness>2</thickness></line>
              <line><from><x>44</x><y>10</y></from><to><x>50</x><y>21</y></to><thickness>2</thickness></line>
              <line><from><x>50</x><y>21</y></from><to><x>60</x><y>33</y></to><thickness>2</thickness></line>
            </sprite>
            <collisions>
              <collision class="breaker">
                <die />
                <inc variable="ship.score">20</inc>
                <release object="mediumrocks">2</release>
                <play sound="bangbig" />
              </collision>
              <collision object="ufos">
                <die />
                <release object="mediumrocks">2</release>
                <play sound="bangbig" />
              </collision>
            </collisions>
            <member>
              <position><x><random><min>0</min><max>window.right</max></random></x></position>
              <velocity><x><random><min>0.6</min><max>1.2</max></random></x><y><random><min>-0.8</min><max>0.8</max></random></y></velocity>
            </member>
            <member>
              <sprite>
                <line><from><x>47</x><y>48</y></from><to><x>35</x><y>49</y></to><thickness>2</thickness></line>
                <line><from><x>35</x><y>49</y></from><to><x>22</x><y>59</y></to><thickness>2</thickness></line>
                <line><from><x>22</x><y>59</y></from><to><x>15</x><y>44</y></to><thickness>2</thickness></line>
                <line><from><x>15</x><y>44</y></from><to><x>9</x><y>35</y></to><thickness>2</thickness></line>
                <line><from><x>9</x><y>35</y></from><to><x>11</x><y>11</y></to><thickness>2</thickness></line>
                <line><from><x>11</x><y>11</y></from><to><x>23</x><y>3</y></to><thickness>2</thickness></line>
                <line><from><x>23</x><y>3</y></from><to><x>36</x><y>7</y></to><thickness>2</thickness></line>
                <line><from><x>36</x><y>7</y></from><to><x>46</x><y>15</y></to><thickness>2</thickness></line>
                <line><from><x>46</x><y>15</y></from><to><x>58</x><y>38</y></to><thickness>2</thickness></line>
                <line><from><x>58</x><y>38</y></from><to><x>47</x><y>48</y></to><thickness>2</thickness></line>
              </sprite>
              <position><x>window.right - 60</x><y><random><min>0</min><max>window.bottom</max></random></y></position>
              <velocity><x><random><min>-0.8</min><max>0.8</max></random></x><y><random><min>0.6</min><max>1.2</max></random></y></velocity>
            </member>
            <member>
              <sprite>
                <line><from><x>53</x><y>35</y></from><to><x>50</x><y>48</y></to><thickness>2</thickness></line>
                <line><from><x>50</x><y>48</y></from><to><x>35</x><y>47</y></to><thickness>2</thickness></line>
                <line><from><x>35</x><y>47</y></from><to><x>24</x><y>56</y></to><thickness>2</thickness></line>
                <line><from><x>24</x><y>56</y></from><to><x>10</x><y>36</y></to><thickness>2</thickness></line>
                <line><from><x>10</x><y>36</y></from><to><x>10</x><y>11</y></to><thickness>2</thickness></line>
                <line><from><x>10</x><y>11</y></from><to><x>21</x><y>3</y></to><thickness>2</thickness></line>
                <line><from><x>21</x><y>3</y></from><to><x>36</x><y>4</y></to><thickness>2</thickness></line>
                <line><from><x>36</x><y>4</y></from><to><x>58</x><y>21</y></to><thickness>2</thickness></line>
                <line><from><x>58</x><y>21</y></from><to><x>53</x><y>35</y></to><thickness>2</thickness></line>
              </sprite>
              <position><x><random><min>0</min><max>window.right</max></random></x><y>window.bottom - 60</y></position>
              <velocity><x><random><min>-1.2</min><max>-0.6</max></random></x><y><random><min>-0.8</min><max>0.8</max></random></y></velocity>
            </member>
            <member>
              <position><y><random><min>0</min><max>window.bottom</max></random></y></position>
              <velocity><x><random><min>-0.8</min><max>0.8</max></random></x><y><random><min>-1.2</min><max>-0.6</max></random></y></velocity>
            </member>
          </group>
        </group>
        <object name="saucer">
          <collisions>
            <collision class="breaker">
              <die />
              <inc variable="ship.score">200</inc>
              <play sound="bangbig" />
            </collision>
          </collisions>
          <timers>
            <timer name="hum"><every>0.25</every><play sound="saucer" /></timer>
            <timer name="shoot"><every>1</every><fire object="wildshot" /></timer>
          </timers>
        </object>
        <object name="smallsaucer">
          <collisions>
            <collision class="breaker">
              <die />
              <inc variable="ship.score">1000</inc>
              <play sound="bangsmall" />
            </collision>
          </collisions>
          <timers>
            <timer name="hum"><every>0.18</every><play sound="saucer" /></timer>
            <timer name="shoot">
              <every>1</every>
              <aim object="ship" />
              <fire object="saucershot" />
            </timer>
          </timers>
        </object>
        <!-- Where a ship that was hit comes back: in play while it waits, ready two seconds on. -->
        <object name="centre">
          <position><x>window.width.center</x><y>window.height.center</y></position>
          <active>false</active>
          <variables><variable name="ready">0</variable></variables>
          <timers>
            <timer><after>2</after><set variable="centre.ready">1</set></timer>
          </timers>
        </object>
        <!-- When a saucer is due, and the luck that picks which. -->
        <object name="saucers">
          <variables>
            <variable name="due">0</variable>
            <variable name="luck">0</variable>
          </variables>
        </object>
        <object name="score">
          <sprite><text style="hud"><number>ship.score</number></text></sprite>
          <position><x>margin</x><y>margin</y></position>
        </object>
        <object name="lives">
          <sprite><text style="hud"><content>SHIPS</content><number>ship.lives</number></text></sprite>
          <position><x>window.right - lives.width - margin</x><y>margin</y></position>
        </object>
      </objects>
      <shows>
        <show object="best" />
      </shows>
      <music sound="beat" />
      <inputs>
        <input><button>a</button><button>left</button><trigger object="ship" action="left" /></input>
        <input><button>d</button><button>right</button><trigger object="ship" action="right" /></input>
        <input><button>w</button><button>up</button><trigger object="ship" action="thrust" /></input>
        <input><button>s</button><button>down</button><trigger object="ship" action="hyperspace" /></input>
        <input button="space"><trigger object="ship" action="fire" /></input>
        <input><button>p</button><button>escape</button><push state="paused" /></input>
      </inputs>
      <conditions>
        <condition object="ship" variable="lives">
          <atmost>0</atmost>
          <push state="gameover" />
          <play sound="gameover" />
        </condition>
        <!-- a wave cleared: the next one comes in from the edges -->
        <condition>
          <all>
            <condition object="rocks"><remaining>0</remaining></condition>
            <condition object="mediumrocks"><remaining>0</remaining></condition>
            <condition object="smallrocks"><remaining>0</remaining></condition>
          </all>
          <reset object="rocks" />
        </condition>
        <!-- the middle clear: the ship comes back -->
        <condition>
          <all>
            <condition object="centre" variable="ready"><equal>1</equal></condition>
            <any>
              <condition class="hazard"><remaining>0</remaining></condition>
              <condition class="hazard" distance="centre" total="lowest"><above>150</above></condition>
            </any>
          </all>
          <reveal object="ship" />
          <reset object="centre" />
        </condition>
        <!-- a saucer due and none out: the small one by luck, likelier as the score climbs -->
        <condition>
          <all>
            <condition object="saucers" variable="due"><equal>1</equal></condition>
            <condition object="saucer"><remaining>0</remaining></condition>
            <condition object="smallsaucer"><remaining>0</remaining></condition>
            <condition object="saucers" variable="luck"><below>ship.score / 40000</below></condition>
          </all>
          <reveal object="smallsaucer" />
          <set variable="saucers.due">0</set>
        </condition>
        <condition>
          <all>
            <condition object="saucers" variable="due"><equal>1</equal></condition>
            <condition object="saucer"><remaining>0</remaining></condition>
            <condition object="smallsaucer"><remaining>0</remaining></condition>
          </all>
          <reveal object="saucer" />
          <set variable="saucers.due">0</set>
        </condition>
        <condition object="ship" variable="score">
          <atleast>ship.next</atleast>
          <inc variable="ship.lives" />
          <inc variable="ship.next">10000</inc>
          <play sound="extra" />
        </condition>
        <condition object="ship" variable="score">
          <above>best.score</above>
          <copy variable="ship.score" into="best.score" />
        </condition>
      </conditions>
      <timers>
        <timer>
          <every><random><min>12</min><max>24</max></random></every>
          <set variable="saucers.luck"><random><min>0</min><max>1</max></random></set>
          <set variable="saucers.due">1</set>
        </timer>
      </timers>
    </state>
    <state name="paused">
      <objects>
        <object name="paused">
          <sprite><text style="banner"><content>PAUSED</content></text></sprite>
          <position><x><centered /></x><y><centered /></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input><button>space</button><button>p</button><button>escape</button><pop /></input>
      </inputs>
    </state>
    <state name="gameover">
      <objects>
        <object name="message">
          <sprite><text style="banner"><content>GAME OVER</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 60</centered></y></position>
        </object>
        <object name="again">
          <sprite><text style="prompt"><content>spacebar to play again</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center + 70</centered></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input button="space"><reset /></input>
      </inputs>
    </state>
  </states>
</game>
