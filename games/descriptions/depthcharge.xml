<!-- depthcharge.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Sept 30, 2026 -->

<!--
  Depth Charge, after the 1977 arcade game: a destroyer crosses the surface
  and rolls depth charges off both sides onto the submarines cruising below.
  The deeper a submarine, the more it is worth. The submarines lay mines
  that rise to the surface; one that comes up under the destroyer costs a
  ship. The game lasts 90 seconds, or three ships.

  A and D or the arrows move, Space drops a pair of charges, one off each
  side, P or Escape pauses.

  How it is written:
  * A charge does not exist until the destroyer <spawn>s a pair of them at
    its two sides (positions read as Space is pressed); six at most are in
    the water, and one that hits a boat or the bottom is <despawn>ed.
  * The submarines are one group, which says once what every submarine
    does (wrap round, lay a mine now and then with <release>, sink to a
    charge for its lane's worth, self.worth), with a group inside it for
    each lane: its color, depth, speed, worth and boats. A sunk boat comes
    back where it started, on a timer of the playing state.
  * A sunk boat <release>s a burst, an animated picture spawned where it
    sank, which <despawn>s itself on its own timer. Mines are spawned the
    same way.
  * The sonar ping is the playing state's <music>.
  Not in it: the time given back for a high score, the charges' depth
  setting.
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../xge/xgedef.xsd">
  <window name="Depth Charge">
    <width>800</width>
    <height>600</height>
    <background>color.black</background>
    <fullscreen>false</fullscreen>
    <framerate>60</framerate>
  </window>
  <variables>
    <variable name="surface">100</variable>
    <variable name="step">4</variable>
    <variable name="margin">20</variable>
  </variables>
  <sounds>
    <!-- the sonar, pinging all through the hunt -->
    <sound name="sonar" wave="sine">
      <loop />
      <volume>0.15</volume>
      <note pitch="B5" to="A5">0.15</note>
      <rest>1.6</rest>
    </sound>
    <sound name="drop" wave="square">
      <volume>0.2</volume>
      <note pitch="G3" to="C3">0.1</note>
    </sound>
    <sound name="sink" wave="noise">
      <volume>0.45</volume>
      <note pitch="2500" to="150">0.5</note>
    </sound>
    <sound name="boom" wave="noise">
      <volume>0.5</volume>
      <note pitch="1200" to="60">0.9</note>
    </sound>
    <sound name="start" wave="square">
      <volume>0.2</volume>
      <note pitch="C5">0.07</note>
      <note pitch="E5">0.07</note>
      <note pitch="G5">0.07</note>
      <note pitch="C6">0.14</note>
    </sound>
    <sound name="gameover" wave="triangle">
      <volume>0.4</volume>
      <note pitch="G4">0.25</note>
      <note pitch="E4">0.25</note>
      <note pitch="C4" to="C3">0.7</note>
    </sound>
  </sounds>
  <styles>
    <style name="banner"><size>110</size><color>color.cyan</color></style>
    <style name="line"><size>30</size><color>color.white</color></style>
    <style name="hud"><size>30</size><color>color.white</color></style>
  </styles>
  <kit>
    <!-- a charge, sinking slowly; six at most in the water -->
    <object name="charge" class="charge">
      <sprite>
        <bitmap>
          <row>.**.</row>
          <row>****</row>
          <row>****</row>
          <row>.**.</row>
          <scale>3</scale>
          <color>color.orange</color>
        </bitmap>
      </sprite>
      <velocity><y>2</y></velocity>
      <most>6</most>
      <collisions>
        <enabled>true</enabled>
        <collision edge="bottom"><despawn /></collision>
        <collision class="sub"><despawn /></collision>
      </collisions>
    </object>
    <!-- the mines the submarines lay: they rise, and go off at the top of the water or under the destroyer -->
    <object name="mine" class="mine">
      <sprite>
        <bitmap>
          <row>*.*.*</row>
          <row>.***.</row>
          <row>*****</row>
          <row>.***.</row>
          <row>*.*.*</row>
          <scale>2</scale>
          <color>color.white</color>
        </bitmap>
      </sprite>
      <velocity><y>-1.2</y></velocity>
      <most>6</most>
      <collisions>
        <enabled>true</enabled>
        <collision object="ship"><despawn /></collision>
        <collision object="waterline"><despawn /></collision>
      </collisions>
    </object>
    <!-- a submarine going down -->
    <object name="burst">
      <sprite name="flash">
        <bitmap>
          <row>.*..*..*.</row>
          <row>..*.*.*..</row>
          <row>*..***..*</row>
          <row>..*.*.*..</row>
          <row>.*..*..*.</row>
          <scale>4</scale>
          <color>color.white</color>
        </bitmap>
      </sprite>
      <sprite name="spray">
        <bitmap>
          <row>*...*...*</row>
          <row>.*.....*.</row>
          <row>...*.*...</row>
          <row>.*.....*.</row>
          <row>*...*...*</row>
          <scale>4</scale>
          <color>color.cyan</color>
        </bitmap>
      </sprite>
      <animation>
        <interval>0.1</interval>
        <frame sprite="flash" />
        <frame sprite="spray" />
      </animation>
      <timers>
        <timer><every>0.6</every><despawn /></timer>
      </timers>
    </object>
  </kit>
  <states>
    <state name="mainmenu">
      <objects>
        <object name="title">
          <sprite><text style="banner"><content>DEPTH CHARGE</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 130</centered></y></position>
        </object>
        <object name="help">
          <sprite><text style="line"><content>the deeper the submarine, the more it is worth</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 20</centered></y></position>
        </object>
        <object name="keys">
          <sprite><text style="line"><content>a and d or the arrows move, space drops a pair</content><size>28</size><color>color.lightgrey</color></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center + 30</centered></y></position>
        </object>
        <object name="start">
          <sprite><text style="line"><content>spacebar to start</content><size>48</size></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center + 130</centered></y></position>
        </object>
      </objects>
      <inputs>
        <input button="space">
          <push state="playing" />
          <play sound="start" />
        </input>
      </inputs>
    </state>
    <state name="playing">
      <objects>
        <object name="sea">
          <sprite><rectangle><width>window.right</width><height>window.bottom - surface</height><color>color.darkblue</color></rectangle></sprite>
          <position><x>0</x><y>surface</y></position>
        </object>
        <!-- the top of the water, where a mine that has come up goes off -->
        <object name="waterline">
          <sprite><rectangle><width>window.right</width><height>2</height><color>color.cyan</color></rectangle></sprite>
          <position><x>0</x><y>surface</y></position>
          <collisions><enabled>true</enabled></collisions>
        </object>
        <object name="status">
          <variables>
            <variable name="score">0</variable>
            <variable name="time">90</variable>
            <variable name="ships">3</variable>
          </variables>
        </object>
        <!-- the submarines: four lanes, each deeper, slower to reach and worth more -->
        <group name="subs" class="sub">
          <sprite>
            <bitmap>
              <row>.........**.........</row>
              <row>........****........</row>
              <row>.******************.</row>
              <row>********************</row>
              <row>.******************.</row>
              <row>..****************..</row>
              <scale>3</scale>
              <color>color.yellow</color>
            </bitmap>
          </sprite>
          <collisions>
            <enabled>true</enabled>
            <type>pixel</type>
            <collision edge="horizontal"><wrap /></collision>
            <collision class="charge">
              <inc variable="status.score">self.worth</inc>
              <play sound="sink" />
              <release object="burst" />
              <die />
            </collision>
          </collisions>
          <timers>
            <timer><every><random min="3" max="9" /></every><release object="mine" /></timer>
          </timers>
          <group name="lane1">
            <position><y>170</y></position>
            <velocity><x>1.5</x></velocity>
            <variables><variable name="worth">20</variable></variables>
            <member><position><x>-60</x></position></member>
            <member><position><x>240</x></position></member>
            <member><position><x>540</x></position></member>
          </group>
          <group name="lane2">
            <sprite><bitmap><color>color.green</color></bitmap></sprite>
            <position><y>260</y></position>
            <velocity><x>-2</x></velocity>
            <variables><variable name="worth">40</variable></variables>
            <member><position><x>80</x></position></member>
            <member><position><x>380</x></position></member>
            <member><position><x>680</x></position></member>
          </group>
          <group name="lane3">
            <sprite><bitmap><color>color.orange</color></bitmap></sprite>
            <position><y>350</y></position>
            <velocity><x>2.5</x></velocity>
            <variables><variable name="worth">60</variable></variables>
            <member><position><x>-10</x></position></member>
            <member><position><x>390</x></position></member>
          </group>
          <group name="lane4">
            <sprite><bitmap><color>color.red</color></bitmap></sprite>
            <position><y>440</y></position>
            <velocity><x>-3</x></velocity>
            <variables><variable name="worth">80</variable></variables>
            <member><position><x>200</x></position></member>
            <member><position><x>600</x></position></member>
          </group>
        </group>
        <object name="ship">
          <sprite>
            <bitmap>
              <row>..........*...................</row>
              <row>.........***......*...........</row>
              <row>....**..*****....***..........</row>
              <row>..**************************..</row>
              <row>******************************</row>
              <row>.****************************.</row>
              <row>..**************************..</row>
              <row>...************************...</row>
              <scale>3</scale>
              <color>color.lightgrey</color>
            </bitmap>
          </sprite>
          <position><x><centered /></x><y>surface - 20</y></position>
          <collisions>
            <enabled>true</enabled>
            <type>pixel</type>
            <collision edge="horizontal"><stick /></collision>
            <collision class="mine">
              <dec variable="status.ships" />
              <play sound="boom" />
            </collision>
          </collisions>
          <actions>
            <action name="left"><move direction="left">step</move></action>
            <action name="right"><move direction="right">step</move></action>
            <action name="drop">
              <spawn object="charge"><position><x><centered>ship.x + 6</centered></x><y>ship.y + 12</y></position></spawn>
              <spawn object="charge"><position><x><centered>ship.x + ship.width - 6</centered></x><y>ship.y + 12</y></position></spawn>
              <play sound="drop" />
            </action>
          </actions>
        </object>
        <object name="score">
          <sprite><text style="hud"><content>SCORE </content><number>status.score</number></text></sprite>
          <position><x>margin</x><y>margin</y></position>
        </object>
        <object name="clock">
          <sprite><text style="hud"><content>TIME </content><number>status.time</number><color>color.yellow</color></text></sprite>
          <position><x><centered /></x><y>margin</y></position>
        </object>
        <object name="ships">
          <sprite><text style="hud"><content>SHIPS </content><number>status.ships</number></text></sprite>
          <position><x>window.right - 140</x><y>margin</y></position>
        </object>
      </objects>
      <music sound="sonar" />
      <inputs>
        <input button="a left"><trigger object="ship" action="left" /></input>
        <input button="d right"><trigger object="ship" action="right" /></input>
        <input button="space"><trigger object="ship" action="drop" /></input>
        <input button="p escape"><push state="paused" /></input>
      </inputs>
      <conditions>
        <condition object="status" variable="time">
          <atmost>0</atmost>
          <push state="gameover" />
          <play sound="gameover" />
        </condition>
        <condition object="status" variable="ships">
          <atmost>0</atmost>
          <push state="gameover" />
          <play sound="gameover" />
        </condition>
      </conditions>
      <timers>
        <timer><every>1</every><dec variable="status.time" /></timer>
        <!-- a sunk boat back in its lane -->
        <timer><every>2</every><reveal object="subs" /></timer>
      </timers>
    </state>
    <state name="paused">
      <objects>
        <object name="paused">
          <sprite><text style="banner"><content>PAUSED</content><color>color.white</color></text></sprite>
          <position><x><centered /></x><y><centered /></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input button="space p escape"><pop /></input>
      </inputs>
    </state>
    <state name="gameover">
      <objects>
        <object name="message">
          <sprite><text style="banner"><content>GAME OVER</content><color>color.red</color></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 60</centered></y></position>
        </object>
        <object name="again">
          <sprite><text style="line"><content>spacebar to play again</content><size>48</size></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center + 70</centered></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input button="space"><reset /></input>
      </inputs>
    </state>
  </states>
</game>
