<!-- fishingderby.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Oct 17, 2026 -->

<!--
  After Activision's Fishing Derby for the Atari 2600: a fisherman on the
  pier, a line down into the water, three rows of fish swimming to and fro,
  and a shark patrolling just under the surface. Steer the hook onto a fish,
  reel it up past the shark, and land it: a deeper fish is worth more. The
  first to 60 pounds wins.

  W A S D or the arrows move the hook, P or Escape pauses, Space starts,
  pauses and plays again.

  It is the game values read when used, <set>, <spawn> and <tether> were
  made for:
  * The line is a <tether> from the rod tip to the hook: drawn again every
    frame wherever the two are.
  * Each row of fish has its own <variable> worth. A landed fish adds
    <inc variable="player.score">self.worth</inc>: the amount is read when
    it runs, from the fish that ran it.
  * A landed fish is <spawn>ed again at once, out of the side of the sea,
    at the depth its worth says and going faster the more is landed, all
    worked out from self.worth and player.score as it comes in.
  * Every fish landed, the shark goes a tenth faster:
    <set variable="shark.velocity.x">shark.velocity.x * 1.1</set>.
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../xge/xgedef.xsd">
  <window name="Fishing Derby">
    <width>800</width>
    <height>600</height>
    <background>color.blue</background>
    <fullscreen>false</fullscreen>
    <framerate>60</framerate>
  </window>
  <variables>
    <variable name="surface">200</variable>
    <variable name="reel">3</variable>
    <variable name="goal">60</variable>
  </variables>
  <sounds>
    <sound name="bite" wave="square">
      <volume>0.2</volume>
      <note pitch="E5">0.05</note>
    </sound>
    <sound name="landed" wave="triangle">
      <volume>0.4</volume>
      <note pitch="C5" to="C6">0.2</note>
    </sound>
    <sound name="chomp" wave="noise">
      <volume>0.3</volume>
      <note pitch="300">0.2</note>
    </sound>
  </sounds>
  <styles>
    <style name="banner"><size>100</size><color>color.yellow</color></style>
    <style name="prompt"><size>40</size></style>
    <style name="help"><size>28</size></style>
    <style name="hud"><size>36</size><color>color.white</color></style>
  </styles>
  <objects>
    <object name="again">
      <sprite>
        <text style="prompt">
          <content>spacebar to play again</content>
        </text>
      </sprite>
      <position><x><centered /></x><y><centered>window.height.center + 70</centered></y></position>
    </object>
  </objects>
  <states>
    <state name="mainmenu">
      <objects>
        <object name="title">
          <sprite>
            <text style="banner">
              <content>FISHING DERBY</content>
            </text>
          </sprite>
          <position><x><centered /></x><y><centered>window.height.center - 140</centered></y></position>
        </object>
        <object name="help">
          <sprite>
            <text style="help">
              <content>hook a fish, reel it up past the shark, land 60 pounds</content>
            </text>
          </sprite>
          <position><x><centered /></x><y><centered>window.height.center - 40</centered></y></position>
        </object>
        <object name="keys">
          <sprite>
            <text style="help">
              <content>w a s d or the arrows move the hook</content>
              <color>color.lightgrey</color>
            </text>
          </sprite>
          <position><x><centered /></x><y><centered>window.height.center + 10</centered></y></position>
        </object>
        <object name="start">
          <sprite>
            <text style="prompt">
              <content>spacebar to start</content>
            </text>
          </sprite>
          <position><x><centered /></x><y><centered>window.height.center + 110</centered></y></position>
        </object>
      </objects>
      <inputs>
        <input button="space">
          <push state="playing" />
        </input>
      </inputs>
    </state>
    <state name="playing">
      <objects>
        <object name="sky">
          <sprite>
            <rectangle>
              <width>800</width>
              <height>surface</height>
              <color>color.cyan</color>
            </rectangle>
          </sprite>
          <position><x>0</x><y>0</y></position>
        </object>
        <object name="pier">
          <sprite>
            <rectangle>
              <width>120</width>
              <height>20</height>
              <color>color.brown</color>
            </rectangle>
          </sprite>
          <position><x>0</x><y>surface - 30</y></position>
        </object>
        <object name="fisherman">
          <sprite>
            <rectangle>
              <width>16</width>
              <height>50</height>
              <color>color.darkgreen</color>
            </rectangle>
          </sprite>
          <position><x>40</x><y>surface - 80</y></position>
        </object>
        <object name="rod">
          <sprite>
            <rectangle>
              <width>4</width>
              <height>4</height>
              <color>color.black</color>
            </rectangle>
          </sprite>
          <position><x>150</x><y>surface - 110</y></position>
        </object>
        <!-- the line: from the rod tip to the hook, wherever the hook goes -->
        <object name="line">
          <sprite>
            <tether from="rod" to="hook">
              <thickness>2</thickness>
              <color>color.black</color>
            </tether>
          </sprite>
          <position><x>0</x><y>0</y></position>
        </object>
        <object name="score">
          <sprite>
            <text style="hud">
              <number>player.score</number>
            </text>
          </sprite>
          <position><x>window.right - score.width - 40</x><y>12</y></position>
        </object>
        <object name="player">
          <variables>
            <variable name="score">0</variable>
          </variables>
        </object>
        <!-- the surface: a fish brought up to it is landed -->
        <object name="surface">
          <sprite>
            <rectangle>
              <width>800</width>
              <height>4</height>
              <color>color.cyan</color>
            </rectangle>
          </sprite>
          <position><x>0</x><y>surface - 4</y></position>
          <collisions>
            <enabled>true</enabled>
          </collisions>
        </object>
        <object name="shark">
          <sprite>
            <rectangle>
              <width>70</width>
              <height>22</height>
              <color>color.grey</color>
            </rectangle>
          </sprite>
          <position><x>300</x><y>surface + 20</y></position>
          <velocity><x>2</x></velocity>
          <collisions>
            <enabled>true</enabled>
            <collision edge="left">
              <bounce />
            </collision>
            <collision edge="right">
              <bounce />
            </collision>
          </collisions>
        </object>
        <object name="hook">
          <sprite>
            <rectangle>
              <width>8</width>
              <height>8</height>
              <color>color.lightgrey</color>
            </rectangle>
          </sprite>
          <position><x>146</x><y>surface + 60</y></position>
          <collisions>
            <enabled>true</enabled>
            <collision edge="all">
              <stick />
            </collision>
            <collision class="fish">
              <carry />
            </collision>
          </collisions>
          <actions>
            <action name="up"><move direction="up">reel</move></action>
            <action name="down"><move direction="down">reel</move></action>
            <action name="left"><move direction="left">reel</move></action>
            <action name="right"><move direction="right">reel</move></action>
          </actions>
        </object>
        <!-- three rows of fish, the deeper worth more -->
        <group name="fish" class="fish">
          <sprite>
            <rectangle>
              <width>34</width>
              <height>14</height>
              <color>color.yellow</color>
            </rectangle>
          </sprite>
          <collisions>
            <enabled>true</enabled>
            <collision edge="left">
              <bounce />
            </collision>
            <collision edge="right">
              <bounce />
            </collision>
            <collision object="hook">
              <stop />
              <play sound="bite" />
            </collision>
            <collision object="shark">
              <play sound="chomp" />
              <die />
              <spawn object="fish">
                <position>
                  <x>0</x>
                  <y>surface + 60 + self.worth * 30</y>
                </position>
                <velocity><x>1 + player.score / 30</x></velocity>
              </spawn>
            </collision>
            <collision object="surface">
              <inc variable="player.score">self.worth</inc>
              <set variable="shark.velocity.x">shark.velocity.x * 1.1</set>
              <play sound="landed" />
              <die />
              <spawn object="fish">
                <position>
                  <x>0</x>
                  <y>surface + 60 + self.worth * 30</y>
                </position>
                <velocity><x>1 + player.score / 30</x></velocity>
              </spawn>
            </collision>
          </collisions>
          <group name="shallow">
            <velocity><x>1</x></velocity>
            <variables><variable name="worth">2</variable></variables>
            <member><position><x>200</x><y>surface + 120</y></position></member>
            <member><position><x>550</x><y>surface + 120</y></position></member>
          </group>
          <group name="middle">
            <sprite><rectangle><color>color.orange</color></rectangle></sprite>
            <velocity><x>-1.5</x></velocity>
            <variables><variable name="worth">4</variable></variables>
            <member><position><x>300</x><y>surface + 180</y></position></member>
            <member><position><x>650</x><y>surface + 180</y></position></member>
          </group>
          <group name="deep">
            <sprite><rectangle><color>color.red</color></rectangle></sprite>
            <velocity><x>2</x></velocity>
            <variables><variable name="worth">6</variable></variables>
            <member><position><x>100</x><y>surface + 240</y></position></member>
            <member><position><x>450</x><y>surface + 240</y></position></member>
          </group>
        </group>
      </objects>
      <inputs>
        <input button="w"><trigger object="hook" action="up" /></input>
        <input button="up"><trigger object="hook" action="up" /></input>
        <input button="s"><trigger object="hook" action="down" /></input>
        <input button="down"><trigger object="hook" action="down" /></input>
        <input button="a"><trigger object="hook" action="left" /></input>
        <input button="left"><trigger object="hook" action="left" /></input>
        <input button="d"><trigger object="hook" action="right" /></input>
        <input button="right"><trigger object="hook" action="right" /></input>
        <input button="space"><push state="paused" /></input>
        <input button="p"><push state="paused" /></input>
        <input button="escape"><push state="paused" /></input>
      </inputs>
      <conditions>
        <condition object="player" variable="score">
          <atleast>goal</atleast>
          <push state="won" />
        </condition>
      </conditions>
    </state>
    <state name="paused">
      <objects>
        <object name="paused">
          <sprite>
            <text style="banner">
              <content>PAUSED</content>
              <color>color.white</color>
            </text>
          </sprite>
          <position><x><centered /></x><y><centered /></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input button="space"><pop /></input>
        <input button="p"><pop /></input>
        <input button="escape"><pop /></input>
      </inputs>
    </state>
    <state name="won">
      <objects>
        <object name="message">
          <sprite>
            <text style="banner">
              <content>60 POUNDS</content>
            </text>
          </sprite>
          <position><x><centered /></x><y><centered>window.height.center - 60</centered></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
        <show object="again" />
      </shows>
      <inputs>
        <input button="space">
          <reset />
        </input>
      </inputs>
    </state>
  </states>
</game>
