<!-- tennis.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Oct 17, 2026 -->

<!--
  Tennis, after Activision's 1981 game for the Atari 2600. The court is seen
  from above, and the ball flies: it is drawn higher the higher it is, with
  its shadow under it on the court, and it bounces where it lands. Walk into
  the ball to hit it back, but only when it is low enough to reach. The
  computer plays the far end. Points go love, 15, 30, 40 and game, with
  deuce and advantage; six games take the set and the match.

  W A S D or the arrow keys walk, Space starts and plays again, P or Escape
  pauses.

  How it is written:
  * The two players are one group: the picture, a person and a white
    racket, the <stick /> at the edges, the walking and the score are said
    once, and each says where it stands and the far one its colour.
  * The ball has an <altitude>: how high it is, how fast it rises (less each
    frame by its fall) and how much of its speed it keeps when it bounces.
    Its position is where it is over the court, so what it touches is what
    is under it, and it is drawn raised by its altitude. The shadow is an
    object of its own kept under it (<shadow object="ball" />).
  * Each racket's rule on the ball has a <condition> of the ball's altitude, so
    a ball over a player's head goes past. A hit sends it back up (rise) and
    toward the other end, more to one side the further from the middle of
    the racket it was hit (values read as the rule runs).
  * The far player is the computer's: a <computer> in the playing state
    holds J or L down while the ball is to one side of it, the keys a second
    player would use, so a person could play that end instead.
  * The score is words: a <choose> shows LOVE, 15, 30, 40 or AD from the
    points. Conditions of <all> and <any> say who takes the game: four
    points with the other on 30 or less, or five, after four all has gone
    back to deuce (three all).
  * A ball out at the far end is a point to the near player, and the other
    way round; either way it is served again (<reset />).
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../xgedef.xsd">
  <window name="Tennis">
    <width>800</width>
    <height>600</height>
    <background>color.forestgreen</background>
  </window>
  <variables>
    <variable name="step">3</variable>
    <variable name="reach">50</variable>
    <variable name="hit">4.5</variable>
    <variable name="loft">6</variable>
    <variable name="spin">0.12</variable>
    <variable name="set">6</variable>
  </variables>
  <sounds>
    <sound name="hit"><volume>0.2</volume><note pitch="C5">0.04</note></sound>
    <sound name="point" wave="triangle">
      <volume>0.3</volume>
      <note pitch="E5" to="E4">0.25</note>
    </sound>
  </sounds>
  <styles>
    <style name="banner"><size>110</size><color>color.white</color></style>
    <style name="score"><size>32</size><color>color.white</color></style>
  </styles>
  <objects>
    <object name="continue">
      <sprite><text><content>spacebar to play</content><size>40</size><color>color.white</color></text></sprite>
      <position><x><centered /></x><y>window.height.center + 60</y></position>
    </object>
  </objects>
  <states>
    <state name="mainmenu">
      <objects>
        <object name="title">
          <sprite><text style="banner"><content>TENNIS</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 80</centered></y></position>
        </object>
      </objects>
      <shows>
        <show object="continue" />
      </shows>
      <inputs>
        <input button="space"><push state="playing" /></input>
      </inputs>
    </state>
    <state name="playing">
      <objects>
        <!-- the court's lines: the sidelines, the service boxes and the line down the middle -->
        <object name="court">
          <sprite>
            <line><from><x>0</x><y>0</y></from><to><x>500</x><y>0</y></to><thickness>2</thickness></line>
            <line><from><x>500</x><y>0</y></from><to><x>500</x><y>440</y></to><thickness>2</thickness></line>
            <line><from><x>500</x><y>440</y></from><to><x>0</x><y>440</y></to><thickness>2</thickness></line>
            <line><from><x>0</x><y>440</y></from><to><x>0</x><y>0</y></to><thickness>2</thickness></line>
            <line><from><x>250</x><y>100</y></from><to><x>250</x><y>340</y></to><thickness>2</thickness></line>
            <line><from><x>0</x><y>100</y></from><to><x>500</x><y>100</y></to><thickness>2</thickness></line>
            <line><from><x>0</x><y>340</y></from><to><x>500</x><y>340</y></to><thickness>2</thickness></line>
          </sprite>
          <position><x>150</x><y>80</y></position>
        </object>
        <object name="net">
          <sprite><rectangle><width>540</width><height>4</height><color>color.lightgrey</color></rectangle></sprite>
          <position><x>130</x><y>298</y></position>
        </object>
        <!-- the players: a person with a racket; the far one is the computer's -->
        <group name="players" class="racket">
          <sprite>
            <bitmap>
              <row>...**.....</row>
              <row>...**...rr</row>
              <row>.******.rr</row>
              <row>...**..r..</row>
              <row>...**.....</row>
              <row>..*..*....</row>
              <row>..*..*....</row>
              <row>.**..**...</row>
              <scale>3</scale>
              <color>color.orange</color>
              <color char="r">color.white</color>
            </bitmap>
          </sprite>
          <collisions>
            <collision edge="all"><stick /></collision>
          </collisions>
          <actions>
            <action name="up"><move direction="up">step</move></action>
            <action name="down"><move direction="down">step</move></action>
            <action name="left"><move direction="left">step</move></action>
            <action name="right"><move direction="right">step</move></action>
          </actions>
          <variables>
            <variable name="points">0</variable>
            <variable name="games">0</variable>
          </variables>
          <member name="cpu">
            <sprite><bitmap><color>color.cyan</color></bitmap></sprite>
            <position><x>385</x><y>50</y></position>
          </member>
          <member name="player"><position><x>385</x><y>520</y></position></member>
        </group>
        <!-- the ball's shadow, on the court under it; written before the ball, so drawn under it -->
        <object name="shadow">
          <sprite><circle><radius>6</radius><color>color.darkgreen</color></circle></sprite>
          <position><x>0</x><y>0</y></position>
          <shadow object="ball" />
        </object>
        <!-- served from the far end toward the player, falling from high up -->
        <object name="ball">
          <sprite><circle><radius>6</radius><color>color.yellow</color></circle></sprite>
          <position><x>394</x><y>90</y></position>
          <velocity><x><random><min>-1.5</min><max>1.5</max></random></x><y>3</y></velocity>
          <altitude>
            <start>80</start>
            <fall>0.25</fall>
            <bounce>0.7</bounce>
          </altitude>
          <collisions>
            <collision edge="horizontal"><bounce /></collision>
            <collision edge="top">
              <inc variable="player.points" />
              <play sound="point" />
              <reset />
            </collision>
            <collision edge="bottom">
              <inc variable="cpu.points" />
              <play sound="point" />
              <reset />
            </collision>
            <!-- hit back when it is low enough to reach: up, and away, angled by where on the racket -->
            <collision object="player">
              <condition variable="altitude"><below>reach</below></condition>
              <set variable="ball.velocity.y">0 - hit</set>
              <set variable="ball.velocity.x">(ball.x - player.x - 9) * spin</set>
              <set variable="ball.rise">loft</set>
              <play sound="hit" />
            </collision>
            <collision object="cpu">
              <condition variable="altitude"><below>reach</below></condition>
              <set variable="ball.velocity.y">hit</set>
              <set variable="ball.velocity.x">(ball.x - cpu.x - 9) * spin</set>
              <set variable="ball.rise">loft</set>
              <play sound="hit" />
            </collision>
          </collisions>
        </object>
        <!-- the score: games, then this game's points as words -->
        <object name="cpuscore">
          <sprite>
            <text style="score">
              <content>CPU</content>
              <number>cpu.games</number>
              <choose><by>cpu.points</by><word>LOVE</word><word>15</word><word>30</word><word>40</word><word>AD</word></choose>
            </text>
          </sprite>
          <position><x>10</x><y>10</y></position>
        </object>
        <object name="playerscore">
          <sprite>
            <text style="score">
              <content>YOU</content>
              <number>player.games</number>
              <choose><by>player.points</by><word>LOVE</word><word>15</word><word>30</word><word>40</word><word>AD</word></choose>
            </text>
          </sprite>
          <position><x>10</x><y>window.bottom - 50</y></position>
        </object>
      </objects>
      <inputs>
        <input button="p escape"><push state="paused" /></input>
        <input button="w up"><trigger object="player" action="up" /></input>
        <input button="s down"><trigger object="player" action="down" /></input>
        <input button="a left"><trigger object="player" action="left" /></input>
        <input button="d right"><trigger object="player" action="right" /></input>
        <!-- the far end's keys: the computer's, or a second player's -->
        <input button="j"><trigger object="cpu" action="left" /></input>
        <input button="l"><trigger object="cpu" action="right" /></input>
      </inputs>
      <conditions>
        <condition object="player" variable="games">
          <atleast>set</atleast>
          <push state="won" />
        </condition>
        <condition object="cpu" variable="games">
          <atleast>set</atleast>
          <push state="lost" />
        </condition>
        <!-- four all is deuce again: forty all -->
        <condition>
          <all>
            <condition object="player" variable="points"><atleast>4</atleast></condition>
            <condition object="cpu" variable="points"><atleast>4</atleast></condition>
          </all>
          <set variable="players.points">3</set>
        </condition>
        <!-- four points against thirty or less, or five (after advantage), take the game -->
        <condition>
          <any>
            <condition object="player" variable="points"><atleast>5</atleast></condition>
            <all>
              <condition object="player" variable="points"><atleast>4</atleast></condition>
              <condition object="cpu" variable="points"><atmost>2</atmost></condition>
            </all>
          </any>
          <inc variable="player.games" />
          <set variable="players.points">0</set>
        </condition>
        <condition>
          <any>
            <condition object="cpu" variable="points"><atleast>5</atleast></condition>
            <all>
              <condition object="cpu" variable="points"><atleast>4</atleast></condition>
              <condition object="player" variable="points"><atmost>2</atmost></condition>
            </all>
          </any>
          <inc variable="cpu.games" />
          <set variable="players.points">0</set>
        </condition>
      </conditions>
      <!-- the computer keeps its racket under the ball -->
      <computer>
        <condition object="cpu" variable="x">
          <below object="ball" variable="x" />
          <hold button="l" />
        </condition>
        <condition object="cpu" variable="x">
          <above object="ball" variable="x" />
          <hold button="j" />
        </condition>
      </computer>
    </state>
    <state name="paused">
      <objects>
        <object name="paused">
          <sprite><text style="banner"><content>paused</content></text></sprite>
          <position><x><centered /></x><y><centered /></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input button="space p escape"><pop /></input>
      </inputs>
    </state>
    <state name="lost">
      <objects>
        <object name="message">
          <sprite><text style="banner"><content>SET, CPU</content><color>color.red</color></text></sprite>
          <position><x><centered /></x><y>window.height.center - 150</y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
        <show object="continue" />
      </shows>
      <inputs>
        <input button="space"><reset /></input>
      </inputs>
    </state>
    <state name="won" from="lost">
      <objects>
        <object name="message">
          <sprite><text style="banner"><content>SET, YOU</content><color>color.yellow</color></text></sprite>
        </object>
      </objects>
    </state>
  </states>
</game>
