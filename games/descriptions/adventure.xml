<!-- adventure.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Oct 14, 2026 -->

<!--
  Adventure, after Warren Robinett's 1980 game for the Atari 2600: five rooms
  of a small kingdom. A square hero starts in front of the gold castle, its
  portcullis down. East is a field where Yorgle, the yellow dragon, sleeps by
  the gold key; further east the black castle, shut too. The black key lies
  in the gold castle's hall, and the enchanted chalice in the black castle's
  dungeon, which Grundle, the green dragon, guards. Pick a thing up by
  walking into it, one at a time; carry it, put it down. A key raises its
  castle's portcullis, the sword slays a dragon that runs into it, and a
  dragon that catches the hero eats him. Bring the chalice into the gold
  castle's hall to win.

          hall                         dungeon
           |                              |
        castle  =====  field  =====  blackcastle

  W A S D or the arrow keys walk, Space puts down what is carried, P or
  Escape pauses, Space starts.

  How it is written:
  * The rooms are the <scenes> of the playing state, and the hero and the
    score he plays for (status) the state's own, there in every room. A room
    left stays as it was until he comes back.
  * The kit: the walls (one group; a room takes the walls it has, a member
    at a time, in its own colour), the two castles (members of one group),
    the two dragons (members of one group, each in its own colours), and
    four unseen strips, the ways out: east, west, in through a castle's
    gate and out through the bottom of a hall. Each room's <ways> say where
    they lead; the hero's own rule for each puts him in at the far side.
    What he carries goes with him.
  * The castles are bitmaps with <type>pixel</type>, so the towers and the
    gate's arch stop him where they are drawn.
  * The hero <carry />s any object of class item he touches. One thing at a
    time: picking up another puts the first down. <drop /> puts it down, and
    he does not pick it up again until he has walked off it.
  * A portcullis <die />s when its key touches it, carried or not; a carried
    key is swept like anything that moves, so it meets the gate first.
  * A dragon sleeps (its first look) until the hero comes near: a condition
    of its room, an <all> of how far the hero is (distance=) and that it is
    still asleep, wakes it with a roar. Its timer follows the awake look, so
    only then does it <chase> him, at its room's dragonspeed.
  * Paused, won and eaten draw the room still underneath (<show state>).
  Not in it: the other rooms and the blue labyrinth, the white castle, Rhindle
  the red dragon, the bat, the bridge, the magnet and the hidden dot.
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../xge/xgedef.xsd">
  <window name="Adventure">
    <width>640</width>
    <height>480</height>
  </window>
  <variables>
    <variable name="step">3</variable>
    <variable name="wall">12</variable>
    <variable name="gap">120</variable>
  </variables>
  <sounds>
    <sound name="pickup" wave="square">
      <volume>0.15</volume>
      <note pitch="E5">0.04</note>
      <note pitch="A5">0.05</note>
    </sound>
    <sound name="drop" wave="triangle">
      <volume>0.3</volume>
      <note pitch="A3">0.06</note>
    </sound>
    <sound name="open" wave="square">
      <volume>0.15</volume>
      <note pitch="C4" to="C5">0.4</note>
    </sound>
    <sound name="slay" wave="noise">
      <volume>0.4</volume>
      <note pitch="2000" to="150">0.5</note>
    </sound>
    <sound name="roar" wave="sawtooth">
      <volume>0.25</volume>
      <note pitch="A1" to="E2">0.5</note>
    </sound>
    <sound name="start" wave="square">
      <volume>0.2</volume>
      <note pitch="C5">0.07</note>
      <note pitch="E5">0.07</note>
      <note pitch="G5">0.07</note>
      <note pitch="C6">0.14</note>
    </sound>
    <sound name="win" wave="square">
      <volume>0.2</volume>
      <note pitch="C5">0.1</note>
      <note pitch="E5">0.1</note>
      <note pitch="G5">0.1</note>
      <note pitch="C6">0.1</note>
      <note pitch="G5">0.1</note>
      <note pitch="C6">0.3</note>
    </sound>
    <sound name="gameover" wave="triangle">
      <volume>0.4</volume>
      <note pitch="G4">0.25</note>
      <note pitch="E4">0.25</note>
      <note pitch="C4" to="C3">0.7</note>
    </sound>
  </sounds>
  <styles>
    <style name="banner"><size>50</size><color>color.yellow</color></style>
    <style name="prompt"><size>36</size></style>
    <style name="help"><size>22</size><color>color.white</color></style>
  </styles>
  <kit>
    <!-- the walls a room can have, taken a member at a time -->
    <group name="walls" class="wall">
      <sprite><rectangle><width>window.right</width><height>wall</height><color>color.yellow</color></rectangle></sprite>
      <collisions />
      <member name="top"><position><x>0</x><y>0</y></position></member>
      <member name="bottom"><position><x>0</x><y>window.bottom - wall</y></position></member>
      <member name="west">
        <sprite><rectangle><width>wall</width><height>window.bottom</height></rectangle></sprite>
        <position><x>0</x><y>0</y></position>
      </member>
      <member name="east">
        <sprite><rectangle><width>wall</width><height>window.bottom</height></rectangle></sprite>
        <position><x>window.right - wall</x><y>0</y></position>
      </member>
      <!-- a hall's bottom wall, either side of its way out -->
      <member name="lowleft">
        <sprite><rectangle><width>(window.right - gap) / 2</width></rectangle></sprite>
        <position><x>0</x><y>window.bottom - wall</y></position>
      </member>
      <member name="lowright">
        <sprite><rectangle><width>(window.right - gap) / 2</width></rectangle></sprite>
        <position><x>(window.right + gap) / 2</x><y>window.bottom - wall</y></position>
      </member>
    </group>

    <!-- the castles: towers, a keep, and an arch for the gate -->
    <group name="castles" class="wall">
      <sprite>
        <bitmap>
          <row>*.*.*.*..................*.*.*.*</row>
          <row>*******..................*******</row>
          <row>*******..................*******</row>
          <row>*******..................*******</row>
          <row>********.*.*.*.*.*.*.*.*.*******</row>
          <row>********************************</row>
          <row>********************************</row>
          <row>********************************</row>
          <row>********************************</row>
          <row>********************************</row>
          <row>********************************</row>
          <row>********************************</row>
          <row>************........************</row>
          <row>************........************</row>
          <row>************........************</row>
          <row>************........************</row>
          <row>************........************</row>
          <row>************........************</row>
          <row>************........************</row>
          <row>************........************</row>
          <scale>8</scale>
          <color>color.yellow</color>
        </bitmap>
      </sprite>
      <position><x>window.width.center - 128</x><y>40</y></position>
      <collisions>
        <type>pixel</type>
      </collisions>
      <member name="gold" />
      <member name="black"><sprite><bitmap><color>color.darkgrey</color></bitmap></sprite></member>
    </group>

    <!-- the dragons: asleep until the hero comes near, then after him -->
    <group name="dragons" class="dragon">
      <sprite name="asleep">
        <bitmap>
          <row>....***.</row>
          <row>....*.**</row>
          <row>....****</row>
          <row>....*...</row>
          <row>*...**..</row>
          <row>**..***.</row>
          <row>.*****..</row>
          <row>..****..</row>
          <row>...**...</row>
          <row>...*.*..</row>
          <row>..**.**.</row>
          <scale>5</scale>
        </bitmap>
      </sprite>
      <sprite name="awake">
        <bitmap>
          <row>....***.</row>
          <row>....*.**</row>
          <row>....****</row>
          <row>....*...</row>
          <row>*...**..</row>
          <row>**..***.</row>
          <row>.*****..</row>
          <row>..****..</row>
          <row>...**...</row>
          <row>...*.*..</row>
          <row>..**.**.</row>
          <scale>5</scale>
        </bitmap>
      </sprite>
      <collisions>
        <collision edge="all"><stick /></collision>
        <collision class="wall"><stop /></collision>
        <collision object="sword">
          <die />
          <play sound="slay" />
        </collision>
      </collisions>
      <variables>
        <variable name="awake">0</variable>
      </variables>
      <timers>
        <timer sprite="awake">
          <every>0.3</every>
          <chase object="hero">dragonspeed</chase>
        </timer>
      </timers>
      <member name="yorgle">
        <sprite name="asleep"><bitmap><color>color.orange</color></bitmap></sprite>
        <sprite name="awake"><bitmap><color>color.yellow</color></bitmap></sprite>
        <position><x>420</x><y>160</y></position>
      </member>
      <member name="grundle">
        <sprite name="asleep"><bitmap><color>color.darkgreen</color></bitmap></sprite>
        <sprite name="awake"><bitmap><color>color.green</color></bitmap></sprite>
        <position><x>460</x><y>240</y></position>
      </member>
    </group>

    <!-- the ways out, never drawn -->
    <object name="eastexit" class="eastside">
      <sprite><rectangle><width>4</width><height>window.bottom</height><color>color.black</color></rectangle></sprite>
      <position><x>window.right - 4</x><y>0</y></position>
      <drawn>false</drawn>
      <collisions>
        <collision object="hero"><enter way="east" /></collision>
      </collisions>
    </object>
    <object name="westexit" class="westside">
      <sprite><rectangle><width>4</width><height>window.bottom</height><color>color.black</color></rectangle></sprite>
      <position><x>0</x><y>0</y></position>
      <drawn>false</drawn>
      <collisions>
        <collision object="hero"><enter way="west" /></collision>
      </collisions>
    </object>
    <!-- just inside a castle's arch -->
    <object name="doorway" class="inside">
      <sprite><rectangle><width>64</width><height>6</height><color>color.black</color></rectangle></sprite>
      <position><x>window.width.center - 32</x><y>136</y></position>
      <drawn>false</drawn>
      <collisions>
        <collision object="hero"><enter way="in" /></collision>
      </collisions>
    </object>
    <!-- the bottom of a hall -->
    <object name="doorout" class="outside">
      <sprite><rectangle><width>gap</width><height>6</height><color>color.black</color></rectangle></sprite>
      <position><x>(window.right - gap) / 2</x><y>window.bottom - 6</y></position>
      <drawn>false</drawn>
      <collisions>
        <collision object="hero"><enter way="out" /></collision>
      </collisions>
    </object>
  </kit>
  <states>
    <state name="title">
      <objects>
        <object name="title">
          <sprite><text style="banner"><content>ADVENTURE</content><size>72</size></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 130</centered></y></position>
        </object>
        <object name="help">
          <sprite><text style="help"><content>bring the chalice home to the gold castle</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 40</centered></y></position>
        </object>
        <object name="keys">
          <sprite><text style="help"><content>w a s d or arrows walk, space puts down</content></text></sprite>
          <position><x><centered /></x><y><centered /></y></position>
        </object>
        <object name="start">
          <sprite><text style="prompt"><content>spacebar to start</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center + 100</centered></y></position>
        </object>
      </objects>
      <inputs>
        <input button="space">
          <push state="playing" />
          <play sound="start" />
        </input>
      </inputs>
    </state>

    <state name="playing">
      <objects>
        <!-- how the game ends; never drawn -->
        <object name="status">
          <variables>
            <variable name="won">0</variable>
            <variable name="eaten">0</variable>
          </variables>
        </object>

        <!-- the hero: walks, stops at walls, carries what he walks into -->
        <object name="hero">
          <sprite><rectangle><width>10</width><height>10</height><color>color.orange</color></rectangle></sprite>
          <position><x>window.width.center - 5</x><y>400</y></position>
          <collisions>
            <collision edge="all"><stick /></collision>
            <collision class="wall"><stop /></collision>
            <collision class="item"><carry /><play sound="pickup" /></collision>
            <!-- through a way out: in at the far side of the next room -->
            <collision class="eastside"><move direction="left">window.right - 40</move></collision>
            <collision class="westside"><move direction="right">window.right - 40</move></collision>
            <collision class="inside"><move direction="down">270</move></collision>
            <collision class="outside"><move direction="up">260</move></collision>
            <collision class="dragon">
              <die />
              <inc variable="status.eaten" />
            </collision>
          </collisions>
          <actions>
            <action name="up"><move direction="up">step</move></action>
            <action name="down"><move direction="down">step</move></action>
            <action name="left"><move direction="left">step</move></action>
            <action name="right"><move direction="right">step</move></action>
            <action name="drop">
              <drop />
              <play sound="drop" />
            </action>
          </actions>
        </object>
      </objects>
      <scenes>

        <!-- in front of the gold castle, the sword by the moat -->
        <scene name="castle">
          <ways>
            <way name="east" scene="field" />
            <way name="in" scene="hall" />
          </ways>
          <objects>
            <object name="top" />
            <object name="bottom" />
            <object name="west" />
            <object name="eastexit" />
            <object name="gold" />
            <object name="doorway" />
            <object name="goldgate" class="wall">
              <sprite>
                <bitmap>
                  <row>*.*.*.*.</row><row>********</row><row>*.*.*.*.</row><row>*.*.*.*.</row><row>********</row><row>*.*.*.*.</row><row>*.*.*.*.</row><row>********</row>
                  <scale>8</scale>
                  <color>color.lightgrey</color>
                </bitmap>
              </sprite>
              <position><x>window.width.center - 32</x><y>136</y></position>
              <collisions>
                <collision object="goldkey"><die /><play sound="open" /></collision>
              </collisions>
            </object>
            <object name="sword" class="item">
              <sprite>
                <bitmap>
                  <row>.*......</row>
                  <row>********</row>
                  <row>.*......</row>
                  <scale>3</scale>
                  <color>color.yellow</color>
                </bitmap>
              </sprite>
              <position><x>100</x><y>380</y></position>
              <collisions />
            </object>
          </objects>
        </scene>

        <!-- inside the gold castle: the black key, and where the chalice belongs -->
        <scene name="hall">
          <ways>
            <way name="out" scene="castle" />
          </ways>
          <objects>
            <object name="top" />
            <object name="west" />
            <object name="east" />
            <object name="lowleft" />
            <object name="lowright" />
            <object name="doorout" />
            <object name="home">
              <sprite><rectangle><width>window.right - 2 * wall</width><height>window.bottom - 3 * wall</height><color>color.black</color></rectangle></sprite>
              <position><x>wall</x><y>wall</y></position>
              <drawn>false</drawn>
              <collisions>
                <collision object="chalice"><inc variable="status.won" /></collision>
              </collisions>
            </object>
            <object name="blackkey" class="item">
              <sprite>
                <bitmap>
                  <row>.***.....</row>
                  <row>**.******</row>
                  <row>.***..*.*</row>
                  <scale>3</scale>
                  <color>color.darkgrey</color>
                </bitmap>
              </sprite>
              <position><x>300</x><y>200</y></position>
              <collisions />
            </object>
          </objects>
        </scene>

        <!-- the field between the castles: Yorgle asleep by the gold key -->
        <scene name="field">
          <ways>
            <way name="west" scene="castle" />
            <way name="east" scene="blackcastle" />
          </ways>
          <variables>
            <variable name="dragonspeed">1.2</variable>
          </variables>
          <objects>
            <object name="top"><sprite><rectangle><width>window.right</width><height>wall</height><color>color.green</color></rectangle></sprite></object>
            <object name="bottom"><sprite><rectangle><width>window.right</width><height>wall</height><color>color.green</color></rectangle></sprite></object>
            <object name="westexit" />
            <object name="eastexit" />
            <object name="goldkey" class="item">
              <sprite>
                <bitmap>
                  <row>.***.....</row>
                  <row>**.******</row>
                  <row>.***..*.*</row>
                  <scale>3</scale>
                  <color>color.yellow</color>
                </bitmap>
              </sprite>
              <position><x>480</x><y>300</y></position>
              <collisions />
            </object>
            <object name="yorgle" />
          </objects>
          <conditions>
            <condition>
              <all>
                <condition object="yorgle" distance="hero"><below>160</below></condition>
                <condition object="yorgle" variable="awake"><equal>0</equal></condition>
              </all>
              <inc variable="yorgle.awake" />
              <become object="yorgle" sprite="awake" />
              <play sound="roar" />
            </condition>
          </conditions>
        </scene>

        <!-- in front of the black castle -->
        <scene name="blackcastle">
          <ways>
            <way name="west" scene="field" />
            <way name="in" scene="dungeon" />
          </ways>
          <objects>
            <object name="top"><sprite><rectangle><width>window.right</width><height>wall</height><color>color.lightgrey</color></rectangle></sprite></object>
            <object name="bottom"><sprite><rectangle><width>window.right</width><height>wall</height><color>color.lightgrey</color></rectangle></sprite></object>
            <object name="east"><sprite><rectangle><width>wall</width><height>window.bottom</height><color>color.lightgrey</color></rectangle></sprite></object>
            <object name="westexit" />
            <object name="black" />
            <object name="doorway" />
            <object name="blackgate" class="wall">
              <sprite>
                <bitmap>
                  <row>*.*.*.*.</row><row>********</row><row>*.*.*.*.</row><row>*.*.*.*.</row><row>********</row><row>*.*.*.*.</row><row>*.*.*.*.</row><row>********</row>
                  <scale>8</scale>
                  <color>color.lightgrey</color>
                </bitmap>
              </sprite>
              <position><x>window.width.center - 32</x><y>136</y></position>
              <collisions>
                <collision object="blackkey"><die /><play sound="open" /></collision>
              </collisions>
            </object>
          </objects>
        </scene>

        <!-- inside the black castle: the chalice, and Grundle -->
        <scene name="dungeon">
          <ways>
            <way name="out" scene="blackcastle" />
          </ways>
          <variables>
            <variable name="dragonspeed">1.6</variable>
          </variables>
          <objects>
            <object name="top"><sprite><rectangle><width>window.right</width><height>wall</height><color>color.lightgrey</color></rectangle></sprite></object>
            <object name="west"><sprite><rectangle><width>wall</width><height>window.bottom</height><color>color.lightgrey</color></rectangle></sprite></object>
            <object name="east"><sprite><rectangle><width>wall</width><height>window.bottom</height><color>color.lightgrey</color></rectangle></sprite></object>
            <object name="lowleft"><sprite><rectangle><width>(window.right - gap) / 2</width><height>wall</height><color>color.lightgrey</color></rectangle></sprite></object>
            <object name="lowright"><sprite><rectangle><width>(window.right - gap) / 2</width><height>wall</height><color>color.lightgrey</color></rectangle></sprite></object>
            <object name="doorout" />
            <!-- the chalice, flashing -->
            <object name="chalice" class="item">
              <sprite name="bright">
                <bitmap>
                  <row>*.....*</row>
                  <row>*.....*</row>
                  <row>.*...*.</row>
                  <row>..***..</row>
                  <row>...*...</row>
                  <row>...*...</row>
                  <row>.*****.</row>
                  <scale>3</scale>
                  <color>color.magenta</color>
                </bitmap>
              </sprite>
              <sprite name="dim">
                <bitmap>
                  <row>*.....*</row>
                  <row>*.....*</row>
                  <row>.*...*.</row>
                  <row>..***..</row>
                  <row>...*...</row>
                  <row>...*...</row>
                  <row>.*****.</row>
                  <scale>3</scale>
                  <color>color.purple</color>
                </bitmap>
              </sprite>
              <animation>
                <interval>0.15</interval>
                <frame sprite="bright" />
                <frame sprite="dim" />
              </animation>
              <position><x>300</x><y>120</y></position>
              <collisions />
            </object>
            <object name="grundle" />
          </objects>
          <conditions>
            <condition>
              <all>
                <condition object="grundle" distance="hero"><below>200</below></condition>
                <condition object="grundle" variable="awake"><equal>0</equal></condition>
              </all>
              <inc variable="grundle.awake" />
              <become object="grundle" sprite="awake" />
              <play sound="roar" />
            </condition>
          </conditions>
        </scene>
      </scenes>
      <inputs>
        <input button="w up"><trigger object="hero" action="up" /></input>
        <input button="s down"><trigger object="hero" action="down" /></input>
        <input button="a left"><trigger object="hero" action="left" /></input>
        <input button="d right"><trigger object="hero" action="right" /></input>
        <input button="space"><trigger object="hero" action="drop" /></input>
        <input button="p escape"><push state="paused" /></input>
      </inputs>
      <conditions>
        <condition object="status" variable="eaten">
          <atleast>1</atleast>
          <play sound="gameover" />
          <push state="eaten" />
        </condition>
        <condition object="status" variable="won">
          <atleast>1</atleast>
          <play sound="win" />
          <push state="won" />
        </condition>
      </conditions>
    </state>

    <state name="paused">
      <objects>
        <object name="paused">
          <sprite><text style="banner"><content>PAUSED</content><size>100</size><color>color.white</color></text></sprite>
          <position><x><centered /></x><y><centered /></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input button="space p escape"><pop /></input>
      </inputs>
    </state>

    <state name="won">
      <objects>
        <object name="message">
          <sprite><text style="banner"><content>THE CHALICE IS HOME</content><color>color.magenta</color></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center + 20</centered></y></position>
        </object>
        <object name="again">
          <sprite><text style="prompt"><content>spacebar to play again</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center + 90</centered></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input button="space"><reset /></input>
      </inputs>
    </state>

    <state name="eaten" from="won">
      <objects>
        <object name="message">
          <sprite><text style="banner"><content>EATEN BY A DRAGON</content><color>color.green</color></text></sprite>
        </object>
      </objects>
    </state>
  </states>
</game>
