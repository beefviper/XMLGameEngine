<!-- tictactoe.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Nov 1, 2026 -->

<!--
  Tic-Tac-Toe: X and O take turns marking a square of a three by three
  grid, X first. Three in a line, across, down or on a slant, wins; a
  full grid is a draw. You play X against the computer, easy or smart,
  or two players share the keyboard.

  W A S D or the arrows move the cursor, Space puts your mark there. The
  mouse works too: the cursor follows it and a left click marks. P or
  Escape pauses. On the title, Space plays the computer, A and D choose
  how well it plays, and 2 is for two players. Space plays again.

  How it is written:
  * The grid is a <map> of <cells />, empty to begin with: X and O wait
    on it, to be put. Their <moves /> say nothing, so a mark may be put
    in any free cell.
  * The cursor is on a map of its own over the grid; <put class="x" />
    marks its cell, and a taken cell refuses it.
  * The grid's <checks> find three in a <line>.
  * The computer plays O with <think>: easy looks one move ahead (it
    takes a win, but does not see yours coming); smart looks to the end
    of the game, and cannot be beaten, only drawn with.
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../xgedef.xsd">
  <window name="Tic-Tac-Toe">
    <width>800</width>
    <height>600</height>
  </window>
  <variables>
    <variable name="square">120</variable>
    <variable name="left">220</variable>
    <variable name="top">110</variable>
  </variables>
  <sounds>
    <sound name="mark" wave="triangle"><note pitch="E4">0.05</note></sound>
    <sound name="win">
      <note pitch="C5">0.12</note>
      <note pitch="E5">0.12</note>
      <note pitch="G5">0.12</note>
      <note pitch="C6">0.4</note>
    </sound>
  </sounds>
  <styles>
    <style name="banner"><size>80</size></style>
    <style name="prompt"><size>32</size></style>
    <style name="help"><size>22</size><color>color.lightgrey</color></style>
    <style name="hud"><size>32</size></style>
    <style name="x"><scale>8</scale><color>color.red</color></style>
    <style name="o"><scale>8</scale><color>color.cyan</color></style>
    <style name="cursor"><scale>12</scale><color>color.yellow</color></style>
  </styles>
  <objects>
    <!-- how well the computer plays, kept: 0 easy, 1 smart -->
    <object name="options">
      <variables><variable name="smart">1</variable></variables>
    </object>
    <!-- how many play; marks put; 1 once a line is made -->
    <object name="match">
      <variables>
        <variable name="players">1</variable>
        <variable name="made">0</variable>
        <variable name="won">0</variable>
      </variables>
    </object>
    <object name="again">
      <sprite><text style="prompt"><content>spacebar to play again</content></text></sprite>
      <position><x><centered /></x><y><centered>window.height.center + 70</centered></y></position>
    </object>
  </objects>
  <keeps>
    <keep object="options" />
  </keeps>
  <states>
    <state name="title">
      <objects>
        <object name="title">
          <sprite><text style="banner"><content>TIC-TAC-TOE</content><color>color.red</color></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 170</centered></y></position>
        </object>
        <object name="help1">
          <sprite><text style="help"><content>you play x, and go first; 2 for two players</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 90</centered></y></position>
        </object>
        <object name="help2">
          <sprite><text style="help"><content>w a s d or the arrows move, spacebar or a click marks, p pauses</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 60</centered></y></position>
        </object>
        <object name="level">
          <sprite><text style="help"><content>a d: the computer plays </content><choose><by>options.smart</by><word>easy</word><word>smart</word></choose></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center + 10</centered></y></position>
        </object>
        <object name="start">
          <sprite><text style="prompt"><content>spacebar to start</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center + 170</centered></y></position>
        </object>
      </objects>
      <inputs>
        <input><button>space</button><button>pad1.start</button><set variable="match.players">1</set><push state="playing" /></input>
        <input><button>num2</button><button>numpad2</button><set variable="match.players">2</set><push state="playing" /></input>
        <input><button>a</button><button>left</button><set variable="options.smart">0</set></input>
        <input><button>d</button><button>right</button><set variable="options.smart">1</set></input>
      </inputs>
    </state>
    <state name="playing">
      <objects>
        <object name="whoseturn">
          <sprite name="x"><text style="hud"><content>x to move</content><color>color.red</color></text></sprite>
          <sprite name="o"><text style="hud"><content>o to move</content><color>color.cyan</color></text></sprite>
          <position><x><centered /></x><y>24</y></position>
        </object>
        <!-- the grid: lines between the squares, the board showing through -->
        <object name="lines">
          <sprite><rectangle><width>square * 3</width><height>square * 3</height><color>color.darkgrey</color></rectangle></sprite>
          <position><x>left</x><y>top</y></position>
        </object>
        <group name="squares">
          <columns>3</columns>
          <rows>3</rows>
          <padding><x>6</x><y>6</y></padding>
          <sprite><rectangle><width>square - 6</width><height>square - 6</height><color>color.black</color></rectangle></sprite>
          <position><x>left + 3</x><y>top + 3</y></position>
        </group>

        <map name="grid">
          <tile><width>square</width><height>square</height></tile>
          <position><x>left</x><y>top</y></position>
          <columns>3</columns>
          <rows>3</rows>
          <cells />
          <group name="x" class="x">
            <sprite>
              <bitmap style="x">
                <row>**.......**</row>
                <row>***.....***</row>
                <row>.***...***.</row>
                <row>..***.***..</row>
                <row>...*****...</row>
                <row>....***....</row>
                <row>...*****...</row>
                <row>..***.***..</row>
                <row>.***...***.</row>
                <row>***.....***</row>
                <row>**.......**</row>
              </bitmap>
            </sprite>
            <moves />
          </group>
          <group name="o" class="o">
            <sprite>
              <bitmap style="o">
                <row>...*****...</row>
                <row>..*******..</row>
                <row>.***...***.</row>
                <row>***.....***</row>
                <row>**.......**</row>
                <row>**.......**</row>
                <row>**.......**</row>
                <row>***.....***</row>
                <row>.***...***.</row>
                <row>..*******..</row>
                <row>...*****...</row>
              </bitmap>
            </sprite>
            <moves />
          </group>
          <checks>
            <line class="x"><atleast>3</atleast><become object="over.winner" sprite="x" /><set variable="match.won">1</set></line>
            <line class="o"><atleast>3</atleast><become object="over.winner" sprite="o" /><set variable="match.won">1</set></line>
          </checks>
        </map>

        <!-- the cursor, on a map of its own over the grid -->
        <map name="pointer">
          <tile><width>square</width><height>square</height></tile>
          <position><x>left</x><y>top</y></position>
          <cells />
          <row>...</row>
          <row>.c.</row>
          <row>...</row>
          <object name="cursor" char="c">
            <sprite name="x">
              <bitmap style="cursor">
                <row>*********</row>
                <row>*.......*</row>
                <row>*.......*</row>
                <row>*.......*</row>
                <row>*.......*</row>
                <row>*.......*</row>
                <row>*.......*</row>
                <row>*.......*</row>
                <row>*********</row>
              </bitmap>
            </sprite>
            <sprite name="o">
              <bitmap style="cursor">
                <row>*********</row>
                <row>*.......*</row>
                <row>*.......*</row>
                <row>*.......*</row>
                <row>*.......*</row>
                <row>*.......*</row>
                <row>*.......*</row>
                <row>*.......*</row>
                <row>*********</row>
              </bitmap>
            </sprite>
            <sprite name="cpu">
              <bitmap style="cursor">
                <row>*********</row>
                <row>*.......*</row>
                <row>*.......*</row>
                <row>*.......*</row>
                <row>*.......*</row>
                <row>*.......*</row>
                <row>*.......*</row>
                <row>*.......*</row>
                <row>*********</row>
              </bitmap>
            </sprite>
            <actions>
              <action name="up"><hop direction="up" /></action>
              <action name="down"><hop direction="down" /></action>
              <action name="left"><hop direction="left" /></action>
              <action name="right"><hop direction="right" /></action>
              <action name="point"><track /></action>
              <action name="xput">
                <put class="x" />
                <play sound="mark" />
                <inc variable="match.made" />
                <set variable="cursor.turn">2</set>
                <become sprite="o" />
                <become object="whoseturn" sprite="o" />
              </action>
              <action name="oput">
                <put class="o" />
                <play sound="mark" />
                <inc variable="match.made" />
                <set variable="cursor.turn">1</set>
                <become sprite="x" />
                <become object="whoseturn" sprite="x" />
              </action>
            </actions>
            <!-- whose turn: 1 x, 2 o -->
            <variables>
              <variable name="turn">1</variable>
            </variables>
          </object>
        </map>
      </objects>
      <inputs>
        <input><button>w</button><button>up</button><button>pad1.up</button><trigger object="cursor" action="up" /></input>
        <input><button>s</button><button>down</button><button>pad1.down</button><trigger object="cursor" action="down" /></input>
        <input><button>a</button><button>left</button><button>pad1.left</button><trigger object="cursor" action="left" /></input>
        <input><button>d</button><button>right</button><button>pad1.right</button><trigger object="cursor" action="right" /></input>
        <input>
          <button>space</button><button>pad1.a</button><button>mouse.left</button>
          <trigger object="cursor" action="xput" from="x" />
          <trigger object="cursor" action="oput" from="o" />
        </input>
        <input axis="mouse.x">
          <trigger object="cursor" action="point" from="x" />
          <trigger object="cursor" action="point" from="o" />
        </input>
        <input axis="mouse.y">
          <trigger object="cursor" action="point" from="x" />
          <trigger object="cursor" action="point" from="o" />
        </input>
        <!-- the computer's key: only its look answers it -->
        <input><button>f12</button><trigger object="cursor" action="oput" from="cpu" /></input>
        <input><button>p</button><button>escape</button><button>pad1.start</button><push state="paused" /></input>
      </inputs>
      <conditions>
        <condition object="match" variable="won">
          <equal>1</equal>
          <play sound="win" />
          <push state="over" />
        </condition>
        <!-- nine marks and no line: a draw -->
        <condition object="match" variable="made">
          <atleast>9</atleast>
          <become object="over.winner" sprite="draw" />
          <push state="over" />
        </condition>
        <!-- against the computer, O's turn is its: the cursor takes its look -->
        <condition>
          <all>
            <condition object="match" variable="players"><equal>1</equal></condition>
            <condition object="cursor" variable="turn"><equal>2</equal></condition>
          </all>
          <become object="cursor" sprite="cpu" from="o" />
        </condition>
      </conditions>
      <!-- O's move: easy looks one ahead, smart to the end -->
      <computer>
        <condition>
          <all>
            <condition object="match" variable="players"><equal>1</equal></condition>
            <condition object="options" variable="smart"><equal>0</equal></condition>
            <condition object="cursor" variable="turn"><equal>2</equal></condition>
          </all>
          <think class="o" object="cursor" button="f12"><depth>1</depth></think>
        </condition>
        <condition>
          <all>
            <condition object="match" variable="players"><equal>1</equal></condition>
            <condition object="options" variable="smart"><equal>1</equal></condition>
            <condition object="cursor" variable="turn"><equal>2</equal></condition>
          </all>
          <think class="o" object="cursor" button="f12"><depth>9</depth></think>
        </condition>
      </computer>
    </state>
    <state name="paused">
      <objects>
        <object name="paused">
          <sprite><text style="banner"><content>PAUSED</content></text></sprite>
          <position><x><centered /></x><y><centered /></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input><button>space</button><button>p</button><button>escape</button><button>pad1.start</button><pop /></input>
      </inputs>
    </state>
    <state name="over">
      <objects>
        <object name="winner">
          <sprite name="x"><text style="banner"><content>X WINS</content><color>color.red</color></text></sprite>
          <sprite name="o"><text style="banner"><content>O WINS</content><color>color.cyan</color></text></sprite>
          <sprite name="draw"><text style="banner"><content>A DRAW</content><color>color.yellow</color></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 40</centered></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
        <show object="again" />
      </shows>
      <inputs>
        <input><button>space</button><button>pad1.start</button><reset /></input>
      </inputs>
    </state>
  </states>
</game>
