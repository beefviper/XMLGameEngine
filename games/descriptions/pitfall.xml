<!-- pitfall.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Oct 7, 2026 -->

<!--
  Pitfall!, after David Crane's 1982 Atari 2600 game. Pitfall Harry runs
  through the jungle, one screen at a time, after the treasures hidden in it,
  with a tunnel running under every screen. Logs roll along the path (one that
  rolls over Harry costs points while it does), a tar pit and a fire burn him,
  the crocodiles in the pond can be stood on until they open their jaws, the
  water drowns him, and a scorpion guards the tunnel. Four screens, a treasure
  in each, and the jungle goes round: off the right of the fourth is the
  first again. Take all four treasures before the clock runs out to win.
  Three lives.

  A and D (or the arrows) run, Space jumps, W and S climb the ladder, P or
  Escape pauses.

  How it is written:
  * Harry, the jungle behind him (the canopy, the trunks, the earth and the
    tunnel floor), the score, the clock and the lives are the playing
    state's own objects, there on every screen. The clock is a timer of the
    state taking a second off status.time.
  * The four jungle screens are the <scenes> of the playing state. The kit
    holds the pieces a screen is made of: the whole path, the banks of a
    pond, a path with a ladder hole, the ladder, the logs, a tar pit, the
    pond with its crocodiles and their jaws, a fire, a scorpion and a
    treasure. Each screen takes what it has and changes what differs: the
    fourth screen's scorpion is further along, and each treasure has its own
    look and place. What a screen's treasure is worth is the screen's
    variable `worth`.
  * The kit also holds an unseen strip (<drawn>false</drawn>) for each side,
    and every screen takes both. Harry walking into one goes that way: each
    screen's <ways> say which screen lies east and which west, and the
    strip says <enter way="east" />. His own rule for that side <move>s him
    in at the far side. East of the fourth screen is the first, so the
    jungle goes round. A screen left stays as it was:
    a treasure taken stays taken, a log rolls on from where it was.
  * Harry falls (an <acceleration>), stands on the ground with <land />,
    jumps with <leap> and climbs the ladder of the fourth screen with
    <climb>, as Jumpman does in Donkey Kong.
  * The score, the lives, the clock and the treasures found are variables
    of `status`, an object never drawn, so any rule can put Harry back where
    he started with <reset object="harry" /> without losing them. A treasure
    taken counts itself in status.found and four win: a condition counting
    the treasures left would see only the screen Harry is on.
  * The crocodiles are platforms; their jaws are three hidden hazards that the
    pond <reveal>s every three seconds and that <die /> again on a timer of
    their own a second later.
  * Paused, won and game over draw the jungle still underneath (<show state>).
  Not in it: the swinging vines, quicksand, the wall at the end of the tunnel,
  and a tunnel that goes three screens at a time.
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../xge/xgedef.xsd">
  <window name="Pitfall!">
    <width>640</width>
    <height>480</height>
    <background>color.black</background>
    <fullscreen>false</fullscreen>
    <framerate>60</framerate>
  </window>
  <variables>
    <variable name="margin">10</variable>
    <!-- the top of the jungle path and of the tunnel floor -->
    <variable name="surface">300</variable>
    <variable name="tunnel">440</variable>
    <variable name="thick">16</variable>
    <variable name="pull">0.4</variable>
    <variable name="run">2.5</variable>
    <variable name="climbstep">2</variable>
    <variable name="leapheight">48</variable>
    <variable name="roll">1.5</variable>
    <variable name="crawl">1</variable>
    <!-- what a rolling log does to Harry each time it knocks into him: the
         points it takes away and how far back it throws him -->
    <variable name="bump">50</variable>
    <variable name="knock">24</variable>
  </variables>
  <sounds>
    <sound name="jump" wave="square">
      <volume>0.2</volume>
      <note pitch="C5" to="G5">0.1</note>
    </sound>
    <sound name="treasure" wave="square">
      <volume>0.25</volume>
      <note pitch="E5">0.08</note>
      <note pitch="G5">0.08</note>
      <note pitch="C6">0.08</note>
      <note pitch="E6">0.2</note>
    </sound>
    <sound name="die" wave="triangle">
      <volume>0.4</volume>
      <note pitch="G4" to="G2">0.6</note>
    </sound>
    <sound name="thud" wave="noise">
      <volume>0.3</volume>
      <note pitch="400" to="80">0.12</note>
    </sound>
    <sound name="snap" wave="noise">
      <volume>0.2</volume>
      <note pitch="2000" to="600">0.1</note>
    </sound>
  </sounds>
  <styles>
    <style name="banner"><size>100</size><color>color.yellow</color></style>
    <style name="prompt"><size>40</size></style>
    <style name="hud"><size>28</size></style>
  </styles>
  <objects>
    <!-- after a game, in both endings -->
    <object name="again">
      <sprite>
        <text style="prompt">
          <content>spacebar to play again</content>
        </text>
      </sprite>
      <position><x><centered /></x><y><centered>window.height.center + 70</centered></y></position>
    </object>
  </objects>
  <states>
    <state name="title">
      <objects>
        <object name="title">
          <sprite>
            <text style="banner">
              <content>PITFALL!</content>
            </text>
          </sprite>
          <position><x><centered /></x><y><centered>window.height.center - 140</centered></y></position>
        </object>
        <object name="help">
          <sprite>
            <text>
              <content>find the four treasures before time runs out</content>
              <size>26</size>
              <color>color.white</color>
            </text>
          </sprite>
          <position><x><centered /></x><y><centered>window.height.center - 40</centered></y></position>
        </object>
        <object name="keys">
          <sprite>
            <text>
              <content>a and d run, space jumps, w and s climb</content>
              <size>22</size>
              <color>color.lightgrey</color>
            </text>
          </sprite>
          <position><x><centered /></x><y><centered>window.height.center + 10</centered></y></position>
        </object>
        <object name="start">
          <sprite>
            <text style="prompt">
              <content>spacebar to start</content>
            </text>
          </sprite>
          <position><x><centered /></x><y><centered>window.height.center + 110</centered></y></position>
        </object>
      </objects>
      <inputs>
        <input button="space"><push state="playing" /></input>
      </inputs>
    </state>

    <state name="playing">
      <objects>
        <!-- what is kept from screen to screen; never drawn -->
        <object name="status">
          <variables>
            <variable name="score">2000</variable>
            <variable name="lives">3</variable>
            <variable name="time">180</variable>
            <variable name="found">0</variable>
          </variables>
        </object>

        <!-- the jungle behind it all: the canopy, the trunks, the earth between
             the path and the tunnel, and the tunnel floor under every screen -->
        <object name="canopy">
          <sprite>
            <rectangle>
              <width>window.right</width>
              <height>90</height>
              <color>color.forestgreen</color>
            </rectangle>
          </sprite>
          <position><x>0</x><y>50</y></position>
        </object>
        <group name="trunks">
          <sprite>
            <rectangle>
              <width>14</width>
              <height>surface - 140</height>
              <color>color.brown</color>
            </rectangle>
          </sprite>
          <position><y>140</y></position>
          <member><position><x>70</x></position></member>
          <member><position><x>230</x></position></member>
          <member><position><x>410</x></position></member>
          <member><position><x>560</x></position></member>
        </group>
        <object name="earth">
          <sprite>
            <rectangle>
              <width>window.right</width>
              <height>24</height>
              <color>color.brown</color>
            </rectangle>
          </sprite>
          <position><x>0</x><y>surface + thick</y></position>
        </object>
        <object name="bedrock">
          <sprite>
            <rectangle>
              <width>window.right</width>
              <height>window.bottom - tunnel - thick</height>
              <color>color.brown</color>
            </rectangle>
          </sprite>
          <position><x>0</x><y>tunnel + thick</y></position>
        </object>
        <object name="tunnelfloor" class="ground">
          <sprite>
            <rectangle>
              <width>window.right</width>
              <height>thick</height>
              <color>color.darkgrey</color>
            </rectangle>
          </sprite>
          <position><x>0</x><y>tunnel</y></position>
          <collisions>
            <enabled>true</enabled>
          </collisions>
        </object>

        <!-- Pitfall Harry -->
        <object name="harry">
          <sprite>
            <bitmap>
              <row>...**...</row>
              <row>..****..</row>
              <row>...**...</row>
              <row>...**...</row>
              <row>.******.</row>
              <row>*.****.*</row>
              <row>*.****.*</row>
              <row>*.****.*</row>
              <row>..****..</row>
              <row>..****..</row>
              <row>..*..*..</row>
              <row>..*..*..</row>
              <row>..*..*..</row>
              <row>..*..*..</row>
              <row>..*..*..</row>
              <row>.**..**.</row>
              <scale>2</scale>
              <color>color.white</color>
            </bitmap>
          </sprite>
          <position><x>24</x><y>surface - harry.height</y></position>
          <acceleration><x>0</x><y>pull</y></acceleration>
          <collisions>
            <enabled>true</enabled>
            <!-- through a side of a screen: in at the other side of the next -->
            <collision class="eastside">
              <move direction="left">window.right - 2 * harry.width</move>
            </collision>
            <collision class="westside">
              <move direction="right">window.right - 2 * harry.width</move>
            </collision>
            <collision class="ground">
              <land />
            </collision>
            <collision class="croc">
              <land />
            </collision>
            <!-- a log knocks Harry back the way it rolls; only a leap gets
                 him over it -->
            <collision class="log">
              <dec variable="status.score">bump</dec>
              <move direction="left">knock</move>
              <play sound="thud" />
            </collision>
            <collision class="hazard"><trigger action="lose" /></collision>
            <collision class="water"><trigger action="lose" /></collision>
          </collisions>
          <actions>
            <action name="lose">
              <dec variable="status.lives" />
              <play sound="die" />
              <reset />
            </action>
            <action name="left">
              <move direction="left">run</move>
            </action>
            <action name="right">
              <move direction="right">run</move>
            </action>
            <action name="up">
              <climb direction="up" class="ladder">climbstep</climb>
            </action>
            <action name="down">
              <climb direction="down" class="ladder">climbstep</climb>
            </action>
            <action name="jump">
              <leap>leapheight</leap>
              <play sound="jump" />
            </action>
          </actions>
        </object>

        <!-- what the player sees of status -->
        <object name="score">
          <sprite>
            <text style="hud">
              <number>status.score</number>
            </text>
          </sprite>
          <position><x>margin</x><y>margin</y></position>
        </object>
        <object name="clock">
          <sprite>
            <text style="hud">
              <number>status.time</number>
              <color>color.yellow</color>
            </text>
          </sprite>
          <position><x><centered /></x><y>margin</y></position>
        </object>
        <object name="lives">
          <sprite>
            <text style="hud">
              <number>status.lives</number>
              <color>color.red</color>
            </text>
          </sprite>
          <position><x>window.right - lives.width - margin</x><y>margin</y></position>
        </object>
      </objects>
      <scenes>
        <!-- what a jungle screen is made of -->
        <objects>
          <!-- what Harry stands on: the whole path, the banks of a pond, or a
               path with a ladder hole too narrow to fall down -->
          <object name="path" class="ground">
            <sprite>
              <rectangle>
                <width>window.right</width>
                <height>thick</height>
                <color>color.yellow</color>
              </rectangle>
            </sprite>
            <position><x>0</x><y>surface</y></position>
            <collisions>
              <enabled>true</enabled>
            </collisions>
          </object>
          <group name="banks" class="ground">
            <sprite>
              <rectangle>
                <width>220</width>
                <height>thick</height>
                <color>color.yellow</color>
              </rectangle>
            </sprite>
            <position><y>surface</y></position>
            <collisions>
              <enabled>true</enabled>
            </collisions>
            <member><position><x>0</x></position></member>
            <member>
              <sprite>
                <rectangle>
                  <width>150</width>
                  <height>thick</height>
                  <color>color.yellow</color>
                </rectangle>
              </sprite>
              <position><x>490</x></position>
            </member>
          </group>
          <group name="holepath" class="ground">
            <sprite>
              <rectangle>
                <width>314</width>
                <height>thick</height>
                <color>color.yellow</color>
              </rectangle>
            </sprite>
            <position><y>surface</y></position>
            <collisions>
              <enabled>true</enabled>
            </collisions>
            <member><position><x>0</x></position></member>
            <member><position><x>326</x></position></member>
          </group>
          <!-- the ladder from the path down to the tunnel -->
          <object name="ladder" class="ladder">
            <sprite>
              <rectangle>
                <width>20</width>
                <height>tunnel - surface</height>
                <color>color.lightgrey</color>
              </rectangle>
            </sprite>
            <position><x>310</x><y>surface</y></position>
          </object>

          <!-- two logs rolling along the path -->
          <group name="logs" class="log">
            <sprite>
              <bitmap>
                <row>...******...</row>
                <row>.**********.</row>
                <row>****.***.***</row>
                <row>***.***.****</row>
                <row>****.***.***</row>
                <row>.**********.</row>
                <row>...******...</row>
                <scale>3</scale>
                <color>color.orange</color>
              </bitmap>
            </sprite>
            <position><y>surface - 21</y></position>
            <velocity><x>-roll</x></velocity>
            <collisions>
              <enabled>true</enabled>
              <collision edge="horizontal">
                <wrap />
              </collision>
            </collisions>
            <member><position><x>330</x></position></member>
            <member><position><x>560</x></position></member>
          </group>

          <!-- a tar pit on the path -->
          <object name="tar" class="hazard">
            <sprite>
              <rectangle>
                <width>48</width>
                <height>6</height>
                <color>color.darkgrey</color>
              </rectangle>
            </sprite>
            <position><x>300</x><y>surface - 1</y></position>
            <collisions>
              <enabled>true</enabled>
            </collisions>
          </object>

          <!-- the pond, three crocodiles to cross it on, and their jaws -->
          <object name="pond" class="water">
            <sprite>
              <rectangle>
                <width>270</width>
                <height>32</height>
                <color>color.blue</color>
              </rectangle>
            </sprite>
            <position><x>220</x><y>surface + 4</y></position>
            <collisions>
              <enabled>true</enabled>
            </collisions>
            <timers>
              <timer>
                <every>3</every>
                <reveal object="jaws">3</reveal>
                <play sound="snap" />
              </timer>
            </timers>
          </object>
          <!-- taken before the crocodiles, so that when Harry is on a head as
               the jaws open, the jaws are met first, before he lands -->
          <group name="jaws" class="hazard">
            <sprite>
              <rectangle>
                <width>30</width>
                <height>6</height>
                <color>color.red</color>
              </rectangle>
            </sprite>
            <position><y>surface - 8</y></position>
            <hidden>true</hidden>
            <collisions>
              <enabled>true</enabled>
            </collisions>
            <timers>
              <timer>
                <every>1</every>
                <die />
              </timer>
            </timers>
            <member><position><x>260</x></position></member>
            <member><position><x>340</x></position></member>
            <member><position><x>420</x></position></member>
          </group>
          <group name="crocs" class="croc">
            <sprite>
              <rectangle>
                <width>30</width>
                <height>8</height>
                <color>color.darkgreen</color>
              </rectangle>
            </sprite>
            <position><y>surface - 2</y></position>
            <collisions>
              <enabled>true</enabled>
            </collisions>
            <member><position><x>260</x></position></member>
            <member><position><x>340</x></position></member>
            <member><position><x>420</x></position></member>
          </group>

          <!-- a fire on the path -->
          <object name="fire" class="hazard">
            <sprite>
              <bitmap>
                <row>...*....</row>
                <row>..**..*.</row>
                <row>..***.*.</row>
                <row>.*****..</row>
                <row>.******.</row>
                <row>********</row>
                <row>********</row>
                <row>.******.</row>
                <scale>2</scale>
                <color>color.orange</color>
              </bitmap>
            </sprite>
            <position><x>170</x><y>surface - fire.height</y></position>
            <collisions>
              <enabled>true</enabled>
            </collisions>
          </object>

          <!-- a scorpion pacing the tunnel -->
          <object name="scorpion" class="hazard">
            <sprite>
              <bitmap>
                <row>.......**.</row>
                <row>........*.</row>
                <row>.**.....*.</row>
                <row>*..******.</row>
                <row>.********.</row>
                <row>*.*.*.*.*.</row>
                <scale>2</scale>
                <color>color.white</color>
              </bitmap>
            </sprite>
            <position><x>200</x><y>tunnel - 12</y></position>
            <velocity><x>crawl</x></velocity>
            <collisions>
              <enabled>true</enabled>
              <collision edge="horizontal">
                <bounce />
              </collision>
            </collisions>
          </object>

          <!-- the screen's treasure, a money bag unless the screen says
               otherwise, worth the screen's `worth` -->
          <object name="treasure" class="treasure">
            <sprite>
              <bitmap>
                <row>..****..</row>
                <row>...**...</row>
                <row>.******.</row>
                <row>***..***</row>
                <row>**.****.</row>
                <row>***..***</row>
                <row>.****.**</row>
                <row>..****..</row>
                <scale>2</scale>
                <color>color.lightgrey</color>
              </bitmap>
            </sprite>
            <position><x>580</x><y>surface - treasure.height</y></position>
            <collisions>
              <enabled>true</enabled>
              <collision object="harry">
                <inc variable="status.score">worth</inc>
                <inc variable="status.found" />
                <play sound="treasure" />
                <die />
              </collision>
            </collisions>
          </object>
          <object name="east" class="eastside">
            <sprite>
              <rectangle>
                <width>4</width>
                <height>window.bottom</height>
                <color>color.black</color>
              </rectangle>
            </sprite>
            <position><x>window.right - 4</x><y>0</y></position>
            <drawn>false</drawn>
            <collisions>
              <enabled>true</enabled>
              <collision object="harry">
                <enter way="east" />
              </collision>
            </collisions>
          </object>
          <object name="west" class="westside">
            <sprite>
              <rectangle>
                <width>4</width>
                <height>window.bottom</height>
                <color>color.black</color>
              </rectangle>
            </sprite>
            <position><x>0</x><y>0</y></position>
            <drawn>false</drawn>
            <collisions>
              <enabled>true</enabled>
              <collision object="harry">
                <enter way="west" />
              </collision>
            </collisions>
          </object>
        </objects>

        <!-- screen 1: rolling logs, and the money bag -->
        <scene name="screen1">
          <ways>
            <way name="east" scene="screen2" />
            <way name="west" scene="screen4" />
          </ways>
          <variables>
            <variable name="worth">2000</variable>
          </variables>
          <objects>
            <object name="path" />
            <group name="logs" />
            <object name="treasure" />
            <object name="east" />
            <object name="west" />
          </objects>
        </scene>

        <!-- screen 2: the tar pit, the silver bar, and a scorpion below -->
        <scene name="screen2">
          <ways>
            <way name="east" scene="screen3" />
            <way name="west" scene="screen1" />
          </ways>
          <variables>
            <variable name="worth">3000</variable>
          </variables>
          <objects>
            <object name="path" />
            <object name="tar" />
            <object name="scorpion" />
            <object name="treasure">
              <sprite>
                <bitmap>
                  <row>..********</row>
                  <row>.********.</row>
                  <row>**********</row>
                  <row>*********.</row>
                  <row>********..</row>
                  <scale>2</scale>
                  <color>color.white</color>
                </bitmap>
              </sprite>
              <position><x>570</x></position>
            </object>
            <object name="east" />
            <object name="west" />
          </objects>
        </scene>

        <!-- screen 3: the crocodile pond, and the gold bar on the far bank -->
        <scene name="screen3">
          <ways>
            <way name="east" scene="screen4" />
            <way name="west" scene="screen2" />
          </ways>
          <variables>
            <variable name="worth">4000</variable>
          </variables>
          <objects>
            <group name="banks" />
            <object name="pond" />
            <group name="jaws" />
            <group name="crocs" />
            <object name="treasure">
              <sprite>
                <bitmap>
                  <row>..********</row>
                  <row>.********.</row>
                  <row>**********</row>
                  <row>*********.</row>
                  <row>********..</row>
                  <scale>2</scale>
                  <color>color.yellow</color>
                </bitmap>
              </sprite>
            </object>
            <object name="east" />
            <object name="west" />
          </objects>
        </scene>

        <!-- screen 4: a fire, the ladder down, and the ring in the tunnel past
             a scorpion -->
        <scene name="screen4">
          <ways>
            <way name="east" scene="screen1" />
            <way name="west" scene="screen3" />
          </ways>
          <variables>
            <variable name="worth">5000</variable>
          </variables>
          <objects>
            <group name="holepath" />
            <object name="ladder" />
            <object name="fire" />
            <object name="treasure">
              <sprite>
                <bitmap>
                  <row>...**...</row>
                  <row>..****..</row>
                  <row>...**...</row>
                  <row>.**..**.</row>
                  <row>*......*</row>
                  <row>*......*</row>
                  <row>.**..**.</row>
                  <row>...**...</row>
                  <scale>2</scale>
                  <color>color.cyan</color>
                </bitmap>
              </sprite>
              <position><y>tunnel - treasure.height</y></position>
            </object>
            <object name="scorpion">
              <position><x>400</x></position>
            </object>
            <object name="east" />
            <object name="west" />
          </objects>
        </scene>
      </scenes>
      <inputs>
        <input button="a left"><trigger object="harry" action="left" /></input>
        <input button="d right"><trigger object="harry" action="right" /></input>
        <input button="w up"><trigger object="harry" action="up" /></input>
        <input button="s down"><trigger object="harry" action="down" /></input>
        <input button="space"><trigger object="harry" action="jump" /></input>
        <input button="p escape"><push state="paused" /></input>
      </inputs>
      <!-- how a game ends: out of lives or time, or every treasure found -->
      <conditions>
        <condition object="status" variable="lives">
          <atmost>0</atmost>
          <push state="gameover" />
        </condition>
        <condition object="status" variable="time">
          <atmost>0</atmost>
          <push state="gameover" />
        </condition>
        <condition object="status" variable="found">
          <atleast>4</atleast>
          <push state="youwin" />
        </condition>
      </conditions>
      <timers>
        <timer>
          <every>1</every>
          <dec variable="status.time" />
        </timer>
      </timers>
    </state>

    <state name="paused">
      <objects>
        <object name="paused">
          <sprite>
            <text style="banner">
              <content>PAUSED</content>
              <color>color.white</color>
            </text>
          </sprite>
          <position><x><centered /></x><y><centered /></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input button="space p escape"><pop /></input>
      </inputs>
    </state>
    <state name="youwin">
      <objects>
        <object name="message">
          <sprite>
            <text style="banner">
              <content>YOU WIN</content>
              <color>color.green</color>
            </text>
          </sprite>
          <position><x><centered /></x><y><centered>window.height.center - 60</centered></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
        <show object="again" />
      </shows>
      <inputs>
        <input button="space"><reset /></input>
      </inputs>
    </state>
    <state name="gameover" from="youwin">
      <objects>
        <object name="message">
          <sprite>
            <text style="banner">
              <content>GAME OVER</content>
              <color>color.red</color>
            </text>
          </sprite>
        </object>
      </objects>
    </state>
  </states>
</game>
