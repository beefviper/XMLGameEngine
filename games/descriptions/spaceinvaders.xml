<!-- spaceinvaders.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Sept 18, 2020 -->

<!--
  Space Invaders, after Taito's 1978 arcade game. Five rows of eleven march
  from side to side, stepping down at each edge and dropping bombs, faster
  the fewer of them are left; a mystery ship crosses the top now and then.
  Shoot them all before they reach the shields; a bomb costs a cannon, three
  cannons. Squids score 30, crabs 20, octopuses 10, the mystery ship 50 to
  200. The best score is kept.

  A and D or the arrows move, Space fires, Pause pauses, Space starts
  and plays again.

  How it is written:
  * The ship and the aliens are <bitmap>s, `pixel` (5) real pixels to a
    character. The aliens are one group of 11 columns and 5 rows in
    lockstep, so they march, bounce and step down as one block; the squids'
    two pictures and their <animation> are the group's, and rows 2 and 3
    (crabs) and 4 and 5 (octopuses) change the pictures and the worth.
  * A hit alien leaves a blast, spawned where it was, that
    goes after a quarter of a second.
  * The march speeds up: whenever no more aliens are left than pace.next,
    a condition sets the block's speed half as fast again and halves next.
  * The shields are pictures with a pixel collision, so a shot or bomb that
    hits one cuts a ragged <hole> in it.
  * A bomb on the cannon blasts it too, and pushes "blasted", which holds
    the invasion still for a second, as the arcade game does.
  * The march is the playing state's <music>: four notes round and round.
  * Paused, blasted and both endings draw the game still underneath.
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../xgedef.xsd">
  <window name="Space Invaders">
    <width>1024</width>
    <height>768</height>
  </window>
  <variables>
    <variable name="margin">80</variable>
    <variable name="top">120</variable>
    <variable name="pixel">5</variable>
    <variable name="gap">15</variable>
    <variable name="animation.seconds">1</variable>
    <variable name="step">2</variable>
    <variable name="shieldtop">540</variable>
  </variables>
  <styles>
    <style name="banner"><size>128</size><color>color.green</color></style>
    <style name="hud"><size>36</size><color>color.white</color></style>
    <style name="prompt"><size>48</size><color>color.white</color></style>
  </styles>
  <objects>
    <object name="bullet" class="projectile">
      <sprite><rectangle><width>4</width><height>24</height></rectangle></sprite>
      <velocity><y>-12</y></velocity>
      <most>1</most>
      <collisions>
        <collision edge="all"><despawn /></collision>
        <collision class="aliens"><despawn /></collision>
        <collision class="shield"><despawn /></collision>
        <collision class="bomb"><despawn /></collision>
        <collision class="ufo"><despawn /></collision>
      </collisions>
    </object>
    <!-- a bomb, three at most, a zigzag that wriggles as it falls,
         dropped by any alien (each faces down) after a wait of its own -->
    <object name="bomb" class="bomb">
      <sprite name="a">
        <bitmap from="bomb-a" />
      </sprite>
      <sprite name="b">
        <bitmap from="bomb-b" />
      </sprite>
      <animation><seconds>0.1</seconds><frame sprite="a" /><frame sprite="b" /></animation>
      <velocity><y>5</y></velocity>
      <most>3</most>
      <collisions>
        <collision edge="all"><despawn /></collision>
        <collision object="player"><despawn /></collision>
        <collision class="shield"><despawn /></collision>
        <collision class="ground"><despawn /></collision>
        <collision object="bullet"><despawn /></collision>
      </collisions>
    </object>
    <!-- what a hit leaves for a moment -->
    <object name="blast" class="blast">
      <sprite name="blast">
        <bitmap from="blast" />
      </sprite>
      <animation><seconds>0.25</seconds><once /><frame sprite="blast" /><then><despawn /></then></animation>
      <most>2</most>
    </object>
  </objects>
  <keeps>
    <keep object="best" />
  </keeps>
  <states>
    <objects>
      <object name="player">
        <sprite>
          <bitmap from="player" />
        </sprite>
        <position><x><centered /></x><y>
          <subtract>
            <value>window.bottom</value>
            <value><multiply><value>player.height</value><value>2</value></multiply></value>
          </subtract>
        </y></position>
        <collisions>
          <collision edge="horizontal"><stick /></collision>
          <collision class="bomb">
            <dec variable="player.lives" />
            <inc variable="player.struck" />
            <spawn object="blast" />
            <play sound="playerhit" />
          </collision>
        </collisions>
        <actions>
          <action name="left"><move direction="left">step</move></action>
          <action name="right"><move direction="right">step</move></action>
          <action name="gun">
            <fire object="bullet" />
            <play sound="shoot" />
          </action>
        </actions>
        <variables>
          <variable name="score">0</variable>
          <variable name="lives">3</variable>
          <variable name="struck">0</variable>
        </variables>
      </object>
      <!-- the best score, kept from game to game -->
      <object name="best">
        <sprite><text style="hud"><content>HI-SCORE</content><number>best.score</number></text></sprite>
        <position><x><centered /></x><y>10</y></position>
        <variables><variable name="score">0</variable></variables>
      </object>
      <object name="continue">
        <sprite><text style="prompt"><content>spacebar to continue</content></text></sprite>
        <position><x><centered /></x><y><add><value>window.height.center</value><value>60</value></add></y></position>
      </object>
    </objects>
    <state name="title">
      <objects>
        <object name="title">
          <sprite><text style="banner"><content>SPACE INVADERS</content><size>110</size></text></sprite>
          <position><x><centered /></x><y><centered><offset>-100</offset></centered></y></position>
        </object>
        <object name="table">
          <sprite><text style="hud"><content>squid 30   crab 20   octopus 10   mystery ?</content><size>28</size></text></sprite>
          <position><x><centered /></x><y><add><value>window.height.center</value><value>20</value></add></y></position>
        </object>
      </objects>
      <shows>
        <show object="player" />
        <show object="best" />
      </shows>
      <inputs>
        <input button="space"><push state="playing" /></input>
      </inputs>
    </state>
    <state name="playing">
      <objects>
        <group name="shields" class="shield">
          <columns>4</columns>
          <rows>1</rows>
          <padding><x>150</x><y>0</y></padding>
          <sprite>
            <bitmap from="shields" />
          </sprite>
          <position><x>111</x><y>shieldtop</y></position>
          <collisions>
            <type>pixel</type>
            <collision object="bullet"><hole>10<rough>0.6</rough></hole></collision>
            <collision class="bomb"><hole>8<rough>0.6</rough></hole></collision>
          </collisions>
        </group>
        <object name="ground" class="ground">
          <sprite><rectangle><width>window.right</width><height>3</height><color>color.green</color></rectangle></sprite>
          <position><x>0</x><y><subtract><value>window.bottom</value><value>30</value></subtract></y></position>
        </object>
        <!-- the mystery ship: across the top now and then, 50 to 200 points -->
        <object name="ufo" class="ufo">
          <sprite>
            <bitmap from="ufo" />
          </sprite>
          <position><x><subtract><value>0</value><value>ufo.width</value></subtract></x><y>60</y></position>
          <velocity><x>2.5</x></velocity>
          <waiting />
          <collisions>
            <collision edge="right"><die /></collision>
            <collision object="bullet">
              <inc variable="player.score">
                <multiply>
                  <value>50</value>
                  <value><ceiling><value>self.worth</value></ceiling></value>
                </multiply>
              </inc>
              <spawn object="blast" />
              <play sound="alienhit" />
              <die />
            </collision>
          </collisions>
          <variables><variable name="worth"><random><min>0.01</min><max>4</max></random></variable></variables>
        </object>
        <group name="aliens" class="aliens">
          <columns>11</columns>
          <rows>5</rows>
          <padding><x>gap</x><y>gap</y></padding>
          <sprite name="a">
            <bitmap from="aliens-a" />
          </sprite>
          <sprite name="b">
            <bitmap from="aliens-b" />
          </sprite>
          <animation>
            <seconds>animation.seconds</seconds>
            <frame sprite="a" />
            <frame sprite="b" />
          </animation>
          <position><x>margin</x><y>top</y></position>
          <velocity><x>2</x></velocity>
          <facing>down</facing>
          <collisions>
            <lockstep />
            <collision edge="horizontal">
              <bounce />
              <move direction="down">10</move>
            </collision>
            <collision object="bullet">
              <inc variable="player.score">self.worth</inc>
              <spawn object="blast" />
              <play sound="alienhit" />
              <die />
            </collision>
          </collisions>
          <variables><variable name="worth">30</variable></variables>
          <timers>
            <timer>
              <every><random><min>2</min><max>25</max></random></every>
              <fire object="bomb" />
            </timer>
          </timers>
          <row><number>2</number><number>3</number>
            <sprite name="a">
              <bitmap from="aliens-row2-a" />
            </sprite>
            <sprite name="b">
              <bitmap from="aliens-row2-b" />
            </sprite>
            <variables><variable name="worth">20</variable></variables>
          </row>
          <row><number>4</number><number>5</number>
            <sprite name="a">
              <bitmap from="aliens-row4-a" />
            </sprite>
            <sprite name="b">
              <bitmap from="aliens-row4-b" />
            </sprite>
            <variables><variable name="worth">10</variable></variables>
          </row>
        </group>
        <!-- how many aliens may be left before the march speeds up again -->
        <object name="pace">
          <variables><variable name="next">28</variable></variables>
        </object>
        <object name="score">
          <sprite><text style="hud"><content>SCORE</content><number>player.score</number></text></sprite>
          <position><x>20</x><y>10</y></position>
        </object>
        <object name="lives">
          <sprite><text style="hud"><number>player.lives</number><size>24</size><color>color.green</color></text></sprite>
          <position><x>20</x><y><subtract><value>window.bottom</value><value>27</value></subtract></y></position>
        </object>
      </objects>
      <shows>
        <show object="player" />
        <show object="bullet" />
        <show object="best" />
      </shows>
      <music sound="march" />
      <inputs>
        <input><button>a</button><button>left</button><trigger object="player" action="left" /></input>
        <input><button>d</button><button>right</button><trigger object="player" action="right" /></input>
        <input button="space"><trigger object="player" action="gun" /></input>
        <input><button>pause</button><button>pad1.start</button><push state="paused" /></input>
      </inputs>
      <conditions>
        <condition class="aliens">
          <remaining>0</remaining>
          <become object="over.message" sprite="won" />
          <push state="over" />
        </condition>
        <condition object="player" variable="lives">
          <atmost>0</atmost>
          <become object="over.message" sprite="lost" />
          <push state="over" />
        </condition>
        <!-- the block down on the shields: the invasion has landed -->
        <condition class="aliens" variable="y" total="highest">
          <atleast><subtract><value>shieldtop</value><value>40</value></subtract></atleast>
          <become object="over.message" sprite="lost" />
          <push state="over" />
        </condition>
        <condition object="player" variable="struck">
          <atleast>1</atleast>
          <dec variable="player.struck" />
          <push state="blasted" />
        </condition>
        <condition class="aliens" total="count">
          <atmost>pace.next</atmost>
          <set variable="aliens.velocity.x"><multiply><value>aliens.1.1.velocity.x</value><value>1.3</value></multiply></set>
          <set variable="pace.next"><divide><value>pace.next</value><value>2</value></divide></set>
        </condition>
        <condition object="player" variable="score">
          <above>best.score</above>
          <copy variable="player.score" into="best.score" />
        </condition>
      </conditions>
      <timers>
        <timer>
          <every><random><min>20</min><max>30</max></random></every>
          <reveal object="ufo" />
          <play sound="ufo" />
        </timer>
      </timers>
    </state>
    <state name="paused">
      <objects>
        <object name="paused">
          <sprite><text style="banner"><content>paused</content><color>color.white</color></text></sprite>
          <position><x><centered /></x><y><centered /></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input><button>pause</button><button>pad1.start</button><pop /></input>
      </inputs>
    </state>
    <!-- the cannon hit: everything holds still for a second, then the bombs are gone -->
    <state name="blasted">
      <shows>
        <show state="playing" />
      </shows>
      <inputs />
      <timers>
        <!-- every, not after: it counts only while this state is current, so
             each visit starts the second again -->
        <timer>
          <after>1</after>
          <despawn object="bomb" />
          <pop />
        </timer>
      </timers>
    </state>
    <state name="over">
      <objects>
        <object name="message">
          <sprite name="lost"><text style="banner"><content>GAME OVER</content><color>color.red</color></text></sprite>
          <sprite name="won"><text style="banner"><content>YOU WIN</content></text></sprite>
          <position><x><centered /></x><y><subtract><value>window.height.center</value><value>150</value></subtract></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
        <show object="continue" />
      </shows>
      <inputs>
        <input button="space"><reset /></input>
      </inputs>
    </state>
  </states>
  <sounds>
    <sound name="shoot" wave="square"><volume>0.15</volume><note pitch="C6" to="C5">0.08</note></sound>
    <sound name="alienhit" wave="noise"><volume>0.3</volume><note pitch="6000" to="1500">0.15</note></sound>
    <sound name="playerhit" wave="noise"><volume>0.45</volume><note pitch="2000" to="100">0.7</note></sound>
    <!-- the mystery ship's warble as it comes on -->
    <sound name="ufo" wave="square">
      <volume>0.12</volume>
      <note pitch="G5" to="G6">0.15</note>
      <note pitch="G6" to="G5">0.15</note>
      <note pitch="G5" to="G6">0.15</note>
      <note pitch="G6" to="G5">0.15</note>
    </sound>
    <!-- the march: four falling notes, round and round -->
    <sound name="march" wave="triangle">
      <loop />
      <volume>0.35</volume>
      <note pitch="F2">0.1</note>
      <rest>0.4</rest>
      <note pitch="E2">0.1</note>
      <rest>0.4</rest>
      <note pitch="D#2">0.1</note>
      <rest>0.4</rest>
      <note pitch="D2">0.1</note>
      <rest>0.4</rest>
    </sound>
  </sounds>
  <pictures>
    <bitmap name="bomb-a"><row>.*</row><row>*.</row><row>.*</row><row>*.</row><row>.*</row><scale>3</scale></bitmap>
    <bitmap name="bomb-b"><row>*.</row><row>.*</row><row>*.</row><row>.*</row><row>*.</row><scale>3</scale></bitmap>
    <bitmap name="blast">
      <row>....*...*....</row>
      <row>.*...*.*...*.</row>
      <row>..*.......*..</row>
      <row>...*.....*...</row>
      <row>**.........**</row>
      <row>...*.....*...</row>
      <row>..*..*.*..*..</row>
      <row>.*..*...*..*.</row>
      <scale><subtract><value>pixel</value><value>1</value></subtract></scale>
    </bitmap>
    <bitmap name="player">
      <row>.....*.....</row>
      <row>....***....</row>
      <row>....***....</row>
      <row>.*********.</row>
      <row>***********</row>
      <row>***********</row>
      <row>***********</row>
      <scale>pixel</scale>
      <color>color.green</color>
    </bitmap>
    <bitmap name="shields">
      <row>....**************....</row>
      <row>...****************...</row>
      <row>..******************..</row>
      <row>.********************.</row>
      <row>**********************</row>
      <row>**********************</row>
      <row>**********************</row>
      <row>**********************</row>
      <row>**********************</row>
      <row>**********************</row>
      <row>**********************</row>
      <row>*******........*******</row>
      <row>******..........******</row>
      <row>*****............*****</row>
      <row>*****............*****</row>
      <row>*****............*****</row>
      <scale>4</scale>
      <color>color.green</color>
    </bitmap>
    <bitmap name="ufo">
      <row>.....******.....</row>
      <row>...**********...</row>
      <row>..************..</row>
      <row>.**.**.**.**.**.</row>
      <row>****************</row>
      <row>..***..**..***..</row>
      <row>...*........*...</row>
      <scale><subtract><value>pixel</value><value>1</value></subtract></scale>
      <color>color.red</color>
    </bitmap>
    <bitmap name="aliens-a">
      <row>....***....</row>
      <row>...*****...</row>
      <row>..*******..</row>
      <row>.**.***.**.</row>
      <row>.*********.</row>
      <row>...*.*.*...</row>
      <row>..*..*..*..</row>
      <row>...*.*.*...</row>
      <scale>pixel</scale>
      <color>color.magenta</color>
    </bitmap>
    <bitmap name="aliens-b">
      <row>....***....</row>
      <row>...*****...</row>
      <row>..*******..</row>
      <row>.**.***.**.</row>
      <row>.*********.</row>
      <row>..*..*..*..</row>
      <row>.*...*...*.</row>
      <row>..*.....*..</row>
      <scale>pixel</scale>
      <color>color.magenta</color>
    </bitmap>
    <bitmap name="aliens-row2-a">
      <row>..*.....*..</row>
      <row>...*...*...</row>
      <row>..*******..</row>
      <row>.**.***.**.</row>
      <row>***********</row>
      <row>*.*******.*</row>
      <row>*.*.....*.*</row>
      <row>...**.**...</row>
      <color>color.cyan</color>
    </bitmap>
    <bitmap name="aliens-row2-b">
      <row>..*.....*..</row>
      <row>*..*...*..*</row>
      <row>*.*******.*</row>
      <row>***.***.***</row>
      <row>***********</row>
      <row>.*********.</row>
      <row>..*.....*..</row>
      <row>.*.......*.</row>
      <color>color.cyan</color>
    </bitmap>
    <bitmap name="aliens-row4-a">
      <row>...*****...</row>
      <row>.*********.</row>
      <row>***********</row>
      <row>***..*..***</row>
      <row>***********</row>
      <row>...**.**...</row>
      <row>..**...**..</row>
      <row>***.....***</row>
      <color>color.white</color>
    </bitmap>
    <bitmap name="aliens-row4-b">
      <row>...*****...</row>
      <row>.*********.</row>
      <row>***********</row>
      <row>***..*..***</row>
      <row>***********</row>
      <row>..***.***..</row>
      <row>.**.....**.</row>
      <row>..**...**..</row>
      <color>color.white</color>
    </bitmap>
  </pictures>
</game>
