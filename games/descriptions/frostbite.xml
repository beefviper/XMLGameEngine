<!-- frostbite.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Oct 3, 2026 -->

<!--
  Frostbite, after Activision's 1983 game for the Atari 2600. Frostbite Bailey
  lives on the snowy shore along the top of the screen, and builds his igloo
  there from blocks of ice he gets by jumping down onto the floes drifting
  below. Every row of ice he lands on while it is white turns blue and puts
  one more block on the igloo; once all four rows are blue they all turn
  white again. Land in the water and he is lost; the temperature drops a
  degree every second, and at zero he freezes. Snow geese fly along two of
  the rows and push him along if they catch him, off the ice if he is not
  quick. A fish swims along the third row, a bonus if he catches it. When the
  igloo is finished its door appears: walk in, and what is left of the
  temperature is a bonus, and the next night begins, the ice faster. Get home
  three nights running to win.

  W or Up jumps up a row, S or Down jumps down one, A and D or Left and Right
  walk. Pause pauses.

  How it is written:
  * <hop> with <seconds>: a hop between rows takes a moment and passes over
    the water; he only meets what he lands on. Water drowns him unless he is on a floe
    (unless="floe"), and he rides a floe (<ride />).
  * The nights are the <scenes> of the playing state. The ice, the igloo and
    its door are pieces, taken by the first night; each later night is the
    one before (from=) with its own <variables>: how fast the ice drifts and
    what a floe is worth. Walking in through the door goes the way "next".
  * The ice is one <group> of four rows, each with two looks, white and blue,
    and a rule sprite="white" that turns its whole row blue and runs
    Bailey's action "block": the score, the counts, a block of the igloo.
  * The igloo is a pool of hidden blocks, laid out a course at a time, the
    bottom course first, so <reveal> builds it from the ground up.
  * The cold is a state <timer> taking a degree a second off the
    thermometer; another brings the fish back from time to time.
  * Paused, home and frozen draw the shore and the ice still underneath
    (<show state="playing" />).
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../xgedef.xsd">
  <window name="Frostbite">
    <width>800</width>
    <height>600</height>
    <background>color.darkblue</background>
  </window>
  <variables>
    <variable name="shore">125</variable>
    <variable name="row1">192</variable>
    <variable name="rowgap">90</variable>
    <variable name="walk">2</variable>
    <variable name="hoptime">0.35</variable>
    <variable name="igloox">520</variable>
    <variable name="iglooground">112</variable>
    <variable name="margin">10</variable>
  </variables>
  <styles>
    <style name="banner"><size>110</size><color>color.cyan</color></style>
    <style name="prompt"><size>40</size></style>
    <style name="help"><size>30</size></style>
    <style name="hud"><size>26</size><color>color.darkblue</color></style>
  </styles>
  <objects>
    <!-- the snowy shore along the top; below it all is water -->
    <object name="snow">
      <sprite><rectangle><width>window.right</width><height>shore</height><color>color.white</color></rectangle></sprite>
      <position><x>0</x><y>0</y></position>
    </object>
    <object name="water" class="water">
      <sprite><rectangle><width>window.right</width><height><subtract><value>window.bottom</value><value>shore</value></subtract></height><color>color.darkblue</color></rectangle></sprite>
      <position><x>0</x><y>shore</y></position>
      <collisions />
    </object>
    <!-- four rows of three floes, white until landed on -->
    <group name="ice" class="floe">
      <columns>3</columns>
      <rows>1</rows>
      <padding><x>
        <subtract>
          <value>
            <divide>
              <value><add><value>window.right</value><value>115</value></add></value>
              <value>3</value>
            </divide>
          </value>
          <value>115</value>
        </subtract>
      </x></padding>
      <sprite name="white">
        <bitmap from="ice-white" />
      </sprite>
      <sprite name="blue">
        <bitmap from="ice-blue" />
      </sprite>
      <collisions>
        <collision edge="horizontal"><wrap /></collision>
      </collisions>
      <actions>
        <action name="block">
          <inc variable="bailey.score">points</inc>
          <inc variable="bailey.blocks" />
          <inc variable="bailey.blue" />
          <reveal object="igloo" />
          <play sound="block" />
        </action>
      </actions>
      <group name="row1">
        <position><x>0</x><y>row1</y></position>
        <velocity><x><multiply><value>1.2</value><value>drift</value></multiply></x></velocity>
        <collisions>
          <collision object="bailey" sprite="white"><become object="row1" sprite="blue" /><trigger action="block" /></collision>
        </collisions>
      </group>
      <group name="row2">
        <position><x>60</x><y><add><value>row1</value><value>rowgap</value></add></y></position>
        <velocity><x><multiply><value>-1.6</value><value>drift</value></multiply></x></velocity>
        <collisions>
          <collision object="bailey" sprite="white"><become object="row2" sprite="blue" /><trigger action="block" /></collision>
        </collisions>
      </group>
      <group name="row3">
        <position><x>120</x><y>
          <add>
            <value>row1</value>
            <value><multiply><value>2</value><value>rowgap</value></multiply></value>
          </add>
        </y></position>
        <velocity><x><multiply><value>2</value><value>drift</value></multiply></x></velocity>
        <collisions>
          <collision object="bailey" sprite="white"><become object="row3" sprite="blue" /><trigger action="block" /></collision>
        </collisions>
      </group>
      <group name="row4">
        <position><x>30</x><y>
          <add>
            <value>row1</value>
            <value><multiply><value>3</value><value>rowgap</value></multiply></value>
          </add>
        </y></position>
        <velocity><x><multiply><value>-1.4</value><value>drift</value></multiply></x></velocity>
        <collisions>
          <collision object="bailey" sprite="white"><become object="row4" sprite="blue" /><trigger action="block" /></collision>
        </collisions>
      </group>
    </group>
    <!-- the igloo: fifteen blocks hidden until earned, laid a course at a time from the ground up -->
    <group name="igloo" class="igloo">
      <columns>4</columns>
      <rows>1</rows>
      <padding><x>2</x></padding>
      <sprite><rectangle><width>30</width><height>14</height><color>color.lightgrey</color></rectangle></sprite>
      <waiting />
      <group name="course1"><position><x>igloox</x><y><subtract><value>iglooground</value><value>14</value></subtract></y></position></group>
      <group name="course2"><position><x>igloox</x><y><subtract><value>iglooground</value><value>30</value></subtract></y></position></group>
      <group name="course3"><position><x>igloox</x><y><subtract><value>iglooground</value><value>46</value></subtract></y></position></group>
      <group name="dome"><columns>3</columns><position><x><add><value>igloox</value><value>16</value></add></x><y><subtract><value>iglooground</value><value>62</value></subtract></y></position></group>
    </group>
    <!-- the door, which appears once the igloo is finished -->
    <object name="door" class="door">
      <sprite><rectangle><width>24</width><height>30</height><color>color.black</color></rectangle></sprite>
      <position><x><add><value>igloox</value><value>51</value></add></x><y><subtract><value>iglooground</value><value>30</value></subtract></y></position>
      <waiting />
      <collisions />
    </object>
  </objects>
  <states>
    <state name="title">
      <objects>
        <object name="title">
          <sprite><text style="banner"><content>FROSTBITE</content></text></sprite>
          <position><x><centered /></x><y>170</y></position>
        </object>
        <group name="help">
          <rows>2</rows>
          <padding><y>50</y></padding>
          <sprite><text style="help" /></sprite>
          <position><x><centered /></x><y>320</y></position>
          <row number="1"><sprite><text><content>land on white ice to build the igloo, then walk in</content></text></sprite></row>
          <row number="2"><sprite><text><content>w and s jump, a and d walk</content><color>color.lightgrey</color></text></sprite></row>
        </group>
        <object name="start">
          <sprite><text style="prompt"><content>spacebar to start</content></text></sprite>
          <position><x><centered /></x><y>450</y></position>
        </object>
      </objects>
      <inputs>
        <input button="space"><push state="playing" /></input>
      </inputs>
    </state>
    <state name="playing">
      <objects>
        <!-- the thermometer, which holds the temperature -->
        <object name="thermometer">
          <sprite>
            <bitmap from="thermometer" />
          </sprite>
          <position><x><subtract><value>window.right</value><value>150</value></subtract></x><y><add><value>margin</value><value>4</value></add></y></position>
          <variables>
            <variable name="degrees">45</variable>
          </variables>
        </object>
        <!-- snow geese: they push Bailey along with them if they catch him -->
        <group name="geese" class="goose">
          <sprite name="up">
            <bitmap from="geese-up" />
          </sprite>
          <sprite name="down">
            <bitmap from="geese-down" />
          </sprite>
          <animation>
            <interval>0.2</interval>
            <frame sprite="up" />
            <frame sprite="down" />
          </animation>
          <collisions>
            <collision edge="horizontal"><wrap /></collision>
          </collisions>
          <member><position><x>500</x><y>
            <subtract>
              <value><add><value>row1</value><value>rowgap</value></add></value>
              <value>4</value>
            </subtract>
          </y></position><velocity><x>2.4</x></velocity></member>
          <member><position><x>100</x><y>
            <subtract>
              <value>
                <add>
                  <value>row1</value>
                  <value><multiply><value>3</value><value>rowgap</value></multiply></value>
                </add>
              </value>
              <value>4</value>
            </subtract>
          </y></position><velocity><x>2.2</x></velocity></member>
        </group>
        <!-- a fish along the third row: a bonus, back every so often -->
        <object name="fish" class="fish">
          <sprite>
            <bitmap from="fish" />
          </sprite>
          <position><x>700</x><y>
            <subtract>
              <value>
                <add>
                  <value>row1</value>
                  <value><multiply><value>2</value><value>rowgap</value></multiply></value>
                </add>
              </value>
              <value>6</value>
            </subtract>
          </y></position>
          <velocity><x>-1</x></velocity>
          <collisions>
            <collision edge="horizontal"><wrap /></collision>
            <collision object="bailey"><die /></collision>
          </collisions>
        </object>
        <!-- Frostbite Bailey, in his fur hat and parka -->
        <object name="bailey" class="player">
          <sprite>
            <bitmap from="bailey" />
          </sprite>
          <position><x>110</x><y><subtract><value>shore</value><value>40</value><value>5</value></subtract></y></position>
          <collisions>
            <collision edge="horizontal"><stick /></collision>
            <collision class="floe"><ride /></collision>
            <collision class="goose"><ride /></collision>
            <collision class="water" unless="floe">
              <dec variable="bailey.lives" />
              <reset object="thermometer" />
              <play sound="splash" />
              <reset />
            </collision>
            <collision class="fish">
              <inc variable="bailey.score">200</inc>
              <play sound="bonus" />
            </collision>
            <!-- in at the door: the warmth left is a bonus, and the next night -->
            <collision class="door">
              <inc variable="bailey.score"><multiply><value>thermometer.degrees</value><value>10</value></multiply></inc>
              <inc variable="bailey.nights" />
              <set variable="bailey.blocks">0</set>
              <set variable="bailey.blue">0</set>
              <reset object="thermometer" />
              <reset way="next" />
              <enter way="next" />
              <play sound="home" />
              <reset />
            </collision>
          </collisions>
          <actions>
            <action name="left"><move direction="left">walk</move></action>
            <action name="right"><move direction="right">walk</move></action>
            <action name="up">
              <hop direction="up">rowgap<seconds>hoptime</seconds></hop>
              <play sound="jump" />
            </action>
            <action name="down">
              <hop direction="down">rowgap<seconds>hoptime</seconds></hop>
              <play sound="jump" />
            </action>
            <action name="home"><reset /></action>
          </actions>
          <variables>
            <variable name="score">0</variable>
            <variable name="lives">4</variable>
            <variable name="blocks">0</variable>
            <variable name="blue">0</variable>
            <variable name="nights">0</variable>
          </variables>
        </object>
        <!-- along the top -->
        <object name="score">
          <sprite><text style="hud"><content>SCORE</content><number>bailey.score</number></text></sprite>
          <position><x>margin</x><y>margin</y></position>
        </object>
        <object name="lives">
          <sprite><text style="hud"><content>LIVES</content><number>bailey.lives</number></text></sprite>
          <position><x>230</x><y>margin</y></position>
        </object>
        <object name="degrees">
          <sprite><text style="hud"><number>thermometer.degrees</number><color>color.red</color></text></sprite>
          <position><x><subtract><value>window.right</value><value>120</value></subtract></x><y>margin</y></position>
        </object>
      </objects>
      <scenes>
        <scene name="night1">
          <ways>
            <way name="next" scene="night2" />
          </ways>
          <variables>
            <variable name="drift">1</variable>
            <variable name="points">10</variable>
          </variables>
          <objects>
            <object name="snow" />
            <object name="water" />
            <group name="ice" />
            <group name="igloo" />
            <object name="door" />
          </objects>
        </scene>
        <scene name="night2" from="night1">
          <ways>
            <way name="next" scene="night3" />
          </ways>
          <variables>
            <variable name="drift">1.4</variable>
            <variable name="points">20</variable>
          </variables>
        </scene>
        <scene name="night3" from="night2">
          <ways>
            <way name="next" scene="night1" />
          </ways>
          <variables>
            <variable name="drift">1.8</variable>
            <variable name="points">30</variable>
          </variables>
        </scene>
      </scenes>
      <inputs>
        <input><button>a</button><button>left</button><trigger object="bailey" action="left" /></input>
        <input><button>d</button><button>right</button><trigger object="bailey" action="right" /></input>
        <input><button>w</button><button>up</button><trigger object="bailey" action="up" /></input>
        <input><button>s</button><button>down</button><trigger object="bailey" action="down" /></input>
        <input><button>pause</button><button>pad1.start</button><push state="paused" /></input>
      </inputs>
      <conditions>
        <condition object="bailey" variable="lives">
          <atmost>0</atmost>
          <become object="over.message" sprite="lost" />
          <push state="over" />
          <play sound="gameover" />
        </condition>
        <condition object="bailey" variable="nights">
          <atleast>3</atleast>
          <become object="over.message" sprite="won" />
          <push state="over" />
        </condition>
        <condition object="thermometer" variable="degrees">
          <atmost>0</atmost>
          <dec variable="bailey.lives" />
          <reset object="thermometer" />
          <trigger object="bailey" action="home" />
          <play sound="freeze" />
        </condition>
        <condition object="bailey" variable="blue">
          <atleast>4</atleast>
          <become object="ice" sprite="white" />
          <dec variable="bailey.blue">4</dec>
        </condition>
        <condition object="bailey" variable="blocks">
          <atleast>15</atleast>
          <reveal object="door" />
        </condition>
      </conditions>
      <timers>
        <timer>
          <every>1</every>
          <dec variable="thermometer.degrees" />
        </timer>
        <timer>
          <every>12</every>
          <reveal object="fish" />
        </timer>
      </timers>
    </state>
    <state name="paused">
      <objects>
        <object name="paused">
          <sprite><text style="banner"><content>PAUSED</content><color>color.white</color></text></sprite>
          <position><x><centered /></x><y>250</y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input><button>pause</button><button>pad1.start</button><pop /></input>
      </inputs>
    </state>
    <state name="over">
      <objects>
        <object name="message">
          <sprite name="won"><text style="banner"><content>HOME AND WARM</content><size>90</size><color>color.yellow</color></text></sprite>
          <sprite name="lost"><text style="banner"><content>FROZEN SOLID</content><size>90</size></text></sprite>
          <position><x><centered /></x><y>230</y></position>
        </object>
        <object name="again">
          <sprite><text style="prompt"><content>spacebar to play again</content></text></sprite>
          <position><x><centered /></x><y>360</y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input button="space"><reset /></input>
      </inputs>
    </state>
  </states>
  <sounds>
    <sound name="jump" wave="square">
      <volume>0.15</volume>
      <note pitch="C5" to="C6">0.08</note>
    </sound>
    <sound name="block" wave="triangle">
      <volume>0.4</volume>
      <note pitch="G5">0.05</note>
      <note pitch="C6">0.08</note>
    </sound>
    <sound name="splash" wave="noise">
      <volume>0.4</volume>
      <note pitch="5000" to="300">0.5</note>
    </sound>
    <sound name="freeze" wave="sine">
      <volume>0.4</volume>
      <note pitch="E6" to="E4">0.8</note>
    </sound>
    <sound name="bonus" wave="square">
      <volume>0.2</volume>
      <note pitch="C6">0.05</note>
      <note pitch="E6">0.05</note>
      <note pitch="G6">0.1</note>
    </sound>
    <sound name="home" wave="square">
      <volume>0.2</volume>
      <note pitch="C5">0.1</note>
      <note pitch="E5">0.1</note>
      <note pitch="G5">0.1</note>
      <note pitch="C6">0.1</note>
      <note pitch="G5">0.1</note>
      <note pitch="C6">0.3</note>
    </sound>
    <sound name="gameover" wave="triangle">
      <volume>0.4</volume>
      <note pitch="G4">0.25</note>
      <note pitch="E4">0.25</note>
      <note pitch="C4" to="C3">0.7</note>
    </sound>
  </sounds>
  <pictures>
    <bitmap name="ice-white">
      <row>.******..******..*****.</row>
      <row>*******.*******.*******</row>
      <row>ccccccc.ccccccc.ccccccc</row>
      <row>.ccccc...ccccc...ccccc.</row>
      <scale>5</scale>
      <color>color.white</color>
      <color char="c">color.cyan</color>
    </bitmap>
    <bitmap name="ice-blue">
      <row>.******..******..*****.</row>
      <row>*******.*******.*******</row>
      <row>ccccccc.ccccccc.ccccccc</row>
      <row>.ccccc...ccccc...ccccc.</row>
      <scale>5</scale>
      <color>color.blue</color>
      <color char="c">color.darkblue</color>
    </bitmap>
    <bitmap name="thermometer">
      <row>.ww.</row>
      <row>.w*.</row>
      <row>.w*.</row>
      <row>.w*.</row>
      <row>****</row>
      <row>****</row>
      <scale>4</scale>
      <color>color.red</color>
      <color char="w">color.lightgrey</color>
    </bitmap>
    <bitmap name="geese-up">
      <row>*......*</row>
      <row>.*....*.</row>
      <row>..****o.</row>
      <row>...**...</row>
      <scale>4</scale>
      <color>color.lightgrey</color>
      <color char="o">color.orange</color>
    </bitmap>
    <bitmap name="geese-down">
      <row>........</row>
      <row>..****o.</row>
      <row>.*.**.*.</row>
      <row>*......*</row>
      <scale>4</scale>
      <color>color.lightgrey</color>
      <color char="o">color.orange</color>
    </bitmap>
    <bitmap name="fish">
      <row>.***..*</row>
      <row>*k*****</row>
      <row>.***..*</row>
      <scale>4</scale>
      <color>color.green</color>
      <color char="k">color.black</color>
    </bitmap>
    <bitmap name="bailey">
      <row>..bb..</row>
      <row>.bbbb.</row>
      <row>.ffff.</row>
      <row>..ff..</row>
      <row>.****.</row>
      <row>******</row>
      <row>f.**.f</row>
      <row>.****.</row>
      <row>.b..b.</row>
      <row>bb..bb</row>
      <scale>4</scale>
      <color>color.orange</color>
      <color char="b">color.brown</color>
      <color char="f">color.yellow</color>
    </bitmap>
  </pictures>
</game>
