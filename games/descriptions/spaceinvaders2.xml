<!-- spaceinvaders2.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Oct 2, 2026 -->

<!--
  Space Invaders (spaceinvaders.xml), drawn from an SVG sprite sheet instead
  of rows of text: the same game, the same keys.

  assets/Space Invaders Color Sprites.svg is a sheet of 32 by 32 unit cells, six
  across and four down, with the frames of each picture running left to right
  (column, row):

    row 0   ship (0,0) idle, (1,0) banking left, (2,0) banking right, (3,0) hit
            flash; player bolts (4,0) and (5,0) charged
    row 1   enemy bolt (0,1), enemy bomb (1,1); explosion frames (2,1) to (5,1)
    row 2   alien A, frames (0,2) (1,2) (2,2); alien B, frames (3,2) (4,2) (5,2)
    row 3   alien C, frames (0,3) (1,3) (2,3); a flying saucer, frames (3,3) to (5,3)

  An <svg> sprite takes a part of the drawing (<x>, <y>, <width>, <height>, in
  its own units) and draws it `scale` real pixels to a unit, once, when the
  game loads. The parts are cut close round what is drawn, so the box tested
  for a hit is about the size of the alien. The sheet's backdrop is left out
  with <hide>. A member, row or cell that changes an <svg> gives only what
  changes (a row of crabs only its <x>, <y> and <height>).

  The aliens step through three frames each; a hit leaves the four explosion
  frames, spawned where it was; the saucer is the mystery ship and turns
  its lights as it goes. Not used yet: banking, the hit flash, the charged
  bolt and the enemy bomb.
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../xgedef.xsd">
  <window name="Space Invaders 2">
    <width>1024</width>
    <height>768</height>
  </window>
  <variables>
    <variable name="margin">80</variable>
    <variable name="top">120</variable>
    <variable name="zoom">2</variable>
    <variable name="boltzoom">1.5</variable>
    <variable name="gap">15</variable>
    <variable name="animation.seconds">0.5</variable>
    <variable name="step">2</variable>
    <variable name="shieldtop">540</variable>
  </variables>
  <styles>
    <style name="banner"><size>128</size><color>color.green</color></style>
    <style name="hud"><size>36</size><color>color.white</color></style>
    <style name="prompt"><size>48</size><color>color.white</color></style>
  </styles>
  <objects>
    <object name="bullet" class="projectile">
      <sprite>
        <svg>
          <path>assets/Space Invaders Color Sprites.svg</path>
          <x>140.5</x><y>2.5</y><width>7</width><height>27</height>
          <scale>boltzoom</scale>
          <hide>backdrop</hide>
        </svg>
      </sprite>
      <velocity><y>-12</y></velocity>
      <most>1</most>
      <collisions>
        <collision edge="all"><despawn /></collision>
        <collision class="aliens"><despawn /></collision>
        <collision class="shield"><despawn /></collision>
        <collision class="bomb"><despawn /></collision>
        <collision class="ufo"><despawn /></collision>
      </collisions>
    </object>
    <!-- the aliens' plasma bolts, the sheet's enemy bolt (0,1) flipped to
         fly down: three at most -->
    <object name="bomb" class="bomb">
      <sprite>
        <svg>
          <path>assets/Space Invaders Color Sprites.svg</path>
          <x>11</x><y>37</y><width>10</width><height>23</height>
          <scale>boltzoom</scale>
          <hide>backdrop</hide>
          <flip>vertical</flip>
        </svg>
      </sprite>
      <velocity><y>5</y></velocity>
      <most>3</most>
      <collisions>
        <collision edge="all"><despawn /></collision>
        <collision object="player"><despawn /></collision>
        <collision class="shield"><despawn /></collision>
        <collision class="ground"><despawn /></collision>
        <collision object="bullet"><despawn /></collision>
      </collisions>
    </object>
    <!-- the sheet's four explosion frames, left where a hit was -->
    <object name="blast" class="blast">
      <sprite name="a">
        <svg>
          <path>assets/Space Invaders Color Sprites.svg</path>
          <x>66</x><y>34</y><width>28</width><height>28</height>
          <scale>zoom</scale>
          <hide>backdrop</hide>
        </svg>
      </sprite>
      <sprite name="b">
        <svg>
          <path>assets/Space Invaders Color Sprites.svg</path>
          <x>98</x><y>34</y><width>28</width><height>28</height>
          <scale>zoom</scale>
          <hide>backdrop</hide>
        </svg>
      </sprite>
      <sprite name="c">
        <svg>
          <path>assets/Space Invaders Color Sprites.svg</path>
          <x>130</x><y>34</y><width>28</width><height>28</height>
          <scale>zoom</scale>
          <hide>backdrop</hide>
        </svg>
      </sprite>
      <sprite name="d">
        <svg>
          <path>assets/Space Invaders Color Sprites.svg</path>
          <x>162</x><y>34</y><width>28</width><height>28</height>
          <scale>zoom</scale>
          <hide>backdrop</hide>
        </svg>
      </sprite>
      <animation>
        <seconds>0.08</seconds>
        <frame sprite="a" />
        <frame sprite="b" />
        <frame sprite="c" />
        <frame sprite="d" />
      </animation>
      <most>2</most>
      <timers>
        <timer><after>0.32</after><despawn /></timer>
      </timers>
    </object>
  </objects>
  <keeps>
    <keep object="best" />
  </keeps>
  <states>
    <objects>
      <object name="player">
        <sprite>
          <svg>
            <path>assets/Space Invaders Color Sprites.svg</path>
            <x>4</x><y>3.5</y><width>24</width><height>26</height>
            <scale>zoom</scale>
            <hide>backdrop</hide>
          </svg>
        </sprite>
        <position><x><centered /></x><y>
          <subtract>
            <value>window.bottom</value>
            <value><multiply><value>player.height</value><value>2</value></multiply></value>
          </subtract>
        </y></position>
        <collisions>
          <collision edge="horizontal"><stick /></collision>
          <collision class="bomb">
            <dec variable="player.lives" />
            <inc variable="player.struck" />
            <spawn object="blast" />
            <play sound="playerhit" />
          </collision>
        </collisions>
        <actions>
          <action name="left"><move direction="left">step</move></action>
          <action name="right"><move direction="right">step</move></action>
          <action name="gun">
            <fire object="bullet" />
            <play sound="shoot" />
          </action>
        </actions>
        <variables>
          <variable name="score">0</variable>
          <variable name="lives">3</variable>
          <variable name="struck">0</variable>
        </variables>
      </object>
      <object name="best">
        <sprite><text style="hud"><content>HI-SCORE</content><number>best.score</number></text></sprite>
        <position><x><centered /></x><y>10</y></position>
        <variables><variable name="score">0</variable></variables>
      </object>
      <object name="continue">
        <sprite><text style="prompt"><content>spacebar to continue</content></text></sprite>
        <position><x><centered /></x><y><add><value>window.height.center</value><value>60</value></add></y></position>
      </object>
    </objects>
    <state name="title">
      <objects>
        <object name="title">
          <sprite><text style="banner"><content>SPACE INVADERS</content><size>110</size></text></sprite>
          <position><x><centered /></x><y><centered><offset>-100</offset></centered></y></position>
        </object>
        <object name="table">
          <sprite><text style="hud"><content>squid 30   crab 20   octopus 10   saucer ?</content><size>28</size></text></sprite>
          <position><x><centered /></x><y><add><value>window.height.center</value><value>20</value></add></y></position>
        </object>
      </objects>
      <shows>
        <show object="player" />
        <show object="best" />
      </shows>
      <inputs>
        <input button="space"><push state="playing" /></input>
      </inputs>
    </state>
    <state name="playing">
      <objects>
        <group name="shields" class="shield">
          <columns>4</columns>
          <rows>1</rows>
          <padding><x>150</x><y>0</y></padding>
          <sprite>
            <bitmap from="shields" />
          </sprite>
          <position><x>111</x><y>shieldtop</y></position>
          <collisions>
            <type>pixel</type>
            <collision object="bullet"><hole>10<rough>0.6</rough></hole></collision>
            <collision class="bomb"><hole>8<rough>0.6</rough></hole></collision>
          </collisions>
        </group>
        <object name="ground" class="ground">
          <sprite><rectangle><width>window.right</width><height>3</height><color>color.cyan</color></rectangle></sprite>
          <position><x>0</x><y><subtract><value>window.bottom</value><value>30</value></subtract></y></position>
        </object>
        <!-- the flying saucer, its lights running: across the top now and then -->
        <object name="ufo" class="ufo">
          <sprite name="a">
            <svg>
              <path>assets/Space Invaders Color Sprites.svg</path>
              <x>97</x><y>100.5</y><width>30</width><height>21</height>
              <scale>zoom</scale>
              <hide>backdrop</hide>
            </svg>
          </sprite>
          <sprite name="b">
            <svg>
              <path>assets/Space Invaders Color Sprites.svg</path>
              <x>129</x><y>100.5</y><width>30</width><height>21</height>
              <scale>zoom</scale>
              <hide>backdrop</hide>
            </svg>
          </sprite>
          <sprite name="c">
            <svg>
              <path>assets/Space Invaders Color Sprites.svg</path>
              <x>161</x><y>100.5</y><width>30</width><height>21</height>
              <scale>zoom</scale>
              <hide>backdrop</hide>
            </svg>
          </sprite>
          <animation><seconds>0.15</seconds><frame sprite="a" /><frame sprite="b" /><frame sprite="c" /></animation>
          <position><x><subtract><value>0</value><value>ufo.width</value></subtract></x><y>55</y></position>
          <velocity><x>2.5</x></velocity>
          <waiting />
          <collisions>
            <collision edge="right"><die /></collision>
            <collision object="bullet">
              <inc variable="player.score">
                <multiply>
                  <value>50</value>
                  <value><ceiling><value>self.worth</value></ceiling></value>
                </multiply>
              </inc>
              <spawn object="blast" />
              <play sound="alienhit" />
              <die />
            </collision>
          </collisions>
          <variables><variable name="worth"><random><min>0.01</min><max>4</max></random></variable></variables>
        </object>
        <group name="aliens" class="aliens">
          <columns>11</columns>
          <rows>5</rows>
          <padding><x>gap</x><y>gap</y></padding>
          <sprite name="a">
            <svg>
              <path>assets/Space Invaders Color Sprites.svg</path>
              <x>1.5</x><y>64.5</y><width>28</width><height>25</height>
              <scale>zoom</scale>
              <hide>backdrop</hide>
            </svg>
          </sprite>
          <sprite name="b">
            <svg>
              <path>assets/Space Invaders Color Sprites.svg</path>
              <x>33.5</x><y>64.5</y><width>28</width><height>25</height>
              <scale>zoom</scale>
              <hide>backdrop</hide>
            </svg>
          </sprite>
          <sprite name="c">
            <svg>
              <path>assets/Space Invaders Color Sprites.svg</path>
              <x>65.5</x><y>64.5</y><width>28</width><height>25</height>
              <scale>zoom</scale>
              <hide>backdrop</hide>
            </svg>
          </sprite>
          <animation>
            <seconds>animation.seconds</seconds>
            <frame sprite="a" />
            <frame sprite="b" />
            <frame sprite="c" />
          </animation>
          <position><x>margin</x><y>top</y></position>
          <velocity><x>2</x></velocity>
          <facing>down</facing>
          <collisions>
            <lockstep />
            <collision edge="horizontal">
              <bounce />
              <move direction="down">10</move>
            </collision>
            <collision object="bullet">
              <inc variable="player.score">self.worth</inc>
              <spawn object="blast" />
              <play sound="alienhit" />
              <die />
            </collision>
          </collisions>
          <variables><variable name="worth">30</variable></variables>
          <timers>
            <timer>
              <every><random><min>2</min><max>25</max></random></every>
              <fire object="bomb" />
            </timer>
          </timers>
          <row><number>2</number><number>3</number>
            <sprite name="a"><svg><x>98</x><y>70.5</y><height>23</height></svg></sprite>
            <sprite name="b"><svg><x>130</x><y>70.5</y><height>23</height></svg></sprite>
            <sprite name="c"><svg><x>162</x><y>70.5</y><height>23</height></svg></sprite>
            <variables><variable name="worth">20</variable></variables>
          </row>
          <row><number>4</number><number>5</number>
            <sprite name="a"><svg><y>99.5</y><height>24.5</height></svg></sprite>
            <sprite name="b"><svg><y>99.5</y><height>24.5</height></svg></sprite>
            <sprite name="c"><svg><y>99.5</y><height>24.5</height></svg></sprite>
            <variables><variable name="worth">10</variable></variables>
          </row>
        </group>
        <object name="pace">
          <variables><variable name="next">28</variable></variables>
        </object>
        <object name="score">
          <sprite><text style="hud"><content>SCORE</content><number>player.score</number></text></sprite>
          <position><x>20</x><y>10</y></position>
        </object>
        <object name="lives">
          <sprite><text style="hud"><number>player.lives</number><size>24</size><color>color.cyan</color></text></sprite>
          <position><x>20</x><y><subtract><value>window.bottom</value><value>27</value></subtract></y></position>
        </object>
      </objects>
      <shows>
        <show object="player" />
        <show object="bullet" />
        <show object="best" />
      </shows>
      <music sound="march" />
      <inputs>
        <input><button>a</button><button>left</button><trigger object="player" action="left" /></input>
        <input><button>d</button><button>right</button><trigger object="player" action="right" /></input>
        <input button="space"><trigger object="player" action="gun" /></input>
        <input><button>pause</button><button>pad1.start</button><push state="paused" /></input>
      </inputs>
      <conditions>
        <condition class="aliens">
          <remaining>0</remaining>
          <become object="over.message" sprite="won" />
          <push state="over" />
        </condition>
        <condition object="player" variable="lives">
          <atmost>0</atmost>
          <become object="over.message" sprite="lost" />
          <push state="over" />
        </condition>
        <condition class="aliens" variable="y" total="highest">
          <atleast><subtract><value>shieldtop</value><value>50</value></subtract></atleast>
          <become object="over.message" sprite="lost" />
          <push state="over" />
        </condition>
        <condition object="player" variable="struck">
          <atleast>1</atleast>
          <dec variable="player.struck" />
          <push state="blasted" />
        </condition>
        <condition class="aliens" total="count">
          <atmost>pace.next</atmost>
          <set variable="aliens.velocity.x"><multiply><value>aliens.1.1.velocity.x</value><value>1.3</value></multiply></set>
          <set variable="pace.next"><divide><value>pace.next</value><value>2</value></divide></set>
        </condition>
        <condition object="player" variable="score">
          <above>best.score</above>
          <copy variable="player.score" into="best.score" />
        </condition>
      </conditions>
      <timers>
        <timer>
          <every><random><min>20</min><max>30</max></random></every>
          <reveal object="ufo" />
          <play sound="ufo" />
        </timer>
      </timers>
    </state>
    <state name="paused">
      <objects>
        <object name="paused">
          <sprite><text style="banner"><content>paused</content><color>color.white</color></text></sprite>
          <position><x><centered /></x><y><centered /></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input><button>pause</button><button>pad1.start</button><pop /></input>
      </inputs>
    </state>
    <state name="blasted">
      <shows>
        <show state="playing" />
      </shows>
      <inputs />
      <timers>
        <!-- every, not after: it counts only while this state is current, so
             each visit starts the second again -->
        <timer>
          <after>1</after>
          <despawn object="bomb" />
          <pop />
        </timer>
      </timers>
    </state>
    <state name="over">
      <objects>
        <object name="message">
          <sprite name="lost"><text style="banner"><content>GAME OVER</content><color>color.red</color></text></sprite>
          <sprite name="won"><text style="banner"><content>YOU WIN</content></text></sprite>
          <position><x><centered /></x><y><subtract><value>window.height.center</value><value>150</value></subtract></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
        <show object="continue" />
      </shows>
      <inputs>
        <input button="space"><reset /></input>
      </inputs>
    </state>
  </states>
  <sounds>
    <sound name="shoot" wave="square"><volume>0.15</volume><note pitch="C6" to="C5">0.08</note></sound>
    <sound name="alienhit" wave="noise"><volume>0.3</volume><note pitch="6000" to="1500">0.15</note></sound>
    <sound name="playerhit" wave="noise"><volume>0.45</volume><note pitch="2000" to="100">0.7</note></sound>
    <sound name="ufo" wave="square">
      <volume>0.12</volume>
      <note pitch="G5" to="G6">0.15</note>
      <note pitch="G6" to="G5">0.15</note>
      <note pitch="G5" to="G6">0.15</note>
      <note pitch="G6" to="G5">0.15</note>
    </sound>
    <sound name="march" wave="triangle">
      <loop />
      <volume>0.35</volume>
      <note pitch="F2">0.1</note>
      <rest>0.4</rest>
      <note pitch="E2">0.1</note>
      <rest>0.4</rest>
      <note pitch="D#2">0.1</note>
      <rest>0.4</rest>
      <note pitch="D2">0.1</note>
      <rest>0.4</rest>
    </sound>
  </sounds>
  <pictures>
    <bitmap name="shields">
      <row>....**************....</row>
      <row>...****************...</row>
      <row>..******************..</row>
      <row>.********************.</row>
      <row>**********************</row>
      <row>**********************</row>
      <row>**********************</row>
      <row>**********************</row>
      <row>**********************</row>
      <row>**********************</row>
      <row>**********************</row>
      <row>*******........*******</row>
      <row>******..........******</row>
      <row>*****............*****</row>
      <row>*****............*****</row>
      <row>*****............*****</row>
      <scale>4</scale>
      <color>color.cyan</color>
    </bitmap>
  </pictures>
</game>
