<!-- dotsandboxes.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Nov 1, 2026 -->

<!--
  Dots and Boxes: two players take turns drawing a line, in their own
  colour, between two dots next to each other on a six by six grid of
  dots, red first. A line that closes the fourth side of a box claims it,
  and that player goes again. When every box is claimed, more boxes wins.
  You play red against the computer, or two players share the keyboard.

  W A S D or the arrows move the cursor over the places still free:
  left and right along a row of them, up and down to the next row (across
  lines and down lines in turn). Space draws the line under it. The mouse
  works too: the cursor goes to the free place nearest the pointer and a
  left click draws it. While the computer plays, the keys do nothing. Pause pauses. On the title, Space
  plays the computer and 2 is for two players. Space plays again.

  How it is written:
  * The grid is a <map> of <cells />, two cells for each step between
    dots: o a dot, h and v where a line can go (faint until drawn), b a
    box.
  * The players are a group that takes <turns>; red <owns> the class
    redline and blue blueline, so the cursor's one <put /> draws the line
    of the player on its turn, then <pass> hands the turn on.
  * A line is put on its place: red's across and down are both of class
    redline, and <on class="hslot" /> in their <moves> says which goes
    where, so the put takes whichever fits the cell.
  * <close class="box" object="redbox" /> in a red line's <moves>: a box
    beside it with no place for a line left around it becomes red's. A
    put that closes one counts as refused, so the turn does not pass.
  * <count> keeps the score, and how many boxes are still open.
  * The cursor's hops and its <track> name the places with <onto>, so it
    only ever stands on a place a line can still go.
  * The computer plays blue with <think>, three lines ahead: it reads
    from the lines' <moves> that a put closes boxes and goes again, and
    counts boxes. It presses Space, which your keys cannot do meanwhile.
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../xgedef.xsd">
  <window name="Dots and Boxes">
    <width>800</width>
    <height>600</height>
  </window>
  <variables>
    <variable name="square">40</variable>
    <variable name="left">180</variable>
    <variable name="top">110</variable>
  </variables>
  <styles>
    <style name="banner"><size>80</size></style>
    <style name="prompt"><size>32</size></style>
    <style name="help"><size>22</size><color>color.lightgrey</color></style>
    <style name="hud"><size>32</size></style>
    <style name="cursor"><scale>4</scale><color>color.yellow</color></style>
  </styles>
  <states>
    <objects>
      <!-- how many play: 1 against the computer, 2 at one keyboard -->
      <object name="match">
        <variables><variable name="players">1</variable></variables>
      </object>
      <!-- boxes each side has, and boxes still open -->
      <object name="score">
        <variables>
          <variable name="red">0</variable>
          <variable name="blue">0</variable>
          <variable name="open">25</variable>
        </variables>
      </object>
      <object name="again">
        <sprite><text style="prompt"><content>spacebar to play again</content></text></sprite>
        <position><x><centered /></x><y><centered><offset>70</offset></centered></y></position>
      </object>
    </objects>
    <state name="title">
      <objects>
        <object name="title">
          <sprite><text style="banner"><content>DOTS AND BOXES</content><color>color.cyan</color></text></sprite>
          <position><x><centered /></x><y><centered><offset>-170</offset></centered></y></position>
        </object>
        <group name="help">
          <rows>3</rows>
          <padding><y>30</y></padding>
          <sprite><text style="help" /></sprite>
          <position><x><centered /></x><y><centered><offset>-90</offset></centered></y></position>
          <row number="1"><sprite><text><content>you play red, and go first; 2 for two players</content></text></sprite></row>
          <row number="2"><sprite><text><content>close a box's fourth side to claim it, and go again</content></text></sprite></row>
          <row number="3"><sprite><text><content>w a s d or the arrows move, spacebar or a click draws, pause key pauses</content></text></sprite></row>
        </group>
        <object name="start">
          <sprite><text style="prompt"><content>spacebar to start</content></text></sprite>
          <position><x><centered /></x><y><centered><offset>170</offset></centered></y></position>
        </object>
      </objects>
      <inputs>
        <input><button>space</button><button>pad1.start</button><set variable="match.players">1</set><push state="playing" /></input>
        <input><button>num2</button><button>numpad2</button><set variable="match.players">2</set><push state="playing" /></input>
      </inputs>
    </state>
    <state name="playing">
      <objects>
        <!-- the players, red first: each the words over the grid on its turn, nothing off it -->
        <group name="players">
          <sprite name="moving" />
          <sprite name="thinking" />
          <sprite name="waiting" />
          <position><x><centered /></x><y>24</y></position>
          <turns sprite="waiting" />
          <member name="reds">
            <sprite name="moving"><text style="hud"><content>red to move</content><color>color.red</color></text></sprite>
            <owns class="redline" />
          </member>
          <member name="blues">
            <sprite name="moving"><text style="hud"><content>blue to move</content><color>color.cyan</color></text></sprite>
            <sprite name="thinking"><text style="hud"><content>blue is thinking</content><color>color.cyan</color></text></sprite>
            <owns class="blueline" />
          </member>
        </group>
        <object name="redscore">
          <sprite><text style="hud"><content>red </content><number>score.red</number><color>color.red</color></text></sprite>
          <position><x>left + square * 11 + 30</x><y>top + 20</y></position>
        </object>
        <object name="bluescore">
          <sprite><text style="hud"><content>blue </content><number>score.blue</number><color>color.cyan</color></text></sprite>
          <position><x>left + square * 11 + 30</x><y>top + 60</y></position>
        </object>

        <map name="grid">
          <tile><width>square</width><height>square</height></tile>
          <position><x>left</x><y>top</y></position>
          <cells />
          <row>ohohohohoho</row>
          <row>vbvbvbvbvbv</row>
          <row>ohohohohoho</row>
          <row>vbvbvbvbvbv</row>
          <row>ohohohohoho</row>
          <row>vbvbvbvbvbv</row>
          <row>ohohohohoho</row>
          <row>vbvbvbvbvbv</row>
          <row>ohohohohoho</row>
          <row>vbvbvbvbvbv</row>
          <row>ohohohohoho</row>

          <group name="dots" char="o" class="dot">
            <sprite><circle><radius>5</radius><color>color.white</color></circle></sprite>
          </group>
          <!-- where a line can go, faint -->
          <group name="hslots" char="h" class="hslot">
            <sprite><rectangle><width>square * 2 - 20</width><height>2</height><color>color.darkgrey</color></rectangle></sprite>
          </group>
          <group name="vslots" char="v" class="vslot">
            <sprite><rectangle><width>2</width><height>square * 2 - 20</height><color>color.darkgrey</color></rectangle></sprite>
          </group>
          <group name="boxes" char="b" class="box">
            <sprite><rectangle><width>4</width><height>4</height><color>color.black</color></rectangle></sprite>
          </group>
          <!-- a line drawn on its place, in the colour of who drew it; one that
               walls in a box claims it in that colour -->
          <object name="redacross" class="redline">
            <sprite><rectangle><width>square * 2</width><height>6</height><color>color.red</color></rectangle></sprite>
            <moves><on class="hslot" /><close class="box" object="redbox" /></moves>
          </object>
          <object name="reddown" class="redline">
            <sprite><rectangle><width>6</width><height>square * 2</height><color>color.red</color></rectangle></sprite>
            <moves><on class="vslot" /><close class="box" object="redbox" /></moves>
          </object>
          <object name="blueacross" class="blueline">
            <sprite><rectangle><width>square * 2</width><height>6</height><color>color.cyan</color></rectangle></sprite>
            <moves><on class="hslot" /><close class="box" object="bluebox" /></moves>
          </object>
          <object name="bluedown" class="blueline">
            <sprite><rectangle><width>6</width><height>square * 2</height><color>color.cyan</color></rectangle></sprite>
            <moves><on class="vslot" /><close class="box" object="bluebox" /></moves>
          </object>
          <!-- a box claimed -->
          <object name="redbox" class="redbox">
            <sprite><rectangle><width>square * 2 - 14</width><height>square * 2 - 14</height><color>color.red</color></rectangle></sprite>
          </object>
          <object name="bluebox" class="bluebox">
            <sprite><rectangle><width>square * 2 - 14</width><height>square * 2 - 14</height><color>color.cyan</color></rectangle></sprite>
          </object>
        </map>

        <!-- the last line drawn, marked -->
        <map name="marks">
          <tile><width>square</width><height>square</height></tile>
          <position><x>left</x><y>top</y></position>
          <columns>11</columns>
          <rows>11</rows>
          <cells />
          <object name="lastmark">
            <sprite><circle><radius>5</radius><color>color.yellow</color></circle></sprite>
          </object>
        </map>

        <!-- the cursor, on a map of its own over the grid -->
        <map name="pointer">
          <tile><width>square</width><height>square</height></tile>
          <position><x>left</x><y>top</y></position>
          <cells />
          <row>.c.........</row>
          <row>...........</row>
          <row>...........</row>
          <row>...........</row>
          <row>...........</row>
          <row>...........</row>
          <row>...........</row>
          <row>...........</row>
          <row>...........</row>
          <row>...........</row>
          <row>...........</row>
          <object name="cursor" char="c">
            <sprite>
              <bitmap from="cursor" />
            </sprite>
            <marks>
              <last object="lastmark" />
            </marks>
            <actions>
              <!-- only onto places still free: along a row of them, or to the next row -->
              <action name="up"><hop direction="up"><onto class="hslot" /><onto class="vslot" /></hop></action>
              <action name="down"><hop direction="down"><onto class="hslot" /><onto class="vslot" /></hop></action>
              <action name="left"><hop direction="left"><onto class="hslot" /><onto class="vslot" /></hop></action>
              <action name="right"><hop direction="right"><onto class="hslot" /><onto class="vslot" /></hop></action>
              <action name="point"><track><onto class="hslot" /><onto class="vslot" /></track></action>
              <!-- the line of the player on its turn; one that closes a box keeps the turn -->
              <action name="put">
                <put />
                <play sound="line" />
                <pass object="players" />
              </action>
              <action name="tally">
                <count class="redbox" into="score.red" />
                <count class="bluebox" into="score.blue" />
                <count class="box" into="score.open" />
              </action>
            </actions>
          </object>
        </map>
      </objects>
      <inputs>
        <input><button>w</button><button>up</button><button>pad1.up</button><trigger object="cursor" action="up" /></input>
        <input><button>s</button><button>down</button><button>pad1.down</button><trigger object="cursor" action="down" /></input>
        <input><button>a</button><button>left</button><button>pad1.left</button><trigger object="cursor" action="left" /></input>
        <input><button>d</button><button>right</button><button>pad1.right</button><trigger object="cursor" action="right" /></input>
        <input>
          <button>space</button><button>pad1.a</button><button>mouse.left</button>
          <trigger object="cursor" action="put" />
          <trigger object="cursor" action="tally" />
        </input>
        <input axis="mouse.x"><trigger object="cursor" action="point" /></input>
        <input axis="mouse.y"><trigger object="cursor" action="point" /></input>
        <input><button>pause</button><button>pad1.start</button><push state="paused" /></input>
      </inputs>
      <conditions>
        <!-- every box claimed: more boxes wins -->
        <condition object="score" variable="open"><equal>0</equal>
          <condition object="score" variable="red"><above>score.blue</above>
            <become object="over.winner" sprite="red" />
            <play sound="win" />
            <push state="over" />
          </condition>
          <condition object="score" variable="blue"><above>score.red</above>
            <become object="over.winner" sprite="blue" />
            <play sound="win" />
            <push state="over" />
          </condition>
        </condition>
        <!-- against the computer, blue's turn is its -->
        <condition object="match" variable="players"><equal>1</equal>
          <condition object="blues" variable="turn"><equal>1</equal>
            <become object="blues" sprite="thinking" from="moving" />
          </condition>
        </condition>
      </conditions>
      <!-- blue's line: three ahead -->
      <computer>
        <condition object="match" variable="players"><equal>1</equal>
          <condition object="blues" variable="turn"><equal>1</equal>
            <think object="cursor" button="space">
              <depth>3</depth>
            </think>
          </condition>
        </condition>
      </computer>
    </state>
    <state name="paused">
      <objects>
        <object name="paused">
          <sprite><text style="banner"><content>PAUSED</content></text></sprite>
          <position><x><centered /></x><y><centered /></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input><button>pause</button><button>pad1.start</button><pop /></input>
      </inputs>
    </state>
    <state name="over">
      <objects>
        <object name="winner">
          <sprite name="red"><text style="banner"><content>RED WINS</content><color>color.red</color></text></sprite>
          <sprite name="blue"><text style="banner"><content>BLUE WINS</content><color>color.cyan</color></text></sprite>
          <position><x><centered /></x><y><centered><offset>-40</offset></centered></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
        <show object="again" />
      </shows>
      <inputs>
        <input><button>space</button><button>pad1.start</button><reset /></input>
      </inputs>
    </state>
  </states>
  <sounds>
    <sound name="line" wave="triangle"><note pitch="A4">0.04</note></sound>
    <sound name="win">
      <note pitch="C5">0.12</note>
      <note pitch="E5">0.12</note>
      <note pitch="G5">0.12</note>
      <note pitch="C6">0.4</note>
    </sound>
  </sounds>
  <pictures>
    <bitmap name="cursor" style="cursor">
      <row>**......**</row>
      <row>*........*</row>
      <row>..........</row>
      <row>..........</row>
      <row>..........</row>
      <row>..........</row>
      <row>..........</row>
      <row>..........</row>
      <row>*........*</row>
      <row>**......**</row>
    </bitmap>
  </pictures>
</game>
