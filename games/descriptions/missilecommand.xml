<!-- missilecommand.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Oct 7, 2026 -->

<!--
  Missile Command, after the 1980 arcade game and its 1981 Atari 2600
  version. Missiles fall on six cities. You steer a sight about the sky and
  launch counter-missiles from the base in the middle; each one flies to the
  sight and bursts there, and the burst destroys every missile that flies
  into it. A missile destroyed is 25 points. Three waves, each with more
  missiles and faster ones; survive them all to win, and lose every city to
  lose.

  W A S D or the arrow keys move the sight, Space launches, P or Escape
  pauses.

  How it is written:
  * The three waves are the <scenes> of the playing state. The ground, the
    cities, the base, the sight, the counter-missiles, the bursts, the score
    and the count of the game (status, never drawn) are the state's own
    objects, there in every wave.
  * The base <aim>s at the sight on a timer, all the time, so whatever it
    <fire>s goes straight at where the sight is.
  * A counter-missile that meets the sight (or a missile on the way) <release>s
    a burst there: a pool of hidden circles, each of which <die />s back into
    the pool on a timer of its own.
  * The missiles are the kit's pool of eight, in three groups inside it:
    the salvo of four, two more, and the last two (most). A missile
    <chase>s the nearest city that is still standing, worked out again on a
    timer, so when its city goes it turns for the next one. A missile that
    is done (shot down, or landed) is <reset /> to a new place above the
    sky, drawn again from its <random>s, and counted in status.spent.
  * The first wave takes the salvo as it is; the second takes the pool in
    a color of its own with the last two <hidden>, and the third all eight
    in another. Each has a label of its own. How fast its missiles fall
    (speed) and how many end it (total) are the wave's <variables>, read by
    plain names; its condition sees the count and <enter>s the next wave,
    and the last one wins.
  * Paused, won and lost draw the game still underneath (<show state>).
  Not in it: the three bases with ten missiles each, bonus points for the
  cities left, splitting missiles, bombers and smart bombs.
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../xge/xgedef.xsd">
  <window name="Missile Command">
    <width>640</width>
    <height>480</height>
    <background>color.black</background>
    <fullscreen>false</fullscreen>
    <framerate>60</framerate>
  </window>
  <variables>
    <variable name="margin">10</variable>
    <variable name="ground">450</variable>
    <variable name="sightstep">5</variable>
    <variable name="abmspeed">7</variable>
    <!-- how high above the sky a missile starts, at most -->
    <variable name="sky">600</variable>
  </variables>
  <sounds>
    <sound name="launch" wave="square">
      <volume>0.15</volume>
      <note pitch="C5" to="C6">0.1</note>
    </sound>
    <sound name="burst" wave="noise">
      <volume>0.3</volume>
      <note pitch="3000" to="300">0.3</note>
    </sound>
    <sound name="city" wave="noise">
      <volume>0.45</volume>
      <note pitch="800" to="60">0.7</note>
    </sound>
    <sound name="wave" wave="square">
      <volume>0.2</volume>
      <note pitch="G4">0.1</note>
      <note pitch="C5">0.1</note>
      <note pitch="E5">0.1</note>
      <note pitch="G5">0.2</note>
    </sound>
  </sounds>
  <styles>
    <style name="banner"><size>100</size><color>color.red</color></style>
    <style name="prompt"><size>40</size></style>
    <style name="hud"><size>24</size><color>color.lightgrey</color></style>
  </styles>
  <objects>
    <!-- after a game, in both endings -->
    <object name="again">
      <sprite>
        <text style="prompt">
          <content>spacebar to play again</content>
        </text>
      </sprite>
      <position><x><centered /></x><y><centered>window.height.center + 70</centered></y></position>
    </object>
  </objects>
  <states>
    <state name="title">
      <objects>
        <object name="title">
          <sprite>
            <text style="banner">
              <content>MISSILE COMMAND</content>
              <size>72</size>
            </text>
          </sprite>
          <position><x><centered /></x><y><centered>window.height.center - 130</centered></y></position>
        </object>
        <object name="help">
          <sprite>
            <text>
              <content>defend the cities</content>
              <size>32</size>
              <color>color.white</color>
            </text>
          </sprite>
          <position><x><centered /></x><y><centered>window.height.center - 40</centered></y></position>
        </object>
        <object name="keys">
          <sprite>
            <text>
              <content>w a s d or the arrows move the sight, space launches</content>
              <size>20</size>
              <color>color.lightgrey</color>
            </text>
          </sprite>
          <position><x><centered /></x><y><centered>window.height.center + 10</centered></y></position>
        </object>
        <object name="start">
          <sprite>
            <text style="prompt">
              <content>spacebar to start</content>
            </text>
          </sprite>
          <position><x><centered /></x><y><centered>window.height.center + 100</centered></y></position>
        </object>
      </objects>
      <inputs>
        <input button="space"><push state="playing" /></input>
      </inputs>
    </state>

    <state name="playing">
      <objects>
        <!-- the score, and the missiles done with in this wave; never drawn -->
        <object name="status">
          <variables>
            <variable name="score">0</variable>
            <variable name="spent">0</variable>
          </variables>
        </object>

        <object name="ground">
          <sprite>
            <rectangle>
              <width>window.right</width>
              <height>window.bottom - ground</height>
              <color>color.yellow</color>
            </rectangle>
          </sprite>
          <position><x>0</x><y>ground</y></position>
        </object>

        <!-- six cities, three either side of the base -->
        <group name="cities" class="city">
          <sprite>
            <bitmap>
              <row>....*.........</row>
              <row>....*....*....</row>
              <row>.*..**...*..*.</row>
              <row>.*.***..***.*.</row>
              <row>**********.***</row>
              <row>**************</row>
              <row>**************</row>
              <scale>2</scale>
              <color>color.cyan</color>
            </bitmap>
          </sprite>
          <position><y>ground - 14</y></position>
          <collisions>
            <enabled>true</enabled>
            <collision class="missile">
              <play sound="city" />
              <die />
            </collision>
          </collisions>
          <member><position><x>50</x></position></member>
          <member><position><x>130</x></position></member>
          <member><position><x>210</x></position></member>
          <member><position><x>402</x></position></member>
          <member><position><x>482</x></position></member>
          <member><position><x>562</x></position></member>
        </group>

        <!-- the base: always aimed at the sight -->
        <object name="base">
          <sprite>
            <bitmap>
              <row>.....**.....</row>
              <row>.....**.....</row>
              <row>....****....</row>
              <row>..********..</row>
              <row>************</row>
              <scale>2</scale>
              <color>color.white</color>
            </bitmap>
          </sprite>
          <position><x><centered /></x><y>ground - base.height</y></position>
          <actions>
            <action name="launch">
              <fire object="abms" />
              <play sound="launch" />
            </action>
          </actions>
          <timers>
            <timer>
              <every>0.05</every>
              <aim object="sight" />
            </timer>
          </timers>
        </object>

        <!-- the sight the player steers -->
        <object name="sight" class="sight">
          <sprite>
            <bitmap>
              <row>...*...</row>
              <row>...*...</row>
              <row>.......</row>
              <row>**...**</row>
              <row>.......</row>
              <row>...*...</row>
              <row>...*...</row>
              <scale>2</scale>
              <color>color.white</color>
            </bitmap>
          </sprite>
          <position><x><centered /></x><y><centered /></y></position>
          <collisions>
            <enabled>true</enabled>
            <collision edge="all">
              <stick />
            </collision>
          </collisions>
          <actions>
            <action name="up">
              <move direction="up">sightstep</move>
            </action>
            <action name="down">
              <move direction="down">sightstep</move>
            </action>
            <action name="left">
              <move direction="left">sightstep</move>
            </action>
            <action name="right">
              <move direction="right">sightstep</move>
            </action>
          </actions>
        </object>

        <!-- the counter-missiles, three in the air at once -->
        <group name="abms" class="abm">
          <sprite>
            <rectangle>
              <width>4</width>
              <height>4</height>
              <color>color.white</color>
            </rectangle>
          </sprite>
          <position><x>0</x><y>0</y></position>
          <velocity><y>-abmspeed</y></velocity>
          <hidden>true</hidden>
          <collisions>
            <enabled>false</enabled>
            <collision edge="all">
              <die />
            </collision>
            <collision object="sight">
              <release object="bursts" />
              <play sound="burst" />
              <die />
            </collision>
            <collision class="missile">
              <release object="bursts" />
              <play sound="burst" />
              <die />
            </collision>
          </collisions>
          <member />
          <member />
          <member />
        </group>

        <!-- the bursts: out of play until a counter-missile goes off, and gone
             again a moment later -->
        <group name="bursts" class="burst">
          <sprite>
            <circle>
              <radius>26</radius>
              <color>color.orange</color>
            </circle>
          </sprite>
          <position><x>0</x><y>0</y></position>
          <hidden>true</hidden>
          <collisions>
            <enabled>true</enabled>
          </collisions>
          <timers>
            <timer>
              <every>0.7</every>
              <die />
            </timer>
          </timers>
          <member />
          <member />
          <member />
          <member />
          <member />
          <member />
        </group>

        <object name="score">
          <sprite>
            <text style="hud">
              <number>status.score</number>
              <size>28</size>
              <color>color.red</color>
            </text>
          </sprite>
          <position><x>margin</x><y>margin</y></position>
        </object>
      </objects>
      <scenes>
        <objects>
          <!-- the missiles: they start somewhere above the sky and make for
               the nearest city, at the wave's speed -->
          <group name="missiles" class="missile">
            <sprite>
              <rectangle>
                <width>4</width>
                <height>8</height>
                <color>color.red</color>
              </rectangle>
            </sprite>
            <position>
              <x><random min="margin" max="window.right - margin" /></x>
              <y><random min="-sky" max="-10" /></y>
            </position>
            <velocity><y>speed</y></velocity>
            <collisions>
              <enabled>true</enabled>
              <collision class="city">
                <inc variable="status.spent" />
                <reset />
              </collision>
              <collision class="burst">
                <inc variable="status.score">25</inc>
                <inc variable="status.spent" />
                <reset />
              </collision>
              <collision class="abm">
                <inc variable="status.score">25</inc>
                <inc variable="status.spent" />
                <reset />
              </collision>
              <collision edge="bottom">
                <inc variable="status.spent" />
                <reset />
              </collision>
            </collisions>
            <timers>
              <timer>
                <every>0.25</every>
                <chase object="cities"><speed>speed</speed></chase>
              </timer>
            </timers>
            <!-- four in every wave, two more from the second, and the last two in the third -->
            <group name="salvo">
              <member />
              <member />
              <member />
              <member />
            </group>
            <group name="more">
              <member />
              <member />
            </group>
            <group name="most">
              <member />
              <member />
            </group>
          </group>
          <!-- which wave it is, at the top right -->
          <object name="label">
            <sprite>
              <text style="hud">
                <content>wave 1</content>
              </text>
            </sprite>
            <position><x>window.right - label.width - margin</x><y>margin</y></position>
          </object>
        </objects>

        <!-- four missiles at a time, twelve in all -->
        <scene name="wave1">
          <variables>
            <variable name="speed">0.8</variable>
            <variable name="total">12</variable>
          </variables>
          <objects>
            <group name="salvo" />
            <object name="label" />
          </objects>
          <conditions>
            <condition object="status" variable="spent">
              <atleast>total</atleast>
              <dec variable="status.spent">total</dec>
              <play sound="wave" />
              <enter scene="wave2" />
            </condition>
          </conditions>
        </scene>

        <!-- six at a time, eighteen in all -->
        <scene name="wave2">
          <variables>
            <variable name="speed">1.1</variable>
            <variable name="total">18</variable>
          </variables>
          <objects>
            <group name="missiles">
              <sprite>
                <rectangle>
                  <width>4</width>
                  <height>8</height>
                  <color>color.magenta</color>
                </rectangle>
              </sprite>
            </group>
            <group name="most">
              <hidden>true</hidden>
            </group>
            <object name="label">
              <sprite>
                <text style="hud">
                  <content>wave 2</content>
                </text>
              </sprite>
            </object>
          </objects>
          <conditions>
            <condition object="status" variable="spent">
              <atleast>total</atleast>
              <dec variable="status.spent">total</dec>
              <play sound="wave" />
              <enter scene="wave3" />
            </condition>
          </conditions>
        </scene>

        <!-- all eight at a time, twenty-four in all -->
        <scene name="wave3">
          <variables>
            <variable name="speed">1.4</variable>
            <variable name="total">24</variable>
          </variables>
          <objects>
            <group name="missiles">
              <sprite>
                <rectangle>
                  <width>4</width>
                  <height>8</height>
                  <color>color.green</color>
                </rectangle>
              </sprite>
            </group>
            <object name="label">
              <sprite>
                <text style="hud">
                  <content>wave 3</content>
                </text>
              </sprite>
            </object>
          </objects>
          <conditions>
            <condition object="status" variable="spent">
              <atleast>total</atleast>
              <play sound="wave" />
              <push state="youwin" />
            </condition>
          </conditions>
        </scene>
      </scenes>
      <inputs>
        <input button="w up"><trigger object="sight" action="up" /></input>
        <input button="s down"><trigger object="sight" action="down" /></input>
        <input button="a left"><trigger object="sight" action="left" /></input>
        <input button="d right"><trigger object="sight" action="right" /></input>
        <input button="space"><trigger object="base" action="launch" /></input>
        <input button="p escape"><push state="paused" /></input>
      </inputs>
      <conditions>
        <!-- every city gone -->
        <condition class="city">
          <remaining>0</remaining>
          <push state="theend" />
        </condition>
      </conditions>
    </state>

    <state name="paused">
      <objects>
        <object name="paused">
          <sprite>
            <text style="banner">
              <content>PAUSED</content>
              <color>color.white</color>
            </text>
          </sprite>
          <position><x><centered /></x><y><centered /></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input button="space p escape"><pop /></input>
      </inputs>
    </state>

    <state name="youwin">
      <objects>
        <object name="message">
          <sprite>
            <text style="banner">
              <content>YOU WIN</content>
              <color>color.green</color>
            </text>
          </sprite>
          <position><x><centered /></x><y><centered>window.height.center - 60</centered></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
        <show object="again" />
      </shows>
      <inputs>
        <input button="space"><reset /></input>
      </inputs>
    </state>

    <state name="theend" from="youwin">
      <objects>
        <object name="message">
          <sprite>
            <text style="banner">
              <content>THE END</content>
            </text>
          </sprite>
        </object>
      </objects>
    </state>
  </states>
</game>
