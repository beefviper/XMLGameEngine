<!-- berserk.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Oct 4, 2026 -->

<!--
  Berserk, after Stern's 1980 arcade game Berzerk. A man runs through rooms
  of electrified walls with robots in them. The walls kill him, the robots
  kill him, the robots' shots kill him, and so does Evil Otto, the grinning
  face that turns up if he lingers and cannot be shot. He shoots back, one
  shot at a time, and the only way out of a room is through one of the gaps
  in its outer wall. The robots come for him, and blunder into the walls and
  into one another as they do, which destroys them as surely as his shots.
  Every robot is 50 points, and a room with none left is worth 10 more for
  each. An extra man for every 2000 points. Four rooms, and then the first
  again, with the robots quicker and quicker to fire and Otto to arrive. The
  first room's yellow robots do not fire at all.

  W A S D or the arrow keys walk, Space fires the way he last walked. P or
  Escape pauses.

  How it is written:
  * The rooms are the <scenes> of the playing state. The man, his shot, the
    robots' shots, Evil Otto and the score are the state's own objects,
    there in every room.
  * Each room is the arcade's five cells across and three down, written as
    a <map>: a pillar (+) at every corner of a cell and a wall (- or |)
    between two, on tiles half a cell across, so the file shows the room as
    it looks; x and y are the gaps of the outer wall, the exits, never
    drawn. Each room's <ways> name the room its way "out" leads
    to; walking into an exit puts that room back as it started (<reset
    way="out" />), with its robots, and <enter>s it. The man's own rule for
    class exit puts him back at the start and counts the room in
    player.depth.
  * The robots are one group of the kit, a member for every robot of every
    room, each room taking its own by name and saying where it stands. An
    inner group gives each room's robots their colour, and every group but
    the first room's an <aim> and <fire> timer, whose wait is drawn again
    after every shot, between ends that shrink as player.depth grows.
  * Now and then (every 1 to 2.5 seconds, so it stands a while first) a
    robot turns to <chase> the man, a little faster the deeper he has gone; a
    robot that touches a wall or another robot is destroyed (its action
    "destroyed", which a shot runs too).
  * The man has four looks, one for each way he faces, and <become> in his
    actions picks it; <facing> makes <fire> leave the way he looks.
  * Every rule that costs the man a life is his own, because the <reset />
    in a rule puts only that object back at the start, where a
    <reset object="player" /> would put his variables back too.
  * player.kills counts the robots destroyed in this room; once none is left
    the state's condition pays 10 for each and clears the count, and
    another brings Otto at once. player.lifepoints is the score since the
    last extra man.
  * Evil Otto is revealed by a timer of each room whose wait is an
    expression of player.depth; he <chase>s the man over the walls.
  * Paused and game over draw the room and the score still underneath
    (<show state>).
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../xge/xgedef.xsd">
  <window name="Berserk">
    <width>568</width>
    <height>440</height>
    <background>color.black</background>
    <fullscreen>false</fullscreen>
    <framerate>60</framerate>
  </window>

  <variables>
    <variable name="margin">8</variable>
    <variable name="wide">112</variable>
    <variable name="tall">128</variable>
    <variable name="top">48</variable>
    <variable name="walk">2</variable>
  </variables>

  <sounds>
    <sound name="shoot" wave="square">
      <volume>0.15</volume>
      <note pitch="A5" to="A4">0.07</note>
    </sound>
    <sound name="robotshoot" wave="square">
      <volume>0.1</volume>
      <note pitch="E4" to="E3">0.1</note>
    </sound>
    <sound name="boom" wave="noise">
      <volume>0.4</volume>
      <note pitch="3000" to="200">0.3</note>
    </sound>
    <sound name="zap" wave="noise">
      <volume>0.45</volume>
      <note pitch="8000" to="400">0.5</note>
    </sound>
    <sound name="otto" wave="triangle">
      <volume>0.4</volume>
      <note pitch="C4" to="C5">0.12</note>
      <note pitch="C5" to="C4">0.12</note>
      <note pitch="C4" to="C5">0.12</note>
    </sound>
    <sound name="door" wave="square">
      <volume>0.15</volume>
      <note pitch="C5">0.05</note>
      <note pitch="G5">0.08</note>
    </sound>
    <sound name="bonus" wave="square">
      <volume>0.2</volume>
      <note pitch="G5">0.06</note>
      <note pitch="C6">0.12</note>
    </sound>
    <sound name="extralife" wave="square">
      <volume>0.2</volume>
      <note pitch="C5">0.08</note>
      <note pitch="E5">0.08</note>
      <note pitch="G5">0.08</note>
      <note pitch="C6">0.2</note>
    </sound>
  </sounds>

  <styles>
    <style name="banner"><size>110</size></style>
    <style name="prompt"><size>32</size><color>color.green</color></style>
    <style name="help"><size>22</size><color>color.lightgrey</color></style>
    <style name="hud"><size>28</size></style>
  </styles>
  <kit>
    <!-- every robot of every room: each room takes its own by name -->
    <group name="robots" class="robot">
      <sprite name="a">
        <bitmap>
          <row>.*****.</row><row>.*.*.*.</row><row>.*****.</row><row>..***..</row><row>*******</row><row>*.***.*</row><row>..*.*..</row><row>..*.*..</row><row>.**.**.</row>
          <scale>2</scale>
          <color>color.yellow</color>
        </bitmap>
      </sprite>
      <sprite name="b">
        <bitmap>
          <row>.*****.</row><row>.*.*.*.</row><row>.*****.</row><row>..***..</row><row>.*****.</row><row>*.***.*</row><row>.*...*.</row><row>.*...*.</row><row>**...**</row>
          <scale>2</scale>
          <color>color.yellow</color>
        </bitmap>
      </sprite>
      <animation>
        <interval>0.25</interval>
        <frame sprite="a" />
        <frame sprite="b" />
      </animation>
      <position><x>0</x><y>0</y></position>
      <collisions>
        <enabled>true</enabled>
        <collision class="wall"><trigger action="destroyed" /></collision>
        <collision class="robot"><trigger action="destroyed" /></collision>
        <collision class="exit"><reverse /></collision>
        <collision object="bullet">
          <trigger action="destroyed" />
          <reset object="bullet" />
        </collision>
      </collisions>
      <actions>
        <action name="destroyed">
          <die />
          <inc variable="player.score">50</inc>
          <inc variable="player.lifepoints">50</inc>
          <inc variable="player.kills" />
          <play sound="boom" />
        </action>
      </actions>
      <timers>
        <timer>
          <every><random min="1" max="2.5" /></every>
          <chase object="player"><speed>0.25 + player.depth * 0.05</speed></chase>
        </timer>
      </timers>
      <!-- room one's: they do not fire -->
      <group name="quiet">
        <member name="y1" />
        <member name="y2" />
        <member name="y3" />
      </group>
      <!-- the rest aim at the man and fire, sooner the deeper he is -->
      <group name="armed">
        <timers>
          <timer>
            <every><random min="max(0.8, 3 - player.depth * 0.25)" max="max(2, 7 - player.depth * 0.5)" /></every>
            <aim object="player" />
            <fire object="robotshot" />
            <play sound="robotshoot" />
          </timer>
        </timers>
        <group name="red">
          <sprite name="a"><bitmap><color>color.red</color></bitmap></sprite>
          <sprite name="b"><bitmap><color>color.red</color></bitmap></sprite>
          <member name="r1" />
          <member name="r2" />
          <member name="r3" />
          <member name="r4" />
        </group>
        <group name="cyan">
          <sprite name="a"><bitmap><color>color.cyan</color></bitmap></sprite>
          <sprite name="b"><bitmap><color>color.cyan</color></bitmap></sprite>
          <member name="c1" />
          <member name="c2" />
          <member name="c3" />
          <member name="c4" />
          <member name="c5" />
        </group>
        <group name="green">
          <sprite name="a"><bitmap><color>color.green</color></bitmap></sprite>
          <sprite name="b"><bitmap><color>color.green</color></bitmap></sprite>
          <member name="g1" />
          <member name="g2" />
          <member name="g3" />
          <member name="g4" />
          <member name="g5" />
          <member name="g6" />
        </group>
      </group>
    </group>
    <!-- a robot's shot: spawned when one fires, four at most in the room -->
    <object name="robotshot" class="robotshot">
      <sprite><rectangle><width>5</width><height>5</height><color>color.orange</color></rectangle></sprite>
      <velocity><y>3</y></velocity>
      <most>4</most>
      <collisions>
        <enabled>true</enabled>
        <collision edge="all"><despawn /></collision>
        <collision class="wall"><despawn /></collision>
        <collision object="player"><despawn /></collision>
      </collisions>
    </object>
  </kit>
  <states>
    <state name="title">
      <objects>
        <object name="title">
          <sprite><text style="banner"><content>BERSERK</content></text></sprite>
          <position><x><centered /></x><y>70</y></position>
        </object>
        <object name="taunt">
          <sprite><text><content>Chicken! Fight like a robot!</content><size>30</size><color>color.yellow</color></text></sprite>
          <position><x><centered /></x><y>205</y></position>
        </object>
        <object name="help1">
          <sprite><text style="help"><content>W A S D or the arrow keys walk, Space fires the way you face</content></text></sprite>
          <position><x><centered /></x><y>270</y></position>
        </object>
        <object name="help2">
          <sprite><text style="help"><content>The walls are electrified: leave by any gap. P pauses.</content></text></sprite>
          <position><x><centered /></x><y>305</y></position>
        </object>
        <object name="start">
          <sprite><text style="prompt"><content>Press Space to start</content></text></sprite>
          <position><x><centered /></x><y>380</y></position>
        </object>
      </objects>
      <inputs>
        <input button="space"><push state="playing" /></input>
      </inputs>
    </state>

    <state name="playing">
      <objects>
        <!-- the man. He faces the way he last walked (<facing>), shows it with one of
             four looks, and shoots that way. -->
        <object name="player" class="player">
          <sprite name="down">
            <bitmap>
              <row>..***..</row><row>.*.*.*.</row><row>..***..</row><row>...*...</row><row>.*****.</row><row>*..*..*</row><row>*..*..*</row><row>..*.*..</row><row>..*.*..</row><row>..*.*..</row><row>.**.**.</row>
              <scale>2</scale>
              <color>color.green</color>
            </bitmap>
          </sprite>
          <sprite name="up">
            <bitmap>
              <row>..***..</row><row>.*****.</row><row>..***..</row><row>*..*..*</row><row>*.***.*</row><row>*..*..*</row><row>...*...</row><row>..*.*..</row><row>..*.*..</row><row>..*.*..</row><row>.**.**.</row>
              <scale>2</scale>
              <color>color.green</color>
            </bitmap>
          </sprite>
          <sprite name="left">
            <bitmap>
              <row>..***..</row><row>.**.**.</row><row>..***..</row><row>...*...</row><row>*****..</row><row>*..*...</row><row>...*...</row><row>..*.*..</row><row>..*.*..</row><row>..*.*..</row><row>.**.**.</row>
              <scale>2</scale>
              <color>color.green</color>
            </bitmap>
          </sprite>
          <sprite name="right">
            <bitmap>
              <row>..***..</row><row>.**.**.</row><row>..***..</row><row>...*...</row><row>..*****</row><row>...*..*</row><row>...*...</row><row>..*.*..</row><row>..*.*..</row><row>..*.*..</row><row>.**.**.</row>
              <scale>2</scale>
              <color>color.green</color>
            </bitmap>
          </sprite>
          <position><x>21</x><y>233</y></position>
          <facing>right</facing>
          <collisions>
            <enabled>true</enabled>
            <!-- the walls are electrified, and so is everything else that touches him -->
            <collision class="wall"><trigger action="lose" /></collision>
            <collision class="robotshot"><trigger action="lose" /></collision>
            <collision class="otto"><trigger action="lose" /></collision>
            <collision class="robot"><trigger action="lose" /></collision>
            <!-- through an exit (the exit's own rule goes on to the next room):
                 back at the start, one room deeper, and the room tidied -->
            <collision class="exit">
              <inc variable="player.depth">1</inc>
              <set variable="player.kills">0</set>
              <play sound="door" />
              <reset />
              <reset object="bullet" />
              <despawn object="robotshot" />
              <reset object="otto" />
            </collision>
            <collision edge="all"><stick /></collision>
          </collisions>
          <actions>
            <action name="lose">
              <dec variable="player.lives">1</dec>
              <play sound="zap" />
              <reset />
              <reset object="bullet" />
              <despawn object="robotshot" />
            </action>
            <action name="up"><move direction="up">walk</move><become sprite="up" /></action>
            <action name="down"><move direction="down">walk</move><become sprite="down" /></action>
            <action name="left"><move direction="left">walk</move><become sprite="left" /></action>
            <action name="right"><move direction="right">walk</move><become sprite="right" /></action>
            <action name="gun">
              <fire object="bullet" />
              <play sound="shoot" />
            </action>
          </actions>
          <variables>
            <variable name="score">0</variable>
            <variable name="lives">3</variable>
            <variable name="lifepoints">0</variable>
            <variable name="depth">0</variable>
            <variable name="kills">0</variable>
          </variables>
        </object>

        <!-- his shot: one at a time, like the arcade game -->
        <object name="bullet" class="bullet">
          <sprite><rectangle><width>5</width><height>5</height><color>color.green</color></rectangle></sprite>
          <position><x>0</x><y>0</y></position>
          <velocity><y>-8</y></velocity>
          <active>false</active>
          <collisions>
            <enabled>false</enabled>
            <collision edge="all"><die /></collision>
            <collision class="wall"><die /></collision>
            <collision class="otto"><die /></collision>
          </collisions>
        </object>

        <!-- Evil Otto: comes straight for the man over the walls, cannot be shot -->
        <object name="otto" class="otto">
          <sprite>
            <bitmap>
              <row>..*****..</row><row>.*.....*.</row><row>*.**.**.*</row><row>*.**.**.*</row><row>*.......*</row><row>*.*...*.*</row><row>*..***..*</row><row>.*.....*.</row><row>..*****..</row>
              <scale>3</scale>
              <color>color.yellow</color>
            </bitmap>
          </sprite>
          <position><x>504</x><y>72</y></position>
          <velocity><x>-1.2</x><y>0.9</y></velocity>
          <active>false</active>
          <collisions>
            <enabled>true</enabled>
            <collision edge="all"><bounce /></collision>
            <collision object="player"><die /></collision>
          </collisions>
          <timers>
            <timer>
              <every>0.1</every>
              <chase object="player"><speed>1.1</speed></chase>
            </timer>
          </timers>
        </object>

        <!-- the score, and the men left -->
        <object name="score">
          <sprite><text style="hud"><number>player.score</number><color>color.green</color></text></sprite>
          <position><x>margin</x><y>margin</y></position>
        </object>
        <object name="lives">
          <sprite><text style="hud"><number>player.lives</number><color>color.green</color></text></sprite>
          <position><x>window.right - lives.width - margin</x><y>margin</y></position>
        </object>
        <object name="liveicon">
          <sprite>
            <bitmap>
              <row>..***..</row><row>.*.*.*.</row><row>..***..</row><row>...*...</row><row>.*****.</row><row>*..*..*</row><row>*..*..*</row><row>..*.*..</row><row>..*.*..</row><row>..*.*..</row><row>.**.**.</row>
              <scale>2</scale>
              <color>color.green</color>
            </bitmap>
          </sprite>
          <position><x>window.right - lives.width - margin * 2 - 14</x><y>margin</y></position>
        </object>
      </objects>

      <scenes>

        <!-- ======================================================== room 1 -->
        <scene name="room1">
          <ways>
            <way name="out" scene="room2" />
          </ways>
          <objects>
            <map name="maze">
              <tile><width>wide / 2</width><height>tall / 2</height></tile>
              <position><x>margin / 2 - wide / 4</x><y>top + margin / 2 - tall / 4</y></position>
              <row>+-+-+x+-+-+</row>
              <row>|         |</row>
              <row>+ +-+ + + +</row>
              <row>y   | |   y</row>
              <row>+ + + +-+ +</row>
              <row>|     |   |</row>
              <row>+-+-+x+-+-+</row>
              <group name="walls" class="wall">
                <sprite><rectangle><width>margin</width><height>margin</height><color>color.blue</color></rectangle></sprite>
                <collisions><enabled>true</enabled></collisions>
                <group name="post" char="+" />
                <group name="across" char="-"><sprite><rectangle><width>wide - margin</width></rectangle></sprite></group>
                <group name="down" char="|"><sprite><rectangle><height>tall - margin</height></rectangle></sprite></group>
              </group>
              <group name="exits" class="exit">
                <sprite><rectangle><width>wide - margin</width><height>margin</height><color>color.black</color></rectangle></sprite>
                <drawn>false</drawn>
                <collisions>
                  <enabled>true</enabled>
                  <collision object="player">
                    <reset way="out" />
                    <enter way="out" />
                  </collision>
                </collisions>
                <group name="level" char="x" />
                <group name="side" char="y"><sprite><rectangle><width>margin</width><height>tall - margin</height></rectangle></sprite></group>
              </group>
            </map>
            <!-- 3 robots, yellow, and they do not fire -->
            <object name="y1"><position><x>277</x><y>107</y></position></object>
            <object name="y2"><position><x>501</x><y>363</y></position></object>
            <object name="y3"><position><x>389</x><y>235</y></position></object>
          </objects>
          <!-- Otto comes if the man lingers: sooner the deeper he has gone -->
          <timers>
            <timer>
              <every>max(6, 14 - player.depth)</every>
              <reveal object="otto" />
              <play sound="otto" />
            </timer>
          </timers>
        </scene>

        <!-- ======================================================== room 2 -->
        <scene name="room2">
          <ways>
            <way name="out" scene="room3" />
          </ways>
          <objects>
            <map name="maze">
              <tile><width>wide / 2</width><height>tall / 2</height></tile>
              <position><x>margin / 2 - wide / 4</x><y>top + margin / 2 - tall / 4</y></position>
              <row>+-+-+x+-+-+</row>
              <row>|   |     |</row>
              <row>+ + +-+ +-+</row>
              <row>y   |     y</row>
              <row>+-+ + + + +</row>
              <row>|       | |</row>
              <row>+-+-+x+-+-+</row>
              <group name="walls" class="wall">
                <sprite><rectangle><width>margin</width><height>margin</height><color>color.blue</color></rectangle></sprite>
                <collisions><enabled>true</enabled></collisions>
                <group name="post" char="+" />
                <group name="across" char="-"><sprite><rectangle><width>wide - margin</width></rectangle></sprite></group>
                <group name="down" char="|"><sprite><rectangle><height>tall - margin</height></rectangle></sprite></group>
              </group>
              <group name="exits" class="exit">
                <sprite><rectangle><width>wide - margin</width><height>margin</height><color>color.black</color></rectangle></sprite>
                <drawn>false</drawn>
                <collisions>
                  <enabled>true</enabled>
                  <collision object="player">
                    <reset way="out" />
                    <enter way="out" />
                  </collision>
                </collisions>
                <group name="level" char="x" />
                <group name="side" char="y"><sprite><rectangle><width>margin</width><height>tall - margin</height></rectangle></sprite></group>
              </group>
            </map>
            <!-- 4 robots, red -->
            <object name="r1"><position><x>277</x><y>107</y></position></object>
            <object name="r2"><position><x>501</x><y>235</y></position></object>
            <object name="r3"><position><x>165</x><y>363</y></position></object>
            <object name="r4"><position><x>389</x><y>363</y></position></object>
          </objects>
          <!-- Otto comes if the man lingers: sooner the deeper he has gone -->
          <timers>
            <timer>
              <every>max(6, 14 - player.depth)</every>
              <reveal object="otto" />
              <play sound="otto" />
            </timer>
          </timers>
        </scene>

        <!-- ======================================================== room 3 -->
        <scene name="room3">
          <ways>
            <way name="out" scene="room4" />
          </ways>
          <objects>
            <map name="maze">
              <tile><width>wide / 2</width><height>tall / 2</height></tile>
              <position><x>margin / 2 - wide / 4</x><y>top + margin / 2 - tall / 4</y></position>
              <row>+-+-+x+-+-+</row>
              <row>|     |   |</row>
              <row>+-+ + + + +</row>
              <row>y   |   | y</row>
              <row>+ + +-+ + +</row>
              <row>|   |     |</row>
              <row>+-+-+x+-+-+</row>
              <group name="walls" class="wall">
                <sprite><rectangle><width>margin</width><height>margin</height><color>color.blue</color></rectangle></sprite>
                <collisions><enabled>true</enabled></collisions>
                <group name="post" char="+" />
                <group name="across" char="-"><sprite><rectangle><width>wide - margin</width></rectangle></sprite></group>
                <group name="down" char="|"><sprite><rectangle><height>tall - margin</height></rectangle></sprite></group>
              </group>
              <group name="exits" class="exit">
                <sprite><rectangle><width>wide - margin</width><height>margin</height><color>color.black</color></rectangle></sprite>
                <drawn>false</drawn>
                <collisions>
                  <enabled>true</enabled>
                  <collision object="player">
                    <reset way="out" />
                    <enter way="out" />
                  </collision>
                </collisions>
                <group name="level" char="x" />
                <group name="side" char="y"><sprite><rectangle><width>margin</width><height>tall - margin</height></rectangle></sprite></group>
              </group>
            </map>
            <!-- 5 robots, cyan -->
            <object name="c1"><position><x>165</x><y>107</y></position></object>
            <object name="c2"><position><x>501</x><y>107</y></position></object>
            <object name="c3"><position><x>277</x><y>235</y></position></object>
            <object name="c4"><position><x>165</x><y>363</y></position></object>
            <object name="c5"><position><x>389</x><y>363</y></position></object>
          </objects>
          <!-- Otto comes if the man lingers: sooner the deeper he has gone -->
          <timers>
            <timer>
              <every>max(6, 14 - player.depth)</every>
              <reveal object="otto" />
              <play sound="otto" />
            </timer>
          </timers>
        </scene>

        <!-- ======================================================== room 4 -->
        <scene name="room4">
          <ways>
            <way name="out" scene="room1" />
          </ways>
          <objects>
            <map name="maze">
              <tile><width>wide / 2</width><height>tall / 2</height></tile>
              <position><x>margin / 2 - wide / 4</x><y>top + margin / 2 - tall / 4</y></position>
              <row>+-+-+x+-+-+</row>
              <row>| |       |</row>
              <row>+ + +-+-+ +</row>
              <row>y     |   y</row>
              <row>+ +-+ + +-+</row>
              <row>|   |     |</row>
              <row>+-+-+x+-+-+</row>
              <group name="walls" class="wall">
                <sprite><rectangle><width>margin</width><height>margin</height><color>color.blue</color></rectangle></sprite>
                <collisions><enabled>true</enabled></collisions>
                <group name="post" char="+" />
                <group name="across" char="-"><sprite><rectangle><width>wide - margin</width></rectangle></sprite></group>
                <group name="down" char="|"><sprite><rectangle><height>tall - margin</height></rectangle></sprite></group>
              </group>
              <group name="exits" class="exit">
                <sprite><rectangle><width>wide - margin</width><height>margin</height><color>color.black</color></rectangle></sprite>
                <drawn>false</drawn>
                <collisions>
                  <enabled>true</enabled>
                  <collision object="player">
                    <reset way="out" />
                    <enter way="out" />
                  </collision>
                </collisions>
                <group name="level" char="x" />
                <group name="side" char="y"><sprite><rectangle><width>margin</width><height>tall - margin</height></rectangle></sprite></group>
              </group>
            </map>
            <!-- 6 robots, green -->
            <object name="g1"><position><x>277</x><y>107</y></position></object>
            <object name="g2"><position><x>501</x><y>107</y></position></object>
            <object name="g3"><position><x>277</x><y>235</y></position></object>
            <object name="g4"><position><x>501</x><y>235</y></position></object>
            <object name="g5"><position><x>165</x><y>363</y></position></object>
            <object name="g6"><position><x>389</x><y>363</y></position></object>
          </objects>
          <!-- Otto comes if the man lingers: sooner the deeper he has gone -->
          <timers>
            <timer>
              <every>max(6, 14 - player.depth)</every>
              <reveal object="otto" />
              <play sound="otto" />
            </timer>
          </timers>
        </scene>
      </scenes>
      <inputs>
        <input button="up w"><trigger object="player" action="up" /></input>
        <input button="down s"><trigger object="player" action="down" /></input>
        <input button="left a"><trigger object="player" action="left" /></input>
        <input button="right d"><trigger object="player" action="right" /></input>
        <input button="space"><trigger object="player" action="gun" /></input>
        <input button="p escape"><push state="paused" /></input>
      </inputs>
      <conditions>
        <!-- out of lives -->
        <condition object="player" variable="lives">
          <atmost>0</atmost>
          <push state="gameover" />
        </condition>
        <!-- an extra man for every 2000 points: lifepoints is the score since the last one -->
        <condition object="player" variable="lifepoints">
          <atleast>2000</atleast>
          <inc variable="player.lives">1</inc>
          <dec variable="player.lifepoints">2000</dec>
          <play sound="extralife" />
        </condition>
        <!-- no robot left in the room: ten more for each destroyed -->
        <condition>
          <all>
            <check class="robot"><remaining>0</remaining></check>
            <check object="player" variable="kills"><atleast>1</atleast></check>
          </all>
          <inc variable="player.score">10 * player.kills</inc>
          <inc variable="player.lifepoints">10 * player.kills</inc>
          <set variable="player.kills">0</set>
          <play sound="bonus" />
        </condition>
        <!-- and Otto comes at once -->
        <condition class="robot">
          <remaining>0</remaining>
          <reveal object="otto" />
        </condition>
      </conditions>
    </state>

    <!-- the room still underneath -->
    <state name="paused">
      <objects>
        <object name="paused">
          <sprite><text style="banner"><content>PAUSED</content></text></sprite>
          <position><x><centered /></x><y>150</y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input button="space p escape"><pop /></input>
      </inputs>
    </state>

    <state name="gameover">
      <objects>
        <object name="gameover">
          <sprite><text style="banner"><content>GAME OVER</content><color>color.red</color></text></sprite>
          <position><x><centered /></x><y>120</y></position>
        </object>
        <object name="again">
          <sprite><text style="prompt"><content>Press Space to play again</content></text></sprite>
          <position><x><centered /></x><y>300</y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input button="space"><reset /></input>
      </inputs>
    </state>
  </states>
</game>
