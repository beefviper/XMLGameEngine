<!-- donkeykong.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Oct 7, 2026 -->

<!--
  Donkey Kong, after the 1981 arcade game: Kong stands at the top of six
  sloping girders and throws barrels down at Jumpman, who climbs to the top
  to save Pauline. The barrels roll down each girder and drop off its open
  end onto the one below, or now and then go down a ladder; at the bottom
  they burn up in the oil drum, which lets out a fireball. Fireballs wander
  the girders and climb ladders. A barrel or a fireball that touches Jumpman
  costs a life, unless he holds the hammer, which smashes a barrel for 300
  and a fireball for 500. A barrel jumped is 100. The bonus counts down from
  5000 as he climbs: reaching Pauline scores what is left of it and starts
  the climb again, with Kong throwing faster; let it run out and a life is
  lost. Save her three times to win. The high score is kept.

  A and D (or the arrows) walk, W and S climb, Space starts and jumps, P or
  Escape pauses.

  It is the game the standing verbs were made for:
  * Jumpman and the barrels fall (an <acceleration> with only a <y>) and
    <land /> on the girders: coming down onto a girder's top, they stand on
    it, and a girder can be walked past or jumped up through from below.
  * <leap> is Jumpman's jump: up under his own pull, from the ground only,
    and the way across fixed until he lands, as in the arcade game.
  * <climb class="ladder"> takes him up and down a ladder while he stands at
    one; on it nothing pulls him and he cannot walk off.
  * Kong <fire>s a barrel from his right side (he has <facing>right) every
    `kong.wait` seconds, a variable that each rescue takes some off.
  * A barrel at the top of a ladder (a hidden laddertop marker) goes down it
    if its luck, drawn when it is thrown and again at each wall and ladder,
    is under 0.3: the <climb> of an action a rule triggers takes it down one
    ladder and lets go. Off the foot of the ladder it stands still, which its
    rule for the girder sees, and it rolls on the other way. A fireball
    climbs up the same way.
  * Jumping a barrel: a condition sees a barrel near Jumpman while his jump
    lasts (man.leapt) and marks it (man.over); landing scores it.

  How it is written:
  * Each girder is a row of truss pieces, one bitmap, in a group of girders
    laid out in columns (<columns>), so the girder's length is its count,
    and each piece half a pixel lower or higher than the one before
    (<slope>), so it slopes as the arcade's do.
  * A ladder is a column of rung pieces (<rows>), climbed as one; a broken
    ladder is two short ones with a gap.
  * The hammer is a look: touching the hammer gives Jumpman the look
    "hammer" and sets man.hammer, which a barrel's rule <condition>s; a timer of
    that look takes it away again, with the hammer's tune.
  * Paused, won and game over draw the girders still underneath
    (<show state="playing" />), the barrels stopped where they were.
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../xgedef.xsd">
  <window name="Donkey Kong">
    <width>800</width>
    <height>700</height>
  </window>
  <variables>
    <variable name="piece">16</variable>
    <variable name="pull">0.4</variable>
    <variable name="walk">2.5</variable>
    <variable name="climbstep">2</variable>
    <variable name="leapheight">44</variable>
    <variable name="roll">2.5</variable>
    <variable name="margin">16</variable>
    <variable name="goal">3</variable>
  </variables>
  <sounds>
    <sound name="jump" wave="square">
      <volume>0.2</volume>
      <note pitch="C5" to="C6">0.12</note>
    </sound>
    <!-- a barrel jumped -->
    <sound name="points" wave="square">
      <volume>0.15</volume>
      <note pitch="E6">0.05</note>
      <note pitch="A6">0.08</note>
    </sound>
    <sound name="smash" wave="noise">
      <volume>0.3</volume>
      <note pitch="1500" to="200">0.2</note>
    </sound>
    <!-- caught: the arcade's falling notes, then three low ones -->
    <sound name="hit" wave="square">
      <volume>0.25</volume>
      <note pitch="D5">0.08</note>
      <note pitch="C#5">0.08</note>
      <note pitch="C5">0.08</note>
      <note pitch="B4">0.08</note>
      <note pitch="A#4">0.08</note>
      <note pitch="A4">0.08</note>
      <note pitch="G#4">0.08</note>
      <note pitch="G4">0.08</note>
      <rest>0.12</rest>
      <note pitch="C4">0.15</note>
      <rest>0.05</rest>
      <note pitch="G3">0.15</note>
      <rest>0.05</rest>
      <note pitch="C3">0.3</note>
    </sound>
    <sound name="rescue">
      <volume>0.2</volume>
      <part wave="square">
        <note pitch="C5">0.1</note>
        <note pitch="E5">0.1</note>
        <note pitch="G5">0.1</note>
        <note pitch="C6">0.1</note>
        <note pitch="G5">0.1</note>
        <note pitch="C6">0.3</note>
      </part>
      <part wave="triangle">
        <note pitch="C3">0.2</note>
        <note pitch="G3">0.2</note>
        <note pitch="C4">0.4</note>
      </part>
    </sound>
    <!-- play's music: the low beat under the girders -->
    <sound name="beat" wave="triangle">
      <loop />
      <volume>0.25</volume>
      <note pitch="C3">0.15</note>
      <rest>0.15</rest>
      <note pitch="C3">0.15</note>
      <rest>0.15</rest>
      <note pitch="G2">0.15</note>
      <rest>0.15</rest>
      <note pitch="A#2">0.15</note>
      <rest>0.15</rest>
    </sound>
    <!-- while he holds the hammer -->
    <sound name="hammertime" wave="square">
      <loop />
      <volume>0.1</volume>
      <note pitch="C5">0.1</note>
      <note pitch="E5">0.1</note>
      <note pitch="G5">0.1</note>
      <note pitch="E5">0.1</note>
    </sound>
  </sounds>
  <styles>
    <style name="banner"><size>48</size><color>color.red</color><font>assets/pressstart2p.ttf</font></style>
    <style name="prompt"><size>24</size><font>assets/pressstart2p.ttf</font></style>
    <style name="help"><size>16</size><font>assets/pressstart2p.ttf</font></style>
    <style name="hud"><size>24</size><font>assets/pressstart2p.ttf</font></style>
    <style name="wood">
      <scale>2</scale>
      <color>color.orange</color>
      <color char="b">color.brown</color>
    </style>
  </styles>
  <kit>
    <!-- a barrel, there once Kong throws it, eight at most,
         rolling as it goes, and seen end on going down a ladder -->
    <object name="barrel" class="barrel">
      <sprite name="flat">
        <bitmap style="wood">
          <row>...*****...</row>
          <row>.**bbbbb**.</row>
          <row>.*********.</row>
          <row>***********</row>
          <row>*bbbbbbbbb*</row>
          <row>***********</row>
          <row>*bbbbbbbbb*</row>
          <row>***********</row>
          <row>.*********.</row>
          <row>.**bbbbb**.</row>
          <row>...*****...</row>
        </bitmap>
      </sprite>
      <sprite name="end">
        <bitmap style="wood">
          <row>...*b*b*...</row>
          <row>.***b*b***.</row>
          <row>.***b*b***.</row>
          <row>****b*b****</row>
          <row>****b*b****</row>
          <row>****b*b****</row>
          <row>****b*b****</row>
          <row>****b*b****</row>
          <row>.***b*b***.</row>
          <row>.***b*b***.</row>
          <row>...*b*b*...</row>
        </bitmap>
      </sprite>
      <sprite name="down">
        <bitmap style="wood">
          <row>..*******..</row>
          <row>.*bbbbbbb*.</row>
          <row>*b*******b*</row>
          <row>*b*bbbbb*b*</row>
          <row>*b*b***b*b*</row>
          <row>*b*b*b*b*b*</row>
          <row>*b*b***b*b*</row>
          <row>*b*bbbbb*b*</row>
          <row>*b*******b*</row>
          <row>.*bbbbbbb*.</row>
          <row>..*******..</row>
        </bitmap>
      </sprite>
      <animation name="rolling">
        <interval>0.15</interval>
        <frame sprite="flat" />
        <frame sprite="end" />
      </animation>
      <velocity><x>roll</x></velocity>
      <acceleration><x>0</x><y>pull</y></acceleration>
      <most>8</most>
      <collisions>
        <collision edge="horizontal">
          <bounce />
          <set variable="self.luck"><random><min>0</min><max>1</max></random></set>
        </collision>
        <collision edge="bottom">
          <despawn />
        </collision>
        <collision class="girder">
          <land />
        </collision>
        <!-- at the top of a ladder, the unlucky ones go down -->
        <collision class="laddertop" sprite="rolling">
          <condition variable="luck"><below>0.3</below></condition>
          <trigger action="descend" />
        </collision>
        <!-- off the foot of it, standing still: it rolls on the other way -->
        <collision class="girder" sprite="down">
          <condition variable="velocity.x"><equal>0</equal></condition>
          <set variable="self.velocity.x">self.way</set>
          <set variable="self.luck"><random><min>0</min><max>1</max></random></set>
          <become sprite="rolling" />
        </collision>
        <!-- into the oil drum: it flares up, and lets out a fireball -->
        <collision object="oil">
          <spawn object="fireball"><position><x>oil.x + 4</x><y>oil.y - 24</y></position></spawn>
        </collision>
        <collision object="oil">
          <despawn />
        </collision>
        <!-- swung at with the hammer -->
        <collision object="man">
          <condition object="man" variable="hammer"><atleast>1</atleast></condition>
          <inc variable="man.score">300</inc>
          <play sound="smash" />
          <despawn />
        </collision>
      </collisions>
      <actions>
        <action name="descend">
          <set variable="self.way">0 - self.velocity.x</set>
          <become sprite="down" />
          <climb direction="down" class="ladder">1.5</climb>
        </action>
      </actions>
      <variables>
        <variable name="luck"><random><min>0</min><max>1</max></random></variable>
        <variable name="way">0</variable>
      </variables>
    </object>
    <!-- a fireball out of the oil drum, three at most: it wanders the
         girders, turning now and then, and climbs ladders -->
    <object name="fireball" class="fireball">
      <sprite name="a">
        <bitmap>
          <row>....*.....</row>
          <row>...**..*..</row>
          <row>..***.**..</row>
          <row>.**o*****.</row>
          <row>.*oooo***.</row>
          <row>**owwooo**</row>
          <row>*owwwwwo**</row>
          <row>*owkwkwo*.</row>
          <row>*owwwwwo*.</row>
          <row>.*ooooo*..</row>
          <scale>2</scale>
          <color>color.yellow</color>
          <color char="o">color.orange</color>
          <color char="w">color.white</color>
          <color char="k">color.black</color>
        </bitmap>
      </sprite>
      <sprite name="b">
        <bitmap>
          <row>.....*....</row>
          <row>..*..**...</row>
          <row>..**.***..</row>
          <row>.*****o**.</row>
          <row>.***oooo*.</row>
          <row>**oowwo***</row>
          <row>**owwwwwo*</row>
          <row>.*owkwkwo*</row>
          <row>.*owwwwwo*</row>
          <row>..*ooooo*.</row>
          <scale>2</scale>
          <color>color.yellow</color>
          <color char="o">color.orange</color>
          <color char="w">color.white</color>
          <color char="k">color.black</color>
        </bitmap>
      </sprite>
      <animation name="burning">
        <interval>0.12</interval>
        <frame sprite="a" />
        <frame sprite="b" />
      </animation>
      <animation name="climbing">
        <interval>0.12</interval>
        <frame sprite="b" />
        <frame sprite="a" />
      </animation>
      <velocity><x>1</x></velocity>
      <acceleration><x>0</x><y>pull</y></acceleration>
      <most>3</most>
      <collisions>
        <collision edge="horizontal">
          <bounce />
        </collision>
        <collision edge="bottom">
          <despawn />
        </collision>
        <collision class="girder">
          <land />
        </collision>
        <!-- walking into a ladder, now and then it climbs -->
        <collision class="ladder" side="horizontal" sprite="burning">
          <condition variable="luck"><below>0.5</below></condition>
          <trigger action="rise" />
        </collision>
        <collision class="girder" sprite="climbing">
          <condition variable="velocity.x"><equal>0</equal></condition>
          <set variable="self.velocity.x">self.way</set>
          <set variable="self.luck"><random><min>0</min><max>1</max></random></set>
          <become sprite="burning" />
        </collision>
        <collision object="man">
          <condition object="man" variable="hammer"><atleast>1</atleast></condition>
          <inc variable="man.score">500</inc>
          <play sound="smash" />
          <despawn />
        </collision>
      </collisions>
      <actions>
        <action name="rise">
          <set variable="self.way">self.velocity.x</set>
          <become sprite="climbing" />
          <climb direction="up" class="ladder">1</climb>
        </action>
      </actions>
      <variables>
        <variable name="luck"><random><min>0</min><max>1</max></random></variable>
        <variable name="way">0</variable>
      </variables>
      <timers>
        <timer sprite="burning">
          <every><random><min>1.5</min><max>4</max></random></every>
          <reverse />
          <set variable="self.luck"><random><min>0</min><max>1</max></random></set>
        </timer>
      </timers>
    </object>
  </kit>
  <objects>
    <!-- after a game, in both endings -->
    <object name="again">
      <sprite>
        <text style="prompt">
          <content>spacebar to play again</content>
        </text>
      </sprite>
      <position><x><centered /></x><y><centered>window.height.center + 70</centered></y></position>
    </object>
    <!-- the best score, kept from game to game -->
    <object name="best">
      <sprite>
        <text style="hud">
          <content>HIGH SCORE</content>
          <number>best.score</number>
        </text>
      </sprite>
      <position><x><centered /></x><y>margin</y></position>
      <variables>
        <variable name="score">0</variable>
      </variables>
    </object>
  </objects>
  <keeps>
    <keep object="best" />
  </keeps>
  <states>
    <state name="mainmenu">
      <objects>
        <object name="title">
          <sprite>
            <text style="banner">
              <content>DONKEY KONG</content>
            </text>
          </sprite>
          <position><x><centered /></x><y><centered>window.height.center - 150</centered></y></position>
        </object>
        <object name="help">
          <sprite>
            <text style="help">
              <content>how high can you get?</content>
            </text>
          </sprite>
          <position><x><centered /></x><y><centered>window.height.center - 40</centered></y></position>
        </object>
        <object name="keys">
          <sprite>
            <text style="help">
              <content>a d walk, w s climb (or arrows), space jumps</content>
              <color>color.lightgrey</color>
            </text>
          </sprite>
          <position><x><centered /></x><y><centered>window.height.center + 10</centered></y></position>
        </object>
        <object name="start">
          <sprite>
            <text style="prompt">
              <content>spacebar to start</content>
            </text>
          </sprite>
          <position><x><centered /></x><y><centered>window.height.center + 120</centered></y></position>
        </object>
      </objects>
      <shows>
        <show object="best" />
      </shows>
      <inputs>
        <input button="space">
          <push state="playing" />
        </input>
      </inputs>
    </state>
    <state name="playing">
