          <position><x>20</x><y>160 - kong.height</y></position>
          <facing>right</facing>
          <collisions />
          <variables>
            <variable name="wait">2.8</variable>
          </variables>
          <timers>
            <timer>
              <every>kong.wait</every>
              <fire object="barrel" />
            </timer>
          </timers>
        </object>
        <object name="pauline">
          <sprite>
            <bitmap>
              <row>..kkkkk...</row>
              <row>.kkkkkkk..</row>
              <row>.kksssk...</row>
              <row>.kssssk...</row>
              <row>..sssk....</row>
              <row>..*****...</row>
              <row>.*******..</row>
              <row>s*******s.</row>
              <row>..*****...</row>
              <row>.*******..</row>
              <row>.*******..</row>
              <row>*********.</row>
              <row>*********.</row>
              <row>.*******..</row>
              <row>..s...s...</row>
              <row>.ss..ss...</row>
              <scale>2</scale>
              <color>color.magenta</color>
              <color char="k">color.brown</color>
              <color char="s">color.orange</color>
            </bitmap>
          </sprite>
          <position><x>300</x><y>85 - pauline.height</y></position>
          <collisions />
        </object>
        <!-- the hammer, on the third girder -->
        <object name="hammer">
          <sprite>
            <bitmap style="wood">
              <row>.******.</row>
              <row>********</row>
              <row>********</row>
              <row>.******.</row>
              <row>...bb...</row>
              <row>...bb...</row>
              <row>...bb...</row>
              <row>...bb...</row>
              <row>...bb...</row>
              <row>...bb...</row>
            </bitmap>
          </sprite>
          <position><x>100</x><y>353 - 40 - hammer.height</y></position>
          <collisions>
            <collision object="man">
              <die />
            </collision>
          </collisions>
        </object>
        <object name="man">
          <sprite name="plain">
            <bitmap>
              <row>...*****....</row>
              <row>..*********.</row>
              <row>..kkkssks...</row>
              <row>.ksksssss...</row>
              <row>.ksskkkkk...</row>
              <row>...sssss....</row>
              <row>..bb*bb.....</row>
              <row>.bbb*bb*b...</row>
              <row>bbbb****bb..</row>
              <row>ssb*s**sbs..</row>
              <row>sss*****ss..</row>
              <row>ss.**.**.s..</row>
              <row>..***.***...</row>
              <row>.***...***..</row>
              <row>.kkk...kkk..</row>
              <row>kkkk...kkkk.</row>
              <scale>2</scale>
              <color>color.red</color>
              <color char="b">color.blue</color>
              <color char="s">color.orange</color>
              <color char="k">color.brown</color>
            </bitmap>
          </sprite>
          <sprite name="hammer">
            <bitmap>
              <row>.........ooo</row>
              <row>...*****.ooo</row>
              <row>..*******.b.</row>
              <row>..kkkssksb..</row>
              <row>.kskssssb...</row>
              <row>.ksskkkkb...</row>
              <row>...sssssb...</row>
              <row>..bb*bbsb...</row>
              <row>.bbb*bb*b...</row>
              <row>bbbb****bb..</row>
              <row>ssb*****bs..</row>
              <row>ss.**.**.s..</row>
              <row>..***.***...</row>
              <row>.***...***..</row>
              <row>.kkk...kkk..</row>
              <row>kkkk...kkkk.</row>
              <scale>2</scale>
              <color>color.red</color>
              <color char="b">color.blue</color>
              <color char="s">color.orange</color>
              <color char="k">color.brown</color>
              <color char="o">color.orange</color>
            </bitmap>
          </sprite>
          <position><x>100</x><y>656 - man.height</y></position>
          <acceleration><x>0</x><y>pull</y></acceleration>
          <collisions>
            <!-- his body, without the arms -->
            <hitbox>
              <rectangle><width>14</width><height>32</height></rectangle>
              <position><x>5</x><y>0</y></position>
            </hitbox>
            <collision edge="horizontal">
              <stick />
            </collision>
            <collision class="girder">
              <land />
              <set variable="self.leapt">0</set>
            </collision>
            <!-- down from a jump over a barrel -->
            <collision class="girder">
              <condition variable="over"><equal>1</equal></condition>
              <set variable="self.over">0</set>
              <inc variable="self.score">100</inc>
              <play sound="points" />
            </collision>
            <collision class="barrel">
              <condition variable="hammer"><equal>0</equal></condition>
              <trigger action="lose" />
            </collision>
            <collision class="fireball">
              <condition variable="hammer"><equal>0</equal></condition>
              <trigger action="lose" />
            </collision>
            <collision object="hammer">
              <become sprite="hammer" />
              <set variable="man.hammer">1</set>
              <play sound="hammertime" />
            </collision>
            <collision object="pauline">
              <inc variable="man.score">man.bonus</inc>
              <inc variable="man.rescues" />
              <dec variable="kong.wait">0.6</dec>
              <play sound="rescue" />
              <set variable="man.bonus">5000</set>
              <reset />
              <despawn object="barrel" />
              <despawn object="fireball" />
            </collision>
          </collisions>
          <actions>
            <action name="left">
              <move direction="left">walk</move>
            </action>
            <action name="right">
              <move direction="right">walk</move>
            </action>
            <action name="up">
              <climb direction="up" class="ladder">climbstep</climb>
            </action>
            <action name="down">
              <climb direction="down" class="ladder">climbstep</climb>
            </action>
            <action name="jump">
              <leap>leapheight</leap>
              <set variable="man.leapt">1</set>
              <play sound="jump" />
            </action>
            <action name="lose">
              <dec variable="man.lives" />
              <play sound="hit" />
              <silence sound="hammertime" />
              <set variable="man.hammer">0</set>
              <set variable="man.bonus">5000</set>
              <set variable="man.over">0</set>
              <reset />
              <despawn object="barrel" />
              <despawn object="fireball" />
            </action>
          </actions>
          <variables>
            <variable name="score">0</variable>
            <variable name="lives">3</variable>
            <variable name="rescues">0</variable>
            <variable name="hammer">0</variable>
            <variable name="bonus">5000</variable>
            <!-- in a jump, and a barrel passed under it -->
            <variable name="leapt">0</variable>
            <variable name="over">0</variable>
          </variables>
          <timers>
            <timer sprite="hammer">
              <after>9</after>
              <become sprite="plain" />
              <set variable="man.hammer">0</set>
              <silence sound="hammertime" />
            </timer>
          </timers>
        </object>
        <object name="score">
          <sprite>
            <text style="hud">
              <number>man.score</number>
            </text>
          </sprite>
          <position><x>margin</x><y>margin</y></position>
        </object>
        <object name="bonus">
          <sprite>
            <text style="hud">
              <content>BONUS</content>
              <number>man.bonus</number>
              <color>color.cyan</color>
            </text>
          </sprite>
          <position><x>window.right - bonus.width - margin</x><y>margin + 36</y></position>
        </object>
        <object name="lives">
          <sprite>
            <text style="hud">
              <content>LIVES</content>
              <number>man.lives</number>
              <color>color.red</color>
            </text>
          </sprite>
          <position><x>window.right - lives.width - margin</x><y>margin</y></position>
        </object>
      </objects>
      <shows>
        <show object="best" />
      </shows>
      <music sound="beat" />
      <inputs>
        <input button="a left"><trigger object="man" action="left" /></input>
        <input button="d right"><trigger object="man" action="right" /></input>
        <input button="w up"><trigger object="man" action="up" /></input>
        <input button="s down"><trigger object="man" action="down" /></input>
        <input button="space"><trigger object="man" action="jump" /></input>
        <input button="p escape"><push state="paused" /></input>
      </inputs>
      <conditions>
        <condition object="man" variable="rescues">
          <atleast>goal</atleast>
          <push state="youwin" />
        </condition>
        <condition object="man" variable="lives">
          <atmost>0</atmost>
          <push state="gameover" />
        </condition>
        <!-- the bonus run out -->
        <condition object="man" variable="bonus">
          <atmost>0</atmost>
          <trigger object="man" action="lose" />
        </condition>
        <!-- a barrel under him in a jump: scored when he lands -->
        <condition>
          <all>
            <condition object="man" variable="leapt"><equal>1</equal></condition>
            <condition class="barrel" distance="man"><below>64</below></condition>
          </all>
          <set variable="man.leapt">0</set>
          <set variable="man.over">1</set>
        </condition>
        <condition object="man" variable="score">
          <above>best.score</above>
          <copy variable="man.score" into="best.score" />
        </condition>
      </conditions>
      <timers>
        <timer>
          <every>2</every>
          <dec variable="man.bonus">100</dec>
        </timer>
      </timers>
    </state>
    <state name="paused">
      <objects>
        <object name="paused">
          <sprite>
            <text style="banner">
              <content>PAUSED</content>
              <color>color.white</color>
            </text>
          </sprite>
          <position><x><centered /></x><y><centered /></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input button="space p escape"><pop /></input>
      </inputs>
    </state>
    <state name="youwin">
      <objects>
        <object name="message">
          <sprite>
            <text style="banner">
              <content>YOU WIN</content>
              <color>color.green</color>
            </text>
          </sprite>
          <position><x><centered /></x><y><centered>window.height.center - 60</centered></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
        <show object="again" />
      </shows>
      <inputs>
        <input button="space"><reset /></input>
      </inputs>
    </state>
    <state name="gameover" from="youwin">
      <objects>
        <object name="message">
          <sprite>
            <text style="banner">
              <content>GAME OVER</content>
            </text>
          </sprite>
        </object>
      </objects>
    </state>
  </states>
</game>
