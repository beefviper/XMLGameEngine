<!-- doubles.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Nov 9, 2026 -->

<!--
  Doubles: a sliding number puzzle on a four by four board. Every key
  slides all the numbers as far as they go that way; two equal numbers
  that meet become one, their sum, and the sum is scored. After each move
  that changes the board a new 2 comes in a free square. Make 2048 to
  win; when the board is full and no two neighbours are equal, the game
  is over.

  W A S D or the arrows slide. Space starts and plays again;
  Pause pauses.

  How it is written:
  * The numbers are pieces on a <map> of <cells />, each holding its
    number in a variable, spawned into a <free /> square.
  * <slide class="tile"> slides every piece of the class, the one nearest
    that way first. It is refused when nothing moves, so the new 2 written
    after it comes only after a real move.
  * A step into another number is refused, and is a touch: the mover's
    rule <merge variable="value" />s them when their numbers are equal
    (once a slide), and the step goes on.
  * Each number counts its equal neighbours with
    <count><around><straight /><alike variable="value" /></around></count>;
    a full board where they add up to none is the end.
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../xgedef.xsd">
  <window name="Doubles">
    <width>480</width>
    <height>600</height>
  </window>
  <variables>
    <variable name="cell">100</variable>
    <variable name="left">40</variable>
    <variable name="top">140</variable>
  </variables>
  <styles>
    <style name="banner"><size>80</size><color>color.orange</color></style>
    <style name="prompt"><size>30</size></style>
    <style name="help"><size>20</size><color>color.lightgrey</color></style>
    <style name="hud"><size>30</size></style>
    <style name="number"><size>40</size><color>color.white</color></style>
  </styles>
  <states>
    <objects>
      <object name="again">
        <sprite><text style="prompt"><content>spacebar to play again</content></text></sprite>
        <position><x><centered /></x><y><centered><offset>70</offset></centered></y></position>
      </object>
    </objects>
    <state name="title">
      <objects>
        <object name="title">
          <sprite><text style="banner"><content>DOUBLES</content></text></sprite>
          <position><x><centered /></x><y><centered><offset>-120</offset></centered></y></position>
        </object>
        <group name="help">
          <rows>3</rows>
          <padding><y>30</y></padding>
          <sprite><text style="help" /></sprite>
          <position><x><centered /></x><y><centered><offset>-20</offset></centered></y></position>
          <row number="1"><sprite><text><content>w a s d or the arrows slide every number</content></text></sprite></row>
          <row number="2"><sprite><text><content>equal numbers that meet add up</content></text></sprite></row>
          <row number="3"><sprite><text><content>make 2048, pause key pauses</content></text></sprite></row>
        </group>
        <object name="start">
          <sprite><text style="prompt"><content>spacebar to start</content></text></sprite>
          <position><x><centered /></x><y><centered><offset>120</offset></centered></y></position>
        </object>
      </objects>
      <inputs>
        <input><button>space</button><button>pad1.start</button><push state="playing" /></input>
      </inputs>
    </state>
    <state name="playing">
      <objects>
        <object name="status">
          <!-- a key: everything slides; then, if anything moved, a new 2,
               and every number counts its equal neighbours again -->
          <actions>
            <action name="up"><slide class="tile" direction="up" /><trigger action="next" /></action>
            <action name="down"><slide class="tile" direction="down" /><trigger action="next" /></action>
            <action name="left"><slide class="tile" direction="left" /><trigger action="next" /></action>
            <action name="right"><slide class="tile" direction="right" /><trigger action="next" /></action>
            <action name="next">
              <spawn object="two" into="board"><free /></spawn>
              <trigger object="tiles" action="count" />
            </action>
          </actions>
          <variables>
            <variable name="score">0</variable>
          </variables>
        </object>
        <object name="scorelabel">
          <sprite><text style="hud"><content>score </content><number>status.score</number></text></sprite>
          <position><x>left</x><y>top - 60</y></position>
        </object>

        <!-- the squares, under the numbers -->
        <map name="squares">
          <tile><width>cell</width><height>cell</height></tile>
          <position><x>left</x><y>top</y></position>
          <cells />
          <row>....</row>
          <row>....</row>
          <row>....</row>
          <row>....</row>
          <group name="square" char=".">
            <sprite><rectangle><width>cell - 8</width><height>cell - 8</height><color>color.darkgrey</color></rectangle></sprite>
          </group>
        </map>
        <!-- the numbers -->
        <map name="board">
          <tile><width>cell</width><height>cell</height></tile>
          <position><x>left</x><y>top</y></position>
          <columns>4</columns>
          <rows>4</rows>
          <cells />
          <group name="tiles" class="tile">
            <sprite><text style="number"><number>self.value</number></text></sprite>
            <collisions>
              <!-- meeting an equal number: one, the sum -->
              <collision class="tile">
                <merge variable="value" />
                <inc variable="status.score">self.value</inc>
                <play sound="merge" />
              </collision>
            </collisions>
            <actions>
              <action name="count">
                <count class="tile" into="self.pairs"><around><straight /><alike variable="value" /></around></count>
              </action>
            </actions>
            <variables>
              <variable name="value">2</variable>
              <variable name="pairs">0</variable>
            </variables>
            <!-- waiting to be spawned -->
            <group name="two" />
          </group>
        </map>
      </objects>
      <inputs>
        <input><button>w</button><button>up</button><button>pad1.up</button><trigger object="status" action="up" /></input>
        <input><button>s</button><button>down</button><button>pad1.down</button><trigger object="status" action="down" /></input>
        <input><button>a</button><button>left</button><button>pad1.left</button><trigger object="status" action="left" /></input>
        <input><button>d</button><button>right</button><button>pad1.right</button><trigger object="status" action="right" /></input>
        <input><button>pause</button><button>pad1.start</button><push state="paused" /></input>
      </inputs>
      <conditions>
        <condition class="tile" variable="value">
          <atleast>2048</atleast>
          <play sound="won" />
          <become object="over.message" sprite="won" />
          <push state="over" />
        </condition>
        <!-- full, and no two equal side by side: no move is left -->
        <condition class="tile" total="count">
          <equal>16</equal>
          <condition class="tile" variable="pairs" total="sum">
            <equal>0</equal>
            <play sound="over" />
            <become object="over.message" sprite="lost" />
            <push state="over" />
          </condition>
        </condition>
      </conditions>
      <timers>
        <!-- two numbers to begin with -->
        <timer>
          <after>0</after>
          <spawn object="two" into="board"><free /></spawn>
          <spawn object="two" into="board"><free /></spawn>
        </timer>
      </timers>
    </state>
    <state name="paused">
      <objects>
        <object name="paused">
          <sprite><text style="banner"><content>PAUSED</content><color>color.white</color></text></sprite>
          <position><x><centered /></x><y><centered /></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input><button>pause</button><button>pad1.start</button><pop /></input>
      </inputs>
    </state>
    <state name="over">
      <objects>
        <object name="message">
          <sprite name="won"><text style="banner"><content>2048!</content><color>color.gold</color></text></sprite>
          <sprite name="lost"><text style="banner"><content>NO MOVES</content><color>color.red</color></text></sprite>
          <position><x><centered /></x><y><centered><offset>-60</offset></centered></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
        <show object="again" />
      </shows>
      <inputs>
        <input><button>space</button><button>pad1.start</button><reset /></input>
      </inputs>
    </state>
  </states>
  <sounds>
    <sound name="merge"><note pitch="E5">0.04</note><note pitch="A5">0.05</note></sound>
    <sound name="won"><note pitch="C5">0.1</note><note pitch="E5">0.1</note><note pitch="G5">0.1</note><note pitch="C6">0.3</note></sound>
    <sound name="over" wave="triangle"><note pitch="E4" to="E1">0.7</note></sound>
  </sounds>
</game>
