<!-- crazyeights.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Nov 2, 2026 -->

<!--
  Crazy Eights, the old shedding game: you against the computer, one pack
  of 52 cards.

  Each player is dealt seven cards; one card is turned up to start the
  discard pile, and the rest are the stock. On your turn, play one card
  that matches the top of the discard pile by suit or by rank. An eight is
  wild: it goes on anything, and whoever plays it names the suit to follow
  (here, by pointing at a card of that suit in their own hand). You may
  draw from the stock whenever you like, and must when you cannot play;
  when it runs out, the discard pile but its top card is shuffled into a
  new stock. The first to get rid of every card wins. An eight turned up to
  start counts as its own suit.

  A and D or the arrows move along your hand, W and S between your hand
  and the stock. Space plays the card pointed at, or draws from the stock;
  after an eight, Space names the suit of the card pointed at. With the
  mouse, click a card to play it, the stock to draw. P or Escape pauses.

  How it is written:
  * The pack is a group, a row for each suit and a column for each rank,
    each face its own cell of the card sheet; a <holds> holds them.
  * The players are a group that takes <turns>, you first; the computer is
    the member with a <think>. Each <owns> the holder of its cards, kept in
    <order> by suit, then rank; the computer's face down.
  * The discard pile <accepts> <any> of the same suit or the same rank, and
    an eight is <wild>: who lays it names the suit (`called`) that the
    eight then counts as; while it waits (`calling`) the turn does not pass.
  * Picked from, the stock sends one to the player's own cards; empty, the
    discard pile but its top comes back, in random order.
  * The <starts>: the pack into the stock, shuffled, seven to each player
    and one turned up.
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../xgedef.xsd">
  <window name="Crazy Eights">
    <width>880</width>
    <height>840</height>
    <background>color.darkgreen</background>
  </window>
  <variables>
    <variable name="cardwidth">96</variable>
    <variable name="cardheight">140</variable>
    <variable name="left">56</variable>
    <variable name="theirs">60</variable>
    <variable name="middle">310</variable>
    <variable name="yours">580</variable>
  </variables>
  <sounds>
    <sound name="card" wave="noise"><note pitch="C6">0.03</note></sound>
    <sound name="deal" wave="noise"><note pitch="G5">0.02</note><note pitch="C6">0.02</note></sound>
    <sound name="call"><note pitch="G5">0.08</note><note pitch="C6">0.12</note></sound>
    <sound name="win">
      <note pitch="C5">0.12</note>
      <note pitch="E5">0.12</note>
      <note pitch="G5">0.12</note>
      <note pitch="C6">0.4</note>
    </sound>
    <sound name="lose">
      <note pitch="G4">0.15</note>
      <note pitch="E4">0.15</note>
      <note pitch="C4">0.4</note>
    </sound>
  </sounds>
  <styles>
    <style name="banner"><size>80</size><color>color.yellow</color></style>
    <style name="prompt"><size>32</size></style>
    <style name="help"><size>22</size><color>color.lightgrey</color></style>
    <style name="note"><size>26</size><color>color.white</color></style>
  </styles>
  <!-- the card sheet: a row for each suit, a column for each rank, then a row of backs -->
  <sheets>
    <sheet name="cards"><path>assets/cards.png</path><columns>13</columns><rows>5</rows></sheet>
  </sheets>
  <states>
    <state name="title">
      <objects>
        <object name="title">
          <sprite><text style="banner"><content>CRAZY EIGHTS</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 170</centered></y></position>
        </object>
        <object name="help1">
          <sprite><text style="help"><content>play a card of the same suit or rank as the top of the pile;</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 90</centered></y></position>
        </object>
        <object name="help2">
          <sprite><text style="help"><content>eights go on anything and name the next suit. first out wins</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 60</centered></y></position>
        </object>
        <object name="help3">
          <sprite><text style="help"><content>a d or the arrows pick a card, w s to the stock, spacebar plays or draws;</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 20</centered></y></position>
        </object>
        <object name="help4">
          <sprite><text style="help"><content>after an eight, spacebar on a card names its suit. or click with the mouse</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center + 10</centered></y></position>
        </object>
        <object name="start">
          <sprite><text style="prompt"><content>spacebar to deal</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center + 170</centered></y></position>
        </object>
      </objects>
      <inputs>
        <input><button>space</button><button>pad1.start</button><push state="playing" /></input>
      </inputs>
    </state>
    <state name="playing">
      <objects>
        <!-- the pack: a row for each suit (spades, hearts, clubs, diamonds), a column for each rank, each face its own cell of the card sheet -->
        <group name="cards" class="card">
          <columns>13</columns>
          <rows>4</rows>
          <sprite name="face"><cell sheet="cards"><scale>0.5</scale></cell></sprite>
          <sprite name="back"><cell sheet="cards"><column>1</column><row>5</row><scale>0.5</scale></cell></sprite>
          <position><x>0</x><y>0</y></position>
        </group>

        <!-- the computer's cards, face down along the top -->
        <object name="theirs" class="place">
          <sprite><rectangle><width>cardwidth</width><height>cardheight</height><color>color.darkgreen</color></rectangle></sprite>
          <position><x>left</x><y>theirs</y></position>
          <holds class="card" sprite="back">
            <spread><x>40</x><width>768</width></spread>
            <order><by variable="suit" /><by variable="rank" /></order>
          </holds>
        </object>

        <!-- the stock: picked from, it sends one to the player's own cards; empty, the discard pile but its top comes back -->
        <object name="stock" class="place">
          <sprite><rectangle><width>cardwidth</width><height>cardheight</height><color>color.forestgreen</color></rectangle></sprite>
          <position><x>window.width.center - cardwidth - 24</x><y>middle</y></position>
          <holds class="card" sprite="back">
            <picked>
              <send>1</send>
              <empty><send from="discard"><all /><leave>1</leave></send><order><random /></order></empty>
              <play sound="deal" />
            </picked>
          </holds>
        </object>

        <!-- the discard pile: the same suit (or the suit called) or the same rank; an eight on anything, and its player names the suit -->
        <object name="discard" class="place">
          <sprite><rectangle><width>cardwidth</width><height>cardheight</height><color>color.forestgreen</color></rectangle></sprite>
          <position><x>window.width.center + 24</x><y>middle</y></position>
          <holds class="card" sprite="face">
            <accepts>
              <any>
                <condition variable="suit"><equal>top.suit</equal></condition>
                <condition variable="rank"><equal>top.rank</equal></condition>
              </any>
              <wild variable="suit"><condition variable="rank"><equal>8</equal></condition></wild>
            </accepts>
          </holds>
        </object>

        <!-- the suit called after an eight, beside the pile -->
        <object name="called">
          <sprite><text style="note"><choose><by>discard.called</by><word></word><word>spades</word><word>hearts</word><word>clubs</word><word>diamonds</word></choose></text></sprite>
          <position><x>window.width.center + cardwidth + 48</x><y>middle + cardheight / 2 - 14</y></position>
        </object>

        <!-- whose turn, and an eight waiting for its suit -->
        <object name="whoseturn">
          <sprite><text style="note"><choose><by>you.turn</by><word>the computer is playing</word><word>your turn: play a card that matches, or draw</word></choose></text></sprite>
          <position><x>left</x><y>middle + cardheight + 40</y></position>
        </object>
        <object name="calling">
          <sprite><text style="note"><choose><by>discard.calling</by><word></word><word>an eight: its player names a suit, pointing at a card of it</word></choose><color>color.cyan</color></text></sprite>
          <position><x>left</x><y>middle + cardheight + 76</y></position>
        </object>

        <!-- your cards, face up along the bottom, in suit and rank order -->
        <object name="mine" class="place">
          <sprite><rectangle><width>cardwidth</width><height>cardheight</height><color>color.darkgreen</color></rectangle></sprite>
          <position><x>left</x><y>yours</y></position>
          <holds class="card" sprite="face">
            <spread><x>56</x><width>768</width></spread>
            <lift>16</lift>
            <order><by variable="suit" /><by variable="rank" /></order>
          </holds>
        </object>

        <!-- the players, you first: a frame around the card each points at, nothing off its turn -->
        <group name="players" class="player">
          <sprite name="free">
            <line><from><x>1</x><y>1</y></from><to><x>cardwidth + 5</x><y>1</y></to><color>color.yellow</color><thickness>3</thickness></line>
            <line><from><x>cardwidth + 5</x><y>1</y></from><to><x>cardwidth + 5</x><y>cardheight + 5</y></to><color>color.yellow</color><thickness>3</thickness></line>
            <line><from><x>cardwidth + 5</x><y>cardheight + 5</y></from><to><x>1</x><y>cardheight + 5</y></to><color>color.yellow</color><thickness>3</thickness></line>
            <line><from><x>1</x><y>cardheight + 5</y></from><to><x>1</x><y>1</y></to><color>color.yellow</color><thickness>3</thickness></line>
          </sprite>
          <sprite name="calling">
            <line><from><x>1</x><y>1</y></from><to><x>cardwidth + 5</x><y>1</y></to><color>color.cyan</color><thickness>3</thickness></line>
            <line><from><x>cardwidth + 5</x><y>1</y></from><to><x>cardwidth + 5</x><y>cardheight + 5</y></to><color>color.cyan</color><thickness>3</thickness></line>
            <line><from><x>cardwidth + 5</x><y>cardheight + 5</y></from><to><x>1</x><y>cardheight + 5</y></to><color>color.cyan</color><thickness>3</thickness></line>
            <line><from><x>1</x><y>cardheight + 5</y></from><to><x>1</x><y>1</y></to><color>color.cyan</color><thickness>3</thickness></line>
          </sprite>
          <sprite name="waiting">
            <line><from><x>1</x><y>1</y></from><to><x>cardwidth + 5</x><y>1</y></to><color>color.darkgreen</color><thickness>3</thickness></line>
            <line><from><x>cardwidth + 5</x><y>1</y></from><to><x>cardwidth + 5</x><y>cardheight + 5</y></to><color>color.darkgreen</color><thickness>3</thickness></line>
            <line><from><x>cardwidth + 5</x><y>cardheight + 5</y></from><to><x>1</x><y>cardheight + 5</y></to><color>color.darkgreen</color><thickness>3</thickness></line>
            <line><from><x>1</x><y>cardheight + 5</y></from><to><x>1</x><y>1</y></to><color>color.darkgreen</color><thickness>3</thickness></line>
          </sprite>
          <actions>
            <action name="left"><hop direction="left" /></action>
            <action name="right"><hop direction="right" /></action>
            <action name="up"><hop direction="up" /></action>
            <action name="down"><hop direction="down" /></action>
            <action name="point"><track /></action>
            <!-- the card pointed at onto the discard pile, if it goes there, and the next one's turn; on the stock, one drawn -->
            <action name="play"><pick class="card" /><place into="discard" /><play sound="card" /><pass /></action>
            <action name="back"><drop /></action>
            <!-- after an eight: the suit of the card pointed at is named -->
            <action name="call"><call pile="discard" /><play sound="call" /><become sprite="free" /><pass /></action>
          </actions>
          <turns sprite="waiting" />
          <member name="you">
            <position><x>left - 3</x><y>yours - 3</y></position>
            <owns object="mine" />
          </member>
          <!-- the computer points at the card it plays (the suit it holds most of, eights last) or the stock, and presses Space -->
          <member name="computer">
            <sprite name="free">
            <line><from><x>1</x><y>1</y></from><to><x>cardwidth + 5</x><y>1</y></to><color>color.lightgrey</color><thickness>3</thickness></line>
            <line><from><x>cardwidth + 5</x><y>1</y></from><to><x>cardwidth + 5</x><y>cardheight + 5</y></to><color>color.lightgrey</color><thickness>3</thickness></line>
            <line><from><x>cardwidth + 5</x><y>cardheight + 5</y></from><to><x>1</x><y>cardheight + 5</y></to><color>color.lightgrey</color><thickness>3</thickness></line>
            <line><from><x>1</x><y>cardheight + 5</y></from><to><x>1</x><y>1</y></to><color>color.lightgrey</color><thickness>3</thickness></line>
          </sprite>
            <position><x>left - 3</x><y>theirs - 3</y></position>
            <owns object="theirs" />
            <think button="space" />
          </member>
        </group>
      </objects>
      <!-- the deal: the pack into the stock, shuffled, seven to each player and one turned up -->
      <starts>
        <send from="cards" into="stock"><all /></send>
        <order group="stock"><random /></order>
        <distribute from="stock" into="mine">7</distribute>
        <distribute from="stock" into="theirs">7</distribute>
        <send from="stock" into="discard">1</send>
      </starts>
      <inputs>
        <input><button>a</button><button>left</button><button>pad1.left</button><trigger object="players" action="left" /></input>
        <input><button>d</button><button>right</button><button>pad1.right</button><trigger object="players" action="right" /></input>
        <input><button>w</button><button>up</button><button>pad1.up</button><trigger object="players" action="up" /></input>
        <input><button>s</button><button>down</button><button>pad1.down</button><trigger object="players" action="down" /></input>
        <!-- after an eight, call; else play, or put back if it does not go -->
        <input>
          <button>space</button><button>pad1.a</button><button>mouse.left</button>
          <trigger object="players" action="call" from="calling" />
          <trigger object="players" action="play" from="free">
            <otherwise><trigger object="players" action="back" /></otherwise>
          </trigger>
        </input>
        <input axis="mouse.x"><trigger object="players" action="point" /></input>
        <input axis="mouse.y"><trigger object="players" action="point" /></input>
        <input><button>p</button><button>escape</button><button>pad1.start</button><push state="paused" /></input>
      </inputs>
      <conditions>
        <!-- first out wins -->
        <condition object="mine" variable="held">
          <equal>0</equal>
          <become object="over.winner" sprite="you" />
          <play sound="win" />
          <push state="over" />
        </condition>
        <condition object="theirs" variable="held">
          <equal>0</equal>
          <become object="over.winner" sprite="computer" />
          <play sound="lose" />
          <push state="over" />
        </condition>
        <!-- an eight laid: the player on its turn names a suit -->
        <condition object="discard" variable="calling">
          <equal>1</equal>
          <become object="players" sprite="calling" from="free" />
        </condition>
      </conditions>
    </state>
    <state name="paused">
      <objects>
        <object name="paused">
          <sprite><text style="banner"><content>PAUSED</content><color>color.white</color></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 40</centered></y></position>
        </object>
        <object name="newdeal">
          <sprite><text style="prompt"><content>n for a new deal</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center + 40</centered></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input><button>space</button><button>p</button><button>escape</button><button>pad1.start</button><pop /></input>
        <input><button>n</button><reset /></input>
      </inputs>
    </state>
    <state name="over">
      <objects>
        <object name="winner">
          <sprite name="you"><text style="banner"><content>YOU WIN</content></text></sprite>
          <sprite name="computer"><text style="banner"><content>COMPUTER WINS</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 40</centered></y></position>
        </object>
        <object name="again">
          <sprite><text style="prompt"><content>spacebar to deal again</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center + 40</centered></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input><button>space</button><button>pad1.start</button><reset /></input>
      </inputs>
    </state>
  </states>
</game>
