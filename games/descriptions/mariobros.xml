              <row>.kksssskkkk.</row>
              <row>...ssssss...</row>
              <row>..rrbrrr....</row>
              <row>.rrrbrrbrr..</row>
              <row>.rrrbbbbrrs.</row>
              <row>.ssbybbybss.</row>
              <row>.ssbbbbbbss.</row>
              <row>..bbbbbbbb..</row>
              <row>.bbb....bbb.</row>
              <row>kkk......kkk</row>
              <row>kk........kk</row>
