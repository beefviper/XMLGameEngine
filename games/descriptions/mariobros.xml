              <row>...ssssss...</row>
              <row>...rrbrr....</row>
              <row>..rrrbbrr...</row>
              <row>..rrbbbbrr..</row>
              <row>..sbybbybs..</row>
              <row>..sbbbbbbs..</row>
              <row>...bbbbbb...</row>
              <row>....bbbb....</row>
              <row>...kkkkkk...</row>
              <row>...kkkkkk...</row>
            </bitmap>
          </sprite>
          <sprite name="stepc">
            <bitmap style="mario">
              <row>...rrrrr....</row>
              <row>..rrrrrrrrr.</row>
