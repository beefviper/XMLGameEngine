<!-- mariobros.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Oct 16, 2026 -->

<!--
  Mario Bros., after the 1983 arcade game: Mario in the sewer under three
  levels of brick floor, on the arcade's own small screen (256 by 224),
  shown three times as big. Shellcreepers come out of the pipes at the top,
  one after another, walk off the ends of the floors down to the bottom and
  go into the pipes there, to come out at the top again. Jump up and bump
  the floor under one to turn it on its back, then run into it to kick it
  off for 800 points; bump it again first and it gets back up. A
  shellcreeper still on its feet costs a life (Mario comes back blinking,
  safe for two seconds), and one left on its back too long gets up where it
  lies and walks on faster, turned red (a palette swap: <become style>). The POW block turns over every shellcreeper on
  its feet at once, three times. Kick off all six to win. The high score is
  kept.

  A or D (or the arrows) walk, Space starts and jumps, P or Escape pauses.

  It is the game a <knock> through a floor was made for, and the one Mario's
  poses were made for:
  * Mario has looks for each way he moves (<poses>): standing, a walk of
    three steps (a look that moves, a named <animation>), skidding, rising
    and falling. The engine picks one each frame from how he moves. His
    pictures face right, and <mirror>left</mirror> draws them the other way
    round when he goes left.
  * His <grip> is low, so he takes a moment to get up to speed and slides
    when he lets go or turns: that slide is when he skids, as in the arcade.
  * Mario has no <mass>, and nor has a floor: his head hitting a floor from
    below is a <knock> that goes through it, to whatever with a mass stands
    on that piece of floor. That shellcreeper runs its own rules about Mario
    as touched on its bottom side: a little hop, and it goes over
    (<become sprite="flipped" />) or gets back up.
  * The floors are bricks, one bitmap in a group of floors laid out in
    columns, so a bump reaches only what stands over the brick Mario hit.
  * How Mario touches a shellcreeper decides what happens: through="floor"
    is a bump through the floor; any other touch is Mario himself running,
    jumping or falling into it.
  * A shellcreeper walks (two steps) and lies on its back kicking (two
    more), each a look that moves, and is drawn turned the way it goes.
    On its back it keeps the way it was going (self.way) and lies still;
    getting up, it sets off that way again. Its down says it has lain there
    a moment, so the bump that turns it over does not also run the rule
    that gets it up.
  * The shellcreepers start out of play and are let out by the state's
    timers. They are drawn before the pipes, so they come out of them and
    go into them, and one on the ground deep in a pipe at either side is
    reset to its start, in its pipe at the top.
  * Mario blinks for two seconds after losing a life (mario.blink), and a
    shellcreeper does him no harm while he does.
  * The POW block's looks are how many bumps it has left; each bump runs
    every shellcreeper's action "powed" (a <trigger> of the group): one on
    a floor hops (<leap>) and, on its feet, goes over; one in the air
    cannot leap, so the rest of the action is refused and it is left alone.
  * A shellcreeper turned over keeps going sideways through its hop, so one
    bumped near the end of a floor sails off it and lands below, still on
    its back. Two on their feet that meet turn round (<bounce />).
  * Everything wraps round the sides of the screen.
  No fighter flies, sidesteppers, coins or second player: see
  docs/designs/56-games-atari.md.
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../xgedef.xsd">
  <window name="Mario Bros.">
    <width>256</width>
    <height>224</height>
    <scale>3</scale>
  </window>
  <variables>
    <variable name="pull">0.3</variable>
    <variable name="walk">1.25</variable>
    <variable name="crawl">0.5</variable>
    <variable name="hop">2.5</variable>
    <variable name="leapheight">56</variable>
    <!-- the top of each level of floor -->
    <variable name="top">64</variable>
    <variable name="middle">112</variable>
    <variable name="low">160</variable>
    <variable name="ground">208</variable>
  </variables>
  <sounds>
    <!-- the arcade's start: the opening of Eine kleine Nachtmusik -->
    <sound name="start" wave="square">
      <volume>0.2</volume>
      <note pitch="G5">0.24</note>
      <rest>0.06</rest>
      <note pitch="D5">0.12</note>
      <note pitch="G5">0.24</note>
      <rest>0.06</rest>
      <note pitch="D5">0.12</note>
      <note pitch="G5">0.12</note>
      <note pitch="D5">0.12</note>
      <note pitch="G5">0.12</note>
      <note pitch="B5">0.12</note>
      <note pitch="D6">0.36</note>
    </sound>
    <sound name="jump" wave="square">
      <volume>0.15</volume>
      <note pitch="C5" to="C6">0.12</note>
    </sound>
    <sound name="bump" wave="square">
      <volume>0.3</volume>
      <note pitch="C3">0.06</note>
    </sound>
    <sound name="flip" wave="square">
      <volume>0.2</volume>
      <note pitch="G5" to="G4">0.15</note>
    </sound>
    <sound name="kick" wave="square">
      <volume>0.2</volume>
      <note pitch="C5">0.06</note>
      <note pitch="E5">0.06</note>
      <note pitch="G5">0.06</note>
      <note pitch="C6">0.12</note>
    </sound>
    <sound name="pow" wave="noise">
      <volume>0.4</volume>
      <note pitch="400" to="40">0.4</note>
    </sound>
    <sound name="hit">
      <volume>0.3</volume>
      <part wave="square">
        <note pitch="C5">0.1</note>
        <note pitch="G4">0.1</note>
        <note pitch="E4">0.1</note>
        <note pitch="C4">0.3</note>
      </part>
      <part wave="triangle">
        <note pitch="E4" to="E2">0.6</note>
      </part>
    </sound>
  </sounds>
  <styles>
    <style name="banner"><size>16</size><color>color.red</color><font>assets/pressstart2p.ttf</font></style>
    <style name="text"><size>8</size><font>assets/pressstart2p.ttf</font></style>
    <style name="mario">
      <color char="r">color.red</color>
      <color char="b">color.blue</color>
      <color char="s">color.orange</color>
      <color char="k">color.brown</color>
      <color char="y">color.yellow</color>
    </style>
    <style name="creeper">
      <color char="G">color.darkgreen</color>
      <color char="g">color.green</color>
      <color char="o">color.orange</color>
      <color char="w">color.white</color>
    </style>
    <!-- a shellcreeper that got up by itself: the same pictures in red -->
    <style name="angry">
      <color char="G">color.brown</color>
      <color char="g">color.red</color>
    </style>
    <style name="pow">
      <color>color.cyan</color>
      <color char="b">color.blue</color>
      <color char="w">color.darkblue</color>
    </style>
  </styles>
  <objects>
    <object name="again">
      <sprite>
        <text style="text">
          <content>space to play again</content>
        </text>
      </sprite>
      <position><x><centered /></x><y><centered>window.height.center + 30</centered></y></position>
    </object>
    <!-- the best score, kept from game to game -->
    <object name="best">
      <sprite>
        <text style="text">
          <content>TOP</content>
          <number>best.score</number>
        </text>
      </sprite>
      <position><x><centered /></x><y>4</y></position>
      <variables>
        <variable name="score">0</variable>
      </variables>
    </object>
  </objects>
  <keeps>
    <keep object="best" />
  </keeps>
  <states>
    <state name="mainmenu">
      <objects>
        <object name="title">
          <sprite>
            <text style="banner">
              <content>MARIO BROS.</content>
            </text>
          </sprite>
          <position><x><centered /></x><y><centered>window.height.center - 56</centered></y></position>
        </object>
        <object name="help">
          <sprite>
            <text style="text">
              <content>bump a shellcreeper from below</content>
            </text>
          </sprite>
          <position><x><centered /></x><y><centered>window.height.center - 12</centered></y></position>
        </object>
        <object name="help2">
          <sprite>
            <text style="text">
              <content>then kick it off</content>
            </text>
          </sprite>
          <position><x><centered /></x><y><centered>window.height.center</centered></y></position>
        </object>
        <object name="keys">
          <sprite>
            <text style="text">
              <content>a d or arrows walk, space jumps</content>
              <color>color.lightgrey</color>
            </text>
          </sprite>
          <position><x><centered /></x><y><centered>window.height.center + 20</centered></y></position>
        </object>
        <object name="start">
          <sprite>
            <text style="text">
              <content>space to start</content>
            </text>
          </sprite>
          <position><x><centered /></x><y><centered>window.height.center + 48</centered></y></position>
        </object>
      </objects>
      <shows>
        <show object="best" />
      </shows>
      <inputs>
        <input button="space">
          <play sound="start" />
          <push state="playing" />
        </input>
      </inputs>
    </state>
    <state name="playing">
      <objects>
        <!-- the floors, in bricks, so that a bump is felt only over the brick
             that was hit: the ground, then three levels of blue -->
        <group name="floors" class="floor">
          <columns>6</columns>
          <rows>1</rows>
          <sprite>
            <bitmap>
              <row>****************</row>
              <row>***.*******.****</row>
              <row>****************</row>
              <row>.*******.*******</row>
              <row>****************</row>
              <row>**.*****.****.**</row>
              <row>****************</row>
              <row>.*.*.*.*.*.*.*.*</row>
              <color>color.blue</color>
            </bitmap>
          </sprite>
          <collisions />
          <group name="ground">
            <columns>16</columns>
            <sprite>
              <bitmap>
                <row>****************</row>
                <row>****.*******.***</row>
                <row>****.*******.***</row>
                <row>****************</row>
                <row>********.*******</row>
                <row>********.*******</row>
                <row>****************</row>
                <row>****************</row>
                <row>**.*******.*****</row>
                <row>**.*******.*****</row>
                <row>****************</row>
                <row>****************</row>
                <row>******.*******.*</row>
                <row>******.*******.*</row>
                <row>****************</row>
                <row>****************</row>
                <color>color.orange</color>
              </bitmap>
            </sprite>
            <position><x>0</x><y>ground</y></position>
          </group>
          <group name="lowleft">
            <position><x>0</x><y>low</y></position>
          </group>
          <group name="lowright">
            <position><x>window.right - 96</x><y>low</y></position>
          </group>
          <group name="middle">
            <columns>8</columns>
            <position><x>64</x><y>middle</y></position>
          </group>
          <group name="midleft">
            <columns>2</columns>
            <position><x>0</x><y>middle</y></position>
          </group>
          <group name="midright">
            <columns>2</columns>
            <position><x>window.right - 32</x><y>middle</y></position>
          </group>
          <group name="topleft">
            <position><x>0</x><y>top</y></position>
          </group>
          <group name="topright">
            <position><x>window.right - 96</x><y>top</y></position>
          </group>
        </group>
        <!-- POW: bumped from below, every shellcreeper on its feet goes over;
             it shrinks with each bump, and is gone after three -->
        <object name="pow" class="pow">
          <sprite name="three">
            <bitmap style="pow">
              <row>bbbbbbbbbbbbbbbb</row>
              <row>b**************b</row>
              <row>b**************b</row>
              <row>b**************b</row>
              <row>b**************b</row>
              <row>b*www*www*w***wb</row>
              <row>b*w*w*w*w*w***wb</row>
              <row>b*www*w*w*w*w*wb</row>
              <row>b*w***w*w*w*w*wb</row>
              <row>b*w***www**w*w*b</row>
              <row>b**************b</row>
              <row>b**************b</row>
              <row>b**************b</row>
              <row>b**************b</row>
              <row>b**************b</row>
              <row>bbbbbbbbbbbbbbbb</row>
            </bitmap>
          </sprite>
          <sprite name="two">
            <bitmap style="pow">
              <row>bbbbbbbbbbbbbbbb</row>
              <row>b**************b</row>
              <row>b**************b</row>
              <row>b*www*www*w***wb</row>
              <row>b*w*w*w*w*w***wb</row>
              <row>b*www*w*w*w*w*wb</row>
              <row>b*w***w*w*w*w*wb</row>
              <row>b*w***www**w*w*b</row>
              <row>b**************b</row>
              <row>b**************b</row>
              <row>bbbbbbbbbbbbbbbb</row>
            </bitmap>
          </sprite>
          <sprite name="one">
            <bitmap style="pow">
              <row>bbbbbbbbbbbbbbbb</row>
              <row>b*www*www*w***wb</row>
              <row>b*www*w*w*w*w*wb</row>
              <row>b*w***www**w*w*b</row>
              <row>b**************b</row>
              <row>bbbbbbbbbbbbbbbb</row>
            </bitmap>
          </sprite>
          <position><x>window.width.center - 8</x><y>low</y></position>
          <collisions>
            <!-- last look first, so one bump changes it only once -->
            <collision object="mario" side="bottom" sprite="one">
              <trigger object="creepers" action="powed" />
              <play sound="pow" />
              <die />
            </collision>
            <collision object="mario" side="bottom" sprite="two">
              <become sprite="one" />
              <trigger object="creepers" action="powed" />
              <play sound="pow" />
            </collision>
            <collision object="mario" side="bottom" sprite="three">
              <become sprite="two" />
              <trigger object="creepers" action="powed" />
              <play sound="pow" />
            </collision>
          </collisions>
        </object>
        <!-- out of play until the state's timers let them out of the top
             pipes, the odd ones on the left going right, the even ones on
             the right going left -->
        <group name="creepers" class="enemy">
          <sprite name="wa">
            <bitmap style="creeper">
              <row>......GGGG......</row>
              <row>....GGgGGgGG....</row>
              <row>...GgggGGgggG...</row>
              <row>..GGGGGGGGGGGG..</row>
              <row>..GgggGGGGgggGoo</row>
              <row>..GGGGGGGGGGGGow</row>
              <row>...wwwwwwwwwwwoo</row>
              <row>....oo....oooo..</row>
              <row>...ooo.....ooo..</row>
              <row>...oo.......oo..</row>
            </bitmap>
          </sprite>
          <sprite name="wb">
            <bitmap style="creeper">
              <row>......GGGG......</row>
              <row>....GGgGGgGG....</row>
              <row>...GgggGGgggG...</row>
              <row>..GGGGGGGGGGGG..</row>
              <row>..GgggGGGGgggGoo</row>
              <row>..GGGGGGGGGGGGow</row>
              <row>...wwwwwwwwwwwoo</row>
              <row>.....oooo.ooo...</row>
              <row>.....ooo..ooo...</row>
              <row>......oo...oo...</row>
            </bitmap>
          </sprite>
          <sprite name="fa">
            <bitmap style="creeper">
              <row>................</row>
              <row>...o..o..o..o...</row>
              <row>...o..o..o..o...</row>
              <row>..wwwwwwwwwwww..</row>
              <row>.GGGGGGGGGGGGGG.</row>
              <row>.GgggGGGGGgggGG.</row>
              <row>.GGGGGGGGGGGGGG.</row>
              <row>..GGgggGGgggGG..</row>
              <row>...GGGGGGGGGG...</row>
              <row>.....GGGGGG.....</row>
            </bitmap>
          </sprite>
          <sprite name="fb">
            <bitmap style="creeper">
              <row>................</row>
              <row>....o..o..o..o..</row>
              <row>..o..o..o..o....</row>
              <row>..wwwwwwwwwwww..</row>
              <row>.GGGGGGGGGGGGGG.</row>
              <row>.GgggGGGGGgggGG.</row>
              <row>.GGGGGGGGGGGGGG.</row>
              <row>..GGgggGGgggGG..</row>
              <row>...GGGGGGGGGG...</row>
              <row>.....GGGGGG.....</row>
            </bitmap>
          </sprite>
          <animation name="walking">
            <interval>0.2</interval>
            <frame sprite="wa" />
            <frame sprite="wb" />
          </animation>
          <animation name="flipped">
            <interval>0.15</interval>
            <frame sprite="fa" />
            <frame sprite="fb" />
          </animation>
          <position><x>2</x><y>top - 10</y></position>
          <velocity><x>crawl</x></velocity>
          <acceleration><x>0</x><y>pull</y></acceleration>
          <mass>1</mass>
          <mirror>left</mirror>
          <active>false</active>
          <collisions>
            <collision edge="horizontal">
              <wrap />
            </collision>
            <collision class="floor">
              <land />
            </collision>
            <!-- on the ground and deep in a pipe at either side: back out of
                 its pipe at the top -->
            <collision object="ground">
              <any>
                <condition variable="x"><atmost>2</atmost></condition>
                <condition variable="x"><atleast>window.right - 18</atleast></condition>
              </any>
              <reset />
            </collision>
            <!-- on its back it slides on with the hop that turned it over
                 (off a ledge, bumped near one), and lies still once down -->
            <collision class="floor" sprite="flipped">
              <condition variable="down"><atleast>1</atleast></condition>
              <set variable="self.velocity.x">0</set>
            </collision>
            <!-- two on their feet that meet turn round -->
            <collision class="enemy" side="horizontal" sprite="walking">
              <bounce />
            </collision>
            <!-- bumped from below through a floor, a little hop: on its feet
                 it goes over, on its back it gets up -->
            <collision object="mario" through="floor" sprite="walking">
              <become sprite="flipped" />
              <set variable="self.velocity.y">0 - hop</set>
              <play sound="flip" />
            </collision>
            <collision object="mario" through="floor" sprite="flipped">
              <condition variable="down"><atleast>1</atleast></condition>
              <trigger action="getup" />
              <set variable="self.velocity.y">0 - hop</set>
            </collision>
            <!-- touched by Mario himself, from any side: kicked off on its
                 back, deadly on its feet unless he is blinking -->
            <collision object="mario" sprite="flipped">
              <trigger action="kicked" />
            </collision>
            <collision object="mario" sprite="walking">
              <condition object="mario" variable="blink"><atmost>0</atmost></condition>
              <trigger object="mario" action="lose" />
            </collision>
          </collisions>
          <actions>
            <action name="getup">
              <become sprite="walking" />
              <set variable="self.velocity.x">self.way * self.speed</set>
              <set variable="self.down">0</set>
            </action>
            <!-- the POW: one standing on a floor hops, and on its feet goes
                 over; one in the air cannot leap, and is left alone -->
            <action name="powed">
              <leap>10</leap>
              <become sprite="flipped" from="walking" />
            </action>
            <action name="kicked">
              <inc variable="mario.score">800</inc>
              <inc variable="mario.kicked" />
              <play sound="kick" />
              <die />
            </action>
          </actions>
          <variables>
            <variable name="speed">crawl</variable>
            <variable name="way">1</variable>
            <variable name="down">0</variable>
          </variables>
          <timers>
            <!-- let out of its pipe on its feet, whatever a POW did while it
                 waited -->
            <timer>
              <after>0</after>
              <become sprite="walking" />
            </timer>
            <!-- over on its back (bumped, or the POW): it keeps its way, and
                 once down lies still (the rule for a floor) -->
            <timer sprite="flipped">
              <after>0</after>
              <set variable="self.way">sgn(self.velocity.x)</set>
              <set variable="self.down">1</set>
            </timer>
            <!-- left there, it gets up by itself, faster and red -->
            <timer sprite="flipped">
              <after>8</after>
              <inc variable="self.speed">crawl / 2</inc>
              <trigger action="getup" />
              <become style="angry" />
            </timer>
          </timers>
          <member />
          <member>
            <position><x>window.right - 18</x></position>
            <velocity><x>0 - crawl</x></velocity>
          </member>
          <member />
          <member>
            <position><x>window.right - 18</x></position>
            <velocity><x>0 - crawl</x></velocity>
          </member>
          <member />
          <member>
            <position><x>window.right - 18</x></position>
            <velocity><x>0 - crawl</x></velocity>
          </member>
        </group>
        <!-- the pipes, drawn over the shellcreepers: two at the top they come
             out of, two at the bottom they go into -->
        <group name="pipes">
          <sprite>
            <bitmap>
              <row>..................gggggg</row>
              <row>..................gGGGGg</row>
              <row>..................gGGGGg</row>
              <row>gggggggggggggggggggGGGGg</row>
              <row>GGGGGGGGGGGGGGGGGggGGGGg</row>
              <row>gggggggggggggggggggGGGGg</row>
              <row>GGGGGGGGGGGGGGGGGggGGGGg</row>
              <row>GGGGGGGGGGGGGGGGGggGGGGg</row>
              <row>GGGGGGGGGGGGGGGGGggGGGGg</row>
              <row>GGGGGGGGGGGGGGGGGggGGGGg</row>
              <row>GGGGGGGGGGGGGGGGGggGGGGg</row>
              <row>GGGGGGGGGGGGGGGGGggGGGGg</row>
              <row>gggggggggggggggggggGGGGg</row>
              <row>..................gGGGGg</row>
              <row>..................gGGGGg</row>
              <row>..................gggggg</row>
              <color char="g">color.green</color>
              <color char="G">color.darkgreen</color>
            </bitmap>
          </sprite>
          <group name="spouts">
            <position><y>top - 16</y></position>
            <member><position><x>0</x></position></member>
            <member>
              <sprite><bitmap><flip>horizontal</flip></bitmap></sprite>
              <position><x>window.right - 24</x></position>
            </member>
          </group>
          <group name="drains">
            <position><y>ground - 16</y></position>
            <member><position><x>0</x></position></member>
            <member>
              <sprite><bitmap><flip>horizontal</flip></bitmap></sprite>
              <position><x>window.right - 24</x></position>
            </member>
          </group>
        </group>
        <!-- Mario: a look for each way he moves, all facing right -->
        <object name="mario">
          <sprite name="stand">
            <bitmap style="mario">
              <row>...rrrrr....</row>
              <row>..rrrrrrrrr.</row>
              <row>..kkksskk...</row>
              <row>.ksksssskss.</row>
              <row>.kskksssksss</row>
              <row>.kksssskkkk.</row>
              <row>...ssssss...</row>
              <row>..rrbrrr....</row>
              <row>.rrrbrrbrrr.</row>
              <row>rrrrbbbbrrrr</row>
              <row>ssrbybbybrss</row>
              <row>sssbbbbbbsss</row>
              <row>ssbbbbbbbbss</row>
              <row>..bbb..bbb..</row>
