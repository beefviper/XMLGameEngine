          </sprite>
          <sprite name="stepb">
            <bitmap style="mario">
              <row>...rrrrr....</row>
              <row>..rrrrrrrrr.</row>
              <row>..kkksskk...</row>
              <row>.ksksssskss.</row>
              <row>.kskksssksss</row>
