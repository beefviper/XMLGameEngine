              <row>.ksksssskss.</row>
              <row>.kskksssksss</row>
              <row>.kksssskkkk.</row>
              <row>...ssssss...</row>
              <row>..rrbrrr....</row>
              <row>.rrrbrrbrr..</row>
              <row>rrrrbbbbrs..</row>
              <row>ssrbybbybs..</row>
              <row>ssbbbbbbbb..</row>
              <row>..bbbbbbbbk.</row>
              <row>..bbb..kkkk.</row>
              <row>.kkkk..kkk..</row>
              <row>.kkk........</row>
            </bitmap>
          </sprite>
          <sprite name="skid">
            <bitmap style="mario">
              <row>...rrrrr....</row>
              <row>..rrrrrrrrr.</row>
              <row>..kkksskk...</row>
              <row>.ksksssskss.</row>
              <row>.kskksssksss</row>
              <row>.kksssskkkk.</row>
              <row>...ssssss...</row>
              <row>...rrbrrr...</row>
              <row>..rrrbbrrrr.</row>
              <row>..rrbbbbrrss</row>
              <row>...bybbybsss</row>
              <row>..bbbbbbbbss</row>
              <row>.bbbbbbbbb..</row>
              <row>kbbbb..bbb..</row>
              <row>kkk....kkkk.</row>
              <row>kk.....kkkkk</row>
            </bitmap>
          </sprite>
          <sprite name="rising">
            <bitmap style="mario">
              <row>...rrrrr..s.</row>
              <row>..rrrrrrrrs.</row>
              <row>..kkksskk.r.</row>
              <row>.ksksssskrr.</row>
              <row>.kskksssksss</row>
              <row>.kksssskkkk.</row>
              <row>...ssssssr..</row>
              <row>..rrbrrrr...</row>
              <row>.rrrbbrr....</row>
              <row>rrrrbbbb....</row>
              <row>ssrbybbyb...</row>
              <row>sssbbbbbbb..</row>
              <row>ssbbbbbbbbk.</row>
              <row>..bbbb.bbkk.</row>
              <row>.kkk....kkk.</row>
              <row>kkk.........</row>
            </bitmap>
          </sprite>
          <sprite name="falling">
            <bitmap style="mario">
              <row>...rrrrr....</row>
              <row>..rrrrrrrrr.</row>
              <row>..kkksskk...</row>
              <row>.ksksssskss.</row>
              <row>.kskksssksss</row>
              <row>.kksssskkkk.</row>
              <row>...ssssss...</row>
              <row>s.rrbrrr..s.</row>
              <row>srrrbrrbrrs.</row>
              <row>.rrrbbbbrr..</row>
              <row>..rbybbybr..</row>
              <row>..bbbbbbbb..</row>
              <row>.bbbbbbbbbb.</row>
              <row>.bbb....bbb.</row>
              <row>kkk......kkk</row>
              <row>kk........kk</row>
            </bitmap>
          </sprite>
          <animation name="walking">
            <interval>0.08</interval>
            <frame sprite="stepa" />
            <frame sprite="stepb" />
            <frame sprite="stepc" />
            <frame sprite="stepb" />
          </animation>
          <position><x><centered /></x><y>ground - mario.height</y></position>
          <acceleration><x>0</x><y>pull</y></acceleration>
          <facing>right</facing>
          <poses>
            <standing sprite="stand" />
            <walking sprite="walking" />
            <skidding sprite="skid" />
            <rising sprite="rising" />
            <falling sprite="falling" />
          </poses>
          <mirror>left</mirror>
          <grip>0.15</grip>
          <collisions>
            <collision edge="horizontal">
              <wrap />
            </collision>
            <collision class="floor">
              <land />
            </collision>
            <collision class="pow">
              <land />
            </collision>
            <!-- his head against a floor from below: the bump goes through it -->
            <collision class="floor" side="top">
              <knock>0</knock>
              <bounce />
              <play sound="bump" />
            </collision>
            <collision class="pow" side="top">
              <bounce />
            </collision>
          </collisions>
          <actions>
            <action name="left">
              <move direction="left">walk</move>
            </action>
            <action name="right">
              <move direction="right">walk</move>
            </action>
            <action name="jump">
              <leap>leapheight</leap>
              <play sound="jump" />
            </action>
            <action name="lose">
              <dec variable="mario.lives" />
              <play sound="hit" />
              <reset />
              <set variable="mario.blink">2</set>
            </action>
          </actions>
          <variables>
            <variable name="score">0</variable>
            <variable name="lives">3</variable>
            <variable name="kicked">0</variable>
          </variables>
        </object>
        <object name="score">
          <sprite>
            <text style="text">
              <content>I</content>
              <number>mario.score</number>
            </text>
          </sprite>
          <position><x>8</x><y>4</y></position>
        </object>
        <object name="lives">
          <sprite>
            <text style="text">
              <content>M x</content>
              <number>mario.lives</number>
              <color>color.red</color>
            </text>
          </sprite>
          <position><x>window.right - lives.width - 8</x><y>4</y></position>
        </object>
      </objects>
      <shows>
        <show object="best" />
      </shows>
      <inputs>
        <input button="a left"><trigger object="mario" action="left" /></input>
        <input button="d right"><trigger object="mario" action="right" /></input>
        <input button="space"><trigger object="mario" action="jump" /></input>
        <input button="p escape"><push state="paused" /></input>
      </inputs>
      <conditions>
        <condition object="mario" variable="kicked">
          <atleast>6</atleast>
          <push state="youwin" />
        </condition>
        <condition object="mario" variable="lives">
          <atmost>0</atmost>
          <push state="gameover" />
        </condition>
        <condition object="mario" variable="score">
          <above>best.score</above>
          <copy variable="mario.score" into="best.score" />
        </condition>
      </conditions>
      <!-- the shellcreepers come out of the top pipes one after another -->
      <timers>
        <timer><after>1</after><reveal object="creepers.1" /></timer>
        <timer><after>3</after><reveal object="creepers.2" /></timer>
        <timer><after>7</after><reveal object="creepers.3" /></timer>
        <timer><after>9</after><reveal object="creepers.4" /></timer>
        <timer><after>13</after><reveal object="creepers.5" /></timer>
        <timer><after>15</after><reveal object="creepers.6" /></timer>
      </timers>
    </state>
    <state name="paused">
      <objects>
        <object name="paused">
          <sprite>
            <text style="banner">
              <content>PAUSED</content>
              <color>color.white</color>
            </text>
          </sprite>
          <position><x><centered /></x><y><centered /></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input button="space p escape"><pop /></input>
      </inputs>
    </state>
    <state name="youwin">
      <objects>
        <object name="message">
          <sprite>
            <text style="banner">
              <content>YOU WIN</content>
              <color>color.green</color>
            </text>
          </sprite>
          <position><x><centered /></x><y><centered>window.height.center - 20</centered></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
        <show object="again" />
      </shows>
      <inputs>
        <input button="space">
          <reset />
        </input>
      </inputs>
    </state>
    <state name="gameover" from="youwin">
      <objects>
        <object name="message">
          <sprite>
            <text style="banner">
              <content>GAME OVER</content>
            </text>
          </sprite>
        </object>
      </objects>
    </state>
  </states>
</game>
