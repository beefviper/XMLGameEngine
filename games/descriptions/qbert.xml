              <row>.....pp.........</row>
              <row>.....pp...pp....</row>
              <row>......pppppp....</row>
              <row>.......pppp.....</row>
              <row>................</row>
              <row>....pppppppp....</row>
              <row>...pppppppppp...</row>
            </bitmap>
          </sprite>
          <!-- first the egg, which it starts as, squashing as it lands -->
          <animation name="egg">
            <interval>0.35</interval>
            <frame sprite="round" />
            <frame sprite="squashed" />
          </animation>
          <animation name="snake">
            <interval>0.25</interval>
            <frame sprite="coiled" />
            <frame sprite="raised" />
          </animation>
          <position><x>104</x><y>54</y></position>
          <mirror>right</mirror>
          <collisions>
            <hitbox>
              <rectangle><width>8</width><height>4</height></rectangle>
              <position><x>4</x><y>20</y></position>
            </hitbox>
            <collision class="bottom" sprite="egg">
              <become sprite="snake" />
              <set variable="coily.snake">1</set>
            </collision>
            <collision class="void">
              <reset />
            </collision>
          </collisions>
          <actions>
            <action name="left">
              <hop direction="down-left"><x>across</x><y>down</y><seconds>bounce</seconds><arc>height</arc></hop>
              <play sound="thud" />
            </action>
            <action name="right">
              <hop direction="down-right"><x>across</x><y>down</y><seconds>bounce</seconds><arc>height</arc></hop>
              <play sound="thud" />
            </action>
          </actions>
          <variables>
            <variable name="snake">0</variable>
          </variables>
          <timers>
            <timer sprite="egg">
              <every><random><min>0.8</min><max>1.6</max></random></every>
              <trigger action="left" />
            </timer>
            <timer sprite="egg">
              <every><random><min>0.8</min><max>1.6</max></random></every>
              <trigger action="right" />
            </timer>
            <timer sprite="snake">
              <every>1</every>
              <hunt object="qbert">
                <hop><x>across</x><y>down</y><seconds>bounce</seconds><arc>height</arc></hop>
              </hunt>
            </timer>
          </timers>
        </object>
      </objects>
      <shows>
        <show object="best" />
      </shows>
      <inputs>
        <input button="w up"><trigger object="qbert" action="upright" /></input>
        <input button="d right"><trigger object="qbert" action="downright" /></input>
        <input button="s down"><trigger object="qbert" action="downleft" /></input>
        <input button="a left"><trigger object="qbert" action="upleft" /></input>
        <input button="space p escape"><push state="paused" /></input>
      </inputs>
      <conditions>
        <condition object="player" variable="cubes">
          <atleast>28</atleast>
          <play sound="done" />
          <push state="won" />
        </condition>
        <condition object="player" variable="lives">
          <atmost>0</atmost>
          <push state="lost" />
        </condition>
        <condition object="player" variable="score">
          <above>best.score</above>
          <copy variable="player.score" into="best.score" />
        </condition>
      </conditions>
    </state>
    <state name="paused">
      <objects>
        <object name="paused">
          <sprite>
            <text style="banner">
              <content>PAUSED</content>
              <color>color.white</color>
            </text>
          </sprite>
          <position><x><centered /></x><y><centered /></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input button="space p escape"><pop /></input>
      </inputs>
    </state>
    <state name="won">
      <objects>
        <object name="message">
          <sprite>
            <text style="banner">
              <content>PYRAMID DONE</content>
              <size>32</size>
            </text>
          </sprite>
          <position><x><centered /></x><y><centered>window.height.center - 20</centered></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
        <show object="again" />
      </shows>
      <inputs>
        <input button="space">
          <reset />
        </input>
      </inputs>
    </state>
    <state name="lost" from="won">
      <objects>
        <object name="message">
          <sprite>
            <text style="banner">
              <content>GAME OVER</content>
              <color>color.red</color>
            </text>
          </sprite>
        </object>
      </objects>
    </state>
  </states>
</game>
