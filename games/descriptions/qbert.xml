          </sprite>
          <sprite name="coiled">
            <bitmap style="coily">
              <row>................</row>
              <row>................</row>
              <row>....pppppp......</row>
              <row>...pwwppwwp.....</row>
              <row>...pwkppwkp.....</row>
              <row>...pppppppp.....</row>
              <row>....pprrpp......</row>
              <row>.....pppp.......</row>
              <row>.....pp.........</row>
              <row>....pp..........</row>
              <row>....pp..........</row>
              <row>.....pp.........</row>
              <row>......pp........</row>
              <row>.......pp.......</row>
              <row>........pp......</row>
              <row>........pp......</row>
              <row>.......pp.......</row>
              <row>......pp........</row>
              <row>.....pp...pp....</row>
              <row>......pppppp....</row>
              <row>.......pppp.....</row>
              <row>................</row>
              <row>....pppppppp....</row>
              <row>...pppppppppp...</row>
            </bitmap>
          </sprite>
          <sprite name="raised">
            <bitmap style="coily">
              <row>....pppppp......</row>
              <row>...pwwppwwp.....</row>
              <row>...pwkppwkp.....</row>
              <row>...pppppppp.....</row>
              <row>....pprrpp......</row>
              <row>.....pppp.......</row>
              <row>......pp........</row>
              <row>.....pp.........</row>
              <row>....pp..........</row>
              <row>....pp..........</row>
              <row>.....pp.........</row>
              <row>......pp........</row>
              <row>.......pp.......</row>
              <row>........pp......</row>
