              <row>................</row>
              <row>.....pppppp.....</row>
              <row>....pwwppppp....</row>
              <row>...pwwppppppp...</row>
              <row>...pwppppppppp..</row>
              <row>..pppppppppppp..</row>
              <row>..pppppppppppp..</row>
              <row>..pppppppppppp..</row>
              <row>...pppppppppp...</row>
              <row>...pppppppppp...</row>
              <row>....pppppppp....</row>
              <row>.....pppppp.....</row>
              <row>................</row>
            </bitmap>
          </sprite>
          <sprite name="squashed">
            <bitmap style="coily">
              <row>................</row>
