<!-- qbert.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Oct 17, 2026 -->

<!--
  After Q*bert, as on the Atari 2600: a pyramid of 21 cubes, and Q*bert
  hopping from cube to cube on the diagonals. Every cube he lands on turns
  from blue to yellow; turn them all to win. Hop off the pyramid, or meet the
  red ball bouncing down it, and a life is lost.

  W or Up hops up and right, D or Right down and right, S or Down down and
  left, A or Left up and left (the four diagonals, as the arcade's stick
  was turned). P or Escape pauses, Space starts, pauses and plays again.

  It is the game diagonal hops were made for:
  * Each key is a <hop direction="down-right"> with an <x> across and a <y>
    down: half a cube across and a whole row down, so the cubes of one row
    sit between those of the next. Each hop also turns Q*bert to face it
    (four looks of one bitmap, two of them flipped).
  * The pyramid is a <map>, drawn as it stands, on tiles half a cube across.
    A cube is one bitmap of three inks, a top and two sides, so it looks
    solid; with pixel collisions only the faces touch, so Q*bert on a top
    touches no other cube. A cube shows its look "lit" once Q*bert has
    landed on it (a rule only for the unlit look, so it scores once).
  * Around the pyramid is the void: unseen tiles where a hop off the
    pyramid lands, which cost a life and put Q*bert back on top.
  * The red ball hops down on its own, a <trigger> from its own <timer>s
    with <random> waits, and back to the top once it falls off.
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../xge/xgedef.xsd">
  <window name="Q*bert">
    <width>800</width>
    <height>600</height>
    <background>color.black</background>
    <fullscreen>false</fullscreen>
    <framerate>60</framerate>
  </window>
  <variables>
    <variable name="across">32</variable>
    <variable name="down">48</variable>
    <variable name="goal">21 * 25</variable>
  </variables>
  <sounds>
    <sound name="hop" wave="square">
      <volume>0.2</volume>
      <note pitch="A4" to="E5">0.06</note>
    </sound>
    <sound name="fall" wave="triangle">
      <volume>0.4</volume>
      <note pitch="C6" to="C3">0.5</note>
    </sound>
    <sound name="hit" wave="noise">
      <volume>0.3</volume>
      <note pitch="200">0.3</note>
    </sound>
  </sounds>
  <styles>
    <style name="banner"><size>110</size><color>color.orange</color></style>
    <style name="prompt"><size>40</size></style>
    <style name="help"><size>28</size></style>
    <style name="hud"><size>32</size><color>color.white</color></style>
  </styles>
  <objects>
    <object name="again">
      <sprite>
        <text style="prompt">
          <content>spacebar to play again</content>
        </text>
      </sprite>
      <position><x><centered /></x><y><centered>window.height.center + 70</centered></y></position>
    </object>
  </objects>
  <states>
    <state name="mainmenu">
      <objects>
        <object name="title">
          <sprite>
            <text style="banner">
              <content>Q*BERT</content>
            </text>
          </sprite>
          <position><x><centered /></x><y><centered>window.height.center - 140</centered></y></position>
        </object>
        <object name="help">
          <sprite>
            <text style="help">
              <content>hop on every cube to turn it yellow</content>
            </text>
          </sprite>
          <position><x><centered /></x><y><centered>window.height.center - 40</centered></y></position>
        </object>
        <object name="keys">
          <sprite>
            <text style="help">
              <content>w d s a or the arrows hop up right, down right, down left, up left</content>
              <color>color.lightgrey</color>
            </text>
          </sprite>
          <position><x><centered /></x><y><centered>window.height.center + 10</centered></y></position>
        </object>
        <object name="start">
          <sprite>
            <text style="prompt">
              <content>spacebar to start</content>
            </text>
          </sprite>
          <position><x><centered /></x><y><centered>window.height.center + 110</centered></y></position>
        </object>
      </objects>
      <inputs>
        <input button="space">
          <push state="playing" />
        </input>
      </inputs>
    </state>
    <state name="playing">
      <objects>
        <object name="score">
          <sprite>
            <text style="hud">
              <number>player.score</number>
            </text>
          </sprite>
          <position><x>40</x><y>12</y></position>
        </object>
        <object name="lives">
          <sprite>
            <text style="hud">
              <content>lives</content>
              <number>player.lives</number>
            </text>
          </sprite>
          <position><x>window.right - lives.width - 40</x><y>12</y></position>
        </object>
        <object name="player">
          <variables>
            <variable name="score">0</variable>
            <variable name="lives">3</variable>
          </variables>
        </object>
        <!-- the pyramid, drawn as it stands: a tile is half a cube across and a row
             down, so a cube (#) stands between the two below it; the void (o) is
             every tile a hop off the pyramid lands on -->
        <map name="pyramid">
          <tile><width>across</width><height>down</height></tile>
          <position><x>160</x><y>74</y></position>
          <row>......o.o......</row>
          <row>.....o.#.o.....</row>
          <row>....o.#.#.o....</row>
          <row>...o.#.#.#.o...</row>
          <row>..o.#.#.#.#.o..</row>
          <row>.o.#.#.#.#.#.o.</row>
          <row>..#.#.#.#.#.#..</row>
          <row>.o.o.o.o.o.o.o.</row>
          <!-- a cube is three faces of one bitmap; its middle is the tile's, so its
               top face is centred 16 above it, where Q*bert and the ball stand.
               Pixel collisions, so only the faces count, not the corners of the box -->
          <group name="cubes" char="#" class="cube">
            <sprite name="unlit">
              <bitmap>
                <row>.......**.......</row>
                <row>.....******.....</row>
                <row>...**********...</row>
                <row>.**************.</row>
                <row>l**************r</row>
                <row>lll**********rrr</row>
                <row>lllll******rrrrr</row>
                <row>lllllll**rrrrrrr</row>
                <row>llllllllrrrrrrrr</row>
                <row>llllllllrrrrrrrr</row>
                <row>llllllllrrrrrrrr</row>
                <row>llllllllrrrrrrrr</row>
                <row>.lllllllrrrrrrr.</row>
                <row>...lllllrrrrr...</row>
                <row>.....lllrrr.....</row>
                <row>.......lr.......</row>
                <scale>4</scale>
                <color>color.blue</color>
                <color char="l">color.brown</color>
                <color char="r">color.darkgrey</color>
              </bitmap>
            </sprite>
            <sprite name="lit">
              <bitmap>
                <row>.......**.......</row>
                <row>.....******.....</row>
                <row>...**********...</row>
                <row>.**************.</row>
                <row>l**************r</row>
                <row>lll**********rrr</row>
                <row>lllll******rrrrr</row>
                <row>lllllll**rrrrrrr</row>
                <row>llllllllrrrrrrrr</row>
                <row>llllllllrrrrrrrr</row>
                <row>llllllllrrrrrrrr</row>
                <row>llllllllrrrrrrrr</row>
                <row>.lllllllrrrrrrr.</row>
                <row>...lllllrrrrr...</row>
                <row>.....lllrrr.....</row>
                <row>.......lr.......</row>
                <scale>4</scale>
                <color>color.yellow</color>
                <color char="l">color.brown</color>
                <color char="r">color.darkgrey</color>
              </bitmap>
            </sprite>
            <collisions>
              <enabled>true</enabled>
              <type>pixel</type>
              <collision object="qbert" sprite="unlit">
                <become sprite="lit" />
                <inc variable="player.score">25</inc>
              </collision>
            </collisions>
          </group>
          <!-- tall and thin, to reach from the tile's middle up to where a hop lands
               without touching anything standing on the cubes beside it -->
          <group name="void" char="o" class="void">
            <sprite>
              <rectangle>
                <width>24</width>
                <height>56</height>
              </rectangle>
            </sprite>
            <drawn>false</drawn>
            <collisions>
              <enabled>true</enabled>
            </collisions>
          </group>
        </map>
        <object name="qbert">
          <sprite name="downright">
            <bitmap>
              <row>..****..</row>
              <row>.******.</row>
              <row>.*wk*wk.</row>
              <row>.*wk*wk*</row>
              <row>.*******</row>
              <row>..****.*</row>
              <row>...*.*..</row>
              <row>..**.**.</row>
              <scale>2</scale>
              <color>color.orange</color>
              <color char="w">color.white</color>
              <color char="k">color.black</color>
            </bitmap>
          </sprite>
          <sprite name="downleft">
            <bitmap>
              <row>..****..</row>
              <row>.******.</row>
              <row>.*wk*wk.</row>
              <row>.*wk*wk*</row>
              <row>.*******</row>
              <row>..****.*</row>
              <row>...*.*..</row>
              <row>..**.**.</row>
              <scale>2</scale>
              <color>color.orange</color>
              <color char="w">color.white</color>
              <color char="k">color.black</color>
              <flip>horizontal</flip>
            </bitmap>
          </sprite>
          <sprite name="upright">
            <bitmap>
              <row>......**</row>
              <row>..*****.</row>
              <row>.******.</row>
              <row>.******.</row>
              <row>.******.</row>
              <row>..****..</row>
              <row>...*.*..</row>
              <row>..**.**.</row>
              <scale>2</scale>
              <color>color.orange</color>
              <color char="w">color.white</color>
              <color char="k">color.black</color>
            </bitmap>
          </sprite>
          <sprite name="upleft">
            <bitmap>
              <row>......**</row>
              <row>..*****.</row>
              <row>.******.</row>
              <row>.******.</row>
              <row>.******.</row>
              <row>..****..</row>
              <row>...*.*..</row>
              <row>..**.**.</row>
              <scale>2</scale>
              <color>color.orange</color>
              <color char="w">color.white</color>
              <color char="k">color.black</color>
              <flip>horizontal</flip>
            </bitmap>
          </sprite>
          <position><x>392</x><y>122</y></position>
          <collisions>
            <enabled>true</enabled>
            <collision class="void">
              <dec variable="player.lives" />
              <play sound="fall" />
              <reset />
            </collision>
            <collision object="ball">
              <dec variable="player.lives" />
              <play sound="hit" />
              <reset />
            </collision>
          </collisions>
          <actions>
            <action name="upright">
              <hop direction="up-right"><x>across</x><y>down</y></hop>
              <become sprite="upright" />
              <play sound="hop" />
            </action>
            <action name="downright">
              <hop direction="down-right"><x>across</x><y>down</y></hop>
              <become sprite="downright" />
              <play sound="hop" />
            </action>
            <action name="downleft">
              <hop direction="down-left"><x>across</x><y>down</y></hop>
              <become sprite="downleft" />
              <play sound="hop" />
            </action>
            <action name="upleft">
              <hop direction="up-left"><x>across</x><y>down</y></hop>
              <become sprite="upleft" />
              <play sound="hop" />
            </action>
          </actions>
        </object>
        <!-- the red ball: down the pyramid one way or the other, and off it -->
        <object name="ball">
          <sprite>
            <bitmap>
              <row>..****..</row>
              <row>.*ww***.</row>
              <row>**w*****</row>
              <row>********</row>
              <row>********</row>
              <row>********</row>
              <row>.******.</row>
              <row>..****..</row>
              <scale>2</scale>
              <color>color.red</color>
              <color char="w">color.white</color>
            </bitmap>
          </sprite>
          <position><x>424</x><y>170</y></position>
          <collisions>
            <enabled>true</enabled>
            <collision class="void">
              <reset />
            </collision>
            <collision object="qbert">
              <reset />
            </collision>
          </collisions>
          <actions>
            <action name="left">
              <hop direction="down-left"><x>across</x><y>down</y></hop>
            </action>
            <action name="right">
              <hop direction="down-right"><x>across</x><y>down</y></hop>
            </action>
          </actions>
          <timers>
            <timer>
              <every><random min="0.6" max="1.4" /></every>
              <trigger object="ball" action="left" />
            </timer>
            <timer>
              <every><random min="0.6" max="1.4" /></every>
              <trigger object="ball" action="right" />
            </timer>
          </timers>
        </object>
      </objects>
      <inputs>
        <input button="w"><trigger object="qbert" action="upright" /></input>
        <input button="up"><trigger object="qbert" action="upright" /></input>
        <input button="d"><trigger object="qbert" action="downright" /></input>
        <input button="right"><trigger object="qbert" action="downright" /></input>
        <input button="s"><trigger object="qbert" action="downleft" /></input>
        <input button="down"><trigger object="qbert" action="downleft" /></input>
        <input button="a"><trigger object="qbert" action="upleft" /></input>
        <input button="left"><trigger object="qbert" action="upleft" /></input>
        <input button="space"><push state="paused" /></input>
        <input button="p"><push state="paused" /></input>
        <input button="escape"><push state="paused" /></input>
      </inputs>
      <conditions>
        <condition object="player" variable="score">
          <atleast>goal</atleast>
          <push state="won" />
        </condition>
        <condition object="player" variable="lives">
          <atmost>0</atmost>
          <push state="lost" />
        </condition>
      </conditions>
    </state>
    <state name="paused">
      <objects>
        <object name="paused">
          <sprite>
            <text style="banner">
              <content>PAUSED</content>
              <color>color.white</color>
            </text>
          </sprite>
          <position><x><centered /></x><y><centered /></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input button="space"><pop /></input>
        <input button="p"><pop /></input>
        <input button="escape"><pop /></input>
      </inputs>
    </state>
    <state name="won">
      <objects>
        <object name="message">
          <sprite>
            <text style="banner">
              <content>PYRAMID DONE</content>
              <size>80</size>
            </text>
          </sprite>
          <position><x><centered /></x><y><centered>window.height.center - 60</centered></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
        <show object="again" />
      </shows>
      <inputs>
        <input button="space">
          <reset />
        </input>
      </inputs>
    </state>
    <state name="lost" from="won">
      <objects>
        <object name="message">
          <sprite>
            <text style="banner">
              <content>GAME OVER</content>
              <color>color.red</color>
            </text>
          </sprite>
        </object>
      </objects>
    </state>
  </states>
</game>
