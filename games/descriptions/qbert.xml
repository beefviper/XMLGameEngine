<!-- qbert.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Oct 17, 2026 -->

<!--
  Q*bert, after the 1982 arcade game: a pyramid of 28 cubes, and Q*bert
  hopping from cube to cube on the diagonals, on the arcade's own small
  screen (256 by 240) shown three times as big. Every cube he lands on
  turns from blue to yellow, for 25 points; turn them all to win. Hop off
  the pyramid, or meet the red ball or Coily, and he curses and a life is
  lost. A flying disc on each side carries him back to the top, once;
  Coily, if he is chasing him by then, leaps after him and falls, for 500
  points. The high score is kept.

  W or Up hops up and right, D or Right down and right, S or Down down and
  left, A or Left up and left (the four diagonals, as the arcade's stick
  was turned). Space starts, pauses and plays again; P or Escape pauses.

  It is the game diagonal hops were made for:
  * Each key is a <hop direction="down-right"> with an <x> across and a <y>
    down: half a cube across and a whole row down, so the cubes of one row
    sit between those of the next. A hop takes its <seconds>, through the
    air, and lands; its <arc> lifts him up off the straight line and drops
    him onto the cube, as the arcade's hop does. The ball and Coily hop
    the same way.
  * Q*bert has two looks, facing down and facing up, both drawn turned to
    the right; his <mirror>left</mirror> draws them the other way round
    when he hops to the left. Coily's pictures face left, so his mirror is
    right.
  * The pyramid is a <map>, drawn as it stands, on tiles half a cube across.
    A cube is one bitmap of three inks, a top and two sides, so it looks
    solid; its pixels touch, and of them only the top's (<solid char>).
    Q*bert touches with his feet alone (a <hitbox>), so he stands on a top
    and touches nothing else. A cube shows its look "lit" once Q*bert has
    landed on it (a rule only for the unlit look, so it scores once).
  * Around the pyramid is the void: unseen tiles where a hop off the
    pyramid lands, which cost a life and put Q*bert back on top. Two of
    them are the discs, which spin (a look that moves, a named
    <animation>) until they have been used.
  * The red ball hops down on its own, a <trigger> from its own <timer>s
    with <random> waits, and back to the top once it falls off. Coily is an
    egg that does the same until it reaches the bottom row (a look that
    squashes and rounds again, the first of his, so the one he starts as),
    then a snake that coils and rears (another look that moves) and whose timer hunts
    Q*bert by hops (<hunt> with a <hop>): each time, the diagonal that
    lands nearest him.
  No Slick and Sam, Ugg and Wrongway or green ball, and one round: see
  docs/designs/56-games-atari.md.
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../xgedef.xsd">
  <window name="Q*bert">
    <width>256</width>
    <height>240</height>
    <scale>3</scale>
  </window>
  <variables>
    <variable name="across">16</variable>
    <variable name="down">24</variable>
    <variable name="flight">0.3</variable>
    <variable name="bounce">0.35</variable>
    <variable name="height">10</variable>
  </variables>
  <sounds>
    <sound name="hop" wave="square">
      <volume>0.15</volume>
      <note pitch="A4" to="E5">0.06</note>
    </sound>
    <!-- the ball and the egg landing -->
    <sound name="thud" wave="triangle">
      <volume>0.2</volume>
      <note pitch="G3" to="C3">0.06</note>
    </sound>
    <sound name="fall" wave="triangle">
      <volume>0.4</volume>
      <note pitch="C6" to="C3">0.8</note>
    </sound>
    <!-- his curse: a garble of noise and squawks -->
    <sound name="curse">
      <volume>0.3</volume>
      <part wave="square">
        <note pitch="E5">0.07</note>
        <note pitch="A4">0.05</note>
        <note pitch="F5">0.08</note>
        <note pitch="C5">0.05</note>
        <note pitch="G5">0.07</note>
        <note pitch="D5">0.1</note>
      </part>
      <part wave="noise">
        <note pitch="900" to="300">0.42</note>
      </part>
    </sound>
    <sound name="disc" wave="square">
      <volume>0.2</volume>
      <note pitch="C5" to="C6">0.25</note>
      <note pitch="C5" to="C6">0.25</note>
      <note pitch="C5" to="C7">0.4</note>
    </sound>
    <sound name="done">
      <volume>0.2</volume>
      <part wave="square">
        <note pitch="C5">0.1</note>
        <note pitch="E5">0.1</note>
        <note pitch="G5">0.1</note>
        <note pitch="C6">0.1</note>
        <note pitch="E6">0.1</note>
        <note pitch="G6">0.3</note>
      </part>
    </sound>
  </sounds>
  <styles>
    <style name="banner"><size>40</size><color>color.orange</color></style>
    <style name="text"><size>16</size><color>color.white</color></style>
    <style name="coily">
      <color char="p">color.purple</color>
      <color char="w">color.white</color>
      <color char="k">color.black</color>
      <color char="r">color.red</color>
    </style>
    <style name="disc">
      <color char="c">color.cyan</color>
      <color char="m">color.magenta</color>
      <color char="y">color.yellow</color>
    </style>
  </styles>
  <objects>
    <object name="again">
      <sprite>
        <text style="text">
          <content>space to play again</content>
        </text>
      </sprite>
      <position><x><centered /></x><y><centered>window.height.center + 30</centered></y></position>
    </object>
    <!-- the best score, kept from game to game -->
    <object name="best">
      <sprite>
        <text style="text">
          <content>TOP</content>
          <number>best.score</number>
        </text>
      </sprite>
      <position><x><centered /></x><y>4</y></position>
      <variables>
        <variable name="score">0</variable>
      </variables>
    </object>
  </objects>
  <keeps>
    <keep object="best" />
  </keeps>
  <states>
    <state name="mainmenu">
      <objects>
        <object name="title">
          <sprite>
            <text style="banner">
              <content>Q*BERT</content>
            </text>
          </sprite>
          <position><x><centered /></x><y><centered>window.height.center - 56</centered></y></position>
        </object>
        <object name="help">
          <sprite>
            <text style="text">
              <content>turn every cube yellow</content>
            </text>
          </sprite>
          <position><x><centered /></x><y><centered>window.height.center - 12</centered></y></position>
        </object>
        <object name="keys">
          <sprite>
            <text style="text">
              <content>w d s a or arrows hop</content>
              <color>color.lightgrey</color>
            </text>
          </sprite>
          <position><x><centered /></x><y><centered>window.height.center + 8</centered></y></position>
        </object>
        <object name="start">
          <sprite>
            <text style="text">
              <content>space to start</content>
            </text>
          </sprite>
          <position><x><centered /></x><y><centered>window.height.center + 40</centered></y></position>
        </object>
      </objects>
      <shows>
        <show object="best" />
      </shows>
      <inputs>
        <input button="space">
          <push state="playing" />
        </input>
      </inputs>
    </state>
    <state name="playing">
      <objects>
        <object name="score">
          <sprite>
            <text style="text">
              <number>player.score</number>
            </text>
          </sprite>
          <position><x>8</x><y>4</y></position>
        </object>
        <object name="lives">
          <sprite>
            <text style="text">
              <content>lives</content>
              <number>player.lives</number>
            </text>
          </sprite>
          <position><x>window.right - lives.width - 8</x><y>4</y></position>
        </object>
        <object name="player">
          <variables>
            <variable name="score">0</variable>
            <variable name="lives">3</variable>
            <variable name="cubes">0</variable>
          </variables>
        </object>
        <!-- the pyramid, drawn as it stands: a tile is half a cube across and a row
             down, so a cube (#) stands between the two below it; the bottom row
             (=) is cubes too, where Coily hatches; the void (o) is every tile a
             hop off the pyramid lands on, and the discs (d) two of them -->
        <map name="pyramid">
          <tile><width>across</width><height>down</height></tile>
          <position><x>8</x><y>24</y></position>
          <row>......o.o......</row>
          <row>.....o.#.o.....</row>
          <row>....o.#.#.o....</row>
          <row>...o.#.#.#.o...</row>
          <row>..o.#.#.#.#.o..</row>
          <row>.d.#.#.#.#.#.d.</row>
          <row>o.#.#.#.#.#.#.o</row>
          <row>.=.=.=.=.=.=.=.</row>
          <row>o.o.o.o.o.o.o.o</row>
          <!-- a cube is three faces of one bitmap; its middle is the tile's, so its
               top face is centred 8 above it, where Q*bert and the ball stand.
               Pixel collisions, and of those only the top (*) is solid: what
               stands on a cube touches it, not the cube behind -->
          <group name="cubes" class="cube">
              <sprite name="unlit">
                <bitmap>
                  <row>.......**.......</row>
                  <row>.....******.....</row>
                  <row>...**********...</row>
                  <row>.**************.</row>
                  <row>l**************r</row>
                  <row>lll**********rrr</row>
                  <row>lllll******rrrrr</row>
                  <row>lllllll**rrrrrrr</row>
                  <row>llllllllrrrrrrrr</row>
                  <row>llllllllrrrrrrrr</row>
                  <row>llllllllrrrrrrrr</row>
                  <row>llllllllrrrrrrrr</row>
                  <row>.lllllllrrrrrrr.</row>
                  <row>...lllllrrrrr...</row>
                  <row>.....lllrrr.....</row>
                  <row>.......lr.......</row>
                  <scale>2</scale>
                  <color>color.blue</color>
                  <color char="l">color.brown</color>
                  <color char="r">color.darkgrey</color>
                </bitmap>
              </sprite>
              <sprite name="lit">
                <bitmap>
                  <row>.......**.......</row>
                  <row>.....******.....</row>
                  <row>...**********...</row>
                  <row>.**************.</row>
                  <row>l**************r</row>
                  <row>lll**********rrr</row>
                  <row>lllll******rrrrr</row>
                  <row>lllllll**rrrrrrr</row>
                  <row>llllllllrrrrrrrr</row>
                  <row>llllllllrrrrrrrr</row>
                  <row>llllllllrrrrrrrr</row>
                  <row>llllllllrrrrrrrr</row>
                  <row>.lllllllrrrrrrr.</row>
                  <row>...lllllrrrrr...</row>
                  <row>.....lllrrr.....</row>
                  <row>.......lr.......</row>
                  <scale>2</scale>
                  <color>color.yellow</color>
                  <color char="l">color.brown</color>
                  <color char="r">color.darkgrey</color>
                </bitmap>
              </sprite>
            <collisions>
              <type>pixel</type>
              <solid char="*" />
              <collision object="qbert" sprite="unlit">
                <become sprite="lit" />
                <inc variable="player.score">25</inc>
                <inc variable="player.cubes" />
              </collision>
            </collisions>
            <group name="upper" char="#" />
            <group name="bottom" char="=" class="bottom" />
          </group>
          <!-- tall and thin, to reach from the tile's middle up to where a hop lands
               without touching anything standing on the cubes beside it -->
          <group name="void" char="o" class="void">
            <sprite>
              <rectangle>
                <width>12</width>
                <height>28</height>
              </rectangle>
            </sprite>
            <drawn>false</drawn>
            <collisions />
          </group>
          <!-- a disc floats where Q*bert's feet land, in a box as tall as the
               void's, spinning until it is used; used, it is void too. Its
               rules go last look first, so a landing changes the look only once -->
          <group name="discs" char="d" class="disc">
            <sprite name="spina">
              <bitmap style="disc">
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>...cmmmmc...</row>
                <row>.cmmyyyymmc.</row>
                <row>..ccmmmmcc..</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
              </bitmap>
            </sprite>
            <sprite name="spinb">
              <bitmap style="disc">
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>...myyyym...</row>
                <row>.myyccccyym.</row>
                <row>..mmyyyymm..</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
              </bitmap>
            </sprite>
            <sprite name="spinc">
              <bitmap style="disc">
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>...yccccy...</row>
                <row>.yccmmmmccy.</row>
                <row>..yyccccyy..</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
                <row>............</row>
              </bitmap>
            </sprite>
            <sprite name="used">
              <rectangle>
                <width>12</width>
                <height>28</height>
                <color>color.black</color>
              </rectangle>
            </sprite>
            <animation name="ready">
              <interval>0.12</interval>
              <frame sprite="spina" />
              <frame sprite="spinb" />
              <frame sprite="spinc" />
            </animation>
            <collisions>
              <collision object="qbert" sprite="used">
                <play sound="fall" />
                <trigger object="qbert" action="lose" />
              </collision>
              <!-- Coily, chasing him, leaps after him -->
              <collision object="qbert" sprite="ready">
                <condition object="coily" variable="snake"><equal>1</equal></condition>
                <inc variable="player.score">500</inc>
                <reset object="coily" />
              </collision>
              <collision object="qbert" sprite="ready">
                <become sprite="used" />
                <play sound="disc" />
                <reset object="qbert" />
              </collision>
            </collisions>
          </group>
        </map>
        <!-- Q*bert: facing down or up, drawn turned to the right -->
        <object name="qbert">
          <sprite name="front">
            <bitmap>
              <row>.....oooooo.....</row>
              <row>...oooooooooo...</row>
              <row>..oowwooowwooo..</row>
              <row>..owkwoowkwooo..</row>
              <row>.oowwoooowwoooo.</row>
              <row>.oooooooooooooo.</row>
              <row>.oooooooooooooo.</row>
              <row>..oooooooooooooo</row>
              <row>..ooooooooookkoo</row>
              <row>...ooooooooko.ko</row>
              <row>....ooooooo.ooo.</row>
              <row>......o..o......</row>
              <row>.....oo..oo.....</row>
              <row>.....o...o......</row>
              <row>....kkk..kkk....</row>
              <row>...kkkk..kkkk...</row>
              <color char="o">color.orange</color>
              <color char="w">color.white</color>
              <color char="k">color.black</color>
            </bitmap>
          </sprite>
          <sprite name="back">
            <bitmap>
              <row>..........okko..</row>
              <row>.....oooooko.o..</row>
              <row>...oooooooooo...</row>
              <row>..oooooooooooo..</row>
              <row>.oooooooooooooo.</row>
              <row>.oooooooooooooo.</row>
              <row>.oooooooooooooo.</row>
              <row>.oooooooooooooo.</row>
              <row>..oooooooooooo..</row>
              <row>...oooooooooo...</row>
              <row>....oooooooo....</row>
              <row>......o..o......</row>
              <row>.....oo..oo.....</row>
              <row>.....o...o......</row>
              <row>....kkk..kkk....</row>
              <row>...kkkk..kkkk...</row>
              <color char="o">color.orange</color>
              <color char="w">color.white</color>
              <color char="k">color.black</color>
            </bitmap>
          </sprite>
          <!-- standing on a top: his feet, all he touches with, on its middle -->
          <position><x>120</x><y>38</y></position>
          <mirror>left</mirror>
          <collisions>
            <hitbox>
              <rectangle><width>8</width><height>4</height></rectangle>
              <position><x>4</x><y>12</y></position>
            </hitbox>
            <collision class="void">
              <play sound="fall" />
              <trigger action="lose" />
            </collision>
            <collision class="enemy">
              <play sound="curse" />
              <trigger action="lose" />
            </collision>
          </collisions>
          <actions>
            <action name="upright">
              <hop direction="up-right"><x>across</x><y>down</y><seconds>flight</seconds><arc>height</arc></hop>
              <become sprite="back" />
              <play sound="hop" />
            </action>
            <action name="downright">
              <hop direction="down-right"><x>across</x><y>down</y><seconds>flight</seconds><arc>height</arc></hop>
              <become sprite="front" />
              <play sound="hop" />
            </action>
            <action name="downleft">
              <hop direction="down-left"><x>across</x><y>down</y><seconds>flight</seconds><arc>height</arc></hop>
              <become sprite="front" />
              <play sound="hop" />
            </action>
            <action name="upleft">
              <hop direction="up-left"><x>across</x><y>down</y><seconds>flight</seconds><arc>height</arc></hop>
              <become sprite="back" />
              <play sound="hop" />
            </action>
            <action name="lose">
              <dec variable="player.lives" />
              <become object="curse" sprite="said" />
              <reset />
              <reset object="ball" />
              <reset object="coily" />
            </action>
          </actions>
        </object>
        <!-- what he says when caught, for a moment, over the top of the pyramid -->
        <object name="curse">
          <sprite name="quiet">
            <rectangle><width>1</width><height>1</height><color>color.black</color></rectangle>
          </sprite>
          <sprite name="said">
            <text style="text">
              <content>@!#?@!</content>
            </text>
          </sprite>
          <position><x>window.width.center + 16</x><y>20</y></position>
          <timers>
            <timer sprite="said">
              <after>1.5</after>
              <become sprite="quiet" />
            </timer>
          </timers>
        </object>
        <!-- the red ball: down the pyramid one way or the other, and off it -->
        <object name="ball" class="enemy">
          <sprite>
            <bitmap>
              <row>..****..</row>
              <row>.*ww***.</row>
              <row>**w*****</row>
              <row>********</row>
              <row>********</row>
              <row>********</row>
              <row>.******.</row>
              <row>..****..</row>
              <color>color.red</color>
              <color char="w">color.white</color>
            </bitmap>
          </sprite>
          <position><x>140</x><y>70</y></position>
          <collisions>
            <collision class="void">
              <reset />
            </collision>
            <collision object="qbert">
              <reset />
            </collision>
          </collisions>
          <actions>
            <action name="left">
              <hop direction="down-left"><x>across</x><y>down</y><seconds>bounce</seconds><arc>height</arc></hop>
              <play sound="thud" />
            </action>
            <action name="right">
              <hop direction="down-right"><x>across</x><y>down</y><seconds>bounce</seconds><arc>height</arc></hop>
              <play sound="thud" />
            </action>
          </actions>
          <timers>
            <timer>
              <every><random><min>0.6</min><max>1.4</max></random></every>
              <trigger action="left" />
            </timer>
            <timer>
              <every><random><min>0.6</min><max>1.4</max></random></every>
              <trigger action="right" />
            </timer>
          </timers>
        </object>
        <!-- Coily: an egg that bounces down as the ball does, and on the bottom
             row hatches into a snake that hunts Q*bert, a hop at a time,
             coiling and rearing as he goes -->
        <object name="coily" class="enemy">
          <sprite name="round">
            <bitmap style="coily">
              <row>................</row>
              <row>................</row>
              <row>................</row>
              <row>................</row>
              <row>................</row>
              <row>................</row>
              <row>................</row>
