<!-- galaxian.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Oct 5, 2026 -->

<!--
  Galaxian, after the 1979 arcade game, cut down to its shape: a fleet of
  aliens flies in, settles into formation, and one at a time they break away
  and dive at the ship, weaving side to side and dropping bombs, then loop
  round from the top of the screen back into their places. Shoot them all and
  the next fleet flies in; lose three ships and it is over.

  It is the first game with <paths>. A path is a list of steps (move this far
  across and this far down) flown at a speed, and <home /> flies back to the
  object's own <position>, its place in the formation. <follow path="..." />
  sets an object off along one. The fleet flies in on five paths, one per row,
  each row a line of aliens <stagger>ed one behind another. Each alien's own
  timer sends it on the dive now and then.

  How it is written:
  * The ship, its shot, the bombs and the numbers along the top are the
    playing state's own objects. The fleet, its five rows, is the one scene
    of the state, and its timer sends the rows in when the scene starts.
  * When the whole fleet is shot down, a condition of the scene <reset
    scene>s it: every alien back as it started and the scene's timer
    started over, so the next fleet flies in.
  * The dive's steps add up to no movement across and to the window's height
    plus the alien's height down, and the aliens <wrap /> at the bottom of the
    screen, which moves them up by exactly that much: so a diver that misses
    comes back in from the top and ends the dive at its own place, whichever
    row it started from.
  * Paused and game over draw the game still underneath (<show state>).
  * The best score is an object of the game's own, which the title and play
    show. While the ship's score is <above> it, a condition <copy>s the score
    into it, and <keeps> passes it over when Space starts a new game.
  * The best five are a table on the title screen: a group of five places,
    the best first, each a <text> of three <letter>s and a <number> that
    name the group's variables (table.first, table.score), so each place
    shows its own. A game that ends above the fifth asks for initials, one
    letter a state (W and S or the arrows change it, Space goes on), and
    <rank> puts the entry in its place, the ones below moving down.
  * Two players take turns, as on the arcade machine: 2 on the title starts
    a game with <turns>, a <player> each, so each has a game of their own.
    A ship lost <pass>es the turn, each player's own screen saying whose it
    is, and a player out of ships is <out />: the other plays on, and when
    both are out the game ends.
  * The best and the table are kept, and the engine writes what is kept to
    saves/galaxian.xml, so they last from one run of the program to the next.
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../xge/xgedef.xsd">
  <window name="Galaxian">
    <width>560</width>
    <height>640</height>
    <background>color.black</background>
    <fullscreen>false</fullscreen>
    <framerate>60</framerate>
  </window>
  <variables>
    <variable name="pixel">3</variable>
    <variable name="alienheight">8 * pixel</variable>
    <variable name="left">83</variable>
    <variable name="gap">40</variable>
    <variable name="row1">70</variable>
    <variable name="row2">100</variable>
    <variable name="row3">130</variable>
    <variable name="row4">160</variable>
    <variable name="row5">190</variable>
    <variable name="enterspeed">4</variable>
    <variable name="divespeed">3</variable>
    <variable name="spacing">0.15</variable>
    <variable name="step">4</variable>
    <variable name="margin">12</variable>
    <variable name="tabletop">250</variable>
    <variable name="tablerow">36</variable>
    <variable name="letters">window.width.center - 80</variable>
    <variable name="letterstep">60</variable>
    <variable name="startlives">3</variable>
  </variables>
  <sounds>
    <sound name="shoot" wave="square">
      <volume>0.15</volume>
      <note pitch="E6" to="E5">0.06</note>
    </sound>
    <sound name="hit" wave="noise">
      <volume>0.3</volume>
      <note pitch="2000" to="200">0.2</note>
    </sound>
    <sound name="dive" wave="triangle">
      <volume>0.2</volume>
      <note pitch="C6" to="C4">0.4</note>
    </sound>
    <sound name="boom" wave="noise">
      <volume>0.4</volume>
      <note pitch="3000" to="100">0.6</note>
    </sound>
  </sounds>
  <paths>
    <!-- the flagships: straight down the middle, a loop to the left, and up into place -->
    <path name="fromtop">
      <speed>enterspeed</speed>
      <start><x>window.width.center - 16</x><y>-30</y></start>
      <step><x>0</x><y>260</y></step>
      <step><x>-80</x><y>60</y></step>
      <step><x>-60</x><y>-60</y></step>
      <step><x>60</x><y>-80</y></step>
      <home />
    </path>
    <!-- the red escorts: in from the top left and round -->
    <path name="fromtopleft">
      <speed>enterspeed</speed>
      <start><x>100</x><y>-30</y></start>
      <step><x>60</x><y>200</y></step>
      <step><x>120</x><y>40</y></step>
      <step><x>40</x><y>-80</y></step>
      <home />
    </path>
    <!-- the purple aliens: the same from the top right -->
    <path name="fromtopright">
      <speed>enterspeed</speed>
      <start><x>window.right - 133</x><y>-30</y></start>
      <step><x>-60</x><y>200</y></step>
      <step><x>-120</x><y>40</y></step>
      <step><x>-40</x><y>-80</y></step>
      <home />
    </path>
    <!-- the first row of blue aliens: in low from the left and up -->
    <path name="fromleft">
      <speed>enterspeed</speed>
      <start><x>-40</x><y>330</y></start>
      <step><x>200</x><y>-20</y></step>
      <step><x>100</x><y>-100</y></step>
      <step><x>-40</x><y>-80</y></step>
      <home />
    </path>
    <!-- the second row of blue aliens: the same from the right -->
    <path name="fromright">
      <speed>enterspeed</speed>
      <start><x>window.right + 7</x><y>330</y></start>
      <step><x>-200</x><y>-20</y></step>
      <step><x>-100</x><y>-100</y></step>
      <step><x>40</x><y>-80</y></step>
      <home />
    </path>
    <!--
      The dive: a peel off up and to the left, then down, weaving side to
      side and dropping a bomb on the way, then straight down off the bottom
      of the screen. The steps add up to 0 across and to window.bottom +
      alienheight down, which is what the <wrap /> at the bottom takes off
      again, so the last <home /> only tidies up.
    -->
    <path name="dive">
      <speed>divespeed</speed>
      <step><x>-24</x><y>-24</y><play sound="dive" /></step>
      <step><x>-24</x><y>40</y></step>
      <step><x>80</x><y>120</y><fire object="bombs" /></step>
      <step><x>-80</x><y>120</y></step>
      <step><x>80</x><y>120</y><fire object="bombs" /></step>
      <step><x>-32</x><y>120</y></step>
      <step><x>0</x><y>window.bottom + alienheight - 496</y></step>
      <home />
    </path>
  </paths>
  <objects>
    <!-- the best score, at the top in the middle on the title and in play -->
    <object name="best">
      <sprite>
        <text>
          <number>best.score</number>
          <size>36</size>
          <color>color.red</color>
        </text>
      </sprite>
      <position><x>window.width.center - best.width / 2</x><y>margin</y></position>
      <variables>
        <variable name="score">0</variable>
      </variables>
    </object>
    <!-- the best five, on the title screen: three letters and a score each -->
    <group name="table">
      <sprite>
        <text>
          <letter>table.first</letter>
          <letter>table.second</letter>
          <letter>table.third</letter>
          <number>table.score</number>
          <size>28</size>
          <color>color.cyan</color>
        </text>
      </sprite>
      <position><x>window.width.center - 60</x></position>
      <variables>
        <variable name="first">0</variable>
        <variable name="second">0</variable>
        <variable name="third">0</variable>
        <variable name="score">0</variable>
      </variables>
      <member><position><y>tabletop</y></position></member>
      <member><position><y>tabletop + tablerow</y></position></member>
      <member><position><y>tabletop + tablerow * 2</y></position></member>
      <member><position><y>tabletop + tablerow * 3</y></position></member>
      <member><position><y>tabletop + tablerow * 4</y></position></member>
    </group>
    <!-- a score for the table, and the initials it is given -->
    <object name="entry">
      <sprite>
        <text>
          <content>NEW BEST</content>
          <size>60</size>
          <color>color.yellow</color>
        </text>
      </sprite>
      <position><x>window.width.center - entry.width / 2</x><y>120</y></position>
      <variables>
        <variable name="first">0</variable>
        <variable name="second">0</variable>
        <variable name="third">0</variable>
        <variable name="score">0</variable>
      </variables>
    </object>
    <object name="entryscore">
      <sprite>
        <text>
          <number>entry.score</number>
          <size>36</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position><x>window.width.center - entryscore.width / 2</x><y>210</y></position>
    </object>
    <object name="letter1">
      <sprite><text><letter>entry.first</letter><size>60</size><color>color.cyan</color></text></sprite>
      <position><x>letters</x><y>300</y></position>
    </object>
    <object name="letter2">
      <sprite><text><letter>entry.second</letter><size>60</size><color>color.cyan</color></text></sprite>
      <position><x>letters + letterstep</x><y>300</y></position>
    </object>
    <object name="letter3">
      <sprite><text><letter>entry.third</letter><size>60</size><color>color.cyan</color></text></sprite>
      <position><x>letters + letterstep * 2</x><y>300</y></position>
    </object>
    <object name="howto">
      <sprite>
        <text>
          <content>w and s, or up and down, change the letter; space for the next</content>
          <size>18</size>
          <color>color.lightgrey</color>
        </text>
      </sprite>
      <position><x>window.width.center - howto.width / 2</x><y>440</y></position>
    </object>
  </objects>
  <!-- a new game starts the score again, but not the best or the table -->
  <keeps>
    <keep object="best" />
    <keep object="table" />
  </keeps>
  <states>
    <!-- what the three states that ask for initials show -->
    <shows name="initials">
      <show object="entry" />
      <show object="entryscore" />
      <show object="letter1" />
      <show object="letter2" />
      <show object="letter3" />
      <show object="howto" />
    </shows>
    <state name="mainmenu">
      <objects>
        <object name="title">
          <sprite>
            <text>
              <content>GALAXIAN</content>
              <size>96</size>
              <color>color.yellow</color>
            </text>
          </sprite>
          <position><x>window.width.center - title.width / 2</x><y>window.height.center - title.height / 2 + (-230)</y></position>
        </object>
        <object name="help">
          <sprite>
            <text>
              <content>they fly in, then dive at you</content>
              <size>30</size>
              <color>color.white</color>
            </text>
          </sprite>
          <position><x>window.width.center - help.width / 2</x><y>window.height.center - help.height / 2 + (-150)</y></position>
        </object>
        <object name="keys">
          <sprite>
            <text>
              <content>a and d, or the arrows, to move; space to fire; p to pause</content>
              <size>20</size>
              <color>color.lightgrey</color>
            </text>
          </sprite>
          <position><x>window.width.center - keys.width / 2</x><y>window.height.center - keys.height / 2 + (-115)</y></position>
        </object>
        <object name="start">
          <sprite>
            <text>
              <content>spacebar to start, 2 for two players</content>
              <size>36</size>
              <color>color.white</color>
            </text>
          </sprite>
          <position><x>window.width.center - start.width / 2</x><y>window.height.center - start.height / 2 + (230)</y></position>
        </object>
      </objects>
      <shows>
        <show object="best" />
        <show object="table" />
      </shows>
      <inputs>
        <input button="space">
          <push state="playing" />
        </input>
        <!-- two players, taking turns -->
        <input button="num2">
          <push state="playing" />
          <turns>
            <player state="player1" />
            <player state="player2" />
          </turns>
        </input>
      </inputs>
    </state>
    <state name="playing">
      <objects>
        <!-- the aliens' bombs: a pool of six, dropped by divers -->
        <group name="bombs" class="bomb">
          <sprite>
            <rectangle>
              <width>3</width>
              <height>9</height>
              <color>color.yellow</color>
            </rectangle>
          </sprite>
          <position><x>0</x><y>0</y></position>
          <velocity><y>6</y></velocity>
          <hidden>true</hidden>
          <collisions>
            <enabled>false</enabled>
            <collision edge="all">
              <die />
            </collision>
            <collision object="ship">
              <die />
            </collision>
          </collisions>
          <member />
          <member />
          <member />
          <member />
          <member />
          <member />
        </group>
        <object name="shot" class="projectile">
          <sprite>
            <rectangle>
              <width>3</width>
              <height>12</height>
              <color>color.white</color>
            </rectangle>
          </sprite>
          <position><x>0</x><y>0</y></position>
          <velocity><y>-10</y></velocity>
          <hidden>true</hidden>
          <collisions>
            <enabled>false</enabled>
            <collision edge="all">
              <die />
            </collision>
            <collision class="alien">
              <die />
            </collision>
          </collisions>
        </object>
        <object name="ship">
          <sprite>
            <bitmap>
              <row>.....*.....</row>
              <row>....***....</row>
              <row>....***....</row>
              <row>.*.*****.*.</row>
              <row>***********</row>
              <row>*****.*****</row>
              <row>**.......**</row>
              <scale>pixel</scale>
              <color>color.cyan</color>
            </bitmap>
          </sprite>
          <position><x>window.width.center - ship.width / 2</x><y>window.bottom - ship.height - margin * 3</y></position>
          <collisions>
            <enabled>true</enabled>
            <collision edge="horizontal">
              <stick />
            </collision>
            <collision class="alien">
              <dec variable="ship.lives" />
              <inc variable="ship.lost" />
              <play sound="boom" />
            </collision>
            <collision class="bomb">
              <dec variable="ship.lives" />
              <inc variable="ship.lost" />
              <play sound="boom" />
            </collision>
          </collisions>
          <actions>
            <action name="left">
              <move direction="left">step</move>
            </action>
            <action name="right">
              <move direction="right">step</move>
            </action>
            <action name="gun">
              <fire object="shot" />
              <play sound="shoot" />
            </action>
          </actions>
          <variables>
            <variable name="score">0</variable>
            <variable name="lives">startlives</variable>
            <variable name="lost">0</variable>
          </variables>
        </object>
        <object name="score">
          <sprite>
            <text>
              <number>ship.score</number>
              <size>36</size>
              <color>color.white</color>
            </text>
          </sprite>
          <position><x>margin</x><y>margin</y></position>
        </object>
        <object name="lives">
          <sprite>
            <text>
              <number>ship.lives</number>
              <size>36</size>
              <color>color.cyan</color>
            </text>
          </sprite>
          <position><x>window.right - lives.width - margin</x><y>margin</y></position>
        </object>
      </objects>
      <scenes>
        <!-- the fleet: five rows that fly in and take their places -->
        <scene name="fleet">
          <objects>
            <!-- flagships: 2, 60 points each -->
            <group name="flagships" class="alien">
              <sprite>
                <bitmap>
                  <row>...*...*...</row>
                  <row>....***....</row>
                  <row>..*******..</row>
                  <row>.**.***.**.</row>
                  <row>***********</row>
                  <row>*.*******.*</row>
                  <row>*.*.....*.*</row>
                  <row>...**.**...</row>
                  <scale>pixel</scale>
                  <color>color.yellow</color>
                </bitmap>
              </sprite>
              <position>
                <y>row1</y>
              </position>
              <collisions>
                <enabled>true</enabled>
                <collision edge="bottom">
                  <wrap />
                </collision>
                <collision object="shot">
                  <die />
                  <inc variable="ship.score">60</inc>
                  <play sound="hit" />
                </collision>
                <collision object="ship">
                  <die />
                </collision>
              </collisions>
              <timers>
                <timer>
                  <every><random min="20" max="60" /></every>
                  <follow path="dive" />
                </timer>
              </timers>
              <member><position><x>left + gap * 3</x></position></member>
              <member><position><x>left + gap * 6</x></position></member>
            </group>
            <!-- escorts: 6, 50 points each -->
            <group name="escorts" class="alien">
              <sprite>
                <bitmap>
                  <row>...*...*...</row>
                  <row>..*******..</row>
                  <row>.**.***.**.</row>
                  <row>***********</row>
                  <row>*.*******.*</row>
                  <row>*.*.....*.*</row>
                  <row>...*...*...</row>
                  <row>..*.....*..</row>
                  <scale>pixel</scale>
                  <color>color.red</color>
                </bitmap>
              </sprite>
              <position>
                <y>row2</y>
              </position>
              <collisions>
                <enabled>true</enabled>
                <collision edge="bottom">
                  <wrap />
                </collision>
                <collision object="shot">
                  <die />
                  <inc variable="ship.score">50</inc>
                  <play sound="hit" />
                </collision>
                <collision object="ship">
                  <die />
                </collision>
              </collisions>
              <timers>
                <timer>
                  <every><random min="12" max="60" /></every>
                  <follow path="dive" />
                </timer>
              </timers>
              <member><position><x>left + gap * 2</x></position></member>
              <member><position><x>left + gap * 3</x></position></member>
              <member><position><x>left + gap * 4</x></position></member>
              <member><position><x>left + gap * 5</x></position></member>
              <member><position><x>left + gap * 6</x></position></member>
              <member><position><x>left + gap * 7</x></position></member>
            </group>
            <!-- purples: 8, 40 points each -->
            <group name="purples" class="alien">
              <sprite>
                <bitmap>
                  <row>..*.....*..</row>
                  <row>...*...*...</row>
                  <row>..*******..</row>
                  <row>.**.***.**.</row>
                  <row>***********</row>
                  <row>*.*******.*</row>
                  <row>*.*.....*.*</row>
                  <row>...**.**...</row>
                  <scale>pixel</scale>
                  <color>color.magenta</color>
                </bitmap>
              </sprite>
              <position>
                <y>row3</y>
              </position>
              <collisions>
                <enabled>true</enabled>
                <collision edge="bottom">
                  <wrap />
                </collision>
                <collision object="shot">
                  <die />
                  <inc variable="ship.score">40</inc>
                  <play sound="hit" />
                </collision>
                <collision object="ship">
                  <die />
                </collision>
              </collisions>
              <timers>
                <timer>
                  <every><random min="15" max="80" /></every>
                  <follow path="dive" />
                </timer>
              </timers>
              <member><position><x>left + gap * 1</x></position></member>
              <member><position><x>left + gap * 2</x></position></member>
              <member><position><x>left + gap * 3</x></position></member>
              <member><position><x>left + gap * 4</x></position></member>
              <member><position><x>left + gap * 5</x></position></member>
              <member><position><x>left + gap * 6</x></position></member>
              <member><position><x>left + gap * 7</x></position></member>
              <member><position><x>left + gap * 8</x></position></member>
            </group>
            <!-- blues: 10, 30 points each -->
            <group name="blues" class="alien">
              <sprite>
                <bitmap>
                  <row>....*.*....</row>
                  <row>...*****...</row>
                  <row>..**.*.**..</row>
                  <row>.*********.</row>
                  <row>*.*******.*</row>
                  <row>*.*.....*.*</row>
                  <row>..*.....*..</row>
                  <row>.*.......*.</row>
                  <scale>pixel</scale>
                  <color>color.cyan</color>
                </bitmap>
              </sprite>
              <position>
                <y>row4</y>
              </position>
              <collisions>
                <enabled>true</enabled>
                <collision edge="bottom">
                  <wrap />
                </collision>
                <collision object="shot">
                  <die />
                  <inc variable="ship.score">30</inc>
                  <play sound="hit" />
                </collision>
                <collision object="ship">
                  <die />
                </collision>
              </collisions>
              <timers>
                <timer>
                  <every><random min="20" max="100" /></every>
                  <follow path="dive" />
                </timer>
              </timers>
              <member><position><x>left + gap * 0</x></position></member>
              <member><position><x>left + gap * 1</x></position></member>
              <member><position><x>left + gap * 2</x></position></member>
              <member><position><x>left + gap * 3</x></position></member>
              <member><position><x>left + gap * 4</x></position></member>
              <member><position><x>left + gap * 5</x></position></member>
              <member><position><x>left + gap * 6</x></position></member>
              <member><position><x>left + gap * 7</x></position></member>
              <member><position><x>left + gap * 8</x></position></member>
              <member><position><x>left + gap * 9</x></position></member>
            </group>
            <!-- blues2: 10, 30 points each -->
            <group name="blues2" class="alien">
              <sprite>
                <bitmap>
                  <row>....*.*....</row>
                  <row>...*****...</row>
                  <row>..**.*.**..</row>
                  <row>.*********.</row>
                  <row>*.*******.*</row>
                  <row>*.*.....*.*</row>
                  <row>..*.....*..</row>
                  <row>.*.......*.</row>
                  <scale>pixel</scale>
                  <color>color.cyan</color>
                </bitmap>
              </sprite>
              <position>
                <y>row5</y>
              </position>
              <collisions>
                <enabled>true</enabled>
                <collision edge="bottom">
                  <wrap />
                </collision>
                <collision object="shot">
                  <die />
                  <inc variable="ship.score">30</inc>
                  <play sound="hit" />
                </collision>
                <collision object="ship">
                  <die />
                </collision>
              </collisions>
              <timers>
                <timer>
                  <every><random min="20" max="100" /></every>
                  <follow path="dive" />
                </timer>
              </timers>
              <member><position><x>left + gap * 0</x></position></member>
              <member><position><x>left + gap * 1</x></position></member>
              <member><position><x>left + gap * 2</x></position></member>
              <member><position><x>left + gap * 3</x></position></member>
              <member><position><x>left + gap * 4</x></position></member>
              <member><position><x>left + gap * 5</x></position></member>
              <member><position><x>left + gap * 6</x></position></member>
              <member><position><x>left + gap * 7</x></position></member>
              <member><position><x>left + gap * 8</x></position></member>
              <member><position><x>left + gap * 9</x></position></member>
            </group>
          </objects>
          <conditions>
            <!-- the whole fleet shot down: the next one flies in -->
            <condition class="alien">
              <remaining>0</remaining>
              <reset scene="fleet" />
            </condition>
          </conditions>
          <timers>
            <!-- sends the fleet in, row by row, as the scene starts -->
            <timer>
              <after>0.01</after>
              <follow path="fromtop" object="flagships"><stagger>spacing</stagger></follow>
              <follow path="fromtopleft" object="escorts"><stagger>spacing</stagger></follow>
              <follow path="fromtopright" object="purples"><stagger>spacing</stagger></follow>
              <follow path="fromleft" object="blues"><stagger>spacing</stagger></follow>
              <follow path="fromright" object="blues2"><stagger>spacing</stagger></follow>
            </timer>
          </timers>
        </scene>
      </scenes>
      <shows>
        <show object="best" />
      </shows>
      <inputs>
        <input button="a left">
          <trigger object="ship" action="left" />
        </input>
        <input button="d right">
          <trigger object="ship" action="right" />
        </input>
        <input button="space">
          <trigger object="ship" action="gun" />
        </input>
        <input button="p escape">
          <push state="paused" />
        </input>
      </inputs>
      <conditions>
        <condition object="ship" variable="lives">
          <atmost>0</atmost>
          <push state="gameover" />
        </condition>
        <!-- a ship lost: the other player's turn, with two -->
        <condition object="ship" variable="lost">
          <atleast>1</atleast>
          <dec variable="ship.lost" />
          <pass />
        </condition>
        <!-- a new best: the score is copied into it as it goes up -->
        <condition object="ship" variable="score">
          <above object="best" variable="score" />
          <copy variable="ship.score" into="best.score" />
        </condition>
      </conditions>
    </state>
    <state name="paused">
      <objects>
        <object name="paused">
          <sprite>
            <text>
              <content>PAUSED</content>
              <size>96</size>
              <color>color.white</color>
            </text>
          </sprite>
          <position><x>window.width.center - paused.width / 2</x><y>window.height.center - paused.height / 2 + (0)</y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input button="space p escape">
          <pop />
        </input>
      </inputs>
    </state>
    <state name="gameover">
      <objects>
        <object name="gameover">
          <sprite>
            <text>
              <content>GAME OVER</content>
              <size>80</size>
              <color>color.red</color>
            </text>
          </sprite>
          <position><x>window.width.center - gameover.width / 2</x><y>window.height.center - gameover.height / 2 + (-60)</y></position>
        </object>
        <object name="again">
          <sprite>
            <text>
              <content>spacebar to go on</content>
              <size>36</size>
              <color>color.white</color>
            </text>
          </sprite>
          <position><x>window.width.center - again.width / 2</x><y>window.height.center - again.height / 2 + (60)</y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <!-- the other player plays on; with no one left, a new game -->
        <input button="space">
          <out />
          <reset />
        </input>
      </inputs>
      <conditions>
        <!-- above the fifth of the table: initials for it -->
        <condition object="ship" variable="score">
          <above object="table.5" variable="score" />
          <copy variable="ship.score" into="entry.score" />
          <pop state="initial1" />
        </condition>
      </conditions>
    </state>
    <!-- whose turn it is, over their game, for two seconds -->
    <state name="player1">
      <objects>
        <object name="player1">
          <sprite><text><content>PLAYER 1</content><size>80</size><color>color.yellow</color></text></sprite>
          <position><x>window.width.center - player1.width / 2</x><y>window.height.center - player1.height / 2</y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input button="space"><pop /></input>
      </inputs>
      <timers>
        <timer><after>2</after><pop /></timer>
      </timers>
    </state>
    <state name="player2">
      <objects>
        <object name="player2">
          <sprite><text><content>PLAYER 2</content><size>80</size><color>color.cyan</color></text></sprite>
          <position><x>window.width.center - player2.width / 2</x><y>window.height.center - player2.height / 2</y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input button="space"><pop /></input>
      </inputs>
      <timers>
        <timer><after>2</after><pop /></timer>
      </timers>
    </state>
    <!-- the initials, a letter a state; the cursor shows which -->
    <state name="initial1">
      <objects>
        <object name="cursor1">
          <sprite><rectangle><width>36</width><height>4</height><color>color.yellow</color></rectangle></sprite>
          <position><x>letters</x><y>375</y></position>
        </object>
      </objects>
      <shows>
        <show set="initials" />
      </shows>
      <inputs>
        <input button="w up"><inc variable="entry.first" /></input>
        <input button="s down"><dec variable="entry.first" /></input>
        <input button="space d right"><pop state="initial2" /></input>
      </inputs>
    </state>
    <state name="initial2">
      <objects>
        <object name="cursor2">
          <sprite><rectangle><width>36</width><height>4</height><color>color.yellow</color></rectangle></sprite>
          <position><x>letters + letterstep</x><y>375</y></position>
        </object>
      </objects>
      <shows>
        <show set="initials" />
      </shows>
      <inputs>
        <input button="w up"><inc variable="entry.second" /></input>
        <input button="s down"><dec variable="entry.second" /></input>
        <input button="space d right"><pop state="initial3" /></input>
      </inputs>
    </state>
    <state name="initial3">
      <objects>
        <object name="cursor3">
          <sprite><rectangle><width>36</width><height>4</height><color>color.yellow</color></rectangle></sprite>
          <position><x>letters + letterstep * 2</x><y>375</y></position>
        </object>
      </objects>
      <shows>
        <show set="initials" />
      </shows>
      <inputs>
        <input button="w up"><inc variable="entry.third" /></input>
        <input button="s down"><dec variable="entry.third" /></input>
        <!-- the entry into its place in the table, and a new game -->
        <input button="space d right">
          <rank variable="entry.score" into="table" />
          <out />
          <reset />
        </input>
      </inputs>
    </state>
  </states>
</game>
