<!-- galaxian.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Oct 5, 2026 -->

<!--
  Galaxian, after Namco's 1979 arcade game. Over a field of drifting stars a
  fleet of 46 flies in and settles into formation: two yellow flagships, six
  red escorts, eight purples and three rows of blues. One at a time they
  break away and dive at the ship, weaving and dropping bombs, then loop
  round from the top back into their places. Blues score 30, purples 40,
  escorts 50, flagships 60. Shoot them all and the next fleet flies in; lose
  three ships and it is over.

  A and D or the arrows move, Space fires and starts, P or Escape pauses, 2
  on the title for two players.

  How it is written:
  * The stars are a <map>: each character is a star of one colour, and all
    of them drift down and <wrap /> at the bottom, blinking on an
    <animation> of their own colour's pace.
  * The fleet is one group of six rows, each an inner group laid out in
    <columns>: what every alien does (wrap at the bottom, die to the shot
    and score its own worth, dive on a timer) is said once, and each row
    says its picture, its height and its worth. The three rows of blues
    share their picture in a group of their own.
  * The fleet flies in on <paths>, a row to a path (the top and bottom
    blues share one, as a line of twenty), the aliens of a row <stagger>ed
    one behind another, waiting off screen at the path's start for their
    turn; <home /> flies each to its <position>.
    The dive's steps add up to no movement across and to the window's
    height plus the alien's down, which is what the <wrap /> takes off, so
    a diver that misses comes back in from the top to its own place.
  * The fleet is the playing state's one scene: when it is shot down a
    condition <reset scene>s it and sends the next in at once, so it is
    never drawn sitting in its places first.
  * The best score and the table of the best five are <keeps>, written to
    saves/galaxian.xml. A game over above the fifth asks for initials, a
    letter a state; the second and third letters are the first's state
    (from=) with the cursor moved and their own keys.
  * Two players take turns (<turns>, <pass />, <out />); each turn begins
    with a screen saying whose it is, player 2's a copy of player 1's.
  * Left on the title for ten seconds, it plays its <demo>.
  * The swarm hums under play (the playing state's <music>); a short tune
    plays as a game starts.
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../xgedef.xsd">
  <window name="Galaxian">
    <width>560</width>
    <height>640</height>
  </window>
  <variables>
    <variable name="pixel">3</variable>
    <variable name="alienheight">8 * pixel</variable>
    <variable name="left">83</variable>
    <variable name="gap">40</variable>
    <!-- the space between two aliens side by side -->
    <variable name="apart">gap - 11 * pixel</variable>
    <variable name="enterspeed">4</variable>
    <variable name="divespeed">3</variable>
    <variable name="spacing">0.15</variable>
    <variable name="step">4</variable>
    <variable name="margin">12</variable>
    <variable name="tabletop">250</variable>
    <variable name="tablerow">36</variable>
    <variable name="letters">window.width.center - 80</variable>
    <variable name="letterstep">60</variable>
    <variable name="startlives">3</variable>
  </variables>
  <sounds>
    <sound name="shoot" wave="square"><volume>0.15</volume><note pitch="E6" to="E5">0.06</note></sound>
    <sound name="hit" wave="noise"><volume>0.3</volume><note pitch="2000" to="200">0.2</note></sound>
    <sound name="dive" wave="triangle"><volume>0.2</volume><note pitch="C6" to="C4">0.4</note></sound>
    <sound name="boom" wave="noise"><volume>0.4</volume><note pitch="3000" to="100">0.6</note></sound>
    <!-- the swarm, humming under play -->
    <sound name="swarm" wave="triangle">
      <loop />
      <volume>0.1</volume>
      <note pitch="A2" to="C3">0.3</note>
      <note pitch="C3" to="A2">0.3</note>
    </sound>
    <!-- a game starting -->
    <sound name="start">
      <volume>0.2</volume>
      <part wave="square">
        <note pitch="C5">0.12</note>
        <note pitch="E5">0.12</note>
        <note pitch="G5">0.12</note>
        <note pitch="C6">0.12</note>
        <note pitch="B5">0.12</note>
        <note pitch="G5">0.12</note>
        <note pitch="A5">0.12</note>
        <note pitch="C6">0.36</note>
      </part>
      <part wave="triangle">
        <note pitch="C3">0.48</note>
        <note pitch="G2">0.48</note>
        <note pitch="C3">0.36</note>
      </part>
    </sound>
  </sounds>
  <paths>
    <!-- the flagships: straight down the middle, a loop to the left, and up into place -->
    <path name="fromtop">
      <speed>enterspeed</speed>
      <start><x>window.width.center - 16</x><y>-30</y></start>
      <step><x>0</x><y>260</y></step>
      <step><x>-80</x><y>60</y></step>
      <step><x>-60</x><y>-60</y></step>
      <step><x>60</x><y>-80</y></step>
      <home />
    </path>
    <!-- the red escorts: in from the top left and round -->
    <path name="fromtopleft">
      <speed>enterspeed</speed>
      <start><x>100</x><y>-30</y></start>
      <step><x>60</x><y>200</y></step>
      <step><x>120</x><y>40</y></step>
      <step><x>40</x><y>-80</y></step>
      <home />
    </path>
    <!-- the purples: the same from the top right -->
    <path name="fromtopright">
      <speed>enterspeed</speed>
      <start><x>window.right - 133</x><y>-30</y></start>
      <step><x>-60</x><y>200</y></step>
      <step><x>-120</x><y>40</y></step>
      <step><x>-40</x><y>-80</y></step>
      <home />
    </path>
    <!-- the blues: in low from the left and up -->
    <path name="fromleft">
      <speed>enterspeed</speed>
      <start><x>-40</x><y>330</y></start>
      <step><x>200</x><y>-20</y></step>
      <step><x>100</x><y>-100</y></step>
      <step><x>-40</x><y>-80</y></step>
      <home />
    </path>
    <!-- and from the right -->
    <path name="fromright">
      <speed>enterspeed</speed>
      <start><x>window.right + 7</x><y>330</y></start>
      <step><x>-200</x><y>-20</y></step>
      <step><x>-100</x><y>-100</y></step>
      <step><x>40</x><y>-80</y></step>
      <home />
    </path>
    <!--
      The dive: a peel off up and to the left, then down, weaving side to
      side and dropping a bomb on the way, then straight down off the bottom
      of the screen. The steps add up to 0 across and to window.bottom +
      alienheight down, which is what the <wrap /> at the bottom takes off
      again, so the last <home /> only tidies up.
    -->
    <path name="dive">
      <speed>divespeed</speed>
      <step><x>-24</x><y>-24</y><play sound="dive" /></step>
      <step><x>-24</x><y>40</y></step>
      <step><x>80</x><y>120</y><fire object="bomb" /></step>
      <step><x>-80</x><y>120</y></step>
      <step><x>80</x><y>120</y><fire object="bomb" /></step>
      <step><x>-32</x><y>120</y></step>
      <step><x>0</x><y>window.bottom + alienheight - 496</y></step>
      <home />
    </path>
  </paths>
  <styles>
    <style name="banner"><size>96</size><color>color.yellow</color></style>
    <style name="prompt"><size>36</size><color>color.white</color></style>
    <style name="hud"><size>36</size><color>color.white</color></style>
    <style name="letter"><size>60</size><color>color.cyan</color></style>
  </styles>
  <kit>
    <!-- an alien's bomb, dropped by divers: six at most -->
    <object name="bomb" class="bomb">
      <sprite><rectangle><width>3</width><height>9</height><color>color.yellow</color></rectangle></sprite>
      <velocity><y>6</y></velocity>
      <most>6</most>
      <collisions>
        <collision edge="all"><despawn /></collision>
        <collision object="ship"><despawn /></collision>
      </collisions>
    </object>
  </kit>
  <objects>
    <!-- the stars, drifting down behind everything, each colour blinking at its own pace -->
    <map name="sky">
      <tile><width>40</width><height>40</height></tile>
      <position><x>0</x><y>0</y></position>
      <row>..r.......w...</row>
      <row>.......b......</row>
      <row>y..........r..</row>
      <row>.....w........</row>
      <row>.b.........y..</row>
      <row>........r.....</row>
      <row>...y.........b</row>
      <row>.........w....</row>
      <row>r....b........</row>
      <row>...........y..</row>
      <row>..w....r......</row>
      <row>.............w</row>
      <row>.y.....b......</row>
      <row>.........r....</row>
      <row>....w.......b.</row>
      <row>b.........y...</row>
      <group name="stars">
        <sprite name="on"><bitmap><row>*</row><scale>2</scale></bitmap></sprite>
        <sprite name="off"><bitmap><row>.</row><scale>2</scale></bitmap></sprite>
        <animation><interval>0.4</interval><frame sprite="on" /><frame sprite="on" /><frame sprite="off" /></animation>
        <velocity><y>0.5</y></velocity>
        <collisions>
          <collision edge="bottom"><wrap /></collision>
        </collisions>
        <group name="redstars" char="r"><sprite name="on"><bitmap><color>color.red</color></bitmap></sprite></group>
        <group name="bluestars" char="b">
          <sprite name="on"><bitmap><color>color.cyan</color></bitmap></sprite>
          <animation><interval>0.3</interval><frame sprite="on" /><frame sprite="off" /></animation>
        </group>
        <group name="yellowstars" char="y">
          <sprite name="on"><bitmap><color>color.yellow</color></bitmap></sprite>
          <animation><interval>0.5</interval><frame sprite="off" /><frame sprite="on" /><frame sprite="on" /></animation>
        </group>
        <group name="whitestars" char="w" />
      </group>
    </map>
    <!-- the best score, at the top in the middle on the title and in play -->
    <object name="best">
      <sprite><text style="hud"><number>best.score</number><color>color.red</color></text></sprite>
      <position><x><centered /></x><y>margin</y></position>
      <variables><variable name="score">0</variable></variables>
    </object>
    <!-- the best five, on the title screen: three letters and a score each -->
    <group name="table">
      <sprite>
        <text>
          <letter>table.first</letter>
          <letter>table.second</letter>
          <letter>table.third</letter>
          <number>table.score</number>
          <size>28</size>
          <color>color.cyan</color>
        </text>
      </sprite>
      <position><x>window.width.center - 60</x></position>
      <variables>
        <variable name="first">0</variable>
        <variable name="second">0</variable>
        <variable name="third">0</variable>
        <variable name="score">0</variable>
      </variables>
      <member><position><y>tabletop</y></position></member>
      <member><position><y>tabletop + tablerow</y></position></member>
      <member><position><y>tabletop + tablerow * 2</y></position></member>
      <member><position><y>tabletop + tablerow * 3</y></position></member>
      <member><position><y>tabletop + tablerow * 4</y></position></member>
    </group>
    <!-- a score for the table, and the initials it is given -->
    <object name="entry">
      <sprite><text style="letter"><content>NEW BEST</content><color>color.yellow</color></text></sprite>
      <position><x><centered /></x><y>120</y></position>
      <variables>
        <variable name="first">0</variable>
        <variable name="second">0</variable>
        <variable name="third">0</variable>
        <variable name="score">0</variable>
      </variables>
    </object>
    <object name="entryscore">
      <sprite><text style="hud"><number>entry.score</number></text></sprite>
      <position><x><centered /></x><y>210</y></position>
    </object>
    <object name="letter1">
      <sprite><text style="letter"><letter>entry.first</letter></text></sprite>
      <position><x>letters</x><y>300</y></position>
    </object>
    <object name="letter2">
      <sprite><text style="letter"><letter>entry.second</letter></text></sprite>
      <position><x>letters + letterstep</x><y>300</y></position>
    </object>
    <object name="letter3">
      <sprite><text style="letter"><letter>entry.third</letter></text></sprite>
      <position><x>letters + letterstep * 2</x><y>300</y></position>
    </object>
    <object name="howto">
      <sprite><text><content>w and s, or up and down, change the letter; space for the next</content><size>18</size><color>color.lightgrey</color></text></sprite>
      <position><x><centered /></x><y>440</y></position>
    </object>
  </objects>
  <!-- a new game starts the score again, but not the best or the table -->
  <keeps>
    <keep object="best" />
    <keep object="table" />
  </keeps>
  <states>
    <!-- what the three states that ask for initials show -->
    <shows name="initials">
      <show object="entry" />
      <show object="entryscore" />
      <show object="letter1" />
      <show object="letter2" />
      <show object="letter3" />
      <show object="howto" />
    </shows>
    <state name="mainmenu">
      <objects>
        <object name="title">
          <sprite><text style="banner"><content>GALAXIAN</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 230</centered></y></position>
        </object>
        <object name="help">
          <sprite><text><content>blue 30  purple 40  red 50  flagship 60</content><size>26</size><color>color.white</color></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 150</centered></y></position>
        </object>
        <object name="keys">
          <sprite><text><content>a and d, or the arrows, to move; space to fire; p to pause</content><size>20</size><color>color.lightgrey</color></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 115</centered></y></position>
        </object>
        <object name="start">
          <sprite><text style="prompt"><content>spacebar to start, 2 for two players</content><size>32</size></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center + 230</centered></y></position>
        </object>
      </objects>
      <shows>
        <show object="sky" />
        <show object="best" />
        <show object="table" />
      </shows>
      <inputs>
        <input button="space">
          <push state="playing" />
          <play sound="start" />
        </input>
        <!-- two players, taking turns -->
        <input button="num2">
          <push state="playing" />
          <play sound="start" />
          <turns>
            <player state="player1" />
            <player state="player2" />
          </turns>
        </input>
      </inputs>
      <!-- left alone, the game shows itself being played -->
      <timers>
        <timer><after>10</after><demo /></timer>
      </timers>
    </state>
    <state name="playing">
      <objects>
        <object name="shot" class="projectile">
          <sprite><rectangle><width>3</width><height>12</height><color>color.white</color></rectangle></sprite>
          <position><x>0</x><y>0</y></position>
          <velocity><y>-10</y></velocity>
          <active>false</active>
          <collisions>
            <enabled>false</enabled>
            <collision edge="all"><die /></collision>
            <collision class="alien"><die /></collision>
          </collisions>
        </object>
        <object name="ship">
          <sprite>
            <bitmap>
              <row>.....*.....</row>
              <row>....***....</row>
              <row>....*r*....</row>
              <row>.r.*****.r.</row>
              <row>***********</row>
              <row>*****.*****</row>
              <row>**.......**</row>
              <scale>pixel</scale>
              <color>color.cyan</color>
              <color char="r">color.red</color>
            </bitmap>
          </sprite>
          <position><x><centered /></x><y>window.bottom - ship.height - margin * 3</y></position>
          <collisions>
            <collision edge="horizontal"><stick /></collision>
            <collision class="alien"><trigger action="lose" /></collision>
            <collision class="bomb"><trigger action="lose" /></collision>
          </collisions>
          <actions>
            <action name="lose">
              <dec variable="ship.lives" />
              <inc variable="ship.lost" />
              <play sound="boom" />
            </action>
            <action name="left"><move direction="left">step</move></action>
            <action name="right"><move direction="right">step</move></action>
            <action name="gun">
              <fire object="shot" />
              <play sound="shoot" />
            </action>
          </actions>
          <variables>
            <variable name="score">0</variable>
            <variable name="lives">startlives</variable>
            <variable name="lost">0</variable>
          </variables>
        </object>
        <object name="score">
          <sprite><text style="hud"><number>ship.score</number></text></sprite>
          <position><x>margin</x><y>margin</y></position>
        </object>
        <object name="lives">
          <sprite><text style="hud"><number>ship.lives</number><color>color.cyan</color></text></sprite>
          <position><x>window.right - lives.width - margin</x><y>margin</y></position>
        </object>
      </objects>
      <scenes>
        <!-- the fleet: six rows that fly in and take their places -->
        <scene name="fleet">
          <objects>
            <group name="aliens" class="alien">
              <collisions>
                <collision edge="bottom"><wrap /></collision>
                <collision object="shot">
                  <die />
                  <inc variable="ship.score">self.worth</inc>
                  <play sound="hit" />
                </collision>
                <collision object="ship"><die /></collision>
              </collisions>
              <timers>
                <timer>
                  <every><random><min>15</min><max>90</max></random></every>
                  <follow path="dive" />
                </timer>
              </timers>
              <group name="flagships">
                <columns>2</columns>
                <rows>1</rows>
                <padding><x>gap * 3 - 11 * pixel</x><y>0</y></padding>
                <sprite>
                  <bitmap>
                    <row>...*...*...</row>
                    <row>....***....</row>
                    <row>..*******..</row>
                    <row>.**.*r*.**.</row>
                    <row>***********</row>
                    <row>*.rrrrrrr.*</row>
                    <row>*.*.....*.*</row>
                    <row>...**.**...</row>
                    <scale>pixel</scale>
                    <color>color.yellow</color>
                    <color char="r">color.red</color>
                  </bitmap>
                </sprite>
                <position><x>left + gap * 3</x><y>70</y></position>
                <variables><variable name="worth">60</variable></variables>
              </group>
              <group name="escorts">
                <columns>6</columns>
                <rows>1</rows>
                <padding><x>apart</x><y>0</y></padding>
                <sprite>
                  <bitmap>
                    <row>...*...*...</row>
                    <row>..*******..</row>
                    <row>.**.*b*.**.</row>
                    <row>***********</row>
                    <row>*.*******.*</row>
                    <row>*.*.....*.*</row>
                    <row>...*...*...</row>
                    <row>..*.....*..</row>
                    <scale>pixel</scale>
                    <color>color.red</color>
                    <color char="b">color.cyan</color>
                  </bitmap>
                </sprite>
                <position><x>left + gap * 2</x><y>100</y></position>
                <variables><variable name="worth">50</variable></variables>
              </group>
              <group name="purples">
                <columns>8</columns>
                <rows>1</rows>
                <padding><x>apart</x><y>0</y></padding>
                <sprite>
                  <bitmap>
                    <row>..*.....*..</row>
                    <row>...*...*...</row>
                    <row>..*******..</row>
                    <row>.**.*b*.**.</row>
                    <row>***********</row>
                    <row>*.*******.*</row>
                    <row>*.*.....*.*</row>
                    <row>...**.**...</row>
                    <scale>pixel</scale>
                    <color>color.magenta</color>
                    <color char="b">color.cyan</color>
                  </bitmap>
                </sprite>
                <position><x>left + gap</x><y>130</y></position>
                <variables><variable name="worth">40</variable></variables>
              </group>
              <!-- three rows of blues, ten each -->
              <group name="blues">
                <columns>10</columns>
                <rows>1</rows>
                <padding><x>apart</x><y>0</y></padding>
                <sprite>
                  <bitmap>
                    <row>....*.*....</row>
                    <row>...*****...</row>
                    <row>..**y*y**..</row>
                    <row>.*********.</row>
                    <row>*.*******.*</row>
                    <row>*.*.....*.*</row>
                    <row>..*.....*..</row>
                    <row>.*.......*.</row>
                    <scale>pixel</scale>
                    <color>color.cyan</color>
                    <color char="y">color.yellow</color>
                  </bitmap>
                </sprite>
                <variables><variable name="worth">30</variable></variables>
                <!-- the top and bottom rows fly in from the left as one line of twenty -->
                <group name="leftblues">
                  <group name="blues1"><position><x>left</x><y>160</y></position></group>
                  <group name="blues3"><position><x>left</x><y>220</y></position></group>
                </group>
                <group name="blues2"><position><x>left</x><y>190</y></position></group>
              </group>
            </group>
          </objects>
          <conditions>
            <!-- the whole fleet shot down: the next one flies in -->
            <condition class="alien">
              <remaining>0</remaining>
              <reset scene="fleet" />
              <follow path="fromtop" object="flagships"><stagger>spacing</stagger></follow>
              <follow path="fromtopleft" object="escorts"><stagger>spacing</stagger></follow>
              <follow path="fromtopright" object="purples"><stagger>spacing</stagger></follow>
              <follow path="fromleft" object="leftblues"><stagger>spacing</stagger></follow>
              <follow path="fromright" object="blues2"><stagger>spacing</stagger></follow>
            </condition>
          </conditions>
          <timers>
            <!--
              Sends the fleet in, row by row, as the scene starts; each row waits
              off screen, at its path's start, for its turn. A new fleet is sent
              by the condition above, in the frame it is put back, so it is never
              drawn sitting in its places first.
            -->
            <timer>
              <after>0.01</after>
              <follow path="fromtop" object="flagships"><stagger>spacing</stagger></follow>
              <follow path="fromtopleft" object="escorts"><stagger>spacing</stagger></follow>
              <follow path="fromtopright" object="purples"><stagger>spacing</stagger></follow>
              <follow path="fromleft" object="leftblues"><stagger>spacing</stagger></follow>
              <follow path="fromright" object="blues2"><stagger>spacing</stagger></follow>
            </timer>
          </timers>
        </scene>
      </scenes>
      <shows>
        <show object="sky" />
        <show object="best" />
      </shows>
      <music sound="swarm" />
      <inputs>
        <input button="a left"><trigger object="ship" action="left" /></input>
        <input button="d right"><trigger object="ship" action="right" /></input>
        <input button="space"><trigger object="ship" action="gun" /></input>
        <input button="p escape"><push state="paused" /></input>
      </inputs>
      <conditions>
        <condition object="ship" variable="lives">
          <atmost>0</atmost>
          <push state="gameover" />
        </condition>
        <!-- a ship lost: the other player's turn, with two -->
        <condition object="ship" variable="lost">
          <atleast>1</atleast>
          <dec variable="ship.lost" />
          <pass />
        </condition>
        <!-- a new best: the score is copied into it as it goes up -->
        <condition object="ship" variable="score">
          <above>best.score</above>
          <copy variable="ship.score" into="best.score" />
        </condition>
      </conditions>
    </state>
    <state name="paused">
      <objects>
        <object name="paused">
          <sprite><text style="banner"><content>PAUSED</content><color>color.white</color></text></sprite>
          <position><x><centered /></x><y><centered /></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input button="space p escape"><pop /></input>
      </inputs>
    </state>
    <state name="gameover">
      <objects>
        <object name="gameover">
          <sprite><text style="banner"><content>GAME OVER</content><size>80</size><color>color.red</color></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 60</centered></y></position>
        </object>
        <object name="again">
          <sprite><text style="prompt"><content>spacebar to go on</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center + 60</centered></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <!-- the other player plays on; with no one left, a new game -->
        <input button="space">
          <out />
          <reset />
        </input>
      </inputs>
      <conditions>
        <!-- above the fifth of the table: initials for it -->
        <condition object="ship" variable="score">
          <above>table.5.score</above>
          <copy variable="ship.score" into="entry.score" />
          <pop state="initial1" />
        </condition>
      </conditions>
    </state>
    <!-- whose turn it is, over their game, for two seconds -->
    <state name="player1">
      <objects>
        <object name="whose">
          <sprite><text style="banner"><content>PLAYER 1</content><size>80</size></text></sprite>
          <position><x><centered /></x><y><centered /></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input button="space"><pop /></input>
      </inputs>
      <timers>
        <timer><after>2</after><pop /></timer>
      </timers>
    </state>
    <state name="player2" from="player1">
      <objects>
        <object name="whose">
          <sprite><text style="banner"><content>PLAYER 2</content><size>80</size><color>color.cyan</color></text></sprite>
        </object>
      </objects>
    </state>
    <!-- the initials, a letter a state; the cursor shows which -->
    <state name="initial1">
      <objects>
        <object name="cursor">
          <sprite><rectangle><width>36</width><height>4</height><color>color.yellow</color></rectangle></sprite>
          <position><x>letters</x><y>375</y></position>
        </object>
      </objects>
      <shows>
        <show set="initials" />
      </shows>
      <inputs>
        <input button="w up"><inc variable="entry.first" /></input>
        <input button="s down"><dec variable="entry.first" /></input>
        <input button="space d right"><pop state="initial2" /></input>
      </inputs>
    </state>
    <state name="initial2" from="initial1">
      <objects>
        <object name="cursor"><position><x>letters + letterstep</x></position></object>
      </objects>
      <inputs>
        <input button="w up"><inc variable="entry.second" /></input>
        <input button="s down"><dec variable="entry.second" /></input>
        <input button="space d right"><pop state="initial3" /></input>
      </inputs>
    </state>
    <state name="initial3" from="initial1">
      <objects>
        <object name="cursor"><position><x>letters + letterstep * 2</x></position></object>
      </objects>
      <inputs>
        <input button="w up"><inc variable="entry.third" /></input>
        <input button="s down"><dec variable="entry.third" /></input>
        <!-- the entry into its place in the table, and a new game -->
        <input button="space d right">
          <rank variable="entry.score" into="table" />
          <out />
          <reset />
        </input>
      </inputs>
    </state>
  </states>
  <!-- the attract mode: a game played by itself, from the title after ten seconds -->
