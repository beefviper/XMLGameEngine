<!-- fourinarow.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Nov 1, 2026 -->

<!--
  Four in a Row: red and yellow take turns dropping a disc into one of
  seven columns, red first; the disc falls to the lowest free place. The
  first to have four in a line, across, down or on a slant, wins; a full
  board is a draw. You play red against the computer, or two players
  share the keyboard.

  A and D or the arrows move the disc above the board, Space (or S, or
  Down) drops it. The mouse works too: the disc follows it and a left
  click drops it. Pause pauses. On the title, Space plays the
  computer and 2 is for two players. Space plays again.

  How it is written:
  * The board is a <map> of seven by six <cells />, empty to begin with:
    red and yellow wait on it, to be put. <fall /> in their <moves> drops
    a disc put to the lowest free cell of its column.
  * The players are a group that takes <turns>, each <owns> its discs.
    The cursor is a disc on a map of its own, one row above the board, in
    the colour of the one on its turn. <put /> puts that player's disc
    down its column; a full column refuses it, so the turn passes (the
    <pass> after it) only when a disc is put.
  * The board's <checks> ask after each put: four red in a <line> make
    red the winner. A count of discs put finds a full board.
  * The computer plays yellow with <think>: it reads the lines from the
    checks, so it takes a win, blocks one, and builds towards its own.
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../xgedef.xsd">
  <window name="Four in a Row">
    <width>800</width>
    <height>600</height>
  </window>
  <variables>
    <variable name="square">64</variable>
    <variable name="left">176</variable>
    <variable name="top">150</variable>
  </variables>
  <styles>
    <style name="banner"><size>80</size><color>color.yellow</color></style>
    <style name="prompt"><size>32</size></style>
    <style name="help"><size>22</size><color>color.lightgrey</color></style>
    <style name="hud"><size>32</size></style>
  </styles>
  <states>
    <objects>
      <!-- how many play: 1 against the computer, 2 at one keyboard; discs put; 1 once a line is made -->
      <object name="match">
        <variables>
          <variable name="players">1</variable>
          <variable name="made">0</variable>
          <variable name="won">0</variable>
        </variables>
      </object>
      <object name="again">
        <sprite><text style="prompt"><content>spacebar to play again</content></text></sprite>
        <position><x><centered /></x><y><centered><offset>70</offset></centered></y></position>
      </object>
    </objects>
    <state name="title">
      <objects>
        <object name="title">
          <sprite><text style="banner"><content>FOUR IN A ROW</content></text></sprite>
          <position><x><centered /></x><y><centered><offset>-170</offset></centered></y></position>
        </object>
        <group name="help">
          <rows>3</rows>
          <padding><y>30</y></padding>
          <sprite><text style="help" /></sprite>
          <position><x><centered /></x><y><centered><offset>-90</offset></centered></y></position>
          <row number="1"><sprite><text><content>you play red, and go first; 2 for two players</content></text></sprite></row>
          <row number="2"><sprite><text><content>four in a line, across, down or on a slant, wins</content></text></sprite></row>
          <row number="3"><sprite><text><content>a d or the arrows move, spacebar or a click drops, pause key pauses</content></text></sprite></row>
        </group>
        <object name="start">
          <sprite><text style="prompt"><content>spacebar to start</content></text></sprite>
          <position><x><centered /></x><y><centered><offset>170</offset></centered></y></position>
        </object>
      </objects>
      <inputs>
        <input><button>space</button><button>pad1.start</button><set variable="match.players">1</set><push state="playing" /></input>
        <input><button>num2</button><button>numpad2</button><set variable="match.players">2</set><push state="playing" /></input>
      </inputs>
    </state>
    <state name="playing">
      <objects>
        <!-- the players, red first: each the words over the board on its turn, nothing off it -->
        <group name="players">
          <sprite name="moving"><rectangle><width>1</width><height>1</height><color>color.black</color></rectangle></sprite>
          <sprite name="waiting"><rectangle><width>1</width><height>1</height><color>color.black</color></rectangle></sprite>
          <position><x><centered /></x><y>24</y></position>
          <turns sprite="waiting" />
          <member name="reds">
            <sprite name="moving"><text style="hud"><content>red to move</content><color>color.red</color></text></sprite>
            <owns class="red" />
          </member>
          <member name="yellows">
            <sprite name="moving"><text style="hud"><content>yellow to move</content><color>color.yellow</color></text></sprite>
            <owns class="yellow" />
          </member>
        </group>
        <object name="frame">
          <sprite><rectangle><width>square * 7 + 16</width><height>square * 6 + 16</height><color>color.blue</color></rectangle></sprite>
          <position><x>left - 8</x><y>top - 8</y></position>
        </object>
        <!-- the holes, each a place a disc can be -->
        <group name="holes">
          <columns>7</columns>
          <rows>6</rows>
          <padding><x>square - 52</x><y>square - 52</y></padding>
          <sprite><circle><radius>26</radius><color>color.black</color></circle></sprite>
          <position><x>left + 6</x><y>top + 6</y></position>
        </group>

        <map name="board">
          <tile><width>square</width><height>square</height></tile>
          <position><x>left</x><y>top</y></position>
          <columns>7</columns>
          <rows>6</rows>
          <cells />
          <group name="red" class="red">
            <sprite><circle><radius>26</radius><color>color.red</color></circle></sprite>
            <moves><fall /></moves>
          </group>
          <group name="yellow" class="yellow">
            <sprite><circle><radius>26</radius><color>color.yellow</color></circle></sprite>
            <moves><fall /></moves>
          </group>
          <checks>
            <line class="red"><atleast>4</atleast><become object="over.winner" sprite="red" /><set variable="match.won">1</set></line>
            <line class="yellow"><atleast>4</atleast><become object="over.winner" sprite="yellow" /><set variable="match.won">1</set></line>
          </checks>
        </map>

        <!-- the last disc put, ringed -->
        <map name="marks">
          <tile><width>square</width><height>square</height></tile>
          <position><x>left</x><y>top</y></position>
          <columns>7</columns>
          <rows>6</rows>
          <cells />
          <object name="lastmark">
            <sprite><circle><radius>6</radius><color>color.white</color></circle></sprite>
          </object>
        </map>

        <!-- the disc to drop, on a row of its own above the board -->
        <map name="pointer">
          <tile><width>square</width><height>square</height></tile>
          <position><x>left</x><y>top - square - 8</y></position>
          <cells />
          <row>...c...</row>
          <object name="cursor" char="c">
            <sprite name="red"><circle><radius>26</radius><color>color.red</color></circle></sprite>
            <sprite name="yellow"><circle><radius>26</radius><color>color.yellow</color></circle></sprite>
            <marks>
              <last object="lastmark" />
            </marks>
            <actions>
              <action name="left"><hop direction="left" /></action>
              <action name="right"><hop direction="right" /></action>
              <action name="point"><track /></action>
              <!-- a disc of the player on its turn, and the next one's turn -->
              <action name="put">
                <put />
                <play sound="drop" />
                <inc variable="match.made" />
                <pass object="players" />
              </action>
            </actions>
          </object>
        </map>
      </objects>
      <inputs>
        <input><button>a</button><button>left</button><button>pad1.left</button><trigger object="cursor" action="left" /></input>
        <input><button>d</button><button>right</button><button>pad1.right</button><trigger object="cursor" action="right" /></input>
        <input>
          <button>space</button><button>s</button><button>down</button><button>pad1.a</button><button>mouse.left</button>
          <trigger object="cursor" action="put" />
        </input>
        <input axis="mouse.x"><trigger object="cursor" action="point" /></input>
        <input><button>pause</button><button>pad1.start</button><push state="paused" /></input>
      </inputs>
      <conditions>
        <condition object="match" variable="won">
          <equal>1</equal>
          <play sound="win" />
          <push state="over" />
        </condition>
        <!-- forty-two discs put and no line: a draw -->
        <condition object="match" variable="made">
          <atleast>42</atleast>
          <become object="over.winner" sprite="draw" />
          <push state="over" />
        </condition>
        <!-- the disc to drop is the colour of the player on its turn -->
        <condition object="reds" variable="turn"><equal>1</equal><become object="cursor" sprite="red" /></condition>
        <condition object="yellows" variable="turn"><equal>1</equal><become object="cursor" sprite="yellow" /></condition>
      </conditions>
      <!-- against the computer, yellow's move: six ahead -->
      <computer>
        <condition object="match" variable="players"><equal>1</equal>
          <condition object="yellows" variable="turn"><equal>1</equal>
            <think object="cursor" button="space">
              <depth>6</depth>
            </think>
          </condition>
        </condition>
      </computer>
    </state>
    <state name="paused">
      <objects>
        <object name="paused">
          <sprite><text style="banner"><content>PAUSED</content><color>color.white</color></text></sprite>
          <position><x><centered /></x><y><centered /></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input><button>pause</button><button>pad1.start</button><pop /></input>
      </inputs>
    </state>
    <state name="over">
      <objects>
        <object name="winner">
          <sprite name="red"><text style="banner"><content>RED WINS</content><color>color.red</color></text></sprite>
          <sprite name="yellow"><text style="banner"><content>YELLOW WINS</content></text></sprite>
          <sprite name="draw"><text style="banner"><content>A DRAW</content><color>color.white</color></text></sprite>
          <position><x><centered /></x><y><centered><offset>-40</offset></centered></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
        <show object="again" />
      </shows>
      <inputs>
        <input><button>space</button><button>pad1.start</button><reset /></input>
      </inputs>
    </state>
  </states>
  <sounds>
    <sound name="drop" wave="triangle"><note pitch="G3">0.04</note><note pitch="C3">0.06</note></sound>
    <sound name="win">
      <note pitch="C5">0.12</note>
      <note pitch="E5">0.12</note>
      <note pitch="G5">0.12</note>
      <note pitch="C6">0.4</note>
    </sound>
  </sounds>
</game>
