<!-- pong.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Sept 18, 2020 -->

<!--
  Pong, after Atari's 1972 arcade game: white on black, two paddles, a square
  ball and a dashed net, the scores in big digits at the top. The first to
  eleven wins.

  W and S move the left paddle, Up and Down the right one; Space starts,
  pauses and plays again.

  How it is written:
  * The paddles are one group: their size, the <stick /> at the top and the
    bottom, the moves and the score are said once, and each says where it is.
  * The ball <bounce>s off the top and the bottom and <deflect>s off a
    paddle, steeper the further from its middle, as the arcade's paddle of
    eight segments. It counts its hits, and the fourth and the twelfth make
    it faster, as the arcade's did. Off either side it gives the other player
    a point and is served again, its <random>s and its hits drawn anew.
  * The net is a group of one column and many rows.
  * Paused and game over draw the game still underneath (<show state>).
-->
<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../xge/xgedef.xsd">
  <window name="Pong">
    <width>1280</width>
    <height>720</height>
  </window>
  <variables>
    <variable name="margin">30</variable>
    <variable name="width">20</variable>
    <variable name="height">120</variable>
    <variable name="step">6</variable>
  </variables>
  <!-- the arcade's three tones: a paddle hit, the wall an octave lower, and a long one for a point -->
  <sounds>
    <sound name="paddle"><note pitch="459">0.1</note></sound>
    <sound name="wall"><note pitch="226">0.02</note></sound>
    <sound name="score"><note pitch="490">0.26</note></sound>
  </sounds>
  <styles>
    <style name="banner"><size>160</size></style>
    <style name="prompt"><size>48</size><color>color.lightgrey</color></style>
    <style name="hud"><size>128</size></style>
  </styles>
  <states>
    <state name="mainmenu">
      <objects>
        <object name="title">
          <sprite><text style="banner"><content>PONG</content></text></sprite>
          <!-- x is window.width.center - title.width / 2, written as a <formula>: one operation, its operands nested inside it -->
          <position>
            <x>
              <formula>
                <subtract>
                  <minuend>window.width.center</minuend>
                  <subtrahend><divide><dividend>title.width</dividend><divisor>2</divisor></divide></subtrahend>
                </subtract>
              </formula>
            </x>
            <y>margin * 4</y>
          </position>
        </object>
        <object name="start">
          <sprite><text style="prompt"><content>spacebar to serve, first to eleven</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center + 120</centered></y></position>
        </object>
      </objects>
      <inputs>
        <input button="space"><push state="playing" /></input>
      </inputs>
    </state>
    <state name="playing">
      <objects>
        <!-- the net: a dash in every other place down the middle -->
        <group name="net">
          <columns>1</columns>
          <rows>18</rows>
          <padding><y>20</y></padding>
          <sprite><rectangle><width>6</width><height>20</height><color>color.lightgrey</color></rectangle></sprite>
          <position><x><centered /></x><y>10</y></position>
        </group>
        <group name="paddles" class="paddle">
          <sprite><rectangle><width>width</width><height>height</height></rectangle></sprite>
          <collisions>
            <collision edge="vertical"><stick /></collision>
          </collisions>
          <actions>
            <action name="up"><move direction="up">step</move></action>
            <action name="down"><move direction="down">step</move></action>
          </actions>
          <variables>
            <variable name="score">0</variable>
          </variables>
          <member name="paddle1"><position><x>margin</x><y><centered /></y></position></member>
          <member name="paddle2"><position><x>window.right - margin - width</x><y><centered /></y></position></member>
        </group>
        <object name="score1">
          <sprite><text style="hud"><number>paddle1.score</number></text></sprite>
          <position><x>window.width.center - 80 - score1.width</x><y>margin</y></position>
        </object>
        <object name="score2">
          <sprite><text style="hud"><number>paddle2.score</number></text></sprite>
          <position><x>window.width.center + 80</x><y>margin</y></position>
        </object>
        <!-- served from the middle at ball.speed, within 30 degrees of straight left or right, to either side -->
        <object name="ball">
          <sprite><rectangle><width>ball.size</width><height>ball.size</height></rectangle></sprite>
          <position><x><centered /></x><y><centered /></y></position>
          <velocity>
            <x>sgn(ball.side) * ball.speed * cos(ball.angle * pi / 180)</x>
            <y>ball.speed * sin(ball.angle * pi / 180)</y>
          </velocity>
          <collisions>
            <collision edge="vertical">
              <bounce />
              <play sound="wall" />
            </collision>
            <collision edge="left">
              <inc variable="paddle2.score" />
              <play sound="score" />
              <reset object="ball" />
            </collision>
            <collision edge="right">
              <inc variable="paddle1.score" />
              <play sound="score" />
              <reset object="ball" />
            </collision>
            <collision class="paddle">
              <deflect>45</deflect>
              <inc variable="ball.hits" />
              <play sound="paddle" />
            </collision>
            <collision class="paddle">
              <any>
                <condition variable="hits"><equal>4</equal></condition>
                <condition variable="hits"><equal>12</equal></condition>
              </any>
              <set variable="ball.velocity.x">ball.velocity.x * 1.3</set>
              <set variable="ball.velocity.y">ball.velocity.y * 1.3</set>
            </collision>
          </collisions>
          <variables>
            <variable name="size">16</variable>
            <variable name="speed">6</variable>
            <variable name="hits">0</variable>
            <variable name="angle"><random><min>-30</min><max>30</max></random></variable>
            <variable name="side"><random><min>-1</min><max>1</max></random></variable>
          </variables>
        </object>
      </objects>
      <inputs>
        <input button="w"><trigger object="paddle1" action="up" /></input>
        <input button="s"><trigger object="paddle1" action="down" /></input>
        <input button="up"><trigger object="paddle2" action="up" /></input>
        <input button="down"><trigger object="paddle2" action="down" /></input>
        <input button="space"><push state="paused" /></input>
      </inputs>
      <conditions>
        <condition class="paddle" variable="score">
          <atleast>11</atleast>
          <push state="gameover" />
        </condition>
      </conditions>
    </state>
    <state name="paused">
      <objects>
        <object name="paused">
          <sprite><text style="banner"><content>PAUSED</content></text></sprite>
          <position><x><centered /></x><y><centered /></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input button="space"><pop /></input>
      </inputs>
    </state>
    <state name="gameover">
      <objects>
        <object name="gameover">
          <sprite><text style="banner"><content>GAME OVER</content></text></sprite>
          <position><x><centered /></x><y><centered /></y></position>
        </object>
        <object name="continue">
          <sprite><text style="prompt"><content>spacebar to play again</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center + 120</centered></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input button="space"><reset /></input>
      </inputs>
    </state>
  </states>
</game>
