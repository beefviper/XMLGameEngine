<!-- spacerace.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Sept 30, 2026 -->

<!--
  Space Race, after Atari's 1973 arcade game: two rockets start at the
  bottom and fly up through rows of debris drifting sideways. A hit sends a
  rocket back to the bottom; getting off the top scores a point and sends it
  back for another go. The clock is the bar down the middle, sinking out of
  sight; when it is gone, the most points win.

  Player 1 is W and S, player 2 the up and down arrows; Space starts,
  pauses (or P) and plays again.

  How it is written:
  * The rockets are one group: the picture, the moves, the rules (a point
    at the top, <inc>'d as self.score, and back to the start when hit) are
    said once, and each says where it starts.
  * The debris is one group of twelve rows: each row's speed is said once
    for the rows that share it, and every piece <wrap />s round at the
    sides, eight to a row spaced a window width plus their own apart.
  * The clock is a bar with a <velocity>: it sinks a window's height in a
    minute, and a condition on its y ends the race.
  * One win screen: the winner's words are a look for each player and one
    for a draw, picked by the win screen's own conditions.
  * Paused and the win screen draw the race still underneath (<show state>).
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../xgedef.xsd">
  <window name="Space Race">
    <width>800</width>
    <height>600</height>
  </window>
  <variables>
    <variable name="step">2.5</variable>
    <variable name="margin">10</variable>
    <variable name="seconds">60</variable>
  </variables>
  <sounds>
    <sound name="score" wave="triangle">
      <volume>0.4</volume>
      <note pitch="E4" to="E5">0.3</note>
    </sound>
    <sound name="crash" wave="noise">
      <volume>0.4</volume>
      <note pitch="2500" to="200">0.35</note>
    </sound>
    <sound name="end">
      <volume>0.2</volume>
      <note pitch="C5">0.1</note>
      <note pitch="E5">0.1</note>
      <note pitch="G5">0.1</note>
      <note pitch="C6">0.3</note>
    </sound>
  </sounds>
  <styles>
    <style name="banner"><size>110</size></style>
    <style name="prompt"><size>40</size></style>
    <style name="hud"><size>56</size></style>
  </styles>
  <states>
    <state name="mainmenu">
      <objects>
        <object name="title">
          <sprite><text style="banner"><content>SPACE RACE</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 80</centered></y></position>
        </object>
        <object name="help">
          <sprite><text style="prompt"><content>w s and up down, the most crossings in a minute</content><size>24</size><color>color.lightgrey</color></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center + 10</centered></y></position>
        </object>
        <object name="start">
          <sprite><text style="prompt"><content>spacebar to start</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center + 90</centered></y></position>
        </object>
      </objects>
      <inputs>
        <input button="space"><push state="playing" /></input>
      </inputs>
    </state>
    <state name="playing">
      <objects>
        <!-- the clock: a bar down the middle that sinks out of sight in a minute -->
        <object name="clock">
          <sprite><rectangle><width>4</width><height>window.bottom</height></rectangle></sprite>
          <position><x><centered /></x><y>0</y></position>
          <velocity><y>window.bottom / (seconds * 60)</y></velocity>
        </object>
        <group name="debris" class="debris">
          <columns>8</columns>
          <rows>12</rows>
          <padding><x>(window.right + 8) / 8 - 8</x><y>28</y></padding>
          <sprite><rectangle><width>8</width><height>4</height></rectangle></sprite>
          <position><x>0</x><y>50</y></position>
          <collisions>
            <collision edge="horizontal"><wrap /></collision>
          </collisions>
          <row number="1 5 9"><velocity><x>1.5</x></velocity></row>
          <row number="2 6 10"><velocity><x>-2.5</x></velocity></row>
          <row number="3 7 11"><velocity><x>2</x></velocity></row>
          <row number="4 8 12"><velocity><x>-1</x></velocity></row>
        </group>
        <group name="rockets" class="rocket">
          <sprite>
            <bitmap>
              <row>..*..</row>
              <row>..*..</row>
              <row>.***.</row>
              <row>.***.</row>
              <row>.***.</row>
              <row>*****</row>
              <row>*.*.*</row>
              <scale>3</scale>
            </bitmap>
          </sprite>
          <collisions>
            <type>pixel</type>
            <collision edge="bottom"><stick /></collision>
            <collision edge="top">
              <inc variable="self.score" />
              <play sound="score" />
              <reset />
            </collision>
            <collision class="debris">
              <play sound="crash" />
              <reset />
            </collision>
          </collisions>
          <actions>
            <action name="up"><move direction="up">step</move></action>
            <action name="down"><move direction="down">step</move></action>
          </actions>
          <variables>
            <variable name="score">0</variable>
          </variables>
          <member name="rocket1"><position><x><centered>window.right / 4</centered></x><y>window.bottom - 21 - margin</y></position></member>
          <member name="rocket2"><position><x><centered>window.right * 3 / 4</centered></x><y>window.bottom - 21 - margin</y></position></member>
        </group>
        <object name="score1">
          <sprite><text style="hud"><number>rocket1.score</number></text></sprite>
          <position><x>window.right / 4 - 60 - score1.width</x><y>window.bottom - score1.height - margin</y></position>
        </object>
        <object name="score2">
          <sprite><text style="hud"><number>rocket2.score</number></text></sprite>
          <position><x>window.right * 3 / 4 + 60</x><y>window.bottom - score2.height - margin</y></position>
        </object>
      </objects>
      <inputs>
        <input button="w"><trigger object="rocket1" action="up" /></input>
        <input button="s"><trigger object="rocket1" action="down" /></input>
        <input button="up"><trigger object="rocket2" action="up" /></input>
        <input button="down"><trigger object="rocket2" action="down" /></input>
        <input button="space p"><push state="paused" /></input>
      </inputs>
      <conditions>
        <condition object="clock" variable="y">
          <atleast>window.bottom</atleast>
          <push state="wins" />
          <play sound="end" />
        </condition>
      </conditions>
    </state>
    <state name="paused">
      <objects>
        <object name="paused">
          <sprite><text style="banner"><content>PAUSED</content></text></sprite>
          <position><x><centered /></x><y><centered /></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input button="space p"><pop /></input>
      </inputs>
    </state>
    <state name="wins">
      <objects>
        <object name="winner">
          <sprite name="draw"><text style="banner"><content>A DRAW</content><size>80</size></text></sprite>
          <sprite name="player1"><text style="banner"><content>PLAYER 1 WINS</content><size>80</size></text></sprite>
          <sprite name="player2"><text style="banner"><content>PLAYER 2 WINS</content><size>80</size></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 60</centered></y></position>
        </object>
        <object name="continue">
          <sprite><text style="prompt"><content>spacebar to play again</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center + 50</centered></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input button="space"><reset /></input>
      </inputs>
      <conditions>
        <condition object="rocket1" variable="score">
          <above object="rocket2" variable="score" />
          <become object="winner" sprite="player1" />
        </condition>
        <condition object="rocket2" variable="score">
          <above object="rocket1" variable="score" />
          <become object="winner" sprite="player2" />
        </condition>
      </conditions>
    </state>
  </states>
</game>
