<!-- frogger.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Sept 30, 2026 -->

<!--
  Frogger, after Konami's 1981 arcade game, on a grid of 48 pixel cells, 13
  across and 14 down:

    row  0        the score, the time and the lives
    row  1        home: five bays between hedges
    rows 2-6      the river: logs, and turtles, some of which dive
    row  7        the grassy bank
    rows 8-12     the road: a truck lane, a racing car, bulldozers and cars
    row  13       the pavement where the frog starts

  The frog hops one cell for each press of W A S D or the arrows. It is lost,
  and the next one starts at the bottom, when it is run over, falls in the
  river (not on a log or a turtle, or on a turtle that has dived), is ridden
  off the side, hops into a hedge or a bay already filled, or runs out of
  time. A frog home is 50 points, and fills its bay; five home is a win.
  Space starts and pauses, as do P and Escape.

  How it is written:
  * Every lane of the river and the road is a group inside one group that
    gives the <wrap />. A lane says its row, its speed and its picture; its
    logs or cars are laid out as <columns>, evenly round the loop.
  * The diving turtles have two looks and a <timer> on each: up for a while,
    then under, then up again. A turtle that is under drowns a frog on it,
    by its own rule (sprite="under"); the frog's water rule only asks
    whether it is on a log or a turtle (unless="logs").
  * The hedge is one strip along the home row; the frog's rule for it is
    passed over while it is also on a bay (unless="pads").
  * A bay has two looks, empty and home. Its rules, the filled one first,
    run the frog's own actions: home, or lose.
  * The time is a variable of the clock that a state <timer> counts down;
    every new frog puts the clock back (<reset object="clock" />).
  * Paused, game over and the win draw the board still underneath
    (<show state>).
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../xgedef.xsd">
  <window name="Frogger">
    <width>624</width>
    <height>672</height>
  </window>
  <variables>
    <variable name="cell">48</variable>
    <variable name="time">40</variable>
  </variables>
  <sounds>
    <sound name="hop" wave="square">
      <volume>0.15</volume>
      <note pitch="C5" to="G5">0.05</note>
    </sound>
    <sound name="squash" wave="noise">
      <volume>0.4</volume>
      <note pitch="1200" to="150">0.3</note>
    </sound>
    <sound name="splash" wave="noise">
      <volume>0.4</volume>
      <note pitch="5000" to="300">0.5</note>
    </sound>
    <sound name="home" wave="square">
      <volume>0.2</volume>
      <note pitch="C6">0.05</note>
      <note pitch="E6">0.05</note>
      <note pitch="G6">0.1</note>
    </sound>
    <!-- the start: a few bars of the tune, over a bass -->
    <sound name="start">
      <volume>0.15</volume>
      <part wave="square">
        <note pitch="G5">0.12</note>
        <note pitch="G5">0.12</note>
        <note pitch="E5">0.12</note>
        <note pitch="G5">0.12</note>
        <note pitch="C6">0.24</note>
        <note pitch="A5">0.12</note>
        <note pitch="G5">0.24</note>
      </part>
      <part wave="triangle">
        <note pitch="C3">0.24</note>
        <note pitch="G3">0.24</note>
        <note pitch="C3">0.24</note>
        <note pitch="G3">0.36</note>
      </part>
    </sound>
    <sound name="win" wave="square">
      <volume>0.2</volume>
      <note pitch="C5">0.1</note>
      <note pitch="E5">0.1</note>
      <note pitch="G5">0.1</note>
      <note pitch="C6">0.1</note>
      <note pitch="G5">0.1</note>
      <note pitch="C6">0.3</note>
    </sound>
    <sound name="gameover" wave="triangle">
      <volume>0.4</volume>
      <note pitch="G4">0.25</note>
      <note pitch="E4">0.25</note>
      <note pitch="C4" to="C3">0.7</note>
    </sound>
  </sounds>
  <styles>
    <style name="banner"><size>96</size><color>color.green</color></style>
    <style name="prompt"><size>32</size></style>
    <style name="hud"><size>30</size></style>
  </styles>
  <states>
    <state name="mainmenu">
      <objects>
        <object name="title">
          <sprite><text style="banner"><content>FROGGER</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 60</centered></y></position>
        </object>
        <object name="start">
          <sprite><text style="prompt"><content>spacebar to start</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center + 40</centered></y></position>
        </object>
      </objects>
      <inputs>
        <input button="space">
          <push state="playing" />
          <play sound="start" />
        </input>
      </inputs>
    </state>
    <state name="playing">
      <objects>
        <!-- scenery: the river, the bank, the road and the pavement -->
        <object name="water" class="water">
          <sprite><rectangle><width>window.right</width><height>5 * cell</height><color>color.darkblue</color></rectangle></sprite>
          <position><x>0</x><y>2 * cell</y></position>
          <collisions />
        </object>
        <object name="bank">
          <sprite><rectangle><width>window.right</width><height>cell</height><color>color.purple</color></rectangle></sprite>
          <position><x>0</x><y>7 * cell</y></position>
        </object>
        <object name="pavement">
          <sprite><rectangle><width>window.right</width><height>cell</height><color>color.purple</color></rectangle></sprite>
          <position><x>0</x><y>13 * cell</y></position>
        </object>

        <!-- home: five bays in a hedge -->
        <object name="hedge" class="hazard">
          <sprite><rectangle><width>window.right</width><height>cell</height><color>color.forestgreen</color></rectangle></sprite>
          <position><x>0</x><y>1 * cell</y></position>
          <collisions />
        </object>
        <group name="pads" class="pads">
          <columns>5</columns>
          <rows>1</rows>
          <padding><x>2 * cell - 40</x></padding>
          <sprite name="empty"><rectangle><width>40</width><height>40</height><color>color.darkblue</color></rectangle></sprite>
          <sprite name="home">
            <bitmap>
              <row>.y......y.</row>
              <row>yyy....yyy</row>
              <row>.yy****yy.</row>
              <row>..******..</row>
              <row>.********.</row>
              <row>.***yy***.</row>
              <row>yy******yy</row>
              <row>.y......y.</row>
              <scale>4</scale>
              <color>color.green</color>
              <color char="y">color.yellow</color>
            </bitmap>
          </sprite>
          <position><x>2 * cell + 4</x><y>1 * cell + 4</y></position>
          <collisions>
            <collision object="frog" sprite="home"><trigger object="frog" action="lose" /></collision>
            <collision object="frog" sprite="empty">
              <become sprite="home" />
              <trigger object="frog" action="home" />
            </collision>
          </collisions>
        </group>

        <!-- every lane of the river and the road wraps round at the sides -->
        <group name="lanes">
          <rows>1</rows>
          <collisions>
            <collision edge="horizontal"><wrap /></collision>
          </collisions>

          <!-- the river: logs, and turtles -->
          <group name="river" class="logs">
            <group name="logs">
              <sprite>
                <bitmap>
                  <row>.****************************.</row>
                  <row>******************************</row>
                  <row>**oo*******oo*********oo******</row>
                  <row>*******oo********oo*******oo**</row>
                  <row>******************************</row>
                  <row>.****************************.</row>
                  <scale>6</scale>
                  <color>color.brown</color>
                  <color char="o">color.orange</color>
                </bitmap>
              </sprite>
              <group name="logrow2">
                <columns>3</columns>
                <padding><x>(window.right + 180) / 3 - 180</x></padding>
                <position><x>20</x><y>2 * cell + 6</y></position>
                <velocity><x>1.4</x></velocity>
              </group>
              <group name="logrow4">
                <columns>2</columns>
                <padding><x>(window.right + 228) / 2 - 228</x></padding>
                <sprite><bitmap><row>.************************************.</row><row>**************************************</row><row>**oo*******oo*********oo*******oo*****</row><row>*******oo********oo*******oo*******oo*</row><row>**************************************</row><row>.************************************.</row></bitmap></sprite>
                <position><x>100</x><y>4 * cell + 6</y></position>
                <velocity><x>2</x></velocity>
              </group>
              <group name="logrow5">
                <columns>3</columns>
                <padding><x>(window.right + 132) / 3 - 132</x></padding>
                <sprite><bitmap><row>.********************.</row><row>**********************</row><row>**oo*******oo*********</row><row>*******oo********oo***</row><row>**********************</row><row>.********************.</row></bitmap></sprite>
                <position><x>0</x><y>5 * cell + 6</y></position>
                <velocity><x>1</x></velocity>
              </group>
            </group>
            <group name="turtlerow3">
              <columns>4</columns>
              <padding><x>(window.right + 80) / 4 - 80</x></padding>
              <sprite name="up">
                <bitmap>
                  <row>....**........**....</row>
                  <row>.gg****gg..gg****gg.</row>
                  <row>..******....******..</row>
                  <row>.********..********.</row>
                  <row>.********..********.</row>
                  <row>..******....******..</row>
                  <row>.gg****gg..gg****gg.</row>
                  <row>....**........**....</row>
                  <scale>4</scale>
                  <color>color.red</color>
                  <color char="g">color.green</color>
                </bitmap>
              </sprite>
              <sprite name="under">
                <bitmap>
                  <row>....................</row>
                  <row>....................</row>
                  <row>..******....******..</row>
                  <row>.*......*..*......*.</row>
                  <row>.*......*..*......*.</row>
                  <row>..******....******..</row>
                  <row>....................</row>
                  <row>....................</row>
                  <scale>4</scale>
                  <color>color.blue</color>
                </bitmap>
              </sprite>
              <position><x>60</x><y>3 * cell + 8</y></position>
              <velocity><x>-1.6</x></velocity>
              <collisions>
                <collision object="frog" sprite="under"><trigger object="frog" action="drown" /></collision>
              </collisions>
              <timers>
                <timer sprite="up"><after>3.5</after><become sprite="under" /></timer>
                <timer sprite="under"><after>1.5</after><become sprite="up" /></timer>
              </timers>
            </group>
            <group name="turtlerow6">
              <columns>3</columns>
              <padding><x>(window.right + 120) / 3 - 120</x></padding>
              <sprite>
                <bitmap>
                  <row>....**........**........**....</row>
                  <row>.gg****gg..gg****gg..gg****gg.</row>
                  <row>..******....******....******..</row>
                  <row>.********..********..********.</row>
                  <row>.********..********..********.</row>
                  <row>..******....******....******..</row>
                  <row>.gg****gg..gg****gg..gg****gg.</row>
                  <row>....**........**........**....</row>
                  <scale>4</scale>
                  <color>color.red</color>
                  <color char="g">color.green</color>
                </bitmap>
              </sprite>
              <position><x>30</x><y>6 * cell + 8</y></position>
              <velocity><x>-1.2</x></velocity>
            </group>
          </group>

          <!-- the road: a car is 40 wide, the trucks 88 -->
          <group name="traffic" class="hazard">
            <sprite>
              <bitmap>
                <row>..kk..kk..</row>
                <row>**********</row>
                <row>**ww***ww*</row>
                <row>**********</row>
                <row>**********</row>
                <row>**ww***ww*</row>
                <row>**********</row>
                <row>..kk..kk..</row>
                <scale>4</scale>
                <color char="k">color.black</color>
                <color char="w">color.white</color>
              </bitmap>
            </sprite>
            <group name="truckrow8">
              <columns>2</columns>
              <padding><x>(window.right + 88) / 2 - 88</x></padding>
              <sprite>
                <bitmap>
                  <row>.kk..kk..........kk..kk.</row>
                  <row>****.***************....</row>
                  <row>*ww*.***************....</row>
                  <row>****.***************....</row>
                  <row>****.***************....</row>
                  <row>*ww*.***************....</row>
                  <row>****.***************....</row>
                  <row>.kk..kk..........kk..kk.</row>
                  <color>color.white</color>
                </bitmap>
              </sprite>
              <position><x>100</x><y>8 * cell + 8</y></position>
              <velocity><x>-1.3</x></velocity>
            </group>
            <!-- the white racing car, fast -->
            <group name="carrow9">
              <columns>2</columns>
              <padding><x>(window.right + 40) / 2 - 40</x></padding>
              <sprite><bitmap><color>color.lightgrey</color></bitmap></sprite>
              <position><x>60</x><y>9 * cell + 8</y></position>
              <velocity><x>3.2</x></velocity>
            </group>
            <group name="carrow10">
              <columns>4</columns>
              <padding><x>(window.right + 40) / 4 - 40</x></padding>
              <sprite><bitmap><color>color.magenta</color></bitmap></sprite>
              <position><x>40</x><y>10 * cell + 8</y></position>
              <velocity><x>-1.6</x></velocity>
            </group>
            <!-- bulldozers -->
            <group name="carrow11">
              <columns>3</columns>
              <padding><x>(window.right + 40) / 3 - 40</x></padding>
              <sprite><bitmap><color>color.green</color></bitmap></sprite>
              <position><x>100</x><y>11 * cell + 8</y></position>
              <velocity><x>1.2</x></velocity>
            </group>
            <group name="carrow12">
              <columns>3</columns>
              <padding><x>(window.right + 40) / 3 - 40</x></padding>
              <sprite><bitmap><color>color.yellow</color></bitmap></sprite>
              <position><x>30</x><y>12 * cell + 8</y></position>
              <velocity><x>-1</x></velocity>
            </group>
          </group>
        </group>

        <!-- the frog. Lives count down from 3; homes is how many are in. -->
        <object name="frog" class="frog">
          <sprite>
            <bitmap>
              <row>.y......y.</row>
              <row>yyy....yyy</row>
              <row>.yy****yy.</row>
              <row>..*k**k*..</row>
              <row>.********.</row>
              <row>.***yy***.</row>
              <row>yy******yy</row>
              <row>.y......y.</row>
              <scale>4</scale>
              <color>color.green</color>
              <color char="y">color.yellow</color>
              <color char="k">color.black</color>
            </bitmap>
          </sprite>
          <position><x>6 * cell + 4</x><y>13 * cell + 8</y></position>
          <collisions>
            <collision class="hazard" unless="pads"><trigger action="lose" /></collision>
            <collision class="water" unless="logs"><trigger action="drown" /></collision>
            <collision class="logs"><ride /></collision>
            <collision edge="horizontal"><trigger action="lose" /></collision>
          </collisions>
          <actions>
            <action name="lose">
              <dec variable="frog.lives" />
              <reset />
              <reset object="clock" />
              <play sound="squash" />
            </action>
            <action name="drown">
              <dec variable="frog.lives" />
              <reset />
              <reset object="clock" />
              <play sound="splash" />
            </action>
            <action name="home">
              <inc variable="frog.homes" />
              <inc variable="frog.score">50 + 10 * clock.time</inc>
              <reset />
              <reset object="clock" />
              <play sound="home" />
            </action>
            <action name="up">
              <hop direction="up">cell</hop>
              <play sound="hop" />
            </action>
            <action name="down">
              <hop direction="down">cell</hop>
              <play sound="hop" />
            </action>
            <action name="left">
              <hop direction="left">cell</hop>
              <play sound="hop" />
            </action>
            <action name="right">
              <hop direction="right">cell</hop>
              <play sound="hop" />
            </action>
          </actions>
          <variables>
            <variable name="lives">3</variable>
            <variable name="homes">0</variable>
            <variable name="score">0</variable>
          </variables>
        </object>

        <!-- the time each frog has, counted down by the state's timer -->
        <object name="clock">
          <sprite><text style="hud"><content>TIME</content><number>clock.time</number><color>color.yellow</color></text></sprite>
          <position><x><centered /></x><y><centered>cell / 2</centered></y></position>
          <variables>
            <variable name="time">time</variable>
          </variables>
        </object>
        <object name="score">
          <sprite><text style="hud"><content>SCORE</content><number>frog.score</number></text></sprite>
          <position><x>12</x><y><centered>cell / 2</centered></y></position>
        </object>
        <object name="lives">
          <sprite><text style="hud"><content>LIVES</content><number>frog.lives</number><color>color.green</color></text></sprite>
          <position><x>window.right - 12 - lives.width</x><y><centered>cell / 2</centered></y></position>
        </object>
      </objects>
      <inputs>
        <input button="w up"><trigger object="frog" action="up" /></input>
        <input button="s down"><trigger object="frog" action="down" /></input>
        <input button="a left"><trigger object="frog" action="left" /></input>
        <input button="d right"><trigger object="frog" action="right" /></input>
        <input button="space p escape"><push state="paused" /></input>
      </inputs>
      <conditions>
        <condition object="frog" variable="lives">
          <atmost>0</atmost>
          <push state="gameover" />
          <play sound="gameover" />
        </condition>
        <condition object="frog" variable="homes">
          <atleast>5</atleast>
          <push state="youwin" />
          <play sound="win" />
        </condition>
        <condition object="clock" variable="time">
          <atmost>0</atmost>
          <trigger object="frog" action="lose" />
        </condition>
      </conditions>
      <timers>
        <timer>
          <every>1</every>
          <dec variable="clock.time" />
        </timer>
      </timers>
    </state>
    <state name="paused">
      <objects>
        <object name="paused">
          <sprite><text style="banner"><content>PAUSED</content><color>color.white</color></text></sprite>
          <position><x><centered /></x><y><centered /></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input button="space p escape"><pop /></input>
      </inputs>
    </state>
    <state name="gameover">
      <objects>
        <object name="message">
          <sprite><text style="banner"><content>GAME OVER</content><size>80</size><color>color.red</color></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 60</centered></y></position>
        </object>
        <object name="continue">
          <sprite><text style="prompt"><content>spacebar to continue</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center + 40</centered></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input button="space"><reset /></input>
      </inputs>
    </state>
    <state name="youwin" from="gameover">
      <objects>
        <object name="message">
          <sprite><text style="banner"><content>YOU WIN</content></text></sprite>
        </object>
      </objects>
    </state>
  </states>
</game>
