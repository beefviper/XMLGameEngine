<!-- gin.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Nov 5, 2026 -->

<!--
  Gin rummy: you against the computer (north), one pack of 52 cards, the
  ace low.

  Each player is dealt ten cards; one is turned up to start the discard
  pile, and the rest are the stock. On your turn, draw one card, the top
  of the stock or of the discard pile, then discard one. The aim is to
  lay your cards out in melds: sets (three or four of a rank) and runs
  (three or more in a row of one suit, the ace below the two). The cards
  in no meld are your deadwood, counted by their pips, the court cards
  ten. When your deadwood is ten or less after your discard, you may
  knock: the hand ends, and you score the difference between the two
  deadwoods. Knocking with none at all is gin: 25 more. But if the other
  player's deadwood is no more than yours, they undercut you and score the
  difference and 25. With two cards left in the stock the hand is void.
  The first to 100 wins. Who goes first takes turns.

  A and D or the arrows move along your cards, W and S between your cards
  and the piles. Space draws from the pile pointed at, then discards the
  card pointed at; K discards it and knocks. Your cards are laid out
  melds first, deadwood last. Or click. Pause pauses.

  How it is written:
  * The pack is a group, a row for each suit (spades, hearts, clubs,
    diamonds) and a column for each rank; a card is worth its column (the
    ace 1), the court cards 10.
  * The game's <patterns name="rummy">: a set is <alike variable="rank">3,
    a run <run variable="rank">3 and <alike variable="suit">3.
  * Each player's cards are a holder with <score patterns="rummy"><melds />:
    laid out in groups that each make a pattern with all their cards, the
    groups chosen to leave the fewest points over; its live number
    `deadwood`, those points (each card's worth), counted from its best
    ten (<best>10): holding eleven, what is left after the best discard.
  * The cards start in the stock; each hand, the first too, every card is
    <send> back, put in <order> at <random />, <distribute>d ten to each
    player's own holder, and one sent to the discard pile.
  * Picked, the stock and the discard pile send their top card to the
    player's own (<picked><send>); the discard pile <accepts /> anything.
    A player drawing is holding eleven, which turns the look to discard.
  * The players are a group that takes turns: you, then north, each a
    member that <owns> its cards; a turn is a draw (the look `draw`) and a
    discard (`discard`), then <pass />. Who goes first takes turns
    (<pass member="table.first" />).
  * North's <think> on cards with melds draws the discard when it leaves
    less deadwood, else from the stock, and lets go of the card that
    leaves the least. It knocks as soon as it can: its `discarded`, and
    conditions.
  * Where the hand is, is the table's look: dealing, drawing,
    discarding, done; each look's rules sit inside one condition on it.
    `knocking`: 1 your knock, 3 a knock that holds.
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../xgedef.xsd">
  <window name="Gin Rummy">
    <width>880</width>
    <height>840</height>
    <background>color.darkgreen</background>
  </window>
  <variables>
    <variable name="cardwidth">96</variable>
    <variable name="cardheight">140</variable>
    <variable name="theirs">40</variable>
    <variable name="middle">300</variable>
    <variable name="yours">640</variable>
  </variables>
  <styles>
    <style name="banner"><size>80</size><color>color.yellow</color></style>
    <style name="prompt"><size>32</size></style>
    <style name="help"><size>22</size><color>color.lightgrey</color></style>
    <style name="note"><size>24</size><color>color.white</color></style>
  </styles>
  <!-- what melds: a set of three or four of a rank, a run of three or more of a suit -->
  <patterns name="rummy">
    <pattern name="set"><alike variable="rank">3</alike></pattern>
    <pattern name="run"><run variable="rank">3</run><alike variable="suit">3</alike></pattern>
  </patterns>
  <states>
    <state name="title">
      <objects>
        <object name="title">
          <sprite><text style="banner"><content>GIN RUMMY</content></text></sprite>
          <position><x><centered /></x><y><centered><offset>-190</offset></centered></y></position>
        </object>
        <group name="help">
          <rows>4</rows>
          <padding><y>30</y></padding>
          <sprite><text style="help" /></sprite>
          <position><x><centered /></x><y><centered><offset>-90</offset></centered></y></position>
          <row number="1"><sprite><text><content>draw a card, then discard one. meld sets of a rank and runs of a suit;</content></text></sprite></row>
          <row number="2"><sprite><text><content>the rest is deadwood. at ten or less, knock: score the difference.</content></text></sprite></row>
          <row number="3"><sprite><text><content>gin, no deadwood, scores 25 more; an undercut gives them 25. 100 wins.</content></text></sprite></row>
          <row number="4"><sprite><text><content>a d along your cards, w s to the piles, spacebar draws and discards, k knocks</content></text></sprite></row>
        </group>
        <object name="start">
          <sprite><text style="prompt"><content>spacebar to deal</content></text></sprite>
          <position><x><centered /></x><y><centered><offset>170</offset></centered></y></position>
        </object>
      </objects>
      <inputs>
        <input><button>space</button><button>pad1.start</button><push state="playing" /></input>
      </inputs>
    </state>
    <state name="playing">
      <objects>
        <!-- the pack: a row for each suit (spades, hearts, clubs, diamonds), a column for each rank, the ace low; the court cards worth 10 -->
        <group name="cards" class="card">
          <columns name="rank">13</columns>
          <rows name="suit">4</rows>
          <sprite name="face"><cell sheet="cards"><scale>0.5</scale></cell></sprite>
          <sprite name="back"><cell sheet="cards"><column>1</column><row>5</row><scale>0.5</scale></cell></sprite>
          <position><x>0</x><y>0</y></position>
          <column><number>11</number><number>12</number><number>13</number><variables><variable name="worth">10</variable></variables></column>
        </group>

        <!-- the stock and the discard pile: picked, each sends its top card to the player's own -->
        <object name="stock" class="place">
          <sprite><rectangle><width>cardwidth</width><height>cardheight</height><color>color.forestgreen</color></rectangle></sprite>
          <position><x>
            <subtract>
              <value>window.width.center</value>
              <value>cardwidth</value>
              <value>24</value>
            </subtract>
          </x><y>middle</y></position>
          <holds class="card" sprite="back"><picked><send>1</send></picked></holds>
        </object>
        <object name="discard" class="place">
          <sprite><rectangle><width>cardwidth</width><height>cardheight</height><color>color.forestgreen</color></rectangle></sprite>
          <position><x><add><value>window.width.center</value><value>24</value></add></x><y>middle</y></position>
          <holds class="card" sprite="face"><accepts /><picked><send>1</send></picked></holds>
        </object>

        <!-- north's cards, face down, and yours: laid out in melds, the deadwood counted -->
        <object name="northcards" class="place">
          <position><x><subtract><value>window.width.center</value><value>168</value></subtract></x><y>theirs</y></position>
          <holds class="card" sprite="back"><spread><x>24</x></spread><score patterns="rummy"><melds /><best>10</best></score></holds>
        </object>
        <object name="mine" class="place">
          <position><x>56</x><y>yours</y></position>
          <holds class="card" sprite="face"><spread><x>64</x><width>768</width></spread><lift>16</lift><score patterns="rummy"><melds /><best>10</best></score></holds>
        </object>

        <!-- the scores, whose turn it is, and your deadwood -->
        <object name="northscore">
          <sprite><text style="note"><content>north</content><number>north.score</number><choose><by>north.turn</by><word /><word>to play</word></choose></text></sprite>
          <position><x><centered /></x><y><add><value>theirs</value><value>cardheight</value><value>8</value></add></y></position>
        </object>
        <object name="yourscore">
          <sprite><text style="note"><content>you</content><number>you.score</number><choose><by>you.turn</by><word /><word>your turn: draw, then discard; k knocks</word></choose><color>color.yellow</color></text></sprite>
          <position><x>56</x><y><subtract><value>yours</value><value>52</value></subtract></y></position>
        </object>
        <object name="deadwood">
          <sprite><text style="note"><content>deadwood</content><number>mine.deadwood</number></text></sprite>
          <position><x><subtract><value>window.width</value><value>210</value></subtract></x><y><subtract><value>yours</value><value>52</value></subtract></y></position>
        </object>

        <!-- how a hand ended -->
        <object name="message">
          <sprite name="none" />
          <sprite name="yougin"><text style="note"><content>gin! the hand is yours: spacebar deals</content><color>color.cyan</color></text></sprite>
          <sprite name="youknock"><text style="note"><content>you knock and win the hand: spacebar deals</content><color>color.yellow</color></text></sprite>
          <sprite name="youcut"><text style="note"><content>north undercuts your knock: spacebar deals</content></text></sprite>
          <sprite name="northgin"><text style="note"><content>north goes gin: spacebar deals</content></text></sprite>
          <sprite name="northknock"><text style="note"><content>north knocks and wins the hand: spacebar deals</content></text></sprite>
          <sprite name="northcut"><text style="note"><content>you undercut north's knock: spacebar deals</content><color>color.yellow</color></text></sprite>
          <sprite name="void"><text style="note"><content>the stock is out: no score. spacebar deals</content></text></sprite>
          <sprite name="dealing"><text style="note"><content>shuffling</content><color>color.lightgrey</color></text></sprite>
          <position><x><centered /></x><y><add><value>middle</value><value>cardheight</value><value>30</value></add></y></position>
        </object>

        <!-- the table: where the hand is (its look), who goes first, who knocks; between hands, Space deals -->
        <object name="table">
          <sprite name="dealing" />
          <sprite name="drawing" />
          <sprite name="discarding" />
          <sprite name="done" />
          <actions>
            <action name="shuffle">
              <become sprite="dealing" />
              <become object="dealer" sprite="shuffling" />
              <play sound="shuffle" />
            </action>
            <action name="deal">
              <send from="cards" into="stock"><all /></send>
              <order group="stock"><random /></order>
              <distribute from="stock" into="players">10</distribute>
              <send from="stock" into="discard">1</send>
              <become sprite="drawing" />
              <pass object="players" member="table.first" />
              <set variable="table.first"><subtract><value>3</value><value>table.first</value></subtract></set>
              <play sound="deal" />
            </action>
          </actions>
          <variables>
            <variable name="first">1</variable>
            <variable name="knocking">0</variable>
          </variables>
        </object>

        <!-- the dealer: a moment to shuffle before the cards come, the first hand too -->
        <object name="dealer">
          <sprite name="shuffling" />
          <sprite name="idle" />
          <timers>
            <timer sprite="shuffling"><every>0.4</every><become sprite="idle" /><trigger object="table" action="deal" /></timer>
          </timers>
        </object>

        <!-- the players, in turn: you, then the computer (north), who draws what melds and knocks when it can; each a frame around the card it points at (north's unseen) -->
        <group name="players" class="player">
          <sprite name="draw"><drawing from="playersdraw" /></sprite>
          <sprite name="discard"><drawing from="playersdiscard" /></sprite>
          <sprite name="waiting" />
          <actions>
            <action name="left"><hop direction="left" /></action>
            <action name="right"><hop direction="right" /></action>
            <action name="up"><hop direction="up" /></action>
            <action name="down"><hop direction="down" /></action>
            <action name="point"><track /></action>
            <!-- the pile pointed at sends its top to its cards (an own card picked up goes back: "back" below) -->
            <action name="draw"><pick class="card" /></action>
            <!-- holding eleven: back to them, to discard -->
            <action name="drawn">
              <play sound="deal" />
              <become object="table" sprite="discarding" />
              <become sprite="discard" />
              <hop direction="down" />
            </action>
            <!-- the card pointed at onto the discard pile, and the other's turn -->
            <action name="play">
              <pick class="card" />
              <place into="discard" />
              <play sound="card" />
              <set variable="players.discarded">1</set>
              <become object="table" sprite="drawing" />
              <pass />
            </action>
            <action name="back"><drop /></action>
            <!-- the same, and a knock: it holds if the deadwood left is ten or less -->
            <action name="knock">
              <pick class="card" />
              <place into="discard" />
              <play sound="knock" />
              <set variable="table.knocking">1</set>
              <become object="table" sprite="drawing" />
              <pass />
            </action>
          </actions>
          <variables>
            <variable name="score">0</variable>
            <variable name="discarded">0</variable>
          </variables>
          <turns sprite="waiting" />
          <member name="you"><position><x>53</x><y><subtract><value>yours</value><value>3</value></subtract></y></position><owns object="mine" /></member>
          <member name="north">
            <sprite name="draw" />
            <sprite name="discard" />
            <position><x>0</x><y>0</y></position>
            <owns object="northcards" />
            <think button="space" />
          </member>
        </group>
      </objects>
      <!-- the cards start in the stock (the table deals them) -->
      <starts>
        <send from="cards" into="stock"><all /></send>
      </starts>
      <inputs>
        <input><button>a</button><button>left</button><button>pad1.left</button><trigger object="players" action="left" /></input>
        <input><button>d</button><button>right</button><button>pad1.right</button><trigger object="players" action="right" /></input>
        <input><button>w</button><button>up</button><button>pad1.up</button><trigger object="players" action="up" /></input>
        <input><button>s</button><button>down</button><button>pad1.down</button><trigger object="players" action="down" /></input>
        <!-- a discard, or if it may not go, back; a draw (an own card picked up goes back) -->
        <input>
          <button>space</button><button>pad1.a</button><button>mouse.left</button>
          <trigger object="players" action="play" from="discard">
            <otherwise><trigger object="players" action="back" /></otherwise>
          </trigger>
          <trigger object="players" action="draw" from="draw" />
          <trigger object="players" action="back" from="draw" />
          <trigger object="table" action="shuffle" from="done" />
        </input>
        <input>
          <button>k</button><button>pad1.b</button>
          <trigger object="players" action="knock" from="discard">
            <otherwise><trigger object="players" action="back" /></otherwise>
          </trigger>
        </input>
        <input axis="mouse.x"><trigger object="players" action="point" /></input>
        <input axis="mouse.y"><trigger object="players" action="point" /></input>
        <input><button>pause</button><button>pad1.start</button><push state="paused" /></input>
      </inputs>
      <conditions>
        <!-- your discard to knock: with ten or less left, the hand is over (gin, an undercut, or the difference); else it was only a discard -->
        <condition object="table" variable="knocking"><equal>1</equal>
          <condition object="mine" variable="deadwood"><atmost>10</atmost>
            <first><set variable="table.knocking">3</set></first>
            <condition object="mine" variable="deadwood"><equal>0</equal>
              <inc variable="you.score"><add><value>25</value><value>northcards.deadwood</value></add></inc>
              <become object="message" sprite="yougin" />
              <play sound="win" />
            </condition>
            <condition object="northcards" variable="deadwood"><atmost>mine.deadwood</atmost>
              <inc variable="north.score">
                <subtract>
                  <value><add><value>25</value><value>mine.deadwood</value></add></value>
                  <value>northcards.deadwood</value>
                </subtract>
              </inc>
              <become object="message" sprite="youcut" />
              <play sound="lose" />
            </condition>
            <otherwise>
              <inc variable="you.score"><subtract><value>northcards.deadwood</value><value>mine.deadwood</value></subtract></inc>
              <become object="message" sprite="youknock" />
              <play sound="win" />
            </otherwise>
          </condition>
          <otherwise>
            <set variable="table.knocking">0</set>
          </otherwise>
        </condition>

        <!-- north knocks whenever its discard leaves it ten or less -->
        <condition object="north" variable="discarded"><equal>1</equal>
          <first><set variable="north.discarded">0</set></first>
          <condition object="northcards" variable="deadwood"><equal>0</equal>
            <inc variable="north.score"><add><value>25</value><value>mine.deadwood</value></add></inc>
            <become object="message" sprite="northgin" />
            <play sound="lose" />
            <set variable="table.knocking">3</set>
          </condition>
          <condition object="northcards" variable="deadwood"><atmost>10</atmost>
            <first><set variable="table.knocking">3</set></first>
            <condition object="mine" variable="deadwood"><atmost>northcards.deadwood</atmost>
              <inc variable="you.score">
                <subtract>
                  <value><add><value>25</value><value>northcards.deadwood</value></add></value>
                  <value>mine.deadwood</value>
                </subtract>
              </inc>
              <become object="message" sprite="northcut" />
              <play sound="win" />
            </condition>
            <otherwise>
              <inc variable="north.score"><subtract><value>mine.deadwood</value><value>northcards.deadwood</value></subtract></inc>
              <become object="message" sprite="northknock" />
              <play sound="lose" />
            </otherwise>
          </condition>
        </condition>

        <!-- after a knock that holds: north's cards shown, the hand over, nobody's turn -->
        <condition object="table" variable="knocking"><equal>3</equal>
          <become object="northcards" sprite="face" />
          <set variable="table.knocking">0</set>
          <become object="table" sprite="done" />
          <pass object="players" member="0" />
        </condition>

        <!-- the hand over and a score of 100: the higher wins -->
        <condition object="table" sprite="done">
          <condition class="player" variable="score" total="highest"><atleast>100</atleast>
            <condition class="player" variable="score"><highest />
              <become object="over.winner" sprite="self" />
              <push state="over" />
            </condition>
          </condition>
        </condition>

        <!-- a draw: made when the player holds eleven; with two cards left in the stock the hand is void -->
        <condition object="table" sprite="drawing">
          <condition object="mine" variable="cards"><equal>11</equal><trigger object="players" action="drawn" /></condition>
          <condition object="northcards" variable="cards"><equal>11</equal><trigger object="players" action="drawn" /></condition>
          <condition object="stock" variable="cards"><atmost>2</atmost>
            <become object="northcards" sprite="face" />
            <become object="message" sprite="void" />
            <become object="table" sprite="done" />
            <pass object="players" member="0" />
          </condition>
          <otherwise>
            <become object="message" sprite="none" />
          </otherwise>
        </condition>

        <condition object="table" sprite="dealing"><become object="message" sprite="dealing" /></condition>
      </conditions>
    </state>
    <state name="paused">
      <objects>
        <object name="paused">
          <sprite><text style="banner"><content>PAUSED</content><color>color.white</color></text></sprite>
          <position><x><centered /></x><y><centered><offset>-40</offset></centered></y></position>
        </object>
        <object name="newgame">
          <sprite><text style="prompt"><content>n for a new game</content></text></sprite>
          <position><x><centered /></x><y><centered><offset>40</offset></centered></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input><button>pause</button><button>pad1.start</button><pop /></input>
        <input><button>n</button><reset /></input>
      </inputs>
    </state>
    <state name="over">
      <objects>
        <object name="winner">
          <sprite name="you"><text style="banner"><content>YOU WIN</content></text></sprite>
          <sprite name="north"><text style="banner"><content>NORTH WINS</content></text></sprite>
          <position><x><centered /></x><y><centered><offset>-40</offset></centered></y></position>
        </object>
        <object name="again">
          <sprite><text style="prompt"><content>spacebar to play again</content></text></sprite>
          <position><x><centered /></x><y><centered><offset>40</offset></centered></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input><button>space</button><button>pad1.start</button><reset /></input>
      </inputs>
    </state>
  </states>
  <sounds>
    <sound name="card" wave="noise"><note pitch="C6">0.03</note></sound>
    <sound name="deal" wave="noise"><note pitch="G5">0.02</note><note pitch="C6">0.02</note></sound>
    <sound name="shuffle" wave="noise"><note pitch="C6">0.02</note><rest>0.02</rest><note pitch="D6">0.02</note><rest>0.02</rest><note pitch="C6">0.02</note><rest>0.02</rest><note pitch="D6">0.02</note></sound>
    <sound name="knock"><note pitch="C4">0.06</note><rest>0.06</rest><note pitch="C4">0.06</note></sound>
    <sound name="win">
      <note pitch="C5">0.12</note>
      <note pitch="E5">0.12</note>
      <note pitch="G5">0.12</note>
      <note pitch="C6">0.4</note>
    </sound>
    <sound name="lose">
      <note pitch="G4">0.15</note>
      <note pitch="E4">0.15</note>
      <note pitch="C4">0.4</note>
    </sound>
  </sounds>
  <!-- the card sheet: a row for each suit, a column for each rank, then a row of backs -->
  <pictures>
    <sheet name="cards"><path>assets/cards.png</path><columns>13</columns><rows>5</rows></sheet>
    <drawing name="playersdraw">
      <line><from><x>1</x><y>1</y></from><to><x><add><value>cardwidth</value><value>5</value></add></x><y>1</y></to><color>color.yellow</color><thickness>3</thickness></line>
      <line><from><x><add><value>cardwidth</value><value>5</value></add></x><y>1</y></from><to><x><add><value>cardwidth</value><value>5</value></add></x><y><add><value>cardheight</value><value>5</value></add></y></to><color>color.yellow</color><thickness>3</thickness></line>
      <line><from><x><add><value>cardwidth</value><value>5</value></add></x><y><add><value>cardheight</value><value>5</value></add></y></from><to><x>1</x><y><add><value>cardheight</value><value>5</value></add></y></to><color>color.yellow</color><thickness>3</thickness></line>
      <line><from><x>1</x><y><add><value>cardheight</value><value>5</value></add></y></from><to><x>1</x><y>1</y></to><color>color.yellow</color><thickness>3</thickness></line>
    </drawing>
    <drawing name="playersdiscard">
      <line><from><x>1</x><y>1</y></from><to><x><add><value>cardwidth</value><value>5</value></add></x><y>1</y></to><color>color.yellow</color><thickness>3</thickness></line>
      <line><from><x><add><value>cardwidth</value><value>5</value></add></x><y>1</y></from><to><x><add><value>cardwidth</value><value>5</value></add></x><y><add><value>cardheight</value><value>5</value></add></y></to><color>color.yellow</color><thickness>3</thickness></line>
      <line><from><x><add><value>cardwidth</value><value>5</value></add></x><y><add><value>cardheight</value><value>5</value></add></y></from><to><x>1</x><y><add><value>cardheight</value><value>5</value></add></y></to><color>color.yellow</color><thickness>3</thickness></line>
      <line><from><x>1</x><y><add><value>cardheight</value><value>5</value></add></y></from><to><x>1</x><y>1</y></to><color>color.yellow</color><thickness>3</thickness></line>
    </drawing>
  </pictures>
</game>
