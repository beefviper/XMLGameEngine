<!-- holdem.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Nov 2, 2026 -->

<!--
  Texas hold'em, fixed limit, you against the computer: 500 chips each.

  Each hand both put in 5 chips, and each player is dealt two cards of
  their own (the computer's face down). Five shared cards follow, face up
  in the middle: three (the flop), then one (the turn), then one more (the
  river). Before the flop and after each of those there is a round of
  betting: check (bet nothing) while nothing is owed, bet or raise (10
  chips in the first two rounds, 20 in the last two, at most three raises
  a round), call (match what is owed), or fold (give up the pot). When
  both are square, the next cards come. After the river the best five
  cards of each player's seven win the pot: a straight flush, then four of
  a kind, a full house, a flush, a straight, three of a kind, two pair, a
  pair, and the highest cards. A player short of chips may call with all
  they have; the rest of the cards then come without betting. Whoever runs
  out of chips loses the match. Who acts first changes every hand.

  W or Up bets or raises, Space checks or calls, X or Backspace folds.
  Space after a hand deals the next. Pause pauses.

  How it is written:
  * The pack is a group, a row for each suit (spades, hearts, clubs,
    diamonds) and a column for each rank; a card is worth its column
    (jack 11, queen 12, king 13), the ace 1 and its `high` 14, so it plays
    high, and low in A 2 3 4 5.
  * Poker's hands are a <patterns> set of the game: <alike variable="rank">
    cards of a rank, a <run variable="worth"> of worths in a row, <alike
    variable="suit"> cards of one suit. Your cards and the computer's are
    holders that <score> by them, <with> the
    board's five, the <best> five: live numbers `pattern` (which hand,
    0 the highest cards to 8 a straight flush), `strength` (compared at
    the showdown) and `odds` (how often they beat two unseen cards, in
    percent).
  * Where the hand is, is the look of `hand` (dealing, betting,
    showdown, done), and the street the look of `street` (preflop, flop,
    turn, river); each look's rules sit inside one condition on it. The
    betting is the table's variables (pot, owed, raises, acted) and
    conditions.
  * You and the computer are a players group that takes <turns>: the
    actions are written once, on the group, by self; each passes the
    turn, and a new street gives it to whoever acts first with
    <pass member="table.first">. Your keys trigger you, the computer's
    (F9 to F12) trigger it, each only on its turn. The computer's play
    is four <computer> conditions on its odds against the price of a
    call.
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../xgedef.xsd">
  <window name="Texas Hold'em">
    <width>880</width>
    <height>840</height>
    <background>color.darkgreen</background>
  </window>
  <variables>
    <variable name="cardwidth">96</variable>
    <variable name="cardheight">140</variable>
    <variable name="theirrow">70</variable>
    <variable name="boardrow">320</variable>
    <variable name="yourrow">570</variable>
  </variables>
  <styles>
    <style name="banner"><size>80</size><color>color.yellow</color></style>
    <style name="prompt"><size>32</size></style>
    <style name="help"><size>22</size><color>color.lightgrey</color></style>
    <style name="note"><size>26</size><color>color.white</color></style>
    <style name="result"><size>40</size><color>color.yellow</color></style>
  </styles>
  <!-- poker's hands, the lowest first; none of them: the highest cards -->
  <patterns name="poker">
    <pattern name="pair"><alike variable="rank">2</alike></pattern>
    <pattern name="twopair"><alike variable="rank">2</alike><alike variable="rank">2</alike></pattern>
    <pattern name="three"><alike variable="rank">3</alike></pattern>
    <pattern name="straight"><run variable="worth">5</run></pattern>
    <pattern name="flush"><alike variable="suit">5</alike></pattern>
    <pattern name="fullhouse"><alike variable="rank">3</alike><alike variable="rank">2</alike></pattern>
    <pattern name="four"><alike variable="rank">4</alike></pattern>
    <pattern name="straightflush"><run variable="worth">5</run><alike variable="suit">5</alike></pattern>
  </patterns>
  <states>
    <state name="title">
      <objects>
        <object name="title">
          <sprite><text style="banner"><content>TEXAS HOLD'EM</content></text></sprite>
          <position><x><centered /></x><y><centered><offset>-170</offset></centered></y></position>
        </object>
        <group name="help">
          <rows>3</rows>
          <padding><y>30</y></padding>
          <sprite><text style="help" /></sprite>
          <position><x><centered /></x><y><centered><offset>-90</offset></centered></y></position>
          <row number="1"><sprite><text><content>two cards of your own and five shared: the best five win the pot.</content></text></sprite></row>
          <row number="2"><sprite><text><content>bets of 10, then 20 after the turn card; three raises a round at most</content></text></sprite></row>
          <row number="3"><sprite><text><content>w or up bets or raises, spacebar checks or calls, x folds</content></text></sprite><padding><y>40</y></padding></row>
        </group>
        <object name="start">
          <sprite><text style="prompt"><content>spacebar to start</content></text></sprite>
          <position><x><centered /></x><y><centered><offset>170</offset></centered></y></position>
        </object>
      </objects>
      <inputs>
        <input><button>space</button><button>pad1.start</button><push state="playing" /></input>
      </inputs>
    </state>
    <state name="playing">
      <objects>
        <!-- the pack: a row for each suit (spades, hearts, clubs, diamonds), a column for each rank; the ace counts high too -->
        <group name="cards" class="card">
          <columns>13</columns>
          <rows>4</rows>
          <sprite name="face"><cell sheet="cards"><scale>0.5</scale></cell></sprite>
          <sprite name="back"><cell sheet="cards"><column>1</column><row>5</row><scale>0.5</scale></cell></sprite>
          <position><x>0</x><y>0</y></position>
          <column><number>1</number><variables><variable name="high">14</variable></variables></column>
        </group>

        <object name="stock" class="place">
          <sprite name="spot"><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite>
          <position><x>40</x><y>boardrow</y></position>
          <holds class="card" sprite="back" />
        </object>

        <!-- the computer's two cards, yours, and the five shared: each player's scored with the shared -->
        <object name="theirs" class="place">
          <sprite name="spot"><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite>
          <position><x>window.width.center - cardwidth - 4</x><y>theirrow</y></position>
          <holds class="card" sprite="face"><spread><x>cardwidth + 8</x></spread><score patterns="poker"><with object="board"><full>5</full></with><best>5</best></score></holds>
        </object>
        <object name="board" class="place">
          <sprite><rectangle><width>cardwidth * 5 + 64</width><height>cardheight + 16</height><color>color.forestgreen</color></rectangle></sprite>
          <position><x>window.width.center - cardwidth * 2.5 - 32</x><y>boardrow - 8</y></position>
          <holds class="card" sprite="face"><spread><x>cardwidth + 16</x></spread></holds>
        </object>
        <object name="yours" class="place">
          <sprite name="spot"><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite>
          <position><x>window.width.center - cardwidth - 4</x><y>yourrow</y></position>
          <holds class="card" sprite="face"><spread><x>cardwidth + 8</x></spread><score patterns="poker"><with object="board"><full>5</full></with><best>5</best></score></holds>
        </object>

        <!-- the table: the pot, what the player to act owes, the raises and actions this round, the round (0 before
             the flop, 1 the flop, 2 the turn, 3 the river, 4 the showdown, 5 between hands, 6 shuffling), the bet, and who acts first this hand -->
        <object name="table">
          <sprite><text style="note"><content>pot </content><number>table.pot</number></text></sprite>
          <position><x><centered /></x><y>boardrow - 50</y></position>
          <actions>
            <action name="deal">
              <set variable="table.first">3 - table.first</set>
              <pass object="players" member="table.first" />
              <dec variable="you.chips">5</dec>
              <dec variable="cpu.chips">5</dec>
              <set variable="table.pot">10</set>
              <send from="stock" into="yours">1</send>
              <send from="stock" into="theirs" sprite="back">1</send>
              <send from="stock" into="yours">1</send>
              <send from="stock" into="theirs" sprite="back">1</send>
              <become object="hand" sprite="betting" />
              <become object="street" sprite="preflop" />
              <set variable="table.owed">0</set>
              <set variable="table.acted">0</set>
              <set variable="table.raises">0</set>
              <set variable="table.bet">10</set>
              <become object="result" sprite="none" />
              <play sound="deal" />
            </action>
            <action name="flop">
              <send from="stock" into="board">3</send>
              <become object="street" sprite="flop" />
              <set variable="table.acted">0</set>
              <set variable="table.raises">0</set>
              <pass object="players" member="table.first" />
              <play sound="deal" />
            </action>
            <action name="turn">
              <send from="stock" into="board">1</send>
              <become object="street" sprite="turn" />
              <set variable="table.bet">20</set>
              <set variable="table.acted">0</set>
              <set variable="table.raises">0</set>
              <pass object="players" member="table.first" />
              <play sound="deal" />
            </action>
            <action name="river">
              <send from="stock" into="board">1</send>
              <become object="street" sprite="river" />
              <set variable="table.acted">0</set>
              <set variable="table.raises">0</set>
              <pass object="players" member="table.first" />
              <play sound="deal" />
            </action>
            <action name="showdown">
              <become object="theirs" sprite="face" />
              <become object="hand" sprite="showdown" />
            </action>
          </actions>
          <variables>
            <variable name="pot">0</variable>
            <variable name="owed">0</variable>
            <variable name="raises">0</variable>
            <variable name="acted">0</variable>
            <variable name="bet">10</variable>
            <variable name="first">2</variable>
          </variables>
        </object>

        <object name="tocall">
          <sprite><text style="help"><content>to call </content><number>table.owed</number><content>    bet </content><number>table.bet</number></text></sprite>
          <position><x><centered /></x><y>boardrow + cardheight + 24</y></position>
        </object>

        <!-- where the hand is (dealing, betting, showdown, done), and the street the betting is on; Space when it is done deals the next -->
        <object name="hand">
          <sprite name="done"><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite>
          <sprite name="dealing"><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite>
          <sprite name="betting"><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite>
          <sprite name="showdown"><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite>
          <position><x>0</x><y>0</y></position>
          <hidden />
          <actions>
            <action name="next">
              <send from="cards" into="stock"><all /></send>
              <order group="stock"><random /></order>
              <become object="result" sprite="none" />
              <become object="dealer" sprite="shuffling" />
              <become object="you" sprite="wait" />
              <become sprite="dealing" />
              <play sound="shuffle" />
            </action>
          </actions>
        </object>
        <object name="street">
          <sprite name="preflop"><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite>
          <sprite name="flop"><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite>
          <sprite name="turn"><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite>
          <sprite name="river"><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite>
          <position><x>0</x><y>0</y></position>
          <hidden />
        </object>

        <!-- the dealer: a moment to shuffle before the cards come -->
        <object name="dealer">
          <sprite name="idle"><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite>
          <sprite name="shuffling"><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite>
          <position><x>0</x><y>0</y></position>
          <hidden />
          <timers>
            <timer sprite="shuffling"><every>0.4</every><become sprite="idle" /><trigger object="table" action="deal" /></timer>
          </timers>
        </object>

        <!-- the players, taking turns: you (what to do now) and the computer (it acts on F9 to F12 once
             ready); off its turn each waits. The actions are each one's own, by self, and pass the turn. -->
        <group name="players">
          <position><x>0</x><y>0</y></position>
          <actions>
            <action name="call">
              <condition object="cpu" variable="turn"><equal>1</equal><become object="cpusays" sprite="call" /></condition>
              <dec variable="self.chips">table.owed</dec>
              <inc variable="table.pot">table.owed</inc>
              <set variable="table.owed">0</set>
              <inc variable="table.acted">1</inc>
              <set variable="self.ready">0</set>
              <become object="thought" sprite="idle" />
              <play sound="chip" />
              <pass />
            </action>
            <action name="raise">
              <condition object="cpu" variable="turn"><equal>1</equal><become object="cpusays" sprite="raise" /></condition>
              <dec variable="self.chips">table.owed + table.bet</dec>
              <inc variable="table.pot">table.owed + table.bet</inc>
              <set variable="table.owed">table.bet</set>
              <inc variable="table.raises">1</inc>
              <inc variable="table.acted">1</inc>
              <set variable="self.ready">0</set>
              <become object="thought" sprite="idle" />
              <play sound="raise" />
              <pass />
            </action>
            <!-- short: all it has; what it cannot match goes back to the other -->
            <action name="allin">
              <condition object="you" variable="turn"><equal>1</equal><inc variable="cpu.chips">table.owed - you.chips</inc></condition>
              <condition object="cpu" variable="turn"><equal>1</equal><inc variable="you.chips">table.owed - cpu.chips</inc><become object="cpusays" sprite="call" /></condition>
              <dec variable="table.pot">table.owed - self.chips</dec>
              <inc variable="table.pot">self.chips</inc>
              <set variable="self.chips">0</set>
              <set variable="table.owed">0</set>
              <inc variable="table.acted">1</inc>
              <set variable="self.ready">0</set>
              <become object="thought" sprite="idle" />
              <play sound="chip" />
              <pass />
            </action>
            <!-- the pot to the other -->
            <action name="fold">
              <condition object="you" variable="turn"><equal>1</equal><inc variable="cpu.chips">table.pot</inc><become object="result" sprite="youfold" /></condition>
              <condition object="cpu" variable="turn"><equal>1</equal><inc variable="you.chips">table.pot</inc><become object="result" sprite="cpufolds" /><become object="cpusays" sprite="fold" /></condition>
              <set variable="table.pot">0</set>
              <set variable="self.ready">0</set>
              <become object="thought" sprite="idle" />
              <become object="hand" sprite="done" />
              <play sound="fold" />
            </action>
          </actions>
          <variables>
            <variable name="chips">500</variable>
            <variable name="ready">0</variable>
          </variables>
          <turns sprite="wait" />
          <member name="you">
            <sprite name="wait"><text style="note"><content>the computer is thinking</content><color>color.lightgrey</color></text></sprite>
            <sprite name="done"><text style="note"><content>spacebar deals the next hand</content></text></sprite>
            <sprite name="act"><text style="note"><content>w bet or raise, spacebar check or call, x fold</content></text></sprite>
            <sprite name="callonly"><text style="note"><content>spacebar check or call, x fold</content></text></sprite>
            <sprite name="allin"><text style="note"><content>spacebar calls with all your chips, x folds</content></text></sprite>
            <position><x><centered /></x><y>yourrow + cardheight + 70</y></position>
          </member>
          <member name="cpu">
            <sprite name="playing"><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite>
            <sprite name="wait"><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite>
          </member>
        </group>
        <!-- the computer's moment of thought before it is ready -->
        <object name="thought">
          <sprite name="idle"><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite>
          <sprite name="thinking"><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite>
          <position><x>0</x><y>0</y></position>
          <hidden />
          <timers>
            <timer sprite="thinking"><every>0.9</every><set variable="cpu.ready">1</set></timer>
          </timers>
        </object>

        <!-- what the computer did last -->
        <object name="cpusays">
          <sprite name="none"><text style="help"><content>.</content><color>color.darkgreen</color></text></sprite>
          <sprite name="call"><text style="help"><content>the computer checks or calls</content></text></sprite>
          <sprite name="raise"><text style="help"><content>the computer bets</content><color>color.yellow</color></text></sprite>
          <sprite name="fold"><text style="help"><content>the computer folds</content></text></sprite>
          <position><x><centered /></x><y>theirrow + cardheight + 24</y></position>
        </object>

        <object name="cpuchips">
          <sprite><text style="note"><content>computer: </content><number>cpu.chips</number><content> chips</content></text></sprite>
          <position><x><centered /></x><y>theirrow - 44</y></position>
        </object>
        <object name="yourchips">
          <sprite>
            <text style="note">
              <content>you: </content><number>you.chips</number><content> chips, </content>
              <choose>
                <by>yours.pattern</by>
                <word>high card</word><word>a pair</word><word>two pair</word><word>three of a kind</word><word>a straight</word>
                <word>a flush</word><word>a full house</word><word>four of a kind</word><word>a straight flush</word>
              </choose>
            </text>
          </sprite>
          <position><x><centered /></x><y>yourrow - 44</y></position>
        </object>

        <object name="result">
          <sprite name="none"><text style="result"><content>.</content><color>color.darkgreen</color></text></sprite>
          <sprite name="youwin"><text style="result"><content>you win the pot</content></text></sprite>
          <sprite name="cpuwins"><text style="result"><content>the computer wins the pot</content><color>color.lightgrey</color></text></sprite>
          <sprite name="split"><text style="result"><content>a split pot</content><color>color.white</color></text></sprite>
          <sprite name="youfold"><text style="result"><content>you fold</content><color>color.lightgrey</color></text></sprite>
          <sprite name="cpufolds"><text style="result"><content>the computer folds</content></text></sprite>
          <position><x><centered /></x><y>yourrow + cardheight + 30</y></position>
        </object>
      </objects>
      <!-- the cards start in the stock, shuffled -->
      <starts>
        <send from="cards" into="stock"><all /></send>
        <order group="stock"><random /></order>
      </starts>
      <inputs>
        <input><button>w</button><button>up</button><button>pad1.up</button><trigger object="you" action="raise" from="act" /></input>
        <input>
          <button>space</button><button>pad1.a</button>
          <trigger object="you" action="call" from="act" />
          <trigger object="you" action="call" from="callonly" />
          <trigger object="you" action="allin" from="allin" />
          <trigger object="hand" action="next" from="done" />
        </input>
        <input>
          <button>x</button><button>backspace</button><button>pad1.b</button>
          <trigger object="you" action="fold" from="act" />
          <trigger object="you" action="fold" from="callonly" />
          <trigger object="you" action="fold" from="allin" />
        </input>
        <!-- the computer's keys -->
        <input><button>f9</button><trigger object="cpu" action="allin" /></input>
        <input><button>f10</button><trigger object="cpu" action="fold" /></input>
        <input><button>f11</button><trigger object="cpu" action="call" /></input>
        <input><button>f12</button><trigger object="cpu" action="raise" /></input>
        <input><button>pause</button><button>pad1.start</button><push state="paused" /></input>
      </inputs>
      <conditions>
        <!-- out of chips between hands: the match is over -->
        <condition object="hand" sprite="done">
          <condition object="you" variable="chips"><below>5</below><become object="over.winner" sprite="computer" /><play sound="lose" /><push state="over" /></condition>
          <condition object="cpu" variable="chips"><below>5</below><become object="over.winner" sprite="you" /><play sound="win" /><push state="over" /></condition>
          <otherwise>
            <become object="you" sprite="done" />
          </otherwise>
        </condition>

        <!-- the showdown: the stronger best five takes the pot, the same split it -->
        <condition object="hand" sprite="showdown">
          <first><become object="hand" sprite="done" /></first>
          <condition object="yours" variable="strength"><above>theirs.strength</above>
            <inc variable="you.chips">table.pot</inc>
            <set variable="table.pot">0</set>
            <become object="result" sprite="youwin" />
            <play sound="win" />
          </condition>
          <condition object="yours" variable="strength"><below>theirs.strength</below>
            <inc variable="cpu.chips">table.pot</inc>
            <set variable="table.pot">0</set>
            <become object="result" sprite="cpuwins" />
            <play sound="lose" />
          </condition>
          <otherwise>
            <inc variable="you.chips">table.pot / 2</inc>
            <inc variable="cpu.chips">table.pot / 2</inc>
            <set variable="table.pot">0</set>
            <become object="result" sprite="split" />
            <play sound="chip" />
          </otherwise>
        </condition>

        <condition object="hand" sprite="betting">
          <!-- a round of betting over (both acted and square, or one all in): the next cards -->
          <condition object="table" variable="owed"><equal>0</equal>
            <condition>
              <any><condition object="table" variable="acted"><atleast>2</atleast></condition><condition object="you" variable="chips"><equal>0</equal></condition><condition object="cpu" variable="chips"><equal>0</equal></condition></any>
              <condition object="street" sprite="preflop"><trigger object="table" action="flop" /></condition>
              <condition object="street" sprite="flop"><trigger object="table" action="turn" /></condition>
              <condition object="street" sprite="turn"><trigger object="table" action="river" /></condition>
              <otherwise>
                <trigger object="table" action="showdown" />
              </otherwise>
            </condition>
          </condition>
            <!-- the computer's turn: it thinks a moment -->
          <condition object="cpu" variable="turn"><equal>1</equal>
            <become object="thought" sprite="thinking" from="idle" />
          </condition>
          <!-- your turn: what you can do -->
          <condition object="you" variable="turn"><equal>1</equal>
          <condition object="table" variable="raises"><below>3</below>
            <condition object="you" variable="chips"><atleast>table.owed + table.bet</atleast>
              <become object="you" sprite="act" />
            </condition>
          </condition>
          <condition object="you" variable="chips"><atleast>table.owed</atleast><become object="you" sprite="callonly" /></condition>
            <otherwise>
              <become object="you" sprite="allin" />
            </otherwise>
          </condition>
        </condition>
      </conditions>
      <!-- the computer, on its turn after a moment's thought: raise with good odds, call when the odds beat the price, else fold -->
      <computer>
        <condition object="hand" sprite="betting">
          <condition object="cpu" variable="turn"><equal>1</equal>
            <condition object="cpu" variable="ready"><equal>1</equal>
              <condition object="theirs" variable="odds"><atleast>65</atleast>
                <condition object="table" variable="raises"><below>3</below>
                  <condition object="cpu" variable="chips"><atleast>table.owed + table.bet</atleast>
                    <hold button="f12" />
                  </condition>
                </condition>
              </condition>
              <condition object="cpu" variable="chips"><atleast>table.owed</atleast>
                <condition>
                  <any><condition object="theirs" variable="odds"><below>65</below></condition><condition object="table" variable="raises"><atleast>3</atleast></condition><condition object="cpu" variable="chips"><below>table.owed + table.bet</below></condition></any>
                  <condition>
                    <any><condition object="table" variable="owed"><equal>0</equal></condition><condition object="theirs" variable="odds"><atleast>table.owed * 100 / (table.pot + table.owed)</atleast></condition></any>
                    <hold button="f11" />
                  </condition>
                </condition>
              </condition>
              <condition object="cpu" variable="chips"><below>table.owed</below>
                <condition object="theirs" variable="odds"><atleast>table.owed * 100 / (table.pot + table.owed)</atleast>
                  <hold button="f9" />
                </condition>
              </condition>
              <condition object="table" variable="owed"><above>0</above>
                <condition object="theirs" variable="odds"><below>table.owed * 100 / (table.pot + table.owed)</below>
                  <hold button="f10" />
                </condition>
              </condition>
            </condition>
          </condition>
        </condition>
      </computer>
    </state>
    <state name="over">
      <objects>
        <object name="winner">
          <sprite name="you"><text style="banner"><content>YOU WIN</content></text></sprite>
          <sprite name="computer"><text style="banner"><content>THE COMPUTER WINS</content></text></sprite>
          <position><x><centered /></x><y><centered><offset>-40</offset></centered></y></position>
        </object>
        <object name="again">
          <sprite><text style="prompt"><content>spacebar to play again</content></text></sprite>
          <position><x><centered /></x><y><centered><offset>40</offset></centered></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input><button>space</button><button>pad1.start</button><reset /></input>
      </inputs>
    </state>
    <state name="paused">
      <objects>
        <object name="paused">
          <sprite><text style="banner"><content>PAUSED</content><color>color.white</color></text></sprite>
          <position><x><centered /></x><y><centered /></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input><button>pause</button><button>pad1.start</button><pop /></input>
      </inputs>
    </state>
  </states>
  <sounds>
    <sound name="shuffle" wave="noise"><note pitch="C6">0.02</note><rest>0.02</rest><note pitch="D6">0.02</note><rest>0.02</rest><note pitch="C6">0.02</note><rest>0.02</rest><note pitch="D6">0.02</note></sound>
    <sound name="deal" wave="noise"><note pitch="G5">0.02</note><note pitch="C6">0.02</note></sound>
    <sound name="chip"><note pitch="E6">0.04</note></sound>
    <sound name="raise"><note pitch="E6">0.04</note><note pitch="G6">0.06</note></sound>
    <sound name="fold" wave="noise"><note pitch="C5">0.06</note></sound>
    <sound name="win">
      <note pitch="C5">0.1</note>
      <note pitch="E5">0.1</note>
      <note pitch="G5">0.2</note>
    </sound>
    <sound name="lose">
      <note pitch="E4">0.15</note>
      <note pitch="C4">0.3</note>
    </sound>
  </sounds>
  <!-- the card sheet: a row for each suit, a column for each rank, then a row of backs -->
  <pictures>
    <sheet name="cards"><path>assets/cards.png</path><columns>13</columns><rows>5</rows></sheet>
  </pictures>
</game>
