<!-- blackjack.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Nov 2, 2026 -->

<!--
  Blackjack (twenty-one): you against the dealer, one pack shuffled for
  every hand, 200 chips to start.

  Bet first (10 to 100). You and the dealer get two cards each, one of the
  dealer's face down. Cards count their number, jacks, queens and kings 10,
  and an ace 1 or 11, whichever is better without going over 21. Take
  cards (hit) until you stand or go over 21 (bust, and you lose the bet).
  Then the dealer turns its hidden card up and must take cards until it
  has 17 or more. Nearer 21 than the dealer wins your bet back twice; the
  same is a push (the bet back); a dealer bust pays you whatever you have.
  An ace and a ten-count card as your first two is blackjack, paid three
  to two, unless the dealer has one too. Out of chips, the game is over.

  A and D or the arrows change the bet, Space deals. W or Up hits, S or
  Down stands. Space after a hand clears the table. P or Escape pauses.

  How it is written:
  * The deck is the card sheet's, its ace worth <worth>1</worth><worth>11</worth>
    and its court cards <worth>10</worth>.
  * The two hands of cards are piles with <points><atmost>21</atmost>
    </points>: the live number `points` counts their face-up cards, an
    ace as 11 while that stays within 21.
  * Two hands with piles of their own <deal pile="stock" /> into them,
    the dealer's second card with faces="down"; <reveal pile="dealer" />
    turns it up; <shuffle pile="stock" /> gathers every card for the next.
  * The dealer draws by a timer that follows a look its condition gives
    it while its points are under 17.
  * The table's `phase`: 0 betting, 1 your play, 2 the dealer's,
    3 settling, 4 the hand over; its looks say what to do.
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../xgedef.xsd">
  <window name="Blackjack">
    <width>880</width>
    <height>840</height>
    <background>color.darkgreen</background>
  </window>
  <variables>
    <variable name="cardwidth">96</variable>
    <variable name="cardheight">140</variable>
    <variable name="left">200</variable>
    <variable name="dealerrow">110</variable>
    <variable name="yourrow">470</variable>
  </variables>
  <sounds>
    <sound name="deal" wave="noise"><note pitch="G5">0.02</note><note pitch="C6">0.02</note></sound>
    <sound name="chip"><note pitch="E6">0.04</note></sound>
    <sound name="win">
      <note pitch="C5">0.1</note>
      <note pitch="E5">0.1</note>
      <note pitch="G5">0.2</note>
    </sound>
    <sound name="blackjack">
      <note pitch="C5">0.1</note>
      <note pitch="E5">0.1</note>
      <note pitch="G5">0.1</note>
      <note pitch="C6">0.3</note>
    </sound>
    <sound name="lose">
      <note pitch="E4">0.15</note>
      <note pitch="C4">0.3</note>
    </sound>
  </sounds>
  <styles>
    <style name="banner"><size>80</size><color>color.yellow</color></style>
    <style name="prompt"><size>32</size></style>
    <style name="help"><size>22</size><color>color.lightgrey</color></style>
    <style name="note"><size>26</size><color>color.white</color></style>
    <style name="result"><size>48</size><color>color.yellow</color></style>
  </styles>
  <!-- the card sheet: a row for each suit, a column for each rank, then a row of backs -->
  <sheets>
    <sheet name="cards"><path>assets/cards.png</path><columns>13</columns><rows>5</rows></sheet>
  </sheets>
  <states>
    <state name="title">
      <objects>
        <object name="title">
          <sprite><text style="banner"><content>BLACKJACK</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 170</centered></y></position>
        </object>
        <object name="help1">
          <sprite><text style="help"><content>get nearer 21 than the dealer without going over;</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 90</centered></y></position>
        </object>
        <object name="help2">
          <sprite><text style="help"><content>court cards count 10, an ace 1 or 11. the dealer draws to 17</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 60</centered></y></position>
        </object>
        <object name="help3">
          <sprite><text style="help"><content>a d or the arrows bet, spacebar deals; w or up hits, s or down stands</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 20</centered></y></position>
        </object>
        <object name="start">
          <sprite><text style="prompt"><content>spacebar to start</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center + 170</centered></y></position>
        </object>
      </objects>
      <inputs>
        <input><button>space</button><button>pad1.start</button><push state="playing" /></input>
      </inputs>
    </state>
    <state name="playing">
      <objects>
        <!-- the pack: the card sheet's, an ace worth 1 or 11 and the court cards 10 -->
        <deck name="cards" pile="stock" sheet="cards">
          <face><width>96</width><height>140</height></face>
          <suit name="spades"><color>color.black</color></suit>
          <suit name="hearts"><color>color.red</color></suit>
          <suit name="clubs"><color>color.black</color></suit>
          <suit name="diamonds"><color>color.red</color></suit>
          <rank name="A"><worth>1</worth><worth>11</worth></rank>
          <rank>2</rank><rank>3</rank><rank>4</rank><rank>5</rank><rank>6</rank><rank>7</rank><rank>8</rank><rank>9</rank><rank>10</rank>
          <rank name="J"><worth>10</worth></rank>
          <rank name="Q"><worth>10</worth></rank>
          <rank name="K"><worth>10</worth></rank>
        </deck>

        <!-- the stock, top right -->
        <object name="stock" class="place">
          <sprite><rectangle><width>cardwidth</width><height>cardheight</height><color>color.forestgreen</color></rectangle></sprite>
          <position><x>window.width.center * 2 - cardwidth - 40</x><y>dealerrow</y></position>
          <pile faces="down"><deals>1</deals></pile>
        </object>

        <!-- the dealer's cards and yours: their points count the face-up cards, an ace as 11 while within 21 -->
        <object name="dealer" class="place">
          <sprite><rectangle><width>cardwidth</width><height>cardheight</height><color>color.darkgreen</color></rectangle></sprite>
          <position><x>left</x><y>dealerrow</y></position>
          <pile faces="up">
            <fan><x>48</x><width>480</width></fan>
            <points><atmost>21</atmost></points>
          </pile>
        </object>
        <object name="player" class="place">
          <sprite><rectangle><width>cardwidth</width><height>cardheight</height><color>color.darkgreen</color></rectangle></sprite>
          <position><x>left</x><y>yourrow</y></position>
          <pile faces="up">
            <fan><x>48</x><width>480</width></fan>
            <points><atmost>21</atmost></points>
          </pile>
        </object>

        <object name="dealerpoints">
          <sprite><text style="note"><content>dealer </content><number>dealer.points</number></text></sprite>
          <position><x>left</x><y>dealerrow - 44</y></position>
        </object>
        <object name="yourpoints">
          <sprite><text style="note"><content>you </content><number>player.points</number></text></sprite>
          <position><x>left</x><y>yourrow - 44</y></position>
        </object>

        <!-- who takes the cards: hands of their own, never seen -->
        <object name="yourhand">
          <sprite name="hand"><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite>
          <position><x>0</x><y>0</y></position>
          <hand pile="player" />
          <actions>
            <action name="hit"><deal pile="stock" /><play sound="deal" /></action>
          </actions>
        </object>
        <object name="dealerhand">
          <sprite name="wait"><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite>
          <sprite name="draw"><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite>
          <position><x>0</x><y>0</y></position>
          <hand pile="dealer" />
          <actions>
            <action name="up"><deal pile="stock" /></action>
            <action name="down"><deal pile="stock" faces="down" /></action>
          </actions>
          <!-- drawing to 17, a card each half second -->
          <timers>
            <timer sprite="draw">
              <every>0.6</every>
              <deal pile="stock" />
              <play sound="deal" />
              <become sprite="wait" />
            </timer>
          </timers>
        </object>

        <!-- the table: the bank, the bet, where the hand is, and what to do -->
        <object name="table">
          <sprite name="betting"><text style="note"><content>a d to change the bet, spacebar deals</content></text></sprite>
          <sprite name="playing"><text style="note"><content>w to hit, s to stand</content></text></sprite>
          <sprite name="dealer"><text style="note"><content>the dealer plays</content><color>color.lightgrey</color></text></sprite>
          <sprite name="done"><text style="note"><content>spacebar for the next hand</content></text></sprite>
          <position><x><centered /></x><y>yourrow + cardheight + 70</y></position>
          <actions>
            <action name="less"><dec variable="table.bet">10</dec><play sound="chip" /></action>
            <action name="more"><inc variable="table.bet">10</inc><play sound="chip" /></action>
            <action name="deal">
              <dec variable="table.bank">table.bet</dec>
              <trigger object="yourhand" action="hit" />
              <trigger object="dealerhand" action="up" />
              <trigger object="yourhand" action="hit" />
              <trigger object="dealerhand" action="down" />
              <set variable="table.phase">1</set>
              <become sprite="playing" />
            </action>
            <action name="hit"><trigger object="yourhand" action="hit" /></action>
            <action name="stand">
              <reveal pile="dealer" />
              <set variable="table.phase">2</set>
              <become sprite="dealer" />
            </action>
            <action name="next">
              <shuffle pile="stock" />
              <set variable="table.phase">0</set>
              <become sprite="betting" />
              <become object="result" sprite="none" />
            </action>
          </actions>
          <variables>
            <variable name="bank">200</variable>
            <variable name="bet">10</variable>
            <variable name="phase">0</variable>
          </variables>
        </object>

        <object name="result">
          <sprite name="none"><text style="result"><content>.</content><color>color.darkgreen</color></text></sprite>
          <sprite name="win"><text style="result"><content>you win</content></text></sprite>
          <sprite name="dealerbust"><text style="result"><content>dealer busts: you win</content></text></sprite>
          <sprite name="blackjack"><text style="result"><content>blackjack!</content></text></sprite>
          <sprite name="push"><text style="result"><content>push</content><color>color.white</color></text></sprite>
          <sprite name="lose"><text style="result"><content>dealer wins</content><color>color.lightgrey</color></text></sprite>
          <sprite name="bust"><text style="result"><content>bust</content><color>color.lightgrey</color></text></sprite>
          <position><x><centered /></x><y>dealerrow + cardheight + 70</y></position>
        </object>

        <object name="money">
          <sprite><text style="note"><content>chips </content><number>table.bank</number><content>    bet </content><number>table.bet</number></text></sprite>
          <position><x><centered /></x><y>window.height.center * 2 - 60</y></position>
        </object>
      </objects>
      <inputs>
        <input><button>a</button><button>left</button><button>pad1.left</button><trigger object="table" action="less" from="betting" /></input>
        <input><button>d</button><button>right</button><button>pad1.right</button><trigger object="table" action="more" from="betting" /></input>
        <input><button>w</button><button>up</button><button>pad1.up</button><trigger object="table" action="hit" from="playing" /></input>
        <input><button>s</button><button>down</button><button>pad1.down</button><trigger object="table" action="stand" from="playing" /></input>
        <input>
          <button>space</button><button>pad1.a</button>
          <trigger object="table" action="deal" from="betting" />
          <trigger object="table" action="next" from="done" />
        </input>
        <input><button>p</button><button>escape</button><button>pad1.start</button><push state="paused" /></input>
      </inputs>
      <conditions>
        <!-- the bet: 10 to 100, never more than the chips -->
        <condition><all><condition object="table" variable="phase"><equal>0</equal></condition><condition object="table" variable="bank"><below>10</below></condition></all><play sound="lose" /><push state="broke" /></condition>
        <condition><all><condition object="table" variable="phase"><equal>0</equal></condition><condition object="table" variable="bet"><above>table.bank</above></condition></all><set variable="table.bet">table.bank</set></condition>
        <condition><all><condition object="table" variable="phase"><equal>0</equal></condition><condition object="table" variable="bet"><below>10</below></condition></all><set variable="table.bet">10</set></condition>
        <condition><all><condition object="table" variable="phase"><equal>0</equal></condition><condition object="table" variable="bet"><above>100</above></condition></all><set variable="table.bet">100</set></condition>

        <!-- your play: over 21 is bust; 21 stands by itself, at once with blackjack -->
        <condition>
          <all><condition object="table" variable="phase"><equal>1</equal></condition><condition object="player" variable="points"><above>21</above></condition></all>
          <reveal pile="dealer" />
          <set variable="table.phase">4</set>
          <become object="table" sprite="done" />
          <become object="result" sprite="bust" />
          <play sound="lose" />
        </condition>
        <condition>
          <all><condition object="table" variable="phase"><equal>1</equal></condition><condition object="player" variable="points"><equal>21</equal></condition><condition object="player" variable="cards"><equal>2</equal></condition></all>
          <reveal pile="dealer" />
          <set variable="table.phase">3</set>
          <become object="table" sprite="dealer" />
        </condition>
        <condition>
          <all><condition object="table" variable="phase"><equal>1</equal></condition><condition object="player" variable="points"><equal>21</equal></condition></all>
          <trigger object="table" action="stand" />
        </condition>

        <!-- the dealer's play: under 17 it draws, else it stands -->
        <condition>
          <all><condition object="table" variable="phase"><equal>2</equal></condition><condition object="dealer" variable="points"><below>17</below></condition></all>
          <become object="dealerhand" sprite="draw" from="wait" />
        </condition>
        <condition>
          <all><condition object="table" variable="phase"><equal>2</equal></condition><condition object="dealer" variable="points"><atleast>17</atleast></condition></all>
          <set variable="table.phase">3</set>
        </condition>

        <!-- settling: blackjack against blackjack is a push; blackjack pays three to two -->
        <condition>
          <all>
            <condition object="table" variable="phase"><equal>3</equal></condition>
            <condition object="player" variable="points"><equal>21</equal></condition><condition object="player" variable="cards"><equal>2</equal></condition>
            <condition object="dealer" variable="points"><equal>21</equal></condition><condition object="dealer" variable="cards"><equal>2</equal></condition>
          </all>
          <inc variable="table.bank">table.bet</inc>
          <set variable="table.phase">4</set>
          <become object="table" sprite="done" />
          <become object="result" sprite="push" />
        </condition>
        <condition>
          <all><condition object="table" variable="phase"><equal>3</equal></condition><condition object="player" variable="points"><equal>21</equal></condition><condition object="player" variable="cards"><equal>2</equal></condition></all>
          <inc variable="table.bank">table.bet * 2.5</inc>
          <set variable="table.phase">4</set>
          <become object="table" sprite="done" />
          <become object="result" sprite="blackjack" />
          <play sound="blackjack" />
        </condition>
        <!-- the dealer's blackjack beats any other 21 -->
        <condition>
          <all><condition object="table" variable="phase"><equal>3</equal></condition><condition object="dealer" variable="points"><equal>21</equal></condition><condition object="dealer" variable="cards"><equal>2</equal></condition></all>
          <set variable="table.phase">4</set>
          <become object="table" sprite="done" />
          <become object="result" sprite="lose" />
          <play sound="lose" />
        </condition>
        <condition>
          <all><condition object="table" variable="phase"><equal>3</equal></condition><condition object="dealer" variable="points"><above>21</above></condition></all>
          <inc variable="table.bank">table.bet * 2</inc>
          <set variable="table.phase">4</set>
          <become object="table" sprite="done" />
          <become object="result" sprite="dealerbust" />
          <play sound="win" />
        </condition>
        <condition>
          <all><condition object="table" variable="phase"><equal>3</equal></condition><condition object="player" variable="points"><above>dealer.points</above></condition></all>
          <inc variable="table.bank">table.bet * 2</inc>
          <set variable="table.phase">4</set>
          <become object="table" sprite="done" />
          <become object="result" sprite="win" />
          <play sound="win" />
        </condition>
        <condition>
          <all><condition object="table" variable="phase"><equal>3</equal></condition><condition object="player" variable="points"><equal>dealer.points</equal></condition></all>
          <inc variable="table.bank">table.bet</inc>
          <set variable="table.phase">4</set>
          <become object="table" sprite="done" />
          <become object="result" sprite="push" />
        </condition>
        <condition object="table" variable="phase">
          <equal>3</equal>
          <set variable="table.phase">4</set>
          <become object="table" sprite="done" />
          <become object="result" sprite="lose" />
          <play sound="lose" />
        </condition>
      </conditions>
    </state>
    <state name="broke">
      <objects>
        <object name="over">
          <sprite><text style="banner"><content>OUT OF CHIPS</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 40</centered></y></position>
        </object>
        <object name="again">
          <sprite><text style="prompt"><content>spacebar to start again</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center + 40</centered></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input><button>space</button><button>pad1.start</button><reset /></input>
      </inputs>
    </state>
    <state name="paused">
      <objects>
        <object name="paused">
          <sprite><text style="banner"><content>PAUSED</content><color>color.white</color></text></sprite>
          <position><x><centered /></x><y><centered /></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input><button>space</button><button>p</button><button>escape</button><button>pad1.start</button><pop /></input>
      </inputs>
    </state>
  </states>
</game>
