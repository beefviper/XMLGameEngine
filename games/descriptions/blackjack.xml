<!-- blackjack.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Nov 2, 2026 -->

<!--
  Blackjack (twenty-one): you against the dealer, one pack shuffled for
  every hand, 200 chips to start.

  Bet first (10 to 100). You and the dealer get two cards each, one of the
  dealer's face down. Cards count their number, jacks, queens and kings 10,
  and an ace 1 or 11, whichever is better without going over 21. Take
  cards (hit) until you stand or go over 21 (bust, and you lose the bet).
  Then the dealer turns its hidden card up and must take cards until it
  has 17 or more. Nearer 21 than the dealer wins your bet back twice; the
  same is a push (the bet back); a dealer bust pays you whatever you have.
  An ace and a ten-count card as your first two is blackjack, paid three
  to two, unless the dealer has one too. Out of chips, the game is over.

  A and D or the arrows change the bet, Space deals. W or Up hits, S or
  Down stands. Space after a hand clears the table. Pause pauses.

  How it is written:
  * The pack is a group of class card, a row for each suit and a column
    for each rank, a card worth its column: the court cards' columns
    give a worth of 10, the ace's a `high` of 11.
  * Your cards and the dealer's are holders that <counts variable="worth">
    <atmost>21</atmost>: their own `worth` adds up their face-up cards',
    an ace's high while that stays within 21.
  * The table's actions <send> cards from the stock, the dealer's second
    showing its back; <become object="dealer" sprite="face" /> turns it
    up. Between hands every card is sent back and <order>ed at random.
  * The dealer draws by a timer that follows a look its condition gives
    it while its worth is under 17.
  * Where the hand is, is the table's look: betting, playing, dealer,
    settling, done. Each look's rules sit inside one condition on it,
    and what no rule in it catches comes last (the dealer wins).
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../xgedef.xsd">
  <window name="Blackjack">
    <width>880</width>
    <height>840</height>
    <background>color.darkgreen</background>
  </window>
  <variables>
    <variable name="cardwidth">96</variable>
    <variable name="cardheight">140</variable>
    <variable name="left">200</variable>
    <variable name="dealerrow">110</variable>
    <variable name="yourrow">470</variable>
  </variables>
  <styles>
    <style name="banner"><size>80</size><color>color.yellow</color></style>
    <style name="prompt"><size>32</size></style>
    <style name="help"><size>22</size><color>color.lightgrey</color></style>
    <style name="note"><size>26</size><color>color.white</color></style>
    <style name="result"><size>48</size><color>color.yellow</color></style>
  </styles>
  <states>
    <state name="title">
      <objects>
        <object name="title">
          <sprite><text style="banner"><content>BLACKJACK</content></text></sprite>
          <position><x><centered /></x><y><centered><offset>-170</offset></centered></y></position>
        </object>
        <group name="help">
          <rows>3</rows>
          <padding><y>30</y></padding>
          <sprite><text style="help" /></sprite>
          <position><x><centered /></x><y><centered><offset>-90</offset></centered></y></position>
          <row number="1"><sprite><text><content>get nearer 21 than the dealer without going over;</content></text></sprite></row>
          <row number="2"><sprite><text><content>court cards count 10, an ace 1 or 11. the dealer draws to 17</content></text></sprite></row>
          <row number="3"><sprite><text><content>a d or the arrows bet, spacebar deals; w or up hits, s or down stands</content></text></sprite><padding><y>40</y></padding></row>
        </group>
        <object name="start">
          <sprite><text style="prompt"><content>spacebar to start</content></text></sprite>
          <position><x><centered /></x><y><centered><offset>170</offset></centered></y></position>
        </object>
      </objects>
      <inputs>
        <input><button>space</button><button>pad1.start</button><push state="playing" /></input>
      </inputs>
    </state>
    <state name="playing">
      <objects>
        <!-- the pack: a row for each suit (spades, hearts, clubs, diamonds), a column for each rank, each face its own
             cell of the card sheet; a card is worth its column, the court cards 10, and an ace may count 11 -->
        <group name="cards" class="card">
          <columns name="rank">13</columns>
          <rows name="suit">4</rows>
          <sprite name="face"><cell sheet="cards"><scale>0.5</scale></cell></sprite>
          <sprite name="back"><cell sheet="cards"><column>2</column><row>5</row><scale>0.5</scale></cell></sprite>
          <position><x>0</x><y>0</y></position>
          <column><number>1</number><variables><variable name="high">11</variable></variables></column>
          <column><number>11</number><number>12</number><number>13</number><variables><variable name="worth">10</variable></variables></column>
        </group>

        <!-- the stock, top right -->
        <object name="stock" class="place">
          <sprite><rectangle><width>cardwidth</width><height>cardheight</height><color>color.forestgreen</color></rectangle></sprite>
          <position><x>window.width - cardwidth - 40</x><y>dealerrow</y></position>
          <holds class="card" sprite="back" />
        </object>

        <!-- the dealer's cards and yours: their worth counts the face-up cards, an ace 11 while within 21 -->
        <object name="dealer" class="place">
          <sprite><rectangle><width>cardwidth</width><height>cardheight</height><color>color.darkgreen</color></rectangle></sprite>
          <position><x>left</x><y>dealerrow</y></position>
          <holds class="card" sprite="face">
            <spread><x>48</x><width>480</width></spread>
            <counts variable="worth"><atmost>21</atmost></counts>
          </holds>
        </object>
        <object name="player" class="place">
          <sprite><rectangle><width>cardwidth</width><height>cardheight</height><color>color.darkgreen</color></rectangle></sprite>
          <position><x>left</x><y>yourrow</y></position>
          <holds class="card" sprite="face">
            <spread><x>48</x><width>480</width></spread>
            <counts variable="worth"><atmost>21</atmost></counts>
          </holds>
        </object>

        <object name="dealerpoints">
          <sprite><text style="note"><content>dealer </content><number>dealer.worth</number></text></sprite>
          <position><x>left</x><y>dealerrow - 44</y></position>
        </object>
        <object name="yourpoints">
          <sprite><text style="note"><content>you </content><number>player.worth</number></text></sprite>
          <position><x>left</x><y>yourrow - 44</y></position>
        </object>

        <!-- the dealer's draw: while it shows draw, a card each 0.6 seconds -->
        <object name="drawing">
          <sprite name="wait" />
          <sprite name="draw" />
          <timers>
            <timer sprite="draw">
              <every>0.6</every>
              <send from="stock" into="dealer">1</send>
              <play sound="deal" />
              <become sprite="wait" />
            </timer>
          </timers>
        </object>

        <!-- the table: the bank, the bet, where the hand is, and what to do -->
        <object name="table">
          <sprite name="betting"><text style="note"><content>a d to change the bet, spacebar deals</content></text></sprite>
          <sprite name="playing"><text style="note"><content>w to hit, s to stand</content></text></sprite>
          <sprite name="dealer"><text style="note"><content>the dealer plays</content><color>color.lightgrey</color></text></sprite>
          <sprite name="settling"><text style="note"><content>the dealer plays</content><color>color.lightgrey</color></text></sprite>
          <sprite name="done"><text style="note"><content>spacebar for the next hand</content></text></sprite>
          <position><x><centered /></x><y>yourrow + cardheight + 70</y></position>
          <actions>
            <action name="less"><dec variable="table.bet">10</dec><play sound="chip" /></action>
            <action name="more"><inc variable="table.bet">10</inc><play sound="chip" /></action>
            <!-- two each, the dealer's second face down -->
            <action name="deal">
              <dec variable="table.bank">table.bet</dec>
              <send from="stock" into="player">1</send>
              <send from="stock" into="dealer">1</send>
              <send from="stock" into="player">1</send>
              <send from="stock" into="dealer" sprite="back">1</send>
              <play sound="deal" />
              <become sprite="playing" />
            </action>
            <action name="hit"><send from="stock" into="player">1</send><play sound="deal" /></action>
            <action name="stand">
              <become object="dealer" sprite="face" />
              <become sprite="dealer" />
            </action>
            <!-- every card back in the stock, shuffled -->
            <action name="next">
              <send from="cards" into="stock"><all /></send>
              <order group="stock"><random /></order>
              <become sprite="betting" />
              <become object="result" sprite="none" />
            </action>
          </actions>
          <variables>
            <variable name="bank">200</variable>
            <variable name="bet">10</variable>
          </variables>
        </object>

        <object name="result">
          <sprite name="none"><text style="result"><content>.</content><color>color.darkgreen</color></text></sprite>
          <sprite name="win"><text style="result"><content>you win</content></text></sprite>
          <sprite name="dealerbust"><text style="result"><content>dealer busts: you win</content></text></sprite>
          <sprite name="blackjack"><text style="result"><content>blackjack!</content></text></sprite>
          <sprite name="push"><text style="result"><content>push</content><color>color.white</color></text></sprite>
          <sprite name="lose"><text style="result"><content>dealer wins</content><color>color.lightgrey</color></text></sprite>
          <sprite name="bust"><text style="result"><content>bust</content><color>color.lightgrey</color></text></sprite>
          <position><x><centered /></x><y>dealerrow + cardheight + 70</y></position>
        </object>

        <object name="money">
          <sprite><text style="note"><content>chips </content><number>table.bank</number><content>    bet </content><number>table.bet</number></text></sprite>
          <position><x><centered /></x><y>window.height - 60</y></position>
        </object>
      </objects>
      <!-- the pack into the stock, shuffled -->
      <starts>
        <send from="cards" into="stock"><all /></send>
        <order group="stock"><random /></order>
      </starts>
      <inputs>
        <input><button>a</button><button>left</button><button>pad1.left</button><trigger object="table" action="less" from="betting" /></input>
        <input><button>d</button><button>right</button><button>pad1.right</button><trigger object="table" action="more" from="betting" /></input>
        <input><button>w</button><button>up</button><button>pad1.up</button><trigger object="table" action="hit" from="playing" /></input>
        <input><button>s</button><button>down</button><button>pad1.down</button><trigger object="table" action="stand" from="playing" /></input>
        <input>
          <button>space</button><button>pad1.a</button>
          <trigger object="table" action="deal" from="betting" />
          <trigger object="table" action="next" from="done" />
        </input>
        <input><button>pause</button><button>pad1.start</button><push state="paused" /></input>
      </inputs>
      <conditions>
        <!-- the bet: 10 to 100, never more than the chips -->
        <condition object="table" sprite="betting">
          <condition object="table" variable="bank"><below>10</below>
            <play sound="lose" />
            <push state="over" />
          </condition>
          <condition object="table" variable="bet"><above>table.bank</above><set variable="table.bet">table.bank</set></condition>
          <condition object="table" variable="bet"><below>10</below><set variable="table.bet">10</set></condition>
          <condition object="table" variable="bet"><above>100</above><set variable="table.bet">100</set></condition>
        </condition>

        <!-- your play: over 21 is bust; 21 stands by itself, at once with blackjack -->
        <condition object="table" sprite="playing">
          <condition object="player" variable="worth"><above>21</above>
            <become object="dealer" sprite="face" />
            <become object="table" sprite="done" />
            <become object="result" sprite="bust" />
            <play sound="lose" />
          </condition>
          <condition object="player" variable="worth"><equal>21</equal>
            <condition object="player" variable="cards"><equal>2</equal>
              <become object="dealer" sprite="face" />
              <become object="table" sprite="settling" />
            </condition>
            <otherwise>
              <trigger object="table" action="stand" />
            </otherwise>
          </condition>
        </condition>

        <!-- the dealer's play: under 17 it draws, else it stands -->
        <condition object="table" sprite="dealer">
          <condition object="dealer" variable="worth"><below>17</below>
            <become object="drawing" sprite="draw" from="wait" />
          </condition>
          <otherwise>
            <become object="table" sprite="settling" />
          </otherwise>
        </condition>

        <!-- settling -->
        <condition object="table" sprite="settling">
          <first><become object="table" sprite="done" /></first>
          <!-- blackjack, 21 in two cards: against the dealer's a push, else it pays three to two -->
          <condition object="player" variable="worth"><equal>21</equal>
            <condition object="player" variable="cards"><equal>2</equal>
              <condition object="dealer" variable="worth"><equal>21</equal>
                <condition object="dealer" variable="cards"><equal>2</equal>
                  <inc variable="table.bank">table.bet</inc>
                  <become object="result" sprite="push" />
                </condition>
              </condition>
              <otherwise>
                <inc variable="table.bank">table.bet * 2.5</inc>
                <become object="result" sprite="blackjack" />
                <play sound="blackjack" />
              </otherwise>
            </condition>
          </condition>
          <!-- the dealer's blackjack beats any other 21 -->
          <condition object="dealer" variable="worth"><equal>21</equal>
            <condition object="dealer" variable="cards"><equal>2</equal>
              <become object="result" sprite="lose" />
              <play sound="lose" />
            </condition>
          </condition>
          <!-- the dealer bust or beaten pays two to one, a tie gives the bet back -->
          <condition object="dealer" variable="worth"><above>21</above>
            <inc variable="table.bank">table.bet * 2</inc>
            <become object="result" sprite="dealerbust" />
            <play sound="win" />
          </condition>
          <condition object="player" variable="worth"><above>dealer.worth</above>
            <inc variable="table.bank">table.bet * 2</inc>
            <become object="result" sprite="win" />
            <play sound="win" />
          </condition>
          <condition object="player" variable="worth"><equal>dealer.worth</equal>
            <inc variable="table.bank">table.bet</inc>
            <become object="result" sprite="push" />
          </condition>
          <!-- otherwise the dealer wins -->
          <otherwise>
            <become object="result" sprite="lose" />
            <play sound="lose" />
          </otherwise>
        </condition>
      </conditions>
    </state>
    <state name="over">
      <objects>
        <object name="over">
          <sprite><text style="banner"><content>OUT OF CHIPS</content></text></sprite>
          <position><x><centered /></x><y><centered><offset>-40</offset></centered></y></position>
        </object>
        <object name="again">
          <sprite><text style="prompt"><content>spacebar to start again</content></text></sprite>
          <position><x><centered /></x><y><centered><offset>40</offset></centered></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input><button>space</button><button>pad1.start</button><reset /></input>
      </inputs>
    </state>
    <state name="paused">
      <objects>
        <object name="paused">
          <sprite><text style="banner"><content>PAUSED</content><color>color.white</color></text></sprite>
          <position><x><centered /></x><y><centered /></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input><button>pause</button><button>pad1.start</button><pop /></input>
      </inputs>
    </state>
  </states>
  <sounds>
    <sound name="deal" wave="noise"><note pitch="G5">0.02</note><note pitch="C6">0.02</note></sound>
    <sound name="chip"><note pitch="E6">0.04</note></sound>
    <sound name="win">
      <note pitch="C5">0.1</note>
      <note pitch="E5">0.1</note>
      <note pitch="G5">0.2</note>
    </sound>
    <sound name="blackjack">
      <note pitch="C5">0.1</note>
      <note pitch="E5">0.1</note>
      <note pitch="G5">0.1</note>
      <note pitch="C6">0.3</note>
    </sound>
    <sound name="lose">
      <note pitch="E4">0.15</note>
      <note pitch="C4">0.3</note>
    </sound>
  </sounds>
  <!-- the card sheet: a row for each suit, a column for each rank, then a row of backs -->
  <pictures>
    <sheet name="cards"><path>assets/cards.png</path><columns>13</columns><rows>5</rows></sheet>
  </pictures>
</game>
