<!-- lunarlander.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Sept 30, 2026 -->

<!--
  Lunar Lander, after the 1979 arcade game: a lander falls toward the moon
  and has to be set down, upright and gently, on one of the flat pads. The
  narrower the pad, the more it is worth (2X, 3X, 5X). Touch anything else,
  or a pad too fast or leaning, and the lander is wrecked and some of the
  fuel is lost with it. Lander after lander comes down from the top until
  the fuel is gone.

  A and D or Left and Right turn the lander, W or Up fires the engine the
  way it points, Space, P or Escape pauses.

  How it is written:
  * Everything is drawn from <line>s and tested by pixel, so the lander
    touches the moon only where a pixel of it lies on a pixel of the moon.
    The lander has a <heading>: <turn> leans it and <thrust> pushes it the
    way it points, burning a unit of fuel a frame.
  * The terrain and the pads are both class "ground". A landing is one rule
    about the pads: slower than the safe speed and nearly upright (an <any>
    of two <check>s of the heading); every other touch of the ground is a
    wreck. Each pad's own rule says what it is worth.
  * The next lander is the same one put back, <reset object="lander" />,
    which starts its variables over too, so its fuel is copied out and back
    in around the reset, and the game is over when what was copied out is
    nothing; the score is kept apart. A landing pushes a state
    that holds the lander still on the pad; a wreck breaks it into pieces
    (<release>d at the lander) under a message whose timer says when the
    next one may come.
  Not in it: the terrain scrolling and the close-up view, the abort button,
  hard landings.
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../xge/xgedef.xsd">
  <window name="Lunar Lander">
    <width>800</width>
    <height>600</height>
  </window>
  <variables>
    <variable name="gravity">0.01</variable>
    <variable name="thrustpower">0.03</variable>
    <variable name="turnrate">3</variable>
    <variable name="fuelstart">1000</variable>
    <variable name="wreckcost">200</variable>
    <variable name="safespeed">1.2</variable>
    <variable name="upright">10</variable>
    <variable name="margin">20</variable>
  </variables>
  <sounds>
    <!-- the engine, for as long as it is held: a low rumble of noise -->
    <sound name="thrust" wave="noise">
      <loop />
      <volume>0.15</volume>
      <note pitch="150">1</note>
    </sound>
    <sound name="land" wave="triangle">
      <volume>0.4</volume>
      <note pitch="C4">0.1</note>
      <note pitch="E4">0.1</note>
      <note pitch="G4">0.1</note>
      <note pitch="C5">0.3</note>
    </sound>
    <sound name="crash" wave="noise">
      <volume>0.45</volume>
      <note pitch="3000" to="100">0.8</note>
    </sound>
    <sound name="start" wave="square">
      <volume>0.2</volume>
      <note pitch="C5">0.07</note>
      <note pitch="E5">0.07</note>
      <note pitch="G5">0.07</note>
      <note pitch="C6">0.14</note>
    </sound>
  </sounds>
  <styles>
    <style name="banner"><size>80</size><color>color.white</color></style>
    <style name="line"><size>28</size><color>color.white</color></style>
    <style name="hud"><size>26</size><color>color.white</color></style>
  </styles>
  <kit>
    <!-- what is left of a wrecked lander, flung out and falling -->
    <group name="debris">
      <sprite><line><from><x>0</x><y>0</y></from><to><x>8</x><y>6</y></to><thickness>2</thickness></line></sprite>
      <acceleration><x>0</x><y>gravity * 4</y></acceleration>
      <member><velocity><x>-1.6</x><y>-2</y></velocity></member>
      <member><velocity><x>1.4</x><y>-2.4</y></velocity></member>
      <member><velocity><x>-0.6</x><y>-3</y></velocity></member>
      <member><velocity><x>0.8</x><y>-1.6</y></velocity></member>
    </group>
  </kit>
  <states>
    <state name="mainmenu">
      <objects>
        <object name="title">
          <sprite><text style="banner"><content>LUNAR LANDER</content><size>100</size></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 130</centered></y></position>
        </object>
        <object name="help">
          <sprite><text style="line"><content>land upright and slowly on a pad: 2X, 3X or 5X the points</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 20</centered></y></position>
        </object>
        <object name="keys">
          <sprite><text style="line"><content>left and right turn, up fires the engine</content><color>color.lightgrey</color></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center + 25</centered></y></position>
        </object>
        <object name="start">
          <sprite><text style="line"><content>spacebar to start</content><size>48</size><color>color.green</color></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center + 110</centered></y></position>
        </object>
      </objects>
      <inputs>
        <input button="space">
          <push state="playing" />
          <play sound="start" />
        </input>
      </inputs>
    </state>
    <state name="playing">
      <objects>
        <!-- the moon: peaks and valleys with a gap for each pad; a line is measured from the object's top left -->
        <object name="terrain" class="ground">
          <sprite>
            <line><from><x>0</x><y>120</y></from><to><x>40</x><y>80</y></to><color>color.lightgrey</color><thickness>2</thickness></line>
            <line><from><x>40</x><y>80</y></from><to><x>70</x><y>100</y></to><color>color.lightgrey</color><thickness>2</thickness></line>
            <line><from><x>70</x><y>100</y></from><to><x>100</x><y>40</y></to><color>color.lightgrey</color><thickness>2</thickness></line>
            <line><from><x>100</x><y>40</y></from><to><x>130</x><y>90</y></to><color>color.lightgrey</color><thickness>2</thickness></line>
            <line><from><x>162</x><y>90</y></from><to><x>190</x><y>150</y></to><color>color.lightgrey</color><thickness>2</thickness></line>
            <line><from><x>190</x><y>150</y></from><to><x>230</x><y>130</y></to><color>color.lightgrey</color><thickness>2</thickness></line>
            <line><from><x>230</x><y>130</y></from><to><x>260</x><y>170</y></to><color>color.lightgrey</color><thickness>2</thickness></line>
            <line><from><x>340</x><y>170</y></from><to><x>370</x><y>110</y></to><color>color.lightgrey</color><thickness>2</thickness></line>
            <line><from><x>370</x><y>110</y></from><to><x>400</x><y>60</y></to><color>color.lightgrey</color><thickness>2</thickness></line>
            <line><from><x>400</x><y>60</y></from><to><x>430</x><y>30</y></to><color>color.lightgrey</color><thickness>2</thickness></line>
            <line><from><x>430</x><y>30</y></from><to><x>460</x><y>80</y></to><color>color.lightgrey</color><thickness>2</thickness></line>
            <line><from><x>460</x><y>80</y></from><to><x>490</x><y>120</y></to><color>color.lightgrey</color><thickness>2</thickness></line>
            <line><from><x>540</x><y>120</y></from><to><x>570</x><y>160</y></to><color>color.lightgrey</color><thickness>2</thickness></line>
            <line><from><x>570</x><y>160</y></from><to><x>610</x><y>190</y></to><color>color.lightgrey</color><thickness>2</thickness></line>
            <line><from><x>610</x><y>190</y></from><to><x>650</x><y>140</y></to><color>color.lightgrey</color><thickness>2</thickness></line>
            <line><from><x>650</x><y>140</y></from><to><x>690</x><y>70</y></to><color>color.lightgrey</color><thickness>2</thickness></line>
            <line><from><x>690</x><y>70</y></from><to><x>720</x><y>100</y></to><color>color.lightgrey</color><thickness>2</thickness></line>
            <line><from><x>720</x><y>100</y></from><to><x>760</x><y>60</y></to><color>color.lightgrey</color><thickness>2</thickness></line>
            <line><from><x>760</x><y>60</y></from><to><x>798</x><y>110</y></to><color>color.lightgrey</color><thickness>2</thickness></line>
          </sprite>
          <position><x>0</x><y>380</y></position>
          <collisions><type>pixel</type></collisions>
        </object>
        <!-- the pads, flat and lit, in the terrain's gaps -->
        <group name="pads" class="ground">
          <collisions><type>pixel</type></collisions>
          <member name="pad5">
            <sprite><line><from><x>0</x><y>0</y></from><to><x>34</x><y>0</y></to><color>color.green</color><thickness>3</thickness></line></sprite>
            <position><x>129</x><y>469</y></position>
          </member>
          <member name="pad2">
            <sprite><line><from><x>0</x><y>0</y></from><to><x>82</x><y>0</y></to><color>color.green</color><thickness>3</thickness></line></sprite>
            <position><x>259</x><y>549</y></position>
          </member>
          <member name="pad3">
            <sprite><line><from><x>0</x><y>0</y></from><to><x>52</x><y>0</y></to><color>color.green</color><thickness>3</thickness></line></sprite>
            <position><x>489</x><y>499</y></position>
          </member>
        </group>
        <group name="marks">
          <member><sprite><text style="hud"><content>5X</content></text></sprite><position><x>133</x><y>478</y></position></member>
          <member><sprite><text style="hud"><content>2X</content></text></sprite><position><x>286</x><y>558</y></position></member>
          <member><sprite><text style="hud"><content>3X</content></text></sprite><position><x>502</x><y>508</y></position></member>
        </group>
        <object name="lander">
          <sprite>
            <line><from><x>10</x><y>2</y></from><to><x>20</x><y>2</y></to><thickness>2</thickness></line>
            <line><from><x>20</x><y>2</y></from><to><x>25</x><y>7</y></to><thickness>2</thickness></line>
            <line><from><x>25</x><y>7</y></from><to><x>25</x><y>12</y></to><thickness>2</thickness></line>
            <line><from><x>25</x><y>12</y></from><to><x>5</x><y>12</y></to><thickness>2</thickness></line>
            <line><from><x>5</x><y>12</y></from><to><x>5</x><y>7</y></to><thickness>2</thickness></line>
            <line><from><x>5</x><y>7</y></from><to><x>10</x><y>2</y></to><thickness>2</thickness></line>
            <line><from><x>7</x><y>14</y></from><to><x>23</x><y>14</y></to><thickness>2</thickness></line>
            <line><from><x>23</x><y>14</y></from><to><x>23</x><y>19</y></to><thickness>2</thickness></line>
            <line><from><x>23</x><y>19</y></from><to><x>7</x><y>19</y></to><thickness>2</thickness></line>
            <line><from><x>7</x><y>19</y></from><to><x>7</x><y>14</y></to><thickness>2</thickness></line>
            <line><from><x>13</x><y>19</y></from><to><x>11</x><y>23</y></to><thickness>2</thickness></line>
            <line><from><x>17</x><y>19</y></from><to><x>19</x><y>23</y></to><thickness>2</thickness></line>
            <line><from><x>7</x><y>18</y></from><to><x>2</x><y>28</y></to><thickness>2</thickness></line>
            <line><from><x>23</x><y>18</y></from><to><x>28</x><y>28</y></to><thickness>2</thickness></line>
            <line><from><x>0</x><y>28</y></from><to><x>5</x><y>28</y></to><thickness>2</thickness></line>
            <line><from><x>25</x><y>28</y></from><to><x>30</x><y>28</y></to><thickness>2</thickness></line>
          </sprite>
          <position><x><random><min>40</min><max>300</max></random></x><y>40</y></position>
          <velocity><x><random><min>0.5</min><max>1.2</max></random></x></velocity>
          <acceleration><x>0</x><y>gravity</y></acceleration>
          <heading>0</heading>
          <collisions>
            <type>pixel</type>
            <collision edge="horizontal"><stick /></collision>
            <collision edge="top"><stick /></collision>
            <collision object="pad2"><set variable="lander.worth">100</set></collision>
            <collision object="pad3"><set variable="lander.worth">150</set></collision>
            <collision object="pad5"><set variable="lander.worth">250</set></collision>
            <collision object="pads">
              <slower>safespeed</slower>
              <any>
                <check variable="heading"><atmost>upright</atmost></check>
                <check variable="heading"><atleast>360 - upright</atleast></check>
              </any>
              <set variable="lander.landed">1</set>
              <stop />
            </collision>
            <collision class="ground">
              <check variable="landed"><equal>0</equal></check>
              <set variable="lander.crashed">1</set>
              <release object="debris">4</release>
              <die />
            </collision>
          </collisions>
          <actions>
            <action name="left"><turn direction="left">turnrate</turn></action>
            <action name="right"><turn direction="right">turnrate</turn></action>
            <action name="thrust">
              <thrust burn="fuel">thrustpower</thrust>
              <play sound="thrust" />
            </action>
          </actions>
          <variables>
            <variable name="fuel">fuelstart</variable>
            <variable name="worth">0</variable>
            <variable name="landed">0</variable>
            <variable name="crashed">0</variable>
            <variable name="ready">0</variable>
          </variables>
        </object>
        <object name="wrecked">
          <sprite><text style="line"><content>YOU JUST DESTROYED A 100 MEGABUCK LANDER</content><color>color.red</color></text></sprite>
          <position><x><centered /></x><y>window.height.center - 140</y></position>
          <active>false</active>
          <timers>
            <timer><every>2.5</every><inc variable="lander.ready" /><die /></timer>
          </timers>
        </object>
        <!-- the score, and the fuel kept while a new lander is brought in -->
        <object name="status">
          <variables>
            <variable name="score">0</variable>
            <variable name="fuel">fuelstart</variable>
          </variables>
        </object>
        <object name="score">
          <sprite><text style="hud"><content>SCORE </content><number>status.score</number></text></sprite>
          <position><x>margin</x><y>margin</y></position>
        </object>
        <object name="fuel">
          <sprite><text style="hud"><content>FUEL </content><number>lander.fuel</number></text></sprite>
          <position><x>window.right - margin - 160</x><y>margin</y></position>
        </object>
      </objects>
      <inputs>
        <input button="up w"><trigger object="lander" action="thrust" /></input>
        <input button="left a"><trigger object="lander" action="left" /></input>
        <input button="right d"><trigger object="lander" action="right" /></input>
        <input button="space p escape"><push state="paused" /></input>
      </inputs>
      <conditions>
        <!-- the last lander down with no fuel left -->
        <condition object="status" variable="fuel">
          <atmost>0</atmost>
          <push state="gameover" />
        </condition>
        <!-- the next lander, from the top -->
        <condition object="lander" variable="ready">
          <atleast>1</atleast>
          <copy variable="lander.fuel" into="status.fuel" />
          <reset object="lander" />
          <copy variable="status.fuel" into="lander.fuel" />
          <despawn object="debris" />
        </condition>
        <condition object="lander" variable="landed">
          <atleast>1</atleast>
          <inc variable="status.score">lander.worth</inc>
          <silence sound="thrust" />
          <play sound="land" />
          <push state="landed" />
        </condition>
        <condition object="lander" variable="crashed">
          <atleast>1</atleast>
          <set variable="lander.crashed">0</set>
          <set variable="lander.fuel">max(0, lander.fuel - wreckcost)</set>
          <silence sound="thrust" />
          <play sound="crash" />
          <reveal object="wrecked" />
        </condition>
        <!-- out of fuel, the engine goes quiet even with a key held -->
        <condition object="lander" variable="fuel">
          <atmost>0</atmost>
          <silence sound="thrust" />
        </condition>
      </conditions>
    </state>
    <state name="paused">
      <objects>
        <object name="paused">
          <sprite><text style="banner"><content>PAUSED</content></text></sprite>
          <position><x><centered /></x><y><centered /></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input button="space p escape"><pop /></input>
      </inputs>
    </state>
    <!-- down on a pad: the lander stays still while the points are shown, then the next one comes -->
    <state name="landed">
      <objects>
        <object name="message">
          <sprite><text style="banner"><content>THE EAGLE HAS LANDED</content><size>56</size><color>color.green</color></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 150</centered></y></position>
        </object>
        <object name="points">
          <sprite><text style="line"><number>lander.worth</number><content> POINTS</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 90</centered></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input button="space p escape"><push state="paused" /></input>
      </inputs>
      <timers>
        <timer><every>2.5</every><inc variable="lander.ready" /><pop /></timer>
      </timers>
    </state>
    <state name="gameover">
      <objects>
        <object name="message">
          <sprite><text style="banner"><content>OUT OF FUEL</content><color>color.red</color></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 140</centered></y></position>
        </object>
        <object name="again">
          <sprite><text style="line"><content>spacebar to play again</content><size>48</size></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 60</centered></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input button="space"><reset /></input>
      </inputs>
    </state>
  </states>
</game>
