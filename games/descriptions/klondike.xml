<!-- klondike.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Nov 1, 2026 -->

<!--
  Klondike, the classic patience: one player, one pack of 52 cards.

  Seven columns are dealt, one card in the first, two in the second, up to
  seven in the last, each with only its top card face up; the rest of the
  pack is the stock, top left. Build the columns down in alternating
  colours (a red 9 on a black 10); a run of face-up cards moves together,
  and a card left face down on top turns up. Only a king goes in an empty
  column. Take the stock's cards one at a time onto the waste beside it;
  when it is empty, take again to turn the waste back over. Each suit goes
  up from its ace to its king on one of the four foundations, top right.
  All 52 there wins.

  W A S D or the arrows move the hand: left and right from pile to pile,
  up and down through a column's face-up cards and between the rows.
  Space takes the card the hand is on (with the cards on it) and lays them
  where it is moved to; taken from the stock, Space deals. X or Backspace
  puts back what is held, and F sends the card pointed at to its
  foundation. With the mouse, press on a card, drag it and let go; a right
  click sends a card home. Pause pauses, and N there deals a new game.

  How it is written:
  * The pack is a group of 52 cells in 13 <columns> and 4 <rows>: a row for
    each suit, a column for each rank. Each card's face is its own cell of
    the card sheet (a <cell> that leaves out its column and row), its back
    the sheet's first back; a variable `color` tells red from black.
  * Each place is an object or group that <holds> cards: the look a card
    laid there shows, how they <spread>, what it <accepts> on top (the
    columns: a different colour, a rank one lower, a K when empty; the
    foundations: one at a time, the same suit, a rank one higher, an A when
    empty), whether a card picked may <carry /> those on it, and what
    picking from the stock does instead (<picked>).
  * <starts> deals: every card into the stock, shuffled, then one to each
    column and one more for each column after (the staircase).
  * The hand picks and places cards; a place that the pile does not accept
    is refused, so the hand keeps them.
  * The live number `held` of the foundations, added up, is the win.
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../xgedef.xsd">
  <window name="Klondike">
    <width>880</width>
    <height>840</height>
    <background>color.darkgreen</background>
  </window>
  <variables>
    <variable name="cardwidth">96</variable>
    <variable name="cardheight">140</variable>
    <variable name="step">112</variable>
    <variable name="left">56</variable>
    <variable name="top">24</variable>
    <variable name="low">188</variable>
  </variables>
  <styles>
    <style name="banner"><size>80</size><color>color.yellow</color></style>
    <style name="prompt"><size>32</size></style>
    <style name="help"><size>22</size><color>color.lightgrey</color></style>
  </styles>
  <states>
    <state name="title">
      <objects>
        <object name="title">
          <sprite><text style="banner"><content>KLONDIKE</content></text></sprite>
          <position><x><centered /></x><y><centered><offset>-170</offset></centered></y></position>
        </object>
        <group name="help">
          <rows>4</rows>
          <padding><y>30</y></padding>
          <sprite><text style="help" /></sprite>
          <position><x><centered /></x><y><centered><offset>-90</offset></centered></y></position>
          <row number="1"><sprite><text><content>build the columns down in alternating colours,</content></text></sprite></row>
          <row number="2"><sprite><text><content>each suit up from ace to king on the foundations</content></text></sprite></row>
          <row number="3"><sprite><text><content>w a s d or the arrows move, spacebar takes and lays, x puts back,</content></text></sprite><padding><y>40</y></padding></row>
          <row number="4"><sprite><text><content>f sends a card home; or drag with the mouse, right click home</content></text></sprite></row>
        </group>
        <object name="start">
          <sprite><text style="prompt"><content>spacebar to deal</content></text></sprite>
          <position><x><centered /></x><y><centered><offset>170</offset></centered></y></position>
        </object>
      </objects>
      <inputs>
        <input><button>space</button><button>pad1.start</button><push state="playing" /></input>
      </inputs>
    </state>
    <state name="playing">
      <objects>
        <!-- the pack: a row for each suit, a column for each rank, each face its own cell of the card sheet -->
        <group name="cards" class="card">
          <columns>13</columns>
          <rows>4</rows>
          <sprite name="face"><cell sheet="cards"><scale>0.5</scale></cell></sprite>
          <sprite name="back"><cell sheet="cards"><column>1</column><row>5</row><scale>0.5</scale></cell></sprite>
          <position><x>0</x><y>0</y></position>
          <variables><variable name="color">1</variable></variables>
          <row><number>2</number><number>4</number><variables><variable name="color">2</variable></variables></row>
        </group>
        <!-- the stock, top left: picked from, it turns one onto the waste; empty, the waste comes back -->
        <object name="stock" class="place">
          <sprite><rectangle><width>cardwidth</width><height>cardheight</height><color>color.forestgreen</color></rectangle></sprite>
          <position><x>left</x><y>top</y></position>
          <holds class="card" sprite="back">
            <picked>
              <send into="waste">1</send>
              <empty><send from="waste"><all /></send></empty>
              <play sound="deal" />
            </picked>
          </holds>
        </object>
        <object name="waste" class="place">
          <sprite><rectangle><width>cardwidth</width><height>cardheight</height><color>color.forestgreen</color></rectangle></sprite>
          <position><x>left + step</x><y>top</y></position>
          <holds class="card" sprite="face" />
        </object>
        <!-- the foundations: each suit up from its ace, one card at a time -->
        <group name="foundations" class="place">
          <columns>4</columns>
          <rows>1</rows>
          <padding><x>step - cardwidth</x></padding>
          <sprite><rectangle><width>cardwidth</width><height>cardheight</height><color>color.forestgreen</color></rectangle></sprite>
          <position><x>left + step * 3</x><y>top</y></position>
          <holds class="card" sprite="face">
            <accepts>
              <condition total="count"><equal>1</equal></condition>
              <condition variable="suit"><equal>top.suit</equal></condition>
              <condition variable="rank"><equal>top.rank + 1</equal></condition>
              <empty><condition variable="rank"><equal>1</equal></condition></empty>
            </accepts>
          </holds>
        </group>
        <!-- the seven columns: down in alternating colours, a king in an empty one -->
        <group name="columns" class="place">
          <columns>7</columns>
          <rows>1</rows>
          <padding><x>step - cardwidth</x></padding>
          <sprite><rectangle><width>cardwidth</width><height>cardheight</height><color>color.forestgreen</color></rectangle></sprite>
          <position><x>left</x><y>low</y></position>
          <holds class="card">
            <spread><y>32</y></spread>
            <spread sprite="back"><y>9</y></spread>
            <accepts>
              <condition variable="color"><unequal>top.color</unequal></condition>
              <condition variable="rank"><equal>top.rank - 1</equal></condition>
              <empty><condition variable="rank"><equal>13</equal></condition></empty>
            </accepts>
            <carry />
            <top sprite="face" />
          </holds>
        </group>
        <!-- the hand: a frame around the card it points at -->
        <object name="hand">
          <sprite name="free"><drawing from="handfree" /></sprite>
          <sprite name="held"><drawing from="handheld" /></sprite>
          <position><x>left - 3</x><y>top - 3</y></position>
          <actions>
            <action name="left"><hop direction="left" /></action>
            <action name="right"><hop direction="right" /></action>
            <action name="up"><hop direction="up" /></action>
            <action name="down"><hop direction="down" /></action>
            <action name="point"><track /></action>
            <action name="take"><pick class="card" /><play sound="card" /><become sprite="held" /></action>
            <action name="lay"><place /><play sound="card" /><become sprite="free" /></action>
            <action name="back"><drop /><play sound="card" /><become sprite="free" /></action>
            <!-- home: the card pointed at onto the foundation that takes it -->
            <action name="home"><pick class="card" /><place into="foundations" /><play sound="card" /></action>
          </actions>
        </object>
      </objects>
      <!-- the deal: every card into the stock, shuffled; then the staircase -->
      <starts>
        <send from="cards" into="stock"><all /></send>
        <order group="stock"><random /></order>
        <distribute from="stock" into="columns">1<more>1</more></distribute>
      </starts>
      <inputs>
        <input><button>a</button><button>left</button><button>pad1.left</button><trigger object="hand" action="left" /></input>
        <input><button>d</button><button>right</button><button>pad1.right</button><trigger object="hand" action="right" /></input>
        <input><button>w</button><button>up</button><button>pad1.up</button><trigger object="hand" action="up" /></input>
        <input><button>s</button><button>down</button><button>pad1.down</button><trigger object="hand" action="down" /></input>
        <input>
          <button>space</button><button>pad1.a</button>
          <trigger object="hand" action="take" from="free" />
          <trigger object="hand" action="lay" from="held" />
        </input>
        <input><button>x</button><button>backspace</button><button>pad1.b</button><trigger object="hand" action="back" from="held" /></input>
        <!-- home, then back if no foundation took it -->
        <input>
          <button>f</button><button>mouse.right</button><button>pad1.y</button>
          <trigger object="hand" action="home" from="free">
            <otherwise><trigger object="hand" action="back" /></otherwise>
          </trigger>
        </input>
        <!-- the mouse: press takes (or deals), let go lays or puts back -->
        <input>
          <button>mouse.left</button>
          <trigger object="hand" action="take" from="free" />
        </input>
        <input on="release">
          <button>mouse.left</button>
          <trigger object="hand" action="lay" from="held">
            <otherwise><trigger object="hand" action="back" /></otherwise>
          </trigger>
        </input>
        <input axis="mouse.x"><trigger object="hand" action="point" /></input>
        <input axis="mouse.y"><trigger object="hand" action="point" /></input>
        <input><button>pause</button><button>pad1.start</button><push state="paused" /></input>
      </inputs>
      <conditions>
        <!-- all 52 on the foundations -->
        <condition object="foundations" variable="held" total="sum">
          <atleast>52</atleast>
          <play sound="win" />
          <push state="over" />
        </condition>
      </conditions>
    </state>
    <state name="paused">
      <objects>
        <object name="paused">
          <sprite><text style="banner"><content>PAUSED</content><color>color.white</color></text></sprite>
          <position><x><centered /></x><y><centered><offset>-40</offset></centered></y></position>
        </object>
        <object name="newdeal">
          <sprite><text style="prompt"><content>n for a new deal</content></text></sprite>
          <position><x><centered /></x><y><centered><offset>40</offset></centered></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input><button>pause</button><button>pad1.start</button><pop /></input>
        <input><button>n</button><reset /></input>
      </inputs>
    </state>
    <state name="over">
      <objects>
        <object name="winner">
          <sprite><text style="banner"><content>YOU WIN</content></text></sprite>
          <position><x><centered /></x><y><centered><offset>-40</offset></centered></y></position>
        </object>
        <object name="again">
          <sprite><text style="prompt"><content>spacebar to deal again</content></text></sprite>
          <position><x><centered /></x><y><centered><offset>40</offset></centered></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input><button>space</button><button>pad1.start</button><reset /></input>
      </inputs>
    </state>
  </states>
  <sounds>
    <sound name="card" wave="noise"><note pitch="C6">0.03</note></sound>
    <sound name="deal" wave="noise"><note pitch="G5">0.02</note><note pitch="C6">0.02</note></sound>
    <sound name="win">
      <note pitch="C5">0.12</note>
      <note pitch="E5">0.12</note>
      <note pitch="G5">0.12</note>
      <note pitch="C6">0.4</note>
    </sound>
  </sounds>
  <!-- the card sheet: a row for each suit, a column for each rank, then a row of backs -->
  <pictures>
    <sheet name="cards"><path>assets/cards.png</path><columns>13</columns><rows>5</rows></sheet>
    <drawing name="handfree">
      <line><from><x>1</x><y>1</y></from><to><x>cardwidth + 5</x><y>1</y></to><color>color.yellow</color><thickness>3</thickness></line>
      <line><from><x>cardwidth + 5</x><y>1</y></from><to><x>cardwidth + 5</x><y>cardheight + 5</y></to><color>color.yellow</color><thickness>3</thickness></line>
      <line><from><x>cardwidth + 5</x><y>cardheight + 5</y></from><to><x>1</x><y>cardheight + 5</y></to><color>color.yellow</color><thickness>3</thickness></line>
      <line><from><x>1</x><y>cardheight + 5</y></from><to><x>1</x><y>1</y></to><color>color.yellow</color><thickness>3</thickness></line>
    </drawing>
    <drawing name="handheld">
      <line><from><x>1</x><y>1</y></from><to><x>cardwidth + 5</x><y>1</y></to><color>color.cyan</color><thickness>3</thickness></line>
      <line><from><x>cardwidth + 5</x><y>1</y></from><to><x>cardwidth + 5</x><y>cardheight + 5</y></to><color>color.cyan</color><thickness>3</thickness></line>
      <line><from><x>cardwidth + 5</x><y>cardheight + 5</y></from><to><x>1</x><y>cardheight + 5</y></to><color>color.cyan</color><thickness>3</thickness></line>
      <line><from><x>1</x><y>cardheight + 5</y></from><to><x>1</x><y>1</y></to><color>color.cyan</color><thickness>3</thickness></line>
    </drawing>
  </pictures>
</game>
