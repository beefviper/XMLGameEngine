<!-- kaboom.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Sept 30, 2026 -->

<!--
  Kaboom!, after the 1981 Atari 2600 game. The Mad Bomber paces the rooftop at
  the top of the screen, changing direction whenever he likes, and drops bombs
  as he goes; you slide a bucket along the bottom to catch them. Because the
  bombs leave from wherever he is, they come down in trails and clusters that
  follow his path: a run to the left, a doubling back, a burst in one place.
  Every bomb caught scores; one that reaches the ground sets off every bomb
  still falling and costs a bucket (you start with three), and with none left
  it is game over. There are three waves, each with a quicker bomber, faster
  bombs and more of them, worth one, two and three points a bomb. Reach `goal`
  points to win (the arcade game has no end).

  How it is written:
  * The rooftop, the bucket and the score are the playing state's own
    objects, there in every wave.
  * The waves are the <scenes> of the playing state. The bomber, his pool of
    bombs and the wave's label are the kit; the first wave takes them, and
    each later wave is the one before (from=) with its own <variables>: how
    fast the bomber paces (pace), how often he drops a bomb (drop, seconds),
    how fast it falls (fall) and what it is worth (points), read by plain
    names in the kit. A later wave also gives its bombs and its label a
    sprite of their own.
  * The bomber has two <timers>. One <reverse />s him after a random wait
    (worked out again each time), so his path is never the same; the other
    <fire>s a bomb every `drop` seconds. He has <facing>down</facing>, so a
    bomb leaves from under him and falls at its own speed.
  * The bombs are a pool, a <group> of hidden bombs that the bomber fires one
    at a time and that <die /> back into the pool when caught.
  * A bomb that hits the ground runs <reset object="bombs" />, which puts
    every bomb of the wave back in the pool at once: the explosion.
  * A <condition> of each wave on the score <enter>s the next one, and the
    last one's wins.
  * Paused and the two endings draw the game still underneath (<show state>).
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../xge/xgedef.xsd">
  <window name="Kaboom!">
    <width>800</width>
    <height>600</height>
    <background>color.black</background>
    <fullscreen>false</fullscreen>
    <framerate>60</framerate>
  </window>
  <variables>
    <variable name="bucketwidth">110</variable>
    <variable name="bucketheight">18</variable>
    <variable name="bomb">8</variable>
    <variable name="step">9</variable>
    <variable name="margin">20</variable>
    <variable name="roof">104</variable>
    <variable name="wave2at">15</variable>
    <variable name="wave3at">45</variable>
    <variable name="goal">90</variable>
  </variables>
  <sounds>
    <!-- a bomb caught: a quick rising blip -->
    <sound name="catch" wave="square">
      <volume>0.2</volume>
      <note pitch="C5" to="G5">0.05</note>
    </sound>
    <!-- a bomb on the ground: a burst of noise that sinks -->
    <sound name="boom" wave="noise">
      <volume>0.45</volume>
      <note pitch="3000" to="200">0.6</note>
    </sound>
    <!-- a new wave -->
    <sound name="wave" wave="triangle">
      <volume>0.4</volume>
      <note pitch="C4">0.08</note>
      <note pitch="E4">0.08</note>
      <note pitch="G4">0.08</note>
      <note pitch="C5">0.16</note>
    </sound>
    <!-- out of buckets -->
    <sound name="gameover" wave="square">
      <volume>0.2</volume>
      <note pitch="E4">0.2</note>
      <note pitch="D#4">0.2</note>
      <note pitch="D4">0.2</note>
      <note pitch="C#4" to="C3">0.6</note>
    </sound>
  </sounds>
  <objects>
    <!-- after a game, in both endings -->
    <object name="again">
      <sprite>
        <text>
          <content>spacebar to play again</content>
          <size>48</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position><x>window.width.center - again.width / 2</x><y>window.height.center - again.height / 2 + (70)</y></position>
    </object>
  </objects>
  <states>
    <state name="mainmenu">
      <objects>
        <object name="title">
          <sprite>
            <text>
              <content>KABOOM!</content>
              <size>128</size>
              <color>color.red</color>
            </text>
          </sprite>
          <position><x>window.width.center - title.width / 2</x><y>window.height.center - title.height / 2 + (-110)</y></position>
        </object>
        <object name="help">
          <sprite>
            <text>
              <content>the mad bomber drops them; catch every one</content>
              <size>36</size>
              <color>color.white</color>
            </text>
          </sprite>
          <position><x>window.width.center - help.width / 2</x><y>window.height.center - help.height / 2 + (-10)</y></position>
        </object>
        <object name="keys">
          <sprite>
            <text>
              <content>a and d, or the arrow keys, to move</content>
              <size>32</size>
              <color>color.lightgrey</color>
            </text>
          </sprite>
          <position><x>window.width.center - keys.width / 2</x><y>window.height.center - keys.height / 2 + (40)</y></position>
        </object>
        <object name="start">
          <sprite>
            <text>
              <content>spacebar to start</content>
              <size>48</size>
              <color>color.white</color>
            </text>
          </sprite>
          <position><x>window.width.center - start.width / 2</x><y>window.height.center - start.height / 2 + (130)</y></position>
        </object>
      </objects>
      <inputs>
        <input button="space">
          <push state="playing" />
          <play sound="wave" />
        </input>
      </inputs>
    </state>

    <state name="playing">
      <objects>
        <!-- the rooftop the bomber walks along -->
        <object name="rooftop">
          <sprite>
            <rectangle>
              <width>window.right</width>
              <height>roof</height>
              <color>color.darkgrey</color>
            </rectangle>
          </sprite>
          <position><x>0</x><y>0</y></position>
        </object>
        <object name="ledge">
          <sprite>
            <rectangle>
              <width>window.right</width>
              <height>6</height>
              <color>color.lightgrey</color>
            </rectangle>
          </sprite>
          <position><x>0</x><y>roof</y></position>
        </object>
        <!-- the bucket -->
        <object name="bucket">
          <sprite>
            <rectangle>
              <width>bucketwidth</width>
              <height>bucketheight</height>
              <color>color.cyan</color>
            </rectangle>
          </sprite>
          <position><x>window.width.center - bucket.width / 2</x><y>window.bottom - bucket.height - margin</y></position>
          <collisions>
            <enabled>true</enabled>
            <collision edge="horizontal">
              <stick />
            </collision>
          </collisions>
          <actions>
            <action name="left">
              <move direction="left">step</move>
            </action>
            <action name="right">
              <move direction="right">step</move>
            </action>
          </actions>
          <variables>
            <variable name="score">0</variable>
            <variable name="buckets">3</variable>
          </variables>
        </object>
        <object name="scorelabel">
          <sprite>
            <text>
              <content>SCORE</content>
              <size>30</size>
              <color>color.white</color>
            </text>
          </sprite>
          <position><x>margin</x><y>12</y></position>
        </object>
        <object name="scorevalue">
          <sprite>
            <text>
              <number>bucket.score</number>
              <size>30</size>
              <color>color.cyan</color>
            </text>
          </sprite>
          <position><x>margin + scorelabel.width + 12</x><y>12</y></position>
        </object>
        <object name="bucketsvalue">
          <sprite>
            <text>
              <number>bucket.buckets</number>
              <size>30</size>
              <color>color.red</color>
            </text>
          </sprite>
          <position><x>window.right - bucketsvalue.width - margin</x><y>12</y></position>
        </object>
        <object name="bucketslabel">
          <sprite>
            <text>
              <content>BUCKETS</content>
              <size>30</size>
              <color>color.white</color>
            </text>
          </sprite>
          <position><x>window.right - bucketsvalue.width - bucketslabel.width - margin - 12</x><y>12</y></position>
        </object>
      </objects>
      <scenes>
        <!-- what every wave takes: the bomber, his bombs and the wave's label -->
        <objects>
          <!-- the Mad Bomber -->
          <object name="bomber" class="bomber">
            <sprite>
              <bitmap>
                <row>....****....</row>
                <row>...******...</row>
                <row>..********..</row>
                <row>....****....</row>
                <row>...*.**.*...</row>
                <row>....****....</row>
                <row>..********..</row>
                <row>.**.****.**.</row>
                <row>.**.****.**.</row>
                <row>....****....</row>
                <row>....*..*....</row>
                <row>...**..**...</row>
                <scale>4</scale>
                <color>color.white</color>
              </bitmap>
            </sprite>
            <position><x>window.width.center - bomber.width / 2</x><y>roof - bomber.height</y></position>
            <velocity><x>pace</x></velocity>
            <facing>down</facing>
            <collisions>
              <enabled>true</enabled>
              <collision edge="horizontal">
                <bounce />
              </collision>
            </collisions>
            <timers>
              <timer>
                <every><random min="0.3" max="1.4" /></every>
                <reverse />
              </timer>
              <timer>
                <every>drop</every>
                <fire object="bombs" />
              </timer>
            </timers>
          </object>
          <!-- the bombs: ten in a pool, hidden until the bomber drops one -->
          <group name="bombs" class="bombs">
            <sprite>
              <circle>
                <radius>bomb</radius>
                <color>color.lightgrey</color>
              </circle>
            </sprite>
            <position><x>0</x><y>0</y></position>
            <velocity><y>fall</y></velocity>
            <hidden>true</hidden>
            <collisions>
              <enabled>false</enabled>
              <collision edge="bottom">
                <dec variable="bucket.buckets" />
                <play sound="boom" />
                <reset object="bombs" />
              </collision>
              <collision object="bucket">
                <inc variable="bucket.score">points</inc>
                <play sound="catch" />
                <die />
              </collision>
            </collisions>
            <member />
            <member />
            <member />
            <member />
            <member />
            <member />
            <member />
            <member />
            <member />
            <member />
          </group>
          <object name="wavelabel">
            <sprite>
              <text>
                <content>WAVE 1</content>
                <size>30</size>
                <color>color.yellow</color>
              </text>
            </sprite>
            <position><x>window.width.center - wavelabel.width / 2</x><y>12</y></position>
          </object>
        </objects>

        <scene name="wave1">
          <variables>
            <variable name="pace">3</variable>
            <variable name="drop">0.55</variable>
            <variable name="fall">3</variable>
            <variable name="points">1</variable>
          </variables>
          <objects>
            <object name="bomber" />
            <group name="bombs" />
            <object name="wavelabel" />
          </objects>
          <conditions>
            <condition object="bucket" variable="score">
              <atleast>wave2at</atleast>
              <enter scene="wave2" />
              <play sound="wave" />
            </condition>
          </conditions>
        </scene>

        <!-- the same man, quicker, and dropping faster, orange bombs -->
        <scene name="wave2" from="wave1">
          <variables>
            <variable name="pace">4.5</variable>
            <variable name="drop">0.42</variable>
            <variable name="fall">4.5</variable>
            <variable name="points">2</variable>
          </variables>
          <objects>
            <group name="bombs">
              <sprite>
                <circle>
                  <radius>bomb</radius>
                  <color>color.orange</color>
                </circle>
              </sprite>
            </group>
            <object name="wavelabel">
              <sprite>
                <text>
                  <content>WAVE 2</content>
                  <size>30</size>
                  <color>color.yellow</color>
                </text>
              </sprite>
            </object>
          </objects>
          <conditions>
            <condition object="bucket" variable="score">
              <atleast>wave3at</atleast>
              <enter scene="wave3" />
              <play sound="wave" />
            </condition>
          </conditions>
        </scene>

        <!-- quicker again, red bombs -->
        <scene name="wave3" from="wave2">
          <variables>
            <variable name="pace">6</variable>
            <variable name="drop">0.32</variable>
            <variable name="fall">6</variable>
            <variable name="points">3</variable>
          </variables>
          <objects>
            <group name="bombs">
              <sprite>
                <circle>
                  <radius>bomb</radius>
                  <color>color.red</color>
                </circle>
              </sprite>
            </group>
            <object name="wavelabel">
              <sprite>
                <text>
                  <content>WAVE 3</content>
                  <size>30</size>
                  <color>color.yellow</color>
                </text>
              </sprite>
            </object>
          </objects>
          <conditions>
            <condition object="bucket" variable="score">
              <atleast>goal</atleast>
              <reset object="bombs" />
              <push state="youwin" />
              <play sound="wave" />
            </condition>
          </conditions>
        </scene>
      </scenes>
      <inputs>
        <input button="a left">
          <trigger object="bucket" action="left" />
        </input>
        <input button="d right">
          <trigger object="bucket" action="right" />
        </input>
        <input button="space p">
          <push state="paused" />
        </input>
      </inputs>
      <conditions>
        <!-- out of buckets -->
        <condition object="bucket" variable="buckets">
          <atmost>0</atmost>
          <push state="gameover" />
          <play sound="gameover" />
        </condition>
      </conditions>
    </state>

    <state name="paused">
      <objects>
        <object name="paused">
          <sprite>
            <text>
              <content>PAUSED</content>
              <size>128</size>
              <color>color.white</color>
            </text>
          </sprite>
          <position><x>window.width.center - paused.width / 2</x><y>window.height.center - paused.height / 2 + (0)</y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input button="space p">
          <pop />
        </input>
      </inputs>
    </state>
    <state name="youwin">
      <objects>
        <object name="youwin">
          <sprite>
            <text>
              <content>YOU WIN</content>
              <size>128</size>
              <color>color.green</color>
            </text>
          </sprite>
          <position><x>window.width.center - youwin.width / 2</x><y>window.height.center - youwin.height / 2 + (-60)</y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
        <show object="again" />
      </shows>
      <inputs>
        <input button="space">
          <reset />
        </input>
      </inputs>
    </state>
    <state name="gameover">
      <objects>
        <object name="gameover">
          <sprite>
            <text>
              <content>GAME OVER</content>
              <size>128</size>
              <color>color.red</color>
            </text>
          </sprite>
          <position><x>window.width.center - gameover.width / 2</x><y>window.height.center - gameover.height / 2 + (-60)</y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
        <show object="again" />
      </shows>
      <inputs>
        <input button="space">
          <reset />
        </input>
      </inputs>
    </state>
  </states>
</game>
