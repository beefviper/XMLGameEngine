<!-- backgammon.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Nov 22, 2026 -->

<!--
  Backgammon, for two at one keyboard. Red and white each have fifteen
  checkers and race them round the board in opposite ways, red along the
  bottom from the right, then back along the top; white the other way.
  Each turn a player rolls two dice and moves a checker as far as each
  die says (doubles: four times). A point holding two or more of the
  other side's checkers is closed; landing on a lone one hits it to the
  bar, from where it must come in again (into the far corner) before its
  side moves anything else. Once all fifteen are in the last six points
  they are borne off, into the tray on the right; the first to bear off
  all fifteen wins. As many dice as can be used must be, and the bigger
  when only one fits. A win is one point, two (a gammon) when the loser
  has borne off none, three (a backgammon) when the loser also still has
  one on the bar or in the winner's last six points, times the cube.

  Space rolls; then W A S D or the arrows move the cursor along the
  points, Space picks up a checker and puts it down, X or Backspace puts
  it back. Before rolling, C offers to double: the other player takes
  (Y), or drops (N) and loses what the cube says. Pause pauses. The
  score is kept from game to game.

  How it is written:
  * The board is a <map> of <cells> six tiles tall: each point is a cell,
    and the checkers on it stack in its tiles from the edge of the
    board, so the rows show the starting position.
  * Each side's <moves> give its <route>: its bar (<start>), the points
    in order as four runs of a row, and its tray (<end>, reached once all
    are within <home> of it). <steps> moves a checker as far as a die in
    `rolled` says and sends that die to `used`; <hit> sends a lone
    checker of the other side to its bar.
  * The dice are four held items whose worth <set> rolls. A roll puts two
    in `rolled`, and two more of the same worth on doubles.
  * The live number `along` is how far a checker is round its route: a
    side whose furthest back has reached the tray has won, and the
    loser's along says whether it is a gammon or a backgammon.
  * The table's looks are the turn's phases: rolling, moving, and stuck
    (dice left but no move: Space passes).
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../xgedef.xsd">
  <window name="Backgammon">
    <width>920</width>
    <height>640</height>
  </window>
  <variables>
    <variable name="tile">40</variable>
    <variable name="left">60</variable>
    <variable name="top">90</variable>
    <variable name="panel">670</variable>
  </variables>
  <styles>
    <style name="banner"><size>72</size><color>color.red</color></style>
    <style name="prompt"><size>32</size></style>
    <style name="help"><size>20</size><color>color.lightgrey</color></style>
    <style name="hud"><size>28</size></style>
    <style name="note"><size>22</size></style>
    <style name="redpiece"><scale>3</scale><color>color.red</color><color char="d">color.brown</color></style>
    <style name="whitepiece"><scale>3</scale><color>color.white</color><color char="d">color.lightgrey</color></style>
    <style name="die"><scale>3</scale><color char="w">color.white</color><color char="k">color.black</color></style>
  </styles>
  <keeps>
    <keep object="score" />
  </keeps>
  <states>
    <objects>
      <!-- points won so far, kept from game to game -->
      <object name="score">
        <variables>
          <variable name="red">0</variable>
          <variable name="white">0</variable>
        </variables>
      </object>
      <!-- who won the last game (0 red, 1 white) and how many points -->
      <object name="match">
        <variables>
          <variable name="winner">0</variable>
          <variable name="won">0</variable>
        </variables>
      </object>
      <object name="again">
        <sprite><text style="prompt"><content>spacebar to play again</content></text></sprite>
        <position><x><centered /></x><y><centered><offset>90</offset></centered></y></position>
      </object>
    </objects>
    <state name="title">
      <objects>
        <object name="title">
          <sprite><text style="banner"><content>BACKGAMMON</content></text></sprite>
          <position><x><centered /></x><y><centered><offset>-170</offset></centered></y></position>
        </object>
        <group name="help">
          <rows>5</rows>
          <padding><y>30</y></padding>
          <sprite><text style="help" /></sprite>
          <position><x><centered /></x><y><centered><offset>-80</offset></centered></y></position>
          <row number="1"><sprite><text><content>two players at one keyboard, red first</content></text></sprite></row>
          <row number="2"><sprite><text><content>spacebar rolls, then picks up a checker and puts it down</content></text></sprite></row>
          <row number="3"><sprite><text><content>w a s d or the arrows move along the points, x or backspace puts back</content></text></sprite></row>
          <row number="4"><sprite><text><content>c before rolling offers to double: y takes, n drops</content></text></sprite></row>
          <row number="5"><sprite><text><content>pause key pauses</content></text></sprite></row>
        </group>
        <object name="start">
          <sprite><text style="prompt"><content>spacebar to start</content></text></sprite>
          <position><x><centered /></x><y><centered><offset>140</offset></centered></y></position>
        </object>
      </objects>
      <inputs>
        <input><button>space</button><button>pad1.start</button><push state="playing" /></input>
      </inputs>
    </state>
    <state name="playing">
      <objects>
        <!-- the players, red first: each the words over the board on its turn -->
        <group name="players">
          <sprite name="playing" />
          <sprite name="waiting" />
          <position><x>left</x><y>30</y></position>
          <turns sprite="waiting" />
          <member name="redside">
            <sprite name="playing"><text style="hud"><content>red to play</content><color>color.red</color></text></sprite>
            <owns class="red" />
          </member>
          <member name="whiteside">
            <sprite name="playing"><text style="hud"><content>white to play</content></text></sprite>
            <owns class="white" />
          </member>
        </group>

        <!-- the phase of the turn, and the words saying what Space does -->
        <object name="table">
          <sprite name="rolling"><text style="note"><content>spacebar rolls, c doubles</content></text></sprite>
          <sprite name="moving"><text style="note"><content>move a checker</content></text></sprite>
          <sprite name="stuck"><text style="note"><content>no move: spacebar passes</content><color>color.yellow</color></text></sprite>
          <position><x>panel</x><y>110</y></position>
          <actions>
            <!-- two dice rolled, and two more of the same on doubles -->
            <action name="roll">
              <condition object="rolled" variable="held"><above>0</above><send from="rolled" into="used"><all /></send></condition>
              <trigger object="dice" action="clear" />
              <send from="used" into="rolled">2</send>
              <trigger object="dice.3" action="roll" />
              <trigger object="dice.4" action="roll" />
              <condition object="dice.3" variable="worth"><equal>dice.4.worth</equal>
                <send from="used" into="rolled">2</send>
                <copy variable="dice.3.worth" into="dice.1.worth" />
                <copy variable="dice.3.worth" into="dice.2.worth" />
                <trigger object="dice.1" action="show" />
                <trigger object="dice.2" action="show" />
              </condition>
              <play sound="roll" />
              <become sprite="moving" />
            </action>
            <action name="pass">
              <pass object="players" />
              <become sprite="rolling" />
            </action>
            <action name="offer">
              <copy variable="cube.yours" into="cube.asked" />
            </action>
          </actions>
        </object>

        <!-- the doubling cube: its value, and who may double next (0 either, 1 red, 2 white) -->
        <object name="cube">
          <sprite><text style="note"><content>cube</content><number>cube.value</number><choose><by>cube.owner</by><word>in the middle</word><word>red's</word><word>white's</word></choose></text></sprite>
          <position><x>panel</x><y>420</y></position>
          <variables>
            <variable name="value">1</variable>
            <variable name="owner">0</variable>
            <!-- 1 once the player on turn has asked to double -->
            <variable name="asked">0</variable>
            <!-- the player on turn may double: the cube is theirs or in the middle, and below 64 -->
            <variable name="yours" update="live">
              <multiply>
                <value><compare><value>cube.value</value><below>64</below></compare></value>
                <value>
                  <add>
                    <value><compare><value>cube.owner</value><equal>0</equal></compare></value>
                    <value><multiply><value><compare><value>cube.owner</value><equal>1</equal></compare></value><value>redside.turn</value></multiply></value>
                    <value><multiply><value><compare><value>cube.owner</value><equal>2</equal></compare></value><value>whiteside.turn</value></multiply></value>
                  </add>
                </value>
              </multiply>
            </variable>
          </variables>
        </object>

        <object name="scores">
          <sprite><text style="note"><content>red</content><number>score.red</number><content>  white</content><number>score.white</number></text></sprite>
          <position><x>panel</x><y>470</y></position>
        </object>
        <object name="help">
          <sprite><text style="help"><content>spacebar picks up and puts down, x puts back</content></text></sprite>
          <position><x><centered /></x><y>590</y></position>
        </object>

        <!-- the board: its frame, the bar and the trays, then the points -->
        <object name="frame">
          <sprite><rectangle><width><add><value><multiply><value>tile</value><value>14</value></multiply></value><value>16</value></add></width>
            <height><add><value><multiply><value>tile</value><value>12</value></multiply></value><value>16</value></add></height><color>color.brown</color></rectangle></sprite>
          <position><x><subtract><value>left</value><value>8</value></subtract></x><y><subtract><value>top</value><value>8</value></subtract></y></position>
        </object>
        <object name="felt">
          <sprite><rectangle><width><multiply><value>tile</value><value>14</value></multiply></width><height><multiply><value>tile</value><value>12</value></multiply></height><color>color.darkgreen</color></rectangle></sprite>
          <position><x>left</x><y>top</y></position>
        </object>
        <group name="dividers">
          <columns>2</columns>
          <padding><x><multiply><value>tile</value><value>7</value></multiply></x></padding>
          <sprite><rectangle><width>tile</width><height><multiply><value>tile</value><value>12</value></multiply></height><color>color.brown</color></rectangle></sprite>
          <position><x><add><value>left</value><value><multiply><value>tile</value><value>6</value></multiply></value></add></x><y>top</y></position>
        </group>

        <!-- the points, a cell each, pointing in from the edges -->
        <map name="points">
          <tile><width>tile</width><height><multiply><value>tile</value><value>6</value></multiply></height></tile>
          <position><x>left</x><y>top</y></position>
          <row>ababab.ababab.</row>
          <row>cdcdcd.cdcdcd.</row>
          <group name="downlight" char="a"><sprite><drawing from="down-light" /></sprite></group>
          <group name="downdark" char="b"><sprite><drawing from="down-dark" /></sprite></group>
          <group name="uplight" char="d"><sprite><drawing from="up-light" /></sprite></group>
          <group name="updark" char="c"><sprite><drawing from="up-dark" /></sprite></group>
        </map>

        <!--
          The checkers, as they start: a point is a cell six tiles tall.
          Column 7 is the bar (red's below, white's above), column 14 the
          trays (red's above, white's below).
        -->
        <map name="board">
          <tile><width>tile</width><height>tile</height></tile>
          <position><x>left</x><y>top</y></position>
          <cells><height>6</height></cells>
          <row>w...r..r....w.</row>
          <row>w...r..r....w.</row>
          <row>w...r..r......</row>
          <row>w......r......</row>
          <row>w......r......</row>
          <row>..............</row>
          <row>..............</row>
          <row>r......w......</row>
          <row>r......w......</row>
          <row>r...w..w......</row>
          <row>r...w..w....r.</row>
          <row>r...w..w....r.</row>

          <group name="reds" class="red" char="r">
            <sprite><bitmap from="red-checker" /></sprite>
            <moves>
              <route>
                <start><column>7</column><row>2</row></start>
                <row number="2"><from>13</from><to>8</to></row>
                <row number="2"><from>6</from><to>1</to></row>
                <row number="1"><from>1</from><to>6</to></row>
                <row number="1"><from>8</from><to>13</to></row>
                <end><column>14</column><row>1</row><home>6</home></end>
              </route>
              <steps holder="rolled" into="used" />
              <hit class="white" />
            </moves>
          </group>
          <group name="whites" class="white" char="w">
            <sprite><bitmap from="white-checker" /></sprite>
            <moves>
              <route>
                <start><column>7</column><row>1</row></start>
                <row number="1"><from>13</from><to>8</to></row>
                <row number="1"><from>6</from><to>1</to></row>
                <row number="2"><from>1</from><to>6</to></row>
                <row number="2"><from>8</from><to>13</to></row>
                <end><column>14</column><row>2</row><home>6</home></end>
              </route>
              <steps holder="rolled" into="used" />
              <hit class="red" />
            </moves>
          </group>
        </map>

        <!-- where the checker held can go, on a map of their own -->
        <map name="marks">
          <tile><width>tile</width><height>tile</height></tile>
          <position><x>left</x><y>top</y></position>
          <columns>14</columns>
          <rows>12</rows>
          <cells><height>6</height></cells>
          <object name="movemark">
            <sprite><circle><radius>8</radius><color>color.yellow</color></circle></sprite>
          </object>
          <object name="heldmark">
            <sprite><circle><radius>5</radius><color>color.cyan</color></circle></sprite>
          </object>
        </map>

        <!-- the cursor: a frame round a point -->
        <map name="pointer">
          <tile><width>tile</width><height>tile</height></tile>
          <position><x>left</x><y>top</y></position>
          <cells><height>6</height></cells>
          <row>..............</row>
          <row>..............</row>
          <row>..............</row>
          <row>..............</row>
          <row>..............</row>
          <row>..............</row>
          <row>..............</row>
          <row>..............</row>
          <row>..............</row>
          <row>..............</row>
          <row>..............</row>
          <row>............c.</row>
          <object name="cursor" char="c">
            <sprite name="free"><drawing from="frame-free" /></sprite>
            <sprite name="held"><drawing from="frame-held" /></sprite>
            <marks sprite="held">
              <held object="heldmark" />
              <moves object="movemark" />
            </marks>
            <actions>
              <action name="up"><hop direction="up" /></action>
              <action name="down"><hop direction="down" /></action>
              <action name="left"><hop direction="left" /></action>
              <action name="right"><hop direction="right" /></action>
              <action name="pick"><pick /><become sprite="held" /><play sound="pick" /></action>
              <action name="back"><drop /><become sprite="free" /></action>
              <action name="place"><place /><play sound="move" /><become sprite="free" /></action>
            </actions>
          </object>
        </map>

        <!-- the dice: four, two rolled and two more on doubles -->
        <group name="dice" class="die">
          <columns>4</columns>
          <sprite name="blank"><bitmap from="blank" /></sprite>
          <sprite name="one"><bitmap from="one" /></sprite>
          <sprite name="two"><bitmap from="two" /></sprite>
          <sprite name="three"><bitmap from="three" /></sprite>
          <sprite name="four"><bitmap from="four" /></sprite>
          <sprite name="five"><bitmap from="five" /></sprite>
          <sprite name="six"><bitmap from="six" /></sprite>
          <position><x>0</x><y>0</y></position>
          <actions>
            <action name="roll">
              <set variable="self.worth"><smallest><value><floor><value><random><min>1</min><max>7</max></random></value></floor></value><value>6</value></smallest></set>
              <trigger action="show" />
            </action>
            <!-- not rolled this turn: no number -->
            <action name="clear">
              <set variable="self.worth">0</set>
              <become sprite="blank" />
            </action>
            <action name="show">
              <condition variable="worth"><equal>1</equal><become sprite="one" /></condition>
              <condition variable="worth"><equal>2</equal><become sprite="two" /></condition>
              <condition variable="worth"><equal>3</equal><become sprite="three" /></condition>
              <condition variable="worth"><equal>4</equal><become sprite="four" /></condition>
              <condition variable="worth"><equal>5</equal><become sprite="five" /></condition>
              <condition variable="worth"><equal>6</equal><become sprite="six" /></condition>
            </action>
          </actions>
        </group>
        <!-- the dice to play, and those played or not rolled -->
        <object name="rolled">
          <sprite name="spot" />
          <position><x>panel</x><y>170</y></position>
          <holds class="die"><spread><x>56</x></spread><order><by variable="column" /></order></holds>
        </object>
        <object name="usedwords">
          <sprite><text style="help"><content>played</content></text></sprite>
          <position><x>panel</x><y>250</y></position>
        </object>
        <object name="used">
          <sprite name="spot" />
          <position><x>panel</x><y>280</y></position>
          <holds class="die"><spread><x>56</x></spread><order><by variable="column" /></order></holds>
        </object>
      </objects>
      <starts>
        <send from="dice" into="used"><all /></send>
      </starts>
      <inputs>
        <input><button>w</button><button>up</button><button>pad1.up</button><trigger object="cursor" action="up" /></input>
        <input><button>s</button><button>down</button><button>pad1.down</button><trigger object="cursor" action="down" /></input>
        <input><button>a</button><button>left</button><button>pad1.left</button><trigger object="cursor" action="left" /></input>
        <input><button>d</button><button>right</button><button>pad1.right</button><trigger object="cursor" action="right" /></input>
        <!-- one press: put the checker held down (or take up the one pointed at), take one up, roll, or pass -->
        <input>
          <button>space</button><button>pad1.a</button>
          <trigger object="cursor" action="place" from="held">
            <otherwise><trigger object="cursor" action="pick" /></otherwise>
          </trigger>
          <trigger object="cursor" action="pick" from="free" />
          <trigger object="table" action="roll" from="rolling" />
          <trigger object="table" action="pass" from="stuck" />
        </input>
        <input>
          <button>x</button><button>backspace</button><button>pad1.b</button>
          <trigger object="cursor" action="back" from="held" />
        </input>
        <input button="c"><trigger object="table" action="offer" from="rolling" /></input>
        <input><button>pause</button><button>pad1.start</button><push state="paused" /></input>
      </inputs>
      <conditions>
        <!-- all fifteen borne off: a win, a gammon or a backgammon, times the cube -->
        <condition class="red" variable="along" total="lowest"><equal>25</equal>
          <first><set variable="match.winner">0</set><play sound="win" /></first>
          <condition class="white" variable="along" total="highest"><below>25</below>
            <condition class="white" variable="along" total="lowest"><atmost>6</atmost>
              <set variable="match.won"><multiply><value>cube.value</value><value>3</value></multiply></set>
              <inc variable="score.red">match.won</inc>
              <push state="over" />
            </condition>
            <otherwise>
              <set variable="match.won"><multiply><value>cube.value</value><value>2</value></multiply></set>
              <inc variable="score.red">match.won</inc>
              <push state="over" />
            </otherwise>
          </condition>
          <otherwise>
            <set variable="match.won">cube.value</set>
            <inc variable="score.red">match.won</inc>
            <push state="over" />
          </otherwise>
        </condition>
        <condition class="white" variable="along" total="lowest"><equal>25</equal>
          <first><set variable="match.winner">1</set><play sound="win" /></first>
          <condition class="red" variable="along" total="highest"><below>25</below>
            <condition class="red" variable="along" total="lowest"><atmost>6</atmost>
              <set variable="match.won"><multiply><value>cube.value</value><value>3</value></multiply></set>
              <inc variable="score.white">match.won</inc>
              <push state="over" />
            </condition>
            <otherwise>
              <set variable="match.won"><multiply><value>cube.value</value><value>2</value></multiply></set>
              <inc variable="score.white">match.won</inc>
              <push state="over" />
            </otherwise>
          </condition>
          <otherwise>
            <set variable="match.won">cube.value</set>
            <inc variable="score.white">match.won</inc>
            <push state="over" />
          </otherwise>
        </condition>
        <!-- a double offered: the other player answers -->
        <condition object="cube" variable="asked"><equal>1</equal>
          <set variable="cube.asked">0</set>
          <push state="offered" />
        </condition>
        <!-- every die played: the turn passes -->
        <condition object="table" sprite="moving">
          <condition object="rolled" variable="held"><equal>0</equal><trigger object="table" action="pass" /></condition>
          <!-- dice left that no checker of the player on turn can use -->
          <condition object="redside" variable="turn"><equal>1</equal>
            <condition class="red" variable="moves" total="sum"><equal>0</equal><become object="table" sprite="stuck" /></condition>
          </condition>
          <condition object="whiteside" variable="turn"><equal>1</equal>
            <condition class="white" variable="moves" total="sum"><equal>0</equal><become object="table" sprite="stuck" /></condition>
          </condition>
        </condition>
      </conditions>
    </state>
    <state name="offered">
      <objects>
        <object name="offer">
          <sprite><text style="prompt"><content>double offered: y takes, n drops</content><color>color.yellow</color></text></sprite>
          <position><x><centered /></x><y>560</y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <!-- taken: the cube doubles, and the taker may double next -->
        <input button="y">
          <set variable="cube.value"><multiply><value>cube.value</value><value>2</value></multiply></set>
          <set variable="cube.owner"><add><value>1</value><value>redside.turn</value></add></set>
          <play sound="take" />
          <pop />
        </input>
        <!-- dropped: the player who doubled wins what the cube said -->
        <input button="n">
          <set variable="match.winner">whiteside.turn</set>
          <set variable="match.won">cube.value</set>
          <set variable="score.red"><add><value>score.red</value><value><multiply><value>cube.value</value><value>redside.turn</value></multiply></value></add></set>
          <set variable="score.white"><add><value>score.white</value><value><multiply><value>cube.value</value><value>whiteside.turn</value></multiply></value></add></set>
          <play sound="win" />
          <pop />
          <push state="over" />
        </input>
        <input><button>pause</button><button>pad1.start</button><push state="paused" /></input>
      </inputs>
    </state>
    <state name="paused">
      <objects>
        <object name="paused">
          <sprite><text style="banner"><content>PAUSED</content><color>color.white</color></text></sprite>
          <position><x><centered /></x><y><centered /></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input><button>pause</button><button>pad1.start</button><pop /></input>
      </inputs>
    </state>
    <state name="over">
      <objects>
        <object name="winner">
          <sprite><text style="banner"><choose><by>match.winner</by><word>RED</word><word>WHITE</word></choose><content>WINS</content></text></sprite>
          <position><x><centered /></x><y><centered><offset>-40</offset></centered></y></position>
        </object>
        <object name="points">
