<!-- checkers.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Oct 31, 2026 -->

<!--
  Checkers (draughts): red and white take turns on an eight by eight
  board, red first; you play red against the computer, or two players
  share the keyboard. A man steps one square on
  a slant towards the other side; a jump over an enemy piece into the
  empty square beyond takes it. A jump that can be made must be, and a
  piece that can jump again after a jump must go on. A man reaching the
  far row is crowned a king, which moves and jumps backwards as well, and
  its move ends there. A side with no pieces left, or no move to make on
  its turn, has lost.

  W A S D or the arrows move the cursor; Space picks up the piece under
  it, and puts it down where the cursor is. Space on another of your own
  pieces picks that one instead, and X or Backspace puts it back (neither
  in the middle of a run of jumps). The mouse works too: the cursor
  follows it, a left click is Space and a right click puts back.
  Pause pauses. On the title, Space plays the computer and 2 is
  for two players, and M, V and J turn on or off: showing where the piece
  held can go, showing which pieces can move, and picking up the piece
  for you when it is the only one that can move (a jump that must be
  made). The options are kept. Space plays again.

  How it is written:
  * The board is a <map> of <cells />: r red men, w white men. Each side
    is a group whose <moves> say how its men go, and a second <moves
    sprite="king"> how its kings go; <forced /> makes a jump the only
    move while one can be made, and <promote sprite="king"> crowns.
  * The cursor is on a map of its own, the same size over the board, so
    it walks over the pieces without touching them. <pick /> takes
    up the piece under it of the player on its turn; <place /> makes the move ending
    where it is. A place that is no move is refused, and so is one that
    must jump on, so the turn passes (the commands after it) only when
    the move is over.
  * The players are a group that takes <turns>: red <owns> the class
    red and white the class white, so one cursor serves both, and the
    words above the board are the player on its turn. <pass> after the
    place hands the turn on. The cursor's looks say whether it holds a
    piece; Space triggers the action for the look it shows.
  * A side is stuck when the live number `moves` of its pieces adds up to
    nothing on its turn.
  * The cursor's <marks> put pieces of the marks map in cells: a ring on
    the piece held, a dot where it can go, a dot on each piece that can
    move, corners on the last move's two cells. Each look has its set;
    the options turn some on and off by their variable=.
  * <drop /> puts back the piece held; <pick><only /></pick>
    picks the one piece that can move, when only one can.
  * <track /> on a piece on cells puts it in the cell under the mouse.
  * The computer plays white with <think>: it looks four moves ahead,
    a king worth three men, then walks the cursor and presses Space;
    your keys do not reach the cursor on its turn.
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../xgedef.xsd">
  <window name="Checkers">
    <width>800</width>
    <height>600</height>
  </window>
  <variables>
    <variable name="square">60</variable>
    <variable name="left">160</variable>
    <variable name="top">80</variable>
  </variables>
  <styles>
    <style name="banner"><size>80</size><color>color.red</color></style>
    <style name="prompt"><size>32</size></style>
    <style name="help"><size>22</size><color>color.lightgrey</color></style>
    <style name="hud"><size>32</size></style>
    <style name="redpiece">
      <scale>4</scale>
      <color>color.red</color>
      <color char="d">color.brown</color>
      <color char="y">color.yellow</color>
    </style>
    <style name="whitepiece">
      <scale>4</scale>
      <color>color.white</color>
      <color char="d">color.lightgrey</color>
      <color char="y">color.yellow</color>
    </style>
    <style name="cursor"><scale>6</scale><color>color.yellow</color></style>
    <style name="option"><size>22</size></style>
  </styles>
  <keeps>
    <keep object="options" />
  </keeps>
  <states>
    <objects>
      <!-- how many play: 1 against the computer, 2 at one keyboard -->
      <object name="match">
        <variables><variable name="players">1</variable></variables>
      </object>
      <!-- the player's options, kept: 1 on, 0 off -->
      <object name="options">
        <variables>
          <variable name="moves">1</variable>
          <variable name="movable">0</variable>
          <variable name="jumper">0</variable>
        </variables>
      </object>
      <object name="again">
        <sprite><text style="prompt"><content>spacebar to play again</content></text></sprite>
        <position><x><centered /></x><y><centered><offset>70</offset></centered></y></position>
      </object>
    </objects>
    <state name="title">
      <objects>
        <object name="title">
          <sprite><text style="banner"><content>CHECKERS</content></text></sprite>
          <position><x><centered /></x><y><centered><offset>-170</offset></centered></y></position>
        </object>
        <group name="help">
          <rows>3</rows>
          <padding><y>30</y></padding>
          <sprite><text style="help" /></sprite>
          <position><x><centered /></x><y><centered><offset>-90</offset></centered></y></position>
          <row number="1"><sprite><text><content>you play red, and move first; 2 for two players</content></text></sprite></row>
          <row number="2"><sprite><text><content>w a s d or the arrows move, spacebar picks up and puts down</content></text></sprite></row>
          <row number="3"><sprite><text><content>x or backspace puts back, pause key pauses; or click, and right click to put back</content></text></sprite></row>
        </group>
        <group name="choices">
          <rows>3</rows>
          <padding><y>30</y></padding>
          <sprite><text style="option" /></sprite>
          <position><x><centered /></x><y><centered><offset>30</offset></centered></y></position>
          <row number="1"><sprite><text><content>m: show where it can go</content><choose><by>options.moves</by><word>off</word><word>on</word></choose></text></sprite></row>
          <row number="2"><sprite><text><content>v: show which pieces can move</content><choose><by>options.movable</by><word>off</word><word>on</word></choose></text></sprite></row>
          <row number="3"><sprite><text><content>j: pick up the only piece that can move</content><choose><by>options.jumper</by><word>off</word><word>on</word></choose></text></sprite></row>
        </group>
        <object name="start">
          <sprite><text style="prompt"><content>spacebar to start</content></text></sprite>
          <position><x><centered /></x><y><centered><offset>170</offset></centered></y></position>
        </object>
      </objects>
      <inputs>
        <input><button>space</button><button>pad1.start</button><set variable="match.players">1</set><push state="playing" /></input>
        <input><button>num2</button><button>numpad2</button><set variable="match.players">2</set><push state="playing" /></input>
        <input button="m"><set variable="options.moves">1 - options.moves</set></input>
        <input button="v"><set variable="options.movable">1 - options.movable</set></input>
        <input button="j"><set variable="options.jumper">1 - options.jumper</set></input>
      </inputs>
    </state>
    <state name="playing">
      <objects>
        <!-- the players, red first: each the words over the board on its turn, nothing off it -->
        <group name="players">
          <sprite name="moving" />
          <sprite name="waiting" />
          <position><x><centered /></x><y>24</y></position>
          <turns sprite="waiting" />
          <member name="reds">
            <sprite name="moving"><text style="hud"><content>red to move</content><color>color.red</color></text></sprite>
            <owns class="red" />
          </member>
          <member name="whites">
            <sprite name="moving"><text style="hud"><content>white to move</content></text></sprite>
            <owns class="white" />
          </member>
        </group>
        <object name="frame">
          <sprite><rectangle><width>square * 8 + 16</width><height>square * 8 + 16</height><color>color.brown</color></rectangle></sprite>
          <position><x>left - 8</x><y>top - 8</y></position>
        </object>
        <object name="squares">
          <sprite>
            <bitmap from="squares" />
          </sprite>
          <position><x>left</x><y>top</y></position>
        </object>

        <map name="board">
          <tile><width>square</width><height>square</height></tile>
          <position><x>left</x><y>top</y></position>
          <cells />
          <row>.w.w.w.w</row>
          <row>w.w.w.w.</row>
          <row>.w.w.w.w</row>
          <row>........</row>
          <row>........</row>
          <row>r.r.r.r.</row>
          <row>.r.r.r.r</row>
          <row>r.r.r.r.</row>

          <!-- red starts at the bottom and goes up the board -->
          <group name="red" class="red" char="r">
            <sprite name="man">
              <bitmap from="red-man" />
            </sprite>
            <sprite name="king">
              <bitmap from="red-king" />
            </sprite>
            <moves>
              <forced />
              <step><x>-1</x><y>-1</y></step>
              <step><x>1</x><y>-1</y></step>
              <jump class="white"><x>-1</x><y>-1</y></jump>
              <jump class="white"><x>1</x><y>-1</y></jump>
              <promote sprite="king"><row>1</row></promote>
            </moves>
            <moves sprite="king">
              <forced />
              <step><x>-1</x><y>-1</y></step>
              <step><x>1</x><y>-1</y></step>
              <step><x>-1</x><y>1</y></step>
              <step><x>1</x><y>1</y></step>
              <jump class="white"><x>-1</x><y>-1</y></jump>
              <jump class="white"><x>1</x><y>-1</y></jump>
              <jump class="white"><x>-1</x><y>1</y></jump>
              <jump class="white"><x>1</x><y>1</y></jump>
            </moves>
          </group>

          <!-- white starts at the top and goes down -->
          <group name="white" class="white" char="w">
            <sprite name="man">
              <bitmap from="white-man" />
            </sprite>
            <sprite name="king">
              <bitmap from="white-king" />
            </sprite>
            <moves>
              <forced />
              <step><x>-1</x><y>1</y></step>
              <step><x>1</x><y>1</y></step>
              <jump class="red"><x>-1</x><y>1</y></jump>
              <jump class="red"><x>1</x><y>1</y></jump>
              <promote sprite="king"><row>8</row></promote>
            </moves>
            <moves sprite="king">
              <forced />
              <step><x>-1</x><y>-1</y></step>
              <step><x>1</x><y>-1</y></step>
              <step><x>-1</x><y>1</y></step>
              <step><x>1</x><y>1</y></step>
              <jump class="red"><x>-1</x><y>-1</y></jump>
              <jump class="red"><x>1</x><y>-1</y></jump>
              <jump class="red"><x>-1</x><y>1</y></jump>
              <jump class="red"><x>1</x><y>1</y></jump>
            </moves>
          </group>
        </map>

        <!-- what the cursor marks, on a map of their own: copies of these are put in the cells marked -->
        <map name="marks">
          <tile><width>square</width><height>square</height></tile>
          <position><x>left</x><y>top</y></position>
          <columns>8</columns>
          <rows>8</rows>
          <cells />
          <object name="heldmark">
            <sprite>
              <bitmap from="heldmark" />
            </sprite>
          </object>
          <object name="movemark">
            <sprite><circle><radius>9</radius><color>color.yellow</color></circle></sprite>
          </object>
          <object name="movablemark">
            <sprite><circle><radius>6</radius><color>color.cyan</color></circle></sprite>
          </object>
          <object name="lastmark">
            <sprite>
              <bitmap from="lastmark" />
            </sprite>
          </object>
        </map>

        <!-- the cursor, on a map of its own over the board -->
        <map name="pointer">
          <tile><width>square</width><height>square</height></tile>
          <position><x>left</x><y>top</y></position>
          <cells />
          <row>........</row>
          <row>........</row>
          <row>........</row>
          <row>........</row>
          <row>........</row>
          <row>..c.....</row>
          <row>........</row>
          <row>........</row>

          <object name="cursor" char="c">
            <sprite name="free">
              <bitmap from="cursor-free" />
            </sprite>
            <sprite name="held">
              <bitmap from="cursor-held" />
            </sprite>
            <marks>
              <last object="lastmark" />
            </marks>
            <marks sprite="free">
              <movable object="movablemark" variable="options.movable" />
            </marks>
            <marks sprite="held">
              <held object="heldmark" />
              <moves object="movemark" variable="options.moves" />
            </marks>
            <actions>
              <action name="up"><hop direction="up" /></action>
              <action name="down"><hop direction="down" /></action>
              <action name="left"><hop direction="left" /></action>
              <action name="right"><hop direction="right" /></action>

              <!-- a piece of the player on its turn taken up -->
              <action name="pick"><pick /><become sprite="held" /><play sound="pick" /></action>
              <!-- the only piece that can move, picked for you -->
              <action name="only"><pick><only /></pick><become sprite="held" /><play sound="pick" /></action>
              <!-- put back -->
              <action name="back"><drop /><become sprite="free" /></action>
              <!-- where the mouse is -->
              <action name="point"><track /></action>
              <!-- the move made and over: the turn passes -->
              <action name="place">
                <place />
                <play sound="move" />
                <become sprite="free" />
                <pass object="players" />
              </action>
            </actions>
          </object>
        </map>
      </objects>
      <inputs>
        <input><button>w</button><button>up</button><button>pad1.up</button><trigger object="cursor" action="up" /></input>
        <input><button>s</button><button>down</button><button>pad1.down</button><trigger object="cursor" action="down" /></input>
        <input><button>a</button><button>left</button><button>pad1.left</button><trigger object="cursor" action="left" /></input>
        <input><button>d</button><button>right</button><button>pad1.right</button><trigger object="cursor" action="right" /></input>
        <!-- one press: put the piece held down, or take one up (another of your own while holding one) -->
        <input>
          <button>space</button><button>pad1.a</button><button>mouse.left</button>
          <!-- holding a piece: lay it, or if it may not go there, take the one pointed at instead -->
          <trigger object="cursor" action="place" from="held">
            <otherwise><trigger object="cursor" action="pick" /></otherwise>
          </trigger>
          <trigger object="cursor" action="pick" from="free" />
        </input>
        <input>
          <button>x</button><button>backspace</button><button>pad1.b</button><button>mouse.right</button>
          <trigger object="cursor" action="back" from="held" />
        </input>
        <input axis="mouse.x"><trigger object="cursor" action="point" /></input>
        <input axis="mouse.y"><trigger object="cursor" action="point" /></input>
        <input><button>pause</button><button>pad1.start</button><push state="paused" /></input>
      </inputs>
      <conditions>
        <!-- a side with no move on its turn (none left, or all blocked) has lost -->
        <condition object="whites" variable="turn"><equal>1</equal>
          <condition class="white" variable="moves" total="sum"><equal>0</equal>
            <become object="over.winner" sprite="red" />
            <play sound="win" />
            <push state="over" />
          </condition>
        </condition>
        <condition object="reds" variable="turn"><equal>1</equal>
          <condition class="red" variable="moves" total="sum"><equal>0</equal>
            <become object="over.winner" sprite="white" />
            <play sound="win" />
            <push state="over" />
          </condition>
        </condition>
        <!-- the option: the only piece that can move is picked up for you (never for the computer) -->
        <condition object="options" variable="jumper"><equal>1</equal>
          <condition object="reds" variable="turn"><equal>1</equal><trigger object="cursor" action="only" from="free" /></condition>
          <condition object="match" variable="players"><equal>2</equal><trigger object="cursor" action="only" from="free" /></condition>
        </condition>
      </conditions>
      <!-- white's move: four ahead, a king worth three men -->
      <computer>
        <condition object="match" variable="players"><equal>1</equal>
          <condition object="whites" variable="turn"><equal>1</equal>
            <think object="cursor" button="space">
              <depth>4</depth>
              <worth sprite="king">3</worth>
            </think>
          </condition>
        </condition>
      </computer>
    </state>
    <state name="paused">
      <objects>
        <object name="paused">
          <sprite><text style="banner"><content>PAUSED</content><color>color.white</color></text></sprite>
          <position><x><centered /></x><y><centered /></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input><button>pause</button><button>pad1.start</button><pop /></input>
      </inputs>
    </state>
    <state name="over">
      <objects>
        <object name="winner">
          <sprite name="red"><text style="banner"><content>RED WINS</content><color>color.red</color></text></sprite>
          <sprite name="white"><text style="banner"><content>WHITE WINS</content><color>color.white</color></text></sprite>
          <position><x><centered /></x><y><centered><offset>-40</offset></centered></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
        <show object="again" />
      </shows>
      <inputs>
        <input><button>space</button><button>pad1.start</button><reset /></input>
      </inputs>
    </state>
  </states>
  <sounds>
    <sound name="pick"><note pitch="E5">0.03</note></sound>
    <sound name="move" wave="triangle"><note pitch="C4">0.05</note></sound>
    <sound name="win">
      <note pitch="C5">0.12</note>
      <note pitch="E5">0.12</note>
      <note pitch="G5">0.12</note>
      <note pitch="C6">0.4</note>
    </sound>
  </sounds>
  <pictures>
    <bitmap name="squares">
      <row>l*l*l*l*</row>
      <row>*l*l*l*l</row>
      <row>l*l*l*l*</row>
      <row>*l*l*l*l</row>
      <row>l*l*l*l*</row>
      <row>*l*l*l*l</row>
      <row>l*l*l*l*</row>
      <row>*l*l*l*l</row>
      <scale>square</scale>
      <color>color.darkgreen</color>
      <color char="l">color.lightgrey</color>
    </bitmap>
    <bitmap name="red-man" style="redpiece">
      <row>....*****....</row>
      <row>..*********..</row>
      <row>.***********.</row>
      <row>.***ddddd***.</row>
      <row>***d*****d***</row>
      <row>***d*****d***</row>
      <row>***d*****d***</row>
      <row>***d*****d***</row>
      <row>***d*****d***</row>
      <row>.***ddddd***.</row>
      <row>.***********.</row>
      <row>..*********..</row>
      <row>....*****....</row>
    </bitmap>
    <bitmap name="red-king" style="redpiece">
      <row>....*****....</row>
      <row>..*********..</row>
      <row>.***********.</row>
      <row>.**y**y**y**.</row>
      <row>***yy*y*yy***</row>
      <row>***yyyyyyy***</row>
      <row>***yyyyyyy***</row>
      <row>***yyyyyyy***</row>
      <row>*************</row>
      <row>.***********.</row>
      <row>.***********.</row>
      <row>..*********..</row>
      <row>....*****....</row>
    </bitmap>
    <bitmap name="white-man" style="whitepiece">
      <row>....*****....</row>
      <row>..*********..</row>
      <row>.***********.</row>
      <row>.***ddddd***.</row>
      <row>***d*****d***</row>
      <row>***d*****d***</row>
      <row>***d*****d***</row>
      <row>***d*****d***</row>
      <row>***d*****d***</row>
      <row>.***ddddd***.</row>
      <row>.***********.</row>
      <row>..*********..</row>
      <row>....*****....</row>
    </bitmap>
    <bitmap name="white-king" style="whitepiece">
      <row>....*****....</row>
      <row>..*********..</row>
      <row>.***********.</row>
      <row>.**y**y**y**.</row>
      <row>***yy*y*yy***</row>
      <row>***yyyyyyy***</row>
      <row>***yyyyyyy***</row>
      <row>***yyyyyyy***</row>
      <row>*************</row>
      <row>.***********.</row>
      <row>.***********.</row>
      <row>..*********..</row>
      <row>....*****....</row>
    </bitmap>
    <bitmap name="heldmark" style="cursor">
      <row>....*****....</row>
      <row>..**.....**..</row>
      <row>.*.........*.</row>
      <row>.*.........*.</row>
      <row>*...........*</row>
      <row>*...........*</row>
      <row>*...........*</row>
      <row>*...........*</row>
      <row>*...........*</row>
      <row>.*.........*.</row>
      <row>.*.........*.</row>
      <row>..**.....**..</row>
      <row>....*****....</row>
      <scale>5</scale>
    </bitmap>
    <bitmap name="lastmark">
      <row>**......**</row>
      <row>*........*</row>
      <row>..........</row>
      <row>..........</row>
      <row>..........</row>
      <row>..........</row>
      <row>..........</row>
      <row>..........</row>
      <row>*........*</row>
      <row>**......**</row>
      <scale>6</scale>
      <color>color.orange</color>
    </bitmap>
    <bitmap name="cursor-free" style="cursor">
      <row>**********</row>
      <row>*........*</row>
      <row>*........*</row>
      <row>*........*</row>
      <row>*........*</row>
      <row>*........*</row>
      <row>*........*</row>
      <row>*........*</row>
      <row>*........*</row>
      <row>**********</row>
    </bitmap>
    <bitmap name="cursor-held" style="cursor">
      <row>**********</row>
      <row>**********</row>
      <row>**......**</row>
      <row>**......**</row>
      <row>**......**</row>
      <row>**......**</row>
      <row>**......**</row>
      <row>**......**</row>
      <row>**********</row>
      <row>**********</row>
    </bitmap>
  </pictures>
</game>
