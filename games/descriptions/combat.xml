<!-- combat.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Oct 7, 2026 -->

<!--
  Combat, after the tank game of the 1977 Atari 2600 cartridge that came with
  the console. Two players, a tank each, in a field of walls. A tank drives
  forward and back the way it points and turns on the spot, its engine
  rumbling; its shell flies straight from the gun until it hits a wall, a
  tank or the edge of the field, one shell in the air at a time. A hit is a
  point, and knocks the tank that was hit back across the field. The game
  lasts two minutes and sixteen seconds, as the cartridge's did; the most
  hits win.

  Player one: W and S drive, A and D turn, F or Left Shift fires.
  Player two: Up and Down drive, Left and Right turn, Right Shift or Right
  Control fires. Space pauses.

  How it is written:
  * The tanks are one group: the picture, the <drag>, the rules and the
    driving are said once. Each player's tank is a group inside it, giving
    its corner, its <heading> and the shell it fires, and the right one its
    colour. <thrust> and <turn> work along the heading, and the picture
    turns with it; the tanks are <type>pixel</type>, so a turned tank meets
    a wall where it is drawn.
  * The shells are one group too, each counting its own hits. A shell is a
    weight (<mass>), and the tank it hits <knock>s with it, so it is sent
    back the way the shell flew.
  * A state timer ends the game; the win screen's conditions pick its words,
    a look for each player and one for a draw.
  * Paused and the win screen draw the field still (<show state>).
  Not in it: guided and bouncing shells, the plane and jet games, invisible
  tanks, and the hit tank spinning.
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../xgedef.xsd">
  <window name="Combat">
    <width>640</width>
    <height>480</height>
    <background>color.darkgreen</background>
  </window>
  <variables>
    <variable name="margin">10</variable>
    <variable name="drive">0.3</variable>
    <variable name="back">-0.2</variable>
    <variable name="turnrate">3</variable>
    <variable name="shellspeed">6</variable>
  </variables>
  <sounds>
    <sound name="fire" wave="noise">
      <volume>0.25</volume>
      <note pitch="1500" to="300">0.15</note>
    </sound>
    <sound name="hit" wave="noise">
      <volume>0.45</volume>
      <note pitch="600" to="40">0.6</note>
    </sound>
    <sound name="thud"><volume>0.1</volume><note pitch="C3">0.04</note></sound>
    <!-- the engines, while a tank is driven -->
    <sound name="engine" wave="noise">
      <loop />
      <volume>0.12</volume>
      <note pitch="90">0.5</note>
    </sound>
  </sounds>
  <styles>
    <style name="banner"><size>100</size><color>color.yellow</color></style>
    <style name="prompt"><size>40</size><color>color.white</color></style>
    <style name="keys"><size>22</size><color>color.yellow</color></style>
    <style name="hud"><size>40</size><color>color.yellow</color></style>
  </styles>
  <states>
    <state name="title">
      <objects>
        <object name="title">
          <sprite><text style="banner"><content>COMBAT</content><size>110</size></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 140</centered></y></position>
        </object>
        <object name="help">
          <sprite><text style="prompt"><content>two players, the most hits in 2:16</content><size>30</size></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 50</centered></y></position>
        </object>
        <object name="keys1">
          <sprite><text style="keys"><content>yellow: w s drive, a d turn, f fires</content></text></sprite>
          <position><x><centered /></x><y><centered /></y></position>
        </object>
        <object name="keys2">
          <sprite><text style="keys"><content>blue: arrows drive and turn, right shift fires</content><color>color.cyan</color></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center + 35</centered></y></position>
        </object>
        <object name="start">
          <sprite><text style="prompt"><content>spacebar to start</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center + 120</centered></y></position>
        </object>
      </objects>
      <inputs>
        <input button="space"><push state="playing" /></input>
      </inputs>
    </state>
    <state name="playing">
      <objects>
        <!-- the field: a bar in the middle, the same either side, and a beam across each end -->
        <group name="walls" class="wall">
          <sprite><rectangle><width>20</width><height>100</height><color>color.orange</color></rectangle></sprite>
          <collisions />
          <member><sprite><rectangle><height>140</height></rectangle></sprite><position><x>310</x><y>170</y></position></member>
          <member><position><x>150</x><y>60</y></position></member>
          <member><position><x>150</x><y>320</y></position></member>
          <member><position><x>470</x><y>60</y></position></member>
          <member><position><x>470</x><y>320</y></position></member>
          <member><sprite><rectangle><width>100</width><height>20</height></rectangle></sprite><position><x>270</x><y>50</y></position></member>
          <member><sprite><rectangle><width>100</width><height>20</height></rectangle></sprite><position><x>270</x><y>410</y></position></member>
        </group>
        <group name="tanks" class="tank">
          <sprite>
            <bitmap>
              <row>.....*.....</row>
              <row>.....*.....</row>
              <row>.....*.....</row>
              <row>**..***..**</row>
              <row>**.*****.**</row>
              <row>***********</row>
              <row>**.*****.**</row>
              <row>**.*****.**</row>
              <row>***********</row>
              <row>**.......**</row>
              <row>**.......**</row>
              <scale>3</scale>
              <color>color.yellow</color>
            </bitmap>
          </sprite>
          <drag>0.15</drag>
          <mass>1</mass>
          <collisions>
            <type>pixel</type>
            <collision edge="all"><stick /></collision>
            <collision class="wall">
              <bounce />
              <play sound="thud" />
            </collision>
            <collision class="tank"><bounce /></collision>
            <collision class="shell">
              <knock />
              <play sound="hit" />
            </collision>
          </collisions>
          <actions>
            <action name="forward">
              <thrust>drive</thrust>
              <play sound="engine" />
            </action>
            <action name="back">
              <thrust>back</thrust>
              <play sound="engine" />
            </action>
            <action name="left"><turn direction="left">turnrate</turn></action>
            <action name="right"><turn direction="right">turnrate</turn></action>
          </actions>
          <group name="yellow">
            <position><x>40</x><y><centered /></y></position>
            <heading>90</heading>
            <actions><action name="fire"><fire object="shell1" /><play sound="fire" /></action></actions>
            <member name="tank1" />
          </group>
          <group name="blue">
            <sprite><bitmap><color>color.cyan</color></bitmap></sprite>
            <position><x><centered>window.right - 60</centered></x><y><centered /></y></position>
            <heading>270</heading>
            <actions><action name="fire"><fire object="shell2" /><play sound="fire" /></action></actions>
            <member name="tank2" />
          </group>
        </group>
        <!-- one shell each, out of play until it is fired -->
        <group name="shells" class="shell">
          <sprite><rectangle><width>4</width><height>4</height><color>color.yellow</color></rectangle></sprite>
          <position><x>0</x><y>0</y></position>
          <velocity><y>-shellspeed</y></velocity>
          <mass>1</mass>
          <active>false</active>
          <collisions>
            <enabled>false</enabled>
            <collision edge="all"><die /></collision>
            <collision class="wall"><die /></collision>
            <collision class="tank">
              <inc variable="self.hits" />
              <die />
            </collision>
          </collisions>
          <variables>
            <variable name="hits">0</variable>
          </variables>
          <member name="shell1" />
          <member name="shell2"><sprite><rectangle><color>color.cyan</color></rectangle></sprite></member>
        </group>
        <object name="score1">
          <sprite><text style="hud"><number>shell1.hits</number></text></sprite>
          <position><x>window.width.center - 80</x><y>margin</y></position>
        </object>
        <object name="score2">
          <sprite><text style="hud"><number>shell2.hits</number><color>color.cyan</color></text></sprite>
          <position><x>window.width.center + 80 - score2.width</x><y>margin</y></position>
        </object>
      </objects>
      <inputs>
        <input button="w"><trigger object="tank1" action="forward" /></input>
        <input button="s"><trigger object="tank1" action="back" /></input>
        <input button="a"><trigger object="tank1" action="left" /></input>
        <input button="d"><trigger object="tank1" action="right" /></input>
        <input button="f lshift"><trigger object="tank1" action="fire" /></input>
        <input button="up"><trigger object="tank2" action="forward" /></input>
        <input button="down"><trigger object="tank2" action="back" /></input>
        <input button="left"><trigger object="tank2" action="left" /></input>
        <input button="right"><trigger object="tank2" action="right" /></input>
        <input button="rshift rcontrol"><trigger object="tank2" action="fire" /></input>
        <input button="space p escape"><push state="paused" /></input>
      </inputs>
      <timers>
        <timer><after>136</after><push state="wins" /></timer>
      </timers>
    </state>
    <state name="paused">
      <objects>
        <object name="paused">
          <sprite><text style="banner"><content>PAUSED</content><color>color.white</color></text></sprite>
          <position><x><centered /></x><y><centered /></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input button="space p escape"><pop /></input>
      </inputs>
    </state>
    <state name="wins">
      <objects>
        <object name="winner">
          <sprite name="draw"><text style="banner"><content>A DRAW</content><color>color.white</color></text></sprite>
          <sprite name="yellow"><text style="banner"><content>YELLOW WINS</content><size>90</size></text></sprite>
          <sprite name="blue"><text style="banner"><content>BLUE WINS</content><size>90</size><color>color.cyan</color></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 60</centered></y></position>
        </object>
        <object name="again">
          <sprite><text style="prompt"><content>spacebar to play again</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center + 70</centered></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input button="space"><reset /></input>
      </inputs>
      <conditions>
        <condition object="shell1" variable="hits">
          <above>shell2.hits</above>
          <become object="winner" sprite="yellow" />
        </condition>
        <condition object="shell2" variable="hits">
          <above>shell1.hits</above>
          <become object="winner" sprite="blue" />
        </condition>
      </conditions>
    </state>
  </states>
</game>
