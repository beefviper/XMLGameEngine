<!-- hearts.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Nov 4, 2026 -->

<!--
  Hearts, the trick-taking game: you and three computer players (west,
  north and east), one pack of 52 cards, the ace high.

  All the cards are dealt, thirteen each. A player leads any card, and
  each in turn (clockwise: you, west, north, east) plays one: a card of the
  suit led if they have one, else anything. The highest card of the suit
  led takes the trick, and whoever took it leads the next. Hearts may not
  be led until a heart has been played on a trick (hearts are broken),
  unless the leader holds nothing else. Each heart taken is a point, the
  queen of spades thirteen; points are bad. Take all of them (every heart
  and the queen, shooting the moon) and the other three get 26 instead.
  After a hand, once anyone has 100 or more, the lowest score wins.
  Who leads the first trick goes round the table each hand.

  A and D or the arrows pick a card, Space plays it; or click a card.
  Space after a hand deals the next. P or Escape pauses.

  How it is written:
  * The pack is a group, a row for each suit (spades, hearts, clubs,
    diamonds) and a column for each rank, each face its own cell of the
    card sheet. A card is worth its column, the ace 14: the highest card,
    and last in a hand kept in <order>. Its `points`: 1 on the hearts row,
    13 on the queen of spades' cell.
  * The trick is a holder with a <trick variable="suit">: the suit led is
    followed, and it <breaks> hearts (row 2); its live numbers `lead` (the
    suit led) and `winner` (the number of the player who laid the card
    taking it), and `points`, which it <counts>.
  * The players are a group that takes <turns>: you, west, north and east,
    each owning a holder of its own. The computer's three <think> with
    <avoid />: they keep out of tricks, and shed points when they cannot
    follow. <pass /> after a card; a full trick is nobody's turn, then the
    taker's (<pass member="trick.winner" />), whose `got` the points join.
  * The deal, in the <starts> and between hands: every card <send> into
    the stock, put in <order> at <random />, and <distribute>d thirteen to
    each of the players' own holders, a card a round.
  * A full trick waits a moment (a timer on the table's look), then is
    sent to the stock in the corner.
  * Where the hand is, is the table's look: playing, full (a trick
    showing), taking, done, dealing; each look's rules sit inside one
    condition on it. Its `first` is who leads the hand's first trick,
    `tricks` how many are taken.
  * A rule for every player is written once, for the class: `self` is the
    one it holds for (<lowest /> score wins, `self.got` joins its score),
    `others` the rest (26 to them when the moon is shot), and
    sprite="self" the look named after it.
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../xgedef.xsd">
  <window name="Hearts">
    <width>880</width>
    <height>840</height>
    <background>color.darkgreen</background>
  </window>
  <variables>
    <variable name="cardwidth">96</variable>
    <variable name="cardheight">140</variable>
    <variable name="northrow">16</variable>
    <variable name="siderow">196</variable>
    <variable name="trickrow">300</variable>
    <variable name="yours">676</variable>
  </variables>
  <styles>
    <style name="banner"><size>80</size><color>color.yellow</color></style>
    <style name="prompt"><size>32</size></style>
    <style name="help"><size>22</size><color>color.lightgrey</color></style>
    <style name="note"><size>24</size><color>color.white</color></style>
  </styles>
  <states>
    <state name="title">
      <objects>
        <object name="title">
          <sprite><text style="banner"><content>HEARTS</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 190</centered></y></position>
        </object>
        <group name="help">
          <rows>4</rows>
          <padding><y>30</y></padding>
          <sprite><text style="help" /></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 90</centered></y></position>
          <row number="1"><sprite><text><content>follow the suit led if you can; the highest card of it takes the trick.</content></text></sprite></row>
          <row number="2"><sprite><text><content>each heart taken is a point, the queen of spades thirteen: keep them low.</content></text></sprite></row>
          <row number="3"><sprite><text><content>take them all and the others get 26. at 100, the lowest score wins.</content></text></sprite></row>
          <row number="4"><sprite><text><content>a d or the arrows pick a card, spacebar plays it, or click a card</content></text></sprite></row>
        </group>
        <object name="start">
          <sprite><text style="prompt"><content>spacebar to deal</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center + 170</centered></y></position>
        </object>
      </objects>
      <inputs>
        <input><button>space</button><button>pad1.start</button><push state="playing" /></input>
      </inputs>
    </state>
    <state name="playing">
      <objects>
        <!-- the pack: a row for each suit (spades, hearts, clubs, diamonds), a column for each rank, the ace high; a heart a point, the queen of spades 13 -->
        <group name="cards" class="card">
          <columns>13</columns>
          <rows>4</rows>
          <sprite name="face"><cell sheet="cards"><scale>0.5</scale></cell></sprite>
          <sprite name="back"><cell sheet="cards"><column>1</column><row>5</row><scale>0.5</scale></cell></sprite>
          <position><x>0</x><y>0</y></position>
          <row><number>2</number><variables><variable name="points">1</variable></variables></row>
          <column><number>1</number><variables><variable name="worth">14</variable></variables></column>
          <cell row="1" column="12"><variables><variable name="points">13</variable></variables></cell>
        </group>

        <!-- the stock, top left: the deal comes from it, and every trick taken goes back onto it -->
        <object name="stock" class="place">
          <sprite><rectangle><width>cardwidth</width><height>cardheight</height><color>color.forestgreen</color></rectangle></sprite>
          <position><x>24</x><y>northrow</y></position>
          <holds class="card" sprite="back" />
        </object>

        <!-- the computer's cards, face down: west down the left, north along the top, east down the right -->
        <object name="westcards" class="place">
          <sprite><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite>
          <position><x>24</x><y>siderow</y></position>
          <holds class="card" sprite="back"><spread><y>24</y></spread><order><by variable="suit" /><by variable="worth" /></order></holds>
        </object>
        <object name="northcards" class="place">
          <sprite><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite>
          <position><x>window.width.center - cardwidth / 2 - 144</x><y>northrow</y></position>
          <holds class="card" sprite="back"><spread><x>24</x></spread><order><by variable="suit" /><by variable="worth" /></order></holds>
        </object>
        <object name="eastcards" class="place">
          <sprite><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite>
          <position><x>window.width.center * 2 - cardwidth - 24</x><y>siderow</y></position>
          <holds class="card" sprite="back"><spread><y>24</y></spread><order><by variable="suit" /><by variable="worth" /></order></holds>
        </object>

        <!-- your cards, face up along the bottom, in suit and rank order -->
        <object name="mine" class="place">
          <sprite><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite>
          <position><x>56</x><y>yours</y></position>
          <holds class="card" sprite="face"><spread><x>56</x><width>768</width></spread><lift>16</lift><order><by variable="suit" /><by variable="worth" /></order></holds>
        </object>

        <!-- the trick: the suit led is followed if it can be; hearts lead only once broken; its points counted -->
        <object name="trick" class="place">
          <sprite><rectangle><width>cardwidth + 3 * 64</width><height>cardheight</height><color>color.forestgreen</color></rectangle></sprite>
          <position><x>window.width.center - cardwidth / 2 - 96</x><y>trickrow</y></position>
          <holds class="card" sprite="face">
            <spread><x>64</x></spread>
            <trick variable="suit"><breaks>2</breaks></trick>
            <counts variable="points" />
          </holds>
        </object>

        <!-- the scores: the game's, plus this hand's points so far, and whose turn it is -->
        <object name="northscore">
          <sprite><text style="note"><content>north</content><number>north.score</number><content>+</content><number>north.got</number><choose><by>north.turn</by><word /><word>to play</word></choose></text></sprite>
          <position><x><centered /></x><y>northrow + cardheight + 6</y></position>
        </object>
        <object name="westscore">
          <sprite><text style="note"><content>west</content><number>west.score</number><content>+</content><number>west.got</number><choose><by>west.turn</by><word /><word>to play</word></choose></text></sprite>
          <position><x>24</x><y>siderow - 34</y></position>
        </object>
        <object name="eastscore">
          <sprite><text style="note"><content>east</content><number>east.score</number><content>+</content><number>east.got</number><choose><by>east.turn</by><word /><word>to play</word></choose></text></sprite>
          <position><x>window.width.center * 2 - 200</x><y>siderow - 34</y></position>
        </object>
        <object name="yourscore">
          <sprite><text style="note"><content>you</content><number>you.score</number><content>+</content><number>you.got</number><choose><by>you.turn</by><word /><word>your turn: play a card</word></choose></text></sprite>
          <position><x><centered /></x><y>yours - 52</y></position>
        </object>

        <!-- who the trick goes to, as it stands -->
        <object name="taker">
          <sprite><text style="note"><choose><by>trick.winner</by><word /><word>the trick: yours</word><word>the trick: west's</word><word>the trick: north's</word><word>the trick: east's</word></choose></text></sprite>
          <position><x><centered /></x><y>trickrow + cardheight + 24</y></position>
        </object>

        <!-- what is happening between hands -->
        <object name="message">
          <sprite name="none"><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite>
          <sprite name="moon"><text style="note"><content>the moon is shot: 26 to everyone else. spacebar deals</content><color>color.cyan</color></text></sprite>
          <sprite name="done"><text style="note"><content>the hand is over: spacebar deals the next</content></text></sprite>
          <sprite name="dealing"><text style="note"><content>shuffling</content><color>color.lightgrey</color></text></sprite>
          <position><x><centered /></x><y>trickrow + cardheight + 60</y></position>
        </object>

        <!-- the table: where the hand is (its look), who leads first, the tricks taken; a full trick shows a moment; between hands, Space deals -->
        <object name="table">
          <sprite name="playing"><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite>
          <sprite name="full"><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite>
          <sprite name="taking"><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite>
          <sprite name="done"><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite>
          <sprite name="dealing"><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite>
          <position><x>0</x><y>0</y></position>
          <drawn>false</drawn>
          <actions>
            <action name="shuffle">
              <become sprite="dealing" />
              <become object="dealer" sprite="shuffling" />
              <play sound="shuffle" />
            </action>
            <action name="deal">
              <send from="cards" into="stock"><all /></send>
              <order group="stock"><random /></order>
              <distribute from="stock" into="players">13</distribute>
              <set variable="you.got">0</set>
              <set variable="west.got">0</set>
              <set variable="north.got">0</set>
              <set variable="east.got">0</set>
              <set variable="table.tricks">0</set>
              <become sprite="playing" />
              <play sound="deal" />
              <inc variable="table.first">1</inc>
              <pass object="players" member="table.first" />
            </action>
          </actions>
          <variables>
            <variable name="first">1</variable>
            <variable name="tricks">0</variable>
          </variables>
          <timers>
            <timer sprite="full"><every>1.2</every><become sprite="taking" /></timer>
          </timers>
        </object>

        <!-- the dealer: a moment to shuffle before the cards come -->
        <object name="dealer">
          <sprite name="idle"><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite>
          <sprite name="shuffling"><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite>
          <position><x>0</x><y>0</y></position>
          <drawn>false</drawn>
          <timers>
            <timer sprite="shuffling"><every>0.4</every><become sprite="idle" /><trigger object="table" action="deal" /></timer>
          </timers>
        </object>

        <!-- the players, in turn: you, then the computer's three, who keep out of tricks; each a frame around the card it points at (theirs unseen) -->
        <group name="players" class="player">
          <sprite name="free">
            <line><from><x>1</x><y>1</y></from><to><x>cardwidth + 5</x><y>1</y></to><color>color.yellow</color><thickness>3</thickness></line>
            <line><from><x>cardwidth + 5</x><y>1</y></from><to><x>cardwidth + 5</x><y>cardheight + 5</y></to><color>color.yellow</color><thickness>3</thickness></line>
            <line><from><x>cardwidth + 5</x><y>cardheight + 5</y></from><to><x>1</x><y>cardheight + 5</y></to><color>color.yellow</color><thickness>3</thickness></line>
            <line><from><x>1</x><y>cardheight + 5</y></from><to><x>1</x><y>1</y></to><color>color.yellow</color><thickness>3</thickness></line>
          </sprite>
          <sprite name="waiting"><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite>
          <actions>
            <action name="left"><hop direction="left" /></action>
            <action name="right"><hop direction="right" /></action>
            <action name="point"><track /></action>
            <!-- the card pointed at onto the trick, if it may go there, and the next one's turn -->
            <action name="play"><pick class="card" /><place into="trick" /><play sound="card" /><pass /></action>
            <!-- it may not: back -->
            <action name="back"><drop /></action>
          </actions>
          <variables>
            <variable name="score">0</variable>
            <variable name="got">0</variable>
          </variables>
          <turns sprite="waiting" />
          <member name="you"><position><x>53</x><y>yours - 3</y></position><owns object="mine" /></member>
          <member name="west"><sprite name="free"><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite><position><x>21</x><y>siderow - 3</y></position><owns object="westcards" /><think button="space"><avoid /></think></member>
          <member name="north"><sprite name="free"><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite><position><x>window.width.center - cardwidth / 2 - 147</x><y>northrow - 3</y></position><owns object="northcards" /><think button="space"><avoid /></think></member>
          <member name="east"><sprite name="free"><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite><position><x>window.width.center * 2 - cardwidth - 27</x><y>siderow - 3</y></position><owns object="eastcards" /><think button="space"><avoid /></think></member>
        </group>
      </objects>
      <!-- the cards start in the stock, shuffled and dealt thirteen to each player -->
      <starts>
        <send from="cards" into="stock"><all /></send>
        <order group="stock"><random /></order>
        <distribute from="stock" into="players">13</distribute>
      </starts>
      <inputs>
        <input><button>a</button><button>left</button><button>pad1.left</button><trigger object="players" action="left" /></input>
        <input><button>d</button><button>right</button><button>pad1.right</button><trigger object="players" action="right" /></input>
        <input>
          <button>space</button><button>pad1.a</button><button>mouse.left</button>
          <trigger object="players" action="play" />
          <trigger object="players" action="back" />
          <trigger object="table" action="shuffle" from="done" />
        </input>
        <input axis="mouse.x"><trigger object="players" action="point" /></input>
        <input axis="mouse.y"><trigger object="players" action="point" /></input>
        <input><button>p</button><button>escape</button><button>pad1.start</button><push state="paused" /></input>
      </inputs>
      <conditions>
        <!-- who leads first goes round the table -->
        <condition object="table" variable="first">
          <equal>5</equal>
          <set variable="table.first">1</set>
          <pass object="players" member="1" />
        </condition>

        <!-- playing -->
        <condition object="table" sprite="playing">
          <!-- all thirteen tricks taken: one who took all 26 shot the moon; else each one's points join its score -->
          <condition object="table" variable="tricks"><equal>13</equal>
            <condition class="player" variable="got"><equal>26</equal>
              <inc variable="others.score">26</inc>
              <become object="message" sprite="moon" />
              <become object="table" sprite="done" />
              <pass object="players" member="0" />
            </condition>
            <condition class="player">
              <inc variable="self.score">self.got</inc>
              <become object="message" sprite="done" />
              <become object="table" sprite="done" />
              <pass object="players" member="0" />
            </condition>
          </condition>
          <!-- a full trick: shown a moment, nobody's turn -->
          <condition object="trick" variable="cards"><equal>4</equal>
            <become object="table" sprite="full" />
            <pass object="players" member="0" />
            <play sound="take" />
          </condition>
          <otherwise>
            <become object="message" sprite="none" />
          </otherwise>
        </condition>

        <!-- then taken: the taker's turn, its points to the taker, its cards to the stock -->
        <condition object="table" sprite="taking">
          <pass object="players" member="trick.winner" />
          <inc variable="players.got">trick.points</inc>
          <send from="trick" into="stock"><all /></send>
          <inc variable="table.tricks">1</inc>
          <become object="table" sprite="playing" />
        </condition>

        <!-- the hand over and someone at 100: the lowest score wins (a tie, the first named) -->
        <condition object="table" sprite="done">
          <condition class="player" variable="score" total="highest"><atleast>100</atleast>
            <condition class="player" variable="score"><lowest />
              <become object="over.winner" sprite="self" />
              <push state="over" />
            </condition>
          </condition>
        </condition>

        <condition object="table" sprite="dealing"><become object="message" sprite="dealing" /></condition>
      </conditions>
    </state>
    <state name="paused">
      <objects>
        <object name="paused">
          <sprite><text style="banner"><content>PAUSED</content><color>color.white</color></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 40</centered></y></position>
        </object>
        <object name="newgame">
          <sprite><text style="prompt"><content>n for a new game</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center + 40</centered></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input><button>space</button><button>p</button><button>escape</button><button>pad1.start</button><pop /></input>
        <input><button>n</button><reset /></input>
      </inputs>
    </state>
    <state name="over">
      <objects>
        <object name="winner">
          <sprite name="you"><text style="banner"><content>YOU WIN</content></text></sprite>
          <sprite name="west"><text style="banner"><content>WEST WINS</content></text></sprite>
          <sprite name="north"><text style="banner"><content>NORTH WINS</content></text></sprite>
          <sprite name="east"><text style="banner"><content>EAST WINS</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 40</centered></y></position>
          <!-- a cheer if it is you, else a groan -->
          <timers>
            <timer sprite="you"><after>0.01</after><play sound="win" /></timer>
            <timer sprite="west"><after>0.01</after><play sound="lose" /></timer>
            <timer sprite="north"><after>0.01</after><play sound="lose" /></timer>
            <timer sprite="east"><after>0.01</after><play sound="lose" /></timer>
          </timers>
        </object>
        <object name="again">
          <sprite><text style="prompt"><content>spacebar to play again</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center + 40</centered></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input><button>space</button><button>pad1.start</button><reset /></input>
      </inputs>
    </state>
  </states>
  <sounds>
    <sound name="card" wave="noise"><note pitch="C6">0.03</note></sound>
    <sound name="deal" wave="noise"><note pitch="G5">0.02</note><note pitch="C6">0.02</note></sound>
    <sound name="shuffle" wave="noise"><note pitch="C6">0.02</note><rest>0.02</rest><note pitch="D6">0.02</note><rest>0.02</rest><note pitch="C6">0.02</note><rest>0.02</rest><note pitch="D6">0.02</note></sound>
    <sound name="take"><note pitch="E5">0.06</note><note pitch="C5">0.1</note></sound>
    <sound name="win">
      <note pitch="C5">0.12</note>
      <note pitch="E5">0.12</note>
      <note pitch="G5">0.12</note>
      <note pitch="C6">0.4</note>
    </sound>
    <sound name="lose">
      <note pitch="G4">0.15</note>
      <note pitch="E4">0.15</note>
      <note pitch="C4">0.4</note>
    </sound>
  </sounds>
  <!-- the card sheet: a row for each suit, a column for each rank, then a row of backs -->
  <pictures>
    <sheet name="cards"><path>assets/cards.png</path><columns>13</columns><rows>5</rows></sheet>
  </pictures>
</game>
