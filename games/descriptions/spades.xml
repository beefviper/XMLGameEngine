<!-- spades.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Nov 5, 2026 -->

<!--
  Spades, the trick-taking game for partners: you and north against west
  and east, one pack of 52 cards, the ace high, spades always trumps.

  All the cards are dealt, thirteen each. Each player bids how many tricks
  they will take; a side's bids added are its contract. A player leads any
  card, and each in turn (clockwise: you, west, north, east) plays one: a
  card of the suit led if they have one, else anything. The highest spade
  takes the trick, or with no spade in it the highest card of the suit led;
  whoever took it leads the next. Spades may not be led until a spade has
  been played (broken), unless the leader holds nothing else.
  A side that takes at least its contract scores ten a trick bid and one
  for each trick over (a bag); short of it, it loses ten a trick bid.
  Every ten bags cost a hundred. At 500 the higher score wins.
  Who leads the first trick goes round the table each hand.

  The others bid as the cards are dealt; you bid last, seeing theirs:
  W and S or the arrows change your bid, Space bids. Then A and D or the
  arrows pick a card, Space plays it; or click a card. Space after a hand
  deals the next. P or Escape pauses.

  How it is written:
  * The deck is the card sheet's, its ace <worth>14</worth>.
  * The trick is a pile with a <trick>: the suit led is followed, with
    spades its <trumps> and <breaks>; its live numbers `lead` and `winner`
    (the <seat> of the hand that laid the card taking it).
  * Each player is a hand with a pile of its own, a <seat> and a <team>.
    Each player's pile is <dealt>13</dealt>; between hands, and for the
    first, <redeal /> gathers, shuffles and deals them again.
    A pile of a hand's own has the live number `tricks`: how many tricks
    its cards should take, which is each player's bid (at least one).
  * The computer's three <think>: they take tricks, and let a partner's
    winning card stand.
  * A full trick waits a moment, then is <collect>ed into the pile in the
    corner, a trick to the taker and its side.
  * The table's `phase`: 0 playing, 1 a full trick showing, 2 taking it,
    3 the hand over, 4 shuffling, 5 your bid; `us` and `them` the scores,
    their bags, contracts (`usbid`) and tricks taken (`uswon`).
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../xgedef.xsd">
  <window name="Spades">
    <width>880</width>
    <height>840</height>
    <background>color.darkgreen</background>
  </window>
  <variables>
    <variable name="cardwidth">96</variable>
    <variable name="cardheight">140</variable>
    <variable name="northrow">16</variable>
    <variable name="siderow">196</variable>
    <variable name="trickrow">300</variable>
    <variable name="yours">676</variable>
  </variables>
  <sounds>
    <sound name="card" wave="noise"><note pitch="C6">0.03</note></sound>
    <sound name="deal" wave="noise"><note pitch="G5">0.02</note><note pitch="C6">0.02</note></sound>
    <sound name="shuffle" wave="noise"><note pitch="C6">0.02</note><rest>0.02</rest><note pitch="D6">0.02</note><rest>0.02</rest><note pitch="C6">0.02</note><rest>0.02</rest><note pitch="D6">0.02</note></sound>
    <sound name="take"><note pitch="E5">0.06</note><note pitch="C5">0.1</note></sound>
    <sound name="win">
      <note pitch="C5">0.12</note>
      <note pitch="E5">0.12</note>
      <note pitch="G5">0.12</note>
      <note pitch="C6">0.4</note>
    </sound>
    <sound name="lose">
      <note pitch="G4">0.15</note>
      <note pitch="E4">0.15</note>
      <note pitch="C4">0.4</note>
    </sound>
  </sounds>
  <styles>
    <style name="banner"><size>80</size><color>color.yellow</color></style>
    <style name="prompt"><size>32</size></style>
    <style name="help"><size>22</size><color>color.lightgrey</color></style>
    <style name="note"><size>24</size><color>color.white</color></style>
  </styles>
  <states>
    <state name="title">
      <objects>
        <object name="title">
          <sprite><text style="banner"><content>SPADES</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 190</centered></y></position>
        </object>
        <object name="help1">
          <sprite><text style="help"><content>you and north against west and east. follow the suit led if you can;</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 90</centered></y></position>
        </object>
        <object name="help2">
          <sprite><text style="help"><content>spades are trumps. bid your tricks: make your side's bid for ten a trick,</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 60</centered></y></position>
        </object>
        <object name="help3">
          <sprite><text style="help"><content>one for each over; ten overs cost 100. short, lose ten a trick. 500 wins.</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 30</centered></y></position>
        </object>
        <object name="help4">
          <sprite><text style="help"><content>w s change your bid, a d pick a card, spacebar bids and plays</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 0</centered></y></position>
        </object>
        <object name="start">
          <sprite><text style="prompt"><content>spacebar to deal</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center + 170</centered></y></position>
        </object>
      </objects>
      <inputs>
        <input><button>space</button><button>pad1.start</button><push state="playing" /></input>
      </inputs>
    </state>
    <state name="playing">
      <objects>
        <!-- the pack: the card sheet's, the ace high -->
        <deck name="cards" pile="stock">
          <sheet><path>assets/cards.png</path><back>1</back></sheet>
          <face><width>96</width><height>140</height></face>
          <suit name="spades"><color>color.black</color></suit>
          <suit name="hearts"><color>color.red</color></suit>
          <suit name="clubs"><color>color.black</color></suit>
          <suit name="diamonds"><color>color.red</color></suit>
          <rank name="A"><worth>14</worth></rank>
          <rank>2</rank><rank>3</rank><rank>4</rank><rank>5</rank><rank>6</rank><rank>7</rank><rank>8</rank><rank>9</rank><rank>10</rank><rank>J</rank><rank>Q</rank><rank>K</rank>
        </deck>

        <!-- the stock, top left: the deal comes from it, and every trick taken goes back onto it -->
        <object name="stock" class="place">
          <sprite><rectangle><width>cardwidth</width><height>cardheight</height><color>color.forestgreen</color></rectangle></sprite>
          <position><x>24</x><y>northrow</y></position>
          <pile faces="down"><deals>1</deals></pile>
        </object>

        <!-- the computer's cards, face down: west down the left, north along the top, east down the right -->
        <object name="west" class="place">
          <sprite><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite>
          <position><x>24</x><y>siderow</y></position>
          <pile faces="down"><fan><hidden><y>24</y></hidden></fan><dealt>13</dealt><sorted /></pile>
        </object>
        <object name="north" class="place">
          <sprite><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite>
          <position><x>window.width.center - cardwidth / 2 - 144</x><y>northrow</y></position>
          <pile faces="down"><fan><hidden><x>24</x></hidden></fan><dealt>13</dealt><sorted /></pile>
        </object>
        <object name="east" class="place">
          <sprite><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite>
          <position><x>window.width.center * 2 - cardwidth - 24</x><y>siderow</y></position>
          <pile faces="down"><fan><hidden><y>24</y></hidden></fan><dealt>13</dealt><sorted /></pile>
        </object>

        <!-- your cards, face up along the bottom, in suit and rank order -->
        <object name="mine" class="place">
          <sprite><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite>
          <position><x>56</x><y>yours</y></position>
          <pile faces="up"><fan><x>56</x><width>768</width></fan><dealt>13</dealt><sorted /><lift>16</lift></pile>
        </object>

        <!-- the trick: the suit led is followed if it can be; spades are trumps, and lead only once broken -->
        <object name="trick" class="place">
          <sprite><rectangle><width>cardwidth + 3 * 64</width><height>cardheight</height><color>color.forestgreen</color></rectangle></sprite>
          <position><x>window.width.center - cardwidth / 2 - 96</x><y>trickrow</y></position>
          <pile faces="up">
            <fan><x>64</x></fan>
            <trick><breaks><suit>spades</suit></breaks><trumps><suit>spades</suit></trumps></trick>
          </pile>
        </object>

        <!-- each player's bid and tricks taken; the sides' scores and bags, top right -->
        <object name="northscore">
          <sprite><text style="note"><content>north bid</content><number>northhand.bid</number><content>took</content><number>northhand.won</number></text></sprite>
          <position><x><centered /></x><y>northrow + cardheight + 6</y></position>
        </object>
        <object name="westscore">
          <sprite><text style="note"><content>west bid</content><number>westhand.bid</number><content>took</content><number>westhand.won</number></text></sprite>
          <position><x>24</x><y>siderow - 34</y></position>
        </object>
        <object name="eastscore">
          <sprite><text style="note"><content>east bid</content><number>easthand.bid</number><content>took</content><number>easthand.won</number></text></sprite>
          <position><x>window.width.center * 2 - 210</x><y>siderow - 34</y></position>
        </object>
        <object name="yourscore">
          <sprite><text style="note"><content>you bid</content><number>hand.bid</number><content>took</content><number>hand.won</number></text></sprite>
          <position><x><centered /></x><y>yours - 52</y></position>
        </object>
        <object name="usscore">
          <sprite><text style="note"><content>us</content><number>table.us</number><content>bags</content><number>table.usbags</number><color>color.yellow</color></text></sprite>
          <position><x>window.width.center * 2 - 200</x><y>northrow</y></position>
        </object>
        <object name="themscore">
          <sprite><text style="note"><content>them</content><number>table.them</number><content>bags</content><number>table.thembags</number></text></sprite>
          <position><x>window.width.center * 2 - 200</x><y>northrow + 34</y></position>
        </object>

        <!-- what is happening -->
        <object name="message">
          <sprite name="yours"><text style="note"><content>your turn: play a card</content><color>color.yellow</color></text></sprite>
          <sprite name="west"><text style="note"><content>west is playing</content><color>color.lightgrey</color></text></sprite>
          <sprite name="north"><text style="note"><content>north is playing</content><color>color.lightgrey</color></text></sprite>
          <sprite name="east"><text style="note"><content>east is playing</content><color>color.lightgrey</color></text></sprite>
          <sprite name="took1"><text style="note"><content>you take the trick</content><color>color.yellow</color></text></sprite>
          <sprite name="took2"><text style="note"><content>west takes the trick</content></text></sprite>
          <sprite name="took3"><text style="note"><content>north takes the trick</content></text></sprite>
          <sprite name="took4"><text style="note"><content>east takes the trick</content></text></sprite>
          <sprite name="bidding"><text style="note"><content>bid your tricks: w s change it, spacebar bids</content><color>color.yellow</color></text></sprite>
          <sprite name="made11"><text style="note"><content>both sides made their bids: spacebar deals</content></text></sprite>
          <sprite name="made10"><text style="note"><content>we made our bid, they were set: spacebar deals</content><color>color.yellow</color></text></sprite>
          <sprite name="made01"><text style="note"><content>we were set, they made theirs: spacebar deals</content></text></sprite>
          <sprite name="made00"><text style="note"><content>both sides were set: spacebar deals</content></text></sprite>
          <sprite name="dealing"><text style="note"><content>shuffling</content><color>color.lightgrey</color></text></sprite>
          <position><x><centered /></x><y>trickrow + cardheight + 24</y></position>
        </object>

        <!-- the table: whose turn, the phase, who leads first, the tricks taken; a full trick shows a moment -->
        <object name="table">
          <sprite name="playing"><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite>
          <sprite name="full"><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite>
          <position><x>0</x><y>0</y></position>
          <drawn>false</drawn>
          <actions>
            <action name="shuffle">
              <set variable="table.phase">4</set>
              <become object="dealer" sprite="shuffling" />
              <play sound="shuffle" />
            </action>
            <action name="deal">
              <redeal />
              <set variable="hand.won">0</set>
              <set variable="hand.bid"><formula><largest><value>mine.tricks</value><value>1</value></largest></formula></set>
              <set variable="westhand.won">0</set>
              <set variable="westhand.bid"><formula><largest><value>west.tricks</value><value>1</value></largest></formula></set>
              <set variable="northhand.won">0</set>
              <set variable="northhand.bid"><formula><largest><value>north.tricks</value><value>1</value></largest></formula></set>
              <set variable="easthand.won">0</set>
              <set variable="easthand.bid"><formula><largest><value>east.tricks</value><value>1</value></largest></formula></set>
              <set variable="table.tricks">0</set>
              <set variable="table.uswon">0</set>
              <set variable="table.themwon">0</set>
              <inc variable="table.first">1</inc>
              <set variable="table.turn">table.first</set>
              <set variable="table.phase">5</set>
              <play sound="deal" />
            </action>
          </actions>
          <variables>
            <variable name="turn">1</variable>
            <variable name="phase">4</variable>
            <variable name="first">0</variable>
            <variable name="tricks">0</variable>
            <variable name="us">0</variable>
            <variable name="them">0</variable>
            <variable name="usbags">0</variable>
            <variable name="thembags">0</variable>
            <variable name="usbid">0</variable>
            <variable name="thembid">0</variable>
            <variable name="uswon">0</variable>
            <variable name="themwon">0</variable>
          </variables>
          <timers>
            <timer sprite="full"><every>1.2</every><become sprite="playing" /><set variable="table.phase">2</set></timer>
          </timers>
        </object>

        <!-- the dealer: a moment to shuffle before the cards come, the first hand too -->
        <object name="dealer">
          <sprite name="shuffling"><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite>
          <sprite name="idle"><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite>
          <position><x>0</x><y>0</y></position>
          <drawn>false</drawn>
          <timers>
            <timer sprite="shuffling"><every>0.4</every><become sprite="idle" /><trigger object="table" action="deal" /></timer>
          </timers>
        </object>

        <!-- west: it bids as the cards come, thinks, points (unseen) and presses F9 -->
        <object name="westhand">
          <sprite name="idle"><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite>
          <sprite name="go"><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite>
          <position><x>21</x><y>siderow - 3</y></position>
          <hand pile="west"><seat>2</seat><team>2</team></hand>
          <drawn>false</drawn>
          <actions>
            <action name="play">
              <take />
              <lay pile="trick" />
              <play sound="card" />
              <set variable="table.turn">3</set>
              <become sprite="idle" />
            </action>
            <action name="back"><drop /></action>
          </actions>
          <variables>
            <variable name="bid">0</variable>
            <variable name="won">0</variable>
          </variables>
        </object>

        <!-- north: it bids as the cards come, thinks, points (unseen) and presses F10 -->
        <object name="northhand">
          <sprite name="idle"><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite>
          <sprite name="go"><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite>
          <position><x>window.width.center - cardwidth / 2 - 147</x><y>northrow - 3</y></position>
          <hand pile="north"><seat>3</seat><team>1</team></hand>
          <drawn>false</drawn>
          <actions>
            <action name="play">
              <take />
              <lay pile="trick" />
              <play sound="card" />
              <set variable="table.turn">4</set>
              <become sprite="idle" />
            </action>
            <action name="back"><drop /></action>
          </actions>
          <variables>
            <variable name="bid">0</variable>
            <variable name="won">0</variable>
          </variables>
        </object>

        <!-- east: it bids as the cards come, thinks, points (unseen) and presses F11 -->
        <object name="easthand">
          <sprite name="idle"><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite>
          <sprite name="go"><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite>
          <position><x>window.width.center * 2 - cardwidth - 27</x><y>siderow - 3</y></position>
          <hand pile="east"><seat>4</seat><team>2</team></hand>
          <drawn>false</drawn>
          <actions>
            <action name="play">
              <take />
              <lay pile="trick" />
              <play sound="card" />
              <set variable="table.turn">1</set>
              <become sprite="idle" />
            </action>
            <action name="back"><drop /></action>
          </actions>
          <variables>
            <variable name="bid">0</variable>
            <variable name="won">0</variable>
          </variables>
        </object>

        <!-- your hand: a frame around the card it points at -->
        <object name="hand">
          <sprite name="free">
            <line><from><x>1</x><y>1</y></from><to><x>cardwidth + 5</x><y>1</y></to><color>color.yellow</color><thickness>3</thickness></line>
            <line><from><x>cardwidth + 5</x><y>1</y></from><to><x>cardwidth + 5</x><y>cardheight + 5</y></to><color>color.yellow</color><thickness>3</thickness></line>
            <line><from><x>cardwidth + 5</x><y>cardheight + 5</y></from><to><x>1</x><y>cardheight + 5</y></to><color>color.yellow</color><thickness>3</thickness></line>
            <line><from><x>1</x><y>cardheight + 5</y></from><to><x>1</x><y>1</y></to><color>color.yellow</color><thickness>3</thickness></line>
          </sprite>
          <sprite name="bid"><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite>
          <sprite name="wait"><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite>
          <sprite name="done"><rectangle><width>4</width><height>4</height><color>color.darkgreen</color></rectangle></sprite>
          <position><x>53</x><y>yours - 3</y></position>
          <hand pile="mine"><seat>1</seat><team>1</team></hand>
          <actions>
            <action name="left"><hop direction="left" /></action>
            <action name="right"><hop direction="right" /></action>
            <action name="point"><track /></action>
            <!-- the card pointed at onto the trick, if it may go there -->
            <action name="play">
              <take />
              <lay pile="trick" />
              <play sound="card" />
              <set variable="table.turn">2</set>
              <become sprite="wait" />
            </action>
            <!-- it may not: back in your hand -->
            <action name="back"><drop /></action>
            <action name="next"><trigger object="table" action="shuffle" /></action>
            <!-- your bid: what your cards should take, changed by a trick at a time; then play -->
            <action name="more"><inc variable="hand.bid">1</inc></action>
            <action name="less"><inc variable="hand.bid">-1</inc></action>
            <action name="bid">
              <set variable="table.usbid">hand.bid + northhand.bid</set>
              <set variable="table.thembid">westhand.bid + easthand.bid</set>
              <set variable="table.phase">0</set>
              <become sprite="wait" />
              <play sound="card" />
            </action>
          </actions>
          <variables>
            <variable name="bid">0</variable>
            <variable name="won">0</variable>
          </variables>
        </object>
      </objects>
      <inputs>
        <input><button>a</button><button>left</button><button>pad1.left</button><trigger object="hand" action="left" from="free" /></input>
        <input><button>d</button><button>right</button><button>pad1.right</button><trigger object="hand" action="right" from="free" /></input>
        <input><button>w</button><button>up</button><button>pad1.up</button><trigger object="hand" action="more" from="bid" /></input>
        <input><button>s</button><button>down</button><button>pad1.down</button><trigger object="hand" action="less" from="bid" /></input>
        <input>
          <button>space</button><button>pad1.a</button><button>mouse.left</button>
          <trigger object="hand" action="play" from="free" />
          <trigger object="hand" action="back" from="free" />
          <trigger object="hand" action="bid" from="bid" />
          <trigger object="hand" action="next" from="done" />
        </input>
        <input axis="mouse.x"><trigger object="hand" action="point" from="free" /></input>
        <input axis="mouse.y"><trigger object="hand" action="point" from="free" /></input>
        <!-- the computer's keys: only their looks answer them -->
        <input><button>f9</button><trigger object="westhand" action="play" from="go" /><trigger object="westhand" action="back" from="go" /></input>
        <input><button>f10</button><trigger object="northhand" action="play" from="go" /><trigger object="northhand" action="back" from="go" /></input>
        <input><button>f11</button><trigger object="easthand" action="play" from="go" /><trigger object="easthand" action="back" from="go" /></input>
        <input><button>p</button><button>escape</button><button>pad1.start</button><push state="paused" /></input>
      </inputs>
      <conditions>
        <!-- who leads first goes round the table -->
        <condition object="table" variable="first">
          <equal>5</equal>
          <set variable="table.first">1</set>
          <set variable="table.turn">1</set>
        </condition>

        <!-- your bid kept from 1 to 13 -->
        <condition>
          <all><condition object="table" variable="phase"><equal>5</equal></condition><condition object="hand" variable="bid"><above>13</above></condition></all>
          <set variable="hand.bid">13</set>
        </condition>
        <condition>
          <all><condition object="table" variable="phase"><equal>5</equal></condition><condition object="hand" variable="bid"><below>1</below></condition></all>
          <set variable="hand.bid">1</set>
        </condition>

        <!-- the hand over: ten bags cost a hundred -->
        <condition>
          <all><condition object="table" variable="phase"><equal>3</equal></condition><condition object="table" variable="usbags"><atleast>10</atleast></condition></all>
          <inc variable="table.us">-100</inc>
          <inc variable="table.usbags">-10</inc>
        </condition>
        <condition>
          <all><condition object="table" variable="phase"><equal>3</equal></condition><condition object="table" variable="thembags"><atleast>10</atleast></condition></all>
          <inc variable="table.them">-100</inc>
          <inc variable="table.thembags">-10</inc>
        </condition>

        <!-- and a side at 500: the higher score wins (a tie plays on) -->
        <condition>
          <all>
            <condition object="table" variable="phase"><equal>3</equal></condition>
            <any><condition object="table" variable="us"><atleast>500</atleast></condition><condition object="table" variable="them"><atleast>500</atleast></condition></any>
            <condition object="table" variable="us"><above>table.them</above></condition>
          </all>
          <become object="over.winner" sprite="us" />
          <play sound="win" />
          <push state="over" />
        </condition>
        <condition>
          <all>
            <condition object="table" variable="phase"><equal>3</equal></condition>
            <any><condition object="table" variable="us"><atleast>500</atleast></condition><condition object="table" variable="them"><atleast>500</atleast></condition></any>
            <condition object="table" variable="them"><above>table.us</above></condition>
          </all>
          <become object="over.winner" sprite="them" />
          <play sound="lose" />
          <push state="over" />
        </condition>

        <!-- all thirteen tricks taken: each side made its bid (ten a trick bid, a point and a bag a trick over) or was set (ten a trick bid lost) -->
        <condition>
          <all><condition object="table" variable="phase"><equal>0</equal></condition><condition object="table" variable="tricks"><equal>13</equal></condition><condition object="table" variable="uswon"><atleast>table.usbid</atleast></condition><condition object="table" variable="themwon"><atleast>table.thembid</atleast></condition></all>
          <inc variable="table.us">table.usbid * 10 + table.uswon - table.usbid</inc>
          <inc variable="table.usbags">table.uswon - table.usbid</inc>
          <inc variable="table.them">table.thembid * 10 + table.themwon - table.thembid</inc>
          <inc variable="table.thembags">table.themwon - table.thembid</inc>
          <set variable="table.phase">3</set>
          <become object="message" sprite="made11" />
        </condition>
        <condition>
          <all><condition object="table" variable="phase"><equal>0</equal></condition><condition object="table" variable="tricks"><equal>13</equal></condition><condition object="table" variable="uswon"><atleast>table.usbid</atleast></condition><condition object="table" variable="themwon"><below>table.thembid</below></condition></all>
          <inc variable="table.us">table.usbid * 10 + table.uswon - table.usbid</inc>
          <inc variable="table.usbags">table.uswon - table.usbid</inc>
          <inc variable="table.them">0 - table.thembid * 10</inc>
          <set variable="table.phase">3</set>
          <become object="message" sprite="made10" />
        </condition>
        <condition>
          <all><condition object="table" variable="phase"><equal>0</equal></condition><condition object="table" variable="tricks"><equal>13</equal></condition><condition object="table" variable="uswon"><below>table.usbid</below></condition><condition object="table" variable="themwon"><atleast>table.thembid</atleast></condition></all>
          <inc variable="table.us">0 - table.usbid * 10</inc>
          <inc variable="table.them">table.thembid * 10 + table.themwon - table.thembid</inc>
          <inc variable="table.thembags">table.themwon - table.thembid</inc>
          <set variable="table.phase">3</set>
          <become object="message" sprite="made01" />
        </condition>
        <condition>
          <all><condition object="table" variable="phase"><equal>0</equal></condition><condition object="table" variable="tricks"><equal>13</equal></condition><condition object="table" variable="uswon"><below>table.usbid</below></condition><condition object="table" variable="themwon"><below>table.thembid</below></condition></all>
          <inc variable="table.us">0 - table.usbid * 10</inc>
          <inc variable="table.them">0 - table.thembid * 10</inc>
          <set variable="table.phase">3</set>
          <become object="message" sprite="made00" />
        </condition>

        <!-- a full trick: who took it, shown a moment -->
        <condition>
          <all><condition object="table" variable="phase"><equal>0</equal></condition><condition object="trick" variable="cards"><equal>4</equal></condition><condition object="trick" variable="winner"><equal>1</equal></condition></all>
          <set variable="table.phase">1</set>
          <become object="table" sprite="full" />
          <become object="message" sprite="took1" />
          <become object="hand" sprite="wait" />
          <play sound="take" />
        </condition>
        <condition>
          <all><condition object="table" variable="phase"><equal>0</equal></condition><condition object="trick" variable="cards"><equal>4</equal></condition><condition object="trick" variable="winner"><equal>2</equal></condition></all>
          <set variable="table.phase">1</set>
          <become object="table" sprite="full" />
          <become object="message" sprite="took2" />
          <become object="hand" sprite="wait" />
          <play sound="take" />
        </condition>
        <condition>
          <all><condition object="table" variable="phase"><equal>0</equal></condition><condition object="trick" variable="cards"><equal>4</equal></condition><condition object="trick" variable="winner"><equal>3</equal></condition></all>
          <set variable="table.phase">1</set>
          <become object="table" sprite="full" />
          <become object="message" sprite="took3" />
          <become object="hand" sprite="wait" />
          <play sound="take" />
        </condition>
        <condition>
          <all><condition object="table" variable="phase"><equal>0</equal></condition><condition object="trick" variable="cards"><equal>4</equal></condition><condition object="trick" variable="winner"><equal>4</equal></condition></all>
          <set variable="table.phase">1</set>
          <become object="table" sprite="full" />
          <become object="message" sprite="took4" />
          <become object="hand" sprite="wait" />
          <play sound="take" />
        </condition>
        <!-- then taken: its points to the taker, its cards to the stock, the taker leads -->
        <condition>
          <all><condition object="table" variable="phase"><equal>2</equal></condition><condition object="trick" variable="winner"><equal>1</equal></condition></all>
          <inc variable="hand.won">1</inc>
          <inc variable="table.uswon">1</inc>
          <collect pile="trick" into="stock" />
          <inc variable="table.tricks">1</inc>
          <set variable="table.turn">1</set>
          <set variable="table.phase">0</set>
        </condition>
        <condition>
          <all><condition object="table" variable="phase"><equal>2</equal></condition><condition object="trick" variable="winner"><equal>2</equal></condition></all>
          <inc variable="westhand.won">1</inc>
          <inc variable="table.themwon">1</inc>
          <collect pile="trick" into="stock" />
          <inc variable="table.tricks">1</inc>
          <set variable="table.turn">2</set>
          <set variable="table.phase">0</set>
        </condition>
        <condition>
          <all><condition object="table" variable="phase"><equal>2</equal></condition><condition object="trick" variable="winner"><equal>3</equal></condition></all>
          <inc variable="northhand.won">1</inc>
          <inc variable="table.uswon">1</inc>
          <collect pile="trick" into="stock" />
          <inc variable="table.tricks">1</inc>
          <set variable="table.turn">3</set>
          <set variable="table.phase">0</set>
        </condition>
        <condition>
          <all><condition object="table" variable="phase"><equal>2</equal></condition><condition object="trick" variable="winner"><equal>4</equal></condition></all>
          <inc variable="easthand.won">1</inc>
          <inc variable="table.themwon">1</inc>
          <collect pile="trick" into="stock" />
          <inc variable="table.tricks">1</inc>
          <set variable="table.turn">4</set>
          <set variable="table.phase">0</set>
        </condition>

        <!-- whose turn it is, shown -->
        <condition>
          <all><condition object="table" variable="phase"><equal>0</equal></condition><condition object="table" variable="turn"><equal>1</equal></condition></all>
          <become object="hand" sprite="free" />
          <become object="message" sprite="yours" />
        </condition>
        <condition>
          <all><condition object="table" variable="phase"><equal>0</equal></condition><condition object="table" variable="turn"><equal>2</equal></condition></all>
          <become object="hand" sprite="wait" />
          <become object="westhand" sprite="go" from="idle" />
          <become object="message" sprite="west" />
        </condition>
        <condition>
          <all><condition object="table" variable="phase"><equal>0</equal></condition><condition object="table" variable="turn"><equal>3</equal></condition></all>
          <become object="hand" sprite="wait" />
          <become object="northhand" sprite="go" from="idle" />
          <become object="message" sprite="north" />
        </condition>
        <condition>
          <all><condition object="table" variable="phase"><equal>0</equal></condition><condition object="table" variable="turn"><equal>4</equal></condition></all>
          <become object="hand" sprite="wait" />
          <become object="easthand" sprite="go" from="idle" />
          <become object="message" sprite="east" />
        </condition>
        <condition object="table" variable="phase">
          <equal>5</equal>
          <become object="hand" sprite="bid" />
          <become object="message" sprite="bidding" />
        </condition>
        <condition object="table" variable="phase">
          <equal>3</equal>
          <become object="hand" sprite="done" />
        </condition>
        <condition object="table" variable="phase">
          <equal>4</equal>
          <become object="hand" sprite="wait" />
          <become object="message" sprite="dealing" />
        </condition>
      </conditions>
      <!-- the computer's turns: each thinks with its own hand and key -->
      <computer>
        <condition>
          <all><condition object="table" variable="phase"><equal>0</equal></condition><condition object="table" variable="turn"><equal>2</equal></condition></all>
          <think object="westhand" button="f9" />
        </condition>
        <condition>
          <all><condition object="table" variable="phase"><equal>0</equal></condition><condition object="table" variable="turn"><equal>3</equal></condition></all>
          <think object="northhand" button="f10" />
        </condition>
        <condition>
          <all><condition object="table" variable="phase"><equal>0</equal></condition><condition object="table" variable="turn"><equal>4</equal></condition></all>
          <think object="easthand" button="f11" />
        </condition>
      </computer>
    </state>
    <state name="paused">
      <objects>
        <object name="paused">
          <sprite><text style="banner"><content>PAUSED</content><color>color.white</color></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 40</centered></y></position>
        </object>
        <object name="newgame">
          <sprite><text style="prompt"><content>n for a new game</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center + 40</centered></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input><button>space</button><button>p</button><button>escape</button><button>pad1.start</button><pop /></input>
        <input><button>n</button><reset /></input>
      </inputs>
    </state>
    <state name="over">
      <objects>
        <object name="winner">
          <sprite name="us"><text style="banner"><content>WE WIN</content></text></sprite>
          <sprite name="them"><text style="banner"><content>THEY WIN</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center - 40</centered></y></position>
        </object>
        <object name="again">
          <sprite><text style="prompt"><content>spacebar to play again</content></text></sprite>
          <position><x><centered /></x><y><centered>window.height.center + 40</centered></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input><button>space</button><button>pad1.start</button><reset /></input>
      </inputs>
    </state>
  </states>
</game>
