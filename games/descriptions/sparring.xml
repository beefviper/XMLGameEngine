<!-- sparring.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Nov 14, 2026 -->

<!--
  Sparring: two boxers in a ring, seen from the side. A jab that lands on
  the other's body scores a point and knocks him back; a jab into a raised
  guard only knocks him back. The first to ten points wins.

  Player 1 is A and D to step, W to jab and S to guard; player 2 the
  arrows the same way. Space starts and plays again; Pause pauses.

  How it is written:
  * The boxer is a piece, taken twice. Player 2's pictures are player 1's
    flipped (<flip>) in green trunks, and his jab puts its fist out the
    other way.
  * A jab is an animation that plays once, and only its middle frame holds
    a <hitbox name="fist">: the reach is there only while the arm is out.
    Each boxer's body is a <hitbox name="body">.
  * The rules are the one being hit's: by="fist" is the other's fist
    landing; with hitbox="body", on his body. What his own look is as it
    lands (sprite=) says whether it was guarded, hurt (no point while
    reeling) or a point.
  * A jab or a guard is only thrown from the guard (<trigger from>).
  * Each knocks himself back the way he faces away, and two bodies that
    meet push apart, so the boxers never pass through each other.
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../xgedef.xsd">
  <window name="Sparring">
    <width>640</width>
    <height>400</height>
  </window>
  <variables>
    <variable name="step">240</variable>
    <variable name="shove">4</variable>
    <variable name="knock">30</variable>
    <variable name="floor">340</variable>
    <variable name="wins">10</variable>
  </variables>
  <styles>
    <style name="banner"><size>72</size></style>
    <style name="prompt"><size>28</size></style>
    <style name="hud"><size>48</size></style>
  </styles>
  <objects>
    <!-- a boxer, facing right: steps, jabs and guards; the looks after a
         jab, a guard or a hit go back to his guard -->
    <object name="boxer" class="boxer">
      <sprite name="guard"><bitmap from="guard" /></sprite>
      <sprite name="reach"><bitmap from="reach" /></sprite>
      <sprite name="block"><bitmap from="block" /></sprite>
      <sprite name="hurt"><bitmap from="hurt" /></sprite>
      <animation name="jab">
        <seconds>0.06</seconds>
        <once />
        <frame sprite="guard" />
        <frame sprite="reach">
          <seconds>0.15</seconds>
          <hitbox name="fist">
            <rectangle><width>12</width><height>12</height></rectangle>
            <position><x>52</x><y>12</y></position>
          </hitbox>
        </frame>
        <frame sprite="guard"><seconds>0.12</seconds></frame>
      </animation>
      <animation name="guarding">
        <seconds>0.5</seconds>
        <once />
        <frame sprite="block" />
      </animation>
      <animation name="reeling">
        <seconds>0.4</seconds>
        <once />
        <frame sprite="hurt" />
      </animation>
      <position><y><subtract><value>floor</value><value>80</value></subtract></y></position>
      <collisions>
        <hitbox name="body"><left>4</left><right>22</right></hitbox>
        <collision edge="horizontal"><stick /></collision>
        <collision class="boxer" by="fist">
          <collision sprite="guarding"><play sound="thud" /></collision>
          <collision hitbox="body" sprite="guard">
            <inc who="other" variable="points" />
            <become sprite="reeling" />
            <play sound="smack" />
          </collision>
          <collision hitbox="body" sprite="jab">
            <inc who="other" variable="points" />
            <become sprite="reeling" />
            <play sound="smack" />
          </collision>
        </collision>
      </collisions>
      <actions>
        <action name="left"><move direction="left">step</move></action>
        <action name="right"><move direction="right">step</move></action>
        <action name="jab">
          <become sprite="jab" />
          <play sound="swish" />
        </action>
        <action name="guard"><become sprite="guarding" /></action>
      </actions>
      <variables>
        <variable name="points">0</variable>
      </variables>
    </object>
  </objects>
  <states>
    <state name="title">
      <objects>
        <object name="title">
          <sprite><text style="banner"><content>SPARRING</content></text></sprite>
          <position><x><centered /></x><y><centered><offset>-80</offset></centered></y></position>
        </object>
        <object name="help">
          <sprite><text style="prompt"><content>a d step, w jab, s guard; arrows for player 2</content><size>20</size><color>lightgrey</color></text></sprite>
          <position><x><centered /></x><y><centered><offset>0</offset></centered></y></position>
        </object>
        <object name="start">
          <sprite><text style="prompt"><content>spacebar to start</content></text></sprite>
          <position><x><centered /></x><y><centered><offset>70</offset></centered></y></position>
        </object>
      </objects>
      <inputs>
        <input button="space"><push state="playing" /></input>
      </inputs>
    </state>
    <state name="playing">
      <objects>
        <object name="canvas">
          <sprite><rectangle><width><window><right /></window></width><height>12</height><color>brown</color></rectangle></sprite>
          <position><x>0</x><y>floor</y></position>
        </object>
        <object name="toprope">
          <sprite><rectangle><width><window><right /></window></width><height>3</height><color>lightgrey</color></rectangle></sprite>
          <position><x>0</x><y><subtract><value>floor</value><value>110</value></subtract></y></position>
        </object>
        <object name="lowrope">
          <sprite><rectangle><width><window><right /></window></width><height>3</height><color>lightgrey</color></rectangle></sprite>
          <position><x>0</x><y><subtract><value>floor</value><value>60</value></subtract></y></position>
        </object>
        <object name="boxer1" from="boxer">
          <position><x>180</x></position>
          <collisions>
            <collision class="boxer" by="fist"><move direction="left">knock</move></collision>
            <collision class="boxer" hitbox="body" by="body"><move direction="left">shove</move></collision>
          </collisions>
        </object>
        <object name="boxer2" from="boxer">
          <sprite name="guard"><bitmap from="guard"><color char="t">green</color><flip>horizontal</flip></bitmap></sprite>
          <sprite name="reach"><bitmap from="reach"><color char="t">green</color><flip>horizontal</flip></bitmap></sprite>
          <sprite name="block"><bitmap from="block"><color char="t">green</color><flip>horizontal</flip></bitmap></sprite>
          <sprite name="hurt"><bitmap from="hurt"><color char="t">green</color><flip>horizontal</flip></bitmap></sprite>
          <!-- his jab: the fist out past his left side -->
          <animation name="jab">
            <seconds>0.06</seconds>
            <once />
            <frame sprite="guard" />
            <frame sprite="reach">
              <seconds>0.15</seconds>
              <hitbox name="fist">
                <rectangle><width>12</width><height>12</height></rectangle>
                <position><x>0</x><y>12</y></position>
              </hitbox>
            </frame>
            <frame sprite="guard"><seconds>0.12</seconds></frame>
          </animation>
          <position><x>400</x></position>
          <collisions>
            <hitbox name="body"><left>22</left><right>4</right></hitbox>
            <collision class="boxer" by="fist"><move direction="right">knock</move></collision>
            <collision class="boxer" hitbox="body" by="body"><move direction="right">shove</move></collision>
          </collisions>
        </object>
        <object name="score1">
          <sprite><text style="hud"><number>boxer1.points</number><color>red</color></text></sprite>
          <position><x>40</x><y>30</y></position>
        </object>
        <object name="score2">
          <sprite><text style="hud"><number>boxer2.points</number><color>green</color></text></sprite>
          <position><x><right><offset>40</offset></right></x><y>30</y></position>
        </object>
      </objects>
      <inputs>
        <input button="a"><trigger object="boxer1" action="left" /></input>
        <input button="d"><trigger object="boxer1" action="right" /></input>
        <input button="w"><trigger object="boxer1" action="jab" from="guard" /></input>
        <input button="s"><trigger object="boxer1" action="guard" from="guard" /></input>
        <input button="left"><trigger object="boxer2" action="left" /></input>
        <input button="right"><trigger object="boxer2" action="right" /></input>
        <input button="up"><trigger object="boxer2" action="jab" from="guard" /></input>
        <input button="down"><trigger object="boxer2" action="guard" from="guard" /></input>
        <input><button>pause</button><button>pad1.start</button><push state="paused" /></input>
      </inputs>
      <conditions>
        <condition object="boxer1" variable="points">
          <atleast>wins</atleast>
          <become object="over.winner" sprite="player1" />
          <play sound="bell" />
          <push state="over" />
        </condition>
        <condition object="boxer2" variable="points">
          <atleast>wins</atleast>
          <become object="over.winner" sprite="player2" />
          <play sound="bell" />
          <push state="over" />
        </condition>
      </conditions>
    </state>
    <state name="paused">
      <objects>
        <object name="paused">
          <sprite><text style="banner"><content>PAUSED</content></text></sprite>
          <position><x><centered /></x><y><centered /></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input><button>pause</button><button>pad1.start</button><pop /></input>
      </inputs>
    </state>
    <state name="over">
      <objects>
        <object name="winner">
          <sprite name="player1"><text style="banner"><content>PLAYER 1 WINS</content><size>56</size></text></sprite>
          <sprite name="player2"><text style="banner"><content>PLAYER 2 WINS</content><size>56</size></text></sprite>
          <position><x><centered /></x><y><centered><offset>-90</offset></centered></y></position>
        </object>
        <object name="continue">
          <sprite><text style="prompt"><content>spacebar to play again</content></text></sprite>
          <position><x><centered /></x><y><centered><offset>-20</offset></centered></y></position>
        </object>
      </objects>
      <shows>
        <show state="playing" />
      </shows>
      <inputs>
        <input button="space"><reset /></input>
      </inputs>
    </state>
  </states>
  <sounds>
    <sound name="swish" wave="noise">
      <volume>0.15</volume>
      <note pitch="4000" to="1500">0.08</note>
    </sound>
    <sound name="smack" wave="noise">
      <volume>0.4</volume>
      <note pitch="900" to="150">0.15</note>
    </sound>
    <sound name="thud" wave="square">
      <volume>0.25</volume>
      <note pitch="110" to="70">0.1</note>
    </sound>
    <sound name="bell" wave="triangle">
      <volume>0.4</volume>
      <note pitch="A5">0.15</note>
      <note pitch="A5">0.15</note>
      <note pitch="A5">0.6</note>
    </sound>
  </sounds>
  <pictures>
    <!-- s skin, g gloves, t trunks; 16 by 20, four pixels each. Facing
         right: both gloves up by the chin on guard; the jab puts the lead
         arm straight out, the glove at the far right -->
    <bitmap name="guard">
      <row>..ssss..........</row>
      <row>.ssssss...ggg...</row>
      <row>.ssssss...ggg...</row>
      <row>..ssss.gg.ggg...</row>
      <row>...ss..gg..s....</row>
      <row>.ssssssssss.....</row>
      <row>.sssssssss......</row>
      <row>.ssssss.........</row>
      <row>.ssssss.........</row>
      <row>.ssssss.........</row>
      <row>.ssssss.........</row>
      <row>.ssssss.........</row>
      <row>.tttttt.........</row>
      <row>.tttttt.........</row>
      <row>.tt..tt.........</row>
      <row>.ss..ss.........</row>
      <row>.ss..ss.........</row>
      <row>.ss..ss.........</row>
      <row>.ss..ss.........</row>
      <row>sss..sss........</row>
      <scale>4</scale>
      <color char="s">peach</color>
      <color char="g">red</color>
      <color char="t">blue</color>
    </bitmap>
    <bitmap name="reach">
      <row>..ssss..........</row>
      <row>.ssssss.........</row>
      <row>.ssssss.........</row>
      <row>..ssss.gg....ggg</row>
      <row>...ss..ggssssggg</row>
      <row>.sssssssssssssgg</row>
      <row>.sssssssss......</row>
      <row>.ssssss.........</row>
      <row>.ssssss.........</row>
      <row>.ssssss.........</row>
      <row>.ssssss.........</row>
      <row>.ssssss.........</row>
      <row>.tttttt.........</row>
      <row>.tttttt.........</row>
      <row>.tt..tt.........</row>
      <row>.ss..ss.........</row>
      <row>.ss..ss.........</row>
      <row>.ss..ss.........</row>
      <row>.ss..ss.........</row>
      <row>sss..sss........</row>
      <scale>4</scale>
      <color char="s">peach</color>
      <color char="g">red</color>
      <color char="t">blue</color>
    </bitmap>
    <bitmap name="block">
      <row>..ssss.ggg......</row>
      <row>.sssssgggg......</row>
      <row>.sssssgggg......</row>
      <row>..ssssggg.......</row>
      <row>...ss.ss........</row>
      <row>.sssssss........</row>
      <row>.sssssss........</row>
      <row>.ssssss.........</row>
      <row>.ssssss.........</row>
      <row>.ssssss.........</row>
      <row>.ssssss.........</row>
      <row>.ssssss.........</row>
      <row>.tttttt.........</row>
      <row>.tttttt.........</row>
      <row>.tt..tt.........</row>
      <row>.ss..ss.........</row>
      <row>.ss..ss.........</row>
      <row>.ss..ss.........</row>
      <row>.ss..ss.........</row>
      <row>sss..sss........</row>
      <scale>4</scale>
      <color char="s">peach</color>
      <color char="g">red</color>
      <color char="t">blue</color>
    </bitmap>
    <bitmap name="hurt">
      <row>ssss............</row>
      <row>sssss...........</row>
      <row>sssss...........</row>
      <row>.sss............</row>
      <row>..ss............</row>
      <row>.ssssss.........</row>
      <row>.sssssss........</row>
      <row>.ssssss.s.......</row>
      <row>.ssssss.gg......</row>
      <row>.ssssssggg......</row>
      <row>.ssssss.........</row>
      <row>.ssssss.........</row>
      <row>.tttttt.........</row>
      <row>.tttttt.........</row>
      <row>.tt..tt.........</row>
      <row>.ss..ss.........</row>
      <row>.ss..ss.........</row>
      <row>.ss..ss.........</row>
      <row>.ss..ss.........</row>
      <row>sss..sss........</row>
      <scale>4</scale>
      <color char="s">peach</color>
      <color char="g">red</color>
      <color char="t">blue</color>
    </bitmap>
  </pictures>
</game>
