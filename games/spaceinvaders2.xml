<!-- spaceinvaders2.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Oct 2, 2026 -->

<!--
  Space Invaders, drawn from an SVG sprite sheet instead of rows of text.

  assets/Space Invaders Color Sprites.svg is a sheet of 32 by 32 unit cells, six
  across and four down, with the frames of each picture running left to right
  (column, row):

    row 0   ship (0,0) idle, (1,0) banking left, (2,0) banking right, (3,0) hit
            flash; player bolts (4,0) and (5,0) charged
    row 1   enemy bolt (0,1), enemy bomb (1,1); explosion frames (2,1) to (5,1)
    row 2   alien A, frames (0,2) (1,2) (2,2); alien B, frames (3,2) (4,2) (5,2)
    row 3   alien C, frames (0,3) (1,3) (2,3); a flying saucer, frames (3,3) to (5,3)

  An <svg> sprite takes a part of a drawing (<x>, <y>, <width>, <height>, in the
  drawing's own units) and draws it `scale` real pixels to a unit, once, when the
  game loads; it is then an ordinary picture, so every window backend shows it
  alike. The parts here are cut close round the drawn pixels, so the box that is
  tested for a hit is about the size of the alien, and the same size for all the
  frames of one alien, which an animation needs. The sheet carries a backdrop of
  its own, which each sprite leaves out with <hide>.

  The aliens are one group of 11 columns and 5 rows, so they march, bounce and
  step down together as a single block. Each has three frames, which an
  <animation> shows one after the other, each for animation.seconds seconds:
  the squids' (A) are the group's, and rows 2 and 3 (B) and 4 and 5 (C) change
  the part of the sheet each frame takes. The ship is the idle picture, the bullet is the
  player bolt, and the aliens' bombs are the enemy bolt, flipped to fly down.
  The rest of the sheet (banking, the hit flash, the charged bolt, the enemy
  bomb, the explosions, the saucer) is not used yet.
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../xgedef.xsd">
  <window name="Space Invaders 2">
    <width>1024</width>
    <height>768</height>
    <background>color.black</background>
    <fullscreen>false</fullscreen>
    <framerate>60</framerate>
  </window>
  <variables>
    <variable name="margin">80</variable>
    <variable name="zoom">2</variable>
    <variable name="boltzoom">1.5</variable>
    <variable name="gap">15</variable>
    <variable name="animation.seconds">0.5</variable>
    <variable name="step">2</variable>
  </variables>
  <sounds>
    <!-- the cannon firing -->
    <sound name="shoot" wave="square">
      <volume>0.15</volume>
      <note pitch="C6" to="C5">0.08</note>
    </sound>
    <!-- an alien hit -->
    <sound name="alienhit" wave="noise">
      <volume>0.3</volume>
      <note pitch="6000" to="1500">0.15</note>
    </sound>
    <!-- the cannon hit by a bolt -->
    <sound name="playerhit" wave="noise">
      <volume>0.45</volume>
      <note pitch="2000" to="100">0.7</note>
    </sound>
  </sounds>
  <objects>
    <object name="bullet" class="projectile">
      <sprite>
        <svg>
          <path>assets/Space Invaders Color Sprites.svg</path>
          <x>140.5</x>
          <y>2.5</y>
          <width>7</width>
          <height>27</height>
          <scale>boltzoom</scale>
          <hide>backdrop</hide>
        </svg>
      </sprite>
      <position><x>0</x><y>0</y></position>
      <velocity><x>0</x><y>-12</y></velocity>
      <collisions>
        <enabled>false</enabled>
        <collision edge="all">
          <die />
        </collision>
        <collision class="aliens">
          <die />
        </collision>
      </collisions>
    </object>
    <object name="player">
      <sprite>
        <svg>
          <path>assets/Space Invaders Color Sprites.svg</path>
          <x>4</x>
          <y>3.5</y>
          <width>24</width>
          <height>26</height>
          <scale>zoom</scale>
          <hide>backdrop</hide>
        </svg>
      </sprite>
      <position><x>window.width.center - player.width / 2</x><y>window.bottom - player.height * 2</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>true</enabled>
        <collision edge="horizontal">
          <stick />
        </collision>
        <collision class="bomb">
          <dec variable="player.lives" />
          <play sound="playerhit" />
        </collision>
      </collisions>
      <actions>
        <action name="left">
          <move direction="left">step</move>
        </action>
        <action name="right">
          <move direction="right">step</move>
        </action>
        <action name="gun">
          <fire object="bullet" />
          <play sound="shoot" />
        </action>
      </actions>
      <variables>
        <variable name="lives">3</variable>
      </variables>
    </object>
    <!--
      The aliens' plasma bolts (the sheet's enemy bolt, (0,1)): a pool of
      three. Every alien faces down and drops one after a random wait.
    -->
    <group name="bombs" class="bomb">
      <sprite>
        <svg>
          <path>assets/Space Invaders Color Sprites.svg</path>
          <x>11</x>
          <y>37</y>
          <width>10</width>
          <height>23</height>
          <scale>boltzoom</scale>
          <hide>backdrop</hide>
          <!-- drawn flying up the sheet; these fly down -->
          <flip>vertical</flip>
        </svg>
      </sprite>
      <position><x>0</x><y>0</y></position>
      <velocity><x>0</x><y>5</y></velocity>
      <hidden>true</hidden>
      <collisions>
        <enabled>false</enabled>
        <collision edge="all">
          <die />
        </collision>
        <collision object="player">
          <die />
        </collision>
      </collisions>
      <member />
      <member />
      <member />
    </group>
    <group name="aliens" class="aliens">
      <columns>11</columns>
      <rows>5</rows>
      <padding><x>gap</x><y>gap</y></padding>
      <sprite name="a">
        <svg>
          <path>assets/Space Invaders Color Sprites.svg</path>
          <x>1.5</x>
          <y>64.5</y>
          <width>28</width>
          <height>25</height>
          <scale>zoom</scale>
          <hide>backdrop</hide>
        </svg>
      </sprite>
      <sprite name="b">
        <svg>
          <path>assets/Space Invaders Color Sprites.svg</path>
          <x>33.5</x>
          <y>64.5</y>
          <width>28</width>
          <height>25</height>
          <scale>zoom</scale>
          <hide>backdrop</hide>
        </svg>
      </sprite>
      <sprite name="c">
        <svg>
          <path>assets/Space Invaders Color Sprites.svg</path>
          <x>65.5</x>
          <y>64.5</y>
          <width>28</width>
          <height>25</height>
          <scale>zoom</scale>
          <hide>backdrop</hide>
        </svg>
      </sprite>
      <animation>
        <interval>animation.seconds</interval>
        <frame sprite="a" />
        <frame sprite="b" />
        <frame sprite="c" />
      </animation>
      <position><x>margin</x><y>margin / 2</y></position>
      <velocity><x>2</x><y>0</y></velocity>
      <facing>down</facing>
      <collisions>
        <enabled>true</enabled>
        <lockstep>true</lockstep>
        <collision edge="horizontal">
          <bounce />
          <move direction="down">10</move>
        </collision>
        <collision object="bullet">
          <play sound="alienhit" />
          <die />
        </collision>
      </collisions>
      <timers>
        <timer>
          <every><random min="2" max="25" /></every>
          <fire object="bombs" />
        </timer>
      </timers>
      <row number="2 3">
        <sprite name="a">
          <svg>
            <x>98</x>
            <y>70.5</y>
            <height>23</height>
          </svg>
        </sprite>
        <sprite name="b">
          <svg>
            <x>130</x>
            <y>70.5</y>
            <height>23</height>
          </svg>
        </sprite>
        <sprite name="c">
          <svg>
            <x>162</x>
            <y>70.5</y>
            <height>23</height>
          </svg>
        </sprite>
      </row>
      <row number="4 5">
        <sprite name="a">
          <svg>
            <y>99.5</y>
            <height>24.5</height>
          </svg>
        </sprite>
        <sprite name="b">
          <svg>
            <y>99.5</y>
            <height>24.5</height>
          </svg>
        </sprite>
        <sprite name="c">
          <svg>
            <y>99.5</y>
            <height>24.5</height>
          </svg>
        </sprite>
      </row>
    </group>
    <object name="title">
      <sprite>
        <text>
          <content>SPACE INVADERS</content>
          <size>110</size>
          <color>color.green</color>
        </text>
      </sprite>
      <position><x>window.width.center - title.width / 2</x><y>window.height.center - title.height / 2 - 100</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="youwin">
      <sprite>
        <text>
          <content>YOU WIN</content>
          <size>128</size>
          <color>color.green</color>
        </text>
      </sprite>
      <position><x>window.width.center - youwin.width / 2</x><y>window.height.center - 150</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="continue">
      <sprite>
        <text>
          <content>spacebar to continue</content>
          <size>48</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position><x>window.width.center - continue.width / 2</x><y>window.height.center + 60</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="settings">
      <sprite>
        <text>
          <content>settings</content>
          <size>128</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position><x>window.width.center - settings.width / 2</x><y>window.height.center - settings.height / 2</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="paused">
      <sprite>
        <text>
          <content>paused</content>
          <size>128</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position><x>window.width.center - paused.width / 2</x><y>window.height.center - paused.height / 2</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="lives">
      <sprite>
        <text>
          <number>player.lives</number>
          <size>40</size>
          <color>color.green</color>
        </text>
      </sprite>
      <position><x>20</x><y>window.bottom - 50</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="youlose">
      <sprite>
        <text>
          <content>GAME OVER</content>
          <size>128</size>
          <color>color.red</color>
        </text>
      </sprite>
      <position><x>window.width.center - youlose.width / 2</x><y>window.height.center - 150</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
  </objects>
  <states>
    <state name="mainmenu">
      <shows>
        <show object="title" />
        <show object="player" />
      </shows>
      <inputs>
        <input button="space">
          <push state="playing" />
        </input>
        <input button="s">
          <push state="settings" />
        </input>
      </inputs>
    </state>
    <state name="settings">
      <shows>
        <show object="settings" />
        <show object="player" />
      </shows>
      <inputs>
        <input button="escape">
          <pop />
        </input>
      </inputs>
    </state>
    <state name="playing">
      <shows>
        <show object="bullet" />
        <show object="bombs" />
        <show object="player" />
        <show object="aliens" />
        <show object="lives" />
      </shows>
      <inputs>
        <input button="p">
          <push state="paused" />
        </input>
        <input button="a">
          <trigger object="player" action="left" />
        </input>
        <input button="left">
          <trigger object="player" action="left" />
        </input>
        <input button="d">
          <trigger object="player" action="right" />
        </input>
        <input button="right">
          <trigger object="player" action="right" />
        </input>
        <input button="space">
          <trigger object="player" action="gun" />
        </input>
        <input button="escape">
          <push state="paused" />
        </input>
      </inputs>
      <conditions>
        <condition class="aliens">
          <remaining>0</remaining>
          <push state="gameover" />
        </condition>
        <condition object="player" variable="lives">
          <atmost>0</atmost>
          <push state="lost" />
        </condition>
      </conditions>
    </state>
    <state name="paused">
      <shows>
        <show object="paused" />
        <show object="player" />
      </shows>
      <inputs>
        <input button="space">
          <pop />
        </input>
        <input button="p">
          <pop />
        </input>
      </inputs>
    </state>
    <state name="lost">
      <shows>
        <show object="youlose" />
        <show object="continue" />
      </shows>
      <inputs>
        <input button="space">
          <reset />
        </input>
      </inputs>
    </state>
    <state name="gameover">
      <shows>
        <show object="youwin" />
        <show object="continue" />
      </shows>
      <inputs>
        <input button="space">
          <reset />
        </input>
      </inputs>
    </state>
  </states>
</game>
