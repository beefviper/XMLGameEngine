<!-- demonattack.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Oct 10, 2026 -->

<!--
  Demon Attack, after Imagic's 1982 Atari 2600 game. Your laser cannon slides
  along the bottom of the screen and fires up at the demons that flap about
  the sky above you and drop bombs. Three waves: flapping demons that sweep
  from side to side; demons that split into two small ones, which dive at you,
  when they are shot; and big demons that take two hits. A bomb, anything you
  touch, or a demon that reaches you costs a cannon; three cannons. Clear the
  three waves to win.

  A and D (or the arrows) slide, Space fires, P or Escape pauses.

  How it is written:
  * A wave is a <group> of demons, each with a velocity of its own, bouncing off
    the sides, turning round on a timer drawn anew each time and dropping bombs
    from under it (<facing>down</facing>, <fire>) on another.
  * The demons of the first wave flap: two named bitmaps and an <animation>.
  * The second wave's demons <release> two small demons from a pool where they
    were shot; the pool is made ahead of time and hidden, as Asteroids' rocks
    are. A wave is over when none of the class is left in play, small ones too.
  * The third wave's demons have two looks, whole and hurt: a hit turns the
    first into the second, and the next takes it out (Breakout's bricks).
  * Each wave is a <state>; a condition that none of it is left moves on.
  Not in it: the demons that fly down at you from the start of the later
  waves, the spare cannons that are added every so many points, and the colors
  that change every wave.
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../xgedef.xsd">
  <window name="Demon Attack">
    <width>640</width>
    <height>480</height>
    <background>color.black</background>
    <fullscreen>false</fullscreen>
    <framerate>60</framerate>
  </window>
  <variables>
    <variable name="margin">10</variable>
    <variable name="slide">5</variable>
    <variable name="laserspeed">9</variable>
    <variable name="bombspeed">4</variable>
    <!-- a demon drops a bomb every drop - 1 to drop + 2 seconds; the big ones a second sooner -->
    <variable name="drop">3</variable>
    <variable name="speed1">2</variable>
    <variable name="speed2">2.5</variable>
    <variable name="speed3">3</variable>
    <!-- what the small demons do as they come down -->
    <variable name="dive">2.5</variable>
    <variable name="sway">2</variable>
  </variables>
  <sounds>
    <sound name="fire" wave="square">
      <volume>0.15</volume>
      <note pitch="E6" to="E5">0.07</note>
    </sound>
    <sound name="hit" wave="noise">
      <volume>0.3</volume>
      <note pitch="3000" to="300">0.25</note>
    </sound>
    <sound name="split" wave="triangle">
      <volume>0.3</volume>
      <note pitch="C5" to="G5">0.12</note>
      <note pitch="G5" to="C5">0.12</note>
    </sound>
    <sound name="hurt" wave="sawtooth">
      <volume>0.2</volume>
      <note pitch="A3" to="A2">0.15</note>
    </sound>
    <sound name="lost" wave="triangle">
      <volume>0.4</volume>
      <note pitch="E4" to="E2">0.6</note>
    </sound>
    <sound name="wave" wave="square">
      <volume>0.2</volume>
      <note pitch="C5">0.08</note>
      <note pitch="E5">0.08</note>
      <note pitch="G5">0.08</note>
      <note pitch="C6">0.2</note>
    </sound>
  </sounds>
  <objects>
    <!-- the laser cannon -->
    <object name="player" class="player">
      <sprite>
        <bitmap>
          <row>......*......</row>
          <row>.....***.....</row>
          <row>.....***.....</row>
          <row>..*********..</row>
          <row>.***********.</row>
          <row>*************</row>
          <row>***.......***</row>
          <scale>3</scale>
          <color>color.cyan</color>
        </bitmap>
      </sprite>
      <position><x>window.width.center - player.width / 2</x><y>window.bottom - player.height - 20</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>true</enabled>
        <collision edge="horizontal">
          <stick />
        </collision>
        <collision class="bomb">
          <dec variable="player.lives" />
          <play sound="lost" />
          <reset object="bombs" />
          <reset />
        </collision>
        <collision class="demon1">
          <dec variable="player.lives" />
          <play sound="lost" />
          <reset object="bombs" />
          <reset />
        </collision>
        <collision class="demon2">
          <dec variable="player.lives" />
          <play sound="lost" />
          <reset object="bombs" />
          <reset />
        </collision>
        <collision class="demon3">
          <dec variable="player.lives" />
          <play sound="lost" />
          <reset object="bombs" />
          <reset />
        </collision>
      </collisions>
      <actions>
        <action name="left">
          <move direction="left">slide</move>
        </action>
        <action name="right">
          <move direction="right">slide</move>
        </action>
        <action name="fire">
          <fire object="laser" />
          <play sound="fire" />
        </action>
      </actions>
      <variables>
        <variable name="score">0</variable>
        <variable name="lives">3</variable>
      </variables>
    </object>

    <!-- one shot at a time, away when it hits a demon or leaves the screen -->
    <object name="laser" class="laser">
      <sprite>
        <rectangle>
          <width>3</width>
          <height>14</height>
          <color>color.yellow</color>
        </rectangle>
      </sprite>
      <position><x>0</x><y>0</y></position>
      <velocity><x>0</x><y>-laserspeed</y></velocity>
      <hidden>true</hidden>
      <collisions>
        <enabled>false</enabled>
        <collision edge="all">
          <die />
        </collision>
        <collision class="demon1">
          <die />
        </collision>
        <collision class="demon2">
          <die />
        </collision>
        <collision class="demon3">
          <die />
        </collision>
      </collisions>
    </object>

    <!-- the demons' bombs: a pool of eight, hidden until one is dropped -->
    <group name="bombs" class="bomb">
      <sprite>
        <rectangle>
          <width>5</width>
          <height>12</height>
          <color>color.red</color>
        </rectangle>
      </sprite>
      <position><x>0</x><y>0</y></position>
      <velocity><x>0</x><y>bombspeed</y></velocity>
      <hidden>true</hidden>
      <collisions>
        <enabled>false</enabled>
        <collision edge="all">
          <die />
        </collision>
        <collision object="player">
          <die />
        </collision>
      </collisions>
      <member />
      <member />
      <member />
      <member />
      <member />
      <member />
      <member />
      <member />
    </group>

    <!-- the first wave: six flapping demons, each at a speed of its own, three to a row -->
    <group name="demons1" class="demon1">
      <sprite name="up">
        <bitmap>
          <row>.*.......*.</row>
          <row>.**.....**.</row>
          <row>..*.***.*..</row>
          <row>..*******..</row>
          <row>...*.*.*...</row>
          <row>...*****...</row>
          <row>....*.*....</row>
          <scale>3</scale>
          <color>color.orange</color>
        </bitmap>
      </sprite>
      <sprite name="down">
        <bitmap>
          <row>...........</row>
          <row>..*.....*..</row>
          <row>.**.***.**.</row>
          <row>.*.*****.*.</row>
          <row>...*.*.*...</row>
          <row>...*****...</row>
          <row>....*.*....</row>
          <scale>3</scale>
          <color>color.orange</color>
        </bitmap>
      </sprite>
      <animation>
        <interval>0.25</interval>
        <frame sprite="up" />
        <frame sprite="down" />
      </animation>
      <velocity><x>speed1</x><y>0</y></velocity>
      <facing>down</facing>
      <collisions>
        <enabled>true</enabled>
        <collision edge="horizontal">
          <bounce />
        </collision>
        <collision object="laser">
          <inc variable="player.score">30</inc>
          <play sound="hit" />
          <die />
        </collision>
      </collisions>
      <timers>
        <timer>
          <every><random min="1" max="3" /></every>
          <reverse />
        </timer>
        <timer>
          <every><random min="drop - 1" max="drop + 2" /></every>
          <fire object="bombs" />
        </timer>
      </timers>
      <member><position><x>70</x><y>70</y></position></member>
      <member><position><x>260</x><y>70</y></position><velocity><x>-speed1 * 1.25</x></velocity></member>
      <member><position><x>450</x><y>70</y></position><velocity><x>speed1 * 0.75</x></velocity></member>
      <member><position><x>165</x><y>130</y></position><velocity><x>-speed1</x></velocity></member>
      <member><position><x>355</x><y>130</y></position><velocity><x>speed1 * 1.25</x></velocity></member>
      <member><position><x>545</x><y>130</y></position><velocity><x>-speed1 * 0.75</x></velocity></member>
    </group>

    <!-- the second wave: four demons that split in two when they are shot -->
    <group name="demons2" class="demon2">
      <sprite name="walk">
        <bitmap>
          <row>..***...***..</row>
          <row>.*****.*****.</row>
          <row>*.*.*****.*.*</row>
          <row>*************</row>
          <row>.*.*.***.*.*.</row>
          <row>..*.*...*.*..</row>
          <row>.*...*.*...*.</row>
          <scale>3</scale>
          <color>color.magenta</color>
        </bitmap>
      </sprite>
      <sprite name="step">
        <bitmap>
          <row>..***...***..</row>
          <row>.*****.*****.</row>
          <row>*.*.*****.*.*</row>
          <row>*************</row>
          <row>.*.*.***.*.*.</row>
          <row>.*..*...*..*.</row>
          <row>*....*.*....*</row>
          <scale>3</scale>
          <color>color.magenta</color>
        </bitmap>
      </sprite>
      <animation>
        <interval>0.25</interval>
        <frame sprite="walk" />
        <frame sprite="step" />
      </animation>
      <velocity><x>speed2</x><y>0</y></velocity>
      <facing>down</facing>
      <collisions>
        <enabled>true</enabled>
        <collision edge="horizontal">
          <bounce />
        </collision>
        <collision object="laser">
          <inc variable="player.score">50</inc>
          <play sound="split" />
          <release object="halves">2</release>
          <die />
        </collision>
      </collisions>
      <timers>
        <timer>
          <every><random min="1" max="3" /></every>
          <reverse />
        </timer>
        <timer>
          <every><random min="drop - 1" max="drop + 2" /></every>
          <fire object="bombs" />
        </timer>
      </timers>
      <member><position><x>100</x><y>70</y></position></member>
      <member><position><x>380</x><y>70</y></position><velocity><x>-speed2</x></velocity></member>
      <member><position><x>240</x><y>140</y></position><velocity><x>-speed2 * 0.8</x></velocity></member>
      <member><position><x>520</x><y>140</y></position><velocity><x>speed2 * 0.8</x></velocity></member>
    </group>

    <!-- what a split demon leaves: eight small demons, hidden until two are
         released where it was, which fall at the cannon, swaying from side to
         side, and are gone at the bottom -->
    <group name="halves" class="demon2">
      <sprite>
        <bitmap>
          <row>.*...*.</row>
          <row>*******</row>
          <row>*.***.*</row>
          <row>*******</row>
          <row>.*...*.</row>
          <scale>3</scale>
          <color>color.yellow</color>
        </bitmap>
      </sprite>
      <position><x>0</x><y>0</y></position>
      <velocity><x><random min="-sway" max="sway" /></x><y>dive</y></velocity>
      <hidden>true</hidden>
      <collisions>
        <enabled>true</enabled>
        <collision edge="horizontal">
          <bounce />
        </collision>
        <collision edge="bottom">
          <die />
        </collision>
        <collision object="laser">
          <inc variable="player.score">25</inc>
          <play sound="hit" />
          <die />
        </collision>
        <collision object="player">
          <die />
        </collision>
      </collisions>
      <member />
      <member />
      <member />
      <member />
      <member />
      <member />
      <member />
      <member />
    </group>

    <!-- the third wave: three big demons that take two hits -->
    <group name="demons3" class="demon3">
      <sprite name="full">
        <bitmap>
          <row>..*.........*..</row>
          <row>.**..*****..**.</row>
          <row>***.*******.***</row>
          <row>*****.***.*****</row>
          <row>.***.*****.***.</row>
          <row>..*.*.***.*.*..</row>
          <row>.*...*...*...*.</row>
          <row>*...*.....*...*</row>
          <scale>3</scale>
          <color>color.purple</color>
        </bitmap>
      </sprite>
      <sprite name="hurt">
        <bitmap>
          <row>..*.........*..</row>
          <row>.**..*****..**.</row>
          <row>***.*******.***</row>
          <row>*****.***.*****</row>
          <row>.***.*****.***.</row>
          <row>..*.*.***.*.*..</row>
          <row>.*...*...*...*.</row>
          <row>*...*.....*...*</row>
          <scale>3</scale>
          <color>color.red</color>
        </bitmap>
      </sprite>
      <velocity><x>speed3</x><y>0</y></velocity>
      <facing>down</facing>
      <collisions>
        <enabled>true</enabled>
        <collision edge="horizontal">
          <bounce />
        </collision>
        <!-- the hurt look first: a hit on a whole one only turns it -->
        <collision object="laser" sprite="hurt">
          <inc variable="player.score">100</inc>
          <play sound="hit" />
          <die />
        </collision>
        <collision object="laser" sprite="full">
          <inc variable="player.score">20</inc>
          <play sound="hurt" />
          <become sprite="hurt" />
        </collision>
      </collisions>
      <timers>
        <timer>
          <every><random min="1" max="2.5" /></every>
          <reverse />
        </timer>
        <timer>
          <every><random min="drop - 2" max="drop" /></every>
          <fire object="bombs" />
        </timer>
      </timers>
      <member><position><x>120</x><y>70</y></position></member>
      <member><position><x>300</x><y>130</y></position><velocity><x>-speed3</x></velocity></member>
      <member><position><x>480</x><y>190</y></position><velocity><x>speed3 * 0.8</x></velocity></member>
    </group>

    <object name="score">
      <sprite>
        <text>
          <number>player.score</number>
          <size>28</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position><x>margin</x><y>margin</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="lives">
      <sprite>
        <text>
          <number>player.lives</number>
          <size>28</size>
          <color>color.cyan</color>
        </text>
      </sprite>
      <position><x>window.right - lives.width - margin</x><y>margin</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>

    <object name="title">
      <sprite>
        <text>
          <content>DEMON ATTACK</content>
          <size>80</size>
          <color>color.orange</color>
        </text>
      </sprite>
      <position><x>window.width.center - title.width / 2</x><y>window.height.center - title.height / 2 + (-140)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="help">
      <sprite>
        <text>
          <content>shoot every demon before it bombs you</content>
          <size>24</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position><x>window.width.center - help.width / 2</x><y>window.height.center - help.height / 2 + (-40)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="keys">
      <sprite>
        <text>
          <content>a and d (or the arrows) slide, space fires</content>
          <size>22</size>
          <color>color.lightgrey</color>
        </text>
      </sprite>
      <position><x>window.width.center - keys.width / 2</x><y>window.height.center - keys.height / 2 + (10)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="start">
      <sprite>
        <text>
          <content>spacebar to start</content>
          <size>40</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position><x>window.width.center - start.width / 2</x><y>window.height.center - start.height / 2 + (110)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="paused">
      <sprite>
        <text>
          <content>PAUSED</content>
          <size>100</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position><x>window.width.center - paused.width / 2</x><y>window.height.center - paused.height / 2</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="youwin">
      <sprite>
        <text>
          <content>YOU WIN</content>
          <size>100</size>
          <color>color.green</color>
        </text>
      </sprite>
      <position><x>window.width.center - youwin.width / 2</x><y>window.height.center - youwin.height / 2 + (-60)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="gameover">
      <sprite>
        <text>
          <content>GAME OVER</content>
          <size>100</size>
          <color>color.red</color>
        </text>
      </sprite>
      <position><x>window.width.center - gameover.width / 2</x><y>window.height.center - gameover.height / 2 + (-60)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="again">
      <sprite>
        <text>
          <content>spacebar to play again</content>
          <size>40</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position><x>window.width.center - again.width / 2</x><y>window.height.center - again.height / 2 + (70)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
  </objects>
  <states>
    <keys name="cannon">
      <input button="a left"><trigger object="player" action="left" /></input>
      <input button="d right"><trigger object="player" action="right" /></input>
      <input button="space"><trigger object="player" action="fire" /></input>
      <input button="p escape"><push state="paused" /></input>
    </keys>

    <state name="title">
      <shows>
        <show object="title" />
        <show object="help" />
        <show object="keys" />
        <show object="start" />
      </shows>
      <inputs>
        <input button="space"><push state="wave1" /></input>
      </inputs>
    </state>
    <state name="wave1">
      <shows>
        <show object="demons1" />
        <show object="bombs" />
        <show object="laser" />
        <show object="player" />
        <show object="score" />
        <show object="lives" />
      </shows>
      <inputs keys="cannon" />
      <conditions>
        <condition object="player" variable="lives">
          <atmost>0</atmost>
          <push state="gameover" />
        </condition>
        <condition class="demon1">
          <remaining>0</remaining>
          <play sound="wave" />
          <reset object="bombs" />
          <reset object="laser" />
          <pop state="wave2" />
        </condition>
      </conditions>
    </state>
    <state name="wave2">
      <shows>
        <show object="demons2" />
        <show object="halves" />
        <show object="bombs" />
        <show object="laser" />
        <show object="player" />
        <show object="score" />
        <show object="lives" />
      </shows>
      <inputs keys="cannon" />
      <conditions>
        <condition object="player" variable="lives">
          <atmost>0</atmost>
          <push state="gameover" />
        </condition>
        <!-- the demons and the small ones they leave are one class -->
        <condition class="demon2">
          <remaining>0</remaining>
          <play sound="wave" />
          <reset object="bombs" />
          <reset object="laser" />
          <pop state="wave3" />
        </condition>
      </conditions>
    </state>
    <state name="wave3">
      <shows>
        <show object="demons3" />
        <show object="bombs" />
        <show object="laser" />
        <show object="player" />
        <show object="score" />
        <show object="lives" />
      </shows>
      <inputs keys="cannon" />
      <conditions>
        <condition object="player" variable="lives">
          <atmost>0</atmost>
          <push state="gameover" />
        </condition>
        <condition class="demon3">
          <remaining>0</remaining>
          <play sound="wave" />
          <push state="youwin" />
        </condition>
      </conditions>
    </state>
    <state name="paused">
      <shows>
        <show object="paused" />
      </shows>
      <inputs>
        <input button="space p escape"><pop /></input>
      </inputs>
    </state>
    <state name="youwin">
      <shows>
        <show object="youwin" />
        <show object="score" />
        <show object="again" />
      </shows>
      <inputs>
        <input button="space"><reset /></input>
      </inputs>
    </state>
    <state name="gameover">
      <shows>
        <show object="gameover" />
        <show object="score" />
        <show object="again" />
      </shows>
      <inputs>
        <input button="space"><reset /></input>
      </inputs>
    </state>
  </states>
</game>
