<!-- breakout.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Sept 18, 2020 -->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../assets/xmlgameengine.xsd">
  <window name="Breakout">
    <width>1280</width>
    <height>720</height>
    <background>color.black</background>
    <fullscreen>false</fullscreen>
    <framerate>60</framerate>
  </window>
  <variables>
    <variable name="margin">80</variable>
    <variable name="ball.radius">10</variable>
    <variable name="width">120</variable>
    <variable name="height">30</variable>
    <variable name="step">2</variable>
  </variables>
  <objects>
    <object name="ball">
      <sprite>
        <circle>
          <radius>ball.radius</radius>
        </circle>
      </sprite>
      <position>
        <x>window.width.center - ball.radius</x>
        <y>window.bottom - height * 3</y>
      </position>
      <velocity>
        <x><random min="-3" max="3" /></x>
        <y><random min="-7" max="-5" /></y>
      </velocity>
      <collisions>
        <enabled>true</enabled>
        <collision edge="all">
          <bounce />
        </collision>
        <collision edge="bottom">
          <die />
        </collision>
        <collision>
          <bounce />
        </collision>
      </collisions>
    </object>
    <object name="player">
      <sprite>
        <rectangle>
          <width>width</width>
          <height>height</height>
        </rectangle>
      </sprite>
      <position>
        <x>window.width.center</x>
        <y>window.bottom - height * 2</y>
      </position>
      <velocity>
        <x>0</x>
        <y>0</y>
      </velocity>
      <collisions>
        <enabled>true</enabled>
        <collision edge="horizontal">
          <stick />
        </collision>
      </collisions>
      <actions>
        <action name="left">
          <move direction="left">step</move>
        </action>
        <action name="right">
          <move direction="right">step</move>
        </action>
      </actions>
    </object>
    <object name="bricks">
      <sprite>
        <grid>
          <columns>9</columns>
          <rows>6</rows>
          <padding>
            <x>5</x>
            <y>5</y>
          </padding>
          <rectangle>
            <width>width</width>
            <height>height</height>
          </rectangle>
        </grid>
      </sprite>
      <position>
        <x>margin</x>
        <y>margin/2</y>
      </position>
      <velocity>
        <x>0</x>
        <y>0</y>
      </velocity>
      <collisions>
        <enabled>true</enabled>
        <lockstep>true</lockstep>
        <collision edge="horizontal">
          <bounce />
        </collision>
        <collision>
          <die />
        </collision>
      </collisions>
    </object>
  </objects>
  <states>
    <state name="mainmenu">
      <shows>
        <show object="player" />
      </shows>
      <inputs>
        <input button="space">
          <push state="playing" />
        </input>
        <input button="s">
          <push state="settings" />
        </input>
      </inputs>
    </state>
    <state name="settings">
      <shows>
        <show object="player" />
      </shows>
      <inputs>
        <input button="escape">
          <pop />
        </input>
      </inputs>
    </state>
    <state name="playing">
      <shows>
        <show object="ball" />
        <show object="player" />
        <show object="bricks" />
      </shows>
      <inputs>
        <input button="space">
          <push state="paused" />
        </input>
        <input button="left">
          <trigger object="player" action="left" />
        </input>
        <input button="right">
          <trigger object="player" action="right" />
        </input>
      </inputs>
    </state>
    <state name="paused">
      <shows>
        <show object="player" />
      </shows>
      <inputs>
        <input button="space">
          <pop />
        </input>
      </inputs>
    </state>
  </states>
</game>
