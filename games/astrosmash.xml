<!-- astrosmash.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Sept 30, 2026 -->

<!--
  Astrosmash, after the 1981 Intellivision game: rocks fall from the top of the
  screen and you shoot them from a ship that slides along the bottom. A rock
  that is shot scores and starts its fall over; a rock that reaches the ground
  or hits the ship costs a life. Score `goal` to win, lose all your lives and
  it is game over.

  Everything in it is a verb the language already had. It is Kaboom's falling
  pieces, with their fall speeds and starting heights drawn by <random> when
  the game loads, plus Space Invaders' gun: <fire /> launches one shot at a time
  from the ship, and the shot <die />s on a rock or the edge of the screen.
  A rock hit by the shot is <inc />'d for the ship and <reset /> to the start of
  its fall. Two groups of falling things, slow boulders and fast pebbles, share
  the class `rocks`, so the shot and the ship have one rule each for both.
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../xgedef.xsd">
  <window name="Astrosmash">
    <width>800</width>
    <height>600</height>
    <background>color.black</background>
    <fullscreen>false</fullscreen>
    <framerate>60</framerate>
  </window>
  <variables>
    <variable name="shipwidth">60</variable>
    <variable name="shipheight">20</variable>
    <variable name="boulder">34</variable>
    <variable name="pebble">18</variable>
    <variable name="step">7</variable>
    <variable name="margin">20</variable>
    <variable name="goal">20</variable>
    <variable name="startlives">5</variable>
  </variables>
  <objects>
    <group name="boulders" class="rocks">
      <sprite>
        <rectangle>
          <width>boulder</width>
          <height>boulder</height>
          <color>color.lightgrey</color>
        </rectangle>
      </sprite>
      <position>
        <y><random min="-500" max="-40" /></y>
      </position>
      <velocity>
        <x>0</x>
        <y><random min="1" max="2" /></y>
      </velocity>
      <collisions>
        <enabled>true</enabled>
        <collision edge="bottom">
          <dec variable="ship.lives" />
          <reset />
        </collision>
        <collision object="ship">
          <dec variable="ship.lives" />
          <reset />
        </collision>
        <collision object="shot">
          <inc variable="ship.score" />
          <reset />
        </collision>
      </collisions>
      <member>
        <position><x>50</x></position>
      </member>
      <member>
        <position><x>230</x></position>
      </member>
      <member>
        <position><x>410</x></position>
      </member>
      <member>
        <position><x>590</x></position>
      </member>
    </group>
    <group name="pebbles" class="rocks">
      <sprite>
        <rectangle>
          <width>pebble</width>
          <height>pebble</height>
          <color>color.orange</color>
        </rectangle>
      </sprite>
      <position>
        <y><random min="-700" max="-40" /></y>
      </position>
      <velocity>
        <x>0</x>
        <y><random min="2" max="3.5" /></y>
      </velocity>
      <collisions>
        <enabled>true</enabled>
        <collision edge="bottom">
          <dec variable="ship.lives" />
          <reset />
        </collision>
        <collision object="ship">
          <dec variable="ship.lives" />
          <reset />
        </collision>
        <collision object="shot">
          <inc variable="ship.score" />
          <reset />
        </collision>
      </collisions>
      <member>
        <position><x>140</x></position>
      </member>
      <member>
        <position><x>320</x></position>
      </member>
      <member>
        <position><x>500</x></position>
      </member>
      <member>
        <position><x>680</x></position>
      </member>
    </group>
    <object name="shot" class="projectile">
      <sprite>
        <rectangle>
          <width>4</width>
          <height>16</height>
          <color>color.white</color>
        </rectangle>
      </sprite>
      <position><x>0</x><y>0</y></position>
      <velocity><x>0</x><y>-11</y></velocity>
      <collisions>
        <enabled>false</enabled>
        <collision edge="all">
          <die />
        </collision>
        <collision class="rocks">
          <die />
        </collision>
      </collisions>
    </object>
    <object name="ship">
      <sprite>
        <rectangle>
          <width>shipwidth</width>
          <height>shipheight</height>
          <color>color.cyan</color>
        </rectangle>
      </sprite>
      <position><x>window.width.center - ship.width / 2</x><y>window.bottom - ship.height - margin</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>true</enabled>
        <collision edge="horizontal">
          <stick />
        </collision>
      </collisions>
      <actions>
        <action name="left">
          <move direction="left">step</move>
        </action>
        <action name="right">
          <move direction="right">step</move>
        </action>
        <action name="gun">
          <fire object="shot" />
        </action>
      </actions>
      <variables>
        <variable name="score">0</variable>
        <variable name="lives">startlives</variable>
      </variables>
    </object>
    <object name="score">
      <sprite>
        <text>
          <number>ship.score</number>
          <size>48</size>
          <color>color.cyan</color>
        </text>
      </sprite>
      <position><x>margin</x><y>margin</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="lives">
      <sprite>
        <text>
          <number>ship.lives</number>
          <size>48</size>
          <color>color.red</color>
        </text>
      </sprite>
      <position><x>window.right - lives.width - margin</x><y>margin</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="title">
      <sprite>
        <text>
          <content>ASTROSMASH</content>
          <size>120</size>
          <color>color.orange</color>
        </text>
      </sprite>
      <position><x>window.width.center - title.width / 2</x><y>window.height.center - title.height / 2 + (-130)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="help">
      <sprite>
        <text>
          <content>shoot the rocks before they land</content>
          <size>40</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position><x>window.width.center - help.width / 2</x><y>window.height.center - help.height / 2 + (-20)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="keys">
      <sprite>
        <text>
          <content>a and d, or the arrow keys, to move; space to fire</content>
          <size>28</size>
          <color>color.lightgrey</color>
        </text>
      </sprite>
      <position><x>window.width.center - keys.width / 2</x><y>window.height.center - keys.height / 2 + (30)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="start">
      <sprite>
        <text>
          <content>spacebar to start</content>
          <size>48</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position><x>window.width.center - start.width / 2</x><y>window.height.center - start.height / 2 + (130)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="paused">
      <sprite>
        <text>
          <content>PAUSED</content>
          <size>128</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position><x>window.width.center - paused.width / 2</x><y>window.height.center - paused.height / 2 + (0)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="youwin">
      <sprite>
        <text>
          <content>YOU WIN</content>
          <size>128</size>
          <color>color.green</color>
        </text>
      </sprite>
      <position><x>window.width.center - youwin.width / 2</x><y>window.height.center - youwin.height / 2 + (-60)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="gameover">
      <sprite>
        <text>
          <content>GAME OVER</content>
          <size>128</size>
          <color>color.red</color>
        </text>
      </sprite>
      <position><x>window.width.center - gameover.width / 2</x><y>window.height.center - gameover.height / 2 + (-60)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="again">
      <sprite>
        <text>
          <content>spacebar to play again</content>
          <size>48</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position><x>window.width.center - again.width / 2</x><y>window.height.center - again.height / 2 + (70)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
  </objects>
  <states>
    <state name="mainmenu">
      <shows>
        <show object="title" />
        <show object="help" />
        <show object="keys" />
        <show object="start" />
      </shows>
      <inputs>
        <input button="space">
          <push state="playing" />
        </input>
      </inputs>
    </state>
    <state name="playing">
      <shows>
        <show object="boulders" />
        <show object="pebbles" />
        <show object="shot" />
        <show object="ship" />
        <show object="score" />
        <show object="lives" />
      </shows>
      <inputs>
        <input button="a">
          <trigger object="ship" action="left" />
        </input>
        <input button="left">
          <trigger object="ship" action="left" />
        </input>
        <input button="d">
          <trigger object="ship" action="right" />
        </input>
        <input button="right">
          <trigger object="ship" action="right" />
        </input>
        <input button="space">
          <trigger object="ship" action="gun" />
        </input>
        <input button="p">
          <push state="paused" />
        </input>
        <input button="escape">
          <push state="paused" />
        </input>
      </inputs>
      <conditions>
        <condition object="ship" variable="score">
          <atleast>goal</atleast>
          <push state="youwin" />
        </condition>
        <condition object="ship" variable="lives">
          <atmost>0</atmost>
          <push state="gameover" />
        </condition>
      </conditions>
    </state>
    <state name="paused">
      <shows>
        <show object="paused" />
      </shows>
      <inputs>
        <input button="space">
          <pop />
        </input>
        <input button="p">
          <pop />
        </input>
        <input button="escape">
          <pop />
        </input>
      </inputs>
    </state>
    <state name="youwin">
      <shows>
        <show object="youwin" />
        <show object="score" />
        <show object="again" />
      </shows>
      <inputs>
        <input button="space">
          <reset />
        </input>
      </inputs>
    </state>
    <state name="gameover">
      <shows>
        <show object="gameover" />
        <show object="score" />
        <show object="again" />
      </shows>
      <inputs>
        <input button="space">
          <reset />
        </input>
      </inputs>
    </state>
  </states>
</game>
