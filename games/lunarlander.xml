<!-- lunarlander.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Sept 30, 2026 -->

<!--
  Lunar Lander, after the 1979 arcade game: a lander falls toward the moon,
  and has to be set down gently on the flat pad, with fuel to spare. Touch
  anything else, or the pad too fast, and it is wrecked.

  Everything on screen is drawn from <line>s, as the original was, and the
  collisions follow the lines, not the boxes around them: the lander, the
  ground and the pad are all `<type>pixel</type>`, so the lander is only
  touching the ground where a pixel of its legs really lies on a pixel of the
  ground. (The bounding boxes are still swept first, as for any object; the
  pixels are the second, closer look.)

  It needed verbs the language did not have. The moon pulls the lander down
  through its <acceleration>, and each thruster is an <accelerate> that adds to
  its velocity while the key is held and burns one unit of `fuel` a frame; with
  no fuel the thrusters do nothing. Setting down is a pair of rules about the
  pad, told apart by speed: <slower> is a landing, <faster> is a crash, and
  <stop /> is what a landed or wrecked lander does.
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../assets/xmlgameengine.xsd">
  <window name="Lunar Lander">
    <width>800</width>
    <height>600</height>
    <background>color.black</background>
    <fullscreen>false</fullscreen>
    <framerate>60</framerate>
  </window>
  <variables>
    <variable name="gravity">0.01</variable>
    <variable name="thrust">0.035</variable>
    <variable name="sidethrust">0.02</variable>
    <variable name="fuelstart">500</variable>
    <variable name="safespeed">1.2</variable>
    <variable name="margin">20</variable>
  </variables>
  <objects>
    <!-- The moon's surface, in two runs of lines with the pad's gap between them: peaks, slopes and a ledge. A line's coordinates are measured from the object's top left. -->
    <object name="terrain" class="ground">
      <sprite>
        <line><from><x>0</x><y>140</y></from><to><x>60</x><y>90</y></to><color>color.lightgrey</color><thickness>2</thickness></line>
        <line><from><x>60</x><y>90</y></from><to><x>110</x><y>120</y></to><color>color.lightgrey</color><thickness>2</thickness></line>
        <line><from><x>110</x><y>120</y></from><to><x>150</x><y>50</y></to><color>color.lightgrey</color><thickness>2</thickness></line>
        <line><from><x>150</x><y>50</y></from><to><x>200</x><y>140</y></to><color>color.lightgrey</color><thickness>2</thickness></line>
        <line><from><x>200</x><y>140</y></from><to><x>260</x><y>180</y></to><color>color.lightgrey</color><thickness>2</thickness></line>
        <line><from><x>260</x><y>180</y></from><to><x>320</x><y>180</y></to><color>color.lightgrey</color><thickness>2</thickness></line>
        <line><from><x>320</x><y>180</y></from><to><x>360</x><y>120</y></to><color>color.lightgrey</color><thickness>2</thickness></line>
        <line><from><x>360</x><y>120</y></from><to><x>400</x><y>70</y></to><color>color.lightgrey</color><thickness>2</thickness></line>
        <line><from><x>400</x><y>70</y></from><to><x>440</x><y>160</y></to><color>color.lightgrey</color><thickness>2</thickness></line>
        <line><from><x>440</x><y>160</y></from><to><x>498</x><y>180</y></to><color>color.lightgrey</color><thickness>2</thickness></line>
        <line><from><x>582</x><y>180</y></from><to><x>620</x><y>140</y></to><color>color.lightgrey</color><thickness>2</thickness></line>
        <line><from><x>620</x><y>140</y></from><to><x>660</x><y>90</y></to><color>color.lightgrey</color><thickness>2</thickness></line>
        <line><from><x>660</x><y>90</y></from><to><x>700</x><y>150</y></to><color>color.lightgrey</color><thickness>2</thickness></line>
        <line><from><x>700</x><y>150</y></from><to><x>740</x><y>110</y></to><color>color.lightgrey</color><thickness>2</thickness></line>
        <line><from><x>740</x><y>110</y></from><to><x>798</x><y>160</y></to><color>color.lightgrey</color><thickness>2</thickness></line>
      </sprite>
      <position><x>0</x><y>380</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>true</enabled>
        <type>pixel</type>
      </collisions>
    </object>
    <object name="pad" class="pad">
      <sprite>
        <line><from><x>0</x><y>0</y></from><to><x>76</x><y>0</y></to><color>color.green</color><thickness>4</thickness></line>
      </sprite>
      <position><x>500</x><y>560</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>true</enabled>
        <type>pixel</type>
      </collisions>
    </object>
    <object name="lander">
      <sprite>
        <line><from><x>10</x><y>2</y></from><to><x>20</x><y>2</y></to><thickness>2</thickness></line>
        <line><from><x>20</x><y>2</y></from><to><x>25</x><y>7</y></to><thickness>2</thickness></line>
        <line><from><x>25</x><y>7</y></from><to><x>25</x><y>14</y></to><thickness>2</thickness></line>
        <line><from><x>25</x><y>14</y></from><to><x>20</x><y>19</y></to><thickness>2</thickness></line>
        <line><from><x>20</x><y>19</y></from><to><x>10</x><y>19</y></to><thickness>2</thickness></line>
        <line><from><x>10</x><y>19</y></from><to><x>5</x><y>14</y></to><thickness>2</thickness></line>
        <line><from><x>5</x><y>14</y></from><to><x>5</x><y>7</y></to><thickness>2</thickness></line>
        <line><from><x>5</x><y>7</y></from><to><x>10</x><y>2</y></to><thickness>2</thickness></line>
        <line><from><x>12</x><y>9</y></from><to><x>18</x><y>9</y></to><thickness>2</thickness></line>
        <line><from><x>10</x><y>19</y></from><to><x>3</x><y>29</y></to><thickness>2</thickness></line>
        <line><from><x>20</x><y>19</y></from><to><x>27</x><y>29</y></to><thickness>2</thickness></line>
        <line><from><x>0</x><y>29</y></from><to><x>6</x><y>29</y></to><thickness>2</thickness></line>
        <line><from><x>24</x><y>29</y></from><to><x>30</x><y>29</y></to><thickness>2</thickness></line>
      </sprite>
      <position><x>window.width.center - lander.width / 2</x><y>40</y></position>
      <velocity><x>0.5</x><y>0</y></velocity>
      <acceleration><x>0</x><y>gravity</y></acceleration>
      <collisions>
        <enabled>true</enabled>
        <type>pixel</type>
        <collision edge="horizontal">
          <stick />
        </collision>
        <collision edge="top">
          <stick />
        </collision>
        <collision edge="bottom">
          <inc variable="lander.crashed" />
          <stop />
        </collision>
        <collision object="terrain">
          <inc variable="lander.crashed" />
          <stop />
        </collision>
        <collision object="pad">
          <slower>safespeed</slower>
          <inc variable="lander.landed" />
          <stop />
        </collision>
        <collision object="pad">
          <faster>safespeed</faster>
          <inc variable="lander.crashed" />
          <stop />
        </collision>
      </collisions>
      <actions>
        <action name="thrust">
          <accelerate direction="up" burn="fuel">thrust</accelerate>
        </action>
        <action name="left">
          <accelerate direction="left" burn="fuel">sidethrust</accelerate>
        </action>
        <action name="right">
          <accelerate direction="right" burn="fuel">sidethrust</accelerate>
        </action>
      </actions>
      <variables>
        <variable name="fuel">fuelstart</variable>
        <variable name="landed">0</variable>
        <variable name="crashed">0</variable>
      </variables>
    </object>
    <object name="fuelvalue">
      <sprite>
        <text>
          <number>lander.fuel</number>
          <size>30</size>
          <color>color.orange</color>
        </text>
      </sprite>
      <position><x>window.right - fuelvalue.width - margin</x><y>margin</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="fuellabel">
      <sprite>
        <text>
          <content>FUEL</content>
          <size>30</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position><x>window.right - fuelvalue.width - fuellabel.width - margin - 12</x><y>margin</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="title">
      <sprite>
        <text>
          <content>LUNAR LANDER</content>
          <size>110</size>
          <color>color.cyan</color>
        </text>
      </sprite>
      <position><x>window.width.center - title.width / 2</x><y>window.height.center - title.height / 2 + (-130)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="help">
      <sprite>
        <text>
          <content>set it down gently on the green pad</content>
          <size>32</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position><x>window.width.center - help.width / 2</x><y>window.height.center - help.height / 2 + (-20)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="keys">
      <sprite>
        <text>
          <content>up or w for the main thruster, left and right for the sides</content>
          <size>28</size>
          <color>color.lightgrey</color>
        </text>
      </sprite>
      <position><x>window.width.center - keys.width / 2</x><y>window.height.center - keys.height / 2 + (30)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="start">
      <sprite>
        <text>
          <content>spacebar to start</content>
          <size>48</size>
          <color>color.green</color>
        </text>
      </sprite>
      <position><x>window.width.center - start.width / 2</x><y>window.height.center - start.height / 2 + (110)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="paused">
      <sprite>
        <text>
          <content>PAUSED</content>
          <size>128</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position><x>window.width.center - paused.width / 2</x><y>window.height.center - paused.height / 2 + (0)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="landedmsg">
      <sprite>
        <text>
          <content>GOOD LANDING</content>
          <size>110</size>
          <color>color.green</color>
        </text>
      </sprite>
      <position><x>window.width.center - landedmsg.width / 2</x><y>window.height.center - landedmsg.height / 2 + (-60)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="crashedmsg">
      <sprite>
        <text>
          <content>CRASHED</content>
          <size>128</size>
          <color>color.red</color>
        </text>
      </sprite>
      <position><x>window.width.center - crashedmsg.width / 2</x><y>window.height.center - crashedmsg.height / 2 + (-60)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="again">
      <sprite>
        <text>
          <content>spacebar to play again</content>
          <size>48</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position><x>window.width.center - again.width / 2</x><y>window.height.center - again.height / 2 + (70)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
  </objects>
  <states>
    <state name="mainmenu">
      <shows>
        <show object="title" />
        <show object="help" />
        <show object="keys" />
        <show object="start" />
      </shows>
      <inputs>
        <input button="space">
          <push state="playing" />
        </input>
      </inputs>
    </state>
    <state name="playing">
      <shows>
        <show object="terrain" />
        <show object="pad" />
        <show object="lander" />
        <show object="fuellabel" />
        <show object="fuelvalue" />
      </shows>
      <inputs>
        <input button="up">
          <trigger object="lander" action="thrust" />
        </input>
        <input button="w">
          <trigger object="lander" action="thrust" />
        </input>
        <input button="left">
          <trigger object="lander" action="left" />
        </input>
        <input button="a">
          <trigger object="lander" action="left" />
        </input>
        <input button="right">
          <trigger object="lander" action="right" />
        </input>
        <input button="d">
          <trigger object="lander" action="right" />
        </input>
        <input button="space">
          <push state="paused" />
        </input>
        <input button="p">
          <push state="paused" />
        </input>
        <input button="escape">
          <push state="paused" />
        </input>
      </inputs>
      <conditions>
        <condition object="lander" variable="crashed">
          <atleast>1</atleast>
          <push state="crashed" />
        </condition>
        <condition object="lander" variable="landed">
          <atleast>1</atleast>
          <push state="landed" />
        </condition>
      </conditions>
    </state>
    <state name="paused">
      <shows>
        <show object="paused" />
      </shows>
      <inputs>
        <input button="space">
          <pop />
        </input>
        <input button="p">
          <pop />
        </input>
        <input button="escape">
          <pop />
        </input>
      </inputs>
    </state>
    <state name="landed">
      <shows>
        <show object="terrain" />
        <show object="pad" />
        <show object="lander" />
        <show object="fuellabel" />
        <show object="fuelvalue" />
        <show object="landedmsg" />
        <show object="again" />
      </shows>
      <inputs>
        <input button="space">
          <reset />
        </input>
      </inputs>
    </state>
    <state name="crashed">
      <shows>
        <show object="terrain" />
        <show object="pad" />
        <show object="lander" />
        <show object="fuellabel" />
        <show object="fuelvalue" />
        <show object="crashedmsg" />
        <show object="again" />
      </shows>
      <inputs>
        <input button="space">
          <reset />
        </input>
      </inputs>
    </state>
  </states>
</game>
