      <member>
        <position><x>604</x></position>
      </member>
    </group>
    <group name="lane9" class="traffic">
      <sprite>
        <rectangle>
          <width>54</width>
          <height>body</height>
          <color>color.red</color>
        </rectangle>
      </sprite>
      <position><y>9 * cell + inset</y></position>
      <velocity><x>-4</x><y>0</y></velocity>
      <collisions>
        <enabled>true</enabled>
        <collision edge="horizontal">
          <wrap />
        </collision>
      </collisions>
      <member>
        <position><x>196</x></position>
      </member>
      <member>
        <position><x>480</x></position>
      </member>
      <member>
        <position><x>764</x></position>
      </member>
    </group>
    <group name="lane10" class="traffic">
      <sprite>
        <rectangle>
          <width>96</width>
          <height>body</height>
