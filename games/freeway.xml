    <object name="chicken1" class="chicken">
      <sprite>
        <rectangle>
          <width>body</width>
          <height>body</height>
          <color>color.white</color>
        </rectangle>
      </sprite>
      <position><x>window.width.center / 2 - body / 2</x><y>11 * cell + inset</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>true</enabled>
        <collision class="traffic">
          <reset />
          <play sound="hit" />
        </collision>
        <collision class="farside">
          <inc variable="chicken1.score" />
          <reset />
          <play sound="cross" />
        </collision>
      </collisions>
      <actions>
        <action name="up">
          <hop direction="up">cell</hop>
          <play sound="hop" />
        </action>
        <action name="down">
          <hop direction="down">cell</hop>
          <play sound="hop" />
        </action>
      </actions>
      <variables>
        <variable name="score">0</variable>
      </variables>
    </object>
    <object name="chicken2" class="chicken">
      <sprite>
        <rectangle>
          <width>body</width>
          <height>body</height>
          <color>color.yellow</color>
        </rectangle>
      </sprite>
      <position><x>window.width.center * 1.5 - body / 2</x><y>11 * cell + inset</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>true</enabled>
        <collision class="traffic">
          <reset />
          <play sound="hit" />
        </collision>
        <collision class="farside">
          <inc variable="chicken2.score" />
          <reset />
          <play sound="cross" />
        </collision>
      </collisions>
      <actions>
        <action name="up">
          <hop direction="up">cell</hop>
          <play sound="hop" />
        </action>
        <action name="down">
          <hop direction="down">cell</hop>
          <play sound="hop" />
        </action>
      </actions>
      <variables>
        <variable name="score">0</variable>
      </variables>
    </object>
    <object name="score1">
      <sprite>
        <text>
          <number>chicken1.score</number>
          <size>36</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position><x>window.width.center / 2 - score1.width / 2</x><y>6</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="score2">
      <sprite>
        <text>
          <number>chicken2.score</number>
          <size>36</size>
          <color>color.yellow</color>
        </text>
      </sprite>
      <position><x>window.width.center * 1.5 - score2.width / 2</x><y>6</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="title">
      <sprite>
        <text>
          <content>FREEWAY</content>
          <size>128</size>
          <color>color.yellow</color>
        </text>
      </sprite>
      <position><x>window.width.center - title.width / 2</x><y>window.height.center - title.height / 2 + (-130)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="help">
      <sprite>
        <text>
          <content>get across ten lanes of traffic</content>
          <size>40</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position><x>window.width.center - help.width / 2</x><y>window.height.center - help.height / 2 + (-20)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="keys1">
      <sprite>
        <text>
          <content>player 1: w and s</content>
          <size>32</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position><x>window.width.center - keys1.width / 2</x><y>window.height.center - keys1.height / 2 + (40)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="keys2">
      <sprite>
        <text>
          <content>player 2: the up and down arrows</content>
          <size>32</size>
          <color>color.yellow</color>
        </text>
      </sprite>
      <position><x>window.width.center - keys2.width / 2</x><y>window.height.center - keys2.height / 2 + (80)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="start">
      <sprite>
        <text>
          <content>spacebar to start</content>
          <size>48</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position><x>window.width.center - start.width / 2</x><y>window.height.center - start.height / 2 + (160)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="paused">
      <sprite>
        <text>
          <content>PAUSED</content>
          <size>128</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position><x>window.width.center - paused.width / 2</x><y>window.height.center - paused.height / 2 + (0)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="p1wins">
      <sprite>
        <text>
          <content>PLAYER 1 WINS</content>
          <size>100</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position><x>window.width.center - p1wins.width / 2</x><y>window.height.center - p1wins.height / 2 + (-60)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="p2wins">
      <sprite>
        <text>
          <content>PLAYER 2 WINS</content>
          <size>100</size>
          <color>color.yellow</color>
        </text>
      </sprite>
      <position><x>window.width.center - p2wins.width / 2</x><y>window.height.center - p2wins.height / 2 + (-60)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="again">
      <sprite>
        <text>
          <content>spacebar to play again</content>
          <size>48</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position><x>window.width.center - again.width / 2</x><y>window.height.center - again.height / 2 + (60)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
  </objects>
  <states>
    <state name="mainmenu">
      <shows>
        <show object="title" />
        <show object="help" />
        <show object="keys1" />
        <show object="keys2" />
        <show object="start" />
      </shows>
      <inputs>
        <input button="space">
          <push state="playing" />
          <play sound="start" />
        </input>
      </inputs>
    </state>
    <state name="playing">
      <shows>
        <show object="verge" />
        <show object="road" />
        <show object="pavement" />
        <show object="lane1" />
        <show object="lane2" />
        <show object="lane3" />
        <show object="lane4" />
        <show object="lane5" />
        <show object="lane6" />
        <show object="lane7" />
        <show object="lane8" />
        <show object="lane9" />
        <show object="lane10" />
        <show object="chicken1" />
        <show object="chicken2" />
        <show object="score1" />
        <show object="score2" />
      </shows>
      <inputs>
        <input button="w">
          <trigger object="chicken1" action="up" />
        </input>
        <input button="s">
          <trigger object="chicken1" action="down" />
        </input>
        <input button="up">
          <trigger object="chicken2" action="up" />
        </input>
        <input button="down">
          <trigger object="chicken2" action="down" />
        </input>
        <input button="space">
          <push state="paused" />
        </input>
        <input button="p">
          <push state="paused" />
        </input>
        <input button="escape">
          <push state="paused" />
        </input>
      </inputs>
      <conditions>
        <condition object="chicken1" variable="score">
          <atleast>crossings</atleast>
          <push state="p1wins" />
          <play sound="win" />
        </condition>
        <condition object="chicken2" variable="score">
          <atleast>crossings</atleast>
          <push state="p2wins" />
          <play sound="win" />
        </condition>
      </conditions>
    </state>
    <state name="paused">
      <shows>
        <show object="paused" />
      </shows>
      <inputs>
        <input button="space">
          <pop />
        </input>
        <input button="p">
          <pop />
        </input>
        <input button="escape">
          <pop />
        </input>
      </inputs>
    </state>
    <state name="p1wins">
      <shows>
        <show object="p1wins" />
        <show object="score1" />
        <show object="score2" />
        <show object="again" />
      </shows>
      <inputs>
        <input button="space">
          <reset />
        </input>
      </inputs>
    </state>
    <state name="p2wins">
      <shows>
        <show object="p2wins" />
        <show object="score1" />
        <show object="score2" />
        <show object="again" />
      </shows>
      <inputs>
        <input button="space">
          <reset />
        </input>
      </inputs>
    </state>
  </states>
</game>
