    <object name="rocket1" class="rocket">
      <sprite src="shape.rectangle(ship.width,ship.height,'color.cyan')" />
      <position x="window.width.center / 2 - rocket1.width / 2" y="window.bottom - rocket1.height - margin" />
      <velocity x="0" y="0" />
      <collisions enabled="true">
        <collision edge="bottom" action="stick()" />
        <collision edge="top" action="inc('rocket1.score');reset()" />
        <collision class="debris" action="reset()" />
      </collisions>
      <actions>
        <action name="up" value="move.up(step)" />
        <action name="down" value="move.down(step)" />
      </actions>
      <variables>
        <variable name="score" value="0" />
      </variables>
    </object>
    <object name="rocket2" class="rocket">
      <sprite src="shape.rectangle(ship.width,ship.height,'color.yellow')" />
      <position x="window.width.center * 1.5 - rocket2.width / 2" y="window.bottom - rocket2.height - margin" />
      <velocity x="0" y="0" />
      <collisions enabled="true">
        <collision edge="bottom" action="stick()" />
        <collision edge="top" action="inc('rocket2.score');reset()" />
        <collision class="debris" action="reset()" />
      </collisions>
      <actions>
