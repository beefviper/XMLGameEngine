      <collisions enabled="false" />
    </object>
    <object name="score2">
      <sprite src="text(rocket2.score,64,'color.yellow')" />
      <position x="window.width.center + 60" y="window.bottom - score2.height - margin" />
      <velocity x="0" y="0" />
      <collisions enabled="false" />
    </object>
    <object name="title">
      <sprite src="text('SPACE RACE',128,'color.white')" />
      <position x="window.width.center - title.width / 2" y="window.height.center - title.height / 2 + (-60)" />
      <velocity x="0" y="0" />
      <collisions enabled="false" />
    </object>
    <object name="start">
      <sprite src="text('spacebar to start',48,'color.white')" />
      <position x="window.width.center - start.width / 2" y="window.height.center - start.height / 2 + (70)" />
      <velocity x="0" y="0" />
      <collisions enabled="false" />
    </object>
    <object name="paused">
      <sprite src="text('PAUSED',128,'color.white')" />
      <position x="window.width.center - paused.width / 2" y="window.height.center - paused.height / 2 + (0)" />
      <velocity x="0" y="0" />
      <collisions enabled="false" />
    </object>
    <object name="player1wins">
      <sprite src="text('PLAYER 1 WINS',96,'color.cyan')" />
      <position x="window.width.center - player1wins.width / 2" y="window.height.center - player1wins.height / 2 + (-60)" />
      <velocity x="0" y="0" />
      <collisions enabled="false" />
    </object>
    <object name="player2wins">
      <sprite src="text('PLAYER 2 WINS',96,'color.yellow')" />
      <position x="window.width.center - player2wins.width / 2" y="window.height.center - player2wins.height / 2 + (-60)" />
      <velocity x="0" y="0" />
      <collisions enabled="false" />
    </object>
    <object name="continue">
      <sprite src="text('spacebar to continue',48,'color.white')" />
      <position x="window.width.center - continue.width / 2" y="window.height.center - continue.height / 2 + (70)" />
      <velocity x="0" y="0" />
      <collisions enabled="false" />
    </object>
