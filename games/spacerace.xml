  <states>
    <state name="mainmenu">
      <shows>
        <show object="title" />
        <show object="start" />
      </shows>
      <inputs>
        <input button="space" action="state('playing')" />
      </inputs>
    </state>
    <state name="playing">
      <shows>
        <show object="debris1a" />
        <show object="debris1b" />
        <show object="debris1c" />
        <show object="debris2a" />
        <show object="debris2b" />
        <show object="debris2c" />
        <show object="debris3a" />
        <show object="debris3b" />
        <show object="debris3c" />
        <show object="debris4a" />
        <show object="debris4b" />
        <show object="debris4c" />
        <show object="debris5a" />
        <show object="debris5b" />
        <show object="debris5c" />
        <show object="debris6a" />
        <show object="debris6b" />
        <show object="debris6c" />
        <show object="debris7a" />
        <show object="debris7b" />
        <show object="debris7c" />
        <show object="debris8a" />
        <show object="debris8b" />
        <show object="debris8c" />
        <show object="debris9a" />
        <show object="debris9b" />
        <show object="debris9c" />
        <show object="rocket1" />
        <show object="rocket2" />
        <show object="score1" />
        <show object="score2" />
      </shows>
      <inputs>
        <input button="w" action="action('rocket1', 'up')" />
        <input button="s" action="action('rocket1', 'down')" />
        <input button="up" action="action('rocket2', 'up')" />
        <input button="down" action="action('rocket2', 'down')" />
        <input button="space" action="state('paused')" />
        <input button="p" action="state('paused')" />
      </inputs>
      <conditions>
        <condition object="rocket1" variable="score" value="2" action="state('player1wins')" />
        <condition object="rocket2" variable="score" value="2" action="state('player2wins')" />
      </conditions>
    </state>
    <state name="paused">
      <shows>
        <show object="paused" />
      </shows>
      <inputs>
        <input button="space" action="state()" />
        <input button="p" action="state()" />
      </inputs>
    </state>
    <state name="player1wins">
      <shows>
        <show object="player1wins" />
        <show object="continue" />
      </shows>
      <inputs>
        <input button="space" action="reset()" />
      </inputs>
    </state>
    <state name="player2wins">
      <shows>
        <show object="player2wins" />
        <show object="continue" />
      </shows>
      <inputs>
        <input button="space" action="reset()" />
      </inputs>
    </state>
  </states>
</game>
