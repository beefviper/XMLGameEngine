      <position x="3 * cell" y="1 * cell" />
      <velocity x="0" y="0" />
      <collisions enabled="true" />
    </object>
    <object name="hedge3" class="hazard">
      <sprite src="shape.rectangle(cell,cell,'color.forestgreen')" />
      <position x="5 * cell" y="1 * cell" />
      <velocity x="0" y="0" />
      <collisions enabled="true" />
    </object>
    <object name="hedge4" class="hazard">
      <sprite src="shape.rectangle(cell,cell,'color.forestgreen')" />
      <position x="7 * cell" y="1 * cell" />
      <velocity x="0" y="0" />
      <collisions enabled="true" />
    </object>
    <object name="hedge5" class="hazard">
      <sprite src="shape.rectangle(cell,cell,'color.forestgreen')" />
      <position x="9 * cell" y="1 * cell" />
      <velocity x="0" y="0" />
      <collisions enabled="true" />
    </object>
    <object name="hedge6" class="hazard">
      <sprite src="shape.rectangle(2 * cell,cell,'color.forestgreen')" />
      <position x="11 * cell" y="1 * cell" />
      <velocity x="0" y="0" />
