      <position x="486" y="4 * cell + inset" />
      <velocity x="2" y="0" />
      <collisions enabled="true">
        <collision edge="horizontal" action="wrap()" />
      </collisions>
    </object>
    <object name="logrow5a" class="logs">
      <sprite src="shape.rectangle(3 * cell - 2 * inset,body,'color.brown')" />
      <position x="150" y="5 * cell + inset" />
      <velocity x="-1.5" y="0" />
      <collisions enabled="true">
        <collision edge="horizontal" action="wrap()" />
      </collisions>
    </object>
    <object name="logrow5b" class="logs">
      <sprite src="shape.rectangle(3 * cell - 2 * inset,body,'color.brown')" />
      <position x="402" y="5 * cell + inset" />
      <velocity x="-1.5" y="0" />
      <collisions enabled="true">
        <collision edge="horizontal" action="wrap()" />
      </collisions>
    </object>
    <object name="logrow5c" class="logs">
      <sprite src="shape.rectangle(3 * cell - 2 * inset,body,'color.brown')" />
      <position x="-102" y="5 * cell + inset" />
      <velocity x="-1.5" y="0" />
      <collisions enabled="true">
        <collision edge="horizontal" action="wrap()" />
      </collisions>
    </object>
    <object name="logrow6a" class="logs">
      <sprite src="shape.rectangle(4 * cell - 2 * inset,body,'color.brown')" />
      <position x="40" y="6 * cell + inset" />
      <velocity x="1" y="0" />
      <collisions enabled="true">
        <collision edge="horizontal" action="wrap()" />
      </collisions>
    </object>
    <object name="logrow6b" class="logs">
      <sprite src="shape.rectangle(4 * cell - 2 * inset,body,'color.brown')" />
      <position x="308" y="6 * cell + inset" />
      <velocity x="1" y="0" />
      <collisions enabled="true">
        <collision edge="horizontal" action="wrap()" />
      </collisions>
    </object>
    <object name="logrow6c" class="logs">
      <sprite src="shape.rectangle(4 * cell - 2 * inset,body,'color.brown')" />
      <position x="576" y="6 * cell + inset" />
      <velocity x="1" y="0" />
      <collisions enabled="true">
        <collision edge="horizontal" action="wrap()" />
      </collisions>
    </object>

    <!-- the road: trucks are two cells long, cars one -->
    <object name="truckrow8a" class="hazard">
      <sprite src="shape.rectangle(2 * cell - 2 * inset,body,'color.white')" />
      <position x="100" y="8 * cell + inset" />
      <velocity x="-1" y="0" />
      <collisions enabled="true">
        <collision edge="horizontal" action="wrap()" />
      </collisions>
    </object>
    <object name="truckrow8b" class="hazard">
      <sprite src="shape.rectangle(2 * cell - 2 * inset,body,'color.white')" />
      <position x="454" y="8 * cell + inset" />
      <velocity x="-1" y="0" />
      <collisions enabled="true">
        <collision edge="horizontal" action="wrap()" />
      </collisions>
    </object>
    <object name="carrow9a" class="hazard">
      <sprite src="shape.rectangle(body,body,'color.red')" />
      <position x="60" y="9 * cell + inset" />
      <velocity x="3" y="0" />
      <collisions enabled="true">
        <collision edge="horizontal" action="wrap()" />
      </collisions>
    </object>
    <object name="carrow9b" class="hazard">
      <sprite src="shape.rectangle(body,body,'color.red')" />
      <position x="390" y="9 * cell + inset" />
      <velocity x="3" y="0" />
      <collisions enabled="true">
        <collision edge="horizontal" action="wrap()" />
      </collisions>
    </object>
    <object name="carrow10a" class="hazard">
      <sprite src="shape.rectangle(body,body,'color.yellow')" />
      <position x="40" y="10 * cell + inset" />
      <velocity x="-1.5" y="0" />
      <collisions enabled="true">
        <collision edge="horizontal" action="wrap()" />
      </collisions>
    </object>
    <object name="carrow10b" class="hazard">
      <sprite src="shape.rectangle(body,body,'color.yellow')" />
      <position x="240" y="10 * cell + inset" />
      <velocity x="-1.5" y="0" />
      <collisions enabled="true">
        <collision edge="horizontal" action="wrap()" />
      </collisions>
    </object>
    <object name="carrow10c" class="hazard">
      <sprite src="shape.rectangle(body,body,'color.yellow')" />
      <position x="460" y="10 * cell + inset" />
      <velocity x="-1.5" y="0" />
      <collisions enabled="true">
        <collision edge="horizontal" action="wrap()" />
      </collisions>
    </object>
    <object name="carrow11a" class="hazard">
      <sprite src="shape.rectangle(body,body,'color.cyan')" />
      <position x="100" y="11 * cell + inset" />
      <velocity x="2" y="0" />
      <collisions enabled="true">
        <collision edge="horizontal" action="wrap()" />
      </collisions>
    </object>
    <object name="carrow11b" class="hazard">
      <sprite src="shape.rectangle(body,body,'color.cyan')" />
      <position x="310" y="11 * cell + inset" />
      <velocity x="2" y="0" />
      <collisions enabled="true">
        <collision edge="horizontal" action="wrap()" />
      </collisions>
    </object>
    <object name="carrow11c" class="hazard">
      <sprite src="shape.rectangle(body,body,'color.cyan')" />
      <position x="520" y="11 * cell + inset" />
      <velocity x="2" y="0" />
      <collisions enabled="true">
        <collision edge="horizontal" action="wrap()" />
      </collisions>
    </object>
    <object name="carrow12a" class="hazard">
      <sprite src="shape.rectangle(body,body,'color.orange')" />
      <position x="30" y="12 * cell + inset" />
      <velocity x="-1" y="0" />
      <collisions enabled="true">
        <collision edge="horizontal" action="wrap()" />
      </collisions>
    </object>
    <object name="carrow12b" class="hazard">
      <sprite src="shape.rectangle(body,body,'color.orange')" />
      <position x="250" y="12 * cell + inset" />
      <velocity x="-1" y="0" />
      <collisions enabled="true">
        <collision edge="horizontal" action="wrap()" />
      </collisions>
    </object>
    <object name="carrow12c" class="hazard">
      <sprite src="shape.rectangle(body,body,'color.orange')" />
      <position x="470" y="12 * cell + inset" />
      <velocity x="-1" y="0" />
      <collisions enabled="true">
        <collision edge="horizontal" action="wrap()" />
      </collisions>
    </object>

    <!-- the frog. Lives count down from 3; score is how many are home. -->
    <object name="frog" class="frog">
      <sprite src="shape.rectangle(body,body,'color.green')" />
      <position x="6 * cell + inset" y="13 * cell + inset" />
      <velocity x="0" y="0" />
      <collisions enabled="true">
        <collision class="hazard" action="dec('frog.lives');reset()" />
        <collision class="water" unless="logs" action="dec('frog.lives');reset()" />
        <collision class="logs" action="carry()" />
        <collision class="pads" action="inc('frog.score');reset()" />
        <collision edge="horizontal" action="dec('frog.lives');reset()" />
      </collisions>
      <actions>
        <action name="up" value="hop.up(step)" />
        <action name="down" value="hop.down(step)" />
        <action name="left" value="hop.left(step)" />
        <action name="right" value="hop.right(step)" />
      </actions>
      <variables>
        <variable name="lives" value="3" />
        <variable name="score" value="0" />
      </variables>
    </object>

    <!-- the score and lives along the top -->
    <object name="scorelabel">
      <sprite src="text('SCORE',30,'color.white')" />
      <position x="12" y="cell / 2 - scorelabel.height / 2" />
      <velocity x="0" y="0" />
      <collisions enabled="false" />
    </object>
    <object name="scorevalue">
      <sprite src="text(frog.score,30,'color.green')" />
      <position x="12 + scorelabel.width + 12" y="cell / 2 - scorevalue.height / 2" />
      <velocity x="0" y="0" />
      <collisions enabled="false" />
    </object>
    <object name="liveslabel">
      <sprite src="text('LIVES',30,'color.white')" />
      <position x="window.right - 12 - livesvalue.width - 12 - liveslabel.width" y="cell / 2 - liveslabel.height / 2" />
      <velocity x="0" y="0" />
      <collisions enabled="false" />
    </object>
    <object name="livesvalue">
      <sprite src="text(frog.lives,30,'color.green')" />
      <position x="window.right - 12 - livesvalue.width" y="cell / 2 - livesvalue.height / 2" />
      <velocity x="0" y="0" />
      <collisions enabled="false" />
    </object>

    <!-- the screens -->
    <object name="title">
      <sprite src="text('FROGGER',96,'color.green')" />
      <position x="window.width.center - title.width / 2" y="window.height.center - title.height / 2 + (-60)" />
      <velocity x="0" y="0" />
      <collisions enabled="false" />
    </object>
    <object name="start">
      <sprite src="text('spacebar to start',32,'color.white')" />
      <position x="window.width.center - start.width / 2" y="window.height.center - start.height / 2 + (40)" />
      <velocity x="0" y="0" />
      <collisions enabled="false" />
    </object>
    <object name="gameovertext">
      <sprite src="text('GAME OVER',80,'color.red')" />
      <position x="window.width.center - gameovertext.width / 2" y="window.height.center - gameovertext.height / 2 + (-60)" />
      <velocity x="0" y="0" />
      <collisions enabled="false" />
    </object>
    <object name="youwin">
      <sprite src="text('YOU WIN',96,'color.green')" />
      <position x="window.width.center - youwin.width / 2" y="window.height.center - youwin.height / 2 + (-60)" />
      <velocity x="0" y="0" />
      <collisions enabled="false" />
    </object>
    <object name="continue">
      <sprite src="text('spacebar to continue',32,'color.white')" />
      <position x="window.width.center - continue.width / 2" y="window.height.center - continue.height / 2 + (40)" />
      <velocity x="0" y="0" />
      <collisions enabled="false" />
    </object>
    <object name="paused">
      <sprite src="text('paused',96,'color.white')" />
      <position x="window.width.center - paused.width / 2" y="window.height.center - paused.height / 2 + (0)" />
      <velocity x="0" y="0" />
      <collisions enabled="false" />
    </object>
  </objects>
  <states>
    <state name="mainmenu">
      <shows>
        <show object="title" />
        <show object="start" />
      </shows>
      <inputs>
        <input button="space" action="state('playing')" />
      </inputs>
    </state>
    <state name="playing">
      <shows>
        <show object="bayswater" />
        <show object="water" />
        <show object="grass" />
        <show object="road" />
        <show object="lines" />
        <show object="pavement" />
        <show object="home1" />
        <show object="home2" />
        <show object="home3" />
        <show object="home4" />
        <show object="home5" />
        <show object="pad1" />
        <show object="pad2" />
        <show object="pad3" />
        <show object="pad4" />
        <show object="pad5" />
        <show object="hedge1" />
        <show object="hedge2" />
        <show object="hedge3" />
        <show object="hedge4" />
        <show object="hedge5" />
        <show object="hedge6" />
        <show object="logrow2a" />
        <show object="logrow2b" />
        <show object="logrow3a" />
        <show object="logrow3b" />
        <show object="logrow3c" />
        <show object="logrow4a" />
        <show object="logrow4b" />
        <show object="logrow5a" />
        <show object="logrow5b" />
        <show object="logrow5c" />
        <show object="logrow6a" />
        <show object="logrow6b" />
        <show object="logrow6c" />
        <show object="truckrow8a" />
        <show object="truckrow8b" />
        <show object="carrow9a" />
        <show object="carrow9b" />
        <show object="carrow10a" />
        <show object="carrow10b" />
        <show object="carrow10c" />
        <show object="carrow11a" />
        <show object="carrow11b" />
        <show object="carrow11c" />
        <show object="carrow12a" />
        <show object="carrow12b" />
        <show object="carrow12c" />
        <show object="frog" />
        <show object="scorelabel" />
        <show object="scorevalue" />
        <show object="liveslabel" />
        <show object="livesvalue" />
      </shows>
      <inputs>
        <input button="up" action="action('frog', 'up')" />
        <input button="down" action="action('frog', 'down')" />
        <input button="left" action="action('frog', 'left')" />
        <input button="right" action="action('frog', 'right')" />
        <input button="w" action="action('frog', 'up')" />
        <input button="s" action="action('frog', 'down')" />
        <input button="a" action="action('frog', 'left')" />
        <input button="d" action="action('frog', 'right')" />
        <input button="p" action="state('paused')" />
        <input button="escape" action="state('paused')" />
      </inputs>
      <conditions>
        <condition object="frog" variable="lives" atmost="0" action="state('gameover')" />
        <condition class="pads" remaining="0" action="state('youwin')" />
      </conditions>
    </state>
    <state name="paused">
      <shows>
        <show object="paused" />
      </shows>
      <inputs>
        <input button="p" action="state()" />
        <input button="escape" action="state()" />
      </inputs>
    </state>
    <state name="gameover">
      <shows>
        <show object="gameovertext" />
        <show object="continue" />
