      <collisions enabled="false" />
    </object>
    <object name="home5">
      <sprite src="shape.rectangle(body,body,'color.green')" />
      <position x="10 * cell + inset" y="1 * cell + inset" />
      <velocity x="0" y="0" />
      <collisions enabled="false" />
    </object>
    <object name="pad1" class="pads">
      <sprite src="shape.rectangle(body,body,'color.darkgreen')" />
      <position x="2 * cell + inset" y="1 * cell + inset" />
      <velocity x="0" y="0" />
      <collisions enabled="true">
        <collision class="frog" action="die()" />
      </collisions>
    </object>
    <object name="pad2" class="pads">
      <sprite src="shape.rectangle(body,body,'color.darkgreen')" />
      <position x="4 * cell + inset" y="1 * cell + inset" />
      <velocity x="0" y="0" />
      <collisions enabled="true">
        <collision class="frog" action="die()" />
      </collisions>
    </object>
    <object name="pad3" class="pads">
      <sprite src="shape.rectangle(body,body,'color.darkgreen')" />
      <position x="6 * cell + inset" y="1 * cell + inset" />
      <velocity x="0" y="0" />
      <collisions enabled="true">
        <collision class="frog" action="die()" />
