<!-- frogger.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Sept 30, 2026 -->

<!--
  Frogger, on a grid of 48 pixel cells, 13 across and 14 down:

    row  0        the score and lives
    row  1        home: five pads between hedges
    rows 2-6      the river: five lanes of logs
    row  7        grass
    rows 8-12     the road: five lanes of trucks and cars
    row  13       the pavement where the frog starts

  Everything on the board is a square (or a few squares laid end to end) drawn
  6 pixels in from its cell, so the frog fits a lane with room to spare. Every
  car, truck and log is its own object: a lane loops with wrap(), so the lanes
  are spaced by hand, the same way their positions here are (a lane of objects
  that are `size` wide repeats every `window.width + size` pixels).

  The frog hops one cell for each press of an arrow key (or W, A, S, D) - hold
  a key and it hops once. It is lost, and put back at the start, when it
  - is hit by a car or truck, or runs into a hedge,
  - is in the river and not on a log (a collision with unless="logs"),
  - is carried off the side of the screen by a log.
  Reaching a pad scores and sends the frog back; a bright green frog waits
  under every pad and shows once the pad is gone. All five pads is a win, no
  lives left is game over.
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../assets/xmlgameengine.xsd">
  <window name="Frogger" width="624" height="672" background="color.black" fullscreen="false" framerate="60" />
  <variables>
    <variable name="cell" value="48" />
    <variable name="inset" value="6" />
    <variable name="body" value="36" />
    <variable name="step" value="48" />
  </variables>
  <objects>
    <!-- scenery: the river (home row and the five lanes), grass, road, road markings, pavement -->
    <object name="bayswater">
      <sprite src="shape.rectangle(window.right,cell,'color.darkblue')" />
      <position x="0" y="1 * cell" />
      <velocity x="0" y="0" />
      <collisions enabled="false" />
    </object>
    <object name="water" class="water">
      <sprite src="shape.rectangle(window.right,5 * cell,'color.darkblue')" />
      <position x="0" y="2 * cell" />
      <velocity x="0" y="0" />
      <collisions enabled="true" />
    </object>
    <object name="grass">
      <sprite src="shape.rectangle(window.right,cell,'color.forestgreen')" />
      <position x="0" y="7 * cell" />
      <velocity x="0" y="0" />
      <collisions enabled="false" />
    </object>
    <object name="road">
      <sprite src="shape.rectangle(window.right,5 * cell,'color.darkgrey')" />
      <position x="0" y="8 * cell" />
      <velocity x="0" y="0" />
      <collisions enabled="false" />
    </object>
    <object name="lines">
      <sprite src="grid(13,4,24,44,shape.rectangle(24,4,'color.yellow'))" />
      <position x="12" y="9 * cell - 2" />
      <velocity x="0" y="0" />
      <collisions enabled="false" />
    </object>
    <object name="pavement">
      <sprite src="shape.rectangle(window.right,cell,'color.lightgrey')" />
      <position x="0" y="13 * cell" />
      <velocity x="0" y="0" />
      <collisions enabled="false" />
    </object>

    <!-- home: a frog under each pad, then the pads, then the hedges between them -->
    <object name="home1">
      <sprite src="shape.rectangle(body,body,'color.green')" />
      <position x="2 * cell + inset" y="1 * cell + inset" />
      <velocity x="0" y="0" />
      <collisions enabled="false" />
    </object>
    <object name="home2">
      <sprite src="shape.rectangle(body,body,'color.green')" />
      <position x="4 * cell + inset" y="1 * cell + inset" />
      <velocity x="0" y="0" />
      <collisions enabled="false" />
    </object>
    <object name="home3">
      <sprite src="shape.rectangle(body,body,'color.green')" />
      <position x="6 * cell + inset" y="1 * cell + inset" />
      <velocity x="0" y="0" />
      <collisions enabled="false" />
    </object>
    <object name="home4">
      <sprite src="shape.rectangle(body,body,'color.green')" />
