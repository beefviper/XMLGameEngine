        <show object="carrow12a" />
        <show object="carrow12b" />
        <show object="carrow12c" />
        <show object="frog" />
        <show object="scorelabel" />
        <show object="scorevalue" />
        <show object="liveslabel" />
        <show object="livesvalue" />
      </shows>
      <inputs>
        <input button="up">
          <trigger object="frog" action="up" />
        </input>
        <input button="down">
          <trigger object="frog" action="down" />
        </input>
        <input button="left">
          <trigger object="frog" action="left" />
        </input>
        <input button="right">
          <trigger object="frog" action="right" />
        </input>
        <input button="w">
          <trigger object="frog" action="up" />
        </input>
        <input button="s">
          <trigger object="frog" action="down" />
        </input>
        <input button="a">
          <trigger object="frog" action="left" />
        </input>
        <input button="d">
          <trigger object="frog" action="right" />
        </input>
        <input button="p">
          <push state="paused" />
        </input>
        <input button="escape">
          <push state="paused" />
        </input>
      </inputs>
      <conditions>
        <condition object="frog" variable="lives">
          <atmost>0</atmost>
          <push state="gameover" />
        </condition>
        <condition class="pads">
          <remaining>0</remaining>
          <push state="youwin" />
        </condition>
      </conditions>
    </state>
    <state name="paused">
      <shows>
        <show object="paused" />
      </shows>
      <inputs>
        <input button="p">
          <pop />
        </input>
        <input button="escape">
          <pop />
        </input>
      </inputs>
    </state>
    <state name="gameover">
      <shows>
        <show object="gameovertext" />
        <show object="continue" />
      </shows>
      <inputs>
        <input button="space">
          <reset />
        </input>
      </inputs>
    </state>
    <state name="youwin">
      <shows>
        <show object="youwin" />
        <show object="continue" />
      </shows>
      <inputs>
        <input button="space">
          <reset />
        </input>
      </inputs>
    </state>
  </states>
</game>
