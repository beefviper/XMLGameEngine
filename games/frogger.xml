    </object>
    <object name="pad4" class="pads">
      <sprite src="shape.rectangle(body,body,'color.darkgreen')" />
      <position x="8 * cell + inset" y="1 * cell + inset" />
      <velocity x="0" y="0" />
      <collisions enabled="true">
        <collision class="frog" action="die()" />
      </collisions>
    </object>
    <object name="pad5" class="pads">
      <sprite src="shape.rectangle(body,body,'color.darkgreen')" />
      <position x="10 * cell + inset" y="1 * cell + inset" />
      <velocity x="0" y="0" />
      <collisions enabled="true">
        <collision class="frog" action="die()" />
      </collisions>
    </object>
    <object name="hedge1" class="hazard">
