<!-- megamania.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Oct 7, 2026 -->

<!--
  Megamania, after Activision's 1982 Atari 2600 game. Your ship slides along
  the bottom of the screen and fires up at waves of strange things that sweep
  across the sky and drop bombs: hamburgers that cross straight over, cookies
  that come down at a slant and bounce back up, and bugs that rush the other
  way. All the while your energy runs down; shoot the whole wave before it is
  gone. A bomb, anything you fly into, or running out of energy costs a ship;
  three ships. Clear the three waves to win.

  A and D (or the arrows) slide, Space fires, P or Escape pauses.

  How it is written:
  * A wave is a <group> moving with one velocity and <wrap />ping round the
    sides, so the formation goes off one side and comes back on the other;
    the cookies also <bounce /> off the top and bottom.
  * Each member drops bombs from under it (<facing>down</facing>, <fire>)
    on a timer of its own, every few seconds, the wait drawn again each time.
  * The energy is a variable of its own object, which a timer of the wave
    takes down a second at a time and a <reset object="energy" /> fills
    again: at the start of each wave and when a ship is lost.
  * Each wave is a <state>; a condition that none of it is left moves on.
  Not in it: steering a shot after it is fired, the other five waves (tires,
  bow ties, diamonds, irons, dice), and the bonus for energy left.
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../xgedef.xsd">
  <window name="Megamania">
    <width>640</width>
    <height>480</height>
    <background>color.black</background>
    <fullscreen>false</fullscreen>
    <framerate>60</framerate>
  </window>
  <variables>
    <variable name="margin">10</variable>
    <variable name="slide">4</variable>
    <variable name="laserspeed">9</variable>
    <variable name="bombspeed">4</variable>
    <!-- a member of a wave drops a bomb every drop - 1 to drop + 2 seconds -->
    <variable name="drop">3</variable>
    <variable name="speed1">2</variable>
    <variable name="speed2">2</variable>
    <variable name="speed3">3</variable>
  </variables>
  <sounds>
    <sound name="fire" wave="square">
      <volume>0.15</volume>
      <note pitch="E6" to="E5">0.07</note>
    </sound>
    <sound name="hit" wave="noise">
      <volume>0.3</volume>
      <note pitch="3000" to="300">0.25</note>
    </sound>
    <sound name="lost" wave="triangle">
      <volume>0.4</volume>
      <note pitch="E4" to="E2">0.6</note>
    </sound>
    <sound name="wave" wave="square">
      <volume>0.2</volume>
      <note pitch="C5">0.08</note>
      <note pitch="E5">0.08</note>
      <note pitch="G5">0.08</note>
      <note pitch="C6">0.2</note>
    </sound>
  </sounds>
  <objects>
    <!-- the ship -->
    <object name="player" class="player">
      <sprite>
        <bitmap>
          <row>.....**.....</row>
          <row>.....**.....</row>
          <row>....****....</row>
          <row>.**.****.**.</row>
          <row>************</row>
          <row>************</row>
          <row>**...**...**</row>
          <scale>3</scale>
          <color>color.white</color>
        </bitmap>
      </sprite>
      <position><x>window.width.center - player.width / 2</x><y>window.bottom - player.height - 30</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>true</enabled>
        <collision edge="horizontal">
          <stick />
        </collision>
        <collision class="bomb">
          <dec variable="player.lives" />
          <play sound="lost" />
          <reset object="bombs" />
          <reset object="energy" />
          <reset />
        </collision>
        <collision class="burgers">
          <dec variable="player.lives" />
          <play sound="lost" />
          <reset object="bombs" />
          <reset object="energy" />
          <reset />
        </collision>
        <collision class="cookies">
          <dec variable="player.lives" />
          <play sound="lost" />
          <reset object="bombs" />
          <reset object="energy" />
          <reset />
        </collision>
        <collision class="bugs">
          <dec variable="player.lives" />
          <play sound="lost" />
          <reset object="bombs" />
          <reset object="energy" />
          <reset />
        </collision>
      </collisions>
      <actions>
        <action name="left">
          <move direction="left">slide</move>
        </action>
        <action name="right">
          <move direction="right">slide</move>
        </action>
        <action name="fire">
          <fire object="laser" />
          <play sound="fire" />
        </action>
      </actions>
      <variables>
        <variable name="score">0</variable>
        <variable name="lives">3</variable>
      </variables>
    </object>

    <!-- one shot at a time -->
    <object name="laser" class="laser">
      <sprite>
        <rectangle>
          <width>3</width>
          <height>14</height>
          <color>color.cyan</color>
        </rectangle>
      </sprite>
      <position><x>0</x><y>0</y></position>
      <velocity><x>0</x><y>-laserspeed</y></velocity>
      <hidden>true</hidden>
      <collisions>
        <enabled>false</enabled>
        <collision edge="all">
          <die />
        </collision>
        <collision class="burgers">
          <die />
        </collision>
        <collision class="cookies">
          <die />
        </collision>
        <collision class="bugs">
          <die />
        </collision>
      </collisions>
    </object>

    <!-- the bombs: a pool of six -->
    <group name="bombs" class="bomb">
      <sprite>
        <rectangle>
          <width>4</width>
          <height>10</height>
          <color>color.red</color>
        </rectangle>
      </sprite>
      <position><x>0</x><y>0</y></position>
      <velocity><x>0</x><y>bombspeed</y></velocity>
      <hidden>true</hidden>
      <collisions>
        <enabled>false</enabled>
        <collision edge="all">
          <die />
        </collision>
        <collision object="player">
          <die />
        </collision>
      </collisions>
      <member />
      <member />
      <member />
      <member />
      <member />
      <member />
    </group>

    <!-- the three waves: each a <group> that wraps round the sides and drops
         bombs on a timer of its own -->
    <group name="burgers" class="burgers">
      <sprite>
        <bitmap>
          <row>..******..</row>
          <row>.********.</row>
          <row>**********</row>
          <row>..........</row>
          <row>**********</row>
          <row>.********.</row>
          <scale>3</scale>
          <color>color.orange</color>
        </bitmap>
      </sprite>
      <velocity><x>speed1</x><y>0</y></velocity>
      <facing>down</facing>
      <collisions>
        <enabled>true</enabled>
        <collision edge="horizontal">
          <wrap />
        </collision>
        <collision object="laser">
          <inc variable="player.score">20</inc>
          <play sound="hit" />
          <die />
        </collision>
      </collisions>
      <timers>
        <timer>
          <every><random min="drop - 1" max="drop + 2" /></every>
          <fire object="bombs" />
        </timer>
      </timers>
      <member><position><x>40</x><y>80</y></position></member>
      <member><position><x>200</x><y>80</y></position></member>
      <member><position><x>360</x><y>80</y></position></member>
      <member><position><x>520</x><y>80</y></position></member>
      <member><position><x>120</x><y>150</y></position></member>
      <member><position><x>280</x><y>150</y></position></member>
      <member><position><x>440</x><y>150</y></position></member>
      <member><position><x>600</x><y>150</y></position></member>
    </group>
    <group name="cookies" class="cookies">
      <sprite>
        <bitmap>
          <row>..****..</row>
          <row>.**.***.</row>
          <row>****.***</row>
          <row>*.******</row>
          <row>***.**.*</row>
          <row>.******.</row>
          <row>..****..</row>
          <scale>3</scale>
          <color>color.yellow</color>
        </bitmap>
      </sprite>
      <velocity><x>speed2</x><y>speed2 / 2</y></velocity>
      <facing>down</facing>
      <collisions>
        <enabled>true</enabled>
        <collision edge="horizontal">
          <wrap />
        </collision>
        <collision edge="vertical">
          <bounce />
        </collision>
        <collision object="laser">
          <inc variable="player.score">30</inc>
          <play sound="hit" />
          <die />
        </collision>
      </collisions>
      <timers>
        <timer>
          <every><random min="drop - 1" max="drop + 2" /></every>
          <fire object="bombs" />
        </timer>
      </timers>
      <member><position><x>40</x><y>60</y></position></member>
      <member><position><x>200</x><y>60</y></position></member>
      <member><position><x>360</x><y>60</y></position></member>
      <member><position><x>520</x><y>60</y></position></member>
      <member><position><x>120</x><y>140</y></position></member>
      <member><position><x>280</x><y>140</y></position></member>
      <member><position><x>440</x><y>140</y></position></member>
      <member><position><x>600</x><y>140</y></position></member>
    </group>
    <group name="bugs" class="bugs">
      <sprite>
        <bitmap>
          <row>*..*..*..*</row>
          <row>.*.****.*.</row>
          <row>..******..</row>
          <row>.********.</row>
          <row>*.*....*.*</row>
          <scale>3</scale>
          <color>color.green</color>
        </bitmap>
      </sprite>
      <velocity><x>-speed3</x><y>0</y></velocity>
      <facing>down</facing>
      <collisions>
        <enabled>true</enabled>
        <collision edge="horizontal">
          <wrap />
        </collision>
        <collision object="laser">
          <inc variable="player.score">40</inc>
          <play sound="hit" />
          <die />
        </collision>
      </collisions>
      <timers>
        <timer>
          <every><random min="drop - 1" max="drop + 2" /></every>
          <fire object="bombs" />
        </timer>
      </timers>
      <member><position><x>40</x><y>90</y></position></member>
      <member><position><x>200</x><y>90</y></position></member>
      <member><position><x>360</x><y>90</y></position></member>
      <member><position><x>520</x><y>90</y></position></member>
      <member><position><x>120</x><y>170</y></position></member>
      <member><position><x>280</x><y>170</y></position></member>
      <member><position><x>440</x><y>170</y></position></member>
      <member><position><x>600</x><y>170</y></position></member>
    </group>

    <!-- the energy that runs down; never shown, only its number -->
    <object name="energy">
      <sprite>
        <rectangle>
          <width>1</width>
          <height>1</height>
          <color>color.black</color>
        </rectangle>
      </sprite>
      <position><x>0</x><y>0</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
      <variables>
        <variable name="level">45</variable>
      </variables>
    </object>

    <object name="score">
      <sprite>
        <text>
          <number>player.score</number>
          <size>28</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position><x>margin</x><y>margin</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="energybar">
      <sprite>
        <text>
          <number>energy.level</number>
          <size>28</size>
          <color>color.green</color>
        </text>
      </sprite>
      <position><x>window.width.center - energybar.width / 2</x><y>window.bottom - energybar.height - 2</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="lives">
      <sprite>
        <text>
          <number>player.lives</number>
          <size>28</size>
          <color>color.red</color>
        </text>
      </sprite>
      <position><x>window.right - lives.width - margin</x><y>margin</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>

    <object name="title">
      <sprite>
        <text>
          <content>MEGAMANIA</content>
          <size>100</size>
          <color>color.orange</color>
        </text>
      </sprite>
      <position><x>window.width.center - title.width / 2</x><y>window.height.center - title.height / 2 + (-140)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="help">
      <sprite>
        <text>
          <content>shoot every wave before your energy runs out</content>
          <size>24</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position><x>window.width.center - help.width / 2</x><y>window.height.center - help.height / 2 + (-40)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="keys">
      <sprite>
        <text>
          <content>a and d (or the arrows) slide, space fires</content>
          <size>22</size>
          <color>color.lightgrey</color>
        </text>
      </sprite>
      <position><x>window.width.center - keys.width / 2</x><y>window.height.center - keys.height / 2 + (10)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="start">
      <sprite>
        <text>
          <content>spacebar to start</content>
          <size>40</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position><x>window.width.center - start.width / 2</x><y>window.height.center - start.height / 2 + (110)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="paused">
      <sprite>
        <text>
          <content>PAUSED</content>
          <size>100</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position><x>window.width.center - paused.width / 2</x><y>window.height.center - paused.height / 2</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="youwin">
      <sprite>
        <text>
          <content>YOU WIN</content>
          <size>100</size>
          <color>color.green</color>
        </text>
      </sprite>
      <position><x>window.width.center - youwin.width / 2</x><y>window.height.center - youwin.height / 2 + (-60)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="gameover">
      <sprite>
        <text>
          <content>GAME OVER</content>
          <size>100</size>
          <color>color.red</color>
        </text>
      </sprite>
      <position><x>window.width.center - gameover.width / 2</x><y>window.height.center - gameover.height / 2 + (-60)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="again">
      <sprite>
        <text>
          <content>spacebar to play again</content>
          <size>40</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position><x>window.width.center - again.width / 2</x><y>window.height.center - again.height / 2 + (70)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
  </objects>
  <states>
    <keys name="ship">
      <input button="a left"><trigger object="player" action="left" /></input>
      <input button="d right"><trigger object="player" action="right" /></input>
      <input button="space"><trigger object="player" action="fire" /></input>
      <input button="p escape"><push state="paused" /></input>
    </keys>

    <state name="title">
      <shows>
        <show object="title" />
        <show object="help" />
        <show object="keys" />
        <show object="start" />
      </shows>
      <inputs>
        <input button="space"><push state="wave1" /></input>
      </inputs>
    </state>
    <state name="wave1">
      <shows>
        <show object="burgers" />
        <show object="bombs" />
        <show object="laser" />
        <show object="player" />
        <show object="score" />
        <show object="energybar" />
        <show object="lives" />
      </shows>
      <inputs keys="ship" />
      <conditions>
        <condition object="player" variable="lives">
          <atmost>0</atmost>
          <push state="gameover" />
        </condition>
        <condition class="burgers">
          <remaining>0</remaining>
          <play sound="wave" />
          <reset object="energy" />
          <reset object="bombs" />
          <reset object="laser" />
          <pop state="wave2" />
        </condition>
        <!-- out of energy: a ship lost, and the energy filled again -->
        <condition object="energy" variable="level">
          <atmost>0</atmost>
          <dec variable="player.lives" />
          <play sound="lost" />
          <reset object="energy" />
          <reset object="bombs" />
        </condition>
      </conditions>
      <timers>
        <timer>
          <every>1</every>
          <dec variable="energy.level" />
        </timer>
      </timers>
    </state>
    <state name="wave2">
      <shows>
        <show object="cookies" />
        <show object="bombs" />
        <show object="laser" />
        <show object="player" />
        <show object="score" />
        <show object="energybar" />
        <show object="lives" />
      </shows>
      <inputs keys="ship" />
      <conditions>
        <condition object="player" variable="lives">
          <atmost>0</atmost>
          <push state="gameover" />
        </condition>
        <condition class="cookies">
          <remaining>0</remaining>
          <play sound="wave" />
          <reset object="energy" />
          <reset object="bombs" />
          <reset object="laser" />
          <pop state="wave3" />
        </condition>
        <!-- out of energy: a ship lost, and the energy filled again -->
        <condition object="energy" variable="level">
          <atmost>0</atmost>
          <dec variable="player.lives" />
          <play sound="lost" />
          <reset object="energy" />
          <reset object="bombs" />
        </condition>
      </conditions>
      <timers>
        <timer>
          <every>1</every>
          <dec variable="energy.level" />
        </timer>
      </timers>
    </state>
    <state name="wave3">
      <shows>
        <show object="bugs" />
        <show object="bombs" />
        <show object="laser" />
        <show object="player" />
        <show object="score" />
        <show object="energybar" />
        <show object="lives" />
      </shows>
      <inputs keys="ship" />
      <conditions>
        <condition object="player" variable="lives">
          <atmost>0</atmost>
          <push state="gameover" />
        </condition>
        <condition class="bugs">
          <remaining>0</remaining>
          <play sound="wave" />
          <push state="youwin" />
        </condition>
        <!-- out of energy: a ship lost, and the energy filled again -->
        <condition object="energy" variable="level">
          <atmost>0</atmost>
          <dec variable="player.lives" />
          <play sound="lost" />
          <reset object="energy" />
          <reset object="bombs" />
        </condition>
      </conditions>
      <timers>
        <timer>
          <every>1</every>
          <dec variable="energy.level" />
        </timer>
      </timers>
    </state>
    <state name="paused">
      <shows>
        <show object="paused" />
      </shows>
      <inputs>
        <input button="space p escape"><pop /></input>
      </inputs>
    </state>
    <state name="youwin">
      <shows>
        <show object="youwin" />
        <show object="score" />
        <show object="again" />
      </shows>
      <inputs>
        <input button="space"><reset /></input>
      </inputs>
    </state>
    <state name="gameover">
      <shows>
        <show object="gameover" />
        <show object="score" />
        <show object="again" />
      </shows>
      <inputs>
        <input button="space"><reset /></input>
      </inputs>
    </state>
  </states>
</game>
