<!-- spaceinvaders.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Sept 18, 2020 -->

<!--
  Space Invaders. The ship and the aliens are not rectangles but pictures
  written as text: a <bitmap> is rows of characters, a period for a clear pixel
  and an asterisk for a solid one, each character drawn `pixel` (5) real pixels
  across, so a few characters make a chunky sprite.

  Each kind of alien has two sprites (a and b) and an <animation> that shows
  them one after the other, each for animation.seconds (1) seconds. The three
  kinds are the members of one group, so they march, bounce and step down
  together as a single block; each member is a <grid> of its own sprite, and
  both of its sprites have to be laid out the same way. The bullet is a thin
  tall rectangle.
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../assets/xmlgameengine.xsd">
  <window name="Space Invaders">
    <width>1024</width>
    <height>768</height>
    <background>color.black</background>
    <fullscreen>false</fullscreen>
    <framerate>60</framerate>
  </window>
  <variables>
    <variable name="margin">80</variable>
    <variable name="pixel">5</variable>
    <variable name="gap">15</variable>
    <variable name="animation.seconds">1</variable>
    <variable name="bulletwidth">4</variable>
    <variable name="bulletheight">24</variable>
    <variable name="step">2</variable>
  </variables>
  <objects>
    <object name="bullet" class="projectile">
      <sprite>
        <rectangle>
          <width>bulletwidth</width>
          <height>bulletheight</height>
        </rectangle>
      </sprite>
      <position><x>0</x><y>0</y></position>
      <velocity><x>0</x><y>-12</y></velocity>
      <collisions>
        <enabled>false</enabled>
        <collision edge="all">
          <die />
        </collision>
        <collision class="aliens">
          <die />
        </collision>
      </collisions>
    </object>
    <object name="player">
      <sprite>
        <bitmap>
          <row>.....*.....</row>
          <row>....***....</row>
          <row>....***....</row>
          <row>.*********.</row>
          <row>***********</row>
          <row>***********</row>
          <row>***********</row>
          <scale>pixel</scale>
          <color>color.green</color>
        </bitmap>
      </sprite>
      <position><x>window.width.center - player.width / 2</x><y>window.bottom - player.height * 2</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>true</enabled>
        <collision edge="horizontal">
          <stick />
        </collision>
      </collisions>
      <actions>
        <action name="left">
          <move direction="left">step</move>
        </action>
        <action name="right">
          <move direction="right">step</move>
        </action>
        <action name="gun">
          <fire object="bullet" />
        </action>
      </actions>
    </object>
    <group name="aliens" class="aliens">
      <position><x>margin</x></position>
      <velocity><x>2</x><y>0</y></velocity>
      <collisions>
        <enabled>true</enabled>
        <lockstep>true</lockstep>
        <collision edge="horizontal">
          <bounce />
          <move direction="down">10</move>
        </collision>
        <collision>
          <die />
        </collision>
      </collisions>
    <member name="squids">
      <sprite name="a">
        <grid>
          <columns>11</columns>
          <rows>1</rows>
          <padding><x>gap</x><y>gap</y></padding>
          <bitmap>
            <row>....***....</row>
            <row>...*****...</row>
            <row>..*******..</row>
            <row>.**.***.**.</row>
            <row>.*********.</row>
            <row>...*.*.*...</row>
            <row>..*..*..*..</row>
            <row>...*.*.*...</row>
            <scale>pixel</scale>
            <color>color.magenta</color>
          </bitmap>
        </grid>
      </sprite>
      <sprite name="b">
        <grid>
          <columns>11</columns>
          <rows>1</rows>
          <padding><x>gap</x><y>gap</y></padding>
          <bitmap>
            <row>....***....</row>
            <row>...*****...</row>
            <row>..*******..</row>
            <row>.**.***.**.</row>
            <row>.*********.</row>
            <row>..*..*..*..</row>
            <row>.*...*...*.</row>
            <row>..*.....*..</row>
            <scale>pixel</scale>
            <color>color.magenta</color>
          </bitmap>
        </grid>
      </sprite>
      <animation>
        <interval>animation.seconds</interval>
        <frame sprite="a" />
        <frame sprite="b" />
      </animation>
      <position><y>margin / 2</y></position>
    </member>
    <member name="crabs">
      <sprite name="a">
        <grid>
          <columns>11</columns>
          <rows>2</rows>
          <padding><x>gap</x><y>gap</y></padding>
          <bitmap>
            <row>..*.....*..</row>
            <row>...*...*...</row>
            <row>..*******..</row>
            <row>.**.***.**.</row>
            <row>***********</row>
            <row>*.*******.*</row>
            <row>*.*.....*.*</row>
            <row>...**.**...</row>
            <scale>pixel</scale>
            <color>color.cyan</color>
          </bitmap>
        </grid>
      </sprite>
      <sprite name="b">
        <grid>
          <columns>11</columns>
          <rows>2</rows>
          <padding><x>gap</x><y>gap</y></padding>
          <bitmap>
            <row>..*.....*..</row>
            <row>*..*...*..*</row>
            <row>*.*******.*</row>
            <row>***.***.***</row>
            <row>***********</row>
            <row>.*********.</row>
            <row>..*.....*..</row>
            <row>.*.......*.</row>
            <scale>pixel</scale>
            <color>color.cyan</color>
          </bitmap>
        </grid>
      </sprite>
      <animation>
        <interval>animation.seconds</interval>
        <frame sprite="a" />
        <frame sprite="b" />
      </animation>
      <position><y>margin / 2 + squids.height + gap</y></position>
    </member>
    <member name="octopuses">
      <sprite name="a">
        <grid>
          <columns>11</columns>
          <rows>2</rows>
          <padding><x>gap</x><y>gap</y></padding>
          <bitmap>
            <row>...*****...</row>
            <row>.*********.</row>
            <row>***********</row>
            <row>***..*..***</row>
            <row>***********</row>
            <row>...**.**...</row>
            <row>..**...**..</row>
            <row>***.....***</row>
            <scale>pixel</scale>
            <color>color.white</color>
          </bitmap>
        </grid>
      </sprite>
      <sprite name="b">
        <grid>
          <columns>11</columns>
          <rows>2</rows>
          <padding><x>gap</x><y>gap</y></padding>
          <bitmap>
            <row>...*****...</row>
            <row>.*********.</row>
            <row>***********</row>
            <row>***..*..***</row>
            <row>***********</row>
            <row>..***.***..</row>
            <row>.**.....**.</row>
            <row>..**...**..</row>
            <scale>pixel</scale>
            <color>color.white</color>
          </bitmap>
        </grid>
      </sprite>
      <animation>
        <interval>animation.seconds</interval>
        <frame sprite="a" />
        <frame sprite="b" />
      </animation>
      <position><y>margin / 2 + squids.height + gap + 2 * (crabs.height + gap)</y></position>
    </member>
    </group>
    <object name="title">
      <sprite>
        <text>
          <content>SPACE INVADERS</content>
          <size>110</size>
          <color>color.green</color>
        </text>
      </sprite>
      <position><x>window.width.center - title.width / 2</x><y>window.height.center - title.height / 2 - 100</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="youwin">
      <sprite>
        <text>
          <content>YOU WIN</content>
          <size>128</size>
          <color>color.green</color>
        </text>
      </sprite>
      <position><x>window.width.center - youwin.width / 2</x><y>window.height.center - 150</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="continue">
      <sprite>
        <text>
          <content>spacebar to continue</content>
          <size>48</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position><x>window.width.center - continue.width / 2</x><y>window.height.center + 60</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="settings">
      <sprite>
        <text>
          <content>settings</content>
          <size>128</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position><x>window.width.center - settings.width / 2</x><y>window.height.center - settings.height / 2</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="paused">
      <sprite>
        <text>
          <content>paused</content>
          <size>128</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position><x>window.width.center - paused.width / 2</x><y>window.height.center - paused.height / 2</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
  </objects>
  <states>
    <state name="mainmenu">
      <shows>
        <show object="title" />
        <show object="player" />
      </shows>
      <inputs>
        <input button="space">
          <push state="playing" />
        </input>
        <input button="s">
          <push state="settings" />
        </input>
      </inputs>
    </state>
    <state name="settings">
      <shows>
        <show object="settings" />
        <show object="player" />
      </shows>
      <inputs>
        <input button="escape">
          <pop />
        </input>
      </inputs>
    </state>
    <state name="playing">
      <shows>
        <show object="bullet" />
        <show object="player" />
        <show object="aliens" />
      </shows>
      <inputs>
        <input button="p">
          <push state="paused" />
        </input>
        <input button="a">
          <trigger object="player" action="left" />
        </input>
        <input button="left">
          <trigger object="player" action="left" />
        </input>
        <input button="d">
          <trigger object="player" action="right" />
        </input>
        <input button="right">
          <trigger object="player" action="right" />
        </input>
        <input button="space">
          <trigger object="player" action="gun" />
        </input>
        <input button="escape">
          <push state="paused" />
        </input>
      </inputs>
      <conditions>
        <condition class="aliens">
          <remaining>0</remaining>
          <push state="gameover" />
        </condition>
      </conditions>
    </state>
    <state name="paused">
      <shows>
        <show object="paused" />
        <show object="player" />
      </shows>
      <inputs>
        <input button="space">
          <pop />
        </input>
        <input button="p">
          <pop />
        </input>
      </inputs>
    </state>
    <state name="gameover">
      <shows>
        <show object="youwin" />
        <show object="continue" />
      </shows>
      <inputs>
        <input button="space">
          <reset />
        </input>
      </inputs>
    </state>
  </states>
</game>
