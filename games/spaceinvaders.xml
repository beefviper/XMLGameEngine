<!-- spaceinvaders.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Sept 18, 2020 -->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../assets/xmlgameengine.xsd">
  <window name="Space Invaders">
    <width>1024</width>
    <height>768</height>
    <background>color.black</background>
    <fullscreen>false</fullscreen>
    <framerate>60</framerate>
  </window>
  <variables>
    <variable name="margin">80</variable>
    <variable name="bullet.radius">4</variable>
    <variable name="width">50</variable>
    <variable name="height">50</variable>
    <variable name="step">2</variable>
  </variables>
  <objects>
    <object name="bullet" class="projectile">
      <sprite>
        <circle>
          <radius>bullet.radius</radius>
        </circle>
      </sprite>
      <position>
        <x>0</x>
        <y>0</y>
      </position>
      <velocity>
        <x>0</x>
        <y>-12</y>
      </velocity>
      <collisions>
        <enabled>false</enabled>
        <collision edge="all">
          <die />
        </collision>
        <collision class="aliens">
          <die />
        </collision>
      </collisions>
    </object>
    <object name="player">
      <sprite>
        <rectangle>
          <width>width</width>
          <height>height</height>
        </rectangle>
      </sprite>
      <position>
        <x>window.width.center</x>
        <y>window.bottom - height * 2</y>
      </position>
      <velocity>
        <x>0</x>
        <y>0</y>
      </velocity>
      <collisions>
        <enabled>true</enabled>
        <collision edge="horizontal">
          <stick />
        </collision>
      </collisions>
      <actions>
        <action name="left">
          <move direction="left">step</move>
        </action>
        <action name="right">
          <move direction="right">step</move>
        </action>
        <action name="gun">
          <fire object="bullet" />
        </action>
      </actions>
    </object>
    <object name="aliens" class="aliens">
      <sprite>
        <grid>
          <columns>11</columns>
          <rows>5</rows>
          <padding>
            <x>15</x>
            <y>15</y>
          </padding>
          <rectangle>
            <width>width</width>
            <height>height</height>
          </rectangle>
        </grid>
      </sprite>
      <position>
        <x>margin</x>
        <y>margin/2</y>
      </position>
      <velocity>
        <x>2</x>
        <y>0</y>
      </velocity>
      <collisions>
        <enabled>true</enabled>
        <lockstep>true</lockstep>
        <collision edge="horizontal">
          <bounce />
          <move direction="down">10</move>
        </collision>
        <collision>
          <die />
        </collision>
      </collisions>
    </object>
    <object name="title">
      <sprite>
        <text>
          <content>SPACE INVADERS</content>
          <size>110</size>
          <color>color.green</color>
        </text>
      </sprite>
      <position>
        <x>window.width.center - title.width / 2</x>
        <y>window.height.center - title.height / 2 - 100</y>
      </position>
      <velocity>
        <x>0</x>
        <y>0</y>
      </velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="youwin">
      <sprite>
        <text>
          <content>YOU WIN</content>
          <size>128</size>
          <color>color.green</color>
        </text>
      </sprite>
      <position>
        <x>window.width.center - youwin.width / 2</x>
        <y>window.height.center - 150</y>
      </position>
      <velocity>
        <x>0</x>
        <y>0</y>
      </velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="continue">
      <sprite>
        <text>
          <content>spacebar to continue</content>
          <size>48</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position>
        <x>window.width.center - continue.width / 2</x>
        <y>window.height.center + 60</y>
      </position>
      <velocity>
        <x>0</x>
        <y>0</y>
      </velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="settings">
      <sprite>
        <text>
          <content>settings</content>
          <size>128</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position>
        <x>window.width.center - settings.width / 2</x>
        <y>window.height.center - settings.height / 2</y>
      </position>
      <velocity>
        <x>0</x>
        <y>0</y>
      </velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="paused">
      <sprite>
        <text>
          <content>paused</content>
          <size>128</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position>
        <x>window.width.center - paused.width / 2</x>
        <y>window.height.center - paused.height / 2</y>
      </position>
      <velocity>
        <x>0</x>
        <y>0</y>
      </velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
  </objects>
  <states>
    <state name="mainmenu">
      <shows>
        <show object="title" />
        <show object="player" />
      </shows>
      <inputs>
        <input button="space">
          <push state="playing" />
        </input>
        <input button="s">
          <push state="settings" />
        </input>
      </inputs>
    </state>
    <state name="settings">
      <shows>
        <show object="settings" />
        <show object="player" />
      </shows>
      <inputs>
        <input button="escape">
          <pop />
        </input>
      </inputs>
    </state>
    <state name="playing">
      <shows>
        <show object="bullet" />
        <show object="player" />
        <show object="aliens" />
      </shows>
      <inputs>
        <input button="p">
          <push state="paused" />
        </input>
        <input button="a">
          <trigger object="player" action="left" />
        </input>
        <input button="left">
          <trigger object="player" action="left" />
        </input>
        <input button="d">
          <trigger object="player" action="right" />
        </input>
        <input button="right">
          <trigger object="player" action="right" />
        </input>
        <input button="space">
          <trigger object="player" action="gun" />
        </input>
        <input button="escape">
          <push state="paused" />
        </input>
      </inputs>
      <conditions>
        <condition class="aliens">
          <remaining>0</remaining>
          <push state="gameover" />
        </condition>
      </conditions>
    </state>
    <state name="paused">
      <shows>
        <show object="paused" />
        <show object="player" />
      </shows>
      <inputs>
        <input button="space">
          <pop />
        </input>
        <input button="p">
          <pop />
        </input>
      </inputs>
    </state>
    <state name="gameover">
      <shows>
        <show object="youwin" />
        <show object="continue" />
      </shows>
      <inputs>
        <input button="space">
          <reset />
        </input>
      </inputs>
    </state>
  </states>
</game>
