    </group>
    <object name="scorelabel">
      <sprite>
        <text>
          <content>SCORE</content>
          <size>30</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position><x>margin</x><y>margin</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="scorevalue">
      <sprite>
        <text>
          <number>ship.score</number>
          <size>30</size>
          <color>color.orange</color>
        </text>
      </sprite>
      <position><x>margin + scorelabel.width + 12</x><y>margin</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="liveslabel">
      <sprite>
        <text>
          <content>SHIPS</content>
          <size>30</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position><x>window.right - livesvalue.width - liveslabel.width - margin - 12</x><y>margin</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="livesvalue">
      <sprite>
        <text>
          <number>ship.lives</number>
          <size>30</size>
          <color>color.orange</color>
        </text>
      </sprite>
      <position><x>window.right - livesvalue.width - margin</x><y>margin</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="title">
      <sprite>
        <text>
          <content>ASTEROIDS</content>
          <size>110</size>
          <color>color.cyan</color>
        </text>
      </sprite>
      <position><x>window.width.center - title.width / 2</x><y>window.height.center - title.height / 2 + (-130)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="help">
      <sprite>
        <text>
          <content>break every rock; the big ones come apart</content>
          <size>32</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position><x>window.width.center - help.width / 2</x><y>window.height.center - help.height / 2 + (-20)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="keys">
      <sprite>
        <text>
          <content>a and d or left and right turn, w or up thrusts, space fires</content>
          <size>26</size>
          <color>color.lightgrey</color>
        </text>
      </sprite>
      <position><x>window.width.center - keys.width / 2</x><y>window.height.center - keys.height / 2 + (30)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="start">
      <sprite>
        <text>
          <content>spacebar to start</content>
          <size>48</size>
          <color>color.green</color>
        </text>
      </sprite>
      <position><x>window.width.center - start.width / 2</x><y>window.height.center - start.height / 2 + (110)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="paused">
      <sprite>
        <text>
          <content>PAUSED</content>
          <size>128</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position><x>window.width.center - paused.width / 2</x><y>window.height.center - paused.height / 2 + (0)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="wonmsg">
      <sprite>
        <text>
          <content>ALL CLEAR</content>
          <size>110</size>
          <color>color.green</color>
        </text>
      </sprite>
      <position><x>window.width.center - wonmsg.width / 2</x><y>window.height.center - wonmsg.height / 2 + (-60)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="overmsg">
      <sprite>
        <text>
          <content>GAME OVER</content>
          <size>128</size>
          <color>color.red</color>
        </text>
      </sprite>
      <position><x>window.width.center - overmsg.width / 2</x><y>window.height.center - overmsg.height / 2 + (-60)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="again">
      <sprite>
        <text>
          <content>spacebar to play again</content>
          <size>48</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position><x>window.width.center - again.width / 2</x><y>window.height.center - again.height / 2 + (70)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
  </objects>
  <states>
    <state name="mainmenu">
      <shows>
        <show object="title" />
        <show object="help" />
        <show object="keys" />
        <show object="start" />
      </shows>
      <inputs>
        <input button="space">
          <push state="playing" />
        </input>
      </inputs>
    </state>
    <state name="playing">
      <shows>
        <show object="ship" />
        <show object="shots" />
        <show object="bigrocks" />
        <show object="mediumrocks" />
        <show object="smallrocks" />
        <show object="scorelabel" />
        <show object="scorevalue" />
        <show object="liveslabel" />
        <show object="livesvalue" />
      </shows>
      <inputs>
        <input button="a">
          <trigger object="ship" action="left" />
        </input>
        <input button="left">
          <trigger object="ship" action="left" />
        </input>
        <input button="d">
          <trigger object="ship" action="right" />
        </input>
        <input button="right">
          <trigger object="ship" action="right" />
        </input>
        <input button="w">
          <trigger object="ship" action="thrust" />
        </input>
        <input button="up">
          <trigger object="ship" action="thrust" />
        </input>
        <input button="space">
          <trigger object="ship" action="fire" />
        </input>
        <input button="p">
          <push state="paused" />
        </input>
        <input button="escape">
          <push state="paused" />
        </input>
      </inputs>
      <conditions>
        <condition object="ship" variable="lives">
          <atmost>0</atmost>
          <push state="gameover" />
        </condition>
        <condition class="rocks">
          <remaining>0</remaining>
          <push state="won" />
        </condition>
      </conditions>
    </state>
    <state name="paused">
      <shows>
        <show object="paused" />
      </shows>
      <inputs>
        <input button="space">
          <pop />
        </input>
        <input button="p">
          <pop />
        </input>
        <input button="escape">
          <pop />
        </input>
      </inputs>
    </state>
    <state name="won">
      <shows>
        <show object="ship" />
        <show object="shots" />
        <show object="bigrocks" />
        <show object="mediumrocks" />
        <show object="smallrocks" />
        <show object="scorelabel" />
        <show object="scorevalue" />
        <show object="liveslabel" />
        <show object="livesvalue" />
        <show object="wonmsg" />
        <show object="again" />
      </shows>
      <inputs>
        <input button="space">
          <reset />
        </input>
      </inputs>
    </state>
    <state name="gameover">
      <shows>
        <show object="bigrocks" />
        <show object="mediumrocks" />
        <show object="smallrocks" />
        <show object="scorelabel" />
        <show object="scorevalue" />
        <show object="liveslabel" />
        <show object="livesvalue" />
        <show object="overmsg" />
        <show object="again" />
      </shows>
      <inputs>
        <input button="space">
          <reset />
        </input>
      </inputs>
    </state>
  </states>
</game>
