<!-- asteroids.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Oct 1, 2026 -->

<!--
  Asteroids, after the 1979 arcade game: a ship that turns and thrusts in the
  way it faces, drifts on, and wraps round the screen, shooting rocks that break
  into smaller ones.

  Everything is drawn from <line>s and tested by pixel, as in Lunar Lander.
  What Asteroids added to the language:

    * <heading> on an object (degrees clockwise from up) and, in its actions,
      <turn> (held, degrees a frame) and <thrust> (held, pushes along the
      heading). The ship's lines are drawn again at its heading, to the
      nearest whole degree, whenever that changes; that picture is shown and
      tested.
    * <drag>, a fraction of the speed lost every frame, so the ship has a top
      speed of thrustpower / drag instead of speeding up for ever.
    * <fire> from an object with a heading leaves its nose, along the heading.
      Naming a group fires the first of its members that is not in flight, so
      four shots can be in the air at once.
    * <hidden> (an object or a group starts out of play) and <release>, which
      puts members of a pool back in play where the object running the rule is.
      The language still cannot make an object while the game runs; the medium
      and small rocks are made ahead of time and handed out.

  Wrapping is Frogger's <wrap />. A shot is put away at the edge of the screen
  (the original lets it wrap and run out), and a ship that is hit comes back
  at the middle with no wait for the middle to be clear.
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../xgedef.xsd">
  <window name="Asteroids">
    <width>800</width>
    <height>600</height>
    <background>color.black</background>
    <fullscreen>false</fullscreen>
    <framerate>60</framerate>
  </window>
  <variables>
    <variable name="turnrate">4</variable>
    <variable name="thrustpower">0.09</variable>
    <variable name="drag">0.02</variable>
    <variable name="shotspeed">8</variable>
    <variable name="margin">20</variable>
  </variables>
  <objects>
    <!-- The ship: a triangle of four lines, drawn again at its heading (to the whole degree) when that changes. It has a <heading>, so the left and right keys <turn> it, thrust pushes it along the way it faces, and a shot leaves its nose. Pixel collisions look at the picture for the heading it has now. -->
    <object name="ship" class="ship">
      <sprite>
        <line><from><x>12</x><y>0</y></from><to><x>23</x><y>28</y></to><thickness>2</thickness></line>
        <line><from><x>23</x><y>28</y></from><to><x>12</x><y>22</y></to><thickness>2</thickness></line>
        <line><from><x>12</x><y>22</y></from><to><x>1</x><y>28</y></to><thickness>2</thickness></line>
        <line><from><x>1</x><y>28</y></from><to><x>12</x><y>0</y></to><thickness>2</thickness></line>
      </sprite>
      <position><x>window.width.center - ship.width / 2</x><y>window.height.center - ship.height / 2</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <heading>0</heading>
      <drag>drag</drag>
      <collisions>
        <enabled>true</enabled>
        <type>pixel</type>
        <collision edge="horizontal">
          <wrap />
        </collision>
        <collision edge="vertical">
          <wrap />
        </collision>
        <collision class="rocks">
          <dec variable="ship.lives" />
          <stop />
          <reset />
        </collision>
      </collisions>
      <actions>
        <action name="left">
          <turn direction="left">turnrate</turn>
        </action>
        <action name="right">
          <turn direction="right">turnrate</turn>
        </action>
        <action name="thrust">
          <thrust>thrustpower</thrust>
        </action>
        <action name="fire">
          <fire object="shots" />
        </action>
      </actions>
      <variables>
        <variable name="score">0</variable>
        <variable name="lives">3</variable>
      </variables>
    </object>
    <!-- Four shots in a pool: hidden until one is fired, put away again when it hits a rock or leaves the screen. -->
    <group name="shots" class="shots">
      <sprite>
        <rectangle>
          <width>3</width>
          <height>3</height>
          <color>color.white</color>
        </rectangle>
      </sprite>
      <position><x>0</x><y>0</y></position>
      <velocity><x>0</x><y>-shotspeed</y></velocity>
      <hidden>true</hidden>
      <collisions>
        <enabled>false</enabled>
        <collision edge="all">
          <die />
        </collision>
        <collision class="rocks">
          <die />
        </collision>
      </collisions>
      <member />
      <member />
      <member />
      <member />
    </group>
    <!-- The rocks. The big ones are in play from the start; the medium and small ones are pools, hidden until a bigger rock breaks and <release>s two of them where it was. 4 big rocks make 8 medium ones make 16 small ones, so the pools are exactly big enough. -->
    <group name="bigrocks" class="rocks">
      <sprite>
        <line><from><x>60</x><y>33</y></from><to><x>44</x><y>40</y></to><thickness>2</thickness></line>
