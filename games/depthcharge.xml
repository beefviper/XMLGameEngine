<!-- depthcharge.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Sept 30, 2026 -->

<!--
  Depth Charge, after the 1977 arcade game: a ship crosses the surface and drops
  charges on the submarines cruising below. Sink every submarine to win. Only
  one charge can be falling at a time, and a charge that reaches the sea floor
  without hitting anything is a wasted one; waste `misses` of them and the
  game is over, so aim, do not spray.

  It is written with verbs the language already had. The ship is Space
  Invaders' player turned upside down: <fire /> launches the charge from the
  ship, moving with the charge's own velocity, and the charge <die />s when it
  hits a submarine or the floor. The floor rule also has a <dec /> on the
  ship's `charges`, which is what makes a miss cost something while a hit does
  not. Each lane of submarines is a <group> with <wrap />, and the game is won
  with a <remaining> condition on the class of all of them.
-->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../xgedef.xsd">
  <window name="Depth Charge">
    <width>800</width>
    <height>600</height>
    <background>color.black</background>
    <fullscreen>false</fullscreen>
    <framerate>60</framerate>
  </window>
  <variables>
    <variable name="shipwidth">90</variable>
    <variable name="shipheight">16</variable>
    <variable name="subwidth">70</variable>
    <variable name="subheight">24</variable>
    <variable name="step">6</variable>
    <variable name="misses">8</variable>
    <variable name="margin">20</variable>
  </variables>
  <sounds>
    <!-- a charge dropped: a low thunk -->
    <sound name="drop" wave="square">
      <volume>0.2</volume>
      <note pitch="G3" to="C3">0.1</note>
    </sound>
    <!-- a submarine sunk: a rumbling burst -->
    <sound name="sink" wave="noise">
      <volume>0.45</volume>
      <note pitch="2500" to="150">0.5</note>
    </sound>
    <!-- a charge lost on the sea floor: a dull splash -->
    <sound name="miss" wave="noise">
      <volume>0.2</volume>
      <note pitch="800" to="200">0.15</note>
    </sound>
    <!-- a game started: a rising arpeggio -->
    <sound name="start" wave="square">
      <volume>0.2</volume>
      <note pitch="C5">0.07</note>
      <note pitch="E5">0.07</note>
      <note pitch="G5">0.07</note>
      <note pitch="C6">0.14</note>
    </sound>
    <!-- every submarine sunk -->
    <sound name="win" wave="square">
      <volume>0.2</volume>
      <note pitch="C5">0.1</note>
      <note pitch="E5">0.1</note>
      <note pitch="G5">0.1</note>
      <note pitch="C6">0.1</note>
      <note pitch="G5">0.1</note>
      <note pitch="C6">0.3</note>
    </sound>
    <!-- out of charges -->
    <sound name="gameover" wave="triangle">
      <volume>0.4</volume>
      <note pitch="G4">0.25</note>
      <note pitch="E4">0.25</note>
      <note pitch="C4" to="C3">0.7</note>
    </sound>
  </sounds>
  <objects>
    <object name="sea">
      <sprite>
        <rectangle>
          <width>window.right</width>
          <height>window.bottom - 100</height>
          <color>color.darkblue</color>
        </rectangle>
      </sprite>
      <position><x>0</x><y>100</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="charge" class="projectile">
      <sprite>
        <rectangle>
          <width>6</width>
          <height>14</height>
          <color>color.orange</color>
        </rectangle>
      </sprite>
      <position><x>0</x><y>0</y></position>
      <velocity><x>0</x><y>5</y></velocity>
      <collisions>
        <enabled>false</enabled>
        <collision edge="bottom">
          <dec variable="ship.charges" />
          <die />
          <play sound="miss" />
        </collision>
        <collision class="subs">
          <inc variable="ship.sunk" />
          <die />
          <play sound="sink" />
        </collision>
      </collisions>
    </object>
    <group name="subs1" class="subs">
      <sprite>
        <rectangle>
          <width>subwidth</width>
          <height>subheight</height>
          <color>color.yellow</color>
        </rectangle>
      </sprite>
      <position><y>190</y></position>
      <velocity><x>2</x><y>0</y></velocity>
      <collisions>
        <enabled>true</enabled>
        <collision edge="horizontal">
          <wrap />
        </collision>
        <collision object="charge">
          <die />
        </collision>
      </collisions>
      <member>
        <position><x>-50</x></position>
      </member>
      <member>
        <position><x>240</x></position>
      </member>
      <member>
        <position><x>530</x></position>
      </member>
    </group>
    <group name="subs2" class="subs">
      <sprite>
        <rectangle>
          <width>subwidth</width>
          <height>subheight</height>
          <color>color.green</color>
        </rectangle>
      </sprite>
      <position><y>300</y></position>
      <velocity><x>-3</x><y>0</y></velocity>
      <collisions>
        <enabled>true</enabled>
        <collision edge="horizontal">
          <wrap />
        </collision>
        <collision object="charge">
          <die />
        </collision>
      </collisions>
      <member>
        <position><x>80</x></position>
      </member>
      <member>
        <position><x>370</x></position>
      </member>
      <member>
        <position><x>660</x></position>
      </member>
    </group>
    <group name="subs3" class="subs">
      <sprite>
        <rectangle>
          <width>subwidth</width>
          <height>subheight</height>
          <color>color.grey</color>
        </rectangle>
      </sprite>
      <position><y>410</y></position>
      <velocity><x>4</x><y>0</y></velocity>
      <collisions>
        <enabled>true</enabled>
        <collision edge="horizontal">
          <wrap />
        </collision>
        <collision object="charge">
          <die />
        </collision>
      </collisions>
      <member>
        <position><x>-10</x></position>
      </member>
      <member>
        <position><x>280</x></position>
      </member>
      <member>
        <position><x>570</x></position>
      </member>
    </group>
    <object name="ship">
      <sprite>
        <rectangle>
          <width>shipwidth</width>
          <height>shipheight</height>
          <color>color.lightgrey</color>
        </rectangle>
      </sprite>
      <position><x>window.width.center - ship.width / 2</x><y>76</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>true</enabled>
        <collision edge="horizontal">
          <stick />
        </collision>
      </collisions>
      <actions>
        <action name="left">
          <move direction="left">step</move>
        </action>
        <action name="right">
          <move direction="right">step</move>
        </action>
        <action name="drop">
          <fire object="charge" />
          <play sound="drop" />
        </action>
      </actions>
      <variables>
        <variable name="charges">misses</variable>
        <variable name="sunk">0</variable>
      </variables>
    </object>
    <object name="sunklabel">
      <sprite>
        <text>
          <content>SUNK</content>
          <size>30</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position><x>margin</x><y>margin</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="sunkvalue">
      <sprite>
        <text>
          <number>ship.sunk</number>
          <size>30</size>
          <color>color.green</color>
        </text>
      </sprite>
      <position><x>margin + sunklabel.width + 12</x><y>margin</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="chargesvalue">
      <sprite>
        <text>
          <number>ship.charges</number>
          <size>30</size>
          <color>color.orange</color>
        </text>
      </sprite>
      <position><x>window.right - chargesvalue.width - margin</x><y>margin</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="chargeslabel">
      <sprite>
        <text>
          <content>MISSES LEFT</content>
          <size>30</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position><x>window.right - chargesvalue.width - chargeslabel.width - margin - 12</x><y>margin</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="title">
      <sprite>
        <text>
          <content>DEPTH CHARGE</content>
          <size>110</size>
          <color>color.cyan</color>
        </text>
      </sprite>
      <position><x>window.width.center - title.width / 2</x><y>window.height.center - title.height / 2 + (-130)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="help">
      <sprite>
        <text>
          <content>sink every submarine before you run out</content>
          <size>32</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position><x>window.width.center - help.width / 2</x><y>window.height.center - help.height / 2 + (-20)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="keys">
      <sprite>
        <text>
          <content>a and d, or the arrow keys, to move; space to drop</content>
          <size>28</size>
          <color>color.lightgrey</color>
        </text>
      </sprite>
      <position><x>window.width.center - keys.width / 2</x><y>window.height.center - keys.height / 2 + (30)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="start">
      <sprite>
        <text>
          <content>spacebar to start</content>
          <size>48</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position><x>window.width.center - start.width / 2</x><y>window.height.center - start.height / 2 + (130)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="paused">
      <sprite>
        <text>
          <content>PAUSED</content>
          <size>128</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position><x>window.width.center - paused.width / 2</x><y>window.height.center - paused.height / 2 + (0)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="youwin">
      <sprite>
        <text>
          <content>FLEET SUNK</content>
          <size>128</size>
          <color>color.green</color>
        </text>
      </sprite>
      <position><x>window.width.center - youwin.width / 2</x><y>window.height.center - youwin.height / 2 + (-60)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="gameover">
      <sprite>
        <text>
          <content>GAME OVER</content>
          <size>128</size>
          <color>color.red</color>
        </text>
      </sprite>
      <position><x>window.width.center - gameover.width / 2</x><y>window.height.center - gameover.height / 2 + (-60)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <object name="again">
      <sprite>
        <text>
          <content>spacebar to play again</content>
          <size>48</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position><x>window.width.center - again.width / 2</x><y>window.height.center - again.height / 2 + (70)</y></position>
      <velocity><x>0</x><y>0</y></velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
  </objects>
  <states>
    <state name="mainmenu">
      <shows>
        <show object="title" />
        <show object="help" />
        <show object="keys" />
        <show object="start" />
      </shows>
      <inputs>
        <input button="space">
          <push state="playing" />
          <play sound="start" />
        </input>
      </inputs>
    </state>
    <state name="playing">
      <shows>
        <show object="sea" />
        <show object="subs1" />
        <show object="subs2" />
        <show object="subs3" />
        <show object="charge" />
        <show object="ship" />
        <show object="sunklabel" />
        <show object="sunkvalue" />
        <show object="chargeslabel" />
        <show object="chargesvalue" />
      </shows>
      <inputs>
        <input button="a">
          <trigger object="ship" action="left" />
        </input>
        <input button="left">
          <trigger object="ship" action="left" />
        </input>
        <input button="d">
          <trigger object="ship" action="right" />
        </input>
        <input button="right">
          <trigger object="ship" action="right" />
        </input>
        <input button="space">
          <trigger object="ship" action="drop" />
        </input>
        <input button="p">
          <push state="paused" />
        </input>
        <input button="escape">
          <push state="paused" />
        </input>
      </inputs>
      <conditions>
        <condition class="subs">
          <remaining>0</remaining>
          <push state="youwin" />
          <play sound="win" />
        </condition>
        <condition object="ship" variable="charges">
          <atmost>0</atmost>
          <push state="gameover" />
          <play sound="gameover" />
        </condition>
      </conditions>
    </state>
    <state name="paused">
      <shows>
        <show object="paused" />
      </shows>
      <inputs>
        <input button="space">
          <pop />
        </input>
        <input button="p">
          <pop />
        </input>
        <input button="escape">
          <pop />
        </input>
      </inputs>
    </state>
    <state name="youwin">
      <shows>
        <show object="youwin" />
        <show object="sunkvalue" />
        <show object="sunklabel" />
        <show object="again" />
      </shows>
      <inputs>
        <input button="space">
          <reset />
        </input>
      </inputs>
    </state>
    <state name="gameover">
      <shows>
        <show object="gameover" />
        <show object="sunkvalue" />
        <show object="sunklabel" />
        <show object="again" />
      </shows>
      <inputs>
        <input button="space">
          <reset />
        </input>
      </inputs>
    </state>
  </states>
</game>
