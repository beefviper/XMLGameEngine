<!-- pong.xml -->
<!-- XML Game Engine -->
<!-- author: beefviper -->
<!-- date: Sept 18, 2020 -->

<game xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../assets/xmlgameengine.xsd">
  <!-- window -->
  <window name="Pong">
    <width>1280</width>
    <height>720</height>
    <background>color.black</background>
    <fullscreen>false</fullscreen>
    <framerate>60</framerate>
  </window>
  <!-- variables -->
  <variables>
    <variable name="margin">30</variable>
    <variable name="text.size">256</variable>
    <variable name="logo.radius">100</variable>
    <variable name="ball.radius">10</variable>
    <variable name="width">30</variable>
    <variable name="height">150</variable>
    <variable name="step">2</variable>
  </variables>
  <!-- objects -->
  <objects>
    <!-- title -->
    <object name="title">
      <sprite>
        <text>
          <content>PONG</content>
          <size>text.size</size>
          <color>color.red</color>
        </text>
      </sprite>
      <position>
        <x>window.width.center - title.width / 2</x>
        <y>margin</y>
      </position>
      <velocity>
        <x>0</x>
        <y>0</y>
      </velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <!-- logo -->
    <object name="logo">
      <sprite>
        <circle>
          <radius>logo.radius</radius>
          <color>color.green</color>
        </circle>
      </sprite>
      <position>
        <x>window.width.center - logo.radius</x>
        <y>window.height.center - logo.radius</y>
      </position>
      <velocity>
        <x>0</x>
        <y>0</y>
      </velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <!-- ball -->
    <object name="ball">
      <sprite>
        <circle>
          <radius>ball.radius</radius>
          <color>color.green</color>
        </circle>
      </sprite>
      <position>
        <x>window.width.center - ball.radius</x>
        <y>window.height.center - ball.radius</y>
      </position>
      <velocity>
        <x><random min="-7" max="7" /></x>
        <y><random min="-3" max="3" /></y>
      </velocity>
      <collisions>
        <enabled>true</enabled>
        <collision edge="vertical">
          <bounce />
        </collision>
        <collision edge="left">
          <inc variable="paddle2.score" />
          <reset />
        </collision>
        <collision edge="right">
          <inc variable="paddle1.score" />
          <reset />
        </collision>
        <collision>
          <bounce />
        </collision>
      </collisions>
    </object>
    <!-- paddle1 -->
    <object name="paddle1" class="paddle">
      <sprite>
        <image>
          <path>assets/paddle.jpg</path>
        </image>
      </sprite>
      <position>
        <x>window.left + margin</x>
        <y>window.height.center - height / 2</y>
      </position>
      <velocity>
        <x>0</x>
        <y>0</y>
      </velocity>
      <collisions>
        <enabled>true</enabled>
        <collision edge="vertical">
          <stick />
        </collision>
      </collisions>
      <actions>
        <action name="up">
          <move direction="up">step</move>
        </action>
        <action name="down">
          <move direction="down">step</move>
        </action>
      </actions>
      <variables>
        <variable name="score">0</variable>
      </variables>
    </object>
    <!-- paddle2 -->
    <object name="paddle2" class="paddle">
      <sprite>
        <image>
          <path>assets/paddle.jpg</path>
          <flip>horizontal</flip>
        </image>
      </sprite>
      <position>
        <x>window.right - margin - width</x>
        <y>window.height.center - height / 2</y>
      </position>
      <velocity>
        <x>0</x>
        <y>0</y>
      </velocity>
      <collisions>
        <enabled>true</enabled>
        <collision edge="vertical">
          <stick />
        </collision>
      </collisions>
      <actions>
        <action name="up">
          <move direction="up">step</move>
        </action>
        <action name="down">
          <move direction="down">step</move>
        </action>
        <action name="left">
          <move direction="left">step</move>
        </action>
        <action name="right">
          <move direction="right">step</move>
        </action>
      </actions>
      <variables>
        <variable name="score">0</variable>
      </variables>
    </object>
    <!-- score1 -->
    <object name="score1">
      <sprite>
        <text>
          <number>paddle1.score</number>
          <size>128</size>
          <color>color.blue</color>
        </text>
      </sprite>
      <position>
        <x>window.width.center - 50 - score1.width</x>
        <y>margin</y>
      </position>
      <velocity>
        <x>0</x>
        <y>0</y>
      </velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <!-- score2 -->
    <object name="score2">
      <sprite>
        <text>
          <number>paddle2.score</number>
          <size>128</size>
          <color>color.red</color>
        </text>
      </sprite>
      <position>
        <x>window.width.center + 50</x>
        <y>margin</y>
      </position>
      <velocity>
        <x>0</x>
        <y>0</y>
      </velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <!-- paused -->
    <object name="paused">
      <sprite>
        <text>
          <content>PAUSED</content>
          <size>128</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position>
        <x>window.width.center - paused.width / 2</x>
        <y>window.height.center - paused.height / 2</y>
      </position>
      <velocity>
        <x>0</x>
        <y>0</y>
      </velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <!-- gameover -->
    <object name="gameover">
      <sprite>
        <text>
          <content>GAME OVER</content>
          <size>128</size>
          <color>color.red</color>
        </text>
      </sprite>
      <position>
        <x>window.width.center - gameover.width / 2</x>
        <y>window.height.center - 150</y>
      </position>
      <velocity>
        <x>0</x>
        <y>0</y>
      </velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
    <!-- continue -->
    <object name="continue">
      <sprite>
        <text>
          <content>spacebar to continue</content>
          <size>48</size>
          <color>color.white</color>
        </text>
      </sprite>
      <position>
        <x>window.width.center - continue.width / 2</x>
        <y>window.height.center + 60</y>
      </position>
      <velocity>
        <x>0</x>
        <y>0</y>
      </velocity>
      <collisions>
        <enabled>false</enabled>
      </collisions>
    </object>
  </objects>
  <!-- states -->
  <states>
    <!-- mainmenu -->
    <state name="mainmenu">
      <shows>
        <show object="title" />
        <show object="logo" />
      </shows>
      <inputs>
        <input button="space">
          <push state="playing" />
        </input>
        <input button="s">
          <push state="settings" />
        </input>
      </inputs>
    </state>
    <!-- settings -->
    <state name="settings">
      <shows>
        <show object="logo" />
      </shows>
      <inputs>
        <input button="escape">
          <pop />
        </input>
      </inputs>
    </state>
    <!-- playing -->
    <state name="playing">
      <shows>
        <show object="ball" />
        <show object="paddle1" />
        <show object="paddle2" />
        <show object="score1" />
        <show object="score2" />
      </shows>
      <inputs>
        <input button="space">
          <push state="paused" />
        </input>
        <input button="w">
          <trigger object="paddle1" action="up" />
        </input>
        <input button="s">
          <trigger object="paddle1" action="down" />
        </input>
        <input button="up">
          <trigger object="paddle2" action="up" />
        </input>
        <input button="down">
          <trigger object="paddle2" action="down" />
        </input>
        <input button="left">
          <trigger object="paddle2" action="left" />
        </input>
        <input button="right">
          <trigger object="paddle2" action="right" />
        </input>
      </inputs>
      <conditions>
        <condition class="paddle" variable="score">
          <atleast>15</atleast>
          <push state="gameover" />
        </condition>
      </conditions>
    </state>
    <!-- paused -->
    <state name="paused">
      <shows>
        <show object="paused" />
      </shows>
      <inputs>
        <input button="space">
          <pop />
        </input>
      </inputs>
    </state>
    <!-- gameover -->
    <state name="gameover">
      <shows>
        <show object="gameover" />
        <show object="continue" />
      </shows>
      <inputs>
        <input button="space">
          <reset />
        </input>
      </inputs>
    </state>
  </states>
</game>
